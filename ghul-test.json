{
    // How the tasks are run: each is a project, built with the compiler alone
    // where the runner can read everything the project says, and with
    // MSBuild otherwise, using the compiler the tool manifest pins.
    "default": "tasks",
    "configurations": {
        "tasks": {
            "build": "direct",
            "compiler": "project"
        },

        // The same tasks built as native executables for the llvm target,
        // against the ghul-runtime library, its core and runtime sources, and,
        // for a task that references ghul.raster, ghul-raster, each from the
        // first checkout found under libraries/, beside this repository or
        // beside its worktree's primary, and linked with the ghul-llvm on the
        // PATH or named by GHUL_LLVM.
        // Opt-in, and run over the tasks llvm-tasks.txt lists:
        //   dotnet ghul-test --config llvm $(cat llvm-tasks.txt)
        "llvm": {
            "extends": "tasks",
            "build_targets": ["llvm"],
            "targets": {
                "llvm": {
                    "libraries": [
                        {
                            "name": "ghul-runtime",
                            "root": ["libraries/ghul-runtime", "../ghul-runtime", "../../../ghul-runtime"],
                            "sources": ["ghul-core/src/**/*.ghul", "ghul-runtime/src/**/*.ghul"]
                        },
                        {
                            "name": "ghul-raster",
                            "package": "ghul.raster",
                            "root": ["libraries/ghul-raster", "../ghul-raster", "../../../ghul-raster"],
                            "sources": "src/**/*.ghul"
                        }
                    ]
                }
            }
        },

        // The llvm tasks built unoptimised by a native compiler in
        // hosts/llvm/ghul rather than by a .NET-hosted one, as the compiler's
        // CI builds them with the native compiler its pull request produced:
        //   dotnet ghul-test --config native $(cat llvm-tasks.txt)
        "native": {
            "extends": "llvm",
            "compiler": { "path": "hosts/llvm/ghul", "reference_assemblies": false },
            "targets": {
                "llvm": {
                    "flags": "--optimise 0",
                    "libraries": [
                        {
                            "name": "ghul-runtime",
                            "root": ["libraries/ghul-runtime", "../ghul-runtime", "../../../ghul-runtime"],
                            "sources": ["ghul-core/src/**/*.ghul", "ghul-runtime/src/**/*.ghul"]
                        },
                        {
                            "name": "ghul-raster",
                            "package": "ghul.raster",
                            "root": ["libraries/ghul-raster", "../ghul-raster", "../../../ghul-raster"],
                            "sources": "src/**/*.ghul"
                        }
                    ]
                }
            }
        },

        // The tasks wasm-slow.txt lists, built for llvm at -O2 by a native
        // compiler in hosts/llvm/ghul, as the compiler's CI runs them in
        // place of wasm:
        //   dotnet ghul-test --config ci-llvm $(scripts/wasm-tasks.sh --slow)
        "ci-llvm": {
            "extends": "native",
            "optimise": 2
        },

        // The same tasks built as WebAssembly, as ghul.dev's playground builds
        // them, and run under Node on the loader the runtime's core ships,
        // with the same libraries as the llvm configuration. CI runs it over
        // every task wasm-exempt.txt does not list:
        //   dotnet ghul-test --config wasm $(scripts/wasm-tasks.sh)
        "wasm": {
            "extends": "tasks",
            "build_targets": ["wasm"],
            "targets": {
                "wasm": {
                    "libraries": [
                        {
                            "name": "ghul-runtime",
                            "root": ["libraries/ghul-runtime", "../ghul-runtime", "../../../ghul-runtime"],
                            "sources": ["ghul-core/src/**/*.ghul", "ghul-runtime/src/**/*.ghul"],
                            "loader": "ghul-core/host/loader.mjs"
                        },
                        {
                            "name": "ghul-raster",
                            "package": "ghul.raster",
                            "root": ["libraries/ghul-raster", "../ghul-raster", "../../../ghul-raster"],
                            "sources": "src/**/*.ghul"
                        }
                    ]
                }
            }
        },

        // The wasm tasks built by a native compiler in hosts/llvm/ghul, each
        // from a fork server that compiles the libraries once, as the
        // compiler's CI builds them; the tasks wasm-tasks.sh leaves out are
        // built for .NET instead:
        //   dotnet ghul-test --config ci-wasm $(scripts/wasm-tasks.sh)
        //   dotnet ghul-test $(scripts/wasm-tasks.sh --others)
        "ci-wasm": {
            "extends": "wasm",
            "compiler": { "path": "hosts/llvm/ghul", "reference_assemblies": false, "fork_server": true }
        }
    }
}
