{
    // How the tasks are run: each is a project, built with the compiler alone
    // where the runner can read everything the project says, and with
    // MSBuild otherwise, using the compiler the tool manifest pins.
    "default": "tasks",
    "configurations": {
        "tasks": {
            "build": "direct",
            "compiler": "project"
        },

        // The same tasks built as native executables for the llvm target,
        // against the ghul-runtime library, its core and runtime sources, and,
        // for a task that references ghul.raster, ghul-raster, each from the
        // first checkout found under libraries/, beside this repository or
        // beside its worktree's primary, and linked with the ghul-llvm on the
        // PATH or named by GHUL_LLVM.
        // Opt-in, and run over the tasks llvm-tasks.txt lists:
        //   dotnet ghul-test --config llvm $(cat llvm-tasks.txt)
        "llvm": {
            "extends": "tasks",
            "build_targets": ["llvm"],
            "targets": {
                "llvm": {
                    "libraries": [
                        {
                            "name": "ghul-runtime",
                            "root": ["libraries/ghul-runtime", "../ghul-runtime", "../../../ghul-runtime"],
                            "sources": ["ghul-core/src/**/*.ghul", "ghul-runtime/src/**/*.ghul"]
                        },
                        {
                            "name": "ghul-raster",
                            "package": "ghul.raster",
                            "root": ["libraries/ghul-raster", "../ghul-raster", "../../../ghul-raster"],
                            "sources": "src/**/*.ghul"
                        }
                    ]
                }
            }
        }
    }
}
