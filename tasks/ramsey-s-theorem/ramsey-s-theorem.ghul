use default
use Raster.IMAGE

let n = 17

let residues = 1..n |> map(i => i * i % n) |> list()

linked(a, b) =>
    let d = ((a - b) % n + n) % n in
    residues |> any(* == d)

for a in 0..n do
    let row =
        0..n
            |> map(b =>
                if a == b then
                    "-"
                elif linked(a, b) then
                    "1"
                else
                    "0"
                fi
            )

    write_line(row |> join(" "))
od

quads() is
    for a in 0..n do
        for b in a + 1..n do
            for c in b + 1..n do
                for d in c + 1..n do
                    yield (a, b, c, d)
                od
            od
        od
    od
si

uniform(q) =>
    let
        (a, b, c, d) = q,
        pairs = [
            (a, b),
            (a, c),
            (a, d),
            (b, c),
            (b, d),
            (c, d)
        ],
        links = pairs |> filter((x, y) => linked(x, y)) |> count()
    in
        links == 0 \/ links == 6

let bad = quads() |> filter(uniform) |> count()

write_line()
write_line(
    "{quads() |> count()} sets of 4 nodes checked, "
    "{bad} totally connected or totally unconnected"
)

let image = IMAGE(420, 420)

image.view(-1.15, -1.15, 1.15, 1.15)
image.clear(252ub, 252ub, 250ub)

at(i) =>
    let
        turn = double(i) / double(n),
        angle = pi / 2.0 - 2.0 * pi * turn
    in
        (x = cos(angle), y = sin(angle))

image.color(40ub, 90ub, 180ub)
image.stroke(1.2)

for a in 0..n do
    for b in a + 1..n do
        if linked(a, b) then
            let p = at(a)
            let q = at(b)

            image.line(p.x, p.y, q.x, q.y)
        fi
    od
od

for i in 0..n do
    let p = at(i)

    image.color(200ub, 60ub, 40ub)
    image.dot(p.x, p.y, 11.0)
    image.color(255ub, 255ub, 255ub)
    image.text(p.x, p.y - 0.03, 11.0, "{i}", Raster.Anchor.CENTER)
od

image.write("paley.png")

image.show("paley.png")
