use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

derivative(value: bigint) -> bigint is
    if value.sign < 0 then return 0n - derivative(-value) fi
    if value < 2n then return 0n fi

    let two = 2n
    let factor mut = two

    while factor * factor <= value do
        if (value % factor).is_zero then
            let rest = value / factor

            return derivative(rest) * factor + rest
        fi

        factor = factor + 1n
    od

    1n
si

write_line("the arithmetic derivative of -99 through 100:")

let values = -99::100 |> map(n => "{derivative(bigint(n)),5}") |> list()

for row in 0..20 do
    write_line(values[row * 10..row * 10 + 10] |> join(""))
od

write_line("")
write_line("the arithmetic derivative of ten to the power m, over seven:")

let ten = 10n
let seven = 7n

for m in 1::20 do
    let quotient = derivative(bigint.pow(ten, m)) / seven

    write_line("  m = {m,2}: {quotient}")
od
