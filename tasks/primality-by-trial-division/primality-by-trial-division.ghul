use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

is_prime(n: int) -> bool =>
    n > 1 /\
    (n % 2 != 0 \/ n == 2) /\
    3::int(Ghul.Math.sqrt(double(n))) |> all(d => n % d != 0)

write_line(1::50 |> filter(is_prime) |> join())
