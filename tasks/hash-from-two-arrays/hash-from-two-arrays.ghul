use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

let keys = ["hydrogen", "helium", "lithium", "beryllium"]
let values = [1, 2, 3, 4]

let elements =
    keys |> zip(values) |> collect_map(pair => pair.`0, pair => pair.`1)

for key in keys do
    write_line("{key,-10} {elements[key]}")
od
