use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.

modes[T](values: T{}) -> T{} =>
    let
        groups = values |> group_by(value => value),
        most = groups.values |> map(group => group.count) |> max()!
    in
        groups
            |> filter((_, group) => group.count == most)
            |> map((value, _) => value)

show[T](values: T[]) => write_line("mode of {values} is {modes(values)}")

show([1, 3, 6, 6, 6, 6, 7, 7, 12, 12, 17])
show([1, 1, 2, 4, 4])
show(["apple", "pear", "fig", "pear", "fig", "plum"])
