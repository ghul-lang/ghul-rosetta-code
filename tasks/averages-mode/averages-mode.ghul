use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

modes[T](values: T{}) -> T{} =>
    let
        groups = values |> group_by(value => value),
        most = groups.values |> map(group => group.count) |> max()!
    in
        groups
            |> filter((_, group) => group.count == most)
            |> map((value, _) => value)

show[T](values: T[]) => write_line("mode of {values} is {modes(values)}")

show([1, 3, 6, 6, 6, 6, 7, 7, 12, 12, 17])
show([1, 1, 2, 4, 4])
show(["apple", "pear", "fig", "pear", "fig", "plum"])
