use default

class NODE[T](value: T) is
    next: NODE[T]?
    previous: NODE[T]?

    insert_after(value: T) -> NODE[T] is
        let inserted = NODE(value)

        inserted.previous = self
        inserted.next = next

        if let following = next then
            following.previous = inserted
        fi

        next = inserted

        inserted
    si
si

render[T](first: NODE[T]) -> string => (
    let text mut = "{first.value}"
    let cursor mut = first.next

    while let node = cursor do
        text = "{text} -> {node.value}"
        cursor = node.next
    od

    text
)

let a = NODE("A")
let b = a.insert_after("B")

write_line(render(a))

a.insert_after("C")

write_line(render(a))
write_line("B.previous = {b.previous?.value}")
