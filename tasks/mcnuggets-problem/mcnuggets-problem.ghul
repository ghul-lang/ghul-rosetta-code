use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

is_mcnugget(n: int) -> bool =>
    0::n / 20
        |> any(large =>
            0::(n - 20 * large) / 9
                |> any(medium => (n - 20 * large - 9 * medium) % 6 == 0)
        )

let largest = 0::100 |> filter(n => !is_mcnugget(n)) |> max()!

write_line("The largest non-McNuggets number up to 100 is {largest}")
