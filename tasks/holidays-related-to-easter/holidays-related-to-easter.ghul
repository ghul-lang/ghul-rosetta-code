use default

use System.DateTime
use System.Globalization.JulianCalendar

let julian = JulianCalendar()

julian_easter(year: int) -> DateTime =>
    let a = year % 4, b = year % 7, c = year % 19 in
    let d = (19 * c + 15) % 30 in
    let e = (2 * a + 4 * b - d + 34) % 7 in
    let month = (d + e + 114) / 31, day = (d + e + 114) % 31 + 1 in
    DateTime(year, month, day, julian)

gregorian_easter(year: int) -> DateTime =>
    let a = year % 19, b = year / 100, c = year % 100 in
    let d = b / 4, e = b % 4 in
    let f = (b + 8) / 25 in
    let g = (b - f + 1) / 3 in
    let h = (19 * a + b - d - g + 15) % 30 in
    let i = c / 4, k = c % 4 in
    let l = (32 + 2 * e + 2 * i - h - k) % 7 in
    let m = (a + 11 * h + 22 * l) / 451 in
    let month = (h + l - 7 * m + 114) / 31 in
    let day = (h + l - 7 * m + 114) % 31 + 1 in
    DateTime(year, month, day)

let months =
    ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
     "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

in_julian(date: DateTime) -> string =>
    let month = months[julian.get_month(date) - 1] in
    "{julian.get_day_of_month(date):D2} {month}"

in_gregorian(date: DateTime) -> string =>
    "{date.day:D2} {months[date.month - 1]}"

feasts(
    easter: DateTime, shown: DateTime -> string, days: List[(string, int)]
) -> string =>
    days
        |> map((name, offset) =>
            "{name} {shown(easter.add_days(double(offset)))}")
        |> join()

let western = [
    ("Easter", 0), ("Ascension", 39), ("Pentecost", 49),
    ("Trinity", 56), ("Corpus Christi", 60)
]

let orthodox = [
    ("Easter", 0), ("Ascension", 39), ("Pentecost", 49),
    ("All Saints", 56)
]

let years = 4::21 |> map(century => century * 100) |> cat(2010::2020)

for year in years do
    if year < 1583 then
        let easter = julian_easter(year)

        write_line("{year} Julian computus, Julian calendar:")
        write_line("    {feasts(easter, in_julian, western)}")
    else
        let catholic = gregorian_easter(year), eastern = julian_easter(year)

        write_line("{year} Gregorian computus, Gregorian calendar:")
        write_line("    {feasts(catholic, in_gregorian, western)}")
        write_line("{year} Julian computus, Gregorian calendar:")
        write_line("    {feasts(eastern, in_gregorian, orthodox)}")
    fi
od
