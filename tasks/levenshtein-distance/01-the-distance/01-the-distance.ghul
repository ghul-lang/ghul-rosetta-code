use default
use System.Math.min

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

levenshtein(source: string, target: string) -> int is
    let previous mut = 0::target.length |> list()

    for i in 1::source.length do
        let current = LIST()

        current.add(i)

        for j in 1::target.length do
            let same = source[i - 1] == target[j - 1]
            let substitution = previous[j - 1] + if same then 0 else 1 fi

            let insertion = previous[j] + 1
            let deletion = current[j - 1] + 1

            current.add(min(substitution, min(insertion, deletion)))
        od

        previous = current
    od

    return previous[target.length]
si

write_line("{levenshtein("kitten", "sitting")}")
write_line("{levenshtein("rosettacode", "raisethysword")}")
