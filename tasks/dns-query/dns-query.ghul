use default
use System.Net.Dns
use System.Net.IPAddress
use System.Net.Sockets.AddressFamily

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

report(addresses: IPAddress[]) is
    for
        (label, family) in [
            ("IPv4", AddressFamily.INTER_NETWORK),
            ("IPv6", AddressFamily.INTER_NETWORK_V6)
        ]
    do
        let matching = addresses |> filter(a => a.address_family == family)

        for address in matching do
            write_line("{label}: {address}")
        od
    od
si

report(Dns.get_host_addresses("www.kame.net"))
