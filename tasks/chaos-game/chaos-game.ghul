use default
use Raster.COLOR_MAP
use Raster.IMAGE

use Step = (x: double, y: double, corner: int)

let random = System.Random(20260918)

let corners = [
    (x = 0.0, y = 0.0),
    (x = 1.0, y = 0.0),
    (x = 0.5, y = sqrt(3.0) / 2.0)
]

let image = IMAGE(640, 560)

toward_a_corner(at) => (
    let chosen = random.next(corners.count)
    let corner = corners[chosen]

    let next = (
        x = (at.x + corner.x) / 2.0,
        y = (at.y + corner.y) / 2.0,
        corner = chosen
    )

    next || next
)

plot(at) is
    let spot = image.to_pixel(at.x, at.y)

    image.color(COLOR_MAP.hue(double(at.corner) / 3.0))
    image.blend(int(spot.x), int(spot.y), 0.6)
si

let start = (
    x = 0.3 + random.next_double() * 0.4,
    y = 0.1 + random.next_double() * 0.3,
    corner = 0
)

image.view(-0.03, -0.03, 1.03, 0.90)

stream(start, toward_a_corner) |> skip(20) |> take(150000) |> each(plot)

image.write("chaos.png")

image.show("chaos.png")
