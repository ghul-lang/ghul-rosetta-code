use default
use Raster.Anchor
use Raster.IMAGE

// `LIST[T]` is a mutable list that grows as elements are added
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|> LIST()` reads the whole sequence into a new `LIST`
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

let leading_counts = 1::10 |> map(_ => 0) |> LIST()

let previous mut = 0n
let current mut = 1n

for _ in 1::1000 do
    let first = current.to_string()[0]
    let digit = int(first) - int('0')
    leading_counts[digit] = leading_counts[digit] + 1

    let next = previous + current
    previous = current
    current = next
od

let actual = (1::9) |> map(digit => double(leading_counts[digit]) / 10.0)

let expected =
    (1::9)
        |> map(digit => 100.0 * log10(1.0 + 1.0 / double(digit)))
        |> list()

let observed_color = (red = 40ub, green = 90ub, blue = 180ub)
let benford_color = (red = 225ub, green = 145ub, blue = 45ub)

let image = IMAGE(700, 470)

image.view(0.3, 0.0, 9.7, 33.0, 62.0)

box(left: double, bottom: double, right: double, top: double) is
    image.fill([
        (x = left, y = bottom),
        (x = right, y = bottom),
        (x = right, y = top),
        (x = left, y = top)
    ])
si

image.color(215ub, 215ub, 215ub)
image.stroke(1.0)

for step in 0::6 do
    let y = double(step * 5)

    image.line(0.3, y, 9.7, y)
    image.text(0.15, y - 0.4, 12.0, "{step * 5}%", Anchor.RIGHT)
od

image.color(120ub, 120ub, 120ub)
image.line(0.3, 0.0, 9.7, 0.0)

for entry in actual |> index() do
    let digit = entry.index + 1
    let middle = double(digit)

    image.color(observed_color)
    box(middle - 0.36, 0.0, middle - 0.03, entry.value)

    image.color(benford_color)
    box(middle + 0.03, 0.0, middle + 0.36, expected[entry.index])

    image.color(60ub, 60ub, 60ub)
    image.text(middle, -2.1, 14.0, "{digit}", Anchor.CENTER)
od

image.color(60ub, 60ub, 60ub)
image.text(5.0, -4.8, 13.0, "leading digit", Anchor.CENTER)

let keys = [
    (shade = observed_color, label = "first 1000 Fibonacci numbers"),
    (shade = benford_color, label = "Benford's law")
]

for key in keys |> index() do
    let y = 31.0 - 2.6 * double(key.index)

    image.color(key.value.shade)
    box(3.8, y - 0.55, 4.15, y + 0.55)

    image.color(60ub, 60ub, 60ub)
    image.text(4.35, y - 0.45, 12.0, key.value.label, Anchor.LEFT)
od

image.write("benford.png")

image.show("benford.png")
