use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

let one = 1n

motzkin(count: int) -> bigint{} is
    let previous mut = 0n
    let current mut = one

    for index in 0..count do
        yield current

        let following =
            (
                current * bigint(2 * index + 3) +
                previous * bigint(3 * index)
            ) /
            bigint(index + 3)

        previous = current
        current = following
    od
si

let terms = motzkin(42) |> list()

for index in 0..terms.count do
    let mark = if is_prime(terms[index]) then "  prime" else "" fi

    write_line("M[{index,2}] = {terms[index],20}{mark}")
od
