use default

let one = 1n

motzkin(count: int) -> bigint{} is
    let previous mut = 0n
    let current mut = one

    for index in 0..count do
        yield current

        let following =
            (
                current * bigint(2 * index + 3) +
                previous * bigint(3 * index)
            ) /
            bigint(index + 3)

        previous = current
        current = following
    od
si

let terms = motzkin(42) |> collect()

for index in 0..terms.count do
    let mark =
        if is_prime(terms[index]) then "  prime" else "" fi

    write_line("M[{index,2}] = {terms[index],20}{mark}")
od
