use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `yield` makes the function a generator: it returns a lazy `T{}`.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

let one = 1n

motzkin(count: int) -> bigint{} is
    let previous mut = 0n
    let current mut = one

    for index in 0..count do
        yield current

        let following =
            (
                current * bigint(2 * index + 3) +
                previous * bigint(3 * index)
            ) /
            bigint(index + 3)

        previous = current
        current = following
    od
si

let terms = motzkin(42) |> list()

for index in 0..terms.count do
    let mark = if is_prime(terms[index]) then "  prime" else "" fi

    write_line("M[{index,2}] = {terms[index],20}{mark}")
od
