use default

class JOB(priority: int, description: string):
    Ghul.Comparable[JOB]
is
    <>(other: JOB) -> int => priority <> other.priority

    to_string() -> string => "{priority}  {description}"
si

class PRIORITY_QUEUE[T: Ghul.Comparable[T]] is
    _heap: LIST[T]

    init() is
        _heap = LIST[T]()
    si

    count: int => _heap.count

    push(item: T) is
        _heap.add(item)

        let child mut = _heap.count - 1

        while child > 0 /\ _heap[child] < _heap[(child - 1) / 2] do
            let parent = (child - 1) / 2

            _swap(child, parent)

            child = parent
        od
    si

    pop() -> T is
        let top = _heap[0]

        _heap[0] = _heap[_heap.count - 1]
        _heap.remove_at(_heap.count - 1)

        let parent mut = 0

        while true do
            let smallest = _smallest_of(parent)

            if smallest == parent then
                break
            fi

            _swap(parent, smallest)

            parent = smallest
        od

        top
    si

    _smallest_of(parent: int) -> int is
        let smallest mut = parent

        for child in [parent * 2 + 1, parent * 2 + 2] do
            if child < _heap.count /\ _heap[child] < _heap[smallest] then
                smallest = child
            fi
        od

        smallest
    si

    _swap(a: int, b: int) is
        (_heap[a], _heap[b]) = (_heap[b], _heap[a])
    si
si

drain[T: Ghul.Comparable[T]](queue: PRIORITY_QUEUE[T]) -> T{} is
    while queue.count > 0 do
        yield queue.pop()
    od
si

let queue = PRIORITY_QUEUE[JOB]()

[
    JOB(3, "Clear drains"),
    JOB(4, "Feed cat"),
    JOB(5, "Make tea"),
    JOB(1, "Solve RC tasks"),
    JOB(2, "Tax return")
] |> each(job => queue.push(job))

drain(queue) |> each(job => write_line("{job}"))
