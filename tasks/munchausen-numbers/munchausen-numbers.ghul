use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`
// `==` compares identity

power(value: int, exponent: int) -> int =>
    if exponent == 0 then
        1
    else
        value * power(value, exponent - 1)
    fi

digit_powers(number: int) -> int =>
    number
        |> digits()
        |> filter(* > 0)
        |> reduce(0, (total, digit) => total + power(digit, digit))

let munchausen = [
    "{number}"
    for number in 1::5000
    if digit_powers(number) == number
]
    |> join(" ")

write_line("Munchausen numbers up to 5000: {munchausen}")
