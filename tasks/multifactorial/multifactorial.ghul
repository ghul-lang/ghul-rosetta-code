use default

multifactorial(n: int, degree: int) -> long =>
    from(n, -degree)
        |> take_while(term => term > 0)
        |> reduce(1L, (total, term) => total * long(term))

write_line("degree  n = 1 .. 10")

for degree in 1::5 do
    let row = 1::10 |> map(n => "{multifactorial(n, degree),8}") |> join("")
    write_line("{degree,6}{row}")
od
