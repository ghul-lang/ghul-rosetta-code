use default

use System.Text.RegularExpressions.Regex

let number = Regex("(\\.[0-9]+|[1-9][0-9]*(\\.[0-9]+)?)")

groups(digits: string, period: int) -> string{} =>
    digits |> chunk(period) |> map(part => part |> join(""))

from_left(digits: string, period: int, separator: string) -> string =>
    groups(digits, period) |> join(separator)

from_right(digits: string, period: int, separator: string) -> string =>
    let head = (digits.length - 1) % period + 1 in
    [digits.substring(0, head)]
        |> cat(groups(digits.substring(head), period))
        |> join(separator)

commatize(
    text: string, start: int, period: int, separator: string
) -> string is
    let found = number.match(text, start)

    if !found.success \/ period < 1 \/ separator.length == 0 then
        return text
    fi

    let parts = found.value.split(['.'])

    let whole =
        if parts[0].length == 0 then ""
        else from_right(parts[0], period, separator)
        fi

    let fraction =
        if parts.count == 1 then ""
        else ".{from_left(parts[1], period, separator)}"
        fi

    let before = text.substring(0, found.index)
    let after = text.substring(found.index + found.length)

    "{before}{whole}{fraction}{after}"
si

let pi =
    "pi=3.1415926535897932384626433832795028"
    "8419716939937510582097494459231"

let zimbabwe =
    "The author has two Z$100000000000000 Zimbabwe notes "
    "(100 trillion)."

write_line(commatize("123456789.123456789", 0, 2, "*"))
write_line(commatize(".123456789", 0, 3, "-"))
write_line(commatize("57256.1D-4", 0, 4, "__"))
write_line(commatize(pi, 0, 5, " "))
write_line(commatize(zimbabwe, 0, 3, "."))

let others = [
    "-in Aus$+1411.8millions",
    "===US$0017440 millions=== (in 2000 dollars)",
    "123.e8000 is pretty big.",
    "The land area of the earth is 57268900(29% of the surface) "
    "square miles.",
    "Ain't no numbers in this here words, nohow, no way, Jose.",
    "James was never known as 0000000007",
    "Arthur Eddington wrote: I believe there are "
    "157477241362750025776056539611815554680447179145271"
    "16709366231425076185631031296 protons in the universe.",
    "   $-140000±100 millions.",
    "6/9/1946 was a good year for some."
]

for text in others do
    write_line(commatize(text, 0, 3, ","))
od
