use default
dv(d, v) =>
    let
        t = stream((1, v), (p, db) => (p, db) || (p * 2, db * 2))
            |> take_while((p, db) => db <= d),
        sums = t |> reverse() |> reduce((0, 0), ((ans, acc), (p, db)) =>
            if acc + db <= d then (ans + p, acc + db) else (ans, acc) fi)
    in
        (sums.`0, d - sums.`1)

let (a, r) = dv(580, 34)
write_line("580 divided by 34 is {a} remainder {r}")
