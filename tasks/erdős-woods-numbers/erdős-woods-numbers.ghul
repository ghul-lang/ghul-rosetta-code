use default

use System.Numerics.BitOperations

use Partition = (a: long, b: long, unassigned: long)

is_prime(n: int) -> bool =>
    n >= 2 /\ 2..n |> all(d => d * d > n \/ n % d != 0)

set_bits(mask: long) -> long{} =>
    0..64 |> map(i => 1L << i) |> filter(bit => mask & bit != 0L)

lowest_bit(mask: long) -> int =>
    if mask == 0L then -1 else BitOperations.trailing_zero_count(mask) fi

inverse(value: bigint, modulus: bigint) -> bigint is
    let (r0, r1) mut = (modulo(value, modulus), modulus)
    let (s0, s1) mut = (1n, 0n)

    while r1 !~ 0n do
        let q = r0 / r1

        (r0, r1) = (r1, r0 - q * r1)
        (s0, s1) = (s1, s0 - q * s1)
    od

    modulo(s0, modulus)
si

modulo(value: bigint, m: bigint) -> bigint => ((value % m) + m) % m

smallest_start(n: int) -> bigint? is
    let primes = 2..n |> filter(is_prime) |> collect_mutable()

    let divides =
        0..n
            |> map(v =>
                primes
                    |> index()
                    |> filter((_, p) => v % p == 0)
                    |> map((i, _) => 1L << i)
                    |> reduce(0L, (x, y) => x | y))
            |> collect_mutable()

    let partitions: List[Partition] mut =
        [(0L, 0L, (1L << primes.count) - 1L)]

    let order =
        1..n
            |> sort_by_descending(i =>
                lowest_bit(divides[i] | divides[n - i]))

    for i in order do
        let near = divides[i], far = divides[n - i]

        partitions =
            partitions
                |> flat_map(
                    ((a, b, unassigned)) =>
                    if near & a != 0L \/ far & b != 0L then
                        [(a, b, unassigned)]
                    else
                        set_bits(near & unassigned)
                            |> map(w => (a ^ w, b, unassigned ^ w))
                            |> cat(
                                set_bits(far & unassigned)
                                    |> map(w => (a, b ^ w, unassigned ^ w)))
                            |> collect_mutable()
                    fi)
                |> collect_mutable()
    od

    product_of(mask) =>
        primes
            |> index()
            |> filter((i, _) => mask & (1L << i) != 0L)
            |> map((_, p) => bigint(p))
            |> product()

    let size = bigint(n)

    partitions
        |> map((a, b, _) =>
            let x = product_of(a), y = product_of(b) in
            size * inverse(x, y) % y * x - size)
        |> min()
si

let found =
    from(3)
        |> map(k => (k, start = smallest_start(k)))
        |> filter((_, start) => start?)
        |> take(20)

write_line("The first 20 Erdős–Woods numbers and their smallest starts:")

for (k, start) in found do
    write_line("{k,3} -> {start!}")
od
