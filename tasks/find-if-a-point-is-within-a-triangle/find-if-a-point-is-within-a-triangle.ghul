use default

use Point = (x: double, y: double)

-(a: Point, b: Point) -> Point => (a.x - b.x, a.y - b.y)

×(a: Point, b: Point) -> double => a.x * b.y - a.y * b.x

// Walking round the triangle, the point is inside when it is on the same
// side of every edge, which is when the three cross products share a sign.

within(p: Point, a: Point, b: Point, c: Point) -> bool =>
    let sides = [(b - a) × (p - a), (c - b) × (p - b), (a - c) × (p - c)] in
    sides |> all(* >= 0.0) \/ sides |> all(* <= 0.0)

let a: Point = (1.5, 2.4), b: Point = (5.1, -3.1), c: Point = (-3.8, 1.2)

for p in [(0.0, 0.0), (0.0, 1.0), (3.0, 1.0)] do
    let inside = within(p, a, b, c)

    write_line("{p} is within the triangle {a}, {b}, {c}: {inside}")
od

let d: Point = (0.1, 0.1111111111111111)
let e: Point = (12.5, 33.333333333333336)
let f: Point = (25.0, 11.11111111111111)
let q: Point = (5.414285714285714, 14.349206349206348)

let inside = within(q, d, e, f)

write_line("{q} is within the triangle {d}, {e}, {f}: {inside}")
