use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `LIST()` builds its collection eagerly
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity
// `case ... when` pattern-matches, and `[x, ..rest]` matches a list head
//  and tail

amb[T](sets: T{}[], accepts: (T, T) -> bool) -> T[]{} is
    case sets
    when [] then
        yield LIST()
    when [set, ..others] then
        let rests = amb(others, accepts) |> list()

        for choice in set do
            for rest in rests do
                if rest.count == 0 \/ accepts(choice, rest[0]) then
                    let sequence = LIST()

                    sequence.add(choice)
                    sequence.add_range(rest)

                    yield sequence
                fi
            od
        od
    esac
si

let sets: string{}[] = [
    ["the", "that", "a"],
    ["frog", "elephant", "thing"],
    ["walked", "treaded", "grows"],
    ["slowly", "quickly"]
]

let joins = (left, right) => left[left.length - 1] == right[0]

for sentence in amb(sets, joins) do
    write_line(sentence |> join(" "))
od
