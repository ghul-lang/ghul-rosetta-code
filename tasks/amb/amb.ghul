use default

amb[T](sets: List[T{}], accepts: (T, T) -> bool) -> List[T]{} is
    case sets
    when [] then
        yield LIST()
    when [set, ..others] then
        let rests = amb(others, accepts) |> memo()

        for choice in set do
            for rest in rests do
                if
                    rest.count == 0 \/ accepts(choice, rest[0])
                then
                    let sequence = LIST()

                    sequence.add(choice)
                    sequence.add_range(rest)

                    yield sequence
                fi
            od
        od
    esac
si

let sets: List[string{}] = [
    ["the", "that", "a"],
    ["frog", "elephant", "thing"],
    ["walked", "treaded", "grows"],
    ["slowly", "quickly"]
]

let joins = (left, right) => left[left.length - 1] == right[0]

for sentence in amb(sets, joins) do
    write_line(sentence |> join(" "))
od
