use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `if let` and `case ... when` pattern-match; `[x, ..rest]` matches a list.

amb[T](sets: T{}[], accepts: (T, T) -> bool) -> T[]{} is
    case sets
    when [] then
        yield LIST()
    when [set, ..others] then
        let rests = amb(others, accepts) |> list()

        for choice in set do
            for rest in rests do
                if rest.count == 0 \/ accepts(choice, rest[0]) then
                    let sequence = LIST()

                    sequence.add(choice)
                    sequence.add_range(rest)

                    yield sequence
                fi
            od
        od
    esac
si

let sets: string{}[] = [
    ["the", "that", "a"],
    ["frog", "elephant", "thing"],
    ["walked", "treaded", "grows"],
    ["slowly", "quickly"]
]

let joins = (left, right) => left[left.length - 1] == right[0]

for sentence in amb(sets, joins) do
    write_line(sentence |> join(" "))
od
