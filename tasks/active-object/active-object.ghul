use default
use System.Math.abs
use System.Math.pi
use System.Math.sin
use System.Threading.AutoResetEvent
use System.Threading.Thread

let frequency = 0.5D
let step = 0.001D

// The integrator samples only when the clock is advanced, and the advance
// waits for that sample to be taken, so the number of samples is what the
// caller asked for rather than however many the machine managed in the
// time available.
class INTEGRATOR is
    _worker: Thread
    _sample_due: AutoResetEvent
    _sample_taken: AutoResetEvent
    _input: (double) -> double
    _now: double
    _output: double
    _previous: double
    _last: double
    _running: bool

    init() is
        _input = t => 0.0D
        _sample_due = AutoResetEvent(false)
        _sample_taken = AutoResetEvent(false)
        _running = true
        _worker = Thread(() => _integrate())

        _worker.is_background = true
        _worker.start()
    si

    _integrate() is
        while true do
            _sample_due.wait_one()

            if !_running then
                _sample_taken.set()

                return
            fi

            let sample = _input(_now)

            _output = _output + (sample + _previous) * (_now - _last) / 2.0D
            _previous = sample
            _last = _now

            _sample_taken.set()
        od
    si

    advance(seconds: double) is
        _now = _now + seconds

        _sample_due.set()
        _sample_taken.wait_one()
    si

    input(k: (double) -> double) is
        _previous = k(_now)
        _input = k
    si

    output: double => _output

    stop() is
        _running = false

        _sample_due.set()
        _sample_taken.wait_one()

        _worker.join()
    si
si

run_for(integrator: INTEGRATOR, seconds: double) is
    for _ in 0..int(seconds / step) do
        integrator.advance(step)
    od
si

let integrator = INTEGRATOR()

integrator.input(t => sin(2.0D * pi * frequency * t))

run_for(integrator, 1.0D)

let half_period = integrator.output

run_for(integrator, 1.0D)

let full_period = integrator.output

integrator.input(t => 0.0D)

run_for(integrator, 0.5D)

integrator.stop()

write_line("integral over half a period: {half_period:F4}")
write_line("integral over a whole period: {abs(full_period):F4}")
write_line("integral once the input is zero: {abs(integrator.output):F4}")
