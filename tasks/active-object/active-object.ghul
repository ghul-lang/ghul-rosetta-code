use default
use Concurrency

let frequency = 0.5
let step = 0.001

// The integrator is an asynchronous function of its own. It samples only
// when the clock is advanced, and the advance waits for that sample to be
// taken, so the number of samples is what the caller asked for.
class INTEGRATOR is
    _sample_due: Semaphore
    _sample_taken: Semaphore
    _input: (double) -> double
    _now: double
    _output: double
    _previous: double
    _last: double
    _running: bool

    init() is
        _input = t => 0.0
        _sample_due = Semaphore(0)
        _sample_taken = Semaphore(0)
        _running = true
    si

    integrate() -> Future is
        do
            await _sample_due.acquire()

            if !_running then
                _sample_taken.release()

                return
            fi

            let sample = _input(_now)

            _output = _output + (sample + _previous) * (_now - _last) / 2.0
            _previous = sample
            _last = _now

            _sample_taken.release()
        od
    si

    advance(seconds: double) -> Future is
        _now = _now + seconds

        _sample_due.release()

        await _sample_taken.acquire()
    si

    input(k: (double) -> double) is
        _previous = k(_now)
        _input = k
    si

    output: double => _output

    stop() -> Future is
        _running = false

        _sample_due.release()

        await _sample_taken.acquire()
    si
si

run_for(integrator: INTEGRATOR, seconds: double) -> Future is
    for _ in 0..int(seconds / step) do
        await integrator.advance(step)
    od
si

let integrator = INTEGRATOR()

driver() -> Future is
    integrator.input(t => sin(2.0 * pi * frequency * t))

    await run_for(integrator, 1.0)

    let half_period = integrator.output

    await run_for(integrator, 1.0)

    let full_period = integrator.output

    integrator.input(t => 0.0)

    await run_for(integrator, 0.5)

    await integrator.stop()

    write_line("integral over half a period: {half_period:F4}")
    write_line("integral over a whole period: {abs(full_period):F4}")
    let after_zero = abs(integrator.output)

    write_line("integral once the input is zero: {after_zero:F4}")
si

run(() => Future.when_all([integrator.integrate(), driver()]))
