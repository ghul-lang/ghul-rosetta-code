use default
use IO.Std.read_line

use Score = (bulls: int, cows: int)

score(guess: string, secret: string) -> Score =>
    let bulls = 0..4 |> filter(i => guess[i] == secret[i]) |> count() in
    let shared =
        0..4 |> filter(i => secret.contains(guess[i])) |> count() in
    (bulls = bulls, cows = shared - bulls)

let candidates mut =
    (1234::9876)
        |> map(n => "{n}")
        |> filter(s =>
            !s.contains('0') /\
            0..4 |> all(i => s.last_index_of(s[i]) == i))
        |> collect()

let random = System.Random(4)

write_line("think of four different digits from 1 to 9")
write_line("score each guess as bulls then cows, like 1 2")

let guesses mut = 0

do
    if candidates.count == 0 then
        write_line("no number fits those scores")
        break
    fi

    let guess = candidates[random.next(candidates.count)]

    guesses = guesses + 1
    write_line()
    write_line("guess {guesses}: {guess}")

    let line = read_line()

    if !line? then
        break
    fi

    let parts = words(line) |> collect()
    let given = (bulls = int.parse(parts[0]), cows = int.parse(parts[1]))

    write_line("bulls {given.bulls}, cows {given.cows}")

    if given.bulls == 4 then
        write_line("got it in {guesses}")
        break
    fi

    candidates =
        candidates
            |> filter(c => score(guess, c) =~ given)
            |> collect()
od
