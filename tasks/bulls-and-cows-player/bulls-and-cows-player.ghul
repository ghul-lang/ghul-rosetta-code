use default
use IO.Std.read_line

use Score = (bulls: int, cows: int)

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read, and `count` reads it all
// `=~` compares values (structural equality) - `==` compares identity

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.
// `=~` compares values (structural equality); `==` compares identity.

score(guess: string, secret: string) -> Score =>
    let bulls = 0..4 |> filter(i => guess[i] == secret[i]) |> count() in
    let shared = 0..4 |> filter(i => secret.contains(guess[i])) |> count()
    in
    (bulls = bulls, cows = shared - bulls)

let candidates mut =
    (1234::9876)
        |> map(n => "{n}")
        |> filter(s =>
            !s.contains('0') /\ 0..4 |> all(i => s.last_index_of(s[i]) == i)
        )
        |> list()

let random = System.Random(4)

write_line("think of four different digits from 1 to 9")
write_line("score each guess as bulls then cows, like 1 2")

let guesses mut = 0

do
    if candidates.count == 0 then
        write_line("no number fits those scores")
        break
    fi

    let guess = candidates[random.next(candidates.count)]

    guesses = guesses + 1
    write_line()
    write_line("guess {guesses}: {guess}")

    let line = read_line()

    if !line? then
        break
    fi

    let parts = line |> words() |> list()
    let given = (bulls = int.parse(parts[0]), cows = int.parse(parts[1]))

    write_line("bulls {given.bulls}, cows {given.cows}")

    if given.bulls == 4 then
        write_line("got it in {guesses}")
        break
    fi

    candidates =
        candidates |> filter(c => score(guess, c) =~ given) |> list()
od
