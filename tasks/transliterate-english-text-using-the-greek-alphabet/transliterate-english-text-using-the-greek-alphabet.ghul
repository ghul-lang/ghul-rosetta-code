use default

let pairs = [
    ("ch", 'χ'), ("kh", 'χ'), ("ph", 'φ'), ("rh", 'ρ'), ("th", 'θ'),
    ("ps", 'ψ'), ("ck", 'κ'), ("ee", 'η'), ("oo", 'ω'),
    ("a", 'α'), ("b", 'β'), ("c", 'κ'), ("d", 'δ'), ("e", 'ε'),
    ("f", 'φ'), ("g", 'γ'), ("h", 'η'), ("i", 'ι'), ("j", 'ι'),
    ("k", 'κ'), ("l", 'λ'), ("m", 'μ'), ("n", 'ν'), ("o", 'ο'),
    ("p", 'π'), ("q", 'κ'), ("r", 'ρ'), ("s", 'σ'), ("t", 'τ'),
    ("u", 'υ'), ("v", 'β'), ("w", 'ω'), ("x", 'ξ'), ("y", 'υ'),
    ("z", 'ζ')
]

matched_at(text: string, at: int) -> (string, char)? =>
    pairs |> find(((english, _)) =>
        at + english.length <= text.length /\
        text[at..at + english.length].to_lower() =~ english)

matching_case(greek: char, english: char) -> char =>
    if char.is_upper(english) then char.to_upper(greek) else greek fi

// The Greek letters for text, starting at position at. Pairs of English
// letters are tried before single letters, and anything that matches
// neither passes through unchanged.
letters(text: string, at: int) -> char{} is
    if at < text.length then
        if let (english, greek) = matched_at(text, at) then
            yield matching_case(greek, text[at])
            yield in letters(text, at + english.length)
        else
            yield text[at]
            yield in letters(text, at + 1)
        fi
    fi
si

// A sigma at the end of a word is written in its final form, ς.
final_form(greek: char[], at: int) -> char =>
    let
        ends_word =
            at == greek.count - 1 \/ !char.is_letter(greek[at + 1])
    in
        if greek[at] == 'σ' /\ ends_word then 'ς' else greek[at] fi

transliterate(text: string) -> string =>
    let greek = letters(text, 0) |> collect() in
    string(0..greek.count |> map(final_form(greek, *)) |> collect())

let passage = [
    "I was looking at some rhododendrons in my back garden,",
    "dressed in my khaki shorts, when the telephone rang.",
    "",
    "As I answered it, I cheerfully glimpsed that the July sun",
    "caused a fragment of black pine wax to ooze on the velvet quilt",
    "laying in my patio."
]

write_line(transliterate("The quick brown fox jumped over the lazy dog."))
write_line("")

for line in passage do
    write_line(transliterate(line))
od
