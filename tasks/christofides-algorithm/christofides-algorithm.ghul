use default

use Edge = (from: int, to: int)

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `SET()` and `LIST()` build their collections eagerly
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity
// `if let` pattern-matches, and `[x, ..rest]` matches a list head and tail

let points = [
    (0.0, 0.0), (3.0, 1.0), (6.0, 0.0), (8.0, 4.0), (6.0, 7.0),
    (2.0, 6.0), (0.0, 4.0), (4.0, 4.0), (9.0, 8.0)
]

distance(a: int, b: int) -> double =>
    let
        (ax, ay) = points[a],
        (bx, by) = points[b]
    in
        double.sqrt((ax - bx) * (ax - bx) + (ay - by) * (ay - by))

length(edges: Edge{}) -> double =>
    edges |> sum_by((from, to) => distance(from, to))

spanning_tree(n: int) -> Edge{} => (
    let in_tree = SET([0])
    let edges = LIST()

    while in_tree.count < n do
        let next =
            [
                (from, to)
                for from in in_tree
                for to in 0..n
                if !in_tree.contains(to)
            ]
                |> min_by((from, to) => distance(from, to))!

        edges.add(next)
        in_tree.add(next.to)
    od

    edges
)

perfect_matching(vertices: int[]) -> Edge{} =>
    if vertices.count == 0 then
        []
    else
        1..vertices.count
            |> map(partner =>
                let rest =
                    vertices
                        |> index()
                        |> filter((at, _) => at != 0 /\ at != partner)
                        |> map((_, vertex) => vertex)
                        |> list()
                in
                [
                    (from = vertices[0], to = vertices[partner])
                ] ++ perfect_matching(rest)
                    |> list()
            )
            |> min_by(matching => length(matching))!
    fi

eulerian_circuit(n: int, edges: Edge[]) -> int{} is
    let unused = 0..n |> map(_ => LIST()) |> list()
    let used = repeat(false, edges.count) |> LIST()

    for (edge, (from, to)) in edges |> index() do
        unused[from].add((edge, other = to))
        unused[to].add((edge, other = from))
    od

    let stack = STACK([edges[0].from])
    let circuit = LIST()

    while stack.count > 0 do
        let vertex = stack.peek()
        let next = unused[vertex] |> find((edge, _) => !used[edge])

        if let (edge, other) = next then
            used[edge] = true
            stack.push(other)
        else
            circuit.add(stack.pop())
        fi
    od

    circuit
si

let n = points.count
let tree = spanning_tree(n)

let odd =
    0..n
        |> filter(v =>
            tree |> count((from, to) => from == v \/ to == v) % 2 == 1
        )
        |> list()

let matching = perfect_matching(odd)
let circuit = eulerian_circuit(n, tree ++ matching |> list())

let visited = SET()
let tour = circuit |> filter(visited.add) |> LIST()

tour.add(tour[0])

let tour_edges =
    tour |> windows(2) |> map(pair => (from = pair[0], to = pair[1]))

write_line("points:            {points}")
write_line("spanning tree:     {tree}")
write_line("odd vertices:      {odd}")
write_line("matching:          {matching}")
write_line("eulerian circuit:  {circuit}")
write_line("hamiltonian tour:  {tour}")
write_line("tour length:       {length(tour_edges):F3}")
