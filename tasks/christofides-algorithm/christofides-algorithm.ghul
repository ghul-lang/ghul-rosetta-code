use default

use Edge = (from: int, to: int)

let points = [
    (0.0, 0.0), (3.0, 1.0), (6.0, 0.0), (8.0, 4.0), (6.0, 7.0),
    (2.0, 6.0), (0.0, 4.0), (4.0, 4.0), (9.0, 8.0)
]

distance(a: int, b: int) -> double =>
    let (ax, ay) = points[a], (bx, by) = points[b] in
    double.sqrt((ax - bx) * (ax - bx) + (ay - by) * (ay - by))

length(edges: Iterable[Edge]) -> double =>
    edges |> sum_by((from, to) => distance(from, to))

spanning_tree(n: int) -> List[Edge] is
    let in_tree = SET([0])
    let edges = LIST()

    while in_tree.count < n do
        let next =
            [(from, to)
                for from in in_tree for to in 0..n
                if !in_tree.contains(to)]
                |> min_by((from, to) => distance(from, to))!

        edges.add(next)
        in_tree.add(next.to)
    od

    edges
si

perfect_matching(vertices: List[int]) -> List[Edge] =>
    if vertices.count == 0 then
        []
    else
        1..vertices.count
            |> map(partner =>
                let rest =
                    vertices
                        |> index()
                        |> filter((at, _) => at != 0 /\ at != partner)
                        |> map((_, vertex) => vertex)
                        |> collect()
                in
                [(from = vertices[0], to = vertices[partner])]
                    |> cat(perfect_matching(rest))
                    |> collect())
            |> min_by(matching => length(matching))!
    fi

eulerian_circuit(n: int, edges: List[Edge]) -> List[int] is
    let unused =
        0..n
            |> map(_ => LIST())
            |> collect()
    let used = repeat(false, edges.count) |> collect_mutable()

    for (edge, (from, to)) in edges |> index() do
        unused[from].add((edge, other = to))
        unused[to].add((edge, other = from))
    od

    let stack = STACK([edges[0].from])
    let circuit = LIST()

    while stack.count > 0 do
        let vertex = stack.peek()
        let next = unused[vertex] |> find((edge, _) => !used[edge])

        if let (edge, other) = next then
            used[edge] = true
            stack.push(other)
        else
            circuit.add(stack.pop())
        fi
    od

    circuit
si

let n = points.count
let tree = spanning_tree(n)

let odd = 0..n
    |> filter(v =>
        tree |> count((from, to) => from == v \/ to == v) % 2 == 1)
    |> collect()

let matching = perfect_matching(odd)
let circuit =
    eulerian_circuit(n, tree |> cat(matching) |> collect())

let visited = SET()
let tour = circuit |> filter(v => visited.add(v)) |> collect_mutable()

tour.add(tour[0])

let tour_edges =
    tour |> windows(2) |> map(pair => (from = pair[0], to = pair[1]))

write_line("points:            {points}")
write_line("spanning tree:     {tree}")
write_line("odd vertices:      {odd}")
write_line("matching:          {matching}")
write_line("eulerian circuit:  {circuit}")
write_line("hamiltonian tour:  {tour}")
write_line("tour length:       {length(tour_edges):F3}")
