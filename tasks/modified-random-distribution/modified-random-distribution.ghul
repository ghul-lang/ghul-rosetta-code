use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.
// `*` as an argument leaves that parameter open: partial application.

let random = System.Random(42)

modifier(x: double) -> double =>
    if x < 0.5 then 2.0 * (0.5 - x) else 2.0 * (x - 0.5) fi

modified(generate: () -> double, weight: double -> double) -> double is
    do
        let candidate = generate()

        if generate() < weight(candidate) then
            return candidate
        fi
    od
si

let samples = 10_000
let bins = 20

let sample_bins =
    1::samples
        |> map(_ => modified(() => random.next_double(), modifier))
        |> map(x => int(x * double(bins)))
        |> list()

let counts = 0..bins |> map(bin => sample_bins |> count(* == bin)) |> list()

let largest = counts |> max()!

write_line("{samples:N0} samples from the modified distribution:")

for bin in 0..bins do
    let low = double(bin) / double(bins)
    let high = low + 1.0 / double(bins)
    let bar = string('#', counts[bin] * 50 / largest)

    write_line("{low:F2} .. {high:F2} {counts[bin],5} {bar}")
od
