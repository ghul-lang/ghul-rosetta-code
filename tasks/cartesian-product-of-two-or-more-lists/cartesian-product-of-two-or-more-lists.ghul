use default

// `T[]` is the read-only list trait - elements can be read by index
// `ARRAY[T]` is a fixed-size, read-only array
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `case ... when` pattern-matches, and `[x, ..rest]` matches a list head
//  and tail

product(lists: int[][]) -> int[][] =>
    case lists
    when [] then [[]]
    when [first, ..rest] then
        [
            [head] ++ tail |> list()
            for head in first
            for tail in product(rest)
        ]
    esac

show(lists: int[][]) =>
    let factors = lists |> map(list => $(list)) |> join(" × ") in
    write_line("{factors} = {$(product(lists))}")

let empty = ARRAY[int]([])

show([[1, 2], [3, 4]])
show([[3, 4], [1, 2]])
show([[1, 2], empty])
show([empty, [1, 2]])

write_line("")

show([[1776, 1789], [7, 12], [4, 14, 23], [0, 1]])
show([[1, 2, 3], [30], [500, 100]])
show([[1, 2, 3], empty, [500, 100]])
