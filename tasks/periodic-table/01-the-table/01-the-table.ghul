use default

symbols() -> string[] => [
    "H", "He",
    "Li", "Be", "B", "C", "N", "O", "F", "Ne",
    "Na", "Mg", "Al", "Si", "P", "S", "Cl", "Ar",
    "K", "Ca", "Sc", "Ti", "V", "Cr", "Mn", "Fe", "Co", "Ni",
    "Cu", "Zn", "Ga", "Ge", "As", "Se", "Br", "Kr",
    "Rb", "Sr", "Y", "Zr", "Nb", "Mo", "Tc", "Ru", "Rh", "Pd",
    "Ag", "Cd", "In", "Sn", "Sb", "Te", "I", "Xe",
    "Cs", "Ba", "La", "Ce", "Pr", "Nd", "Pm", "Sm", "Eu", "Gd",
    "Tb", "Dy", "Ho", "Er", "Tm", "Yb", "Lu", "Hf", "Ta", "W",
    "Re", "Os", "Ir", "Pt", "Au", "Hg", "Tl", "Pb", "Bi", "Po",
    "At", "Rn",
    "Fr", "Ra", "Ac", "Th", "Pa", "U", "Np", "Pu", "Am", "Cm",
    "Bk", "Cf", "Es", "Fm", "Md", "No", "Lr", "Rf", "Db", "Sg",
    "Bh", "Hs", "Mt", "Ds", "Rg", "Cn", "Nh", "Fl", "Mc", "Lv",
    "Ts", "Og"
]

position(z: int) -> (row: int, column: int) is
    if z <= 2 then
        (row = 1, column = if z == 1 then 1 else 18 fi)
    elif z <= 18 then
        let row = if z <= 10 then 2 else 3 fi
        let at = z - if row == 2 then 3 else 11 fi

        (
            row = row,
            column = if at < 2 then at + 1 else at + 11 fi
        )
    elif z <= 54 then
        let row = if z <= 36 then 4 else 5 fi

        (
            row = row,
            column = z - if row == 4 then 19 else 37 fi + 1
        )
    else
        let row = if z <= 86 then 6 else 7 fi
        let at = z - if row == 6 then 55 else 87 fi

        if at < 2 then
            (row = row, column = at + 1)
        elif at < 17 then
            (row = row + 2, column = at + 2)
        else
            (row = row, column = at - 13)
        fi
    fi
si

let table = symbols()

let grid =
    repeat(0, 9)
        |> map(_ => repeat(" ", 18) |> collect_mutable())
        |> collect()

for z in 1::118 do
    let at = position(z)

    grid[at.row - 1][at.column - 1] = table[z - 1]
od

grid[5][2] = "*"
grid[6][2] = "#"

let labels = ["1", "2", "3", "4", "5", "6", "7", "8*", "9#"]

let header = 1::18 |> map(c => "{c,-4}") |> join("")

write_line("    {header.trim_end()}")

for row in 0..9 do
    if row == 7 then
        write_line("")
    fi

    let cells = grid[row] |> map(s => "{s,-4}") |> join("")

    write_line("{labels[row],-4}{cells.trim_end()}")
od

write_line("")

for z in [1, 2, 29, 42, 57, 58, 72, 89, 118] do
    let at = position(z)

    write_line(
        "{z,3} {table[z - 1],-3} row {at.row}, column {at.column}"
    )
od
