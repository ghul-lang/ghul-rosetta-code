use default
use Raster.Anchor
use Raster.IMAGE
use Raster.SHAPES

symbols() -> string[] => [
    "H", "He",
    "Li", "Be", "B", "C", "N", "O", "F", "Ne",
    "Na", "Mg", "Al", "Si", "P", "S", "Cl", "Ar",
    "K", "Ca", "Sc", "Ti", "V", "Cr", "Mn", "Fe", "Co", "Ni",
    "Cu", "Zn", "Ga", "Ge", "As", "Se", "Br", "Kr",
    "Rb", "Sr", "Y", "Zr", "Nb", "Mo", "Tc", "Ru", "Rh", "Pd",
    "Ag", "Cd", "In", "Sn", "Sb", "Te", "I", "Xe",
    "Cs", "Ba", "La", "Ce", "Pr", "Nd", "Pm", "Sm", "Eu", "Gd",
    "Tb", "Dy", "Ho", "Er", "Tm", "Yb", "Lu", "Hf", "Ta", "W",
    "Re", "Os", "Ir", "Pt", "Au", "Hg", "Tl", "Pb", "Bi", "Po",
    "At", "Rn",
    "Fr", "Ra", "Ac", "Th", "Pa", "U", "Np", "Pu", "Am", "Cm",
    "Bk", "Cf", "Es", "Fm", "Md", "No", "Lr", "Rf", "Db", "Sg",
    "Bh", "Hs", "Mt", "Ds", "Rg", "Cn", "Nh", "Fl", "Mc", "Lv",
    "Ts", "Og"]

// Rows 1 to 3 have a gap in the middle, rows 6 and 7 send their
// fifteen inner elements down to rows 8 and 9, and the rest fill
// left to right.
position(z: int) -> (row: int, column: int) is
    if z <= 2 then
        (row = 1, column = if z == 1 then 1 else 18 fi)
    elif z <= 18 then
        let row = if z <= 10 then 2 else 3 fi
        let at = z - (if row == 2 then 3 else 11 fi)

        (row = row, column = if at < 2 then at + 1 else at + 11 fi)
    elif z <= 54 then
        let row = if z <= 36 then 4 else 5 fi

        (row = row, column = z - (if row == 4 then 19 else 37 fi) + 1)
    else
        let row = if z <= 86 then 6 else 7 fi
        let at = z - (if row == 6 then 55 else 87 fi)

        if at < 2 then
            (row = row, column = at + 1)
        elif at < 17 then
            (row = row + 2, column = at + 2)
        else
            (row = row, column = at - 13)
        fi
    fi
si

block(at: (row: int, column: int)) -> string =>
    if at.row >= 8 then "f"
    elif at.row == 1 \/ at.column <= 2 then "s"
    elif at.column >= 13 then "p"
    else "d"
    fi

tint(block: string) -> (red: ubyte, green: ubyte, blue: ubyte) =>
    case block
    when "s" then (red = 255ub, green = 212ub, blue = 212ub)
    when "p" then (red = 206ub, green = 230ub, blue = 255ub)
    when "d" then (red = 255ub, green = 236ub, blue = 190ub)
    else (red = 226ub, green = 212ub, blue = 255ub)
    esac

let cell = 44.0
let left = 44.0
let top = 34.0
let split = 16.0

row_y(row: int) -> double =>
    top + double(row - 1) * cell + if row >= 8 then split else 0.0 fi

column_x(column: int) -> double => left + double(column - 1) * cell

box(x: double, y: double, width: double, height: double)
    -> List[(x: double, y: double)]
=>
    [
        (x = x, y = y),
        (x = x + width, y = y),
        (x = x + width, y = y + height),
        (x = x, y = y + height)]

glyph(image: IMAGE, at: (row: int, column: int), letters: string) is
    image.text(
        column_x(at.column) + cell / 2.0,
        row_y(at.row) + cell * 0.76,
        16.0,
        letters,
        Anchor.CENTRE)
si

let table = symbols()

let image = IMAGE(
    int(column_x(18) + cell + 12.0),
    int(row_y(9) + cell + 12.0))

let cells = SHAPES()

for z in 1::118 do
    let at = position(z)

    cells.add(
        box(column_x(at.column), row_y(at.row), cell, cell),
        tint(block(at)))
od

for row in 6::7 do
    cells.add(box(column_x(3), row_y(row), cell, cell), tint("f"))
od

image.fill(cells)

image.colour(120ub, 120ub, 120ub)
image.stroke(0.8)

for z in 1::118 do
    let at = position(z)
    let x = column_x(at.column)
    let y = row_y(at.row)

    image.line([
        (x = x, y = y),
        (x = x + cell, y = y),
        (x = x + cell, y = y + cell),
        (x = x, y = y + cell),
        (x = x, y = y)])
od

for row in 6::7 do
    let x = column_x(3)
    let y = row_y(row)

    image.line([
        (x = x, y = y),
        (x = x + cell, y = y),
        (x = x + cell, y = y + cell),
        (x = x, y = y + cell),
        (x = x, y = y)])
od

image.colour(40ub, 40ub, 40ub)

for column in 1::18 do
    image.text(
        column_x(column) + cell / 2.0,
        top - 10.0,
        13.0,
        "{column}",
        Anchor.CENTRE)
od

for row in 1::9 do
    let label =
        case row
        when 8 then "*"
        when 9 then "#"
        else "{row}"
        esac

    image.text(
        left - 10.0,
        row_y(row) + cell * 0.63,
        13.0,
        label,
        Anchor.RIGHT)
od

for z in 1::118 do
    let at = position(z)
    let x = column_x(at.column)
    let y = row_y(at.row)

    image.text(x + 5.0, y + 12.0, 8.5, "{z}")

    glyph(image, at, table[z - 1])
od

glyph(image, (row = 6, column = 3), "*")
glyph(image, (row = 7, column = 3), "#")

let key = ["s", "p", "d", "f"]
let key_y = row_y(1) + cell * 0.5

for entry in key |> index() do
    let x = column_x(4) + double(entry.index) * 104.0

    image.colour(tint(entry.value))
    image.fill_rectangle(x, key_y - 8.0, x + 18.0, key_y + 8.0)

    image.colour(120ub, 120ub, 120ub)
    image.line([
        (x = x, y = key_y - 8.0),
        (x = x + 18.0, y = key_y - 8.0),
        (x = x + 18.0, y = key_y + 8.0),
        (x = x, y = key_y + 8.0),
        (x = x, y = key_y - 8.0)])

    image.colour(40ub, 40ub, 40ub)
    image.text(x + 25.0, key_y + 5.0, 13.0, "{entry.value} block")
od

image.write("periodic-table.png")

image.show("periodic-table.png")
