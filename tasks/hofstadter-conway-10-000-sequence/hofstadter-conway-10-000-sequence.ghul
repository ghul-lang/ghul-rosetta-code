use default

let limit = 1 << 20

let a = (
    let terms = repeat(0, limit + 1) |> collect_mutable()

    terms[1] = 1
    terms[2] = 1

    for n in 3::limit do
        terms[n] = terms[terms[n - 1]] + terms[n - terms[n - 1]]
    od

    terms
)

ratio(n: int) -> double => double(a[n]) / double(n)

for power in 1..20 do
    let low = 1 << power
    let n = low::(low * 2) |> max_by(n => ratio(n))!

    let range = "between 2^{power,2} and 2^{power + 1,2}"

    write_line("{range}: a({n,7}) / {n,7} = {ratio(n):F8}")
od

let prize = 1::limit |> filter(n => ratio(n) >= 0.55) |> max()!

write_line("\nMallows' number, the last n with a(n) / n >= 0.55: {prize}")
