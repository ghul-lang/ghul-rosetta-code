use default

let bands = [
    (0.06, 0.10), (0.11, 0.18), (0.16, 0.26), (0.21, 0.32),
    (0.26, 0.38), (0.31, 0.44), (0.36, 0.50), (0.41, 0.54),
    (0.46, 0.58), (0.51, 0.62), (0.56, 0.66), (0.61, 0.70),
    (0.66, 0.74), (0.71, 0.78), (0.76, 0.82), (0.81, 0.86),
    (0.86, 0.90), (0.91, 0.94), (0.96, 0.98), (1.01, 1.00)
]

rescale(price: double) -> double =>
    assert price >= 0.0 /\ price < 1.01 else "price out of range" in
    bands |> find(((upper_bound, _)) => price < upper_bound)?.`1!

let shown =
    0::100
        |> map(hundredths => (
            let price = cast(hundredths) / 100.0

            "{price:F2} -> {rescale(price):F2}"
        ))
        |> list()

for row in 0..21 do
    let last = min(row * 5 + 5, shown.count)

    write_line(shown[row * 5..last] |> join("   "))
od
