use default

let limit = 20000

let proper_divisor_sums =
    repeat(0, limit + 1) |> collect_mutable()

for divisor in 1::limit / 2 do
    let multiple mut = divisor * 2

    while multiple <= limit do
        proper_divisor_sums[multiple] =
            proper_divisor_sums[multiple] + divisor

        multiple = multiple + divisor
    od
od

let deficient =
    1::limit |> count(n => proper_divisor_sums[n] < n)
let perfect =
    1::limit |> count(n => proper_divisor_sums[n] == n)
let abundant =
    1::limit |> count(n => proper_divisor_sums[n] > n)

write_line("of 1 to {limit}:")
write_line("  deficient {deficient}")
write_line("  perfect   {perfect}")
write_line("  abundant  {abundant}")
