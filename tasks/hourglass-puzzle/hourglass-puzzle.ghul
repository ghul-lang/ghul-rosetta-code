use default
use IO.Std.read_line
use System.Math.*

let small = 4
let large = 7
let target = 9

use State = (small: int, large: int, time: int)

flip(s: State, which: string) -> State =>
    case which
    when "4" then (small = small - s.small, large = s.large, time = s.time)
    when "7" then (small = s.small, large = large - s.large, time = s.time)
    else
        (small = small - s.small, large = large - s.large, time = s.time)
    esac

running(s: State) -> List[int] =>
    [s.small, s.large] |> filter(sand => sand > 0) |> collect()

wait(s: State) -> State? =>
    let sands = running(s) in
    if sands.count == 0 then null
    else
        let step = sands |> reduce(sands[0], (a, b) => min(a, b)) in
        (
            small = max(s.small - step, 0),
            large = max(s.large - step, 0),
            time = s.time + step)
    fi

moves(s: State) -> List[(command: string, next: State)] is
    let result = LIST()

    if let after = wait(s) then
        result.add((command = "wait", next = after))
    fi

    for which in ["4", "7", "both"] do
        result.add((command = "flip {which}", next = flip(s, which)))
    od

    result
si

plan(start: State) -> List[string]? is
    let seen = SET()
    let queue = Collections.Queue()

    queue.enqueue((state = start, path = LIST()))
    seen.add(start)

    while queue.count > 0 do
        let (state, path) = queue.dequeue()

        if state.time == target then
            return path
        fi

        for (command, next) in moves(state) do
            if next.time <= target /\ !seen.contains(next) then
                seen.add(next)
                let longer = path ++ [command] |> collect_mutable()

                queue.enqueue((state = next, path = longer))
            fi
        od
    od

    return null
si

show(s: State) =>
    write_line(
        "{s.time} minutes gone; sand left to fall: "
        "{s.small} in the 4, {s.large} in the 7")

write_line("measure exactly {target} minutes with 4 and 7 minute glasses")
write_line("say flip 4, flip 7, flip both, wait, done, hint or quit")
write_line("the clock starts now, with both glasses run out")

let state mut = (small = 0, large = 0, time = 0)

do
    write_line()
    show(state)

    let line = read_line()

    if !line? then
        break
    fi

    let command = line.trim().to_lower()

    write_line("> {command}")

    if command =~ "quit" then
        break
    elif command =~ "done" then
        if state.time == target then
            write_line("that is {target} minutes exactly")
            break
        fi

        write_line("that is {state.time} minutes, not {target}")
    elif command =~ "hint" then
        if let steps = plan(state) then
            write_line("from here: {steps |> join(", ")}, done")
        else
            write_line("{target} minutes is out of reach from here")
        fi
    elif command =~ "wait" then
        if let after = wait(state) then
            state = after
        else
            write_line("no sand is falling")
        fi
    elif command.starts_with("flip ") then
        let which = command.substring(5)

        if which =~ "4" \/ which =~ "7" \/ which =~ "both" then
            state = flip(state, which)
        else
            write_line("flip 4, flip 7 or flip both")
        fi
    else
        write_line("say flip 4 or 7 or both, wait, done, hint or quit")
    fi
od
