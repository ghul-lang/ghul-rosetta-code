use default

use System.Convert
use System.Globalization.NumberStyles

// Convert.ToInt64 parses bases 2, 8, 10 and 16, and for base 16 accepts a
// leading 0x as well. Other bases have no built-in parser.

let cases = [
    ("1a", 16), ("0x1A", 16), ("777", 8), ("101010", 2), ("-123", 10)
]

for (text, base) in cases do
    write_line("{text,-8} in base {base,2}: {Convert.to_int64(text, base)}")
od

let hex = int.parse("ff", NumberStyles.HEX_NUMBER)
let grouped = int.parse("1,234", NumberStyles.NUMBER)

write_line("{"ff",-8} as hex:     {hex}")
write_line("{"1,234",-8} as number: {grouped}")
