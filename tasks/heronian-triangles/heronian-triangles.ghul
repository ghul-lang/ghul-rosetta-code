use default
use TRIANGLE = (a: int, b: int, c: int, area: long)

heron_area(a: int, b: int, c: int) -> long? is
    let al = long(a)
    let bl = long(b)
    let cl = long(c)
    let cross_terms =
        2L * al * al * bl * bl +
        2L * bl * bl * cl * cl +
        2L * cl * cl * al * al
    let squares =
        al * al * al * al +
        bl * bl * bl * bl +
        cl * cl * cl * cl
    let sixteen_area_sq = cross_terms - squares

    if sixteen_area_sq <= 0L then
        return null
    fi

    let root = isqrt(sixteen_area_sq)

    if root * root == sixteen_area_sq /\ root % 4L == 0L then
        root / 4L
    else
        null
    fi
si

try_triangle(a: int, b: int, c: int) -> TRIANGLE? =>
    if let area = heron_area(a, b, c) then
        (a = a, b = b, c = c, area = area)
    else
        null
    fi

compare_triangles(x: TRIANGLE, y: TRIANGLE) -> int is
    let by_area = x.area <> y.area

    if by_area != 0 then
        return by_area
    fi

    let by_perimeter = (x.a + x.b + x.c) <> (y.a + y.b + y.c)

    if by_perimeter != 0 then
        return by_perimeter
    fi

    x.c <> y.c
si

let triangles =
    (1::200)
        |> flat_map(a =>
            (a::200)
                |> flat_map(b =>
                    (b::200)
                        |> filter(c =>
                            a + b > c /\ gcd(gcd(a, b), c) == 1
                        )
                        |> map(try_triangle(a, b, *))
                )
        )
        |> filter(t => t?)
        |> map(t => t!)
        |> sort(compare_triangles)
        |> collect()

describe(t: TRIANGLE) is
    let perimeter = t.a + t.b + t.c

    write_line(
        "  sides = ({t.a}, {t.b}, {t.c}), "
        "perimeter = {perimeter}, area = {t.area}"
    )
si

write_line(
    "primitive Heronian triangles with sides <= 200: {triangles.count}"
)
write_line("")
write_line(
    "first ten, ordered by area, then perimeter, then longest side:"
)

for t in triangles |> take(10) do
    describe(t)
od

write_line("")
write_line("triangles with area = 210:")

for t in triangles |> filter(t => t.area == 210L) do
    describe(t)
od
