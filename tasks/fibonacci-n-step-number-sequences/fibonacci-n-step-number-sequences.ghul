use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence

n_step(initial: int[]) -> int{} is
    let window = LIST(initial)

    for value in initial do
        yield value
    od

    do
        let next = window |> sum()

        yield next

        window.remove_at(0)
        window.add(next)
    od
si

show(name: string, initial: int[]) =>
    let series =
        n_step(initial) |> take(10) |> map(value => "{value}") |> join(" ")
    in
    write_line("{name}: {series}")

show("fibonacci", [1, 1])
show("tribonacci", [1, 1, 2])
show("tetranacci", [1, 1, 2, 4])
show("lucas", [2, 1])
