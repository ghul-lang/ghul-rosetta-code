use default

class GRAPH(order: int public) is
    _edges: LIST[LIST[int]]
    _match: LIST[int?]
    _parent: LIST[int?]
    _base: LIST[int]
    _seen: LIST[bool]
    _in_blossom: LIST[bool]

    init(..) is
        _edges =
            0..order
                |> map(_ => LIST[int]())
                |> collect_mutable()
        _match = repeat[int?](null, order) |> collect_mutable()
        _parent = repeat[int?](null, order) |> collect_mutable()
        _base = 0..order |> collect_mutable()
        _seen = repeat(false, order) |> collect_mutable()
        _in_blossom = repeat(false, order) |> collect_mutable()
    si

    join(a: int, b: int) is
        _edges[a].add(b)
        _edges[b].add(a)
    si

    matched: List[(a: int, b: int)] => [
        (a = a, b = _match[a]!)
        for a in 0..order
        if (_match[a] ?? -1) > a
    ]

    maximise() is
        for root in 0..order do
            if !_match[root]? then
                if let last = _augment_from(root) then
                    _flip(last)
                fi
            fi
        od
    si

    _base_of(v: int) -> int => _base[v]

    _lca(left: int, right: int) -> int is
        let reached = repeat(false, order) |> collect_mutable()
        let a mut = left

        while true do
            a = _base_of(a)
            reached[a] = true

            if let paired = _match[a] then
                a = _parent[paired]!
            else
                break
            fi
        od

        let b mut = right

        while !reached[_base_of(b)] do
            b = _parent[_match[b]!]!
        od

        _base_of(b)
    si

    _mark(from: int, meeting: int, child: int) is
        let at mut = from
        let entered mut = child

        while _base_of(at) != meeting do
            _in_blossom[_base_of(at)] = true
            _in_blossom[_base_of(_match[at]!)] = true
            _parent[at] = entered
            entered = _match[at]!
            at = _parent[_match[at]!]!
        od
    si

    _augment_from(root: int) -> int? is
        for at in 0..order do
            _seen[at] = false
            _parent[at] = null
            _base[at] = at
        od

        _seen[root] = true

        let pending = LIST[int]()
        let reading mut = 0

        pending.add(root)

        while reading < pending.count do
            let here = pending[reading]

            reading = reading + 1

            for there in _edges[here] do
                if
                    _base_of(here) == _base_of(there) \/
                    (_match[here] ?? -1) == there
                then
                    continue
                fi

                let grown =
                    _match[there]? /\ _parent[_match[there]!]?

                if there == root \/ grown then
                    let meeting = _lca(here, there)

                    for at in 0..order do
                        _in_blossom[at] = false
                    od

                    _mark(here, meeting, there)
                    _mark(there, meeting, here)

                    for at in 0..order do
                        if _in_blossom[_base_of(at)] then
                            _base[at] = meeting

                            if !_seen[at] then
                                _seen[at] = true

                                pending.add(at)
                            fi
                        fi
                    od
                elif !_parent[there]? then
                    _parent[there] = here

                    if let paired = _match[there] then
                        _seen[paired] = true

                        pending.add(paired)
                    else
                        return there
                    fi
                fi
            od
        od

        null
    si

    _flip(last: int) is
        let at mut = last

        while true do
            let above = _parent[at]!
            let carried = _match[above]

            _match[at] = above
            _match[above] = at

            if let onward = carried then
                at = onward
            else
                break
            fi
        od
    si
si

show(name: string, order: int, edges: List[(a: int, b: int)]) is
    let graph = GRAPH(order)

    edges |> each(edge => graph.join(edge.a, edge.b))

    graph.maximise()

    let pairs = graph.matched

    write_line("{name}: {pairs.count} edges")
    write_line(
        "  {pairs |> map(p => "{p.a}-{p.b}") |> join("  ")}"
    )
si

show("a five-cycle", 5, [
    (0, 1),
    (1, 2),
    (2, 3),
    (3, 4),
    (4, 0)
])

show("a triangle on a tail", 5, [
    (0, 1),
    (1, 2),
    (2, 0),
    (2, 3),
    (3, 4)
])

show("the Petersen graph", 10, [
    (0, 1), (1, 2), (2, 3), (3, 4), (4, 0),
    (5, 7), (7, 9), (9, 6), (6, 8), (8, 5),
    (0, 5), (1, 6), (2, 7), (3, 8), (4, 9)
])

show("two triangles joined by a bridge", 6, [
    (0, 1),
    (1, 2),
    (2, 0),
    (3, 4),
    (4, 5),
    (5, 3),
    (2, 3)
])
