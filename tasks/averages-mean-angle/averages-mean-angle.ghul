use default
use System.Math.*
use double.degrees_to_radians
use double.radians_to_degrees

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

mean_angle(degrees: double[]) -> double =>
    let radians = degrees |> map(degrees_to_radians) in
    let
        sines = radians |> sum_by(sin),
        cosines = radians |> sum_by(cos)
    in
        radians_to_degrees(atan2(sines, cosines))

let lists = [
    [350.0, 10.0],
    [90.0, 180.0, 270.0, 360.0],
    [10.0, 20.0, 30.0]
]

for angles in lists do
    write_line("mean angle of {angles} is {mean_angle(angles):F4} degrees")
od
