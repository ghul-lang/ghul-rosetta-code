use default

let limit = 1_000_000

let prime = (
    let sieve = repeat(true, limit) |> collect_mutable()

    sieve[0] = false
    sieve[1] = false

    for p in 2..limit |> take_while(p => p * p < limit) do
        if sieve[p] then
            for multiple in from(p * p, p) |> take_while(* < limit) do
                sieve[multiple] = false
            od
        fi
    od

    sieve
)

rotations(n: int) -> int{} =>
    let digits = "{n}" in
    0..digits.length
        |> map(i =>
            int.parse("{digits.substring(i)}{digits.substring(0, i)}"))

is_circular(n: int) -> bool =>
    n |> rotations() |> all(rotation => rotation >= n /\ prime[rotation])

probably_prime(n: bigint) -> bool is
    strip(d: bigint, s: int) -> (bigint, int) =>
        if d.is_even then strip(d / 2n, s + 1) else (d, s) fi

    let (d, s) = strip(n - 1n, 0)

    witness(base) is
        let x mut = bigint.mod_pow(base, d, n)

        if x =~ 1n \/ x =~ n - 1n then
            return false
        fi

        for _ in 1..s do
            x = bigint.mod_pow(x, 2n, n)

            if x =~ n - 1n then
                return false
            fi
        od

        true
    si

    [2n, 3n, 5n, 7n, 11n, 13n, 17n, 19n, 23n]
        |> all(base => base >= n \/ !witness(base))
si

repunit(n: int) -> bigint => (bigint.pow(10n, n) - 1n) / 9n

write_line("sieving to {limit:N0}")

let circular =
    2..limit |> filter(is_circular) |> take(19)

write_line("The first 19 circular primes:")
write_line("{circular}")

let repunits =
    from(7)
        |> filter(n => prime[n] /\ probably_prime(repunit(n)))
        |> take(4)
        |> map(n => "R({n})")

write_line("\ntesting repunits for primality")
write_line("The next 4 circular primes, all repunits:")
write_line(repunits |> join())
