use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

hailstone(n: int) -> int{} is
    let current mut = n

    while true do
        yield current

        if current == 1 then
            return
        fi

        current =
            if current % 2 == 0 then
                current / 2
            else
                3 * current + 1
            fi
    od
si

let sequence = hailstone(27) |> list()
write_line("length of hailstone(27): {sequence.count}")
let first = sequence[0..4] |> join()
let last = sequence[4..<<0] |> join()

write_line("first four: {first}")
write_line("last four: {last}")

let (longest, longest_length) =
    1..100_000
        |> map(n => (n, hailstone(n) |> count()))
        |> max_by((_, length) => length)!

write_line("longest under 100,000: {longest} (length {longest_length})")
