use default
use Raster.Anchor
use Raster.AXES
use Raster.IMAGE

step(c: int) -> int => if c % 2 == 0 then c / 2 else 3 * c + 1 fi

hailstone(n: int) -> int{} =>
    (iterate(n, step) |> take_while(* != 1)) ++ [1]

let limit = 100_000

let lengths = 1::limit |> map(n => hailstone(n) |> count())

let peak =
    lengths
        |> index()
        |> map(entry => (n = entry.index + 1, steps = entry.value))
        |> reduce(
            (n = 0, steps = 0),
            (best, item) =>
                if item.steps > best.steps then item
                else best
                fi
        )

let tallest = peak.steps
let longest = peak.n

let image = IMAGE(860, 520)

image.view(0.0, 0.0, double(limit), double(tallest) + 18.0, 62.0)

image.color(80ub, 80ub, 80ub)
image.stroke(1.0)

let axes = AXES(image)

axes.x_title = "n"
axes.y_title = "steps"
axes.draw()

image.color(40ub, 70ub, 150ub)
image.stroke(1.1)

for entry in lengths |> index() do
    let x = double(entry.index + 1)
    let y = double(entry.value)

    image.line(x, y, x, y)
od

let marked_x = double(longest)
let marked_y = double(tallest)

image.color(200ub, 40ub, 40ub)
image.stroke(6.0)
image.line(marked_x, marked_y, marked_x, marked_y)

image.text(marked_x, marked_y + 7.0, 13.0, "{longest}", Anchor.CENTER)

image.write("hailstone.png")

image.show("hailstone.png")
