use default

let random = System.Random(1898)

let terminators = ['.', '!', '?']

// The book is typeset with the curly apostrophe, so a word like "servant's"
// splits in two if only the typewriter one is taken as part of a word.
let apostrophes = ['\'', '\u2019']

// The book proper sits between Gutenberg's own markers, which are not
// part of what the task asks to read.
book_text(path: string) -> string is
    let whole = IO.File.read_all_text(path)
    let start = whole.index_of("*** START OF THE PROJECT GUTENBERG EBOOK")
    let finish = whole.index_of("*** END OF THE PROJECT GUTENBERG EBOOK")

    let from = whole.index_of('\n', start) + 1

    return whole.substring(from, finish - from)
si

words_of(text: string) -> List[string] is
    let words = LIST()
    let current = System.Text.StringBuilder()

    let flush = () =>
        if current.length > 0 then
            words.add(current.to_string().to_lower())

            current.clear()
        fi

    for letter in text do
        if char.is_letter(letter) \/
            apostrophes |> any(a => a == letter)
        then
            current.append(letter)
        else
            flush()

            if terminators |> any(t => t == letter) then
                words.add("{letter}")
            fi
        fi
    od

    flush()

    return words
si

let words = words_of(book_text("war-of-the-worlds.txt"))

// Each following word is stored once per time it was seen, so drawing
// one at random draws it with the weight the book gave it.
let after_one = MAP()
let after_two = MAP[(string, string), LIST[string]]()

for i in 0..words.count - 2 do
    let one = words[i]
    let two = words[i + 1]
    let next = words[i + 2]

    if !after_one.contains_key(one) then
        after_one[one] = LIST()
    fi

    after_one[one].add(two)

    let pair = (one, two)

    if !after_two.contains_key(pair) then
        after_two[pair] = LIST()
    fi

    after_two[pair].add(next)
od

pick(choices: List[string]) -> string =>
    choices[random.next(0, choices.count)]

sentence() -> string is
    let chosen = LIST()

    let first = pick(after_one["."])

    chosen.add(first)

    let second = pick(after_two[(".", first)])

    chosen.add(second)

    while !(terminators |> any(t => "{t}" =~ chosen[chosen.count - 1])) do
        let pair = (chosen[chosen.count - 2], chosen[chosen.count - 1])

        if !after_two.contains_key(pair) then
            chosen.add(".")
        else
            chosen.add(pick(after_two[pair]))
        fi
    od

    let ending = chosen[chosen.count - 1]

    let body = chosen |> take(chosen.count - 1) |> join(" ")

    return "{char.to_upper(body[0])}{body.substring(1)}{ending}"
si

for _ in 0..5 do
    write_line(sentence())
od
