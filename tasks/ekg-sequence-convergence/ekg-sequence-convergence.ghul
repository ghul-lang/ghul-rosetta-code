use default

shares_factor(left_value: int, right_value: int) -> bool =>
    if right_value > 0 then
        shares_factor(right_value, left_value % right_value)
    else
        left_value > 1
    fi

ekg(start: int, count: int) -> List[int] =>
    (let terms = LIST([1, start])
     let used = SET([1, start])

     while terms.count < count do
         let candidate = from(2) |> find(c =>
             !used.contains(c) /\ shares_factor(c, terms[terms.count - 1]))!

         terms.add(candidate)
         used.add(candidate)
     od

     terms)

let two = ekg(2, 80)
let five = ekg(5, 80)

write_line("EKG(2): {two |> take(10) |> join(" ")}")
write_line("EKG(5): {five |> take(10) |> join(" ")}")

let last_difference mut = 0

for index in 0::(two.count - 1) do
    if two[index] != five[index] then
        last_difference = index + 1
    fi
od

write_line(
    "EKG(2) and EKG(5) converge at term {last_difference + 1}")
