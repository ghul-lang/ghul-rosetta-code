use default

shares_factor(left_value: int, right_value: int) -> bool =>
    if right_value > 0 then
        shares_factor(right_value, left_value % right_value)
    else
        left_value > 1
    fi

ekg(start: int, count: int) -> List[int] => (
    let terms = LIST([1, start])
    let used = SET([1, start])

    while terms.count < count do
        let candidate =
            from(2)
                |> find(c =>
                    !used.contains(c) /\
                    shares_factor(c, terms[terms.count - 1])
                )!

        terms.add(candidate)
        used.add(candidate)
    od

    terms
)

for start in [2, 5, 7, 9, 10] do
    write_line("EKG({start,2}): {ekg(start, 10) |> join(" ")}")
od

let five = ekg(5, 100), seven = ekg(7, 100)

let last_difference =
    0..five.count
        |> filter(index => five[index] != seven[index])
        |> reduce(0, (_, index) => index + 1)

write_line("")
write_line(
    "EKG(5) and EKG(7) converge at term {last_difference + 1}"
)
