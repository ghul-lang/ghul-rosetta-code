use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `yield` makes the function a generator: it returns a lazy `T{}`.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

walk(dir: string) -> string{} is
    for path in IO.Directory.get_files(dir) do
        yield path
    od

    for sub in IO.Directory.get_directories(dir) do
        yield in walk(sub)
    od
si

let root = "walk-sample"

IO.Directory.create_directory("{root}/sub/deeper")

for
    (name, dir) in [
        ("a.txt", root),
        ("b.log", root),
        ("c.txt", "{root}/sub"),
        ("d.txt", "{root}/sub/deeper")
    ]
do
    IO.File.write_all_text("{dir}/{name}", "")
od

walk(root)
    |> filter(path => path.ends_with(".txt"))
    |> sort()
    |> each(path => write_line(path))

IO.Directory.delete(root, true)
