use default

let round_constants =
    [0x428A2F98u, 0x71374491u, 0xB5C0FBCFu, 0xE9B5DBA5u, 0x3956C25Bu,
     0x59F111F1u, 0x923F82A4u, 0xAB1C5ED5u, 0xD807AA98u, 0x12835B01u,
     0x243185BEu, 0x550C7DC3u, 0x72BE5D74u, 0x80DEB1FEu, 0x9BDC06A7u,
     0xC19BF174u, 0xE49B69C1u, 0xEFBE4786u, 0x0FC19DC6u, 0x240CA1CCu,
     0x2DE92C6Fu, 0x4A7484AAu, 0x5CB0A9DCu, 0x76F988DAu, 0x983E5152u,
     0xA831C66Du, 0xB00327C8u, 0xBF597FC7u, 0xC6E00BF3u, 0xD5A79147u,
     0x06CA6351u, 0x14292967u, 0x27B70A85u, 0x2E1B2138u, 0x4D2C6DFCu,
     0x53380D13u, 0x650A7354u, 0x766A0ABBu, 0x81C2C92Eu, 0x92722C85u,
     0xA2BFE8A1u, 0xA81A664Bu, 0xC24B8B70u, 0xC76C51A3u, 0xD192E819u,
     0xD6990624u, 0xF40E3585u, 0x106AA070u, 0x19A4C116u, 0x1E376C08u,
     0x2748774Cu, 0x34B0BCB5u, 0x391C0CB3u, 0x4ED8AA4Au, 0x5B9CCA4Fu,
     0x682E6FF3u, 0x748F82EEu, 0x78A5636Fu, 0x84C87814u, 0x8CC70208u,
     0x90BEFFFAu, 0xA4506CEBu, 0xBEF9A3F7u, 0xC67178F2u]

rotate_right(value: uint, count: int) -> uint =>
    (value >>> count) | (value << (32 - count))

padded(message: ubyte[]) -> LIST[ubyte] is
    let bits = ulong(message.count) * 8ul

    let block = LIST(message)

    block.add(0x80ub)

    while block.count % 64 != 56 do
        block.add(0ub)
    od

    for index in 0..8 do
        block.add(ubyte((bits >>> (56 - 8 * index)) & 0xFFul))
    od

    return block
si

word(block: LIST[ubyte], at: int) -> uint =>
    0..4
        |> map(index =>
            uint(block[at + index]) << (24 - 8 * index))
        |> reduce(0u, (packed, part) => packed | part)

sha256(message: ubyte[]) -> string is
    let block = padded(message)

    let state =
        LIST([0x6A09E667u, 0xBB67AE85u, 0x3C6EF372u, 0xA54FF53Au,
              0x510E527Fu, 0x9B05688Cu, 0x1F83D9ABu, 0x5BE0CD19u])

    let start mut = 0

    while start < block.count do
        let schedule =
            0..16
                |> map(index => word(block, start + index * 4))
                |> collect_mutable()

        for index in 16..64 do
            let previous = schedule[index - 15]
            let recent = schedule[index - 2]

            let spread =
                rotate_right(previous, 7) ^ rotate_right(previous, 18) ^
                (previous >>> 3)

            let mixed =
                rotate_right(recent, 17) ^ rotate_right(recent, 19) ^
                (recent >>> 10)

            schedule.add(
                schedule[index - 16] + spread + schedule[index - 7] + mixed)
        od

        let working = LIST(state)

        for step in 0..64 do
            let (a, b, c, d) =
                (working[0], working[1], working[2], working[3])

            let (e, f, g, h) =
                (working[4], working[5], working[6], working[7])

            let choice = (e & f) ^ (\e & g)
            let majority = (a & b) ^ (a & c) ^ (b & c)

            let sum_e =
                rotate_right(e, 6) ^ rotate_right(e, 11) ^
                rotate_right(e, 25)

            let sum_a =
                rotate_right(a, 2) ^ rotate_right(a, 13) ^
                rotate_right(a, 22)

            let first =
                h + sum_e + choice + round_constants[step] + schedule[step]

            working[7] = g
            working[6] = f
            working[5] = e
            working[4] = d + first
            working[3] = c
            working[2] = b
            working[1] = a
            working[0] = first + sum_a + majority
        od

        for index in 0..8 do
            state[index] = state[index] + working[index]
        od

        start = start + 64
    od

    return state |> map(value => "{value:x8}") |> join("")
si

hex(digest: ubyte[]) -> string =>
    digest |> map(byte_value => "{byte_value:x2}") |> join("")

let messages = ["", "abc", "Rosetta code"]

for message in messages do
    let octets = System.Text.Encoding.utf8.get_bytes(message)

    let expected =
        hex(System.Security.Cryptography.SHA256.hash_data(octets))

    assert sha256(octets) =~ expected
    else "does not agree with the digest .NET computes"

    write_line("{sha256(octets)}  \"{message}\"")
od
