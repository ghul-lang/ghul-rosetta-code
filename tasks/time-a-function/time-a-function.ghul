use default
use System.Diagnostics.Stopwatch

// Process time rather than wall-clock time, so another program running at
// the same time does not show up as this one taking longer.
spent() -> double =>
    let process = System.Diagnostics.Process.get_current_process() in
    process.total_processor_time.total_milliseconds

timed(name: string, work: () -> int) =>
    let
        clock = Stopwatch.start_new(),
        before = spent(),
        answer = work(),
        elapsed = clock.elapsed.total_milliseconds,
        processor = spent() - before
    in
        write_line(
            "{name,-22} {answer,12}  {elapsed,8:F2} ms elapsed  "
            "{processor,8:F2} ms processor"
        )

count_primes(limit: int) -> int => 2..limit |> count(is_prime)

timed("primes below 1000000", () => count_primes(1_000_000))
timed("primes below 10000000", () => count_primes(10_000_000))
