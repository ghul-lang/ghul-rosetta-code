use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read, and `count` reads it all

riordan(count: int) -> bigint{} is
    let previous mut = 1n
    let current mut = 0n

    yield previous

    for index in 1..count do
        yield current

        let following =
            cast(index) * (2n * current + 3n * previous) / cast(index + 2)

        previous = current
        current = following
    od
si

let first = riordan(32) |> list()

for row in 0..8 do
    let line = first[row * 4..row * 4 + 4] |> map(term => "{term,14}")

    write_line(line |> join(""))
od

digits(index: int) -> int =>
    (riordan(index + 1) |> list())[index].to_string().length

write_line("")
write_line("the 1,000th Riordan number has {digits(1_000)} digits")
write_line("the 10,000th has {digits(10_000)} digits")
