use default

riordan() -> bigint{} =>
    stream(
        (0, 1n, 0n),
        (index, previous, current) =>
            let following =
                cast(index + 1) * (2n * current + 3n * previous) /
                    cast(index + 3) in
            previous || (index + 1, current, following))

let grid = riordan() |> take(32) |> collect()

for row in 0..8 do
    let line = grid[row * 4..row * 4 + 4] |> map(term => "{term,14}")

    write_line(line |> join(""))
od

digits(index: int) -> int =>
    (riordan() |> skip(index) |> first())!.to_string().length

write_line("")
write_line("the 1,000th Riordan number has {digits(1_000)} digits")
write_line("the 10,000th has {digits(10_000)} digits")
