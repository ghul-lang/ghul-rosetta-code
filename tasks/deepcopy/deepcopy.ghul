use default

class NODE(label: string public) is
    links: LIST[NODE]

    init(..) is
        links = LIST()
    si

    to_string() -> string =>
        "{label} -> {links |> map(n => n.label) |> join(", ")}"
si

deep_copy(node: NODE) -> NODE is
    let seen = MAP()

    copy_into(source) is
        if seen.contains_key(source) then
            return seen[source]
        fi

        let copy = NODE(source.label)

        seen[source] = copy

        source.links |> each(link => copy.links.add(copy_into(link)))

        copy
    si

    copy_into(node)
si

let a = NODE("a")
let b = NODE("b")
let c = NODE("c")

a.links.add(b)
b.links.add(c)
c.links.add(a)
c.links.add(c)

let copy = deep_copy(a)

a.label = "a, renamed"

write_line("original: {a}")
write_line("copy:     {copy}")

let copy_of_b = copy.links[0]
let copy_of_c = copy_of_b.links[0]

write_line("the cycle is a cycle: {copy_of_c.links[0] == copy}")
write_line("the self link too:    {copy_of_c.links[1] == copy_of_c}")
write_line("and nothing is shared: {copy_of_b == b}")
