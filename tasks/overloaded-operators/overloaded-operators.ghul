use default

// Operators declared as members of the type, with the left operand as self.
struct Vector(x: double public, y: double public) is
    +(other: Vector) -> Vector => Vector(x + other.x, y + other.y)

    -(other: Vector) -> Vector => Vector(x - other.x, y - other.y)

    *(scale: double) -> Vector => Vector(x * scale, y * scale)

    ⊗(other: Vector) -> double => x * other.x + y * other.y

    to_string() -> string => "({x}, {y})"
si

// Operators declared as global functions, taking both operands, for a type
// that declares none of its own.
struct Money(pennies: int public) is
    to_string() -> string => "{pennies / 100}.{pennies % 100,2:00}"
si

+(a: Money, b: Money) -> Money => Money(a.pennies + b.pennies)

*(a: Money, times: int) -> Money => Money(a.pennies * times)

<>(a: Money, b: Money) -> int => a.pennies - b.pennies

let a = Vector(1.0, 2.0)
let b = Vector(3.0, 4.0)

write_line("{a} + {b} = {a + b}")
write_line("{b} - {a} = {b - a}")
write_line("{a} * 3 = {a * 3.0}")
write_line("{a} ⊗ {b} = {a ⊗ b}")

let small = Money(199)
let large = Money(250)

write_line("{small} + {large} = {small + large}")
write_line("{small} * 3 = {small * 3}")
write_line("{small} < {large}: {small < large}")

write_line("the intrinsics are overloaded too:")
write_line("  2 + 3 = {2 + 3}")
write_line("  2.5 + 3.5 = {2.5 + 3.5}")
write_line("  2n + 3n = {2n + 3n}")
