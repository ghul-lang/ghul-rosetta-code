use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `if let` and `case ... when` pattern-match; `[x, ..rest]` matches a list.

greatest[T: Ghul.Comparable[T]](values: T{}) -> T? =>
    values |> max_by(value => value)

if let biggest = greatest([3, 9, 4, 1]) then
    write_line("{biggest}")
fi

if let longest = greatest(["pear", "fig", "quince"]) then
    write_line("{longest}")
fi
