use default

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

summarize(term: string) -> string =>
    let counts = term |> frequencies() in
    counts.keys
        |> sort((left, right) => right <> left)
        |> map(digit => "{counts[digit]}{digit}")
        |> join("")

sequence(seed: int) -> string[] => (
    let terms = LIST()
    let seen = SET()

    let term mut = "{seed}"

    while seen.add(term) do
        terms.add(term)
        term = summarize(term)
    od

    terms
)

canonical(seed: int) -> string => string("{seed}" |> sort())

let lengths = MAP()

for seed in 1..1000000 do
    let key = canonical(seed)

    if !lengths.contains_key(key) then
        lengths[key] = sequence(seed).count
    fi
od

let longest = lengths.values |> max() ?? 0

let winners =
    (1..1000000)
        |> filter(seed => lengths[canonical(seed)] == longest)
        |> list()

write_line("seed values: {winners |> join(" ")}")
write_line("")
write_line("iterations: {longest}")
write_line("")

for term in sequence(winners[0]) do
    write_line(term)
od
