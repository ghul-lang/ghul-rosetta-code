use default

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `if let` and `case ... when` pattern-match; `[x, ..rest]` matches a list.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

quibble(words: string[]) -> string =>
    case words.count
    when 0 then "{{}}"
    when 1 then "{{{words[0]}}}"
    else
        let front = words[0..<1] |> join()

        "{{{front} and {words[words.count - 1]}}}"
    esac

let examples = [
    [],
    ["ABC"],
    ["ABC", "DEF"],
    ["ABC", "DEF", "G", "H"]
]

for words in examples do
    write_line(quibble(words))
od
