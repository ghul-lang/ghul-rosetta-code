use default

// `T[]` is the read-only list trait - elements can be read by index
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `case ... when` pattern-matches, and `[x, ..rest]` matches a list head
//  and tail

quibble(words: string[]) -> string =>
    case words.count
    when 0 then "{{}}"
    when 1 then "{{{words[0]}}}"
    else
        let front = words[0..<1] |> join()

        "{{{front} and {words[words.count - 1]}}}"
    esac

let examples = [
    [],
    ["ABC"],
    ["ABC", "DEF"],
    ["ABC", "DEF", "G", "H"]
]

for words in examples do
    write_line(quibble(words))
od
