use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

identity(size: int) -> string{} =>
    (0..size)
        |> map(row =>
            (0..size)
                |> map(column => if row == column then "1" else "0" fi)
                |> join(" ")
        )

for row in identity(5) do
    write_line(row)
od
