use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

identity(size: int) -> string{} =>
    (0..size)
        |> map(row =>
            (0..size)
                |> map(column => if row == column then "1" else "0" fi)
                |> join(" ")
        )

for row in identity(5) do
    write_line(row)
od
