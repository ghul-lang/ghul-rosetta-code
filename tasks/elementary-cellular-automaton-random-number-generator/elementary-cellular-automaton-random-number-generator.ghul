use default

use System.Numerics.BitOperations

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

// 64 cells in a ring, held as the bits of one ulong, starting from a
// single live cell at bit 0; rule 30 is left XOR (centre OR right).

rule_30(cells: ulong) -> ulong =>
    BitOperations.rotate_right(cells, 1) ^
    (cells | BitOperations.rotate_left(cells, 1))

random_bytes() -> int{} is
    let cells mut = 1UL

    for _ in from(0) do
        let byte mut = 0

        for _ in 0..8 do
            byte = (byte << 1) | int(cells & 1UL)
            cells = rule_30(cells)
        od

        yield byte
    od
si

write_line(random_bytes() |> take(10) |> join(" "))
