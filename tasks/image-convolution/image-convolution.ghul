use default
use Raster.Anchor
use Raster.IMAGE

scene() is
    let image = IMAGE(160, 120)

    for y in 0..80 do
        let t = double(y) / 80.0

        image.color(
            ubyte(40.0 + 200.0 * t),
            ubyte(70.0 + 100.0 * t),
            ubyte(160.0 - 60.0 * t)
        )
        image.fill_rectangle(0.0, double(y), 160.0, double(y + 1))
    od

    image.color(255ub, 220ub, 60ub)
    image.disc(112.0, 42.0, 15.0)

    image.color(90ub, 60ub, 120ub)
    image.fill([
        (0.0, 80.0),
        (45.0, 30.0),
        (95.0, 80.0)
    ])

    image.color(60ub, 110ub, 70ub)
    image.fill([
        (55.0, 80.0),
        (105.0, 48.0),
        (160.0, 80.0)
    ])

    image.color(70ub, 150ub, 60ub)
    image.fill_rectangle(0.0, 80.0, 160.0, 120.0)

    image.color(200ub, 35ub, 40ub)
    image.fill_rectangle(22.0, 88.0, 52.0, 110.0)

    image.color(120ub, 25ub, 30ub)
    image.fill([
        (18.0, 88.0),
        (37.0, 75.0),
        (56.0, 88.0)
    ])

    image.color(250ub, 245ub, 235ub)
    image.fill_rectangle(33.0, 97.0, 41.0, 110.0)

    image
si

use Kernel = (name: string, weights: int[], divisor: int)

channel(value) => ubyte(clamp(round(value), 0.0, 255.0))

convolve(source, kernel) is
    let result = IMAGE(source.width, source.height)
    let divisor = double(kernel.divisor)

    for y in 0..source.height do
        for x in 0..source.width do
            let around = [
                (
                    double(kernel.weights[(j + 1) * 3 + i + 1]),
                    source.pixel(
                        clamp(x + i, 0, source.width - 1),
                        clamp(y + j, 0, source.height - 1)
                    )
                )
                for j in -1::1
                for i in -1::1
            ]

            let red = around |> map(((w, p)) => w * double(p.red)) |> sum()
            let green =
                around |> map(((w, p)) => w * double(p.green)) |> sum()
            let blue =
                around |> map(((w, p)) => w * double(p.blue)) |> sum()

            result.set_pixel(
                x,
                y,
                channel(red / divisor),
                channel(green / divisor),
                channel(blue / divisor)
            )
        od
    od

    result
si

let kernels: Kernel[] = [
    ("blur", [1, 2, 1, 2, 4, 2, 1, 2, 1], 16),
    ("sharpen", [0, -1, 0, -1, 5, -1, 0, -1, 0], 1),
    ("edges", [-1, -1, -1, -1, 8, -1, -1, -1, -1], 1),
    ("emboss", [-2, -1, 0, -1, 1, 1, 0, 1, 2], 1)
]

scene().write("scene.png")

let source = IMAGE.read("scene.png")
kernels |> each(k => write_line("{k.name,-8} {k.weights |> join(" ")}"))

let results =
    [("original", source)] ++
    (kernels |> map(k => (k.name, convolve(source, k))))

let cell_width = source.width + 10, cell_height = source.height + 24
let sheet = IMAGE(cell_width * 3 + 10, cell_height * 2 + 10)

sheet.clear(235ub, 235ub, 230ub)

for (i, (name, image)) in results |> index() do
    let left = 10 + i % 3 * cell_width, top = 10 + i / 3 * cell_height

    for y in 0..image.height do
        for x in 0..image.width do
            let p = image.pixel(x, y)

            sheet.set_pixel(left + x, top + y, p.red, p.green, p.blue)
        od
    od

    sheet.color(40ub, 40ub, 40ub)
    sheet.text(
        double(left + image.width / 2),
        double(top + image.height + 15),
        11.0,
        name,
        Anchor.CENTER
    )
od

sheet.write("filters.png")

sheet.show("filters.png")
