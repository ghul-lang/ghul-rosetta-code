use default
use Ghul.Interop.size_of

let word_bits = size_of[word]() * 8

write_line("word size: {word_bits} bits")

let one = Ghul.Math.BitConverter.get_bytes(1)

write_line("endianness: {if one[0] == 1ub then "little" else "big" fi}")
write_line("BitConverter agrees: {Ghul.Math.BitConverter.is_little_endian}")
