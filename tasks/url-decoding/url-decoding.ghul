use default
use System.Convert
use System.Text.Encoding

decoded_bytes(text: string, at: int) -> ubyte{} is
    if at < text.length then
        if text[at] == '%' /\ at + 2 < text.length then
            yield Convert.to_byte(text[at + 1..at + 3], 16)
            yield in decoded_bytes(text, at + 3)
        else
            yield ubyte(text[at])
            yield in decoded_bytes(text, at + 1)
        fi
    fi
si

url_decode(text: string) -> string =>
    Encoding.utf8.get_string(decoded_bytes(text, 0) |> collect())

["http%3A%2F%2Ffoo%20bar%2F",
 "google.com/search?q=%60Abdu%27l-Bah%C3%A1",
 "%25%32%35"]
    |> each(encoded =>
        write_line("{encoded} -> {url_decode(encoded)}"))
