use default

let witnesses = [2L, 3L, 5L, 7L, 11L, 13L, 17L, 19L, 23L, 29L, 31L, 37L]

mod_pow(base: long, exponent: long, modulus: long) -> long =>
    long(bigint.mod_pow(cast(base), cast(exponent), cast(modulus)))

composite_by(witness: long, odd_part: long, twos: int, n: long) -> bool is
    let residue mut = mod_pow(witness, odd_part, n)

    if residue == 1L \/ residue == n - 1L then
        return false
    fi

    for _ in 1..twos do
        residue = mod_pow(residue, 2L, n)

        if residue == n - 1L then
            return false
        fi
    od

    return true
si

prime(n: long) -> bool is
    for witness in witnesses do
        if n == witness then
            return true
        fi

        if n % witness == 0L then
            return false
        fi
    od

    let odd_part mut = n - 1L

    let twos mut = 0

    while odd_part % 2L == 0L do
        odd_part = odd_part / 2L

        twos = twos + 1
    od

    for witness in witnesses do
        if composite_by(witness, odd_part, twos, n) then
            return false
        fi
    od

    return true
si

let index mut = 42L

let found mut = 0

while found < 42 do
    index = index + 1L

    if prime(index) then
        found = found + 1

        write_line("{found,2}: {index,20:N0}")

        index = index + index
    fi
od
