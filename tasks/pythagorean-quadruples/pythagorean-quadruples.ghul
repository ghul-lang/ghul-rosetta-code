use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `LIST()` builds a collection eagerly

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `LIST()`, `SET()`, `MAP()` and `ARRAY()` build the collection eagerly.

let limit = 2_200

let two_squares = repeat(false, 2 * limit * limit + 1) |> LIST()

for a in 1::limit do
    for b in a::limit do
        two_squares[a * a + b * b] = true
    od
od

let represented = repeat(false, limit + 1) |> LIST()

for d in 1::limit do
    represented[d] = 1..d |> any(c => two_squares[d * d - c * c])
od

write_line(1::limit |> filter(d => !represented[d]) |> join(" "))
