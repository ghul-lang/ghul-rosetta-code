use default

let limit = 2_200

let two_squares =
    repeat(false, 2 * limit * limit + 1) |> collect_mutable()

for a in 1::limit do
    for b in a::limit do
        two_squares[a * a + b * b] = true
    od
od

let represented = repeat(false, limit + 1) |> collect_mutable()

for d in 1::limit do
    represented[d] =
        1..d |> any(c => two_squares[d * d - c * c])
od

write_line(
    1::limit |> filter(d => !represented[d]) |> join(" ")
)
