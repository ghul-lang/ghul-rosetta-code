use default

has_five_weekends(year: int, month: int) -> bool =>
    Time.DATE_TIME.days_in_month(year, month) == 31 /\
    Time.DATE_TIME(year, month, 1).day_of_week == Time.DayOfWeek.FRIDAY

let years = 1900::2100

let months = [
    Time.DATE_TIME(year, month, 1)
    for year in years
    for month in 1::12
    if has_five_weekends(year, month)
]

show(label: string, dates: Time.DATE_TIME{}) is
    write_line(label)

    dates |> each(date => write_line("  {date.to_string("yyyy-MM")}"))
si

write_line("{months.count} months have five full weekends")
write_line("")

show("first five:", months |> take(5))
show("last five:", months |> skip(months.count - 5))

let barren =
    years
        |> filter(year =>
            1::12 |> all(month => !has_five_weekends(year, month))
        )

write_line("{barren |> count()} years have none")
