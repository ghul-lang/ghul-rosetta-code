use default

class NODE[T](value: T) is
    next: NODE[T]?
    previous: NODE[T]?

    insert_after(value: T) -> NODE[T] is
        let inserted = NODE(value)

        inserted.previous = self
        inserted.next = next

        if let following = next then
            following.previous = inserted
        fi

        next = inserted

        inserted
    si

    insert_before(value: T) -> NODE[T] is
        let inserted = NODE(value)

        inserted.next = self
        inserted.previous = previous

        if let preceding = previous then
            preceding.next = inserted
        fi

        previous = inserted

        inserted
    si
si

class DOUBLY_LINKED_LIST[T] is
    head: NODE[T]?
    tail: NODE[T]?

    init() is si

    add_to_head(value: T) -> NODE[T] is
        let added =
            if let first = head then
                first.insert_before(value)
            else
                NODE(value)
            fi

        if !tail? then
            tail = added
        fi

        head = added

        added
    si

    add_to_tail(value: T) -> NODE[T] is
        let added =
            if let last = tail then
                last.insert_after(value)
            else
                NODE(value)
            fi

        if !head? then
            head = added
        fi

        tail = added

        added
    si

    add_after(existing: NODE[T], value: T) -> NODE[T] is
        let added = existing.insert_after(value)

        if existing == tail then
            tail = added
        fi

        added
    si

    values() -> T{} is
        let cursor mut = head

        while let node = cursor do
            yield node.value
            cursor = node.next
        od
    si
si

let list = DOUBLY_LINKED_LIST()

let two = list.add_to_tail(2)
list.add_to_tail(4)
list.add_to_head(1)
list.add_after(two, 3)

write_line(list.values() |> join())
