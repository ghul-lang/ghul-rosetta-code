use default

ethiopian(left, right) =>
    iterate(
        (multiplier = left, total = right),
        row => (
            multiplier = halve(row.multiplier),
            total = double(row.total)
        )
    )
        |> take_while(row => row.multiplier > 0)
        |> filter(row => !is_even(row.multiplier))
        |> sum_by(row => row.total)

halve(value) => value / 2

double(value) => value * 2

is_even(value) => value % 2 == 0

write_line("17 x 34 = {ethiopian(17, 34)}")
