use default

use System.Text.RegularExpressions.Regex
use IO.Std.read_line

// Every character becomes an x, so one line is at least as long as
// another exactly when its run of x's starts with the other's: no
// length is ever held as a number or compared.
relation(line: string, longest: string) -> string =>
    let
        line_marks = Regex.replace(line, ".", "x"),
        longest_marks = Regex.replace(longest, ".", "x")
    in
        if !line_marks.starts_with(longest_marks) then
            "shorter"
        elif longest_marks.starts_with(line_marks) then
            "same"
        else
            "longer"
        fi

// The lines tied for longest are kept as one string, joined with line
// breaks, rather than in a list.
longest_lines(longest: string, ties: string) -> string =>
    if let line = read_line() then
        case relation(line, longest)
        when "longer" then longest_lines(line, line)
        when "same" then
            longest_lines(longest, "{ties}\n{line}")
        else longest_lines(longest, ties)
        esac
    else
        ties
    fi

write_line("Enter lines; the longest are printed at the end:")

if let first = read_line() then
    write_line(longest_lines(first, first))
fi
