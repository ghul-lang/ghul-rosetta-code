use default
use System.Reflection.BindingFlags

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `LIST()` builds a collection eagerly

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `LIST()`, `SET()`, `MAP()` and `ARRAY()` build the collection eagerly.

class ROBOT is
    _charge: int

    init() is
        _charge = 100
    si

    walk(steps: int) -> int is
        _charge = _charge - steps

        _charge
    si

    charge() is
        _charge = 100
    si

    _diagnose() -> string => "charge {_charge}"
si

let robot = ROBOT()
let flags = BindingFlags.INSTANCE | BindingFlags.PUBLIC

let declared =
    robot.get_type().get_methods(flags)
        |> filter(m => m.declaring_type == robot.get_type())
        |> map(m =>
            let parameters =
                m.get_parameters()
                    |> map(p => "{p.parameter_type.name} {p.name}")
                    |> join(", ")
            in
            "{m.name}({parameters}) -> {m.return_type.name}"
        )
        |> LIST()

declared.sort((left: string, right: string) -> int =>
    string.compare(left, right)
)

declared |> each(line => write_line(line))

write_line("")
write_line("inherited from object:")

robot.get_type().get_methods(flags)
    |> filter(m => m.declaring_type != robot.get_type())
    |> map(m => m.name)
    |> each(name => write_line("  {name}"))
