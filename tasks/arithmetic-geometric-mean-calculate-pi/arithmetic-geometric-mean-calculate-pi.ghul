use default

use State = (a: bigint, g: bigint, total: bigint, weight: bigint)

let digits = 100
let guard = 12

power_of_ten(n: int) -> bigint => repeat(10n, n) |> product()

integer_sqrt(n: bigint) -> bigint =>
    if n < 2n then n else newton(n, n) fi

newton(n: bigint, root: bigint) -> bigint =>
    let next = (root + n / root) / 2n in
    if next < root then newton(n, next) else root fi

let scale = power_of_ten(digits + guard)

pi(rounds: int) -> bigint =>
    let
        start = (scale, integer_sqrt(scale * scale / 2n), 0n, 4n),
        (a, _, total, _) =
            1::rounds |> reduce(start, ((a, g, total, weight), _) =>
                let
                    next_a = (a + g) / 2n,
                    next_g = integer_sqrt(a * g)
                in
                    (next_a, next_g,
                        total + weight *
                            (next_a * next_a - next_g * next_g) / scale,
                        weight * 2n))
    in
        4n * a * a / (scale - total)

let text = (pi(10) / power_of_ten(guard)).to_string()

write_line("{text[0..1]}.{text[1..text.length]}")
