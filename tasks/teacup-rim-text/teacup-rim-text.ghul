use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `LIST()`, `SET()`, `MAP()` and `ARRAY()` build the collection eagerly.

rotations(word: string) -> string{} =>
    0..word.length |> map(i => "{word.substring(i)}{word.substring(0, i)}")

let words = SET(IO.File.read_all_lines("unixdict.txt"))
let shown = SET()

for word in words |> filter(w => w.length > 2) |> sort() do
    let ring = rotations(word)
    let distinct = ring |> SET()

    if distinct.count > 1 /\ ring |> all(words.contains) then
        let key = ring |> sort() |> join(" ")

        if shown.add(key) then
            write_line(ring |> join(" "))
        fi
    fi
od
