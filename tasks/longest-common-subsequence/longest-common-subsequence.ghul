use default

longest_common_subsequence(left: string, right: string) -> string is
    let known = MAP()

    let longest = (i, j) rec =>
        if i == left.length \/ j == right.length then
            ""
        elif known.contains_key((i, j)) then
            known[(i, j)]
        else
            let answer =
                if left[i] == right[j] then
                    "{left[i]}{rec(i + 1, j + 1)}"
                else
                    let dropping_left = rec(i + 1, j)
                    let dropping_right = rec(i, j + 1)

                    if dropping_left.length >= dropping_right.length then
                        dropping_left
                    else
                        dropping_right
                    fi
                fi

            known[(i, j)] = answer

            answer
        fi

    longest(0, 0)
si

[("1234", "1224533324"),
 ("thisisatest", "testing123testing"),
 ("XMJYAUZ", "MZJAWXU")]
    |> each(pair => (
        let (left, right) = pair
        write_line("{left} and {right}:"
            " {longest_common_subsequence(left, right)}")))
