use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`

let random = System.Random(2026)

let words =
    IO.File.read_all_lines("unixdict.txt")
        |> filter(w => w.length >= 4 /\ w.length <= 8)
        |> filter(w => w |> all(char.is_letter(*)))
        |> list()

capitalised(word: string) -> string =>
    "{char.to_upper(word[0])}{word[1..<0]}"

random_word() -> string =>
    let word = words[random.next(words.count)] in
    "{capitalised(word)}{random.next(10, 100)}"

passphrase(n: int) -> string => 1::n |> map(_ => random_word()) |> join("-")

for n in [3, 5, 7] do
    write_line("{n} words: {passphrase(n)}")
od
