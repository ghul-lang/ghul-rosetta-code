use default

totals(dice: int, faces: int) -> List[long] is
    let counts = LIST([1L])

    for _ in 0..dice do
        let next = repeat(0L, counts.count + faces) |> collect_mutable()

        for (total, ways) in counts |> index() do
            for face in 1::faces do
                next[total + face] = next[total + face] + ways
            od
        od

        counts.clear()
        counts.add_range(next)
    od

    counts
si

beats(dice1: int, faces1: int, dice2: int, faces2: int) -> double =>
    let first = totals(dice1, faces1), second = totals(dice2, faces2) in
    let wins =
        first
            |> index()
            |> sum_by((a, ways) =>
                ways * (second |> take(a) |> sum()))
    in
    let games = (first |> sum()) * (second |> sum()) in
    double(wins) / double(games)

let first = beats(9, 4, 6, 6)
let second = beats(5, 10, 6, 7)

write_line("nine 4-sided dice beat six 6-sided dice: {first:F7}")
write_line("five 10-sided dice beat six 7-sided dice: {second:F7}")
