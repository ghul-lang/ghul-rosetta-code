use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

bernoulli(rows: int) -> int[]{} is
    let row mut = LIST()
    row.add(1)

    for number in 0..rows do
        yield row

        let following = LIST()
        following.add(1)

        for column in 1::row.count - 1 do
            following.add(row[column - 1] + row[column])
        od

        following.add(row[row.count - 1] * 2)

        row = following
    od
si

for row in bernoulli(15) do
    write_line(row |> map(value => "{value,7}") |> join(""))
od
