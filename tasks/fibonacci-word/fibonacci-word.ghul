use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

words() -> string{} is
    let earlier mut = "1"
    let later mut = "0"

    yield earlier

    while true do
        yield later

        let next = "{later}{earlier}"

        earlier = later
        later = next
    od
si

entropy(word: string) -> double =>
    let total = double(word.length) in
    word
        |> group_by(c => c)
        |> map(group => double(group.value.count) / total)
        |> reduce(0.0D, (bits, probability) =>
            bits - probability * log2(probability)
        )

write_line("   N      length            entropy")

words()
    |> take(37)
    |> index(1)
    |> each(word => (
        let bits = entropy(word.value)
        write_line("{word.index,4}{word.value.length,12}{bits,20:F15}")
    ))
