use default
use System.Math

words() -> string{} is
    let earlier mut = "1"
    let later mut = "0"

    yield earlier

    while true do
        yield later

        let next = "{later}{earlier}"

        earlier = later
        later = next
    od
si

entropy(word: string) -> double =>
    let total = double(word.length) in
    "01"
        |> map(symbol => double(word |> count(c => c == symbol)) / total)
        |> filter(probability => probability > 0.0D)
        |> reduce(0.0D, (bits, probability) =>
            bits - probability * Math.log2(probability))

write_line("   N      length            entropy")

words()
    |> take(37)
    |> index(1)
    |> each(word => (
        let bits = entropy(word.value)
        write_line("{word.index,4}{word.value.length,12}{bits,20:F15}")))
