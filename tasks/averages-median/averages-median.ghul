use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

median(values: double{}) -> double is
    let ordered = values |> sort() |> list()

    assert ordered.count > 0 else "the median of no values is not defined"

    let middle = ordered.count / 2

    return
        if ordered.count % 2 == 1 then
            ordered[middle]
        else
            (ordered[middle - 1] + ordered[middle]) / 2.0
        fi
si

write_line("{median([4.1, 5.6, 7.2, 1.7, 9.3, 4.4, 3.2])}")
write_line("{median([4.1, 7.2, 1.7, 9.3, 4.4, 3.2])}")
