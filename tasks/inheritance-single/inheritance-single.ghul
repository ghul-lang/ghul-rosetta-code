use default

class Animal abstract is
    init() is si
si

class Dog: Animal abstract is
    init() is
        super.init()
    si
si

class CAT: Animal is
    init() is
        super.init()
    si
si

class LAB: Dog is
    init() is
        super.init()
    si
si

class COLLIE: Dog is
    init() is
        super.init()
    si
si

write_line(
    "Animal <- Dog <- Lab: {isa Animal(LAB())}, {isa Dog(LAB())}"
)
write_line(
    "Animal <- Dog <- Collie: {isa Animal(COLLIE())}, "
    "{isa Dog(COLLIE())}"
)
write_line("Animal <- Cat: {isa Animal(CAT())}")
write_line("Cat is not a Dog: {!isa Dog(CAT())}")
