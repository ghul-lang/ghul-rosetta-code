use default
use Raster.AXES
use Raster.IMAGE
use System.Math.*

use Math = System.Math

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read

let n = 2.5D
let a = 200.0D
let b = 200.0D

shaped(turn: double, half_axis: double) -> double => (
    let value = pow(abs(turn), 2.0D / n) * half_axis

    if turn < 0.0D then -value else value fi
)

outline(steps: int) -> (x: double, y: double){} =>
    (0::steps)
        |> map(step => (
            let angle = 2.0D * pi * double(step) / double(steps)

            (x = shaped(cos(angle), a), y = shaped(sin(angle), b))
        ))

let image = IMAGE(560, 560)

image.view(-230.0D, -230.0D, 230.0D, 230.0D, 56.0D)

image.colour(120ub, 120ub, 120ub)
image.stroke(1.0D)

AXES(image).draw()

image.colour(180ub, 30ub, 60ub)
image.stroke(2.0D)

image.line(outline(720) |> list())

image.write("superellipse.png")

image.show("superellipse.png")
