use default

is_prime(n: int) -> bool is
    if n < 2 then
        return false
    elif n % 2 == 0 then
        return n == 2
    fi

    let factor mut = 3

    while factor * factor <= n do
        if n % factor == 0 then
            return false
        fi

        factor = factor + 2
    od

    return true
si

// Chernick's method. For each prime p1, try every h3 below p1, and every
// d below h3 + p1 that meets the two divisibility conditions.
carmichaels() -> (int, int, int){} is
    for p1 in 2::61 |> filter(is_prime) do
        for h3 in 2..p1 do
            let sum = h3 + p1

            let allowed = 1..sum |> filter(d =>
                (sum * (p1 - 1)) % d == 0 /\
                ((-p1 * p1) % h3 + h3) % h3 == d % h3)

            for d in allowed do
                let p2 = 1 + (p1 - 1) * sum / d
                let p3 = 1 + p1 * p2 / h3

                if is_prime(p2) /\ is_prime(p3) /\
                    (p2 * p3) % (p1 - 1) == 1 then
                    yield (p1, p2, p3)
                fi
            od
        od
    od
si

let found = carmichaels() |> collect()

for (p1, p2, p3) in found do
    write_line("{p1,4} x {p2,5} x {p3,6} = {p1 * p2 * p3,10}")
od

write_line("")
write_line("{found.count} Carmichael numbers")
