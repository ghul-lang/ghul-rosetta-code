use default
use Raster.ANIMATION
use Raster.IMAGE

class DROP is
    x: double public
    y: double public
    dx: double public
    dy: double public

    init() is si
si

let width = 240
let height = 180
let total = 1500
let gravity = 0.1
let warm_up = 200
let frames = 50

let random = System.Random(7)

spread(half: double) -> double => (random.next_double() * 2.0 - 1.0) * half

launch(drop: DROP) is
    drop.x = double(width / 2) + spread(1.5)
    drop.y = double(height - 10)
    drop.dx = spread(0.9)
    drop.dy = -3.8 + spread(0.3)
si

let drops =
    (0..total)
        |> map(i => (
            let drop = DROP()
            launch(drop)
            drop.y = double(height + i % 80)
            drop
        ))
        |> ARRAY()

step() is
    for drop in drops do
        if drop.y > double(height) then
            if random.next_double() < 0.1 then
                launch(drop)
            fi

            continue
        fi

        drop.dy = drop.dy + gravity
        drop.x = drop.x + drop.dx
        drop.y = drop.y + drop.dy
    od
si

airborne() -> int =>
    drops |> filter(drop => drop.y <= double(height)) |> count()

draw(image: IMAGE) is
    image.clear(10ub, 15ub, 35ub)

    for drop in drops do
        if drop.y <= double(height) then
            let fall = clamp(drop.dy / 3.8, -1.0, 1.0)
            let shade = ubyte(170 + int(80.0 * fall * fall))

            image.color(shade - 60ub, shade, 255ub)
            image.dot(drop.x, drop.y, 0.8)
        fi
    od
si

for _ in 0..warm_up do
    step()
od

let image = IMAGE(width, height)
let animation = ANIMATION(width, height)

for frame in 0..frames do
    if frame % 25 == 0 then
        write_line("frame {frame,3}: {airborne()} drops in the air")
    fi

    draw(image)
    animation.add(image, 40)
    step()
od

animation.write("fountain.png")

animation.show("fountain.png")
