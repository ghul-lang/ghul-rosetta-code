use default

// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `SET[T]` is a mutable set, holding each element once
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|> SET()` reads the whole sequence into a new `SET`
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`
// `==` compares identity

let symbols = "0123456789ABCDEF"

in_base(n: long, base: int) -> string =>
    n |> digits(long(base)) |> map(d => symbols[int(d)]) |> string()

value_of(digits: string, base: int) -> long =>
    digits
        |> reduce(0L, (total, c) =>
            total * long(base) + long(symbols.index_of(c))
        )

is_penholodigital(square: long, base: int) -> bool =>
    let ds = square |> digits(long(base)) |> list() in
    ds.count == base - 1 /\
    ds |> SET() |> count() == ds.count /\
    ds |> all(* > 0L)

roots(base: int) -> long[] is
    let smallest = value_of(symbols.substring(1, base - 1), base)
    let largest = value_of(reversed(symbols.substring(1, base - 1)), base)
    let modulus = long(base - 1)
    let residue = long(base * (base - 1) / 2) % modulus

    from(long(sqrt(double(smallest))))
        |> filter(n => n * n >= smallest)
        |> take_while(n => n * n <= largest)
        |> filter(n => n * n % modulus == residue)
        |> filter(n => is_penholodigital(n * n, base))
        |> list()
si

reversed(s: string) -> string => string(s.to_char_array() |> reverse())

show(n: long, base: int) -> string =>
    "{in_base(n, base)}² = {in_base(n * n, base)}"

for base in 9::15 do
    let found = roots(base)
    let shown =
        if base <= 12 \/ found.count < 2 then found
        else LIST([found[0], found[found.count - 1]])
        fi

    write_line(
        "There are {found.count} penholodigital squares in base {base}:"
    )

    for row in 0..(shown.count + 2) / 3 do
        let cells = shown |> skip(row * 3) |> take(3)

        write_line(cells |> map(show(*, base)) |> join("  "))
    od

    write_line("")
od
