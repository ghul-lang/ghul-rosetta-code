use Ghul.Pipes
use Raster.IMAGE

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

luminance(red: ubyte, green: ubyte, blue: ubyte) -> ubyte =>
    ubyte(
        0.2126D * double(red) +
        0.7152D * double(green) +
        0.0722D * double(blue) +
        0.5D
    )

to_grey(color: IMAGE) -> ubyte[] =>
    (0..color.width * color.height)
        |> map(at => (
            let seen = color.pixel(at % color.width, at / color.width)

            luminance(seen.red, seen.green, seen.blue)
        ))
        |> list()

to_colour(levels: ubyte[], width: int, height: int) -> IMAGE => (
    let image = IMAGE(width, height)

    for at in 0..levels.count do
        image.set_pixel(
            at % width,
            at / width,
            levels[at],
            levels[at],
            levels[at]
        )
    od

    image
)

let width = 300
let height = 200

let color = IMAGE(width, height)

for y in 0..height do
    for x in 0..width do
        color.set_pixel(
            x,
            y,
            ubyte(255 * x / width),
            ubyte(255 * y / height),
            ubyte(255 - 255 * x / width)
        )
    od
od

color.color(255ub, 0ub, 0ub)
color.fill([
    (x = 30.0D, y = 30.0D),
    (x = 110.0D, y = 30.0D),
    (x = 70.0D, y = 110.0D)
])

color.color(0ub, 255ub, 0ub)
color.fill([
    (x = 120.0D, y = 30.0D),
    (x = 200.0D, y = 30.0D),
    (x = 160.0D, y = 110.0D)
])

color.color(0ub, 0ub, 255ub)
color.fill([
    (x = 210.0D, y = 30.0D),
    (x = 290.0D, y = 30.0D),
    (x = 250.0D, y = 110.0D)
])

color.write("color.png")

let grey = to_colour(to_grey(color), width, height)

grey.write("grey.png")

color.show("color.png")
grey.show("grey.png")
