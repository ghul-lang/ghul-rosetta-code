use Ghul.Pipes
use Raster.IMAGE

luminance(red: ubyte, green: ubyte, blue: ubyte) -> ubyte =>
    ubyte(
        0.2126 * double(red) +
        0.7152 * double(green) +
        0.0722 * double(blue) +
        0.5
    )

to_gray(color: IMAGE) -> ubyte[] =>
    (0..color.width * color.height)
        |> map(at => (
            let seen = color.pixel(at % color.width, at / color.width)

            luminance(seen.red, seen.green, seen.blue)
        ))
        |> list()

to_color(levels: ubyte[], width: int, height: int) -> IMAGE => (
    let image = IMAGE(width, height)

    for at in 0..levels.count do
        image.set_pixel(
            at % width,
            at / width,
            levels[at],
            levels[at],
            levels[at]
        )
    od

    image
)

let width = 300
let height = 200

let color = IMAGE(width, height)

for y in 0..height do
    for x in 0..width do
        color.set_pixel(
            x,
            y,
            ubyte(255 * x / width),
            ubyte(255 * y / height),
            ubyte(255 - 255 * x / width)
        )
    od
od

color.color(255ub, 0ub, 0ub)
color.fill([
    (x = 30.0, y = 30.0),
    (x = 110.0, y = 30.0),
    (x = 70.0, y = 110.0)
])

color.color(0ub, 255ub, 0ub)
color.fill([
    (x = 120.0, y = 30.0),
    (x = 200.0, y = 30.0),
    (x = 160.0, y = 110.0)
])

color.color(0ub, 0ub, 255ub)
color.fill([
    (x = 210.0, y = 30.0),
    (x = 290.0, y = 30.0),
    (x = 250.0, y = 110.0)
])

color.write("color.png")

let gray = to_color(to_gray(color), width, height)

gray.write("gray.png")

color.show("color.png")
gray.show("gray.png")
