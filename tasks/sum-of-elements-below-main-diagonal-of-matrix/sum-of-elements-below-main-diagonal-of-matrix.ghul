use default

let matrix = [
    [1, 3, 7, 8, 10],
    [2, 4, 16, 14, 4],
    [3, 1, 9, 18, 11],
    [12, 14, 17, 18, 20],
    [7, 1, 3, 9, 5]
]

let below = [
    matrix[i][j]
    for i in 0..matrix.count
    for j in 0..i
]
    |> sum()

write_line(
    "sum of the elements below the main diagonal: {below}"
)
