use default

class LEDGER is
    _entries: LIST[string]

    init() is
        _entries = LIST()
    si

    record(what: string) is
        _entries.add(what)
    si

    count: int => _entries.count
si

class HANDLER open is
    init() is si

    handle(message: string) -> string => "handled: {message}"
si

class SHOUTING_HANDLER: HANDLER is
    init() is
        super.init()
    si

    handle(message: string) -> string =>
        super.handle(message).to_upper()
si

let ledger = LEDGER()

ledger.record("one")
ledger.record("two")

write_line("the sealed class holds {ledger.count} entries")
write_line(HANDLER().handle("a message"))
write_line(SHOUTING_HANDLER().handle("a message"))
