use default

let source = IO.Std.read_line() ?? ""

tokenize(text: string) -> LIST[string] is
    let result = LIST()
    let i mut = 0

    while i < text.length do
        if char.is_letter(text[i]) then
            let start = i

            while i < text.length /\ char.is_letter_or_digit(text[i]) do
                i = i + 1
            od

            result.add(text.substring(start, i - start))
        elif char.is_white_space(text[i]) then
            i = i + 1
        else
            result.add("{text[i]}")
            i = i + 1
        fi
    od

    result
si

let tokens = tokenize(source)
let at mut = 0
let temporaries mut = 0

peek() -> string => if at < tokens.count then tokens[at] else "" fi

accept(token: string) -> bool is
    if peek() =~ token then
        at = at + 1
        return true
    fi

    false
si

expect(token: string) is
    if !accept(token) then
        throw System.Exception("expected {token}, found {peek()}")
    fi
si

name() -> string is
    let token = peek()

    if token.length == 0 \/ !char.is_letter(token[0]) then
        throw System.Exception("expected a name, found {token}")
    fi

    at = at + 1
    token
si

emit(left: string, operator: string, right: string) -> string is
    temporaries = temporaries + 1

    let result = "_{temporaries:D4}"

    write_line("{result} = {left} {operator} {right}")
    result
si

expr() -> string is
    let left mut = term()

    do
        if accept("+") then
            left = emit(left, "+", term())
        elif accept("-") then
            left = emit(left, "-", term())
        else
            break
        fi
    od

    left
si

term() -> string is
    let left mut = factor()

    do
        if accept("*") then
            left = emit(left, "*", factor())
        elif accept("/") then
            left = emit(left, "/", factor())
        else
            break
        fi
    od

    left
si

factor() -> string is
    if accept("(") then
        let value = expr()

        expect(")")

        return value
    fi

    name()
si

write_line(source)
write_line()

let result = expr()

expect("")
write_line()
write_line("the value is in {result}")
