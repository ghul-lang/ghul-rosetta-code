use default

encode(text: string) -> string =>
    text |> group() |> map(run => "{run.count}{run[0]}") |> join("")

decode(encoded: string) -> string =>
    if encoded.length == 0 then
        ""
    else
        let
            digits =
                encoded |> take_while(c => char.is_digit(c)) |> count(),
            repeats = int.parse(encoded[0..digits]),
            letter = encoded[digits]
        in
            "{string(letter, repeats)}{decode(encoded[digits + 1..<0])}"
    fi

let input =
    "WWWWWWWWWWWWBWWWWWWWWWWWWBBBWWWWWWWWWWWW"
    "WWWWWWWWWWWWBWWWWWWWWWWWWWW"
let encoded = encode(input)

write_line("input:   {input}")
write_line("encoded: {encoded}")
write_line("decoded: {decode(encoded)}")
write_line("round trip restores the input: {decode(encoded) =~ input}")
