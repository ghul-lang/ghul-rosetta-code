use default
use Concurrency

let names = ["Alice", "Bob", "Carol"]

let console = Mutex()

visit(name: string) -> Future is
    write_line("{name} enters")
    await pause()
    write_line("{name} leaves")
si

guarded(name: string) -> Future is
    await console.acquire()
    await visit(name)
    console.release()
si

write_line("without the mutex")

run(() => Future.when_all(names |> map(visit)))

write_line("")
write_line("with the mutex")

run(() => Future.when_all(names |> map(guarded)))
