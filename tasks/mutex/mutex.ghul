use default
use Ghul.Coroutines

let names = ["Alice", "Bob", "Carol"]

let console = MUTEX()

visit(name) is
    write_line("{name} enters")
    await pause()
    write_line("{name} leaves")
si

guarded(name) is
    await console.acquire()
    await visit(name)
    console.release()
si

write_line("without the mutex")

for name in names do
    visit(name)
od

run()

write_line("")
write_line("with the mutex")

for name in names do
    guarded(name)
od

run()
