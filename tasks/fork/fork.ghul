use default
use System.Diagnostics.Process
use System.Diagnostics.ProcessStartInfo

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `=~` compares values (structural equality)

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `=~` compares values (structural equality); `==` compares identity.

let arguments = System.Environment.get_command_line_args()

if arguments |> skip(1) |> any(argument => argument =~ "child") then
    write_line("child: running on my own now")
else
    let start = ProcessStartInfo("dotnet")

    start.argument_list.add(arguments[0])
    start.argument_list.add("child")
    start.redirect_standard_output = true

    let child = Process.start(start)

    if !child? then
        write_line("parent: could not start a child")
    else
        write_line("parent: the child has started")

        IO.Std.write(child.standard_output.read_to_end())

        child.wait_for_exit()

        write_line("parent: the child ended with status {child.exit_code}")
    fi
fi
