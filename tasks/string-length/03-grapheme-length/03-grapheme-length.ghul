use default

let subjects = [
    "møøse", "𝔘𝔫𝔦𝔠𝔬𝔡𝔢", "J\u0332o\u0332s\u0332e\u0301\u0332"
]

for subject in subjects do
    write_line(
        "{shown(subject)}: {subject |> graphemes() |> count()} graphemes"
    )
od

// A combining mark prints as its escape: a page that normalizes text would
// otherwise fold e and U+0301 into one é, and show a different string from
// the one counted.
shown(text: string) -> string => text |> map(escaped) |> string()

escaped(c: char) -> string =>
    if is_combining(c) then "\\u{int(c):X4}" else "{c}" fi

is_combining(c: char) -> bool => int(c) >= 0x300 /\ int(c) <= 0x36F
