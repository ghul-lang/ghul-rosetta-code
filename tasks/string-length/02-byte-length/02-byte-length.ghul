use IO.Std.write_line
use Text.Encoding

let subjects = [
    "møøse", "𝔘𝔫𝔦𝔠𝔬𝔡𝔢", "J\u0332o\u0332s\u0332e\u0301\u0332"
]

for subject in subjects do
    write_line(
        "{subject}: "
        "{Encoding.utf8.get_byte_count(subject)} bytes in UTF-8, "
        "{Text.UTF16_ENCODING().get_byte_count(subject)} in UTF-16"
    )
od
