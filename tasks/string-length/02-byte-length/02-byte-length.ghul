use default
use Text.Encoding

let subjects = [
    "møøse", "𝔘𝔫𝔦𝔠𝔬𝔡𝔢", "J\u0332o\u0332s\u0332e\u0301\u0332"
]

for subject in subjects do
    write_line(
        "{shown(subject)}: "
        "{Encoding.utf8.get_byte_count(subject)} bytes in UTF-8, "
        "{Text.UTF16_ENCODING().get_byte_count(subject)} in UTF-16"
    )
od

// prints combining marks as escapes, so on a page that normalizes text the
// string shown is still the string counted
shown(text: string) -> string => text |> map(escaped) |> string()

escaped(c: char) -> string =>
    if is_combining(c) then "\\u{int(c):X4}" else "{c}" fi

is_combining(c: char) -> bool => int(c) >= 0x300 /\ int(c) <= 0x36F
