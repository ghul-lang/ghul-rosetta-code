use default

bigrams(phrase: string) -> Map[string, int] =>
    phrase.to_lower().split([' '])
        |> flat_map(word =>
            word |> windows(2) |> map(pair => pair |> string()))
        |> frequencies()

shared(left: Map[string, int], right: Map[string, int]) -> int =>
    left
        |> filter(entry => right.contains_key(entry.key))
        |> sum_by(entry =>
            System.Math.min(entry.value, right[entry.key]))

size(counted: Map[string, int]) -> int =>
    counted.values |> sum()

coefficient(left: Map[string, int], right: Map[string, int]) -> double => (
    let total = size(left) + size(right)

    if total == 0 then
        0.0D
    else
        double(2 * shared(left, right)) / cast(total)
    fi
)

let tasks =
    IO.File.read_all_lines("rosetta-tasks.txt")
        |> map(name => (name = name, grams = bigrams(name)))

closest(term: string) -> (name: string, score: double){} => (
    let wanted = bigrams(term)

    let scored =
        tasks
            |> map(task =>
                (name = task.name,
                 score = coefficient(wanted, task.grams)))
            |> collect_mutable()

    scored.sort((left, right) => (
        let by_score = right.score <> left.score

        if by_score != 0 then
            by_score
        else
            left.name <> right.name
        fi
    ))

    scored[0..5]
)

for term in ["Primordial primes",
             "Sunkist-Giuliani formula",
             "Sieve of Euripides",
             "Chowder numbers"] do
    write_line(term)

    for (name, score) in closest(term) do
        write_line("  {score:F4}  {name}")
    od

    write_line()
od
