use default

align(a: string, b: string) -> (
    top: string,
    bottom: string,
    distance: int
) is
    let d =
        0::a.length
            |> map(i =>
                0::b.length
                    |> map(j =>
                        if i == 0 then
                            j
                        elif j == 0 then
                            i
                        else
                            0
                        fi
                    )
                    |> collect_mutable()
            )
            |> collect()

    for i in 1::a.length do
        for j in 1::b.length do
            let substitution =
                if a[i - 1] == b[j - 1] then 0 else 1 fi

            d[i][j] =
                [
                    d[i - 1][j - 1] + substitution,
                    d[i - 1][j] + 1,
                    d[i][j - 1] + 1
                ]
                    |> min()!
        od
    od

    let top = System.Text.StringBuilder()
    let bottom = System.Text.StringBuilder()
    let i mut = a.length
    let j mut = b.length

    while i > 0 \/ j > 0 do
        let matched = i > 0 /\ j > 0 /\ a[i - 1] == b[j - 1]
        let cost = if matched then 0 else 1 fi

        if
            i > 0 /\ j > 0 /\ d[i][j] == d[i - 1][j - 1] + cost
        then
            i = i - 1
            j = j - 1
            top.insert(0, a[i])
            bottom.insert(0, b[j])
        elif i > 0 /\ d[i][j] == d[i - 1][j] + 1 then
            i = i - 1
            top.insert(0, a[i])
            bottom.insert(0, '-')
        else
            j = j - 1
            top.insert(0, '-')
            bottom.insert(0, b[j])
        fi
    od

    (
        top = top.to_string(),
        bottom = bottom.to_string(),
        distance = d[a.length][b.length]
    )
si

for
    (a, b) in [
        ("place", "palace"),
        ("rosettacode", "raisethysword")
    ]
do
    let (top, bottom, distance) = align(a, b)

    write_line(top)
    write_line(bottom)
    write_line("distance {distance}")
    write_line()
od
