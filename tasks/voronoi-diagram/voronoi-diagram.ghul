use Ghul.Pipes
use Raster.IMAGE

let width = 480
let height = 360
let sites = 24

let state mut = 1234567L

next(limit: int) -> int is
    state = (state * 1103515245L + 12345L) % 2147483648L

    return int(state % long(limit))
si

let places =
    (0..sites)
        |> map(_ =>
            (x = next(width),
             y = next(height),
             red = ubyte(80 + next(160)),
             green = ubyte(80 + next(160)),
             blue = ubyte(80 + next(160))))
        |> collect()

nearest(x: int, y: int) -> int =>
    0..places.count |> min_by(at =>
        let across = x - places[at].x, up = y - places[at].y in
        across * across + up * up)!

let image = IMAGE(width, height)

for y in 0..height do
    for x in 0..width do
        let site = places[nearest(x, y)]

        image.set_pixel(x, y, site.red, site.green, site.blue)
    od
od

image.colour(0ub, 0ub, 0ub)

for site in places do
    image.fill([
        (x = double(site.x) - 3.0D, y = double(site.y) - 3.0D),
        (x = double(site.x) + 3.0D, y = double(site.y) - 3.0D),
        (x = double(site.x) + 3.0D, y = double(site.y) + 3.0D),
        (x = double(site.x) - 3.0D, y = double(site.y) + 3.0D)
    ])
od

image.write("voronoi.png")

image.show("voronoi.png")
