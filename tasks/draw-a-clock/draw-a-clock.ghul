use default
use Raster.ANIMATION
use Raster.IMAGE

let size = 180

point(second: double, radius: double) -> (double, double) =>
    let angle = pi / 2.0 - second * pi / 30.0 in
    (radius * cos(angle), radius * sin(angle))

hand(image: IMAGE, at: double, length: double, width: double) is
    let (x, y) = point(at, length)
    let (tail_x, tail_y) = point(at + 30.0, 0.15)

    image.stroke(width)
    image.line(tail_x, tail_y, x, y)
si

draw(image: IMAGE, time: Time.DATE_TIME) is
    image.clear(245ub, 242ub, 235ub)

    image.color(40ub, 40ub, 50ub)
    image.stroke(3.0)
    image.circle(0.0, 0.0, 1.0)

    for tick in 0..60 do
        let long = tick % 5 == 0
        let inner = if long then 0.8 else 0.88 fi
        let (x0, y0) = point(double(tick), inner)
        let (x1, y1) = point(double(tick), 0.94)

        image.stroke(if long then 3.0 else 1.0 fi)
        image.line(x0, y0, x1, y1)
    od

    let second = double(time.second)
    let minute = double(time.minute) + second / 60.0
    let hour = double(time.hour % 12) + minute / 60.0

    hand(image, 5.0 * hour, 0.5, 5.0)
    hand(image, minute, 0.75, 3.0)

    image.color(200ub, 40ub, 40ub)
    hand(image, second, 0.85, 1.5)
    image.disc(0.0, 0.0, 0.05)
si

let live = System.Environment.get_environment_variable("GHUL_LIVE_IMAGES")?

let image = IMAGE(size, size)

image.view(-1.1, -1.1, 1.1, 1.1)

let animation = ANIMATION(size, size)

let now = Time.DATE_TIME.now
let start = now.add_milliseconds(double(-now.millisecond))

for second in 0..60 do
    let time = start.add_seconds(double(second))

    draw(image, time)
    animation.add(image, 1000)

    if live then
        image.write("clock.png")
        image.show("clock.png")

        let wait = time.add_seconds(1.0) - Time.DATE_TIME.now

        if wait.total_milliseconds > 0.0 then
            System.Threading.Thread.sleep(wait)
        fi
    fi
od

write_line("a minute of the clock, from the second it was started")

animation.write("clock.png")

animation.show("clock.png")
