use default

use Employee = (
    name: string,
    id: string,
    salary: int,
    department: string
)

let staff: List[Employee] = [
    ("Tyler Bennett", "E10297", 32000, "D101"),
    ("John Rappl", "E21437", 47000, "D050"),
    ("George Woltman", "E00127", 53500, "D101"),
    ("Adam Smith", "E63535", 18000, "D202"),
    ("Claire Buckman", "E39876", 27800, "D202"),
    ("David McClellan", "E04242", 41500, "D101"),
    ("Rich Holcomb", "E01234", 49500, "D202"),
    ("Nathan Adams", "E41298", 21900, "D050"),
    ("Richard Potter", "E43128", 15900, "D101"),
    ("David Motsinger", "E27002", 19250, "D202"),
    ("Tim Sampair", "E03033", 27000, "D101"),
    ("Kim Arlich", "E10001", 57000, "D190"),
    ("Timothy Grove", "E16398", 29900, "D190")
]

top_earners(department: string, wanted: int) -> Employee{} => (
    let earners =
        staff
            |> filter(e => e.department =~ department)
            |> collect_mutable()

    earners.sort((a, b) => b.salary <> a.salary)

    earners |> take(wanted)
)

let departments =
    staff |> map(e => e.department) |> collect_mutable()

departments.sort()

departments
    |> distinct()
    |> each(department => (
        write_line("{department}")

        top_earners(department, 3)
            |> each(e =>
                write_line(
                    "    {e.name,-16} {e.id}  {e.salary,6}"
                )
            )

        write_line("")
    ))
