use default
use System.Math.*

use Row = (p12: bigint, p1: bigint, p2: bigint, p: bigint)

-(u: Row, v: Row) -> Row =>
    (u.p12 - v.p12, u.p1 - v.p1, u.p2 - v.p2, u.p - v.p)

*(r: Row, t: bigint) -> Row => (r.p12 * t, r.p1 * t, r.p2 * t, r.p * t)

input_first(r: Row, t: bigint) -> Row =>
    (r.p2 + r.p12 * t, r.p + r.p1 * t, r.p12, r.p1)

exhaust_first(r: Row) -> Row => (r.p12, r.p1, r.p12, r.p1)

input_second(r: Row, t: bigint) -> Row =>
    (r.p1 + r.p12 * t, r.p12, r.p + r.p2 * t, r.p2)

exhaust_second(r: Row) -> Row => (r.p12, r.p12, r.p2, r.p2)

is_zero(r: Row) -> bool =>
    r.p12 =~ 0n /\ r.p1 =~ 0n /\ r.p2 =~ 0n /\ r.p =~ 0n

r2cf(numerator: bigint, denominator: bigint) -> bigint{} is
    let n1 mut = numerator
    let n2 mut = denominator

    while n2 !~ 0n do
        let whole = n1 / n2

        (n1, n2) = (n2, n1 - whole * n2)

        yield whole
    od
si

square_root_of_two() -> bigint{} => [1n] |> cat(repeat(2n))

let patience = 40

combine(
    top_row: Row, bottom_row: Row, x: Iterable[bigint], y: Iterable[bigint]
) -> bigint{} is
    let top mut = top_row
    let bottom mut = bottom_row
    let xs = x.iterator
    let ys = y.iterator
    let x_left mut = true
    let y_left mut = true
    let waited mut = 0

    ratio(n, d) => double(n) / double(d)

    settled() =>
        let (a12, a1, a2, a) = top, (b12, b1, b2, b) = bottom in
        b12 !~ 0n /\ b1 !~ 0n /\ b2 !~ 0n /\ b !~ 0n /\
        a12 / b12 =~ a / b /\ a1 / b1 =~ a / b /\ a2 / b2 =~ a / b

    first_is_further() =>
        let (_, a1, a2, a) = top, (_, b1, b2, b) = bottom in
        if b =~ 0n /\ b2 =~ 0n then true
        elif b =~ 0n \/ b2 =~ 0n then false
        else
            abs(ratio(a1, b1) - ratio(a, b)) >
                abs(ratio(a2, b2) - ratio(a, b))
        fi

    while !is_zero(bottom) do
        if settled() then
            let t = top.p / bottom.p

            (top, bottom) = (bottom, top - bottom * t)
            waited = 0

            yield t
        else
            if waited == patience then
                yield bigint(round(ratio(top.p, bottom.p)))

                return
            fi

            waited = waited + 1

            if first_is_further() then
                if x_left /\ xs.move_next() then
                    top = input_first(top, xs.current)
                    bottom = input_first(bottom, xs.current)
                else
                    x_left = false
                    top = exhaust_first(top)
                    bottom = exhaust_first(bottom)
                fi
            elif y_left /\ ys.move_next() then
                top = input_second(top, ys.current)
                bottom = input_second(bottom, ys.current)
            else
                y_left = false
                top = exhaust_second(top)
                bottom = exhaust_second(bottom)
            fi
        fi
    od
si

show(terms: Iterable[bigint]) -> string =>
    let shown = terms |> take(21) |> collect() in
    let rest = shown |> skip(1) |> take(19) |> join() in
    let more = if shown.count > 20 then ", ..." else "" fi in
    if shown.count == 1 then "[{shown[0]}]"
    else "[{shown[0]}; {rest}{more}]"
    fi

let add: (Row, Row) = ((0n, 1n, 1n, 0n), (0n, 0n, 0n, 1n))
let subtract: (Row, Row) = ((0n, 1n, -1n, 0n), (0n, 0n, 0n, 1n))
let multiply: (Row, Row) = ((1n, 0n, 0n, 0n), (0n, 0n, 0n, 1n))
let divide: (Row, Row) = ((0n, 1n, 0n, 0n), (0n, 0n, 1n, 0n))

run(
    label: string, operation: (Row, Row), x: bigint{}, y: bigint{}
) =>
    let (top, bottom) = operation in
    write_line("{label,-15} = {show(combine(top, bottom, x, y))}")

run("22/7 + 1/2", add, r2cf(22n, 7n), r2cf(1n, 2n))
run("13/11 * 22/7", multiply, r2cf(13n, 11n), r2cf(22n, 7n))
run("13/11 - 22/7", subtract, r2cf(13n, 11n), r2cf(22n, 7n))
run("484/49 / 22/7", divide, r2cf(484n, 49n), r2cf(22n, 7n))
run("√2 * √2", multiply, square_root_of_two(), square_root_of_two())
run("√2 + √2", add, square_root_of_two(), square_root_of_two())
run("√2 / √2", divide, square_root_of_two(), square_root_of_two())
