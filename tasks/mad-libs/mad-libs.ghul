use default
use IO.Std.read_line
use System.Text.RegularExpressions.Regex

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `~>` skips the call if its left value is absent; `??` gives a fallback.

write_line("Enter a story with <blanks>, ending with an empty line:")

let story = LIST()

while let line = read_line() /\ line.length > 0 do
    story.add(line)
od

let text mut = story |> join("\n")

let blanks = Regex.matches(text, "<[^>]+>") |> map(m => m.value)

for blank in blanks do
    if text.contains(blank) then
        write_line("Enter a {blank.trim(['<', '>'])}:")

        let word = read_line() ?? ""
        write_line("> {word}")

        text = text.replace(blank, word)
    fi
od

write_line()
write_line(text)
