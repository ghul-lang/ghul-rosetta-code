use Raster.IMAGE
use System.Math.*

let spread = 0.4D
let shrink = 0.76D

let image = IMAGE(500, 500)

branch(
    x: double, y: double,
    angle: double, length: double,
    depth: int
) is
    if depth == 0 then
        return
    fi

    let tip_x = x + length * cos(angle)
    let tip_y = y + length * sin(angle)

    image.stroke(0.6D * double(depth))
    image.line(x, y, tip_x, tip_y)

    branch(tip_x, tip_y, angle - spread, length * shrink, depth - 1)
    branch(tip_x, tip_y, angle + spread, length * shrink, depth - 1)
si

image.view(0.0D, 0.0D, 500.0D, 500.0D)
image.colour(60ub, 40ub, 20ub)

branch(250.0D, 10.0D, pi / 2.0D, 110.0D, 10)

image.write("tree.png")

image.show("tree.png")
