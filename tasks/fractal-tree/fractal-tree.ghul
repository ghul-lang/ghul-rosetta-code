use Raster.IMAGE
use Ghul.Math

let spread = 0.4
let shrink = 0.76

let image = IMAGE(500, 500)

branch(x: double, y: double, angle: double, length: double, depth: int) is
    if depth == 0 then
        return
    fi

    let tip_x = x + length * cos(angle)
    let tip_y = y + length * sin(angle)

    image.stroke(0.6 * double(depth))
    image.line(x, y, tip_x, tip_y)

    branch(tip_x, tip_y, angle - spread, length * shrink, depth - 1)
    branch(tip_x, tip_y, angle + spread, length * shrink, depth - 1)
si

image.view(0.0, 0.0, 500.0, 500.0)
image.color(60ub, 40ub, 20ub)

branch(250.0, 10.0, pi / 2.0, 110.0, 10)

image.write("tree.png")

image.show("tree.png")
