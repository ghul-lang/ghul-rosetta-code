use default

has_factor_up_to(m: int, n: int) -> bool =>
    2::n |> any(p => m % p == 0)

least_m(n: int, factorial: bigint) -> int =>
    from(1)
        |> filter(m => m == 1 \/ !has_factor_up_to(m, n))
        |> find(m => is_prime(factorial + bigint(m)))!

terms() -> (n: int, m: int){} =>
    from(0)
        |> map(n => (
            n = n,
            m = least_m(n, factorial(bigint(n)))
        ))

write_line("The first 50 terms:")

for row in terms() |> take(50) |> chunk(10) do
    write_line(row |> map(t => "{t.m,5}") |> join(""))
od

let first_large = terms() |> find(t => t.m > 1000)!

write_line()
write_line(
    "First m over 1000: {first_large.m} for n = {first_large.n}"
)
