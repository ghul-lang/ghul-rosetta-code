use default

// `QUEUE[T]` is a mutable first-in, first-out queue
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

let queue = QUEUE()

report_empty(pending: QUEUE[string]) =>
    let state = if pending.count == 0 then "yes" else "no" fi in
    write_line("empty: {state}")

["first", "second", "third"] |> each(queue.enqueue)

report_empty(queue)

write_line("front: {queue.peek()}")

while queue.count > 0 do
    write_line("dequeued {queue.dequeue()}")
od

report_empty(queue)
