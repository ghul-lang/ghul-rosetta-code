use default
use IO.Std.write
use IO.Std.read_line

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity
// `if let` pattern-matches

write("a b: ")

if let entered = read_line() then
    let fields = entered |> words() |> list()

    let first = int.parse(fields[0])
    let second = int.parse(fields[1])

    if first < second then
        write_line("{first} is less than {second}")
    fi

    if first == second then
        write_line("{first} is equal to {second}")
    fi

    if first > second then
        write_line("{first} is greater than {second}")
    fi
fi
