use default
use IO.Std.write
use IO.Std.read_line

// `if let` and `case ... when` pattern-match; `[x, ..rest]` matches a list.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

write("a b: ")

if let entered = read_line() then
    let fields = entered |> words() |> list()

    let first = int.parse(fields[0])
    let second = int.parse(fields[1])

    if first < second then
        write_line("{first} is less than {second}")
    fi

    if first == second then
        write_line("{first} is equal to {second}")
    fi

    if first > second then
        write_line("{first} is greater than {second}")
    fi
fi
