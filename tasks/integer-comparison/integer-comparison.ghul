use default
use IO.Std.write
use IO.Std.read_line

write("a b: ")

if let entered = read_line() then
    let fields = entered |> words() |> list()

    let first = int.parse(fields[0])
    let second = int.parse(fields[1])

    let relation =
        if first < second then "less than"
        elif first == second then "equal to"
        else "greater than"
        fi

    write_line("{first} is {relation} {second}")
fi
