use default
use System.Math.*

// The library takes and returns radians, so the degree column is the same
// angle converted on the way in and on the way out.

to_radians(degrees: double) -> double => degrees * pi / 180.0
to_degrees(radians: double) -> double => radians * 180.0 / pi

let radians = pi / 4.0
let degrees = 45.0

write_line("sin {sin(radians)} {sin(to_radians(degrees))}")
write_line("cos {cos(radians)} {cos(to_radians(degrees))}")
write_line("tan {tan(radians)} {tan(to_radians(degrees))}")

let arcsin = asin(sin(radians))
let arccos = acos(cos(radians))
let arctan = atan(tan(radians))

write_line("asin {arcsin} radians, {to_degrees(arcsin)} degrees")
write_line("acos {arccos} radians, {to_degrees(arccos)} degrees")
write_line("atan {arctan} radians, {to_degrees(arctan)} degrees")
