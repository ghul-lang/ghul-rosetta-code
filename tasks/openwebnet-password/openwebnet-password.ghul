use default

step(digit: char, n: uint) -> uint =>
    case digit
    when '1' then ((n & 0xFFFFFF80u) >> 7) | (n << 25)
    when '2' then ((n & 0xFFFFFFF0u) >> 4) | (n << 28)
    when '3' then ((n & 0xFFFFFFF8u) >> 3) | (n << 29)
    when '4' then (n << 1) | (n >> 31)
    when '5' then (n << 5) | (n >> 27)
    when '6' then (n << 12) | (n >> 20)
    when '7' then
        (n & 0x0000FF00u) | ((n & 0x000000FFu) << 24) |
        ((n & 0x00FF0000u) >> 16) | ((n & 0xFF000000u) >> 8)
    when '8' then
        ((n & 0x0000FFFFu) << 16) | (n >> 24) | ((n & 0x00FF0000u) >> 8)
    when '9' then \n
    else n
    esac

password_for(password: uint, nonce: string) -> uint =>
    (let result mut = 0u
     let started mut = false

     for digit in nonce do
         if digit != '0' /\ !started then
             result = password
             started = true
         fi

         result = step(digit, result)
     od

     result)

let cases = [
    ("12345", "603356072", 25280520u),
    ("12345", "410501656", 119537670u),
    ("12345", "630292165", 4269684735u)
]

for (password, nonce, expected) in cases do
    let result = password_for(uint.parse(password), nonce)
    let verdict = if result == expected then "ok" else "WRONG" fi

    write_line("password {password}, nonce {nonce}: {result} ({verdict})")
od
