use default

// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

pyramid(base: int[]) -> int[][] => (
    let rows = LIST[int[]]([base])

    while rows[0].count > 1 do
        let below = rows[0]
        let above =
            0..below.count - 1
                |> map(i => below[i] + below[i + 1])
                |> list()

        rows.insert(0, above)
    od

    rows
)

let solutions = [(x, z) for x in 0::151 for z in 0::151]
    |> map((x, z) => pyramid([x, 11, x + z, 4, z]))
    |> filter(p => p[0][0] == 151 /\ p[2][0] == 40)

for p in solutions do
    for (depth, row) in p |> index() do
        let indent = string(' ', (p.count - 1 - depth) * 3)
        write_line("{indent}{row |> map(v => "[{v,4}]") |> join("")}")
    od

    write_line()
    write_line("X = {p[4][0]}, Y = {p[4][2]}, Z = {p[4][4]}")
od
