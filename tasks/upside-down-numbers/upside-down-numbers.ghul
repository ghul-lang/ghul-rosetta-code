use default

power_of_nine(exponent: int) -> int => repeat(9, exponent) |> product()

// How many upside-down numbers have this many digits. The first half can
// use any of the digits 1 to 9. The second half, and the 5 in the middle
// of an odd length, are then fixed.
count_of_length(length: int) -> int => power_of_nine(length / 2)

// The length of the number at a given zero-based rank, and its rank
// among the numbers of that length.
locate(rank: int, length: int) -> (int, int) =>
    if rank < count_of_length(length) then (length, rank)
    else locate(rank - count_of_length(length), length + 1)
    fi

upside_down(index: int) -> string =>
    let
        (length, rank) = locate(index - 1, 1),
        size = length / 2,
        half =
            [rank / power_of_nine(size - 1 - i) % 9 + 1 for i in 0..size],
        middle = if length % 2 == 1 then "5" else "" fi,
        mirror = [10 - half[size - 1 - i] for i in 0..size]
    in
        "{half |> join("")}{middle}{mirror |> join("")}"

let first_fifty = 1::50 |> map(upside_down) |> collect()

write_line("the first fifty upside-down numbers:")

for row in 0..5 do
    write_line("  {first_fifty[row * 10..row * 10 + 10] |> join(" ")}")
od

write_line("")

for milestone in [500, 5_000, 50_000, 500_000, 5_000_000] do
    write_line("number {milestone,9} is {upside_down(milestone)}")
od
