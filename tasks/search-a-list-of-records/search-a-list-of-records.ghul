use default

use City = (name: string, population: double)

let cities: City[] = [
    ("Lagos", 21.0),
    ("Cairo", 15.2),
    ("Kinshasa-Brazzaville", 11.3),
    ("Greater Johannesburg", 7.55),
    ("Mogadishu", 5.85),
    ("Khartoum-Omdurman", 4.98),
    ("Dar Es Salaam", 4.7),
    ("Alexandria", 4.58),
    ("Abidjan", 4.4),
    ("Casablanca", 3.98)
]

first_index[T](values: T[], matches: (T) -> bool) -> int? =>
    values
        |> index()
        |> filter(entry => matches(entry.value))
        |> map(entry => entry.index)
        |> first()

first_where[T](values: T[], matches: (T) -> bool) -> T? =>
    values |> filter(matches) |> first()

write_line("{first_index(cities, city => city.name =~ "Dar Es Salaam")!}")

if let sparse = first_where(cities, city => city.population < 5.0) then
    write_line("{sparse.name}")
fi

let initial = first_where(cities, city => city.name.starts_with("A"))

if initial? then
    write_line("{initial.population}")
fi
