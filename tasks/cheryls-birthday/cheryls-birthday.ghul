use default

use DATE = (month: string, day: int)

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `=~` compares values (structural equality) - `==` compares identity

sharing_the_day(dates: DATE[], day: int) -> int =>
    dates |> filter(date => date.day == day) |> count()

sharing_the_month(dates: DATE[], month: string) -> int =>
    dates |> filter(date => date.month =~ month) |> count()

let possible = [
    (month = "May", day = 15), (month = "May", day = 16),
    (month = "May", day = 19), (month = "June", day = 17),
    (month = "June", day = 18), (month = "July", day = 14),
    (month = "July", day = 16), (month = "August", day = 14),
    (month = "August", day = 15), (month = "August", day = 17)
]

let albert_knows_bernard_does_not =
    possible
        |> filter(date =>
            possible
                |> filter(other => other.month =~ date.month)
                |> all(other => sharing_the_day(possible, other.day) > 1)
        )
        |> list()

let bernard_now_knows =
    albert_knows_bernard_does_not
        |> filter(date =>
            sharing_the_day(albert_knows_bernard_does_not, date.day) == 1
        )
        |> list()

let birthday =
    bernard_now_knows
        |> filter(date =>
            sharing_the_month(bernard_now_knows, date.month) == 1
        )
        |> only()

write_line("Cheryl's birthday is {birthday.month} {birthday.day}")
