use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

substrings(text: string) -> string{} is
    for start in 0..text.length do
        for finish in (start + 1)::text.length do
            yield text[start..finish]
        od
    od
si

longest_common(left: string, right: string) -> string =>
    substrings(left)
        |> filter(candidate => right.contains(candidate))
        |> reduce("", (best, candidate) =>
            if candidate.length > best.length then
                candidate
            else
                best
            fi
        )

write_line(longest_common("thisisatest", "testing123testing"))
