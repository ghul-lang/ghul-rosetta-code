use default
use IO.Std

let target = 21

union Move is
    PLAY(pick: int)
    QUIT
    BAD(complaint: string)
si

parse_move(entered: string, total: int) -> Move =>
    if entered.to_lower() =~ "q" then
        Move.QUIT
    elif entered.length != 1 \/ !"123".contains(entered) then
        Move.BAD("choose 1, 2 or 3, or q to quit")
    elif total + int.parse(entered) > target then
        Move.BAD("that would take the total past {target}")
    else
        Move.PLAY(int.parse(entered))
    fi

computer_pick(total: int) -> int =>
    1::3
    |> find(pick => total + pick <= target /\ (total + pick) % 4 == 1) ??
        System.Math.min(3, target - total)

ask(prompt: string) -> string? =>
    (Std.write(prompt)
     Std.read_line())

let answer = ask("do you want to go first? (y/n): ")

let players_turn mut =
    answer? /\ answer.to_lower().starts_with("y")

let total mut = 0

Std.write_line("first to reach exactly {target} wins")

while total < target do
    if players_turn then
        let typed = ask("total {total}, your move: ")

        if !typed? then
            break
        fi

        case parse_move(typed.trim(), total)
        when _: Move.QUIT then
            Std.write_line("goodbye")
            break
        when bad: Move.BAD then
            Std.write_line(bad.complaint)
        when played: Move.PLAY then
            total = total + played.pick
            players_turn = false

            if total == target then
                Std.write_line("you reach {target}, you win")
            fi
        esac
    else
        let pick = computer_pick(total)

        total = total + pick
        players_turn = true

        Std.write_line("I play {pick}, total {total}")

        if total == target then
            Std.write_line("I reach {target}, I win")
        fi
    fi
od
