use default

union Kind is
    WASTEFUL
    EQUIDIGITAL
    FRUGAL
si

use Kind.EQUIDIGITAL
use Kind.FRUGAL
use Kind.WASTEFUL

let limit = 20_000_000
let counted = 1_000_000
let smallest_factor =
    (0::limit)
        |> map(value => if value % 2 == 0 then 2 else value fi)
        |> collect_mutable()

let odd mut = 3

while odd * odd <= limit do
    if smallest_factor[odd] == odd then
        let multiple mut = odd * odd

        while multiple <= limit do
            if smallest_factor[multiple] == multiple then
                smallest_factor[multiple] = odd
            fi

            multiple = multiple + 2 * odd
        od
    fi

    odd = odd + 2
od

length_in(value: int, base: int) -> int =>
    value |> digits(base) |> count()

factor_length(value: int, base: int) -> int is
    let total mut = 0
    let remaining mut = value

    while remaining > 1 do
        let factor = smallest_factor[remaining]
        let power mut = 0

        while remaining % factor == 0 do
            remaining = remaining / factor
            power = power + 1
        od

        total = total + length_in(factor, base)

        if power > 1 then
            total = total + length_in(power, base)
        fi
    od

    total
si

classify(value: int, base: int) -> Kind =>
    if value == 1 then EQUIDIGITAL
    else
        let own = length_in(value, base)
        let factors = factor_length(value, base)

        if own < factors then WASTEFUL
        elif own == factors then EQUIDIGITAL
        else FRUGAL
        fi
    fi

class TALLY is
    first_fifty: LIST[int] field
    ten_thousandth: int public
    below: int public
    found: int public

    init() is
        first_fifty = LIST()
    si

    take(value: int) is
        found = found + 1

        if value <= counted then below = below + 1 fi
        if found <= 50 then first_fifty.add(value) fi
        if found == 10_000 then
            ten_thousandth = value
        fi
    si

    settled(value: int) -> bool =>
        found >= 10_000 /\ value > counted

    show(base: int, name: string) is
        write_line("base {base} {name} numbers")
        write_line("  first fifty:")

        for row in 0..5 do
            let cells =
                first_fifty[row * 10..row * 10 + 10]
                    |> map(v => "{v,7}")

            write_line("   {cells |> join("")}")
        od

        write_line("  the 10,000th is {ten_thousandth}")
        write_line("  {below} of them are below 1,000,000")
        write_line("")
    si
si

for base in [10, 11] do
    let wasteful = TALLY()
    let equidigital = TALLY()
    let frugal = TALLY()

    for value in 1::limit do
        case classify(value, base)
        when _: WASTEFUL then wasteful.take(value)
        when _: EQUIDIGITAL then equidigital.take(value)
        when _: FRUGAL then frugal.take(value)
        esac

        if
            wasteful.settled(value) /\
            equidigital.settled(value) /\
            frugal.settled(value)
        then
            break
        fi
    od

    wasteful.show(base, "wasteful")
    equidigital.show(base, "equidigital")
    frugal.show(base, "frugal")
od
