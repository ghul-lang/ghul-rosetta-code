use default

repeats(text: string, size: int) -> bool =>
    0..text.length
        |> all(index => text[index] == text[index % size])

for
    text in [
        "1001110011", "1110111011", "0010010010", "1010101010",
        "1111111111", "0100101101", "0100100", "101", "11",
        "00", "1"
    ]
do
    if let
        size = (1::text.length / 2)
            |> reverse()
            |> find(repeats(text, *))
    then
        write_line("{text} repeats {text[0..size]}")
    else
        write_line("{text} is not a rep-string")
    fi
od
