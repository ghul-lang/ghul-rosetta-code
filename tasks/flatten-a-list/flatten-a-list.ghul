use default

union Nested is
    ATOM(value: int)
    LIST(items: Nested[])
si

use Nested.*

flatten(node) is
    case node
    when (value): ATOM then
        yield value
    when (items): LIST then
        for item in items do
            yield in flatten(item)
        od
    esac
si

show(node) =>
    case node
    when (value): ATOM then "{value}"
    when (items): LIST then "[{items |> map(show) |> join(", ")}]"
    esac

let input = LIST([
    LIST([ATOM(1)]),
    ATOM(2),
    LIST([LIST([ATOM(3), ATOM(4)]), ATOM(5)]),
    LIST([LIST([LIST([])])]),
    LIST([LIST([LIST([ATOM(6)])])]),
    ATOM(7),
    ATOM(8),
    LIST([])
])

write_line(show(input))
write_line("[{input |> flatten() |> join(", ")}]")
