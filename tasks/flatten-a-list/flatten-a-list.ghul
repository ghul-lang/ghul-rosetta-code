use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `case ... when` pattern-matches, and `[x, ..rest]` matches a list head
//  and tail

union Nested is
    ATOM(value: int)
    GROUP(items: Nested[])
si

use Nested.*

flatten(node: Nested) -> int{} is
    case node
    when (value): ATOM then
        yield value
    when (items): GROUP then
        for item in items do
            yield in flatten(item)
        od
    esac
si

show(node: Nested) -> string =>
    case node
    when (value): ATOM then "{value}"
    when (items): GROUP then "[{items |> map(show) |> join(", ")}]"
    esac

let input = GROUP([
    GROUP([ATOM(1)]),
    ATOM(2),
    GROUP([GROUP([ATOM(3), ATOM(4)]), ATOM(5)]),
    GROUP([GROUP([GROUP([])])]),
    GROUP([GROUP([GROUP([ATOM(6)])])]),
    ATOM(7),
    ATOM(8),
    GROUP([])
])

write_line(show(input))
write_line("[{input |> flatten() |> join(", ")}]")
