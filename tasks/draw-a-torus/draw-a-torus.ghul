use default
use Raster.IMAGE

struct VEC(x: double, y: double, z: double) is
    -(other: VEC) -> VEC => VEC(x - other.x, y - other.y, z - other.z)

    ×(o: VEC) -> VEC =>
        VEC(y * o.z - z * o.y, z * o.x - x * o.z, x * o.y - y * o.x)

    length: double => sqrt(x * x + y * y + z * z)
si

use Quad = VEC[]

let around = 48
let along = 24
let yaw = 0.5
let pitch = 0.9

surface(u, v) =>
    let ring = 1.5 + 0.6 * cos(v) in
    VEC(ring * cos(u), ring * sin(u), 0.6 * sin(v))

turned(p) =>
    let
        x = p.x * cos(yaw) - p.y * sin(yaw),
        y = p.x * sin(yaw) + p.y * cos(yaw)
    in
        VEC(
            x,
            p.z * cos(pitch) - y * sin(pitch),
            p.z * sin(pitch) + y * cos(pitch)
        )

corner(i, j) =>
    let
        u = 2.0 * pi * double(i) / double(around),
        v = 2.0 * pi * double(j) / double(along)
    in
        turned(surface(u, v))

depth(quad) => quad |> sum_by(c => c.z)

brightness(quad) =>
    let n = (quad[1] - quad[0]) × (quad[3] - quad[0]) in
    if n.length == 0.0 then 0.5
    else 0.25 + 0.75 * abs(n.z) / n.length
    fi

quad(i, j) => [
    corner(i, j), corner(i + 1, j),
    corner(i + 1, j + 1), corner(i, j + 1)
]

let quads = [quad(i, j) for i in 0..around for j in 0..along]
    |> sort((p, q) => depth(p) <> depth(q))
    |> list()

let image = IMAGE(360, 360)

image.view(-2.2, -2.2, 2.2, 2.2)
image.clear(248ub, 248ub, 244ub)
image.stroke(0.6)

for q in quads do
    let light = brightness(q)
    let outline = q |> map(p => (x = p.x, y = p.y)) |> list()

    image.color(
        ubyte(60.0 * light),
        ubyte(150.0 * light),
        ubyte(200.0 * light)
    )
    image.fill(outline)

    image.color(20ub, 40ub, 60ub)
    image.line(outline ++ [outline[0]] |> list())
od

write_line("a torus, radii 1.5 and 0.6")
write_line("{quads.count} quadrilaterals, drawn farthest first")

image.write("torus.png")

image.show("torus.png")
