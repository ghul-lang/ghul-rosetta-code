use default

use Time.DATE_TIME
use Time.DATE_TIME_OFFSET
use Time.TIME_SPAN
use System.TimeZoneInfo
use System.Globalization.CultureInfo

let offsets = [
    ("EST", -5), ("EDT", -4),
    ("CST", -6), ("CDT", -5),
    ("MST", -7), ("MDT", -6),
    ("PST", -8), ("PDT", -7)
]
    |> MAP()

let format = "MMMM d yyyy h:mmtt"
let culture = CultureInfo.invariant_culture

parse(text: string) -> DATE_TIME_OFFSET =>
    let
        split = text.last_index_of(' '),
        zone = text[split + 1..<0]
    in
        let clock = DATE_TIME.parse_exact(text[0..split], format, culture)
        in
        DATE_TIME_OFFSET(clock, TIME_SPAN.from_hours(offsets[zone]))

show(time) =>
    let
        date = time.to_string("MMMM d yyyy h:mm", culture),
        meridiem = time.to_string("tt", culture).to_lower()
    in
        "{date}{meridiem} (UTC{time.to_string("zzz")})"

let start = parse("March 7 2009 7:30pm EST")
let later = start.add_hours(12.0)

in_zone(time, id) =>
    TimeZoneInfo.convert_time(
        time,
        TimeZoneInfo.find_system_time_zone_by_id(id)
    )

write_line("Start:           {show(start)}")
write_line("12 hours later:  {show(later)}")
write_line("In New York:     {show(in_zone(later, "America/New_York"))}")
write_line("In London:       {show(in_zone(later, "Europe/London"))}")
