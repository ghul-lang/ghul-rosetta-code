use default
use Text.REGEX

let swaps = MAP(
    [
        ("she", "he"), ("he", "she"),
        ("her", "him"), ("him", "her"),
        ("hers", "his"), ("his", "hers"),
        ("herself", "himself"), ("himself", "herself"),
        ("woman", "man"), ("man", "woman"),
        ("girl", "boy"), ("boy", "girl"),
        ("mother", "father"), ("father", "mother"),
        ("wife", "husband"), ("husband", "wife")
    ]
        |> map((word, swap) => KeyValuePair(word, swap))
)

reverse_gender(text) is
    let word_pattern = REGEX("[A-Za-z]+")

    word_pattern.replace(text, m => (
        let word = m.value
        let lower = word.to_lower()

        if swaps.contains_key(lower) then
            let replacement = swaps[lower]

            if word[0].is_upper then
                "{replacement[0].to_upper()}{replacement[1..<0]}"
            else
                replacement
            fi
        else
            word
        fi
    ))
si

write_line(reverse_gender("She was a soul stripper. She took my heart!"))
