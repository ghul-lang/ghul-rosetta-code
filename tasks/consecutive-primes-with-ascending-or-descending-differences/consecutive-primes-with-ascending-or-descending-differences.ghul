use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `LIST()` builds its collection eagerly
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`

primes_below(limit: int) -> int{} is
    let composite = repeat(false, limit) |> LIST()

    for candidate in 2..limit do
        if !composite[candidate] then
            yield candidate

            let multiple mut = candidate * 2

            while multiple < limit do
                composite[multiple] = true
                multiple = multiple + candidate
            od
        fi
    od
si

longest_run(primes: int[], keeps_going: (int, int) -> bool) -> int[] is
    let best mut = (start = 0, length = 1)
    let start mut = 0

    for index in 2..primes.count do
        let previous_gap = primes[index - 1] - primes[index - 2]
        let gap = primes[index] - primes[index - 1]

        if !keeps_going(previous_gap, gap) then
            start = index - 1
        fi

        if index - start + 1 > best.length then
            best = (start, index - start + 1)
        fi
    od

    return primes[best.start..best.start + best.length]
si

let primes = primes_below(1_000_000) |> list()

show(name: string, run: int[]) =>
    write_line("{name}: {run |> map(p => "{p}") |> join(" ")}")

show("ascending", longest_run(primes, * < *))
show("descending", longest_run(primes, * > *))
