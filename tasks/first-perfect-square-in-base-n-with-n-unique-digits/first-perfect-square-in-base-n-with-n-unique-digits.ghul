use default

let digit_glyphs = "0123456789ABCDEF"

is_pandigital(square: long, base: int) -> bool is
    let radix = long(base)
    let wanted = (1 << base) - 1

    walk(remaining: long, seen: int) -> bool =>
        if remaining == 0L then seen == wanted
        else
            walk(remaining / radix,
                seen | (1 << int(remaining % radix)))
        fi

    walk(square, 0)
si

in_base(value: long, base: int) -> string is
    let radix = long(base)

    walk(remaining: long) -> string =>
        if remaining == 0L then
            ""
        else
            let digit = digit_glyphs[int(remaining % radix)] in
            "{walk(remaining / radix)}{digit}"
        fi

    walk(value)
si

smallest_root(base: int) -> int =>
    let lowest = System.Math.pow(double(base), double(base - 1)) in
    int(System.Math.ceiling(System.Math.sqrt(lowest)))

for base in 2::13 do
    let found =
        for root in from(smallest_root(base)) do
            if is_pandigital(long(root) * long(root), base) then
                break root
            fi
        od

    let root = found!
    let square = long(root) * long(root)

    write_line(
        "base {base,2}: {in_base(long(root), base),9} squared is "
        "{in_base(square, base)}")
od
