use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `yield` makes the function a generator: it returns a lazy `T{}`.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

middle_square(seed: int) -> int{} is
    let current mut = seed

    while true do
        let squared = "{long(current) * long(current),012}"

        current = int.parse(squared.substring(3, 6))

        yield current
    od
si

for value in middle_square(675248) |> take(5) do
    write_line("{value}")
od
