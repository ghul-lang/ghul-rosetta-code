use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

middle_square(seed: int) -> int{} is
    let current mut = seed

    while true do
        let squared = "{long(current) * long(current),012}"

        current = int.parse(squared.substring(3, 6))

        yield current
    od
si

for value in middle_square(675248) |> take(5) do
    write_line("{value}")
od
