use default

is_prime(n: int) -> bool =>
    n >= 2 /\ 2..n |> all(d => d * d > n \/ n % d != 0)

// S(k) mod 2^p - 1 is reduced without division: the bits above p are
// folded back onto the low p bits, since 2^p is 1 modulo 2^p - 1.
is_mersenne_prime(p: int) -> bool =>
    p == 2 \/
    let
        mersenne = (1n << p) - 1n,
        s mut = 4n
    in
        (
            for _ in 0..p - 2 do
                s = s * s - 2n

                while s > mersenne do
                    s = (s & mersenne) + (s >> p)
                od

                if s =~ mersenne then
                    s = 0n
                fi
            od

            s =~ 0n
        )

let found =
    2..2300 |> filter(p => is_prime(p) /\ is_mersenne_prime(p))

write_line("Mersenne primes up to 2^2300 - 1:")
write_line(found |> map(p => "M{p}") |> join(" "))
