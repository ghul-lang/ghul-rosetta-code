use default

is_probable_prime(n: bigint) -> bool is
    if n < 2n then
        return false
    fi

    let small = [2n, 3n, 5n, 7n, 11n, 13n, 17n, 19n, 23n, 29n, 31n, 37n]

    if small |> any(p => n =~ p) then
        return true
    elif small |> any(p => (n % p).is_zero) then
        return false
    fi

    let d mut = n - 1n
    let s mut = 0

    while d.is_even do
        d = d / 2n
        s = s + 1
    od

    return small |> all(a => passes(n, a, d, s))
si

passes(n: bigint, a: bigint, d: bigint, s: int) -> bool is
    let x mut = bigint.mod_pow(a, d, n)

    if x.is_one \/ x =~ n - 1n then
        return true
    fi

    for _ in 1..s do
        x = x * x % n

        if x =~ n - 1n then
            return true
        fi
    od

    return false
si

next_prime(n: bigint) -> bigint =>
    from(0) |> map(k => n + bigint(k)) |> find(is_probable_prime)!

reciprocal_primes() -> bigint{} is
    let numerator mut = 1n
    let denominator mut = 1n

    do
        let p = next_prime(denominator / numerator + 1n)
        yield p

        numerator = numerator * p - denominator
        denominator = denominator * p
    od
si

abbreviated(p: bigint) -> string is
    let digits = "{p}"

    return
        if digits.length <= 40 then
            digits
        else
            "{digits[0..20]}...{digits[20..<<0]} {digits.length} digits"
        fi
si

write_line("primality is tested with Miller-Rabin, which is probabilistic")
write_line("for numbers of more than 25 digits")
write_line("")

for p in reciprocal_primes() |> take(12) do
    write_line(abbreviated(p))
od
