use default

next_prime(n: bigint) -> bigint =>
    from(0) |> map(k => n + bigint(k)) |> find(is_prime)!

reciprocal_primes() -> bigint{} is
    let numerator mut = 1n
    let denominator mut = 1n

    do
        let p = next_prime(denominator / numerator + 1n)
        yield p

        numerator = numerator * p - denominator
        denominator = denominator * p
    od
si

abbreviated(p: bigint) -> string =>
    let digits = "{p}" in
    if digits.length <= 40 then
        digits
    else
        "{digits[0..20]}...{digits[20..<<0]} {digits.length} digits"
    fi

write_line(
    "primality is tested with Miller-Rabin, which is probabilistic"
)
write_line("for numbers of more than 25 digits")
write_line("")

for p in reciprocal_primes() |> take(12) do
    write_line(abbreviated(p))
od
