use default

// `LIST[T]` is a mutable list that grows as elements are added
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

let first = [1, 2, 3]
let second = [4, 5, 6]

write_line("{$(first |> cat(second))}")

let grown = LIST(first)

grown.add_range(second)

write_line("{$grown}")
