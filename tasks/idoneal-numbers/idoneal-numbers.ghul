use default

is_idoneal(value: int) -> bool =>
    !(
        from(1)
            |> take_while(a => 3 * a * a + 2 * a < value)
            |> any(a =>
                from(a + 1)
                    |> take_while(b =>
                        a * b + b * (a + 1) < value
                    )
                    |> any(b =>
                        (value - a * b) % (a + b) == 0 /\
                        (value - a * b) / (a + b) > b
                    )
            )
    )

write_line("the 65 known idoneal numbers:")

for row in 1::1_850 |> filter(is_idoneal) |> chunk(5) do
    write_line(row |> map(n => "{n,5}") |> join(""))
od
