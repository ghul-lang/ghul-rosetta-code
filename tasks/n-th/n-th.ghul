use default

// `if let` and `case ... when` pattern-match; `[x, ..rest]` matches a list.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

ordinal(n: int) -> string =>
    let suffix =
        if n % 100 >= 11 /\ n % 100 <= 13 then
            "th"
        else
            case n % 10
            when 1 then "st"
            when 2 then "nd"
            when 3 then "rd"
            else "th"
            esac
        fi
    in
    "{n}{suffix}"

for range in [0::25, 250::265, 1000::1025] do
    write_line(range |> map(ordinal) |> join(" "))
od
