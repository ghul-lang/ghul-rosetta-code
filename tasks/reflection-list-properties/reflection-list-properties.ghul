use default
use System.Reflection.BindingFlags

// `LIST[T]` is a mutable list that grows as elements are added
// `|> LIST()` reads the whole sequence into a new `LIST`
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

class BOOK(title: string, pages: int) is
    borrowed: bool public

    init(..) is
        borrowed = false
    si

    words: int => pages * 300
si

let book = BOOK("Solaris", 204)
let flags = BindingFlags.INSTANCE | BindingFlags.PUBLIC

let properties =
    book.get_type().get_properties(flags)
        |> filter(p => p.declaring_type == book.get_type())
        |> LIST()

properties.sort((left, right) => string.compare(left.name, right.name))

for property in properties do
    let access =
        if property.can_write then
            "read and write"
        else
            "read only"
        fi

    write_line("{property.name}: {property.property_type.name}, {access}")
    write_line("  value now: {property.get_value(book)}")
od

let borrowed = book.get_type().get_property("borrowed")!

borrowed.set_value(book, cast object(true))

write_line("after setting it through reflection: {book.borrowed}")
