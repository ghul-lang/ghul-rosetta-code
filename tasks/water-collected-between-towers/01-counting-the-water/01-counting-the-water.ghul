use default
use System.Math

running_maxima(heights: Iterable[int]) -> int{} is
    let highest mut = 0

    for height in heights do
        highest = Math.max(highest, height)

        yield highest
    od
si

water(heights: int[]) -> int => (
    let left = running_maxima(heights) |> collect()
    let right =
        running_maxima(heights |> reverse()) |> collect()
    let last = heights.count - 1

    (0..heights.count)
    |> sum_by(i => Math.min(left[i], right[last - i]) - heights[i])
)

let series =
    [[1, 5, 3, 7, 2],
     [5, 3, 7, 2, 6, 4, 5, 9, 1, 2],
     [2, 6, 3, 5, 2, 8, 1, 4, 2, 2, 5, 3, 5, 7, 4, 1],
     [5, 5, 5, 5],
     [5, 6, 7, 8],
     [8, 7, 7, 6],
     [6, 7, 10, 7, 6]]

series |> each(towers =>
    write_line("{towers |> join(", ")} -> {water(towers)}"))
