use default
use System.Math

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `T[]` is the read-only list trait - elements can be read by index

running_maxima(heights: int{}) -> int{} is
    let highest mut = 0

    for height in heights do
        highest = Math.max(highest, height)

        yield highest
    od
si

water(heights: int[]) -> int => (
    let left = heights |> running_maxima() |> list()
    let right = heights |> reverse() |> running_maxima() |> list()
    let last = heights.count - 1

    (0..heights.count)
        |> sum_by(i => Math.min(left[i], right[last - i]) - heights[i])
)

let series = [
    [1, 5, 3, 7, 2],
    [5, 3, 7, 2, 6, 4, 5, 9, 1, 2],
    [2, 6, 3, 5, 2, 8, 1, 4, 2, 2, 5, 3, 5, 7, 4, 1],
    [5, 5, 5, 5],
    [5, 6, 7, 8],
    [8, 7, 7, 6],
    [6, 7, 10, 7, 6]
]

series
    |> each(towers =>
        write_line("{towers |> join(", ")} -> {water(towers)}")
    )
