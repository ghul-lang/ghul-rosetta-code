use default
use IO.Std.write
use Ghul.Coroutines

@suppress("non-pascal-case-name")
class OUT_OF_INK: System.Exception is
    init() is
        super.init("out of ink")
    si
si

union Reply is
    PRINTED
    NO_INK
si

use Reply.NO_INK
use Reply.PRINTED

class REQUEST(line: string, replies: CHANNEL[Reply])

class PRINTER is
    _name: string
    _ink: int
    _reserve: PRINTER?
    _requests: CHANNEL[REQUEST]

    init(name: string, ink: int, reserve: PRINTER?) is
        _name = name
        _ink = ink
        _reserve = reserve
        _requests = CHANNEL()
    si

    submit(line: string) -> COROUTINE[Reply] is
        let replies = CHANNEL()

        _requests.send(REQUEST(line, replies))

        return await replies.receive()
    si

    print(line: string) -> COROUTINE is
        let reply = await submit(line)

        if isa NO_INK(reply) then
            throw OUT_OF_INK()
        fi
    si

    serve() -> COROUTINE is
        do
            let request = await _requests.receive()

            if _ink > 0 then
                _ink = _ink - 1

                write("{_name}: ")

                for character in request.line do
                    write("{character}")

                    await pause()
                od

                write_line("")

                request.replies.send(PRINTED)
            elif let reserve = _reserve then
                request.replies.send(await reserve.submit(request.line))
            else
                request.replies.send(NO_INK)
            fi
        od
    si
si

let reserve = PRINTER("reserve", 5, null)
let main = PRINTER("main", 5, reserve)

writer(name: string, lines: string[]) -> COROUTINE is
    try
        for line in lines do
            await main.print(line)
        od
    catch exhausted: OUT_OF_INK
        write_line("{name} stopped: {exhausted.message}")
    yrt
si

main.serve()
reserve.serve()

writer("Humpty Dumpty", [
    "Humpty Dumpty sat on a wall",
    "Humpty Dumpty had a great fall",
    "All the king's horses",
    "And all the king's men",
    "Couldn't put Humpty",
    "Together again"
])

writer("Mother Goose", [
    "Old Mother Goose",
    "When she wanted to wander",
    "Would ride through the air",
    "On a very fine gander",
    "Jack's mother came in",
    "And caught the goose soon"
])

run()
