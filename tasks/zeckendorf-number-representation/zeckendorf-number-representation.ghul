use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

fibonacci_up_to(limit: int) -> int{} is
    let smaller mut = 1
    let larger mut = 2

    do
        yield smaller

        if larger > limit then
            break
        fi

        let next = smaller + larger

        smaller = larger
        larger = next
    od
si

zeckendorf(n: int) -> string is
    let digits = System.Text.StringBuilder()
    let remaining mut = n

    for value in fibonacci_up_to(n) |> reverse() do
        if value <= remaining then
            digits.append('1')

            remaining = remaining - value
        elif digits.length > 0 then
            digits.append('0')
        fi
    od

    return
        if digits.length == 0 then
            "0"
        else
            digits.to_string()
        fi
si

for n in 0::20 do
    write_line("{n,2}: {zeckendorf(n)}")
od
