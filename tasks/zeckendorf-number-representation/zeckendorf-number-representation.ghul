use default

let fibonacci = stream((1, 2), (a, b) => (a, (b, a + b)))

zeckendorf(n: int) -> string is
    let digits = Text.StringBuilder()
    let remaining mut = n

    for fib in fibonacci |> take_while(f => f <= n) |> reverse() do
        if fib <= remaining then
            digits.append('1')

            remaining = remaining - fib
        elif digits.length > 0 then
            digits.append('0')
        fi
    od

    if digits.length == 0 then "0" else digits.to_string() fi
si

for n in 0::20 do
    write_line("{n,2}: {zeckendorf(n)}")
od
