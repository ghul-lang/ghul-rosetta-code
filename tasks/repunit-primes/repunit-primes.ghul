use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read

repunit(base: int, digits: int) -> bigint =>
    (bigint.pow(bigint(base), digits) - 1n) / bigint(base - 1)

is_repunit_prime(base: int, digits: int) -> bool =>
    is_prime(repunit(base, digits))

let limit = 1000

// The base is named before its search rather than after it, so a reader
// watching the program run sees which one is taking the time. A base can
// take several seconds, and all of them together rather longer.
for base in 2::16 do
    IO.Std.write("base {base,3}: ")
    IO.Std.out.flush()

    let found =
        primes()
            |> take_while(p => p <= limit)
            |> filter(is_repunit_prime(base, *))
            |> list()

    write_line(
        if found.count == 0 then
            "none"
        else
            found |> join(" ")
        fi
    )
od
