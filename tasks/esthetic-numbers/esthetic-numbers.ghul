use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`

let digit_symbols = "0123456789abcdef"

render(value: long, base: int) -> string =>
    let
        digit = digit_symbols[int(value % cast(base))],
        rest = value / cast(base)
    in
        if rest > 0L then
            "{render(rest, base)}{digit}"
        else
            "{digit}"
        fi

esthetic(base: int) -> long{} is
    let pending = Queue()

    for digit in 1..base do
        pending.enqueue((long(digit), digit))
    od

    while true do
        let (value, last) = pending.dequeue()

        yield value

        for next in [last - 1, last + 1] do
            if next >= 0 /\ next < base then
                let extended = value * cast(base) + cast(next)

                pending.enqueue((extended, next))
            fi
        od
    od
si

for base in 2::16 do
    let shown =
        esthetic(base)
            |> skip(base * 4 - 1)
            |> take(base * 2 + 1)
            |> map(render(*, base))
            |> join(" ")

    write_line("base {base,2}, esthetic numbers {base * 4} to {base * 6}:")
    write_line("  {shown}")
od

show_range(low: long, high: long) is
    let matching =
        esthetic(10)
            |> filter(* >= low)
            |> take_while(* <= high)
            |> map(value => "{value}")
            |> list()

    write_line("")
    write_line("base 10 esthetic numbers between {low} and {high}:")

    for row in 0..(matching.count + 9) / 10 do
        let cells = matching |> skip(row * 10) |> take(10) |> join(" ")

        write_line("  {cells}")
    od
si

show_range(1_000L, 9_999L)
show_range(100_000_000L, 130_000_000L)
