use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`
// `==` compares identity

let squares = stream(1, n => n * n || n + 1)

write_line(
    squares
        |> skip_while(* < 100)
        |> take_while(* < 1000)
        |> filter(square => square % 2 == 1)
        |> join()
)
