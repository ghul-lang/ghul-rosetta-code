use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

mian_chowla() -> int{} is
    let terms = LIST()
    let sums = SET()
    let candidate mut = 1

    while true do
        let fresh =
            terms
                |> map(term => term + candidate)
                |> cat([candidate + candidate])
                |> list()

        if fresh |> all(sum => !sums.contains(sum)) then
            terms.add(candidate)
            sums.union_with(fresh)

            yield candidate
        fi

        candidate = candidate + 1
    od
si

write_line("the first 30 terms:")

mian_chowla()
    |> take(30)
    |> chunk(10)
    |> each(row => write_line(row |> map(n => "{n,6}") |> join("")))

write_line("")
write_line("terms 91 to 100:")

mian_chowla()
    |> skip(90)
    |> take(10)
    |> chunk(5)
    |> each(row => write_line(row |> map(n => "{n,8}") |> join("")))
