use default

mian_chowla() -> int{} is
    let terms = LIST()
    let sums = SET()
    let candidate mut = 1

    while true do
        let fresh = terms
            |> map(term => term + candidate)
            |> cat([candidate + candidate])
            |> collect()

        if fresh |> all(sum => !sums.contains(sum)) then
            terms.add(candidate)
            sums.union_with(fresh)

            yield candidate
        fi

        candidate = candidate + 1
    od
si

write_line("the first 30 terms:")

mian_chowla()
    |> take(30)
    |> chunk(10)
    |> each(row =>
        write_line(row |> map(n => "{n,6}") |> join("")))

write_line("")
write_line("terms 91 to 100:")

mian_chowla()
    |> skip(90)
    |> take(10)
    |> chunk(5)
    |> each(row =>
        write_line(row |> map(n => "{n,8}") |> join("")))
