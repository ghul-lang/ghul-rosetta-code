use default
use System.Math.*


tanh_sinh(
    f: double -> double, lower: double, upper: double,
    steps: int, accuracy: double
) -> double is
    let h = 0.1
    let half_width = (upper - lower) / 2.0
    let centre = (upper + lower) / 2.0
    let quarter_turn = pi / 2.0

    weighted(i) =>
        let t = double(i) * h in
        let s = sinh(t) * quarter_turn in
        let cosh_s = cosh(s) in
        let slope = cosh(t) * quarter_turn / (cosh_s * cosh_s) in
        f(centre + half_width * tanh(s)) * h * slope

    let result mut = 0.0

    for k in 1::steps do
        let previous = result
        let n = (1 << k) - 1

        result = half_width * (-n::n |> sum_by(weighted))

        if k > 1 /\ abs(result - previous) < accuracy then
            return result
        fi
    od

    result
si

let sine = tanh_sinh(x => sin(x), 0.0, 1.0, 5, 1.0e-9)
let exponential = tanh_sinh(x => exp(x), -3.0, 3.0, 5, 1.0e-9)

write_line("sin(x) from 0 to 1: {sine:F8}")
write_line("exp(x) from -3 to 3: {exponential:F7}")
