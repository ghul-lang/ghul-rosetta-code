use default

let smallest =
    from(1) |> find(c => c * c % 1000000 == 269696) ?? 0

let babbage = 99736L

write_line(
    "smallest: {smallest} squared is {smallest * smallest}"
)
write_line(
    "Babbage's: {babbage} squared is {babbage * babbage}"
)
write_line(
    "both end in 269696, so Babbage's answer was not the smallest"
)
