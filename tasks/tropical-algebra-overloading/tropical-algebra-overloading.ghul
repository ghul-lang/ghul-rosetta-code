use default

let minus_infinity = double.negative_infinity

struct TROPICAL(value: double) is
    ⊕(other: TROPICAL) -> TROPICAL =>
        TROPICAL(
            if value > other.value then
                value
            else
                other.value
            fi
        )

    ⊗(other: TROPICAL) -> TROPICAL => TROPICAL(value + other.value)

    ^(power: int) -> TROPICAL =>
        assert power > 0 else "exponent must be positive" in
        TROPICAL(value * cast(power))

    to_string() -> string =>
        if double.is_negative_infinity(value) then "-Inf"
        else "{value}"
        fi
si

let zero = TROPICAL(minus_infinity)
let one = TROPICAL(0.0)

show(text, result) => write_line("{text} is {result}")

show("2 ⊗ -2", TROPICAL(2.0) ⊗ TROPICAL(-2.0))
show("-0.001 ⊕ -Inf", TROPICAL(-0.001) ⊕ zero)
show("0 ⊗ -Inf", one ⊗ zero)
show("1.5 ⊕ -1", TROPICAL(1.5) ⊕ TROPICAL(-1.0))
show("-0.5 ⊗ 0", TROPICAL(-0.5) ⊗ one)
show("5 ^ 7", TROPICAL(5.0) ^ 7)

let a = TROPICAL(5.0)
let b = TROPICAL(8.0)
let c = TROPICAL(7.0)

show("5 ⊗ (8 ⊕ 7)", a ⊗ (b ⊕ c))
show("5 ⊗ 8 ⊕ 5 ⊗ 7", a ⊗ b ⊕ a ⊗ c)
