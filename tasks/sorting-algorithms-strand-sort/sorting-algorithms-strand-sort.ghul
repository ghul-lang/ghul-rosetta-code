use default

merge(left: List[int], right: List[int]) -> int{} =>
    case (left, right)
    when ([], _) then right
    when (_, []) then left
    when ([x, ..xr], [y, ..yr]) then
        if x <= y then
            [x] ++ merge(xr, right)
        else
            [y] ++ merge(left, yr)
        fi
    esac

strand_sort(values: List[int]) -> int{} is
    let remaining = LIST()

    remaining.add_range(values)

    let sorted mut = LIST()

    while remaining.count > 0 do
        let strand = LIST()

        strand.add(remaining[0])
        remaining.remove_at(0)

        let at mut = 0

        while at < remaining.count do
            if remaining[at] >= strand[strand.count - 1] then
                strand.add(remaining[at])
                remaining.remove_at(at)
            else
                at = at + 1
            fi
        od

        sorted = merge(sorted, strand) |> collect_mutable()
    od

    return sorted
si

for values in [[5, 3, 1, 7, 4, 1, 1, 20], [2, 1], [8]] do
    write_line(
        "{values |> join(" ")} -> {values |> strand_sort() |> join(" ")}"
    )
od
