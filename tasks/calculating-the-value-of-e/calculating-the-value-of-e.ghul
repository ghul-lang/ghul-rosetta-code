use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `yield` makes the function a generator: it returns a lazy `T{}`.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

reciprocal_factorials() -> decimal{} is
    let term mut = 1m
    let n mut = 1

    do
        yield term
        term = term / cast(n)
        n = n + 1
    od
si

let e = reciprocal_factorials() |> take(30) |> sum()

write_line("e = {e}")
