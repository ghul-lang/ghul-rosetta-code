use default
use IO.Std.write

union Term is
    VAR(index: int)
    LAM(body: Term)
    APP(function: Term, argument: Term)
    ATOM(tag: int)
    PAIR
si

class ENV(first: THUNK, rest: ENV?)

union Value is
    CLOSURE(term: Term, env: ENV?)
    PAIRED(head: THUNK, tail: THUNK)
si

class THUNK(term: Term, env: ENV?) is
    value: Value? public
si

union Frame is
    ARGUMENT(thunk: THUNK)
    UPDATE(thunk: THUNK)
si

union Result is
    FUNCTION
    CONSTANT(tag: int)
    CONS(head: THUNK, tail: THUNK)
si

lookup(env: ENV?, index: int) -> THUNK => (
    let e mut = env!

    for _ in 1..index do
        e = e.rest!
    od

    e.first
)

evaluate(start: THUNK, arguments: List[THUNK]) -> Result is
    let stack = STACK()

    for i in 0..arguments.count do
        stack.push(
            Frame.ARGUMENT(arguments[arguments.count - 1 - i])
        )
    od

    let settle = value is
        while stack.count > 0 do
            if let update: Frame.UPDATE = stack.peek() then
                update.thunk.value = value
                stack.pop()
            else
                return
            fi
        od
    si

    let argument =
        () =>
            if let (thunk): Frame.ARGUMENT = stack.pop() then
                thunk
            else
                throw System.InvalidOperationException(
                    "argument expected"
                )
            fi

    let term mut = Term.VAR(1)
    let env mut = ENV(start, null)

    do
        case term
        when (function, operand): Term.APP then
            stack.push(Frame.ARGUMENT(THUNK(operand, env)))
            term = function
        when (body): Term.LAM then
            settle(Value.CLOSURE(term, env))

            if stack.count == 0 then
                return Result.FUNCTION
            fi

            env = ENV(argument(), env)
            term = body
        when (index): Term.VAR then
            let thunk = lookup(env, index)

            case thunk.value
            when (head, tail): Value.PAIRED then
                settle(Value.PAIRED(head, tail))

                return Result.CONS(head, tail)
            when (closure, closure_env): Value.CLOSURE then
                term = closure
                env = closure_env
            else
                stack.push(Frame.UPDATE(thunk))
                term = thunk.term
                env = thunk.env
            esac
        when (tag): Term.ATOM then
            settle(Value.CLOSURE(term, null))

            return Result.CONSTANT(tag)
        else
            let head = argument()
            let tail = argument()

            settle(Value.PAIRED(head, tail))

            return Result.CONS(head, tail)
        esac
    od
si

let truth = Term.LAM(Term.LAM(Term.VAR(2)))
let falsity = Term.LAM(Term.LAM(Term.VAR(1)))

cons(head: Term, tail: Term) -> Term =>
    Term.LAM(Term.APP(Term.APP(Term.VAR(1), head), tail))

bit(b: bool) -> Term => if b then falsity else truth fi

byte(b: int) -> Term =>
    from(0)
        |> take(8)
        |> reduce(falsity, (result, i) =>
            cons(bit((b >> i) & 1 == 1), result)
        )

list(items: List[Term]) -> Term =>
    case items
    when [] then falsity
    when [x, ..rest] then cons(x, list(rest))
    esac

class READER(bits: List[bool]) is
    at: int public

    next() -> bool is
        at = at + 1
        bits[at - 1]
    si

    term() -> Term is
        if !next() then
            return
                if !next() then Term.LAM(term())
                else Term.APP(term(), term())
                fi
        fi

        let index mut = 1

        while next() do
            index = index + 1
        od

        Term.VAR(index)
    si
si

constant(term: Term) -> THUNK => (
    let thunk = THUNK(term, null)

    thunk.value = Value.CLOSURE(term, null)
    thunk
)

let top = constant(Term.PAIR)
let zero = constant(Term.ATOM(0))
let one = constant(Term.ATOM(1))

items(thunk: THUNK, limit: int) -> THUNK{} is
    if limit > 0 then
        if let
            (head, tail): Result.CONS = evaluate(thunk, [top])
        then
            yield head
            yield in items(tail, limit - 1)
        fi
    fi
si

bit_of(thunk: THUNK) -> int =>
    if let
        (tag): Result.CONSTANT = evaluate(thunk, [zero, one])
    then
        tag
    else throw System.InvalidOperationException("bit expected")
    fi

bits_of(bytes: List[int]) -> List[bool] => [
    (b >> (7 - i)) & 1 == 1
    for b in bytes
    for i in 0..8
]

run_bits(program: string, limit: int) -> string =>
    let
        bits = program |> map(* == '1') |> collect(),
        reader = READER(bits),
        term = reader.term(),
        input = list(
            bits |> skip(reader.at) |> map(bit) |> collect()
        )
    in
        items(THUNK(Term.APP(term, input), null), limit)
            |> map(t => "{bit_of(t)}")
            |> join("")

run_bytes(bytes: List[int], limit: int) -> string =>
    let
        reader = READER(bits_of(bytes)),
        term = reader.term(),
        used = (reader.at + 7) / 8,
        rest = bytes |> skip(used) |> map(byte) |> collect()
    in
        items(THUNK(Term.APP(term, list(rest)), null), limit)
            |> map(b =>
                let value =
                    items(b, 8)
                        |> reduce(0, (a, t) =>
                            a * 2 + bit_of(t)
                        )
                in
                "{char(value)}"
            )
            |> join("")

let programs = [
    (
        name = "the 342 bit program", limit = 1000,
        program =
            "010100011010000000011000010110011110000010010111"
            "110111100001010110000000011000011111000000101111"
            "110110010111111011001011110100111010111100010000"
            "001011100101010001101000000000010110000101011111"
            "101111100000010101111011111011111100001011000000"
            "101111111010110111000000111111000010110111101110"
            "011110100000010110000011011000100000101111000111"
            "001110"
    ),
    (
        name = "the quine", limit = 1000,
        program =
            "000101100100011010000000000001011011110010111100"
            "111111011111011010000101100100011010000000000001"
            "011011110010111100111111011111011010"
    ),
    (
        name = "100 doors", limit = 100,
        program =
            "000100010001010100011010000001011000001100111011"
            "001010001101000000000010111111100000010111110101"
            "100101100100011010000111110011010010111110111100"
            "000000101111111111011001100111111101110000000010"
            "111111000000101111101011001101110010101100000010"
            "111101100101111001111001111011010000000000101101"
            "110011101111000000000100000011100111010000000010"
            "1101110110"
    ),
    (
        name = "the sieve of Eratosthenes", limit = 100,
        program =
            "000100011001100101000110100000000101100000100100"
            "010101111101111010010001101000011100110100000000"
            "001011011100111001111111011110000000011111001101"
            "11000000101100000110110"
    )
]

write_line("bit mode")

for (name, limit, program) in programs do
    write_line()
    write_line("{name}:")
    write_line(run_bits(program, limit))
od

let query = "010000011100111001110100000011100111010"

let symbolic =
    IO.File.read_all_bytes("symbolic.Blc")
        |> map(int)
        |> cat(query |> map(int))
        |> collect()

let hilbert =
    IO.File.read_all_bytes("hilbert.Blc")
        |> map(int)
        |> collect()

write_line()
write_line("byte mode")
write_line()
write_line("hilbert.Blc, which ends with the input 123:")
write(run_bytes(hilbert, 100000))
write_line()
write_line("symbolic.Blc with input {query}:")
write(run_bytes(symbolic, 100000))
