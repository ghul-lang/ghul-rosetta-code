use default

if2(
    first: bool,
    second: bool,
    both: () -> void,
    first_only: () -> void,
    second_only: () -> void,
    neither: () -> void
) is
    if first /\ second then
        both()
    elif first then
        first_only()
    elif second then
        second_only()
    else
        neither()
    fi
si

for
    pair in [
        (true, true),
        (true, false),
        (false, true),
        (false, false)
    ]
do
    if2(
        pair.`0,
        pair.`1,
        () => write_line("{pair}: both"),
        () => write_line("{pair}: the first only"),
        () => write_line("{pair}: the second only"),
        () => write_line("{pair}: neither")
    )
od
