use default
use Raster.ANIMATION
use Raster.IMAGE

use Color = (red: ubyte, green: ubyte, blue: ubyte)

use Body = (
    name: string,
    radius: double,
    period: double,
    start: double,
    color: Color
)

let size = 160
let years = 8.0
let shown = 2.2
let frames = 88

rgb(r, g, b) => (
    red = ubyte(r),
    green = ubyte(g),
    blue = ubyte(b)
)

let earth: Body = ("Earth", 1.0, 1.0, 100.46, rgb(60, 110, 220))

let bodies: Body[] = [
    ("Sun", 0.0, 1.0, 0.0, rgb(255, 190, 40)),
    ("Mercury", 0.387, 0.2408, 252.25, rgb(170, 170, 170)),
    ("Venus", 0.723, 0.6152, 181.98, rgb(230, 200, 120)),
    ("Mars", 1.524, 1.8809, 355.45, rgb(220, 70, 50))
]

around_sun(body, year) =>
    let
        turns = body.start / 360.0 + year / body.period,
        angle = 2.0 * pi * turns
    in
        (x = body.radius * cos(angle), y = body.radius * sin(angle))

around_earth(body, year) =>
    let
        p = around_sun(body, year),
        e = around_sun(earth, year)
    in
        (x = p.x - e.x, y = p.y - e.y)

turning(body, from, to) =>
    let
        a = around_earth(body, from),
        b = around_earth(body, to)
    in
        atan2(a.x * b.y - a.y * b.x, a.x * b.x + a.y * b.y)

retrograde_loops(body) is
    let steps = int(years * 2000.0)
    let loops mut = 0
    let backwards mut = false

    for step in 1..steps do
        let year = years * double(step) / double(steps)
        let previous = years * double(step - 1) / double(steps)
        let change = turning(body, previous, year)

        if change < 0.0 /\ !backwards then
            loops = loops + 1
        fi

        backwards = change < 0.0
    od

    loops
si

year_of(frame) => shown * double(frame) / double(frames)

draw(image, frame) is
    image.clear(8ub, 8ub, 20ub)
    image.stroke(1.0)

    for body in bodies do
        let trail =
            (0::frame) |> map(f => around_earth(body, year_of(f))) |> list()

        let here = trail[trail.count - 1]
        let marker = if body.name =~ "Sun" then 4.0 else 2.5 fi

        image.color(body.color.red, body.color.green, body.color.blue)

        if trail.count > 1 then
            image.line(trail)
        fi

        image.dot(here.x, here.y, marker)
    od

    image.color(earth.color.red, earth.color.green, earth.color.blue)
    image.dot(0.0, 0.0, 3.5)
si

for body in bodies do
    let loops = retrograde_loops(body)

    write_line("{body.name,-8} {loops,2} retrograde loops in {years} years")
od

let image = IMAGE(size, size)

image.view(-2.7, -2.7, 2.7, 2.7)

let animation = ANIMATION(size, size)

for frame in 0..frames do
    draw(image, frame)
    animation.add(image, 100)
od

animation.write("geocentric.png")

animation.show("geocentric.png")
