use default
use Raster.IMAGE

use POINT = (x: double, y: double)

let steps = 200

cubic(a, b, c, d) =>
    (0..steps + 1)
        |> map(step => (
            let t = double(step) / double(steps)
            let u = 1.0 - t

            (
                x =
                    u * u * u * a.x +
                    3.0 * u * u * t * b.x +
                    3.0 * u * t * t * c.x +
                    t * t * t * d.x,
                y =
                    u * u * u * a.y +
                    3.0 * u * u * t * b.y +
                    3.0 * u * t * t * c.y +
                    t * t * t * d.y
            )
        ))
        |> list()

let start = (x = 20.0, y = 200.0)
let first = (x = 60.0, y = 20.0)
let second = (x = 240.0, y = 220.0)
let finish = (x = 280.0, y = 40.0)

let image = IMAGE(300, 240)

image.color(190ub, 190ub, 190ub)
image.stroke(1.0)
image.line([start, first, second, finish])

image.color(0ub, 0ub, 160ub)
image.stroke(2.0)
image.line(cubic(start, first, second, finish))

image.write("cubic.png")

image.show("cubic.png")
