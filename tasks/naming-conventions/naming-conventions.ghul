use default

// the case of each name says what it names
trait Shape is
    area: double
si

class Square(side: double): Shape is
    area: double => side * side
si

union Reading is
    CELSIUS(degrees: double)
    MISSING
si

enum Color is
    RED,
    GREEN
si

total_area(shapes) =>
    shapes |> sum_by(shape => shape.area)

// a leading underscore makes a member private to its class
class Counter is
    _count: int

    init() is
        _count = 0
    si

    bump() -> int is
        _count = _count + 1
        return _count
    si
si

class Point(x: int public, y: int public)

// the compiler warns about each of these three
enum Direction is
    north
si
trait drawable is
si
CountItems(items) => items.count

let counter = Counter()
counter.bump()

write_line("total area {total_area([Square(2.0), Square(3.0)])}")
write_line("counter at {counter.bump()}")
write_line("{Color.GREEN} {Reading.CELSIUS(21.5)}")
write_line("point {Point(3, 4).x}, {CountItems([1, 2, 3])} items")

// .NET names are read in ghūl's conventions
write_line("{System.DateTime.days_in_month(2024, 2)} days")
