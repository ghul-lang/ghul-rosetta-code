use default

// the case of each name says what it names
trait Shape is
    area: double
si

class SQUARE(side: double): Shape is
    area: double => side * side
si

union Reading is
    CELSIUS(degrees: double)
    MISSING
si

enum Colour is
    RED,
    GREEN
si

total_area(shapes: Shape[]) -> double =>
    shapes |> sum_by(shape => shape.area)

// a leading underscore makes a member private to its class
class COUNTER is
    _count: int

    init() is
        _count = 0
    si

    bump() -> int is
        _count = _count + 1
        return _count
    si
si

// the compiler warns about each of these three
class Point(x: int public, y: int public)
trait drawable is
si
CountItems(items: int[]) -> int => items.count

let counter = COUNTER()
counter.bump()

write_line(
    "total area {total_area([SQUARE(2.0), SQUARE(3.0)])}"
)
write_line("counter at {counter.bump()}")
write_line("{Colour.GREEN} {Reading.CELSIUS(21.5)}")
write_line(
    "point {Point(3, 4).x}, {CountItems([1, 2, 3])} items"
)

// .NET names are read in ghūl's conventions
write_line("{System.DateTime.days_in_month(2024, 2)} days")
