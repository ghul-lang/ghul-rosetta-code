use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

largest_truncatable(base: int) -> bigint is
    let radix = bigint(base)

    let level mut = 1::base - 1 |> map(bigint) |> filter(is_prime) |> list()

    let place mut = radix
    let largest mut = 0n

    while level.count > 0 do
        largest = level |> max_by(c => c)!
        level = [
            bigint(digit) * place + candidate
            for candidate in level
            for digit in 1::base - 1
        ]
            |> filter(is_prime)
            |> list()

        place = place * radix
    od

    largest
si

for base in 3::12 do
    IO.Std.write("base {base,3}: ")
    IO.Std.out.flush()

    write_line("{largest_truncatable(base)}")
od
