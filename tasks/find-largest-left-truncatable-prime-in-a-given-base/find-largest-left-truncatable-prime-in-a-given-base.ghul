use default
use bigint.mod_pow

let witnesses = [2n, 3n, 5n, 7n, 11n, 13n, 17n, 19n, 23n, 29n, 31n, 37n]

is_prime(n: bigint) -> bool is
    if n < 2n then
        return false
    fi

    for small in witnesses do
        if n =~ small then
            return true
        elif n % small =~ 0n then
            return false
        fi
    od

    let odd_part mut = n - 1n
    let shifts mut = 0

    while odd_part % 2n =~ 0n do
        odd_part = odd_part / 2n
        shifts = shifts + 1
    od

    for witness in witnesses do
        let residue mut = mod_pow(witness, odd_part, n)

        if residue =~ 1n \/ residue =~ n - 1n then
            continue
        fi

        let composite mut = true

        for _ in 1..shifts do
            residue = residue * residue % n

            if residue =~ n - 1n then
                composite = false

                break
            fi
        od

        if composite then
            return false
        fi
    od

    return true
si

largest_truncatable(base: int) -> bigint is
    let radix = bigint(base)

    let level mut =
        1::base - 1
            |> map(bigint)
            |> filter(is_prime)
            |> collect()

    let place mut = radix
    let largest mut = 0n

    while level.count > 0 do
        largest =
            level
                |> reduce(0n, (best, candidate) =>
                    if candidate > best then candidate else best fi)

        level =
            [bigint(digit) * place + candidate
                for candidate in level for digit in 1::base - 1]
                |> filter(is_prime)
                |> collect()

        place = place * radix
    od

    return largest
si

for base in 3::12 do
    IO.Std.write("base {base,3}: ")
    IO.Std.out.flush()

    write_line("{largest_truncatable(base)}")
od
