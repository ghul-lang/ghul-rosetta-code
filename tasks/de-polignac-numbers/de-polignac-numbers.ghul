use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`
// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `*` as an argument leaves that parameter open: partial application.
// `T{}` is a lazy sequence of `T`, read by iterating it.

is_de_polignac(n: int) -> bool =>
    from(0)
        |> map(1 << *)
        |> take_while(* < n)
        |> all(power => !is_prime(n - power))

de_polignac_numbers() -> int{} => from(1, 2) |> filter(is_de_polignac)

write_line("First 50 de Polignac numbers:")

for row in de_polignac_numbers() |> take(50) |> chunk(10) do
    write_line(row |> map(n => "{n,6:N0}") |> join(""))
od

write_line()

for position in [1_000, 10_000] do
    let found =
        de_polignac_numbers() |> skip(position - 1) |> first_or_throw()

    write_line("{position:N0}th: {found:N0}")
od
