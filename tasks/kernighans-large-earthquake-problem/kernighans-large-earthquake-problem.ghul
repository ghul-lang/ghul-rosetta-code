use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

magnitude(line: string) -> double =>
    double.parse((words(line) |> list())[2])

IO.File.read_lines("data.txt")
    |> filter(line => magnitude(line) > 6.0D)
    |> each(line => write_line(line))
