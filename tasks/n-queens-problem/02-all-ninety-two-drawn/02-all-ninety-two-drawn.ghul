use default
use Raster.IMAGE

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `T{}` is a lazy sequence of `T`, read by iterating it.

let cell = 9
let side = cell * 8
let gap = 6
let across = 12
let margin = 12
let header = 40

safe(queens: int[], row: int, column: int) -> bool =>
    queens
        |> index()
        |> all((placed_row, placed_column) =>
            placed_column != column /\
            placed_row - placed_column != row - column /\
            placed_row + placed_column != row + column
        )

placements(n: int, queens: int[]) -> int[]{} is
    if queens.count == n then
        yield queens
    else
        for column in 0..n do
            if safe(queens, queens.count, column) then
                yield in placements(n, queens ++ [column] |> list())
            fi
        od
    fi
si

board(image: IMAGE, solution: int[], left: int, top: int) is
    for row in 0..8 do
        for column in 0..8 do
            if (row + column) % 2 == 1 then
                image.colour(202ub, 212ub, 228ub)
            else
                image.colour(243ub, 245ub, 250ub)
            fi

            image.fill_rectangle(
                double(left + column * cell),
                double(top + row * cell),
                double(left + column * cell + cell),
                double(top + row * cell + cell)
            )
        od
    od

    image.colour(25ub, 50ub, 105ub)

    let half = 0.5 * double(cell)

    for placed in solution |> index() do
        image.dot(
            double(left + placed.value * cell) + half,
            double(top + placed.index * cell) + half,
            0.32 * double(cell)
        )
    od
si

let solutions = placements(8, []) |> list()

let down = (solutions.count + across - 1) / across

let image = IMAGE(
    margin * 2 + across * (side + gap) - gap,
    header + margin + down * (side + gap) - gap
)

image.colour(70ub, 75ub, 90ub)
image.text(
    double(margin),
    26.0,
    16.0,
    "all {solutions.count} solutions to the eight queens problem"
)

for solution in solutions |> index() do
    board(
        image,
        solution.value,
        margin + solution.index % across * (side + gap),
        header + solution.index / across * (side + gap)
    )
od

image.write("queens.png")

image.show("queens.png")
