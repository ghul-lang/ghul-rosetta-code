use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity
// `if let` pattern-matches, and `[x, ..rest]` matches a list head and tail

safe(queens: int[], row: int, column: int) -> bool =>
    queens
        |> index()
        |> all((placed_row, placed_column) =>
            placed_column != column /\
            placed_row - placed_column != row - column /\
            placed_row + placed_column != row + column
        )

placements(n: int, queens: int[]) -> int[]{} is
    if queens.count == n then
        yield queens
    else
        for column in 0..n do
            if safe(queens, queens.count, column) then
                yield in placements(n, queens ++ [column] |> list())
            fi
        od
    fi
si

for n in 1::8 do
    write_line("{n} by {n}: {placements(n, []) |> count()} solutions")
od

write_line("an 8 queens solution:")

if let first_solution = placements(8, []) |> first() then
    first_solution
        |> index()
        |> each((row, column) =>
            write_line(
                (0..8)
                    |> map(c => if c == column then "♕" else "．" fi)
                    |> join(" ")
            )
        )
fi
