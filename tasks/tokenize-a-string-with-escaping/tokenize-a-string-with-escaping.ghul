use default
use System.Text.StringBuilder

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `==` compares identity
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence

tokenize(text: string, separator: char, escape: char) -> string{} is
    let token = StringBuilder()
    let escaped mut = false

    for character in text do
        if escaped then
            token.append(character)
            escaped = false
        elif character == escape then
            escaped = true
        elif character == separator then
            yield token.to_string()
            token.clear()
        else
            token.append(character)
        fi
    od

    yield token.to_string()
si

tokenize("one^|uno||three^^^^|four^^^|^cuatro|", '|', '^')
    |> each(token => write_line("\"{token}\""))
