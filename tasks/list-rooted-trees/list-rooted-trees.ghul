use default

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

trees(bags: int) -> string[] memo =>
    if bags == 1 then
        ["()"]
    else
        forests(bags - 1, null) |> map(forest => "({forest})") |> list()
    fi

forests(bags: int, largest: string?) -> string{} is
    if bags == 0 then
        yield ""
        return
    fi

    for size in 1::bags do
        for first in trees(size) do
            if largest? /\ first > largest then
                continue
            fi

            for rest in forests(bags - size, first) do
                yield "{first}{rest}"
            od
        od
    od
si

plural(count: int, noun: string) -> string =>
    "{count} {noun}{if count == 1 then "" else "s" fi}"

for bags in 1::5 do
    let ways = trees(bags) |> list()

    write_line("{plural(bags, "bag")}, {plural(ways.count, "way")}")

    for way in ways do
        write_line("  {way}")
    od

    write_line("")
od

let counts = 1::9 |> map(n => trees(n) |> count())

write_line("ways for 1 to 9 bags: {counts}")
