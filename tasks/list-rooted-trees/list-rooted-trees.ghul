use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity
// `memo` on a function caches its results - a call with arguments equal to
//  an earlier call's returns the cached result, recursive calls included

trees(bags: int) -> string[] memo =>
    if bags == 1 then
        ["()"]
    else
        forests(bags - 1, null) |> map(forest => "({forest})") |> list()
    fi

forests(bags: int, largest: string?) -> string{} is
    if bags == 0 then
        yield ""
        return
    fi

    for size in 1::bags do
        for first in trees(size) do
            if largest? /\ first > largest then
                continue
            fi

            for rest in forests(bags - size, first) do
                yield "{first}{rest}"
            od
        od
    od
si

plural(count: int, noun: string) -> string =>
    "{count} {noun}{if count == 1 then "" else "s" fi}"

for bags in 1::5 do
    let ways = trees(bags) |> list()

    write_line("{plural(bags, "bag")}, {plural(ways.count, "way")}")

    for way in ways do
        write_line("  {way}")
    od

    write_line("")
od

let counts = 1::9 |> map(n => trees(n) |> count())

write_line("ways for 1 to 9 bags: {counts}")
