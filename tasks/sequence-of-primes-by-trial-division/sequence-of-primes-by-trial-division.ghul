use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `LIST[T]` is a mutable list that grows as elements are added
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

primes() -> int{} is
    let found = LIST()
    let candidate mut = 2

    while true do
        let is_prime =
            found
                |> take_while(p => p * p <= candidate)
                |> all(p => candidate % p != 0)

        if is_prime then
            found.add(candidate)

            yield candidate
        fi

        candidate = candidate + 1
    od
si

let first = primes() |> take(100)

for row in 0..10 do
    let cells = first |> skip(row * 10) |> take(10)

    write_line(cells |> map(p => "{p,4}") |> join(""))
od
