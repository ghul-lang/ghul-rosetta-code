use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `=~` compares values (structural equality) - `==` compares identity
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence

write_line("summing digit powers, which takes a moment")
write_line("")

exponents(n: int, highest: int) -> int{} is
    let value = bigint(n)
    let power mut = value

    for e in 2::highest do
        power = power * value

        if digit_sum(power) =~ value then
            yield e
        fi
    od
si

report(wanted: int, least_ways: int, highest: int) is
    let found =
        from(2)
            |> map(n => (n, exponents(n, highest) |> list()))
            |> filter(((_, ways)) => ways.count >= least_ways)
            |> take(wanted)

    for (n, ways) in found do
        write_line(ways |> map(e => "{n}^{e}") |> join())
    od
si

write_line("first twenty:")

report(20, 1, 100)

write_line()
write_line("first ten in three or more ways:")

report(10, 3, 500)
