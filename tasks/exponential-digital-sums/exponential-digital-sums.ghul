use default

write_line("summing digit powers, which takes a moment")
write_line("")

digit_sum(digits: string) -> int =>
    digits |> reduce(0, (sum, c) => sum + int(c) - int('0'))

exponents(n: int, highest: int) -> int{} is
    let value = bigint(n)
    let power mut = value

    for e in 2::highest do
        power = power * value

        if digit_sum("{power}") == n then
            yield e
        fi
    od
si

report(wanted: int, least_ways: int, highest: int) is
    let found = from(2)
        |> map(n => (n, exponents(n, highest) |> collect()))
        |> filter(((_, ways)) => ways.count >= least_ways)
        |> take(wanted)

    for (n, ways) in found do
        write_line(ways |> map(e => "{n}^{e}") |> join())
    od
si

write_line("first twenty:")

report(20, 1, 100)

write_line()
write_line("first ten in three or more ways:")

report(10, 3, 500)
