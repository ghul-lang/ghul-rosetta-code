use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read, and `count` reads it all
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.
// `T{}` is a lazy sequence of `T`, read by iterating it.

is_colorful(value: int) -> bool is
    if value < 10 then return true fi

    let figures = Ghul.Pipes.digits(value) |> list()

    if figures |> any(d => d < 2) then return false fi

    let seen = SET()

    for start in 0..figures.count do
        let product mut = 1

        for step in start..figures.count do
            product = product * figures[step]

            if !seen.add(product) then return false fi
        od
    od

    true
si

arrangements(prefix: int, available: int[]) -> int{} is
    for chosen in available do
        let value = prefix * 10 + chosen
        let rest = LIST(available)

        rest.remove(chosen)

        if prefix > 0 then
            yield value
        fi

        yield in arrangements(value, rest)
    od
si

let digits = LIST(2::9)

let candidates = (0::9) ++ arrangements(0, digits)
let colorful = candidates |> filter(is_colorful) |> LIST()

colorful.sort()

let small = colorful |> filter(* < 100) |> map(v => "{v}")

write_line("the colorful numbers below 100:")
write_line("  {small |> join(" ")}")

write_line("")
write_line("the largest colorful number is {colorful[colorful.count - 1]}")

write_line("")
write_line("how many colorful numbers each order of magnitude holds:")

for width in 1::8 do
    let below = colorful |> filter(v => "{v}".length == width) |> count()

    write_line("  {width} digit: {below}")
od

write_line("")
write_line("there are {colorful.count} colorful numbers in all")
