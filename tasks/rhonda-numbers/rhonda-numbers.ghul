use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`
// `==` compares identity

is_rhonda(value: int, base: int) -> bool =>
    value |> digits(base) |> product() ==
    base * (value |> prime_factors() |> sum())

rhondas(base: int) -> int{} => from(2) |> filter(is_rhonda(*, base))

write_line("the first ten Rhonda numbers, shown in base ten:")

for base in 2::36 |> filter(b => !is_prime(b)) do
    let found = rhondas(base) |> take(10) |> map(term => "{term,8}")

    write_line("base {base,2}:{found |> join("")}")
od
