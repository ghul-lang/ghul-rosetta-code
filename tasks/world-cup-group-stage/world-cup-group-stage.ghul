use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `LIST()` builds its collection eagerly
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity
// `case ... when` pattern-matches, and `[x, ..rest]` matches a list head
//  and tail

enum Result is
    HOME_WIN,
    DRAW,
    AWAY_WIN
si

let games = [(0, 1), (0, 2), (0, 3), (1, 2), (1, 3), (2, 3)]

outcomes(count: int) -> Result[]{} is
    if count == 0 then
        yield LIST()
        return
    fi

    for rest in outcomes(count - 1) do
        for
            result in [
                Result.HOME_WIN, Result.DRAW, Result.AWAY_WIN
            ]
        do
            yield rest ++ [result] |> list()
        od
    od
si

standings(results: Result[]) -> int{} => (
    let points = repeat(0, 4) |> LIST()

    for ((home, away), result) in zip(games, results) do
        let (home_points, away_points) =
            case result
            when Result.HOME_WIN then (3, 0)
            when Result.DRAW then (1, 1)
            when Result.AWAY_WIN then (0, 3)
            esac

        points[home] = points[home] + home_points
        points[away] = points[away] + away_points
    od

    points |> sort_descending()
)

let histogram = (0..4) |> map(_ => repeat(0, 10) |> LIST()) |> list()

for results in outcomes(games.count) do
    for (place, points) in results |> standings() |> index() do
        histogram[place][points] = histogram[place][points] + 1
    od
od

let places = ["1st", "2nd", "3rd", "4th"]

write_line("points     {(0::9) |> map(p => "{p,5}") |> join("")}")
write_line(string('-', 60))

for (place, counts) in histogram |> index() do
    let row = counts |> map(c => "{c,5}") |> join("")
    write_line("{places[place]} place{row}")
od
