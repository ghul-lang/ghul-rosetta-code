use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

is_duffinian(value: int) -> bool =>
    !is_prime(value) /\ gcd(value, divisor_sum(value)) == 1

duffinians() -> int{} => from(2) |> filter(is_duffinian)

triplets() -> int{} =>
    from(2)
        |> filter(c =>
            is_duffinian(c) /\ is_duffinian(c + 1) /\ is_duffinian(c + 2)
        )

write_line("the first fifty Duffinian numbers:")

let first_fifty = duffinians() |> take(50) |> map(v => "{v,5}") |> list()

for row in 0..5 do
    write_line(first_fifty[row * 10..row * 10 + 10] |> join(""))
od

write_line("")
write_line("the first fifteen Duffinian triplets:")

for start in triplets() |> take(15) do
    write_line("  {start} {start + 1} {start + 2}")
od
