use default

class MATRIX(cells: double[][]) is
    _cells

    _both(other: MATRIX, op: (double, double) -> double pure) -> MATRIX =>
        MATRIX(
            _cells
            |> zip(
                other._cells,
                (a, b) => a |> zip(b, op) |> collect())
            |> collect())

    _each(op: (double) -> double pure) -> MATRIX =>
        MATRIX(
            _cells
            |> map(row => row |> map(op) |> collect())
            |> collect())

    // A scalar on the left becomes a matrix of that scalar, which
    // keeps subtraction and division the right way round.
    constant(value: double) -> MATRIX =>
        _each(_ => value)

    +(other: MATRIX) -> MATRIX => _both(other, (a, b) => a + b)
    -(other: MATRIX) -> MATRIX => _both(other, (a, b) => a - b)
    *(other: MATRIX) -> MATRIX => _both(other, (a, b) => a * b)
    /(other: MATRIX) -> MATRIX => _both(other, (a, b) => a / b)
    ^(other: MATRIX) -> MATRIX =>
        _both(other, (a, b) => System.Math.pow(a, b))

    +(k: double) -> MATRIX => _each(a => a + k)
    -(k: double) -> MATRIX => _each(a => a - k)
    *(k: double) -> MATRIX => _each(a => a * k)
    /(k: double) -> MATRIX => _each(a => a / k)
    ^(k: double) -> MATRIX => _each(System.Math.pow(*, k))

    to_string() -> string =>
        _cells
        |> map(row => row |> map(c => "{c,11:F3}") |> join(""))
        |> join("\n")
si

+(k: double, m: MATRIX) -> MATRIX => m.constant(k) + m
-(k: double, m: MATRIX) -> MATRIX => m.constant(k) - m
*(k: double, m: MATRIX) -> MATRIX => m.constant(k) * m
/(k: double, m: MATRIX) -> MATRIX => m.constant(k) / m
^(k: double, m: MATRIX) -> MATRIX => m.constant(k) ^ m

show(label: string, m: MATRIX) is
    write_line("{label} =")
    write_line("{m}")
    write_line("")
si

let a = MATRIX([[1.0, 2.0], [3.0, 4.0]])
let b = MATRIX([[5.0, 6.0], [7.0, 8.0]])

show("a", a)
show("b", b)

show("a + b", a + b)
show("a - b", a - b)
show("a * b", a * b)
show("a / b", a / b)
show("a ^ b", a ^ b)

show("a + 10", a + 10.0)
show("a - 10", a - 10.0)
show("a * 10", a * 10.0)
show("a / 10", a / 10.0)
show("a ^ 2", a ^ 2.0)

show("10 - a", 10.0 - a)
show("10 / a", 10.0 / a)
show("2 ^ a", 2.0 ^ a)
