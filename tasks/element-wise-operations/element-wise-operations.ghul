use default

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`

class MATRIX(cells: double[][]) is
    _cells

    _both(other: MATRIX, op: (double, double) -> double pure) -> MATRIX =>
        MATRIX(
            _cells
                |> zip(other._cells, (a, b) => a |> zip(b, op) |> list())
                |> list()
        )

    _each(op: (double) -> double pure) -> MATRIX =>
        MATRIX(_cells |> map(row => row |> map(op) |> list()) |> list())

    // A scalar on the left becomes a matrix of that scalar, which
    // keeps subtraction and division the right way round.
    constant(value: double) -> MATRIX => _each(_ => value)

    +(other: MATRIX) -> MATRIX => _both(other, * + *)
    -(other: MATRIX) -> MATRIX => _both(other, * - *)
    *(other: MATRIX) -> MATRIX => _both(other, * * *)
    /(other: MATRIX) -> MATRIX => _both(other, * / *)
    ^(other: MATRIX) -> MATRIX =>
        _both(other, (a, b) => pow(a, b))

    +(k: double) -> MATRIX => _each(* + k)
    -(k: double) -> MATRIX => _each(* - k)
    *(k: double) -> MATRIX => _each(* * k)
    /(k: double) -> MATRIX => _each(* / k)
    ^(k: double) -> MATRIX => _each(pow(*, k))

    to_string() -> string =>
        _cells
            |> map(row => row |> map(c => "{c,11:F3}") |> join(""))
            |> join("\n")
si

+(k: double, m: MATRIX) -> MATRIX => m.constant(k) + m
-(k: double, m: MATRIX) -> MATRIX => m.constant(k) - m
*(k: double, m: MATRIX) -> MATRIX => m.constant(k) * m
/(k: double, m: MATRIX) -> MATRIX => m.constant(k) / m
^(k: double, m: MATRIX) -> MATRIX => m.constant(k) ^ m

show(label: string, m: MATRIX) is
    write_line("{label} =")
    write_line("{m}")
    write_line("")
si

let a = MATRIX([[1.0, 2.0], [3.0, 4.0]])
let b = MATRIX([[5.0, 6.0], [7.0, 8.0]])

show("a", a)
show("b", b)

show("a + b", a + b)
show("a - b", a - b)
show("a * b", a * b)
show("a / b", a / b)
show("a ^ b", a ^ b)

show("a + 10", a + 10.0)
show("a - 10", a - 10.0)
show("a * 10", a * 10.0)
show("a / 10", a / 10.0)
show("a ^ 2", a ^ 2.0)

show("10 - a", 10.0 - a)
show("10 / a", 10.0 / a)
show("2 ^ a", 2.0 ^ a)
