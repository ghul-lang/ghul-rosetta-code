use default

lis(xs: int[]) -> Collections.List[int] is
    let n = xs.count
    let lengths = repeat(1, n + 1) |> collect_mutable()
    let prev = repeat(-1, n + 1) |> collect_mutable()

    for i in 0..n do
        for j in 0..i do
            if xs[j] < xs[i] /\ lengths[j] + 1 > lengths[i] then
                lengths[i] = lengths[j] + 1
                prev[i] = j
            fi
        od
    od

    let best_index = (0..n |> max_by(i => lengths[i]))!

    let result = LIST()
    let cur mut = best_index

    while cur >= 0 do
        result.add(xs[cur])
        cur = prev[cur]
    od

    result |> reverse() |> collect()
si

let sequences = [
    [3, 2, 6, 4, 5, 1],
    [0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15]
]

for xs in sequences do
    let xs_text = xs |> map(x => "{x}") |> join()
    let lis_text = lis(xs) |> map(x => "{x}") |> join()

    write_line("{xs_text}")
    write_line("  -> {lis_text}")
od
