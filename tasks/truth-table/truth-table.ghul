use default

union Expression is
    VARIABLE(name: string)
    NOT(operand: Expression)
    BINARY(symbol: char, left: Expression, right: Expression)
si

use PARSE = (value: Expression, rest: char{})
use SUBPARSER = (char{}) -> PARSE

parse_atom(tokens: char{}) -> PARSE =>
    case tokens
    when ['(', ..rest] then
        let inner = parse_or(rest) in
        (value = inner.value, rest = inner.rest |> skip(1))
    when ['!', ..rest] then
        let operand = parse_atom(rest) in
        (
            value = Expression.NOT(operand.value),
            rest = operand.rest
        )
    when [name, ..rest] then
        (value = Expression.VARIABLE("{name}"), rest = rest)
    when [] then
        throw Ghul.Exception("expected an operand")
    esac

parse_binary(
    tokens: char{},
    symbol: char,
    below: SUBPARSER
) -> PARSE is
    more(left: PARSE) -> PARSE =>
        case left.rest
        when [~symbol, ..rest] then
            let right = below(rest) in
            more(
                (
                    value = Expression.BINARY(
                        symbol,
                        left.value,
                        right.value
                    ),
                    rest = right.rest
                )
            )
        else
            left
        esac

    more(below(tokens))
si

parse_and(tokens: char{}) -> PARSE =>
    parse_binary(tokens, '&', parse_atom)

parse_xor(tokens: char{}) -> PARSE =>
    parse_binary(tokens, '^', parse_and)

parse_or(tokens: char{}) -> PARSE =>
    parse_binary(tokens, '|', parse_xor)

names(expression: Expression) -> string{} is
    case expression
    when leaf: Expression.VARIABLE then
        yield leaf.name
    when negation: Expression.NOT then
        yield in names(negation.operand)
    when pair: Expression.BINARY then
        yield in names(pair.left)
        yield in names(pair.right)
    esac
si

evaluate(
    expression: Expression,
    values: MAP[string, bool]
) -> bool =>
    case expression
    when leaf: Expression.VARIABLE then
        values[leaf.name]
    when negation: Expression.NOT then
        !evaluate(negation.operand, values)
    when pair: Expression.BINARY then
        let
            left = evaluate(pair.left, values),
            right = evaluate(pair.right, values)
        in
            case pair.symbol
            when '&' then left /\ right
            when '|' then left \/ right
            else left != right
            esac
    esac

assignments(count: int) -> bool{}{} =>
    if count == 0 then
        [[]]
    else
        {
            [bit] ++ rest
            for bit in [false, true]
            for rest in assignments(count - 1)
        }
    fi

digit(value: bool) -> string => if value then "1" else "0" fi

table(source: string) is
    let expression =
        parse_or(source |> filter(c => c != ' ')).value
    let variables =
        expression |> names() |> distinct() |> collect()

    write_line(source)
    write_line("  {variables |> join(" ")} | result")

    assignments(variables.count)
        |> map(bits => (
            let values = variables |> zip(bits) |> MAP()
            let result = digit(evaluate(expression, values))
            "  {bits |> map(digit) |> join(" ")} | {result}"
        ))
        |> each(line => write_line(line))

    write_line()
si

[
    "A & B", "A ^ B ^ C", "A & (B | C)", "!A | B",
    "(A | B) & (C | D)"
]
    |> each(table)
