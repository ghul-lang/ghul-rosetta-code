use default

// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|> LIST()` reads the whole sequence into a new `LIST`
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`
// `=~` compares values (structural equality) - `==` compares identity

let small_primes = primes(3) |> take_while(* < 1000) |> list()

has_small_factor(k: int, m: int, powers: int[]) -> bool =>
    (0..small_primes.count)
        |> any(i =>
            (k + powers[i]) % small_primes[i] == 0 /\
            bigint(k) + bigint.pow(2n, m) !~ bigint(small_primes[i])
        )

always_composite(k: int) -> bool is
    let powers = small_primes |> map(_ => 1) |> LIST()

    for m in 1..k do
        for i in 0..small_primes.count do
            powers[i] = powers[i] * 2 % small_primes[i]
        od

        if
            !has_small_factor(k, m, powers) /\
            is_prime(bigint(k) + bigint.pow(2n, m))
        then
            return false
        fi
    od

    return true
si

write_line("testing odd numbers for a composite k - 2^m at every m")

let found =
    from(3, 2)
        |> filter(always_composite)
        |> take(5)
        |> map(k => "{k}")
        |> join(" ")

write_line("the first 5 terms: {found}")
