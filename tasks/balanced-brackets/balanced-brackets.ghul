use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

balanced(brackets: string) -> bool => (
    let level mut = 0

    for bracket in brackets do
        if bracket == ']' /\ level == 0 then return false fi
        level = level + if bracket == '[' then 1 else -1 fi
    od

    level == 0
)

arrangements(opens: int, closes: int) -> string{} is
    if opens == 0 /\ closes == 0 then
        yield ""
    else
        if opens > 0 then
            yield in arrangements(opens - 1, closes)
                |> map(rest => "[{rest}")
        fi
        if closes > 0 then
            yield in arrangements(opens, closes - 1)
                |> map(rest => "]{rest}")
        fi
    fi
si

for pairs in 0::3 do
    for brackets in arrangements(pairs, pairs) do
        let verdict = if balanced(brackets) then "OK" else "NOT OK" fi
        write_line("{brackets,6}  {verdict}")
    od
od
