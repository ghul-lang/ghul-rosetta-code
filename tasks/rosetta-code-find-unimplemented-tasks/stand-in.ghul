use default
use System.Net.HttpListener
use System.Net.IPAddress
use System.Net.IPEndPoint
use System.Net.Sockets.TcpListener
use System.Text.Encoding

// The test's entry: answers from replies the wiki gave on the date
// api-replies.txt names, one reply a request, served on the loopback
// interface. Not part of the published solution.
stand_in() -> string is
    let replies =
        IO.File.read_all_lines("api-replies.txt") |> skip(1)
    let probe = TcpListener(IPAddress.loopback, 0)

    probe.start()

    let port =
        if let bound: IPEndPoint = probe.local_endpoint then
            bound.port
        else throw System.Exception("the probe has no address")
        fi

    probe.stop()

    let prefix = "http://127.0.0.1:{port}/"
    let listener = HttpListener()

    listener.prefixes.add(prefix)
    listener.start()

    Tasks.TASK.run(() is
        for reply in replies do
            let context = listener.get_context()
            let body = Encoding.utf8.get_bytes(reply)

            context.response.output_stream.write(
                body,
                0,
                body.count
            )
            context.response.close()
        od
    si)

    "{prefix}w/api.php"
si

@entry()
test_entry() is
    let language = "Ghul"
    let missing = unimplemented(stand_in(), language)

    write_line(
        "{missing.count} tasks are not implemented in {language}:"
    )

    for title in missing do
        write_line("    {title}")
    od
si
