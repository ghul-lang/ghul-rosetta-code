use default

swaps(deck: int[]) -> int => (
    let cards = deck |> collect_mutable()

    let count mut = 0

    while cards[0] != 1 do
        let top_card = cards[0]
        let last = top_card - 1

        for i in 0::(top_card - 1) / 2 do
            (cards[i], cards[last - i]) = (
                cards[last - i],
                cards[i]
            )
        od

        count = count + 1
    od

    count
)

topswops(n: int) -> int => (
    let deck = 1::n |> collect_mutable()

    let best mut = 0

    let search = position rec is
        if position == n then
            let rounds = swaps(deck.to_array())

            if rounds > best then
                best = rounds
            fi
        else
            for i in position::(n - 1) do
                (deck[position], deck[i]) = (
                    deck[i],
                    deck[position]
                )

                rec(position + 1)

                (deck[position], deck[i]) = (
                    deck[i],
                    deck[position]
                )
            od
        fi
    si

    search(0)

    best
)

for n in 1::10 do
    write_line("{n}: {topswops(n)}")
od
