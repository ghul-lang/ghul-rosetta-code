use default

let knight_pairs =
    [(lower, higher) for lower in 0..5 for higher in lower + 1..5]

position(number: int) -> string is
    let squares = repeat('.', 8) |> collect_mutable()

    place(piece, among_empty) is
        let square = 0..8
            |> filter(s => squares[s] == '.')
            |> skip(among_empty)
            |> first()!

        squares[square] = piece
    si

    squares[2 * (number % 4) + 1] = 'B'
    squares[2 * (number / 4 % 4)] = 'B'

    let rest = number / 16

    place('Q', rest % 6)

    let (lower, higher) = knight_pairs[rest / 6]

    place('N', higher)
    place('N', lower)

    for piece in "RKR" do
        place(piece, 0)
    od

    string(squares |> collect())
si

is_legal(rank: string) -> bool =>
    let bishops = 0..8 |> filter(s => rank[s] == 'B') |> collect() in
    let rooks = 0..8 |> filter(s => rank[s] == 'R') |> collect() in
    let king = rank.index_of('K') in
    (bishops[0] + bishops[1]) % 2 == 1 /\ rooks[0] < king /\ king < rooks[1]

let symbols = "KQRBN" |> zip("♔♕♖♗♘") |> collect_map()

let random = System.Random(960)

for _ in 1::5 do
    let rank = position(random.next(960))

    write_line(rank |> map(p => symbols[p]) |> join(""))
od

let positions = 0..960 |> map(position) |> collect()

write_line()
write_line("distinct positions: {positions |> distinct() |> count()}")
write_line("all legal: {positions |> all(is_legal)}")
