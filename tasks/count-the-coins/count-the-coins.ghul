use default

ways_to_make(amount: int, coins: int[]) -> long is
    let ways = repeat(0L, amount + 1) |> collect_mutable()
    ways[0] = 1L

    for coin in coins do
        for total in coin::amount do
            ways[total] = ways[total] + ways[total - coin]
        od
    od

    ways[amount]
si

let common = [25, 10, 5, 1]
let all = [100, 50, 25, 10, 5, 1]

write_line("Change for $1, common coins: {ways_to_make(100, common)}")
write_line("Change for $1000, all coins: {ways_to_make(100_000, all)}")
