use default

write_line("testing primorial offsets for primality")
write_line("")

primorials() -> bigint{} is
    let product mut = 1n

    for prime in primes() do
        product = product * cast(prime)

        yield product
    od
si

fortunate(primorial: bigint) -> int =>
    from(1)
        |> map(k => 2 * k + 1)
        |> find(m => is_prime(primorial + cast(m)))!

let count = 75
let seen = LIST()

for (i, primorial) in primorials() |> take(count) |> index() do
    seen.add(fortunate(primorial))

    if (i + 1) % 10 == 0 then
        write_line("  found {i + 1} of {count}")
    fi
od

let unique = seen |> SET() |> sort() |> list()

write_line("first 50 fortunate numbers:")

unique
    |> take(50)
    |> chunk(10)
    |> each(row => write_line(row |> map(n => "{n,3}") |> join(" ")))
