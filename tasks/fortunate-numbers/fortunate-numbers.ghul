use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `LIST[T]` is a mutable list that grows as elements are added
// `SET[T]` is a mutable set, holding each element once
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|> SET()` reads the whole sequence into a new `SET`
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

write_line("testing primorial offsets for primality")
write_line("")

primorials() -> bigint{} is
    let product mut = 1n

    for prime in primes() do
        product = product * cast(prime)

        yield product
    od
si

fortunate(primorial: bigint) -> int =>
    from(1)
        |> map(k => 2 * k + 1)
        |> find(m => is_prime(primorial + cast(m)))!

let count = 75
let seen = LIST[int]()

for (i, primorial) in primorials() |> take(count) |> index() do
    seen.add(fortunate(primorial))

    if (i + 1) % 10 == 0 then
        write_line("  found {i + 1} of {count}")
    fi
od

let unique = seen |> SET() |> sort() |> list()

write_line("first 50 fortunate numbers:")

for row in 0..5 do
    let cells = 0..10 |> map(column => "{unique[row * 10 + column],3}")

    write_line(cells |> join(" "))
od
