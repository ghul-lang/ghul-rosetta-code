use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

sorted_letters(word: string) -> string => string(word |> sort())

let sets =
    IO.File.read_all_lines("unixdict.txt") |> group_by(sorted_letters)

let largest =
    sets.values |> reduce(0, (n, words) => System.Math.max(n, words.count))

sets.values
    |> filter(words => words.count == largest)
    |> each(words => write_line(words |> join(" ")))
