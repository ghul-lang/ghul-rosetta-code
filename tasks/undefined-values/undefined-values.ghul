use default

lookup(table: MAP[string, int], key: string) -> int? =>
    if table.contains_key(key) then table[key] else null fi

let ages = MAP[string, int]()

ages["Ada"] = 36

let known = lookup(ages, "Ada")
let unknown = lookup(ages, "Grace")

write_line("Ada: {known?.to_string() ?? "not known"}")
write_line("Grace: {unknown?.to_string() ?? "not known"}")

if let age = lookup(ages, "Ada") then
    write_line("Ada is {age}, and here the value is an int")
fi

write_line("Grace, with a default: {unknown ?? 0}")

let names: LIST[string]? = null

write_line("names is absent: {!names?}")
let count = names?.count

write_line("its count, or nothing: {count?.to_string() ?? "nothing"}")

let uninitialised: int mut

write_line("a deferred local starts at its default: {uninitialised}")

let first_even = [1, 3, 5] |> find(n => n % 2 == 0)

write_line("no even number: {first_even?.to_string() ?? "none"}")
