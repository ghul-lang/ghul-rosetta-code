use default
use IO.Std.read_line

// `MAP[K, V]` is a mutable map from keys to values

let variables = MAP()

write_line("Enter a variable name:")

let name = read_line()!

write_line("Enter its integer value:")

let value = int.parse(read_line()!)

variables[name] = value

write_line("{name} = {variables[name]}")
