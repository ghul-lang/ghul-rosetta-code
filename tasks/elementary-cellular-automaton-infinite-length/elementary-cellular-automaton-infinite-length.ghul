use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `T{}` is a lazy sequence of `T`, read by iterating it.
// `yield` makes the function a generator: it returns a lazy `T{}`.

flip(cell: char) -> char => if cell == '#' then '.' else '#' fi

step(cells: string, rule: int) -> string => (
    let left = flip(cells[0])
    let right = flip(cells[cells.length - 1])
    let padded = "{left}{left}{cells}{right}{right}"
    let next = LIST()

    for i in 1..padded.length - 1 do
        let pattern =
            (0..3)
                |> map(offset => padded[i - 1 + offset])
                |> map(cell => if cell == '#' then 1 else 0 fi)
                |> reduce(0, (bits, bit) => bits * 2 + bit)

        next.add(if (rule >> pattern) & 1 == 1 then '#' else '.' fi)
    od

    string(next.to_array())
)

generations(start: string, rule: int) -> string{} is
    let cells mut = start

    while true do
        yield cells
        cells = step(cells, rule)
    od
si

for rule in [90, 30] do
    write_line("rule {rule}:")

    for (age, cells) in generations("#", rule) |> take(25) |> index() do
        let margin = string(' ', 25 - age)

        write_line("{margin}{cells}")
    od
od
