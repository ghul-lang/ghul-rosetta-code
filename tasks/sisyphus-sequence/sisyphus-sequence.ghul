use default

sisyphus() -> (term: int, prime: int){} is
    let rising = primes().iterator
    let term mut = 1
    let highest mut = 0

    do
        yield (term = term, prime = highest)

        if term % 2 == 0 then
            term = term / 2
        else
            highest = (rising |> next())!
            term = term + highest
        fi
    od
si

let sequence = sisyphus()
let milestones = [1_000, 10_000, 100_000, 1_000_000]

let first_hundred = LIST()
let reports = LIST()

let position mut = 0

for step in sequence do
    position = position + 1

    if position <= 100 then
        first_hundred.add("{step.term,4}")
    fi

    if milestones |> any(m => m == position) then
        reports.add(
            "term {position,9} is {step.term,7}, "
            "reached with primes up to {step.prime}")
    fi

    if position == milestones[milestones.count - 1] then
        break
    fi
od

for row in 0..10 do
    write_line(first_hundred[row * 10..row * 10 + 10] |> join(""))
od

write_line("")

for report in reports do
    write_line(report)
od
