use default

let wanted = 1_000_000
let limit = 35_000_000

let composite = repeat(false, limit + 1) |> collect_mutable()

let factor mut = 2

while factor * factor <= limit do
    if !composite[factor] then
        let multiple mut = factor * factor

        while multiple <= limit do
            composite[multiple] = true

            multiple = multiple + factor
        od
    fi

    factor = factor + 1
od

let counted = repeat(0, limit + 1) |> collect_mutable()

let seen mut = 0

for n in 2::limit do
    if !composite[n] then
        seen = seen + 1
    fi

    counted[n] = seen
od

// R(n) is one past the largest x where the primes in (x/2, x] number fewer
// than n, so walking x upward leaves each entry holding the last such x.
let ramanujan = repeat(0, wanted + 2) |> collect_mutable()

for x in 1::limit do
    let between = counted[x] - counted[x / 2]

    if between < wanted then
        ramanujan[between + 1] = x + 1
    fi
od

let is_ramanujan = repeat(false, limit + 3) |> collect_mutable()

for n in 1::wanted do
    is_ramanujan[ramanujan[n]] = true
od

for n in [100_000, wanted] do
    let twins = 1::n |> count(i => is_ramanujan[ramanujan[i] + 2])

    write_line("the {n:N0}th Ramanujan prime is {ramanujan[n]:N0}")
    write_line("{twins:N0} of the first {n:N0} Ramanujan primes are twins")
    write_line("")
od
