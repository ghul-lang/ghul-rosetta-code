use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read, and `count` reads it all
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `=~` compares values (structural equality) - `==` compares identity

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.
// `=~` compares values (structural equality); `==` compares identity.

let text = "the quick 🦊 brown fox"

let points = text |> runes() |> map(point => "{point}") |> list()

slice(from: int, length: int) -> string =>
    points[from..from + length] |> join("")

starts_at(wanted: string) -> int =>
    let target = wanted |> runes() |> map(point => "{point}") |> list() in
    0..points.count - target.count + 1
        |> find(at => slice(at, target.count) =~ wanted) ?? -1

write_line(slice(4, 5))
write_line(slice(4, points.count - 4))
write_line(slice(0, points.count - 1))
write_line(slice(starts_at("b"), 5))
write_line(slice(starts_at("fox"), 3))
