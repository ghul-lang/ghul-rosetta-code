use default

// A tuple is the return type, so the elements can be named and the call
// site can take them apart.
divide(dividend: int, divisor: int) -> (
    quotient: int,
    remainder: int
) => (
    quotient = dividend / divisor,
    remainder = dividend % divisor
)

let (quotient, remainder) = divide(17, 5)

write_line("17 / 5 is {quotient} remainder {remainder}")

let result = divide(23, 4)

write_line(
    "23 / 4 is {result.quotient} remainder {result.remainder}"
)
