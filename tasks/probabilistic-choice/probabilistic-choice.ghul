use default

let items = [
    ("aleph", 1.0 / 5.0),
    ("beth", 1.0 / 6.0),
    ("gimel", 1.0 / 7.0),
    ("daleth", 1.0 / 8.0),
    ("he", 1.0 / 9.0),
    ("waw", 1.0 / 10.0),
    ("zayin", 1.0 / 11.0),
    ("heth", 1759.0 / 27720.0)
]

let random = System.Random(42)
let trials = 1_000_000
let counts = repeat(0, items.count) |> collect_mutable()

pick(roll: double) -> int is
    let remaining mut = roll

    for (slot, (_, probability)) in items |> index() do
        if remaining < probability then
            return slot
        fi

        remaining = remaining - probability
    od

    return items.count - 1
si

for _ in 0..trials do
    let chosen = pick(random.next_double())
    counts[chosen] = counts[chosen] + 1
od

write_line("item      target  generated")

for (slot, (name, probability)) in items |> index() do
    let generated = double(counts[slot]) / double(trials)
    write_line("{name,-8} {probability,8:F6} {generated,10:F6}")
od
