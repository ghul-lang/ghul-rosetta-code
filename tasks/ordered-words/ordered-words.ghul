use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

is_ordered(word: string) -> bool =>
    word |> windows(2) |> all(pair => pair[0] <= pair[1])

let ordered = IO.File.read_all_lines("unixdict.txt") |> filter(is_ordered)

let longest = ordered |> map(word => word.length) |> max()!

write_line(ordered |> filter(word => word.length == longest) |> join(" "))
