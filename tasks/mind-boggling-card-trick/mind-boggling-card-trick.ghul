use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `LIST()` builds its collection eagerly
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`
// `==` compares identity

let random = System.Random(52)

shuffled[T](items: T{}) -> T{} => items |> sort_by(_ => random.next())

trial() -> (black_in_black: int, red_in_red: int) is
    let deck = shuffled(repeat('R', 26) ++ repeat('B', 26))
    let pairs = deck |> chunk(2)
    let black =
        pairs |> filter(p => p[0] == 'B') |> map(p => p[1]) |> LIST()
    let red = pairs |> filter(p => p[0] != 'B') |> map(p => p[1]) |> LIST()

    let swap = random.next(int.min(black.count, red.count) + 1)
    let black_bunch = black |> shuffled() |> take(swap) |> list()
    let red_bunch = red |> shuffled() |> take(swap) |> list()

    for card in black_bunch do black.remove(card) od
    for card in red_bunch do red.remove(card) od

    black.add_range(red_bunch)
    red.add_range(black_bunch)

    (black |> count(* == 'B'), red |> count(* == 'R'))
si

for number in 1::10 do
    let (black_in_black, red_in_red) = trial()
    let holds =
        if black_in_black == red_in_red then
            "holds"
        else
            "FAILS"
        fi

    write_line(
        "trial {number,2}: {black_in_black,2} black in the black pile, "
        "{red_in_red,2} red in the red pile: {holds}"
    )
od
