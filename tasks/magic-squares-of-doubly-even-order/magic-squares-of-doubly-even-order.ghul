use default

// `T[]` is the read-only list trait - elements can be read by index
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

magic(n: int) -> int[][] =>
    (0..n)
        |> map(row =>
            (0..n)
                |> map(column =>
                    let
                        i = row * n + column,
                        r = row % 4,
                        c = column % 4
                    in
                        let keep = r == c \/ r + c == 3 in
                        if keep then n * n - i else i + 1 fi
                )
                |> list()
        )
        |> list()

column(square: int[][], c: int) -> int{} => square |> map(row => row[c])

check(square: int[][]) -> bool =>
    let
        n = square.count,
        target = n * (n * n + 1) / 2
    in
        let lines =
            square
                |> cat(0..n |> map(column(square, *)))
                |> cat([
                    0..n |> map(i => square[i][i]),
                    0..n |> map(i => square[i][n - 1 - i])
                ])
        in
        lines |> all(line => line |> sum() == target)

let square = magic(8)

for row in square do
    write_line(row |> map(v => "{v,3}") |> join(" "))
od

write_line("")
write_line("every row, column and diagonal sums to 260: {check(square)}")
