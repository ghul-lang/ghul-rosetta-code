use default

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`
// `==` compares identity

is_pseudoprime(a: int, x: int) -> bool =>
    let power = mod_pow(long(a), long(x - 1), long(x)) in
    x > 1 /\ !is_prime(x) /\ power == 1L

pseudoprimes_up_to(a: int, limit: int) -> int[] =>
    2::limit |> filter(is_pseudoprime(a, *)) |> list()

for a in 1::20 do
    let found = pseudoprimes_up_to(a, 12000)
    let first_twenty = found |> take(20) |> map(x => "{x}") |> join()

    write_line("base {a}: count = {found.count}, first 20: {first_twenty}")
od
