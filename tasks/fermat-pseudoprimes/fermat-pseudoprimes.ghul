use default

is_prime(n: int) -> bool =>
    n == 2 \/ (n > 2 /\ n % 2 == 1 /\
        3::int(Ghul.Math.sqrt(double(n))) |> all(d => n % d != 0))

mod_pow(base: long, exponent: long, modulus: long) -> long is
    walk(b: long, e: long, r: long) -> long =>
        if e == 0L then r
        else
            let square = (b * b) % modulus in
            let bit = if e % 2L == 1L then (r * b) % modulus else r fi in
            walk(square, e / 2L, bit)
        fi

    walk(base % modulus, exponent, 1L)
si

is_pseudoprime(a: int, x: int) -> bool =>
    let power = mod_pow(long(a), long(x - 1), long(x)) in
    x > 1 /\ !is_prime(x) /\ power == 1L

pseudoprimes_up_to(a: int, limit: int) -> LIST[int] =>
    2::limit |> filter(is_pseudoprime(a, *)) |> collect_mutable()

for a in 1::20 do
    let found = pseudoprimes_up_to(a, 12000)
    let first_twenty = found |> take(20) |> map(x => "{x}") |> join()

    write_line("base {a}: count = {found.count}, first 20: {first_twenty}")
od
