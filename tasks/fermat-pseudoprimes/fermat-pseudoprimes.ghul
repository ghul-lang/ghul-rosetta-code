use default

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `*` as an argument leaves that parameter open: partial application.

is_pseudoprime(a: int, x: int) -> bool =>
    let power = mod_pow(long(a), long(x - 1), long(x)) in
    x > 1 /\ !is_prime(x) /\ power == 1L

pseudoprimes_up_to(a: int, limit: int) -> int[] =>
    2::limit |> filter(is_pseudoprime(a, *)) |> list()

for a in 1::20 do
    let found = pseudoprimes_up_to(a, 12000)
    let first_twenty = found |> take(20) |> map(x => "{x}") |> join()

    write_line("base {a}: count = {found.count}, first 20: {first_twenty}")
od
