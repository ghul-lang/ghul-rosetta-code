use default
use Raster.ANIMATION
use Raster.IMAGE

use Color = (red: double, green: double, blue: double)

let width = 240
let height = 180
let frames = 60
let thickness = 24

let bars = [
    (color = (red = 1.0, green = 0.25, blue = 0.2), phase = 0.0),
    (color = (red = 1.0, green = 0.8, blue = 0.2), phase = 0.35),
    (color = (red = 0.3, green = 1.0, blue = 0.35), phase = 0.7),
    (color = (red = 0.25, green = 0.6, blue = 1.0), phase = 1.05),
    (color = (red = 0.8, green = 0.35, blue = 1.0), phase = 1.4)
]

channel(value) => ubyte(round(255.0 * clamp(value, 0.0, 1.0)))

draw_bar(image, color, top) is
    for row in 0..thickness do
        let across = (double(row) + 0.5) / double(thickness)
        let shine = sin(across * pi)
        let glint = pow(shine, 12.0) * 0.5
        let y = top + double(row)

        image.color(
            channel(color.red * shine + glint),
            channel(color.green * shine + glint),
            channel(color.blue * shine + glint)
        )

        image.fill_rectangle(0.0, y, double(width), y + 1.0)
    od
si

draw(image, time) is
    image.clear(0ub, 0ub, 10ub)

    let travel = double(height - thickness) / 2.0

    for bar in bars do
        let top = round(travel + travel * sin(time - bar.phase))

        draw_bar(image, bar.color, top)
    od
si

let image = IMAGE(width, height)
let animation = ANIMATION(width, height)

for frame in 0..frames do
    let time = 2.0 * pi * double(frame) / double(frames)

    draw(image, time)
    animation.add(image, 40)
od

write_line("{bars.count} bars, one period of their sway in {frames} frames")

animation.write("bars.png")

animation.show("bars.png")
