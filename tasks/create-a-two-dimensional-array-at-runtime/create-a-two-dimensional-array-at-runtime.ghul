use default

grid(rows: int, columns: int) -> List[LIST[int]] is
    1::rows
        |> map(_ => repeat(0, columns) |> collect_mutable())
        |> collect()
si

let dimensions = [3, 4]

let values = grid(dimensions[0], dimensions[1])

values[1][2] = 7

for row in values do
    write_line(row |> join(" "))
od
