use default

is_square(n: long) -> bool =>
    let root = long(System.Math.sqrt(double(n))) in
    root * root == n \/ (root + 1L) * (root + 1L) == n

qualifies(square: long) -> bool =>
    let digits = "{square}" in

    // A leading 1 would become a leading zero, so the smaller number would
    // have fewer digits than the square it came from.
    let leading = digits[0] != '1' \/ square == 1L in
    let units = long.parse("".pad_left(digits.length, '1')) in

    leading /\ !digits.contains('0') /\ is_square(square - units)

write_line(
    from(1L)
    |> map(n => n * n)
    |> filter(qualifies)
    |> take(7)
    |> join(" "))
