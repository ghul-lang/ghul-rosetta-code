use default
use IO.Std.write

let stream mut = ""
let position mut = 0

read() -> char is
    let character = stream[position]

    position = position + 1

    character
si

is_letter(character: char) -> bool =>
    character >= 'a' /\ character <= 'z'

forwards() -> char is
    let character mut = read()

    while is_letter(character) do
        write("{character}")
        character = read()
    od

    character
si

backwards() -> char => (
    let character = read() in
    if is_letter(character) then
        let delimiter = backwards()

        write("{character}")

        delimiter
    else
        character
    fi
)

solve(text: string) is
    stream = text
    position = 0

    let reversing mut = false
    let done mut = false

    while !done do
        let delimiter = if reversing then backwards() else forwards() fi

        write("{delimiter}")

        done = delimiter == '.'
        reversing = !reversing
    od

    write_line("")
si

solve("what,is,the;meaning,of:life.")
solve("we,are;not,in,kansas;any,more.")
