use default
use IO.Std.write

is_letter(character: char) -> bool =>
    character >= 'a' /\ character <= 'z'

forwards(input: IO.TextReader) -> char =>
    let character = char(input.read()) in
    if is_letter(character) then
        write("{character}")
        forwards(input)
    else
        character
    fi

backwards(input: IO.TextReader) -> char =>
    let character = char(input.read()) in
    if is_letter(character) then
        let delimiter = backwards(input)
        write("{character}")
        delimiter
    else
        character
    fi

words(input: IO.TextReader, reversing: bool) is
    let delimiter =
        if reversing then backwards(input) else forwards(input) fi

    write("{delimiter}")

    if delimiter != '.' then
        words(input, !reversing)
    fi
si

let texts = [
    "what,is,the;meaning,of:life.",
    "we,are;not,in,kansas;any,more."
]

for text in texts do
    words(IO.StringReader(text), false)
    write_line("")
od
