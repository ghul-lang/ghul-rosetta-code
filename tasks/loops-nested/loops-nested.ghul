use IO.Std.write
use default

grid(size: int, random: System.Random) -> int[][] =>
    [[random.next(1, 21) for _ in 1::size] for _ in 1::size]

show_until_twenty(rows: int[][]) is
    search: for row in rows do
        for value in row do
            write("{value,3}")

            if value == 20 then
                write_line()
                break search
            fi
        od

        write_line()
    od
si

show_until_twenty(grid(10, System.Random(20)))
