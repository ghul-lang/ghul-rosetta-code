use default

kronecker(left: int[][], right: int[][]) -> int[][] =>
    (0..left.count * right.count)
        |> map(row =>
            (0..left[0].count * right[0].count)
                |> map(column =>
                    left[row / right.count][column / right[0].count] *
                    right[row % right.count][column % right[0].count]
                )
                |> collect()
        )
        |> collect()

pad(text: string, width: int) -> string =>
    if text.length >= width then
        text
    else
        pad(" {text}", width)
    fi

show(matrix: int[][]) =>
    let width =
        ["{value}".length for row in matrix for value in row]
            |> max() ?? 1
    in
    matrix
        |> each(row =>
            write_line(
                row
                    |> map(value => pad("{value}", width))
                    |> join(" ")
            )
        )

for
    pair in [
        (left = [[1, 2], [3, 4]], right = [[0, 5], [6, 7]]),
        (
            left = [[0, 1, 0], [1, 1, 1], [0, 1, 0]],
            right = [[1, 1, 1, 1], [1, 0, 0, 1], [1, 1, 1, 1]]
        )
    ]
do
    show(kronecker(pair.left, pair.right))

    write_line("")
od
