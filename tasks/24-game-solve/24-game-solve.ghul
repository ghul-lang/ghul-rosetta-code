use default
use IO.Std.read_line

struct Q(top: long, bottom: long) is
    +(o: Q) -> Q =>
        reduced(
            top * o.bottom + o.top * bottom,
            bottom * o.bottom
        )
    -(o: Q) -> Q =>
        reduced(
            top * o.bottom - o.top * bottom,
            bottom * o.bottom
        )
    *(o: Q) -> Q => reduced(top * o.top, bottom * o.bottom)
    /(o: Q) -> Q => reduced(top * o.bottom, bottom * o.top)

    is_zero: bool => top == 0L
si

reduced(top: long, bottom: long) -> Q =>
    let
        g = gcd(top, bottom),
        sign = if bottom < 0L then -1L else 1L fi
    in
        Q(sign * top / g, sign * bottom / g)

use Term = (value: Q, text: string)

let target = Q(24L, 1L)

solve(terms: List[Term]) -> string? is
    if let [only] = terms then
        return
            if only.value =~ target then only.text else null fi
    fi

    for i in 0..terms.count do
        for j in 0..terms.count do
            if i != j then
                let a = terms[i]
                let b = terms[j]
                let rest =
                    (0..terms.count)
                        |> filter(k => k != i /\ k != j)
                        |> map(k => terms[k])

                let joined = LIST()

                if i < j then
                    joined.add(
                        (
                            a.value + b.value,
                            "({a.text} + {b.text})"
                        )
                    )
                    joined.add(
                        (
                            a.value * b.value,
                            "({a.text} * {b.text})"
                        )
                    )
                fi

                joined.add(
                    (a.value - b.value, "({a.text} - {b.text})")
                )

                if !b.value.is_zero then
                    joined.add(
                        (
                            a.value / b.value,
                            "({a.text} / {b.text})"
                        )
                    )
                fi

                for term in joined do
                    let next = rest ++ [term] |> collect()

                    if let found = solve(next) then
                        return found
                    fi
                od
            fi
        od
    od

    return null
si

write_line("Enter four digits per line to solve:")

while let line = read_line() do
    let digits = line.trim()

    let terms =
        (0..digits.length)
            |> map(i =>
                let d = long(digits[i]) - 48L in
                (value = Q(d, 1L), text = "{d}")
            )
            |> collect()

    if let found = solve(terms) then
        let text = found.substring(1, found.length - 2)

        write_line("{digits}: {text}")
    else
        write_line("{digits}: no solution")
    fi
od
