use default

make_list(separator: string) -> string => (
    let counter mut = 0

    let make_item = item => (
        counter = counter + 1
        "{counter}{separator}{item}"
    )

    let items = ["first", "second", "third"] |> map(make_item)

    items |> join("\n")
)

write_line(make_list(". "))
