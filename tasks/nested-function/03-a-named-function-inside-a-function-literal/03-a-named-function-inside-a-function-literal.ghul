use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

let make_list = separator is
    let counter mut = 0

    make_item(item) is
        counter = counter + 1
        "{counter}{separator}{item}"
    si

    return ["first", "second", "third"] |> map(make_item) |> join("\n")
si

write_line(make_list(". "))
