use default

make_list(separator: string) -> string is
    let counter mut = 0

    make_item(item) is
        counter = counter + 1
        "{counter}{separator}{item}"
    si

    let items = ["first", "second", "third"]
        |> map(item => make_item(item))

    return items |> join("\n")
si

write_line(make_list(". "))
