use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

make_list(separator: string) -> string is
    let counter mut = 0

    make_item(item) is
        counter = counter + 1
        "{counter}{separator}{item}"
    si

    let items = ["first", "second", "third"] |> map(make_item)

    return items |> join("\n")
si

write_line(make_list(". "))
