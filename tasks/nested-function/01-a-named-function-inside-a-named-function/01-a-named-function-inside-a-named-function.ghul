use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

make_list(separator: string) -> string is
    let counter mut = 0

    make_item(item) is
        counter = counter + 1
        "{counter}{separator}{item}"
    si

    let items = ["first", "second", "third"] |> map(make_item)

    return items |> join("\n")
si

write_line(make_list(". "))
