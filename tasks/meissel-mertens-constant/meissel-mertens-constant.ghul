use default

// the terms fall off as 1/p², so stopping at ten million leaves an error
// of about 3e-9

let gamma = 0.57721566490153286

term(p: int) -> double =>
    let reciprocal = 1.0 / double(p) in
    double.log(1.0 - reciprocal) + reciprocal

for bound in [1000, 10_000, 100_000, 1_000_000, 10_000_000] do
    let terms = primes() |> take_while(* < bound) |> map(term)
    let total = gamma + (terms |> sum())

    write_line("primes below {bound,10:N0}: M = {total:F10}")
od
