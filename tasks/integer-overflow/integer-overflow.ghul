use default

// ghūl's fixed-size integers are .NET's, and their arithmetic is unchecked:
// an overflowing result wraps round silently, and the program carries on
// with the wrong value. The one exception is dividing the most negative
// value by -1, which throws System.OverflowException.

show(expression: string, compute: () -> string) is
    try
        write_line("    {expression,-46} {compute()}")
    catch e: System.OverflowException
        write_line("    {expression,-46} throws {e.message}")
    yrt
si

let int_max = 2147483647, minus_one = -1
let long_max = 9223372036854775807L, long_minus_one = -1L
let uint_max = 4294967295ui, ulong_max = 18446744073709551615ul

write_line("32-bit signed:")
show("-(-2147483647-1)", () => "{-(-int_max - 1)}")
show("2000000000 + 2000000000", () =>
    let n = 2000000000 in "{n + n}"
)
show("-2147483647 - 2147483647", () => "{-int_max - int_max}")
show("46341 * 46341", () => let n = 46341 in "{n * n}")
show("(-2147483647-1) / -1", () =>
    "{(-int_max - 1) / minus_one}"
)

write_line("64-bit signed:")
show("-(-9223372036854775807-1)", () => "{-(-long_max - 1L)}")
show("5000000000000000000+5000000000000000000", () =>
    let n = 5000000000000000000L in "{n + n}"
)
show("-9223372036854775807 - 9223372036854775807", () =>
    "{-long_max - long_max}"
)
show("3037000500 * 3037000500", () =>
    let n = 3037000500L in "{n * n}"
)
show("(-9223372036854775807-1) / -1", () =>
    "{(-long_max - 1L) / long_minus_one}"
)

write_line("32-bit unsigned:")
show("-4294967295", () => "{0ui - uint_max}")
show("3000000000 + 3000000000", () =>
    let n = 3000000000ui in "{n + n}"
)
show("2147483647 - 4294967295", () =>
    "{2147483647ui - uint_max}"
)
show("65537 * 65537", () => let n = 65537ui in "{n * n}")

write_line("64-bit unsigned:")
show("-18446744073709551615", () => "{0ul - ulong_max}")
show("10000000000000000000 + 10000000000000000000", () =>
    let n = 10000000000000000000ul in "{n + n}"
)
show("9223372036854775807 - 18446744073709551615", () =>
    "{9223372036854775807ul - ulong_max}"
)
show("4294967296 * 4294967296", () =>
    let n = 4294967296ul in "{n * n}"
)
