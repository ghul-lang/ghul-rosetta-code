use default
use Ghul.Threads
use Tasks.Future

class EVENT is
    _signalled: bool
    _waiting: int
    _gate: Semaphore

    init() is
        _gate = Semaphore(0)
    si

    wait() -> Future is
        if !_signalled then
            _waiting = _waiting + 1

            await _gate.acquire()
        fi
    si

    signal() is
        _signalled = true

        for _ in 1::_waiting do
            _gate.release()
        od

        _waiting = 0
    si

    reset() is
        _signalled = false
    si
si

let event = EVENT()
let delay = 3

waiter(name: string) -> Future is
    write_line("{name} waits")

    await event.wait()

    write_line("{name} released")
si

signaller() -> Future is
    for _ in 1::delay do
        await pause()
    od

    write_line("signalled")

    event.signal()
si

run(() => Future.when_all([waiter("first"), waiter("second"), signaller()]))

run(() => waiter("third"))

event.reset()

let fourth = waiter("fourth")

write_line("fourth is still waiting")

event.signal()

run(() => fourth)
