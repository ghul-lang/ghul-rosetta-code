use default

let columns = ["X", "Y", "Z"]

cell(tag: string, text: string) -> string =>
    "      <{tag} align=\"right\">{text}</{tag}>"

let heading =
    [""] ++ columns |> map(name => cell("th", name)) |> join("\n")

let body =
    1::3
        |> map(number =>
            let values =
                0..columns.count
                    |> map(column => "{number * 100 + column}")
            in
            "    <tr>\n"
            "{cell("td", "{number}")}\n"
            "{values |> map(value => cell("td", value)) |> join("\n")}\n"
            "    </tr>")
        |> join("\n")

write_line(
    "<table>\n"
    "  <thead>\n    <tr>\n{heading}\n    </tr>\n  </thead>\n"
    "  <tbody>\n{body}\n  </tbody>\n"
    "</table>")
