use default
use System.Math.*

romberg(
    f: double -> double, lower: double, upper: double,
    steps: int, accuracy: double
) -> double is
    let rows = LIST[List[double]]()
    let width = upper - lower
    let ends = f(lower) + f(upper)

    rows.add([ends * width / 2.0])

    let intervals mut = 1

    for i in 1::steps do
        intervals = intervals * 2

        let h = width / double(intervals)
        let inner = 1..intervals
            |> sum_by(j => f(lower + double(j) * h))

        let row = LIST[double]([(ends / 2.0 + inner) * h])
        let factor mut = 1.0

        for k in 1::i do
            factor = factor * 4.0
            let above = rows[i - 1][k - 1]
            row.add((factor * row[k - 1] - above) / (factor - 1.0))
        od

        rows.add(row)

        let latest = row[i]
        let previous = rows[i - 1][i - 1]

        if abs(latest - previous) < accuracy then
            return latest
        fi
    od

    rows[rows.count - 1][rows.count - 1]
si

let sine = romberg(x => sin(x), 0.0, 1.0, 5, 1.0e-9)
let exponential = romberg(x => exp(x), -3.0, 3.0, 5, 1.0e-9)

write_line("sin(x) from 0 to 1: {sine:F8}")
write_line("exp(x) from -3 to 3: {exponential:F7}")
