use Raster

let order = 23
let step = 1.0

word(order: int) -> string => (
    let previous mut = "1"
    let current mut = "0"

    for _ in 2..order do
        let next = "{current}{previous}"

        previous = current
        current = next
    od

    current
)

let letters = word(order)

let image = IMAGE(450, 620)
let pen = TURTLE(image)

image.view(0.0, 0.0, 450.0, 620.0)
image.color(0ub, 0ub, 160ub)
image.stroke(1.0)

pen.move_to(21.0, 600.0)

for at in 0..letters.length do
    pen.forward(step)

    if letters[at] == '0' then
        pen.turn(if at % 2 == 1 then 90.0 else -90.0 fi)
    fi
od

image.write("fibonacci.png")

image.show("fibonacci.png")
