use default

let keywords = SET([
    "abstract", "assert", "await", "break", "case", "cast", "catch",
    "class", "continue", "default", "do", "elif", "else", "enum", "esac",
    "false", "fi", "field", "finally", "for", "if", "impl", "in", "is",
    "isa", "let", "mut", "namespace", "null", "od", "operator", "partial",
    "private", "protected", "public", "pure", "rec", "ref", "return",
    "self", "si", "stable", "static", "struct", "super", "then", "throw",
    "trait", "true", "try", "typeof", "union", "use", "when", "while",
    "yield", "yrt"
])

escaped(text: string) -> string =>
    text.replace("&", "&amp;")
        .replace("'", "&apos;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")

// A string literal runs to its closing quote, skipping an escaped one;
// the interpolated expressions inside it are left as part of the string.
string_end(line: string, start: int) -> int is
    let quote = line[start]
    let i mut = start + 1

    while i < line.length /\ line[i] != quote do
        i = i + if line[i] == '\\' then 2 else 1 fi
    od

    System.Math.min(i + 1, line.length)
si

highlight(line: string) -> string is
    let out = System.Text.StringBuilder(" ")
    let i mut = 0

    while i < line.length do
        let c = line[i]

        if c == '/' /\ i + 1 < line.length /\ line[i + 1] == '/' then
            out.append("''").append(escaped(line.substring(i))).append("''")
            i = line.length
        elif c == '"' \/ c == '\'' then
            let stop = string_end(line, i)

            out.append(escaped(line.substring(i, stop - i)))
            i = stop
        elif char.is_letter(c) \/ c == '_' then
            let start = i

            let word_char = (k: int) =>
                char.is_letter_or_digit(line[k]) \/ line[k] == '_'

            while i < line.length /\ word_char(i) do
                i = i + 1
            od

            let word = line.substring(start, i - start)

            if keywords.contains(word) then
                out.append("'''").append(word).append("'''")
            else
                out.append(word)
            fi
        else
            out.append(escaped("{c}"))
            i = i + 1
        fi
    od

    out.to_string()
si

let source = "syntax-highlighting-using-mediawiki-formatting.ghul"

for line in IO.File.read_all_lines(source) do
    write_line(highlight(line))
od
