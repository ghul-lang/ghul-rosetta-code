 '''use''' '''default'''
 
 '''let''' keywords = SET([
     "abstract", "assert", "await", "break", "case", "cast",
     "catch",
     "class", "continue", "default", "do", "elif", "else",
     "enum", "esac",
     "false", "fi", "field", "finally", "for", "if", "impl",
     "in", "is",
     "isa", "let", "mut", "namespace", "null", "od", "operator",
     "partial",
     "private", "protected", "public", "pure", "rec", "ref",
     "return",
     "self", "si", "stable", "static", "struct", "super", "then",
     "throw",
     "trait", "true", "try", "typeof", "union", "use", "when",
     "while",
     "yield", "yrt"
 ])
 
 escaped(text: string) -&gt; string =&gt;
     text.replace("&amp;", "&amp;amp;").replace("&apos;", "&amp;apos;").replace(
         "&lt;",
         "&amp;lt;"
     ).replace("&gt;", "&amp;gt;")
 
 ''// A string literal runs to its closing quote, skipping an escaped one;''
 ''// the interpolated expressions inside it are left as part of the string.''
 string_end(line: string, start: int) -&gt; int '''is'''
     '''let''' quote = line[start]
     '''let''' i '''mut''' = start + 1
 
     '''while''' i &lt; line.length /\ line[i] != quote '''do'''
         i = i + '''if''' line[i] == &apos;\\&apos; '''then''' 2 '''else''' 1 '''fi'''
     '''od'''
 
     System.Math.min(i + 1, line.length)
 '''si'''
 
 highlight(line: string) -&gt; string '''is'''
     '''let''' out = System.Text.StringBuilder(" ")
     '''let''' i '''mut''' = 0
 
     '''while''' i &lt; line.length '''do'''
         '''let''' c = line[i]
 
         '''if'''
             c == &apos;/&apos; /\
             i + 1 &lt; line.length /\
             line[i + 1] == &apos;/&apos;
         '''then'''
             out.append("&apos;&apos;").append(
                 escaped(line.substring(i))
             ).append("&apos;&apos;")
             i = line.length
         '''elif''' c == &apos;"&apos; \/ c == &apos;\&apos;&apos; '''then'''
             '''let''' stop = string_end(line, i)
 
             out.append(escaped(line.substring(i, stop - i)))
             i = stop
         '''elif''' char.is_letter(c) \/ c == &apos;_&apos; '''then'''
             '''let''' start = i
 
             '''let''' word_char =
                 (k: int) =&gt;
                     char.is_letter_or_digit(line[k]) \/
                     line[k] == &apos;_&apos;
 
             '''while''' i &lt; line.length /\ word_char(i) '''do'''
                 i = i + 1
             '''od'''
 
             '''let''' word = line.substring(start, i - start)
 
             '''if''' keywords.contains(word) '''then'''
                 out.append("&apos;&apos;&apos;").append(word).append("&apos;&apos;&apos;")
             '''else'''
                 out.append(word)
             '''fi'''
         '''else'''
             out.append(escaped("{c}"))
             i = i + 1
         '''fi'''
     '''od'''
 
     out.to_string()
 '''si'''
 
 '''let''' source =
     "syntax-highlighting-using-mediawiki-formatting.ghul"
 
 '''for''' line '''in''' IO.File.read_all_lines(source) '''do'''
     write_line(highlight(line))
 '''od'''
