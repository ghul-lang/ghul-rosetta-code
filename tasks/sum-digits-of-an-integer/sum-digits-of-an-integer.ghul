use default

digit_sum(value: int, base: int) -> int is
    walk(remaining: int, total: int) -> int =>
        if remaining == 0 then total
        else walk(remaining / base, total + remaining % base)
        fi

    walk(value, 0)
si

for
    (value, base) in [
        (1, 10),
        (1234, 10),
        (0xFE, 16),
        (0xF0E, 16)
    ]
do
    write_line(
        "{value} in base {base}: {digit_sum(value, base)}"
    )
od
