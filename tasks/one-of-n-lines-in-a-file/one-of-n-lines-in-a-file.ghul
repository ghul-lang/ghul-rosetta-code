use default
use System.Random

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `LIST()` builds a collection eagerly

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `LIST()`, `SET()`, `MAP()` and `ARRAY()` build the collection eagerly.

let chance = Random(20260921)

one_of_n(n: int) -> int =>
    2::n
        |> reduce(1, (chosen, line) =>
            if chance.next(line) == 0 then line else chosen fi
        )

let lines = 10
let trials = 1000000
let counts = repeat(0, lines + 1) |> LIST()

for trial in 1::trials do
    let chosen = one_of_n(lines)

    counts[chosen] = counts[chosen] + 1
od

write_line("{trials} trials over {lines} lines")

for line in 1::lines do
    write_line("{line,3}{counts[line],9}")
od
