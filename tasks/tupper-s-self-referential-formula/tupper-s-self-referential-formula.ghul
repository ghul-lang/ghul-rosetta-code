use default
use Raster.IMAGE

let k =
    bigint.parse(
        "960939379918958884971672962127852754715004339660"
        "129306651505519271702802395266424689642842174350"
        "718121267153782770623355993237280874144307891325"
        "963941337723487857735749823926629715517173716995"
        "165232890538221612403238855866184013235585136048"
        "828693337902491454229288667081096184496091705183"
        "454067827731551705405381627380967602565625016981"
        "482083418783163849115590225610003652351370343874"
        "461848378737238198224849863465033159410054974700"
        "593138339226497249461751545728366702369745461014"
        "655997933798537483143786841806593422227898388722"
        "980000748404719"
    )

let cell = 6

lit(x: int, y: int) -> bool =>
    ((k + bigint(y)) / 17n >> (17 * x + y % 17)) % 2n =~ 1n

let image = IMAGE(106 * cell, 17 * cell)

mark(x: int, y: int) is
    let left = (105 - x) * cell
    let top = y * cell

    for down in 0..cell do
        for across in 0..cell do
            image.set_pixel(
                left + across, top + down, 0ub, 0ub, 0ub
            )
        od
    od
si

for y in 0..17 do
    for x in 0..106 do
        if lit(x, y) then
            mark(x, y)
        fi
    od
od

image.write("tupper.png")

image.show("tupper.png")
