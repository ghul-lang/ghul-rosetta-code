use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `==` compares identity

permutations(items: int[]) -> int[]{} is
    if items.count == 0 then
        yield LIST()
    else
        yield in 0..items.count
            |> flat_map(index => (
                let rest = LIST(items)
                rest.remove_at(index)
                rest
                    |> permutations()
                    |> map(tail => ([items[index]] ++ tail) |> list())
            ))
    fi
si

permutations(LIST([1, 2, 3]))
    |> each(permutation =>
        write_line(permutation |> map(value => "{value}") |> join(" "))
    )
