use default

permutations(items: LIST[int]) -> LIST[int]{} is
    if items.count == 0 then
        yield LIST()
    else
        for index in 0..items.count do
            let rest = LIST(items)

            rest.remove_at(index)

            for tail in permutations(rest) do
                let whole = LIST()

                whole.add(items[index])
                whole.add_range(tail)

                yield whole
            od
        od
    fi
si

permutations(LIST([1, 2, 3]))
    |> each(permutation => write_line(permutation
        |> map(value => "{value}")
        |> join(" ")))
