use default

permutations(items: List[int]) -> List[int]{} is
    if items.count == 0 then
        yield LIST()
    else
        yield in 0..items.count |> flat_map(index => (
            let rest = LIST(items)
            rest.remove_at(index)
            permutations(rest)
            |> map(tail => ([items[index]] ++ tail) |> collect())
        ))
    fi
si

permutations(LIST([1, 2, 3]))
    |> each(permutation => write_line(permutation
        |> map(value => "{value}")
        |> join(" ")))
