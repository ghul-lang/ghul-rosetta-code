use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `yield` makes the function a generator: it returns a lazy `T{}`.

permutations(items: int[]) -> int[]{} is
    if items.count == 0 then
        yield LIST()
    else
        yield in 0..items.count
            |> flat_map(index => (
                let rest = LIST(items)
                rest.remove_at(index)
                rest
                    |> permutations()
                    |> map(tail => ([items[index]] ++ tail) |> list())
            ))
    fi
si

permutations(LIST([1, 2, 3]))
    |> each(permutation =>
        write_line(permutation |> map(value => "{value}") |> join(" "))
    )
