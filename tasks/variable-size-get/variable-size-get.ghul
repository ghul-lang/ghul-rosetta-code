use default
use Ghul.Interop.size_of

struct POINT(x: double, y: double)

show_size[T: struct](name: string) is
    write_line("{name,-32} {size_of[T](),2}")
si

write_line("{"type",-32} {"bytes"}")

show_size[byte]("byte")
show_size[int]("int")
show_size[long]("long")
show_size[double]("double")
show_size[decimal]("decimal")
show_size[POINT]("POINT")
show_size[word]("word, the width of a pointer")

let text = "hello"
let numbers = [1, 2, 3, 4]

write_line("the string holds {text.length} chars")
write_line("the array holds {numbers.count} ints")
