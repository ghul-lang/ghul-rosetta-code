use default

// `LIST[T]` is a mutable list that grows as elements are added
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|> LIST()` reads the whole sequence into a new `LIST`
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

let items = [6, 81, 243, 14, 25, 49, 123, 69, 11] |> LIST()

write_line("{items |> join()}")

while items.count > 1 do
    let smallest = items |> sort() |> take(2) |> list()

    smallest |> each(item => items.remove(item))
    items.add(smallest |> sum())

    write_line("{items |> join()}")
od

write_line("last item: {items[0]}")
