use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read, and `count` reads it all
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `MAP()` builds a collection eagerly

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.
// `LIST()`, `SET()`, `MAP()` and `ARRAY()` build the collection eagerly.

let fifth = 0..250 |> map(n => repeat(long(n), 5) |> product()) |> list()
let root = 1..250 |> map(n => (fifth[n], n)) |> MAP()

search() -> (int, int, int, int, int)? is
    for x0 in 1..250 do
        for x1 in x0 + 1..250 do
            for x2 in x1 + 1..250 do
                for x3 in x2 + 1..250 do
                    let total =
                        fifth[x0] + fifth[x1] + fifth[x2] + fifth[x3]

                    if total > fifth[249] then
                        break
                    fi

                    if root.contains_key(total) then
                        return (x0, x1, x2, x3, root[total])
                    fi
                od
            od
        od
    od

    null
si

if let (x0, x1, x2, x3, y) = search() then
    write_line("{x0}^5 + {x1}^5 + {x2}^5 + {x3}^5 = {y}^5")
fi
