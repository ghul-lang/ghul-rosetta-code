use default
use Raster.IMAGE
use System.Math.*

let random = System.Random(1809)

normal() -> double{} is
    while true do
        let r = sqrt(-2.0D * log(1.0D - random.next_double()))
        let angle = 2.0D * pi * random.next_double()

        yield r * cos(angle)
        yield r * sin(angle)
    od
si

let size = 100000
let samples = normal() |> take(size) |> collect()

let mean =
    samples |> sum() / double(size)

let deviation =
    sqrt(
        samples
        |> sum_by(x => (x - mean) * (x - mean)) / double(size))

write_line("{size:N0} samples by the Box-Muller transform")
write_line("mean {mean:F6}, standard deviation {deviation:F6}")
write_line()

let low = -4.0D
let width = 0.5D
let bins = 16

let counts = repeat(0, bins) |> collect_mutable()

for x in samples do
    let bin = int(floor((x - low) / width))

    if bin >= 0 /\ bin < bins then
        counts[bin] = counts[bin] + 1
    fi
od

let tallest = counts |> reduce(0, (a, b) => max(a, b))

for bin in 0..bins do
    let from = low + width * double(bin)

    let bar = "".pad_right(counts[bin] * 50 / tallest, '#')

    write_line("{from,5:F1} {counts[bin],6} {bar}".trim_end())
od

let image = IMAGE(480, 260)

image.view(low, -0.03D, -low, 0.45D)
image.clear(252ub, 252ub, 250ub)

image.colour(60ub, 110ub, 190ub)

for bin in 0..bins do
    let x = low + width * double(bin)
    let density = double(counts[bin]) / double(size) / width

    image.fill_rectangle(x + 0.02D, 0.0D, x + width - 0.02D, density)
od

let curve =
    (0::160)
        |> map(i =>
            let x = low + double(i) * 0.05D in
            let y = exp(-x * x / 2.0D) / sqrt(2.0D * pi) in
            (x = x, y = y))
        |> collect()

image.colour(220ub, 60ub, 40ub)
image.stroke(2.5D)
image.line(curve)

image.colour(80ub, 80ub, 80ub)
image.stroke(1.0D)
image.line(low, 0.0D, -low, 0.0D)

image.write("normal.png")

image.show("normal.png")
