use default
use Raster.IMAGE
use System.Math.*

use Step = (x: int, y: int)

let signs = [(1, 1), (-1, 1), (1, -1), (-1, -1)]

steps_of_length(squared: int) -> List[Step] =>
    from(0)
        |> take_while(a => 2 * a * a <= squared)
        |> map(a => (
            a,
            int(round(sqrt(double(squared - a * a))))
        ))
        |> filter(((a, b)) => a * a + b * b == squared)
        |> flat_map(((a, b)) => [
            (x = sx * x, y = sy * y)
            for (x, y) in [(a, b), (b, a)]
            for (sx, sy) in signs
        ])
        |> collect()

bend(from: Step, to: Step) -> double =>
    let turn =
        atan2(double(from.y), double(from.x)) -
        atan2(double(to.y), double(to.x))
    in
    turn - 2.0D * pi * floor(turn / (2.0D * pi))

spiral(count: int) -> Step{} is
    let points = LIST([(x = 0, y = 0), (x = 0, y = 1)])
    let last mut = (x = 0, y = 1)
    let squared mut = 1

    while points.count < count do
        let candidates mut = LIST[Step]()

        while candidates.count == 0 do
            squared = squared + 1
            candidates = steps_of_length(squared)
        od

        let from = last

        last =
            candidates
                |> reduce(
                    candidates[0],
                    (best, next) =>
                        if
                            bend(from, next) < bend(from, best)
                        then
                            next
                        else best
                        fi
                )

        let here = points[points.count - 1]

        points.add((x = here.x + last.x, y = here.y + last.y))
    od

    points
si

let first = spiral(40)

write_line("the first 40 points:")

for row in 0..4 do
    write_line(
        first
            |> skip(row * 10)
            |> take(10)
            |> map(p => "({p.x}, {p.y})")
            |> join(" ")
    )
od

let many = spiral(10000)

let xs = many |> map(p => double(p.x)) |> memo()
let ys = many |> map(p => double(p.y)) |> memo()

let low_x = xs |> reduce(0.0D, min)
let high_x = xs |> reduce(0.0D, max)
let low_y = ys |> reduce(0.0D, min)
let high_y = ys |> reduce(0.0D, max)

let middle_x = (low_x + high_x) / 2.0D
let middle_y = (low_y + high_y) / 2.0D
let half = max(high_x - low_x, high_y - low_y) * 0.52D

let image = IMAGE(400, 400)

image.view(
    middle_x - half,
    middle_y - half,
    middle_x + half,
    middle_y + half
)
image.clear(252ub, 250ub, 245ub)
image.colour(30ub, 60ub, 140ub)
image.stroke(1.0D)
image.line(
    many
        |> map(p => (x = double(p.x), y = double(p.y)))
        |> collect()
)

image.write("spiral.png")

image.show("spiral.png")
