use default
use Raster.COLOUR_MAP
use Raster.IMAGE
use System.Math.*

struct VEC(x: double, y: double, z: double) is
    -(other: VEC) -> VEC => VEC(x - other.x, y - other.y, z - other.z)

    ×(o: VEC) -> VEC =>
        VEC(y * o.z - z * o.y, z * o.x - x * o.z, x * o.y - y * o.x)

    length: double => sqrt(x * x + y * y + z * z)
si

use Patch = (corners: List[VEC], phase: double)

let turns = 2
let around = 64 * turns
let along = 22
let reach = 2.2D
let yaw = 0.62D
let pitch = 0.5D

turned(p: VEC) -> VEC is
    let x = p.x * cos(yaw) - p.y * sin(yaw)
    let y = p.x * sin(yaw) + p.y * cos(yaw)

    VEC(
        x,
        p.z * cos(pitch) - y * sin(pitch),
        p.z * sin(pitch) + y * cos(pitch))
si

angle(i: int) -> double =>
    2.0D * pi * double(turns) *
    double(i) / double(around)

radius(j: int) -> double => reach * double(j) / double(along)

corner(i: int, j: int) -> VEC is
    let t = angle(i)
    let r = radius(j)

    VEC(
        r * cos(t),
        r * sin(t),
        sqrt(r) * cos(t / 2.0D))
si

patch(i: int, j: int) -> Patch =>
    (
        corners = [
            turned(corner(i, j)),
            turned(corner(i + 1, j)),
            turned(corner(i + 1, j + 1)),
            turned(corner(i, j + 1))],
        phase = angle(i) / (2.0D * pi * double(turns)))

depth(p: Patch) -> double => p.corners |> sum_by(c => c.z)

brightness(p: Patch) -> double is
    let c = p.corners
    let n = (c[1] - c[0]) × (c[3] - c[0])

    if n.length == 0.0D then 0.6D
    else 0.55D + 0.45D * abs(n.z) / n.length
    fi
si

let patches =
    [patch(i, j) for i in 0..around for j in 0..along]
        |> sort((p, q) => depth(p) <> depth(q))
        |> collect()

let image = IMAGE(620, 560)

image.view(-2.6D, -2.4D, 2.6D, 2.3D)
image.clear(252ub, 252ub, 250ub)
image.stroke(0.4D)

for p in patches do
    let light = brightness(p)
    let tint = COLOUR_MAP.hue(p.phase)
    let outline =
        p.corners |> map(c => (x = c.x, y = c.y)) |> collect()

    image.colour(
        ubyte(double(tint.red) * light),
        ubyte(double(tint.green) * light),
        ubyte(double(tint.blue) * light))

    image.fill(outline)
    image.line(outline |> cat([outline[0]]) |> collect())
od

write_line("the surface of w = sqrt(z), over two turns of the z plane")
write_line("height is the real part of w, and colour is its argument")
write_line("{patches.count} quadrilaterals, drawn farthest first")

image.write("riemann.png")

image.show("riemann.png")
