use default
use Raster.COLOR_MAP
use Raster.IMAGE

struct VEC(x: double, y: double, z: double) is
    -(other: VEC) -> VEC => VEC(x - other.x, y - other.y, z - other.z)

    ×(o: VEC) -> VEC =>
        VEC(y * o.z - z * o.y, z * o.x - x * o.z, x * o.y - y * o.x)

    length: double => sqrt(x * x + y * y + z * z)
si

use Patch = (corners: VEC[], phase: double)

let turns = 2
let around = 64 * turns
let along = 22
let reach = 2.2
let yaw = 0.62
let pitch = 0.5

turned(p) =>
    let
        x = p.x * cos(yaw) - p.y * sin(yaw),
        y = p.x * sin(yaw) + p.y * cos(yaw)
    in
        VEC(
            x,
            p.z * cos(pitch) - y * sin(pitch),
            p.z * sin(pitch) + y * cos(pitch)
        )

angle(i) =>
    2.0 * pi * double(turns) * double(i) / double(around)

radius(j) => reach * double(j) / double(along)

corner(i, j) =>
    let
        t = angle(i),
        r = radius(j)
    in
        VEC(r * cos(t), r * sin(t), sqrt(r) * cos(t / 2.0))

patch(i, j) => (
    corners = [
        turned(corner(i, j)),
        turned(corner(i + 1, j)),
        turned(corner(i + 1, j + 1)),
        turned(corner(i, j + 1))
    ],
    phase = angle(i) / (2.0 * pi * double(turns))
)

depth(p) => p.corners |> sum_by(c => c.z)

brightness(p) =>
    let
        c = p.corners,
        n = (c[1] - c[0]) × (c[3] - c[0])
    in
        if n.length == 0.0 then 0.6
        else 0.55 + 0.45 * abs(n.z) / n.length
        fi

let patches = [patch(i, j) for i in 0..around for j in 0..along]
    |> sort((p, q) => depth(p) <> depth(q))
    |> list()

let image = IMAGE(620, 560)

image.view(-2.6, -2.4, 2.6, 2.3)
image.clear(252ub, 252ub, 250ub)
image.stroke(0.4)

for p in patches do
    let light = brightness(p)
    let tint = COLOR_MAP.hue(p.phase)
    let outline = p.corners |> map(c => (x = c.x, y = c.y)) |> list()

    image.color(
        ubyte(double(tint.red) * light),
        ubyte(double(tint.green) * light),
        ubyte(double(tint.blue) * light)
    )

    image.fill(outline)
    image.line(outline ++ [outline[0]] |> list())
od

write_line("the surface of w = sqrt(z), over two turns of the z plane")
write_line("height is the real part of w, and color is its argument")
write_line("{patches.count} quadrilaterals, drawn farthest first")

image.write("riemann.png")

image.show("riemann.png")
