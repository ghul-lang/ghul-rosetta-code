use default

factorize(text: string) -> string{} is
    let start mut = 0

    while start < text.length do
        let compare mut = start + 1
        let anchor mut = start

        while compare < text.length /\ text[anchor] <= text[compare] do
            if text[anchor] < text[compare] then
                anchor = start
            else
                anchor = anchor + 1
            fi
            compare = compare + 1
        od

        let width = compare - anchor

        while start <= anchor do
            yield text[start .. start + width]
            start = start + width
        od
    od
si

let thue_morse mut = "0"

for _ in 1::7 do
    let flipped = thue_morse
        |> map(c => if c == '0' then '1' else '0' fi)
        |> join("")
    thue_morse = "{thue_morse}{flipped}"
od

let examples = ["0", "0001", "0010", "1000110", "001100", thue_morse]

for text in examples do
    write_line("{text} = {text |> factorize() |> join(" ")}")
od
