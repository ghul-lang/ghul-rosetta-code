use default

chernick_factors(n: int, m: long) -> bigint{} is
    yield cast(6L * m + 1L)
    yield cast(12L * m + 1L)

    for k in 1::n - 2 do
        yield cast((1L << k) * 9L * m + 1L)
    od
si

smallest_chernick(n: int) -> (m: long, factors: List[bigint]) is
    let step = if n > 4 then 1L << (n - 4) else 1L fi
    let m mut = step

    do
        let factors = chernick_factors(n, m) |> collect()

        if factors |> all(is_prime) then
            return (m, factors)
        fi

        m = m + step
    od
si

for n in 3::9 do
    let (m, factors) = smallest_chernick(n)
    let carmichael = factors |> product()

    write_line("a({n}) = U({n}, {m}) = {carmichael}")
    write_line("     = {factors |> map(f => "{f}") |> join(" * ")}")
od
