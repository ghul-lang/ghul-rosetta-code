use default
use Raster.IMAGE

scene() is
    let image = IMAGE(160, 120)

    for y in 0..80 do
        let t = double(y) / 80.0

        image.color(
            ubyte(40.0 + 200.0 * t),
            ubyte(70.0 + 100.0 * t),
            ubyte(160.0 - 60.0 * t)
        )
        image.fill_rectangle(0.0, double(y), 160.0, double(y + 1))
    od

    image.color(255ub, 220ub, 60ub)
    image.disc(112.0, 42.0, 15.0)

    image.color(90ub, 60ub, 120ub)
    image.fill([
        (0.0, 80.0),
        (45.0, 30.0),
        (95.0, 80.0)
    ])

    image.color(60ub, 110ub, 70ub)
    image.fill([
        (55.0, 80.0),
        (105.0, 48.0),
        (160.0, 80.0)
    ])

    image.color(70ub, 150ub, 60ub)
    image.fill_rectangle(0.0, 80.0, 160.0, 120.0)

    image.color(200ub, 35ub, 40ub)
    image.fill_rectangle(22.0, 88.0, 52.0, 110.0)

    image.color(120ub, 25ub, 30ub)
    image.fill([
        (18.0, 88.0),
        (37.0, 75.0),
        (56.0, 88.0)
    ])

    image.color(250ub, 245ub, 235ub)
    image.fill_rectangle(33.0, 97.0, 41.0, 110.0)

    image
si

lerp(a, b, t) => a + (b - a) * t

bilinear(source: IMAGE, x: double, y: double) -> (double, double, double) is
    let x0 = min(int(floor(x)), source.width - 1)
    let y0 = min(int(floor(y)), source.height - 1)
    let x1 = min(x0 + 1, source.width - 1)
    let y1 = min(y0 + 1, source.height - 1)
    let tx = x - double(x0), ty = y - double(y0)

    let a = source.pixel(x0, y0), b = source.pixel(x1, y0)
    let c = source.pixel(x0, y1), d = source.pixel(x1, y1)

    mix(pick) => lerp(
        lerp(double(pick(a)), double(pick(b)), tx),
        lerp(double(pick(c)), double(pick(d)), tx),
        ty
    )

    (mix(p => p.red), mix(p => p.green), mix(p => p.blue))
si

enlarge(source, factor) is
    let width = int(round(double(source.width) * factor))
    let height = int(round(double(source.height) * factor))
    let result = IMAGE(width, height)
    let across = double(source.width - 1) / double(width - 1)
    let down = double(source.height - 1) / double(height - 1)

    for y in 0..height do
        for x in 0..width do
            let sx = double(x) * across
            let sy = double(y) * down
            let (r, g, b) = bilinear(source, sx, sy)

            result.set_pixel(
                x,
                y,
                ubyte(round(r)),
                ubyte(round(g)),
                ubyte(round(b))
            )
        od
    od

    result
si

scene().write("scene.png")

let source = IMAGE.read("scene.png")
let larger = enlarge(source, 1.6)

write_line("{source.width} x {source.height} enlarged by 60%")
write_line("to {larger.width} x {larger.height}")

source.show("scene.png")

larger.write("larger.png")

larger.show("larger.png")
