use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

strip(text: string, unwanted: string) -> string =>
    string(text |> filter(c => !unwanted.contains(c)))

write_line(strip("She was a soul stripper. She took my heart!", "aei"))
