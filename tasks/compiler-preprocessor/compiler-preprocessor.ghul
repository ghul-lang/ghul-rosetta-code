use default
use System.Text.RegularExpressions.Regex
use System.Text.RegularExpressions.Match

class MACRO(parameters: List[string], body: string)

let name = "[A-Za-z_][A-Za-z_0-9]*"

let definition =
    Regex("^#define\\s+({name})\\s*(\\(([^)]*)\\))?\\s*(.*)$")

let inclusion = Regex("^#include\\s+\"([^\"]*)\"\\s*$")
let usage = Regex("#({name})\\s*(\\(([^)#]*)\\))?\\s*#")
let identifier = Regex(name)

split(list: string) -> List[string] =>
    list.split([','])
        |> map(s => s.trim())
        |> filter(s => s.length > 0)
        |> collect()

class PREPROCESSOR(debug: bool) is
    defines: MAP[string, MACRO]
    output: LIST[string]

    init(..) is
        defines = MAP()
        output = LIST()
    si

    note(text: string) is
        if debug then
            output.add("/* {text} */")
        fi
    si

    expand(text: string, used: LIST[string]) -> string =>
        identifier.replace(text, (m) is
            if !defines.contains_key(m.value) then
                return m.value
            fi

            used.add(m.value)

            return expand(defines[m.value].body, used)
        si)

    call(m: Match) -> string is
        let used = LIST()
        let called = m.groups[1].value

        if !defines.contains_key(called) then
            return m.value
        fi

        let macro = defines[called]
        let arguments = split(m.groups[3].value)

        if arguments.count != macro.parameters.count then
            return m.value
        fi

        let body = identifier.replace(macro.body, p =>
            let index =
                (0..macro.parameters.count)
                    |> find(i => macro.parameters[i] =~ p.value) in
            if let i = index then arguments[i] else p.value fi)

        used.add(called)

        let result = expand(body, used)

        let listed =
            if used.count < 3 then used |> join(" and ")
            else
                "{used |> take(used.count - 1) |> join(", ")}, "
                "and {used[used.count - 1]}"
            fi

        note("Use {listed}")

        return result
    si

    run(file: string, depth: int) is
        if depth > 5 then
            output.add("/* {file} nests includes too deeply */")
            return
        fi

        for line in IO.File.read_all_lines(file) do
            let included = inclusion.match(line)
            let defined = definition.match(line)

            if included.success then
                let header = included.groups[1].value

                note("Include {header}")
                run(header, depth + 1)
                note("End {header}")
            elif defined.success then
                let macro = defined.groups[1].value
                let parameters = split(defined.groups[3].value)
                let body = defined.groups[4].value.trim()

                if defines.contains_key(macro) then
                    output.add("/* {macro} is already defined */")
                else
                    defines[macro] = MACRO(parameters, body)

                    let shown =
                        if defined.groups[2].success
                        then "{macro}({parameters |> join(", ")})"
                        else macro
                        fi

                    note("Define {shown} as {body}")
                fi
            else
                let replaced =
                    usage.replace(line, call)

                output.add(replaced)
            fi
        od
    si
si

for debug in [false, true] do
    let preprocessor = PREPROCESSOR(debug)

    preprocessor.run("Source.t", 0)
    preprocessor.output |> each(line => write_line(line))
    write_line()
od
