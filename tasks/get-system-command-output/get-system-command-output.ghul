use default
use System.Diagnostics.Process
use System.Diagnostics.ProcessStartInfo

run(command: string, arguments: List[string]) -> LIST[string] is
    let how = ProcessStartInfo(command)

    how.redirect_standard_output = true

    for argument in arguments do
        how.argument_list.add(argument)
    od

    let child = Process.start(how)!
    let lines = LIST()

    while let line = child.standard_output.read_line() do
        lines.add(line)
    od

    child.wait_for_exit()

    return lines
si

let lines = run("printf", ["%s\n", "one", "two", "three"])

write_line("{lines.count} lines:")

lines |> each(line => write_line("  {line}"))
