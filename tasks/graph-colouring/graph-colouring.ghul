use default
use Raster.Anchor
use Raster.IMAGE

use Edge = (from: int, to: int)

class GRAPH(nodes: int[], edges: Edge[]) is
    _neighbours: Map[int, SET[int]]

    init(..) is
        let outgoing =
            edges
                |> flat_map((from, to) => [
                    (from, to),
                    (to, from)
                ])
                |> group_by((from, to) => from)

        _neighbours =
            nodes
                |> collect_map(
                    node => node,
                    node =>
                        if outgoing.contains_key(node) then
                            outgoing[node] |> map((from, to) => to) |> SET()
                        else
                            SET[int]()
                        fi
                )
    si

    neighbours(node: int) -> Set[int] => _neighbours[node]

    degree(node: int) -> int => _neighbours[node].count
si

parse(description: string) -> GRAPH is
    let tokens = [
        [int.parse(end) for end in token.split(['-'])]
        for token in description.split([' '])
    ]

    let nodes = tokens |> flat_map(ends => ends) |> SET()

    let edges =
        tokens
            |> filter(ends => ends.count == 2)
            |> map(ends => (ends[0], ends[1]))
            |> list()

    GRAPH(nodes |> sort() |> list(), edges)
si

color(graph: GRAPH) -> Map[int, int] is
    let colors = MAP()

    let neighbour_colors =
        node =>
            graph.neighbours(node)
                |> filter(colors.contains_key)
                |> map(other => colors[other])
                |> SET[int]()

    for _ in graph.nodes do
        // the uncolored node seeing the most distinct colors,
        // ties to the higher degree, then to the earlier node
        let (node, taken) =
            graph.nodes
                |> filter(node => !colors.contains_key(node))
                |> map(node => (node, neighbour_colors(node)))
                |> max_by((node, taken) => (
                    taken.count,
                    graph.degree(node)
                ))!

        colors[node] = from(0) |> find(c => !taken.contains(c))!
    od

    colors
si

report(name: string, description: string) is
    let graph = parse(description)
    let colors = color(graph)

    write_line("{name}:")

    for (from, to) in graph.edges do
        write_line("  {from}-{to} colored {colors[from]}-{colors[to]}")
    od

    for node in graph.nodes do
        if graph.degree(node) == 0 then
            write_line("  {node} isolated, colored {colors[node]}")
        fi
    od

    let used = colors.values |> SET()

    write_line(
        "  {graph.nodes.count} nodes, {graph.edges.count} edges, "
        "{used.count} colors"
    )
si

let examples = [
    ("Ex1", "0-1 1-2 2-0 3"),
    ("Ex2", "1-6 1-7 1-8 2-5 2-7 2-8 3-5 3-6 3-8 4-5 4-6 4-7"),
    ("Ex3", "1-4 1-6 1-8 3-2 3-6 3-8 5-2 5-4 5-8 7-2 7-4 7-6"),
    ("Ex4", "1-6 7-1 8-1 5-2 2-7 2-8 3-5 6-3 3-8 4-5 4-6 4-7")
]

for (name, description) in examples do
    report(name, description)
od

write_line("")
write_line("the colorings are drawn below")

let palette = [
    (220ub, 70ub, 60ub), (60ub, 150ub, 80ub),
    (60ub, 110ub, 200ub), (240ub, 190ub, 50ub)
]
let size = 240
let image = IMAGE(size * 2, size * 2)

image.clear(255ub, 255ub, 255ub)

for (i, (name, description)) in examples |> index() do
    let graph = parse(description)
    let colors = color(graph)
    let cx = double(i % 2 * size + size / 2)
    let cy = double(i / 2 * size + size / 2 + 8)

    let slot =
        graph.nodes |> index() |> map(((i, node)) => (node, i)) |> MAP()

    // nodes sit evenly round a circle
    let position = node => (
        let angle =
            6.283185307 * double(slot[node]) / double(graph.nodes.count)
        (cx + 80.0 * Ghul.Math.cos(angle), cy + 80.0 * Ghul.Math.sin(angle))
    )

    image.color(120ub, 120ub, 120ub)
    image.stroke(2.0)

    for (from, to) in graph.edges do
        let (x0, y0) = position(from)
        let (x1, y1) = position(to)

        image.line(x0, y0, x1, y1)
    od

    for node in graph.nodes do
        let (x, y) = position(node)
        let (r, g, b) = palette[colors[node]]

        image.color(r, g, b)
        image.disc(x, y, 14.0)
        image.color(30ub, 30ub, 30ub)
        image.text(x, y + 1.0, 11.0, "{node}", Anchor.CENTER)
    od

    image.color(30ub, 30ub, 30ub)
    image.text(cx, cy - 112.0, 12.0, name, Anchor.CENTER)
od

image.write("graphs.png")

image.show("graphs.png")
