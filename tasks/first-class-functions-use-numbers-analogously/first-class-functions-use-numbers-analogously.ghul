use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

multiplier(a: double, b: double) -> (double) -> double => m => a * b * m

let x = 2.0D
let xi = 0.5D
let y = 4.0D
let yi = 0.25D
let z = x + y
let zi = 1.0D / (x + y)

let numbers = [x, y, z]

let inverses = [xi, yi, zi]

for (number, inverse) in numbers |> zip(inverses) do
    let unity = multiplier(number, inverse)

    write_line("{number} * {inverse} * 1 = {unity(1.0D):F6}")
od
