use default

ackermann(m: int, n: int) -> int memo =>
    if m == 0 then
        n + 1
    elif n == 0 then
        ackermann(m - 1, 1)
    else
        ackermann(m - 1, ackermann(m, n - 1))
    fi

for m in 0::3 do
    let row = 0::5 |> map(n => "{ackermann(m, n)}") |> join(" ")

    write_line("A({m}, n) = {row}")
od
