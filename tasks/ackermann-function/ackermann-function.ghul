use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity
// `memo` on a function caches its results - a call with arguments equal to
//  an earlier call's returns the cached result, recursive calls included

ackermann(m: int, n: int) -> int memo =>
    if m == 0 then
        n + 1
    elif n == 0 then
        ackermann(m - 1, 1)
    else
        ackermann(m - 1, ackermann(m, n - 1))
    fi

for m in 0::3 do
    let row = 0::5 |> map(n => "{ackermann(m, n)}") |> join(" ")

    write_line("A({m}, n) = {row}")
od
