use Raster.IMAGE
use Ghul.Math

let image = IMAGE(400, 300)

image.color(0ub, 0ub, 0ub)

fraction(value) => value - floor(value)

rest(value) => 1.0 - fraction(value)

mark(x, y, steep, weight) is
    if steep then
        image.blend(y, x, weight)
    else
        image.blend(x, y, weight)
    fi
si

endpoint(x, y, gradient, gap, steep) is
    let ends_at = round(x)
    let height = y + gradient * (ends_at - x)

    let column = int(ends_at)
    let base = int(floor(height))

    mark(column, base, steep, rest(height) * gap)
    mark(column, base + 1, steep, fraction(height) * gap)

    return (column = column, height = height)
si

line(from_x, from_y, to_x, to_y) is
    let steep = abs(to_y - from_y) > abs(to_x - from_x)

    let ax mut = if steep then from_y else from_x fi
    let ay mut = if steep then from_x else from_y fi
    let bx mut = if steep then to_y else to_x fi
    let by mut = if steep then to_x else to_y fi

    if ax > bx then
        let held_x = ax
        let held_y = ay

        ax = bx
        ay = by
        bx = held_x
        by = held_y
    fi

    let gradient = if bx == ax then 1.0 else (by - ay) / (bx - ax) fi

    let first = endpoint(ax, ay, gradient, rest(ax + 0.5), steep)
    let last = endpoint(bx, by, gradient, fraction(bx + 0.5), steep)

    let height mut = first.height + gradient

    for column in first.column + 1..last.column do
        let base = int(floor(height))

        mark(column, base, steep, rest(height))
        mark(column, base + 1, steep, fraction(height))

        height = height + gradient
    od
si

for spoke in 0..13 do
    let angle = pi * (double(spoke) / 12.0 - 0.5)

    line(10.0, 150.0, 10.0 + 380.0 * cos(angle), 150.0 - 140.0 * sin(angle))
od

image.write("wu.png")

image.show("wu.png")
