use default
use Raster.IMAGE

let random = System.Random(10)

candidates() is
    while true do
        yield (x = random.next(-15, 16), y = random.next(-15, 16))
    od
si

in_ring(p) =>
    let square = p.x * p.x + p.y * p.y in
    square >= 100 /\ square <= 225

let points = candidates() |> filter(in_ring) |> take(100) |> list()
let distinct = points |> SET()

write_line("{points.count} points, {distinct.count} of them different")
write_line("")

for y in -15::15 do
    let line =
        (-15::15)
            |> map(x => distinct.contains((x = x, y = -y)))
            |> map(hit => if hit then "o" else " " fi)
            |> join(" ")

    write_line(line.trim_end())
od

let image = IMAGE(248, 248)

image.view(-15.5, -15.5, 15.5, 15.5)
image.clear(252ub, 250ub, 245ub)

image.color(210ub, 210ub, 215ub)
image.stroke(1.0)
image.circle(0.0, 0.0, 10.0)
image.circle(0.0, 0.0, 15.0)

image.color(40ub, 80ub, 170ub)

for p in distinct do
    image.dot(double(p.x), double(p.y), 3.0)
od

image.write("ring.png")

image.show("ring.png")
