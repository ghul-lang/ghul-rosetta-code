use default

delete(
    path: string,
    exists: string -> bool,
    remove: string -> void
) -> string is
    if !exists(path) then
        return "not there"
    fi

    try
        remove(path)
        return "deleted"
    catch e: System.Exception
        return "refused"
    yrt
si

for where in ["", "/"] do
    let file = "{where}input.txt"
    let directory = "{where}docs"

    write_line("{file}: {delete(file, IO.File.exists, IO.File.delete)}")
    write_line(
        "{directory}: "
        "{delete(directory, IO.Directory.exists, IO.Directory.delete)}"
    )
od
