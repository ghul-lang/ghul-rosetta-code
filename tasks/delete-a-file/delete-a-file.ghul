use default

delete_file(path) is
    if !IO.File.exists(path) then
        return "not there"
    fi

    try
        IO.File.delete(path)
        return "deleted"
    catch e: System.Exception
        return "refused"
    yrt
si

delete_directory(path) is
    if !IO.Directory.exists(path) then
        return "not there"
    fi

    try
        IO.Directory.delete(path)
        return "deleted"
    catch e: System.Exception
        return "refused"
    yrt
si

for where in ["", "/"] do
    write_line("{where}input.txt: {delete_file("{where}input.txt")}")
    write_line("{where}docs: {delete_directory("{where}docs")}")
od
