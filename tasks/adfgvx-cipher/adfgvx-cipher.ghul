use default

let labels = "ADFGVX"

let random = System.Random(20260908)

shuffled(items: string) -> string => (
    let held = items |> collect_mutable()
    for i in 0..held.count do
        let j = i + random.next(held.count - i)
        (held[i], held[j]) = (held[j], held[i])
    od
    string(held)
)

all_letters(word: string) -> bool => word |> all(char.is_letter)

no_repeats(word: string) -> bool => (
    let seen = SET()
    word |> all(seen.add)
)

read_order(key: string) -> int{} =>
    (0..key.length) |> sort_by(column => key[column])

column_height(key: string, length: int, column: int) -> int =>
    (length / key.length) +
    if column < length % key.length then 1 else 0 fi

to_pairs(square: string, text: string) -> string =>
    text
        |> flat_map(letter =>
            let at = square.index_of(letter) in
            [labels[at / 6], labels[at % 6]]
        )
        |> join("")

from_pairs(square: string, pairs: List[char]) -> string =>
    0..pairs.count / 2
        |> map(at =>
            let
                row = labels.index_of(pairs[at * 2]),
                column = labels.index_of(pairs[at * 2 + 1])
            in
                square[row * 6 + column]
        )
        |> join("")

encrypt(square: string, key: string, text: string) -> string =>
    let pairs = to_pairs(square, text) in
    key
        |> read_order()
        |> flat_map(column =>
            column..pairs.length
                |> step(key.length)
                |> map(at => pairs[at])
        )
        |> join("")

decrypt(
    square: string,
    key: string,
    cipher: string
) -> string => (
    let pairs = cipher |> collect_mutable()
    let taken mut = 0
    for column in read_order(key) do
        let height = column_height(key, cipher.length, column)
        for row in 0..height do
            pairs[row * key.length + column] = cipher[taken]
            taken = taken + 1
        od
    od
    from_pairs(square, pairs)
)

let square = shuffled("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")

let words =
    IO.File.read_all_lines("unixdict.txt")
        |> filter(word => word.length == 9)
        |> filter(all_letters)
        |> filter(no_repeats)
        |> collect()

let key = words[random.next(words.count)].to_upper()

let plain = "ATTACKAT1200AM"
let cipher = encrypt(square, key, plain)

write_line("the Polybius square:")
write_line()
write_line("   {labels |> join(" ")}")

for row in 0..6 do
    let letters = square[row * 6..row * 6 + 6]

    write_line("{labels[row]}  {letters |> join(" ")}")
od

write_line()
write_line("the key: {key}")
write_line()
write_line("plaintext:  {plain}")
write_line("ciphertext: {cipher}")
write_line("decrypted:  {decrypt(square, key, cipher)}")
