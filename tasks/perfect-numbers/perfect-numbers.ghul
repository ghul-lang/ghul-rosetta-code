use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

is_perfect(n: int) -> bool is
    if n < 2 then
        return false
    fi

    let divisors = (1::n / 2) |> filter(d => n % d == 0) |> sum()

    return divisors == n
si

write_line(1::10000 |> filter(is_perfect) |> join())
