use default

combinations(items: List[int], k: int) -> List[int]{} is
    if k == 0 then
        yield LIST()
    elif items.count >= k then
        let rest = items[1..<0]

        for tail in combinations(rest, k - 1) do
            let whole = LIST()

            whole.add(items[0])

            for value in tail do
                whole.add(value)
            od

            yield whole
        od

        yield in combinations(rest, k)
    fi
si

partitions(items: List[int], sizes: List[int]) -> List[List[int]]{} is
    if sizes.count == 0 then
        yield LIST()
    else
        for block in combinations(items, sizes[0]) do
            let remaining = items |> except(block) |> collect()

            for tail in partitions(remaining, sizes[1..<0]) do
                let whole = LIST()

                whole.add(block)

                for rest in tail do
                    whole.add(rest)
                od

                yield whole
            od
        od
    fi
si

braces(block: List[int]) -> string =>
    "{{" "{block |> join(", ")}" "}}"

show(sizes: int[]) is
    let total = sizes |> sum()
    let items = 1::total |> collect()

    write_line("partitions({sizes |> join(", ")}):")

    partitions(items, sizes)
        |> each(partition =>
            write_line("  ({partition |> map(braces) |> join(", ")})"))
si

show([2, 0, 2])
