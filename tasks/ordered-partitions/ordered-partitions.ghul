use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `yield` makes the function a generator: it returns a lazy `T{}`.

combinations(items: int[], k: int) -> int[]{} is
    if k == 0 then
        yield LIST()
    elif items.count >= k then
        let rest = items[1..<0]

        for tail in combinations(rest, k - 1) do
            let whole = LIST()

            whole.add(items[0])

            for value in tail do
                whole.add(value)
            od

            yield whole
        od

        yield in combinations(rest, k)
    fi
si

partitions(items: int[], sizes: int[]) -> int[][]{} is
    case sizes
    when [] then
        yield LIST()
    when [size, ..rest] then
        for block in combinations(items, size) do
            let remaining = items |> except(block) |> list()

            for tail in partitions(remaining, rest) do
                let whole = LIST()

                whole.add(block)

                for part in tail do
                    whole.add(part)
                od

                yield whole
            od
        od
    esac
si

braces(block: int[]) -> string => "{{" "{block |> join(", ")}" "}}"

show(sizes: int[]) is
    let total = sizes |> sum()
    let items = 1::total |> list()

    write_line("partitions({sizes |> join(", ")}):")

    partitions(items, sizes)
        |> each(partition =>
            write_line("  ({partition |> map(braces) |> join(", ")})")
        )
si

show([2, 0, 2])
