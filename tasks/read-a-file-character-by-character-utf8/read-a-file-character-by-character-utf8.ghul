use default
use Ghul.Pipes.Pipe
use IO.File

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

characters(path: string) -> string{} is
    let use reader = File.open_text(path)

    while reader.peek() >= 0 do
        let first = char(reader.read())

        if char.is_high_surrogate(first) /\ reader.peek() >= 0 then
            let second = char(reader.read())

            yield "{first}{second}"
        else
            yield "{first}"
        fi
    od
si

let shown =
    characters("sample.txt")
        |> map(character =>
            if character =~ "\n" then "\\n" else character fi
        )
        |> list()

write_line("{shown.count} characters")
write_line(shown |> join(" "))
