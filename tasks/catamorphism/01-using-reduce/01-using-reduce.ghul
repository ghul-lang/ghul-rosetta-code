use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `*` as an argument leaves that parameter open: partial application.

let numbers = [1, 2, 3, 4, 5]

let largest = (left, right) => if left > right then left else right fi

let sum = numbers |> reduce(0, * + *)
let product = numbers |> reduce(1, * * *)

write_line("sum:     {sum}")
write_line("product: {product}")
write_line("largest: {numbers |> reduce(numbers[0], largest)}")
