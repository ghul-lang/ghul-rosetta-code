use default

use Record = (name: string, sequence: string)

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `if let` and `case ... when` pattern-match; `[x, ..rest]` matches a list.
// `yield` makes the function a generator: it returns a lazy `T{}`.

records(lines: string{}) -> Record{} is
    let name mut = null
    let sequence = System.Text.StringBuilder()

    for line in lines do
        if line.starts_with(">") then
            if let n = name then
                yield (name = n, sequence = sequence.to_string())
            fi

            name = line[1..<0]
            sequence.clear()
        else
            sequence.append(line)
        fi
    od

    if let n = name then
        yield (name = n, sequence = sequence.to_string())
    fi
si

for record in records(IO.File.read_lines("example.fasta")) do
    write_line("{record.name}: {record.sequence}")
od
