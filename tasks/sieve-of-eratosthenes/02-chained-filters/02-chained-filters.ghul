use IO.Std.write_line
use Concurrency

use Numbers = Channel[int?]

let limit = 100

count_up(out: Numbers) -> Future is
    for n in 2::limit do
        out.send(n)

        await pause()
    od

    out.send(null)
si

drop_multiples(prime: int, into: Numbers, out: Numbers) -> Future is
    do
        let value = await into.receive()

        if let n = value then
            if n % prime != 0 then
                out.send(n)
            fi
        else
            out.send(null)

            break
        fi
    od
si

sieve() -> Future is
    let head mut = Numbers()

    count_up(head)

    do
        let value = await head.receive()

        if let prime = value then
            write_line("{prime}")

            let rest = Numbers()

            drop_multiples(prime, head, rest)

            head = rest
        else
            break
        fi
    od
si

run(sieve)
