use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `LIST[T]` is a mutable list that grows as elements are added
// `|> LIST()` reads the whole sequence into a new `LIST`
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

sieve(limit: int) -> int{} is
    let composite = repeat(false, limit + 1) |> LIST()

    for prime in 2::limit do
        if !composite[prime] then
            for multiple in prime * prime::limit |> step(prime) do
                composite[multiple] = true
            od
        fi
    od

    return 2::limit |> filter(i => !composite[i])
si

write_line("{sieve(100)}")
