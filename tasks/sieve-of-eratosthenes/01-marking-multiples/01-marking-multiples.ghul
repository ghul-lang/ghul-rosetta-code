use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

sieve(limit: int) -> int{} is
    let composite = LIST()

    0::limit |> each(_ => composite.add(false))

    let prime mut = 2

    while prime * prime <= limit do
        if !composite[prime] then
            let multiple mut = prime * prime

            while multiple <= limit do
                composite[multiple] = true
                multiple = multiple + prime
            od
        fi

        prime = prime + 1
    od

    return (2::limit) |> filter(i => !composite[i]) |> list()
si

for prime in sieve(100) do
    write_line("{prime}")
od
