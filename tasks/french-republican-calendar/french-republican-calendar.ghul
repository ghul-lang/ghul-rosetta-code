use default
use System.DateTime

let republican_months = [
    "Vendémiaire", "Brumaire", "Frimaire", "Nivôse", "Pluviôse", "Ventôse",
    "Germinal", "Floréal", "Prairial", "Messidor", "Thermidor", "Fructidor"
]

let sansculottides = [
    "Fête de la vertu", "Fête du génie", "Fête du travail",
    "Fête de l'opinion", "Fête des récompenses", "Fête de la Révolution"
]

let gregorian_months = [
    "January", "February", "March", "April", "May", "June", "July",
    "August", "September", "October", "November", "December"
]

let epoch = DateTime(1792, 9, 22)

is_leap(republican_year: int) -> bool is
    let following = republican_year + 1

    return following % 4 == 0 /\
        (following % 100 != 0 \/ following % 400 == 0)
si

days_in(republican_year: int) -> int =>
    if is_leap(republican_year) then 366 else 365 fi

to_republican(date: DateTime) -> string is
    let day_count mut = int(date.subtract(epoch).total_days)
    let year mut = 1

    while day_count >= days_in(year) do
        day_count = day_count - days_in(year)
        year = year + 1
    od

    return if day_count < 360 then
        "{day_count % 30 + 1} {republican_months[day_count / 30]} {year}"
    else
        "{sansculottides[day_count - 360]} {year}"
    fi
si

to_gregorian(republican: string) -> DateTime is
    let words = republican.split([' '])
    let year_text = words[words.count - 1]
    let year = int.parse(year_text)
    let month = System.Array.index_of(republican_months, words[1])
    let day_of_year =
        if month >= 0 then
            month * 30 + int.parse(words[0]) - 1
        else
            let name = republican[0..<year_text.length + 1]

            360 + System.Array.index_of(sansculottides, name)
        fi

    let days = 1..year |> sum_by(days_in)

    return epoch.add_days(cast(days + day_of_year))
si

describe(date: DateTime) -> string =>
    "{date.day} {gregorian_months[date.month - 1]} {date.year}"

let samples = [
    (1792, 9, 22), (1795, 5, 20), (1799, 7, 15), (1803, 9, 23),
    (1805, 12, 31)
]

for (year, month, day) in samples do
    let date = DateTime(year, month, day)
    let republican = to_republican(date)

    write_line("{describe(date)} = {republican}")
    write_line("{republican} = {describe(to_gregorian(republican))}")
od
