use default

let month_names = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"
]

let month_width = 20
let gap = "  "

// The text with enough spaces before it to center it in the width.
center(text: string, width: int) -> string =>
    text.pad_left((width + text.length) / 2)

// A month as eight lines of month_width characters: its name, the day
// names, and six weeks, the ones it doesn't need left blank.
month_lines(year: int, month: int) -> string[] is
    let first_day = cast int(Time.DateTime(year, month, 1).day_of_week)
    let days = Time.DateTime.days_in_month(year, month)

    let cells =
        repeat("  ", first_day) ++ (1::days |> map(day => "{day,2}"))
    let weeks = cells |> chunk(7) |> map(week => week |> join(" "))
    let lines =
        [
            center(month_names[month - 1], month_width),
            "Su Mo Tu We Th Fr Sa"
        ] ++ weeks ++ repeat("", 6)

    return
        lines
            |> take(8)
            |> map(line => line.pad_right(month_width))
            |> list()
si

// The year's calendar, as many months across as fit in the page width.
calendar(year: int, page_width: int) -> string{} is
    let across = (page_width + gap.length) / (month_width + gap.length)
    let width = across * (month_width + gap.length) - gap.length

    yield center("[ Snoopy ]", width)
    yield center("{year}", width)

    for row in 1::12 |> chunk(across) do
        let months = row |> map(month_lines(year, *)) |> list()

        yield ""

        for line in 0..8 do
            yield
                (
                    months |> map(lines => lines[line]) |> join(gap)
                ).trim_end()
        od
    od
si

for line in calendar(1969, 80) do
    write_line(line)
od
