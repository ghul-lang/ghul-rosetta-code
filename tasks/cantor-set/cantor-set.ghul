use default

power_of_three(exponent: int) -> int =>
    if exponent == 0 then
        1
    else
        3 * power_of_three(exponent - 1)
    fi

removed(position: int) -> bool =>
    position > 0 /\ (position % 3 == 1 \/ removed(position / 3))

let depth = 4
let width = power_of_three(depth)

(0::depth)
    |> map(level =>
        (0..width)
            |> map(position =>
                if
                    removed(
                        position / power_of_three(depth - level)
                    )
                then
                    " "
                else
                    "*"
                fi
            )
            |> join("")
    )
    |> each(line => write_line(line))
