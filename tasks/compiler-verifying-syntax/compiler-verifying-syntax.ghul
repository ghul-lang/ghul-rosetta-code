use default
use IO.Std.read_line

let keywords = ["and", "or", "not", "true", "false"]

@suppress("non-pascal-case-name")
class BAD_SYNTAX(text: string init): System.Exception is
    super(text)
si

in_name(c: char) -> bool => char.is_ascii_letter_or_digit(c) \/ c == '_'

tokens(text: string) -> List[string] is
    let result = LIST()
    let i mut = 0

    while i < text.length do
        let c = text[i]

        if c == ' ' then
            i = i + 1
        elif char.is_ascii_letter(c) \/ c == '_' then
            let start = i

            while i < text.length /\ in_name(text[i]) do
                i = i + 1
            od

            if c == '_' then
                throw BAD_SYNTAX(
                    "identifier cannot begin with an underscore")
            fi

            result.add(text.substring(start, i - start))
        elif char.is_ascii_digit(c) then
            let start = i

            while i < text.length /\ char.is_ascii_digit(text[i]) do
                i = i + 1
            od

            result.add(text.substring(start, i - start))
        elif "+-*/=<()".index_of(c) >= 0 then
            result.add("{c}")
            i = i + 1
        else
            throw BAD_SYNTAX("invalid character '{c}' found")
        fi
    od

    result.add("end of line")
    result
si

class VERIFIER(tokens: List[string]) is
    _at: int

    next: string => tokens[_at]

    is_next(token: string) -> bool => next =~ token

    advance() is
        _at = _at + 1
    si

    shown(token: string) -> string =>
        if token =~ "end of line" then token else "'{token}'" fi

    statement() is
        expression()

        if !is_next("end of line") then
            throw BAD_SYNTAX("expected end of line, found {shown(next)}")
        fi
    si

    expression() is
        conjunction()

        while is_next("or") do
            advance()
            conjunction()
        od
    si

    conjunction() is
        comparison()

        while is_next("and") do
            advance()
            comparison()
        od
    si

    comparison() is
        if is_next("not") then
            advance()
        fi

        sum()

        if is_next("=") \/ is_next("<") then
            advance()
            sum()

            if is_next("=") \/ is_next("<") then
                throw BAD_SYNTAX("operator '{next}' is non-associative")
            fi
        fi
    si

    sum() is
        product()

        while is_next("+") \/ is_next("-") do
            advance()
            product()
        od
    si

    product() is
        primary()

        while is_next("*") \/ is_next("/") do
            advance()
            primary()
        od
    si

    primary() is
        let token = next

        if token =~ "(" then
            advance()
            expression()

            if !is_next(")") then
                throw BAD_SYNTAX("expected ')', found {shown(next)}")
            fi

            advance()
        elif token =~ "true" \/ token =~ "false" then
            advance()
        elif keywords |> any(k => k =~ token) \/
                !(char.is_ascii_letter_or_digit(token[0])) then
            throw BAD_SYNTAX("expected operand, found {shown(token)}")
        else
            advance()
        fi
    si
si

while let line = read_line() do
    write_line("{line}")

    try
        VERIFIER(tokens(line)).statement()
        write_line("    true")
    catch e: BAD_SYNTAX
        write_line("    false: {e.message}")
    yrt
od
