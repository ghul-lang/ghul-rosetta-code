use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `LIST()` builds its collection eagerly
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`

let sieve_limit = 10_000_100
let composite = repeat(false, sieve_limit + 1) |> LIST()

for candidate in 2::sieve_limit do
    if !composite[candidate] /\ candidate <= sieve_limit / candidate then
        let multiple mut = candidate * candidate

        while multiple <= sieve_limit do
            composite[multiple] = true
            multiple = multiple + candidate
        od
    fi
od

neighbourhoods() -> int[]{} =>
    (2::sieve_limit)
        |> filter(candidate => !composite[candidate])
        |> windows(3)

strong() -> int{} =>
    neighbourhoods()
        |> filter(around => around[1] * 2 > around[0] + around[2])
        |> map(around => around[1])

weak() -> int{} =>
    neighbourhoods()
        |> filter(around => around[1] * 2 < around[0] + around[2])
        |> map(around => around[1])

report(name: string, found: () -> int{}, wanted: int) is
    write_line("first {wanted} {name} primes:")
    write_line("  {found() |> take(wanted) |> join(" ")}")

    for bound in [1_000_000, 10_000_000] do
        let total = found() |> take_while(* < bound) |> count()

        write_line("  {name} primes below {bound}: {total}")
    od
si

report("strong", strong, 36)
report("weak", weak, 37)
