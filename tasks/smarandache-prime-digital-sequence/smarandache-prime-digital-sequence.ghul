use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

let prime_digits = [2, 3, 5, 7]

prime_digit_numbers() -> int{} is
    let level mut = prime_digits

    do
        yield in level

        level = [
            value * 10 + digit
            for value in level
            for digit in prime_digits
        ]
    od
si

smarandache() -> int{} => prime_digit_numbers() |> filter(is_prime)

write_line("the first 25 Smarandache prime-digital primes:")

smarandache()
    |> take(25)
    |> chunk(5)
    |> each(row => write_line(row |> map(value => "{value,7}") |> join("")))

write_line()
write_line("the hundredth: {smarandache() |> skip(99) |> first_or_throw()}")
