use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

let top = 99

let descendants = (0::top) |> map(_ => LIST()) |> list()
descendants[0].add(1L)

for p in (2::top) |> filter(is_prime) do
    for sum in p::top do
        for d in descendants[sum - p] do
            descendants[sum].add(d * long(p))
        od
    od
od

for sum in 1::top do
    descendants[sum].remove(long(sum))
    descendants[sum].sort()
od

ancestors(n: int) -> int{} is
    let current mut = n

    while current > 1 /\ !is_prime(current) do
        let parent = current |> prime_factors() |> sum()

        if parent == current then
            return
        fi

        yield parent
        current = parent
    od
si

abbreviated(list: long[]) -> string =>
    if list.count == 0 then
        "none"
    elif list.count <= 6 then
        list |> map(d => "{d}") |> join(" ")
    else
        "{list[0]} {list[1]} {list[2]} ... {list[list.count - 1]}"
    fi

for n in 1::top do
    let chain = n |> ancestors() |> sort() |> list()
    let children = descendants[n]

    write_line(
        "[{n}] level {chain.count}, ancestors: "
        "{if chain.count == 0 then "none" else chain |> join(" ") fi}"
    )
    write_line("    {children.count} descendants: {abbreviated(children)}")
od

write_line("")
write_line(
    "total descendants: "
    "{(1::top) |> sum_by(n => descendants[n].count)}"
)
