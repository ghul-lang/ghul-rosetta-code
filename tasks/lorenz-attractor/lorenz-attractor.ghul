use default
use Raster.COLOR_MAP
use Raster.IMAGE

use Point = (x: double, y: double, z: double)

let sigma = 10.0
let rho = 28.0
let beta = 8.0 / 3.0
let dt = 0.004

rate(at: Point) -> Point => (
    x = sigma * (at.y - at.x),
    y = at.x * (rho - at.z) - at.y,
    z = at.x * at.y - beta * at.z
)

along(at: Point, by: Point, scale: double) -> Point => (
    x = at.x + by.x * scale,
    y = at.y + by.y * scale,
    z = at.z + by.z * scale
)

mean(a: Point, b: Point, c: Point, d: Point) -> Point => (
    x = (a.x + 2.0 * b.x + 2.0 * c.x + d.x) / 6.0,
    y = (a.y + 2.0 * b.y + 2.0 * c.y + d.y) / 6.0,
    z = (a.z + 2.0 * b.z + 2.0 * c.z + d.z) / 6.0
)

step(at: Point) -> STREAM[Point, Point] => (
    let first = rate(at)
    let second = rate(along(at, first, dt / 2.0))
    let third = rate(along(at, second, dt / 2.0))
    let fourth = rate(along(at, third, dt))

    let slope = mean(first, second, third, fourth)
    let next = along(at, slope, dt)

    next || next
)

let path =
    stream((x = 1.0, y = 1.0, z = 1.0), step)
        |> skip(400)
        |> take(20000)
        |> list()

let image = IMAGE(560, 700)

image.view(-22.0, 0.0, 22.0, 55.0)
image.stroke(1.0)

for at in 0..path.count - 1 do
    let part = double(at) / double(path.count)
    let from = path[at]
    let to = path[at + 1]

    image.color(COLOR_MAP.viridis(part))
    image.line(from.x, from.z, to.x, to.z)
od

image.write("lorenz.png")

image.show("lorenz.png")
