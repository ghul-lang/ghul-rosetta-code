use default
use System.Net.Http.HttpClient
use System.Text.Json.JsonDocument
use System.Text.Json.JsonDocumentOptions

// The task: rank the languages by how many tasks each solves, which is the
// size of each language's category. The categories are the subcategories of
// Category:Programming Languages, fetched from the wiki's API a batch at a
// time, following its continuation until there is no more.
languages(api: string) -> List[(name: string, tasks: int)] is
    let client = HttpClient()

    // The wiki refuses a request that does not say what is making it.
    client.default_request_headers.user_agent
        .parse_add("ghul-rosetta-code/1.0")

    let found = LIST()
    let query =
        "{api}?action=query&generator=categorymembers"
        "&gcmtitle=Category:Programming_Languages&gcmtype=subcat"
        "&gcmlimit=500&prop=categoryinfo&format=json&formatversion=2"
    let next mut = ""

    do
        let text = client.get_string_async("{query}{next}").result
        let reply = JsonDocument.parse(text, _[JsonDocumentOptions])
        let root = reply.root_element

        for page in root.get_property("query")
                .get_property("pages").enumerate_array() do
            let title = page.get_property("title").get_string() ?? ""
            let info = page.get_property("categoryinfo")

            found.add((
                title.substring("Category:".length),
                info.get_property("pages").get_int32()))
        od

        let more: System.Text.Json.JsonElement mut = _

        if !root.try_get_property("continue", more ref) then
            break
        fi

        let token = more.get_property("gcmcontinue").get_string() ?? ""

        next =
            "&gcmcontinue={System.Uri.escape_data_string(token)}"
            "&continue=gcmcontinue||"
    od

    found
si

let ranked =
    languages("https://rosettacode.org/w/api.php")
        |> sort((a, b) =>
            if a.tasks != b.tasks then b.tasks <> a.tasks
            else string.compare_ordinal(a.name, b.name)
            fi)
        |> collect()

let rank mut = 0

for (i, (name, tasks)) in ranked |> take(25) |> index() do
    if i == 0 \/ tasks != ranked[i - 1].tasks then
        rank = i + 1
    fi

    write_line("Rank: {rank,3} ({tasks,5:N0} entries) {name}")
od

write_line("... and {ranked.count - 25} more")

if let place = ranked |> index() |> find(p => p.value.name =~ "Ghul") then
    write_line(
        "Ghul is at position {place.index + 1}, "
        "with {place.value.tasks:N0}")
fi
