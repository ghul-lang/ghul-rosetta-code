use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|> LIST()` reads the whole sequence into a new `LIST`
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

write_line("searching each triangle size for an arrangement")
write_line("")

let prime_sum = 0::41 |> map(is_prime) |> list()

extend(chosen: LIST[int], taken: LIST[bool], size: int) -> int[]{} is
    if chosen.count == size then
        yield chosen
    else
        let final = chosen.count == size - 1

        for candidate in 2::size do
            if
                (!final \/ candidate == size) /\
                !taken[candidate] /\
                prime_sum[chosen[chosen.count - 1] + candidate]
            then
                taken[candidate] = true

                chosen.add(candidate)

                yield in extend(chosen, taken, size)

                chosen.remove_at(chosen.count - 1)

                taken[candidate] = false
            fi
        od
    fi
si

arrangements(size: int) -> int[]{} =>
    extend([1] |> LIST(), repeat(false, size + 1) |> LIST(), size)

let totals = LIST()

for size in 2::20 do
    let shown mut = false
    let total mut = 0

    for arrangement in arrangements(size) do
        if !shown then
            write_line(arrangement |> map(value => "{value,3}") |> join(""))

            shown = true
        fi

        total = total + 1
    od

    totals.add(total)
od

write_line()
write_line("arrangements for each size:")
write_line("  {totals |> join(" ")}")
