use default
use System.Math

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

root_mean_square(values: double[]) -> double =>
    let squares = values |> sum_by(v => v * v) in
    Math.sqrt(squares / cast(values.count))

let one_to_ten = 1::10 |> map(double) |> list()

write_line("{root_mean_square(one_to_ten)}")
