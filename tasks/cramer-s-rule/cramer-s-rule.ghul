use default

use Matrix = int[][]

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`
// `==` compares identity
// `case ... when` pattern-matches, and `[x, ..rest]` matches a list head
// and tail

sign(column: int) -> int => if column % 2 == 0 then 1 else -1 fi

minor(m: Matrix, column: int) -> Matrix =>
    1..m.count
        |> map(row =>
            0..m.count
                |> filter(* != column)
                |> map(c => m[row][c])
                |> list()
        )
        |> list()

determinant(m: Matrix) -> int =>
    case m
    when [[entry]] then entry
    else
        0..m.count
            |> sum_by(c => sign(c) * m[0][c] * determinant(minor(m, c)))
    esac

with_column(m: Matrix, column: int, values: int[]) -> Matrix =>
    0..m.count
        |> map(row =>
            0..m.count
                |> map(c =>
                    if c == column then
                        values[row]
                    else
                        m[row][c]
                    fi
                )
                |> list()
        )
        |> list()

solve(m: Matrix, constants: int[]) -> double{} =>
    let denominator = double(determinant(m)) in
    0..m.count
        |> map(column =>
            double(
                determinant(with_column(m, column, constants))
            ) / denominator
        )

let coefficients = [
    [2, -1, 5, 1],
    [3, 2, 2, -6],
    [1, 3, 3, -1],
    [5, -2, -3, 3]
]

let constants = [-3, -32, -47, 49]

let names = ["w", "x", "y", "z"]

for (name, value) in names |> zip(solve(coefficients, constants)) do
    write_line("{name} = {value}")
od
