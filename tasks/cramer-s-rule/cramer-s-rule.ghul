use default

use Matrix = int[][]

sign(column) => if column % 2 == 0 then 1 else -1 fi

minor(m, column) =>
    1..m.count
        |> map(row =>
            0..m.count
                |> filter(* != column)
                |> map(c => m[row][c])
                |> list()
        )
        |> list()

determinant(m) =>
    case m
    when [[entry]] then entry
    else
        0..m.count
            |> sum_by(c => sign(c) * m[0][c] * determinant(minor(m, c)))
    esac

with_column(m, column, values) =>
    0..m.count
        |> map(row =>
            0..m.count
                |> map(c =>
                    if c == column then
                        values[row]
                    else
                        m[row][c]
                    fi
                )
                |> list()
        )
        |> list()

solve(m, constants) =>
    let denominator = double(determinant(m)) in
    0..m.count
        |> map(column =>
            double(
                determinant(with_column(m, column, constants))
            ) / denominator
        )

let coefficients = [
    [2, -1, 5, 1],
    [3, 2, 2, -6],
    [1, 3, 3, -1],
    [5, -2, -3, 3]
]

let constants = [-3, -32, -47, 49]

let names = ["w", "x", "y", "z"]

for (name, value) in names |> zip(solve(coefficients, constants)) do
    write_line("{name} = {value}")
od
