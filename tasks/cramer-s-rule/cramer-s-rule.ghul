use default

use Matrix = List[List[int]]

sign(column: int) -> int => if column % 2 == 0 then 1 else -1 fi

minor(m: Matrix, column: int) -> Matrix =>
    1..m.count
        |> map(row =>
            0..m.count
                |> filter(c => c != column)
                |> map(c => m[row][c])
                |> collect())
        |> collect()

determinant(m: Matrix) -> int =>
    if m.count == 1 then
        m[0][0]
    else
        0..m.count
            |> sum_by(c => sign(c) * m[0][c] * determinant(minor(m, c)))
    fi

with_column(m: Matrix, column: int, values: List[int]) -> Matrix =>
    0..m.count
        |> map(row =>
            0..m.count
                |> map(c =>
                    if c == column then values[row] else m[row][c] fi)
                |> collect())
        |> collect()

solve(m: Matrix, constants: List[int]) -> List[double] =>
    let denominator = double(determinant(m)) in
    0..m.count
        |> map(column =>
            double(determinant(with_column(m, column, constants))) /
            denominator)
        |> collect()

let coefficients = [
    [2, -1, 5, 1],
    [3, 2, 2, -6],
    [1, 3, 3, -1],
    [5, -2, -3, 3]
]

let constants = [-3, -32, -47, 49]

let names = ["w", "x", "y", "z"]

for (name, value) in names |> zip(solve(coefficients, constants)) do
    write_line("{name} = {value}")
od
