use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

qualifies(n: int) -> bool =>
    let ds = digits(n) in
    ds |> all(d => d != 0 /\ n % d == 0) /\ n % (ds |> product()) != 0

let found = 1..1000 |> filter(qualifies) |> list()

write_line("{found.count} numbers below 1,000:")

for row in found |> chunk(10) do
    write_line(row |> map(n => "{n,4}") |> join(""))
od
