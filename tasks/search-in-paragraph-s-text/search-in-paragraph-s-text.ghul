use default

let marker = "Traceback (most recent call last):"

let text = IO.File.read_all_text("Traceback.txt")
let paragraphs = text.split("\n\n", System.StringSplitOptions.NONE)

for paragraph in paragraphs do
    let start = paragraph.index_of(marker)

    if paragraph.contains("SystemError") /\ start >= 0 then
        write_line(paragraph.substring(start).trim_end())
        write_line("----------------")
    fi
od
