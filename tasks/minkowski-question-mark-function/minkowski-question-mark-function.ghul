use default
use Raster.Anchor
use Raster.AXES
use Raster.IMAGE

question(x) is
    let whole = floor(x)

    if x < 0.0 \/ x >= 1.0 then
        return whole + question(x - whole)
    fi

    let p mut = 0L
    let q mut = 1L
    let r mut = 1L
    let s mut = 1L

    let y mut = 0.0
    let step mut = 1.0

    do
        step = step / 2.0

        if y + step == y then
            break
        fi

        let m = p + r
        let n = q + s

        if x < double(m) / double(n) then
            r = m
            s = n
        else
            y = y + step
            p = m
            q = n
        fi
    od

    y + step
si

terms(y: double) -> int{} is
    let runs = LIST()

    let rest mut = y
    let bit mut = 0
    let run mut = 1

    for _ in 0..60 do
        if rest == 0.0 then
            break
        fi

        rest = rest * 2.0

        let next = if rest >= 1.0 then 1 else 0 fi

        if rest >= 1.0 then
            rest = rest - 1.0
        fi

        if next == bit then
            run = run + 1
        else
            runs.add(run)
            bit = next
            run = 1
        fi
    od

    runs.add(run)

    runs
si

inverse(y) is
    let whole = floor(y)

    if y < 0.0 \/ y >= 1.0 then
        return whole + inverse(y - whole)
    fi

    if y == 0.0 then
        return 0.0
    fi

    y
        |> terms()
        |> reverse()
        |> reduce(0.0, (x, term) => 1.0 / (double(term) + x))
si

let phi = (1.0 + sqrt(5.0)) / 2.0

write_line(
    "?(31/7)     {question(31.0 / 7.0):F10}"
    "   71/16 is {71.0 / 16.0:F10}"
)
write_line(
    "?(phi)      {question(phi):F10}"
    "   5/3 is {5.0 / 3.0:F10}"
)
write_line(
    "?-1(-5/9)  {inverse(-5.0 / 9.0):F10}"
    "   (sqrt(13) - 7)/6 is {(sqrt(13.0) - 7.0) / 6.0:F10}"
)
write_line("")

write_line("the two undo each other:")

for x in [0.125, 1.0 / 3.0, phi - 1.0, 0.9] do
    write_line("  ?-1(?({x:F6})) = {inverse(question(x)):F6}")
od

for y in [0.25, 0.6, 5.0 / 9.0] do
    write_line("  ?(?-1({y:F6})) = {question(inverse(y)):F6}")
od

write_line("")

let image = IMAGE(560, 560)
let axes = AXES(image)

axes.x_title = "x"
axes.y_title = "?(x)"
axes.fit(0.0, 0.0, 1.0, 1.0)

image.color(150ub, 150ub, 150ub)
image.stroke(1.0)
axes.draw()

image.color(210ub, 210ub, 210ub)
image.line(0.0, 0.0, 1.0, 1.0)

image.color(30ub, 70ub, 160ub)
image.stroke(1.6)
image.line(
    0..1201
        |> map(step => double(step) / 1200.0)
        |> map(x => (x = x, y = question(x)))
        |> list()
)

image.color(40ub, 40ub, 40ub)

for
    marked in [
        (x = 1.0 / 3.0, name = "1/3"),
        (x = phi - 1.0, name = "phi - 1"),
        (x = sqrt(2.0) - 1.0, name = "sqrt(2) - 1")
    ]
do
    let y = question(marked.x)

    image.dot(marked.x, y, 4.0)
    image.text(marked.x + 0.02, y - 0.03, 13.0, marked.name, Anchor.LEFT)
od

image.write("question-mark.png")

image.show("question-mark.png")
