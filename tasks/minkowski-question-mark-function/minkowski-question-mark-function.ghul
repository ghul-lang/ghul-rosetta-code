use default
use Raster.Anchor
use Raster.AXES
use Raster.IMAGE
use System.Math.floor
use System.Math.sqrt

question(x: double) -> double is
    let whole = floor(x)

    if x < 0.0D \/ x >= 1.0D then
        return whole + question(x - whole)
    fi

    let p mut = 0L
    let q mut = 1L
    let r mut = 1L
    let s mut = 1L

    let y mut = 0.0D
    let step mut = 1.0D

    do
        step = step / 2.0D

        if y + step == y then
            break
        fi

        let m = p + r
        let n = q + s

        if x < double(m) / double(n) then
            r = m
            s = n
        else
            y = y + step
            p = m
            q = n
        fi
    od

    y + step
si

terms(y: double) -> List[int] is
    let runs = LIST[int]()

    let rest mut = y
    let bit mut = 0
    let run mut = 1

    for _ in 0..60 do
        if rest == 0.0D then
            break
        fi

        rest = rest * 2.0D

        let next = if rest >= 1.0D then 1 else 0 fi

        if rest >= 1.0D then
            rest = rest - 1.0D
        fi

        if next == bit then
            run = run + 1
        else
            runs.add(run)
            bit = next
            run = 1
        fi
    od

    runs.add(run)

    runs
si

inverse(y: double) -> double is
    let whole = floor(y)

    if y < 0.0D \/ y >= 1.0D then
        return whole + inverse(y - whole)
    fi

    if y == 0.0D then
        return 0.0D
    fi

    let run = terms(y)
    let x mut = 0.0D

    for at in 0..run.count do
        let term = run[run.count - 1 - at]

        x = 1.0D / (double(term) + x)
    od

    x
si

let phi = (1.0D + sqrt(5.0D)) / 2.0D

write_line(
    "?(31/7)     {question(31.0D / 7.0D):F10}"
    "   71/16 is {71.0D / 16.0D:F10}")
write_line(
    "?(phi)      {question(phi):F10}"
    "   5/3 is {5.0D / 3.0D:F10}")
write_line(
    "?-1(-5/9)  {inverse(-5.0D / 9.0D):F10}"
    "   (sqrt(13) - 7)/6 is {(sqrt(13.0D) - 7.0D) / 6.0D:F10}")
write_line("")

write_line("the two undo each other:")

for x in [0.125D, 1.0D / 3.0D, phi - 1.0D, 0.9D] do
    write_line("  ?-1(?({x:F6})) = {inverse(question(x)):F6}")
od

for y in [0.25D, 0.6D, 5.0D / 9.0D] do
    write_line("  ?(?-1({y:F6})) = {question(inverse(y)):F6}")
od

write_line("")

let image = IMAGE(560, 560)
let axes = AXES(image)

axes.x_title = "x"
axes.y_title = "?(x)"
axes.fit(0.0D, 0.0D, 1.0D, 1.0D)

image.colour(150ub, 150ub, 150ub)
image.stroke(1.0D)
axes.draw()

image.colour(210ub, 210ub, 210ub)
image.line(0.0D, 0.0D, 1.0D, 1.0D)

image.colour(30ub, 70ub, 160ub)
image.stroke(1.6D)
image.line(
    0..1201
        |> map(step => double(step) / 1200.0D)
        |> map(x => (x = x, y = question(x)))
        |> collect())

image.colour(40ub, 40ub, 40ub)

for marked in [
    (x = 1.0D / 3.0D, name = "1/3"),
    (x = phi - 1.0D, name = "phi - 1"),
    (x = sqrt(2.0D) - 1.0D, name = "sqrt(2) - 1")]
do
    let y = question(marked.x)

    image.dot(marked.x, y, 4.0D)
    image.text(
        marked.x + 0.02D, y - 0.03D, 13.0D, marked.name, Anchor.LEFT)
od

image.write("question-mark.png")

image.show("question-mark.png")
