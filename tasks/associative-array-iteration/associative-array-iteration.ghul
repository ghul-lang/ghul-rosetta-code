use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `LIST()`, `SET()`, `MAP()` and `ARRAY()` build the collection eagerly.

let capitals = [
    ("France", "Paris"),
    ("Japan", "Tokyo"),
    ("Peru", "Lima")
]
    |> MAP()

write_line("keys:   {capitals.keys |> sort() |> join()}")
write_line("values: {capitals.values |> sort() |> join()}")

for (country, capital) in capitals do
    write_line("the capital of {country} is {capital}")
od
