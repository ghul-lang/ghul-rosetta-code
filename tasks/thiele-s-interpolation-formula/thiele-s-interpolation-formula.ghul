use default
use System.Math.*

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity
// `memo` on a function caches its results - a call with arguments equal to
//  an earlier call's returns the cached result, recursive calls included

class THIELE(_x: double[], _y: double[]) is
    _reciprocal(order: int, i: int) -> double memo =>
        if order < 0 then
            0.0
        elif order == 0 then
            _y[i]
        else
            (_x[i] - _x[i + order]) /
            (_reciprocal(order - 1, i) - _reciprocal(order - 1, i + 1)) +
            _reciprocal(order - 2, i + 1)
        fi

    at(value: double) -> double => _y[0] + _fraction(value, 1)

    _fraction(value: double, order: int) -> double =>
        if order >= _x.count - 1 then 0.0
        else
            (value - _x[order - 1]) /
            (
                _reciprocal(order, 0) -
                _reciprocal(order - 2, 0) +
                _fraction(value, order + 1)
            )
        fi
si

let xs = 0..32 |> map(i => double(i) * 0.05) |> list()
let sines = xs |> map(sin) |> list()
let cosines = xs |> map(cos) |> list()
let tangents = xs |> map(tan) |> list()

let inverse_sin = THIELE(sines, xs)
let inverse_cos = THIELE(cosines, xs)
let inverse_tan = THIELE(tangents, xs)

write_line("6 × asin(0.5) = {6.0 * inverse_sin.at(0.5):F14}")
write_line("3 × acos(0.5) = {3.0 * inverse_cos.at(0.5):F14}")
write_line("4 × atan(1.0) = {4.0 * inverse_tan.at(1.0):F14}")
write_line("π             = {pi:F14}")
