use default
use Raster.IMAGE

use Tier = (half_width: double, top: double)

let tiers: Tier[] = [
    (half_width = 60.0, top = 30.0),
    (half_width = 52.0, top = 60.0),
    (half_width = 40.0, top = 290.0),
    (half_width = 33.0, top = 305.0),
    (half_width = 26.0, top = 318.0),
    (half_width = 19.0, top = 330.0),
    (half_width = 12.0, top = 345.0),
    (half_width = 6.0, top = 380.0),
    (half_width = 2.5, top = 400.0)
]

let random = System.Random(34)

let image = IMAGE(240, 480)

image.view(-120.0, -10.0, 120.0, 470.0)
image.clear(15ub, 20ub, 45ub)

image.color(230ub, 230ub, 240ub)

for _ in 0..60 do
    image.dot(
        -120.0 + 240.0 * random.next_double(),
        200.0 + 270.0 * random.next_double(),
        0.8
    )
od

let bottom mut = 0.0

for tier in tiers do
    image.color(95ub, 95ub, 105ub)
    let left = -tier.half_width

    image.fill_rectangle(left, bottom, tier.half_width, tier.top)

    image.color(120ub, 120ub, 130ub)
    image.fill_rectangle(left, bottom, left + 3.0, tier.top)

    bottom = tier.top
od

image.color(200ub, 200ub, 210ub)
image.stroke(1.5)
image.line(0.0, 400.0, 0.0, 450.0)

let floor_height = 5.0
let window_width = 4.0

let floor mut = 1

while double(floor) * floor_height < 340.0 do
    let y = double(floor) * floor_height
    let tier = tiers |> find(t => t.top > y + floor_height)

    if let t = tier /\ t.half_width > 8.0 then
        let x mut = -t.half_width + 5.0

        while x + window_width < t.half_width - 3.0 do
            if random.next_double() < 0.35 then
                image.color(250ub, 220ub, 120ub)
            else
                image.color(45ub, 45ub, 60ub)
            fi

            image.fill_rectangle(
                x,
                y + 1.0,
                x + window_width - 1.5,
                y + floor_height - 1.0
            )

            x = x + window_width
        od
    fi

    floor = floor + 1
od

image.color(10ub, 12ub, 20ub)
image.fill_rectangle(-120.0, -10.0, 120.0, 0.0)

write_line("the Empire State Building at night")
write_line("{tiers.count} tiers and a mast")

image.write("empire-state.png")

image.show("empire-state.png")
