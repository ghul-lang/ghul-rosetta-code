use default

use Square = List[LIST[int]]

fits(square: Square, row: int, column: int, value: int) -> bool =>
    0..square.count
        |> all(k => square[row][k] != value /\ square[k][column] != value)

completions(square: Square, cells: List[(int, int)]) -> List[List[int]]{} is
    case cells
    when [] then
        yield square |> collect()
    when [(row, column), ..rest] then
        for value in 1::square.count do
            if fits(square, row, column, value) then
                square[row][column] = value
                yield in completions(square, rest)
                square[row][column] = 0
            fi
        od
    esac
si

reduced_latin_squares(n: int) -> List[List[int]]{} =>
    let square = 0..n
        |> map(row => 0..n
            |> map(column =>
                if row == 0 then column + 1
                elif column == 0 then row + 1
                else 0 fi)
            |> collect_mutable())
        |> collect() in
    let cells = 1..n
        |> flat_map(row => 1..n |> map(column => (row, column)))
        |> collect() in
    completions(square, cells)

let oeis = [1L, 2L, 12L, 576L, 161_280L, 812_851_200L]

write_line("The four reduced Latin squares of order 4:")

for square in reduced_latin_squares(4) do
    write_line()

    for row in square do
        write_line("  {row |> join(" ")}")
    od
od

write_line()
write_line(
    "{"n",2}{"reduced",9}{"times n!(n-1)!",17}{"OEIS A002860",16}")

for n in 1::6 do
    let reduced = long(reduced_latin_squares(n) |> count())
    let total = reduced * factorial(long(n)) * factorial(long(n - 1))

    write_line("{n,2}{reduced,9}{total,17}{oeis[n - 1],16}")
od
