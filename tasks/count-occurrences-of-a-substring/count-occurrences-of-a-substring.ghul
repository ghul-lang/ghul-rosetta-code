use default

occurrences(haystack: string, needle: string) -> int =>
    let at = haystack.index_of(needle) in
    if at < 0 then
        0
    else
        1 +
        occurrences(haystack[at + needle.length..<0], needle)
    fi

write_line("{occurrences("the three truths", "th")}")
write_line("{occurrences("ababababab", "abab")}")
