use default
use Raster.IMAGE

struct P(x: double, y: double) is
    -(o: P) -> P => P(x - o.x, y - o.y)
    ×(o: P) -> double => x * o.y - y * o.x

    length: double => sqrt(x * x + y * y)
    to_string() -> string => "({x}, {y})"
si

distance(p, from, to) =>
    let line = to - from in
    if line.length == 0.0 then (p - from).length
    else abs(line × (p - from)) / line.length
    fi

simplify(points: P[], epsilon: double) -> P[] is
    let last = points.count - 1
    let far mut = 0
    let farthest mut = 0.0

    for i in 1..last do
        let d = distance(points[i], points[0], points[last])

        if d > farthest then
            far = i
            farthest = d
        fi
    od

    if farthest <= epsilon then
        return [points[0], points[last]]
    fi

    let left = simplify(points[0::far], epsilon)
    let right = simplify(points[far::last], epsilon)

    return left |> take(left.count - 1) |> cat(right) |> list()
si

let line = [
    P(0.0, 0.0), P(1.0, 0.1), P(2.0, -0.1), P(3.0, 5.0),
    P(4.0, 6.0), P(5.0, 7.0), P(6.0, 8.1), P(7.0, 9.0),
    P(8.0, 9.0), P(9.0, 9.0)
]

let simple = simplify(line, 1.0)

write_line(simple |> join(" "))

let image = IMAGE(400, 400)

image.view(-0.5, -0.5, 9.5, 9.5)
image.clear(252ub, 252ub, 250ub)

draw(points, width, size) is
    image.stroke(width)
    image.line(points |> map(p => (x = p.x, y = p.y)) |> list())

    for p in points do
        image.dot(p.x, p.y, size)
    od
si

image.color(170ub, 170ub, 180ub)
draw(line, 6.0, 7.0)

image.color(200ub, 50ub, 40ub)
draw(simple, 2.0, 4.0)

image.write("simplified.png")

image.show("simplified.png")
