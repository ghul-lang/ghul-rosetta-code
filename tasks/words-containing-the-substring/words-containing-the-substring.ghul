use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

write_line(
    IO.File.read_all_lines("unixdict.txt")
        |> filter(word => word.length > 11 /\ word.contains("the"))
        |> join("\n")
)
