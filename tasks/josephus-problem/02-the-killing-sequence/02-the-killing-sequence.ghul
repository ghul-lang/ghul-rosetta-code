use default

killings(n: int, k: int) -> int{} is
    let standing = 0..n |> collect_mutable()
    let at mut = 0

    while standing.count > 1 do
        at = (at + k - 1) % standing.count

        yield standing[at]

        standing.remove_at(at)
    od
si

show(n: int, k: int) is
    let killed = killings(n, k) |> collect()

    write_line("n = {n}, k = {k}: killed {killed |> join(", ")}")
si

show(5, 2)
show(7, 3)
