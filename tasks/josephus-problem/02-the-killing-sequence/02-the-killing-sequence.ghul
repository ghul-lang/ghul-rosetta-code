use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `LIST[T]` is a mutable list that grows as elements are added
// `|> LIST()` reads the whole sequence into a new `LIST`
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

killings(n: int, k: int) -> int{} is
    let standing = 0..n |> LIST()
    let at mut = 0

    while standing.count > 1 do
        at = (at + k - 1) % standing.count

        yield standing[at]

        standing.remove_at(at)
    od
si

show(n: int, k: int) =>
    write_line("n = {n}, k = {k}: killed {killings(n, k) |> join(", ")}")

show(5, 2)
show(7, 3)
