use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `LIST()`, `SET()`, `MAP()` and `ARRAY()` build the collection eagerly.

killings(n: int, k: int) -> int{} is
    let standing = 0..n |> LIST()
    let at mut = 0

    while standing.count > 1 do
        at = (at + k - 1) % standing.count

        yield standing[at]

        standing.remove_at(at)
    od
si

show(n: int, k: int) =>
    write_line("n = {n}, k = {k}: killed {killings(n, k) |> join(", ")}")

show(5, 2)
show(7, 3)
