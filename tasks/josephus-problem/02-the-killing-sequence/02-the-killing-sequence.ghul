use default

killings(n, k) is
    let standing = 0..n |> LIST()
    let at mut = 0

    while standing.count > 1 do
        at = (at + k - 1) % standing.count

        yield standing[at]

        standing.remove_at(at)
    od
si

show(n, k) =>
    write_line("n = {n}, k = {k}: killed {killings(n, k) |> join(", ")}")

show(5, 2)
show(7, 3)
