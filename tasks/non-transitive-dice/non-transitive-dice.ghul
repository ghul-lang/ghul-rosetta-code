use default

use Die = int[]

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `=~` compares values (structural equality) - `==` compares identity

beats(x: Die, y: Die) -> int =>
    let wins = x |> flat_map(a => y |> map(b => a <> b)) in
    (wins |> count(w => w > 0)) - (wins |> count(w => w < 0))

let dice =
    1::4
        |> flat_map(a =>
            a::4
                |> flat_map(b =>
                    b::4 |> flat_map(c => c::4 |> map(d => [a, b, c, d]))
                )
        )
        |> list()

// chains of distinct dice, each beaten by the one after it, whose first die
// beats the last

extend(chain: Die[], length: int) -> Die[]{} is
    if chain.count == length then
        if beats(chain[0], chain[length - 1]) > 0 then
            yield chain
        fi
    else
        let last = chain[chain.count - 1]

        for die in dice do
            let fresh = !(chain |> any(used => used =~ die))

            if fresh /\ beats(last, die) < 0 then
                let longer = chain ++ [die] |> list()

                yield in extend(longer, length)
            fi
        od
    fi
si

chains(length: int) -> Die[]{} is
    for die in dice do
        yield in extend([die], length)
    od
si

write_line(
    "There are {dice.count} four-faced dice with faces from 1 to 4.\n"
)

for length in [3, 4] do
    let found = chains(length) |> list()

    write_line(
        "{found.count} ordered lists of {length} non-transitive dice:"
    )

    for chain in found do
        write_line("    {chain}")
    od

    write_line("")
od
