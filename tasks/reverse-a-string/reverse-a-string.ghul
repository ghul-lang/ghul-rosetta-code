use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

reverse(text: string) -> string =>
    text |> graphemes() |> reverse() |> string()

write_line(reverse("asdf"))
write_line(reverse("Hello, World!"))
write_line(reverse("as⃝df̅"))
write_line(reverse("Mañana 😀"))
