use default
use System.Net.Http.HttpClient
use System.Net.Http.HttpClientHandler

// The handler decides which server certificates are trusted: a plain one
// checks them against the system's own store.
fetch(url: string, handler: HttpClientHandler) -> string =>
    HttpClient(handler).get_string_async(url).result

IO.Std.write(fetch("https://www.example.com", HttpClientHandler()))
