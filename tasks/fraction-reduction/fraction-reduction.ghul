use default

use Candidate = (value: int, mask: int, reduced: int[])

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `LIST()` builds its collection eagerly
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`
// `==` compares identity

describe(value: int) -> Candidate is
    let reduced = repeat(0, 10) |> LIST()
    let places = value |> digits() |> list()

    let mask mut = 0

    for digit in places do
        if digit == 0 \/ (mask >> digit) & 1 == 1 then
            return (value = value, mask = 0, reduced = reduced)
        fi

        mask = mask | (1 << digit)
    od

    for i in 0..places.count do
        reduced[places[i]] =
            0..places.count
                |> filter(* != i)
                |> reduce(0, (kept, j) => kept * 10 + places[j])
    od

    return (value = value, mask = mask, reduced = reduced)
si

candidates(size: int) -> Candidate[] =>
    let lowest = repeat(10, size - 1) |> reduce(1, * * *) in
    lowest..lowest * 10
        |> map(describe)
        |> filter(candidate => candidate.mask != 0)
        |> list()

for size in 2::5 do
    IO.Std.write("{size}-digit fractions: ")
    IO.Std.out.flush()

    let entries = candidates(size)
    let shown = LIST()

    let found mut = 0

    for i in 0..entries.count do
        let numerator = entries[i]

        for j in i + 1..entries.count do
            let denominator = entries[j]
            let shared = numerator.mask & denominator.mask

            for digit in 1::9 do
                if (shared >> digit) & 1 == 0 then
                    continue
                fi

                let top = numerator.reduced[digit]
                let bottom = denominator.reduced[digit]

                let matches =
                    bottom != 0 /\
                    numerator.value * bottom == denominator.value * top

                if matches then
                    found = found + 1

                    if shown.count < 12 then
                        shown.add(
                            "{numerator.value}/{denominator.value} = "
                            "{top}/{bottom} by omitting {digit}'s"
                        )
                    fi
                fi
            od
        od
    od

    write_line("{found} found")

    shown |> each(line => write_line("  {line}"))

    write_line("")
od
