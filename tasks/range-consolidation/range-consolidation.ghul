use default

use RANGE = (low: double, high: double)

normalised(bounds) =>
    if bounds.low <= bounds.high then
        bounds
    else
        (low = bounds.high, high = bounds.low)
    fi

by_lower_bound(left, right) =>
    if left.low < right.low then
        -1
    elif left.low > right.low then
        1
    else
        0
    fi

consolidate(ranges) is
    let sorted = ranges |> map(normalised) |> sort(by_lower_bound)
    let merged = LIST()

    for bounds in sorted do
        let last_index = merged.count - 1

        if merged.count > 0 /\ bounds.low <= merged[last_index].high then
            let last = merged[last_index]

            if bounds.high > last.high then
                merged[last_index] = (low = last.low, high = bounds.high)
            fi
        else
            merged.add(bounds)
        fi
    od

    return merged
si

show(ranges) =>
    ranges |> map(bounds => "[{bounds.low}, {bounds.high}]") |> join()

let inputs = [
    [(low = 1.1, high = 2.2)],
    [(low = 6.1, high = 7.2), (low = 7.2, high = 8.3)],
    [(low = 4.0, high = 3.0), (low = 2.0, high = 1.0)],
    [
        (low = 4.0, high = 3.0), (low = 2.0, high = 1.0),
        (low = -1.0, high = -2.0), (low = 3.9, high = 10.0)
    ],
    [
        (low = 1.0, high = 3.0), (low = -6.0, high = -1.0),
        (low = -4.0, high = -5.0), (low = 8.0, high = 2.0),
        (low = -6.0, high = -6.0)
    ]
]

for input in inputs do
    write_line("{show(input)} -> {show(consolidate(input))}")
od
