use default
use Raster.IMAGE

struct P(x: double, y: double) is
    +(o: P) -> P => P(x + o.x, y + o.y)
    -(o: P) -> P => P(x - o.x, y - o.y)
    *(k: double) -> P => P(x * k, y * k)
    ×(o: P) -> double => x * o.y - y * o.x

    to_string() -> string => "({x:0.#}, {y:0.#})"
si

class NODE(at: P, crossing: bool) is
    next: NODE? public
    other: NODE? public
    entering: bool public
    visited: bool public
si

use Crossing = (edge: int, t: double, node: NODE)

area(polygon: P[]) -> double =>
    (0..polygon.count)
        |> sum_by(i => polygon[i] × polygon[(i + 1) % polygon.count])

contains(polygon: P[], p: P) -> bool => (
    let inside mut = false

    for i in 0..polygon.count do
        let a = polygon[i]
        let b = polygon[(i + 1) % polygon.count]

        if
            (a.y > p.y) != (b.y > p.y) /\
            p.x < a.x + (p.y - a.y) * (b.x - a.x) / (b.y - a.y)
        then
            inside = !inside
        fi
    od

    inside
)

ring(polygon: P[], crossings: Crossing[]) -> NODE{} is
    let nodes = LIST()

    for i in 0..polygon.count do
        nodes.add(NODE(polygon[i], false))

        crossings
            |> filter(c => c.edge == i)
            |> sort((a, b) => a.t <> b.t)
            |> each(c => nodes.add(c.node))
    od

    for i in 0..nodes.count do
        nodes[i].next = nodes[(i + 1) % nodes.count]
    od

    nodes
si

clip(subject: P[], given: P[]) -> P[][] is
    let flip = (area(subject) > 0.0) != (area(given) > 0.0)
    let window =
        (0..given.count)
            |> map(i =>
                if flip then
                    given[given.count - 1 - i]
                else
                    given[i]
                fi
            )
            |> list()

    let on_subject = LIST()
    let on_window = LIST()

    for i in 0..subject.count do
        let a = subject[i]
        let r = subject[(i + 1) % subject.count] - a

        for j in 0..window.count do
            let c = window[j]
            let q = window[(j + 1) % window.count] - c
            let d = r × q

            if d != 0.0 then
                let t = (c - a) × q / d
                let u = (c - a) × r / d

                if t > 0.0 /\ t < 1.0 /\ u > 0.0 /\ u < 1.0 then
                    let s = NODE(a + r * t, true)
                    let w = NODE(a + r * t, true)

                    s.other = w
                    w.other = s
                    on_subject.add((edge = i, t = t, node = s))
                    on_window.add((edge = j, t = u, node = w))
                fi
            fi
        od
    od

    let nodes = ring(subject, on_subject)

    ring(window, on_window)

    let inside mut = contains(window, subject[0])

    for node in nodes do
        if node.crossing then
            node.entering = !inside
            inside = !inside
        fi
    od

    let results = LIST[P[]]()

    for start in nodes do
        if start.crossing /\ start.entering /\ !start.visited then
            let polygon = LIST()
            let node mut = start

            do
                node.visited = true
                node.other!.visited = true
                polygon.add(node.at)
                node = node.next!

                while !node.crossing do
                    polygon.add(node.at)
                    node = node.next!
                od

                if node == start \/ node.other == start then
                    break
                fi

                node = node.other!
            od

            results.add(polygon)
        fi
    od

    results
si

let subject = [
    P(180.0, 420.0), P(180.0, 120.0), P(520.0, 120.0),
    P(520.0, 420.0), P(420.0, 420.0), P(320.0, 220.0)
]

let window = [
    P(60.0, 220.0), P(330.0, 120.0), P(410.0, 290.0),
    P(80.0, 480.0), P(280.0, 280.0)
]

let pieces = clip(subject, window)

write_line("{pieces.count} polygons")

for piece in pieces do
    write_line()
    piece |> each(p => write_line("    {p}"))
od

let image = IMAGE(600, 560)

image.view(0.0, 540.0, 600.0, 60.0)
image.clear(252ub, 252ub, 250ub)

outline(polygon: P[]) -> (x: double, y: double)[] =>
    polygon ++ [polygon[0]] |> map(p => (x = p.x, y = p.y)) |> list()

image.color(250ub, 200ub, 90ub)

for piece in pieces do
    image.fill(outline(piece))
od

image.stroke(2.0)
image.color(40ub, 90ub, 180ub)
image.line(outline(subject))
image.color(200ub, 50ub, 40ub)
image.line(outline(window))

image.write("clipped.png")

image.show("clipped.png")
