use default
use Time.DATE_TIME
use Time.DATE_TIME_OFFSET
use Time.DateTimeKind
use Time.TIME_SPAN

show(library, epoch) =>
    write_line("{library,-22}{epoch,-22:yyyy-MM-dd HH:mm:ss}{epoch.kind}")

let utc_zero = DATE_TIME_OFFSET(0L, TIME_SPAN.zero)

show("System.DateTime", DATE_TIME(0L))
show("System.DateTimeOffset", utc_zero.utc_date_time)
show("Unix time", DATE_TIME.unix_epoch)
show("Windows file time", DATE_TIME.from_file_time_utc(0L))

let instant = DATE_TIME(2026, 9, 21, 12, 0, 0, DateTimeKind.UTC)
let unix_seconds = DATE_TIME_OFFSET(instant).to_unix_time_seconds()

write_line()
write_line("a tick is 100ns since the type's own epoch, so")
write_line("{instant:yyyy-MM-dd HH:mm:ss} is {instant.ticks} ticks")
write_line("and {unix_seconds} seconds of Unix time")
