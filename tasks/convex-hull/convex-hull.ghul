use default
use Raster.AXES
use Raster.IMAGE

use Point = (x: int, y: int)

let points = [
    (x = 16, y = 3), (x = 12, y = 17), (x = 0, y = 6),
    (x = -4, y = -6), (x = 16, y = 6), (x = 16, y = -7),
    (x = 16, y = -3), (x = 17, y = -4), (x = 5, y = 19),
    (x = 19, y = -8), (x = 3, y = 16), (x = 12, y = 13),
    (x = 3, y = -4), (x = 17, y = 5), (x = -3, y = 15),
    (x = -3, y = -9), (x = 0, y = 11), (x = -9, y = -3),
    (x = -4, y = -2), (x = 12, y = 10)
]

turn(from: Point, through: Point, to: Point) -> int =>
    (through.x - from.x) * (to.y - from.y) -
    (through.y - from.y) * (to.x - from.x)

half_hull(ordered: Point[]) -> LIST[Point] is
    let side = LIST()

    for at in ordered do
        while
            side.count > 1 /\
            turn(side[side.count - 2], side[side.count - 1], at) <= 0
        do
            side.remove_at(side.count - 1)
        od

        side.add(at)
    od

    side.remove_at(side.count - 1)

    return side
si

let ordered =
    points
        |> sort((a, b) => if a.x != b.x then a.x - b.x else a.y - b.y fi)
        |> list()

let backwards =
    (0..ordered.count)
        |> map(step => ordered[ordered.count - 1 - step])
        |> list()

let hull = half_hull(ordered)

for at in half_hull(backwards) do
    hull.add(at)
od

let spelled = hull |> map(at => "({at.x},{at.y})") |> join()

write_line("{points.count} points")
write_line("hull of {hull.count}: {spelled}")

let image = IMAGE(600, 600)

image.color(90ub, 90ub, 100ub)
image.stroke(1.0)

let axes = AXES(image)

axes.fit(-11.0, -11.0, 21.0, 21.0)
axes.draw()

let corners = LIST(hull |> map(at => (x = double(at.x), y = double(at.y))))

image.color(206ub, 224ub, 244ub)
image.fill(corners)

corners.add(corners[0])

image.color(40ub, 92ub, 168ub)
image.stroke(2.0)
image.line(corners)

for at in points do
    image.color(60ub, 60ub, 70ub)
    image.dot(double(at.x), double(at.y), 3.5)
od

for at in hull do
    image.color(216ub, 64ub, 48ub)
    image.dot(double(at.x), double(at.y), 5.0)
od

image.write("hull.png")

image.show("hull.png")
