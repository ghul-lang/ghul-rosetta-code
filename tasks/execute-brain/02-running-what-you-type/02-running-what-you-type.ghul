use IO.Std.read_line
use IO.Std.write
use default

run(program: string, input: string) -> string is
    let cells = LIST()

    for _ in 0..30000 do
        cells.add(0)
    od

    let matching_bracket = LIST()

    for _ in 0..program.length do
        matching_bracket.add(0)
    od

    let open = LIST()

    for at in 0..program.length do
        if program[at] == '[' then
            open.add(at)
        elif program[at] == ']' then
            let start = open[open.count - 1]

            open.remove_at(open.count - 1)

            matching_bracket[start] = at
            matching_bracket[at] = start
        fi
    od

    let output = LIST[char]()

    let cell mut = 0
    let at mut = 0
    let read mut = 0

    while at < program.length do
        case program[at]
        when '>' then cell = cell + 1
        when '<' then cell = cell - 1
        when '+' then cells[cell] = (cells[cell] + 1) % 256
        when '-' then cells[cell] = (cells[cell] + 255) % 256
        when '.' then output.add(char(cells[cell]))
        when ',' then
            let next =
                if read < input.length then int(input[read]) else 0 fi

            cells[cell] = next
            read = read + 1
        when '[' then
            if cells[cell] == 0 then
                at = matching_bracket[at]
            fi
        when ']' then
            if cells[cell] != 0 then
                at = matching_bracket[at]
            fi
        esac

        at = at + 1
    od

    string(output |> collect())
si

balanced(program: string) -> bool is
    let depth mut = 0

    for symbol in program do
        if symbol == '[' then
            depth = depth + 1
        elif symbol == ']' then
            depth = depth - 1

            if depth < 0 then
                return false
            fi
        fi
    od

    depth == 0
si

ask(question: string) -> string? is
    write(question)

    read_line()
si

while let program = ask("program: ") do
    let input = ask("input: ") ?? ""

    if balanced(program) then
        write_line("output: {run(program, input)}")
    else
        write_line("its brackets do not match")
    fi

    write_line("")
od
