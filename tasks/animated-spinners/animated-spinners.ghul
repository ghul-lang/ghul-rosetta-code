use default
use Raster.ANIMATION
use Raster.IMAGE

let size = 240
let frames = 36
let spokes = 12

let centers = [
    (x = 120.0, y = 120.0),
    (x = 60.0, y = 60.0),
    (x = 180.0, y = 60.0),
    (x = 60.0, y = 180.0),
    (x = 180.0, y = 180.0)
]

let radius = 22.0

draw_spinner(image: IMAGE, cx: double, cy: double, angle: double) is
    // faint spokes
    image.color(60ub, 60ub, 80ub)
    image.stroke(1.0)

    for s in 0..spokes do
        let a = double(s) * 360.0 / double(spokes) * pi / 180.0
        image.line(cx, cy, cx + radius * cos(a), cy + radius * sin(a))
    od

    // bright hand
    image.color(255ub, 220ub, 80ub)
    image.stroke(2.0)
    let radians = angle * pi / 180.0
    image.line(
        cx,
        cy,
        cx + radius * cos(radians),
        cy + radius * sin(radians)
    )
si

let image = IMAGE(size, size)
let animation = ANIMATION(size, size)

for frame in 0..frames do
    image.clear(10ub, 10ub, 20ub)

    for ci in 0..centers.count - 1 do
        let c = centers[ci]
        let step = 360.0 / double(frames)
        let angle = double(frame) * step + double(ci) * 30.0
        draw_spinner(image, c.x, c.y, angle)
    od

    animation.add(image, 40)
od

animation.write("animated-spinners.png")

animation.show("animated-spinners.png")
