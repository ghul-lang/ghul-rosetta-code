use default

code(c: char) -> char =>
    case char.to_upper(c)
    when 'B', 'F', 'P', 'V' then '1'
    when 'C', 'G', 'J', 'K', 'Q', 'S', 'X', 'Z' then '2'
    when 'D', 'T' then '3'
    when 'L' then '4'
    when 'M', 'N' then '5'
    when 'R' then '6'
    when 'H', 'W' then '-'
    else '0'
    esac

// H and W do not separate two letters with the same code; a vowel does.
soundex(name: string) -> string is
    let letters =
        name.to_char_array() |> filter(char.is_letter) |> collect()

    if letters.count == 0 then
        return ""
    fi

    let result = System.Text.StringBuilder()
    let previous mut = code(letters[0])

    result.append(char.to_upper(letters[0]))

    for c in letters |> skip(1) do
        let digit = code(c)

        if digit == '-' then
            continue
        fi

        if digit != '0' /\ digit != previous then
            result.append(digit)
        fi

        previous = digit
    od

    result.to_string().pad_right(4, '0').substring(0, 4)
si

let names = [
    "Robert", "Rupert", "Rubin", "Ashcraft", "Ashcroft", "Tymczak",
    "Pfister", "Honeyman", "Lee", "Gutierrez", "Jackson", "VanDeusen",
    "Deusen", "Soundex", "Example", "Lloyd", "Burroughs", "Burrows"
]

for name in names do
    write_line("{name,-10} {soundex(name)}")
od
