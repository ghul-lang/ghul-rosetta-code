use default

union Rule is
    WORD(head: string, word: string)
    PAIR(head: string, left: string, right: string)
si

let grammar =
    [
        Rule.PAIR("NP", "Det", "Nom"),
        Rule.PAIR("Nom", "AP", "Nom"),
        Rule.WORD("Nom", "book"),
        Rule.WORD("Nom", "orange"),
        Rule.WORD("Nom", "man"),
        Rule.PAIR("AP", "Adv", "A"),
        Rule.WORD("AP", "heavy"),
        Rule.WORD("AP", "orange"),
        Rule.WORD("AP", "tall"),
        Rule.WORD("Det", "a"),
        Rule.WORD("Adv", "very"),
        Rule.WORD("Adv", "extremely"),
        Rule.WORD("A", "heavy"),
        Rule.WORD("A", "orange"),
        Rule.WORD("A", "tall"),
        Rule.WORD("A", "muscular")
    ]

parses(sentence: string, start: string) -> bool is
    let words = sentence.split([' '])
    let length = words.count

    let table = LIST[LIST[SET[string]]]()

    for _ in 0..length do
        let row = LIST[SET[string]]()

        for _ in 0..length do
            row.add(SET())
        od

        table.add(row)
    od

    for at in 0..length do
        for rule in grammar do
            if let (head, word): Rule.WORD = rule /\ word =~ words[at] then
                table[at][at].add(head)
            fi
        od
    od

    for span in 2::length do
        for from in 0..length - span + 1 do
            let to = from + span - 1

            for split in from..to do
                for rule in grammar do
                    if let (head, left, right): Rule.PAIR = rule then
                        if table[from][split].contains(left) /\
                            table[split + 1][to].contains(right)
                        then
                            table[from][to].add(head)
                        fi
                    fi
                od
            od
        od
    od

    table[0][length - 1].contains(start)
si

for sentence in ["a very heavy orange book", "a book very heavy"] do
    write_line("{sentence}: {parses(sentence, "NP")}")
od
