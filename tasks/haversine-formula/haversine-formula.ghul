use default

let earth_radius_km = 6372.8

radians(degrees) => degrees * pi / 180.0

haversine(theta) => sin(theta / 2.0) * sin(theta / 2.0)

great_circle_distance(
    (latitude_1, longitude_1): (double, double),
    (latitude_2, longitude_2): (double, double),
    radius: double
) -> double =>
    let chord =
        haversine(radians(latitude_2 - latitude_1)) +
        cos(radians(latitude_1)) *
        cos(radians(latitude_2)) *
        haversine(radians(longitude_2 - longitude_1))
    in
    2.0 * radius * asin(sqrt(chord))

let nashville = (36.12, -86.67)
let los_angeles = (33.94, -118.40)

let distance = great_circle_distance(
    nashville,
    los_angeles,
    earth_radius_km
)

write_line("BNA to LAX: {distance:F6} km")
