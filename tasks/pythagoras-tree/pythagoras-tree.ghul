use Raster.IMAGE

let image = IMAGE(800, 600)

square(
    x1: double, y1: double,
    x2: double, y2: double,
    depth: int
) is
    if depth == 0 then
        return
    fi

    let across = x2 - x1
    let up = y1 - y2

    let x3 = x2 - up
    let y3 = y2 - across
    let x4 = x1 - up
    let y4 = y1 - across

    let x5 = x4 + 0.5D * (across - up)
    let y5 = y4 - 0.5D * (across + up)

    image.colour(0ub, ubyte(90 + 20 * depth), 0ub)

    image.fill([(x1, y1), (x2, y2), (x3, y3), (x4, y4)])

    square(x4, y4, x5, y5, depth - 1)
    square(x5, y5, x3, y3, depth - 1)
si

square(340.0D, 580.0D, 460.0D, 580.0D, 7)

image.write("pythagoras.png")

image.show("pythagoras.png")
