@@suppress("deprecated")
@@precedence("∘", "user-8")

use default

∘(f: (int) -> int, g: (int) -> int) -> (int) -> int => x => f(g(x))

@suppress("non-snake-case-name")
BadlyNamed() -> string => "declared with a name the convention rejects"

@System.Obsolete("superseded, but still callable")
superseded() -> string => "carrying a .NET attribute"

@equality()
class POINT(x: int, y: int) is
    to_string() -> string => "({x}, {y})"
si

let double = n => n * 2
let increment = n => n + 1

let composed = double ∘ increment

write_line("@@precedence places an operator: composed(5) = {composed(5)}")
write_line("@suppress silences one diagnostic, for one declaration:")
write_line("  {BadlyNamed()}")
write_line("a pragma naming no built-in is a .NET attribute:")
write_line("  {superseded()}")
write_line("@equality asks for =~ and a hash:")
write_line("  {POINT(1, 2) =~ POINT(1, 2)}")
write_line("without it they compare by identity:")
write_line("  {POINT(1, 2) == POINT(1, 2)}")
