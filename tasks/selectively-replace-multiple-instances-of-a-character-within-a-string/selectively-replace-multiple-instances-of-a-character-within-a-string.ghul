use default
use System.Text.StringBuilder

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `MAP()` builds a collection eagerly

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `LIST()`, `SET()`, `MAP()` and `ARRAY()` build the collection eagerly.

let replacements = [
    (('a', 1), 'A'),
    (('a', 2), 'B'),
    (('a', 4), 'C'),
    (('a', 5), 'D'),
    (('b', 1), 'E'),
    (('r', 2), 'F')
]
    |> MAP()

let seen = MAP()

let built = StringBuilder()

for letter in "abracadabra" do
    let so_far =
        if seen.contains_key(letter) then
            seen[letter] + 1
        else
            1
        fi

    seen[letter] = so_far

    let key = (letter, so_far)

    if replacements.contains_key(key) then
        built.append(replacements[key])
    else
        built.append(letter)
    fi
od

write_line("{built}")
