use default
use System.Text.StringBuilder

let replacements = [
    (('a', 1), 'A'),
    (('a', 2), 'B'),
    (('a', 4), 'C'),
    (('a', 5), 'D'),
    (('b', 1), 'E'),
    (('r', 2), 'F')
]
    |> collect_map()

let seen = MAP()

let built = StringBuilder()

for letter in "abracadabra" do
    let so_far =
        if seen.contains_key(letter) then
            seen[letter] + 1
        else
            1
        fi

    seen[letter] = so_far

    let key = (letter, so_far)

    if replacements.contains_key(key) then
        built.append(replacements[key])
    else
        built.append(letter)
    fi
od

write_line("{built}")
