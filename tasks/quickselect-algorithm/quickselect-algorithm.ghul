use default

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

quickselect(values: int[], k: int) -> int is
    let pivot = values[values.count / 2]

    let lowers = values |> filter(* < pivot) |> list()
    let pivots = values |> filter(* == pivot) |> list()

    if k < lowers.count then
        quickselect(lowers, k)
    elif k < lowers.count + pivots.count then
        pivot
    else
        quickselect(
            values |> filter(* > pivot) |> list(),
            k - lowers.count - pivots.count
        )
    fi
si

let values = [9, 8, 7, 6, 5, 0, 1, 2, 3, 4]

for k in 0..values.count do
    write_line(
        "largest {k + 1}: {quickselect(values, values.count - 1 - k)}"
    )
od
