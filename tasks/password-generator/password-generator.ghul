use default

use System.Security.Cryptography.RandomNumberGenerator

let usage = [
    "Generates random passwords, each with at least one lower-case letter,",
    "one upper-case letter, one digit and one other printable character.",
    "",
    "  -l <length>  length of each password (default 8, at least 4)",
    "  -c <count>   number of passwords (default 1)",
    "  -s <seed>    seed a repeatable generator instead of the system one",
    "  -x           leave out look-alike characters: Il1 O0 5S 2Z",
    "  -h           show this help"
]

let lookalikes = "Il1O05S2Z"

let groups = [
    "abcdefghijklmnopqrstuvwxyz",
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
    "0123456789",
    "!\"#$%&'()*+,-./:;<=>?@[]^_{{|}}~"
]

option(args: string[], flag: string) -> int? =>
    let at = System.Array.index_of(args, flag) in
    if at >= 0 /\ at + 1 < args.count then
        int.parse(args[at + 1])
    else
        null
    fi

without_lookalikes(group: string) -> string =>
    string(group
        |> filter(c => lookalikes.index_of(c) < 0)
        |> collect())

password(length: int, pools: List[string], next: int -> int) -> string is
    let every = pools |> join("")
    let chars = pools |> map(p => p[next(p.length)]) |> collect_mutable()

    for _ in pools.count..length do
        chars.add(every[next(every.length)])
    od

    for i in 1..chars.count |> reverse() do
        let j = next(i + 1)
        (chars[i], chars[j]) = (chars[j], chars[i])
    od

    string(chars |> collect())
si

if args |> any(a => a =~ "-h") then
    for line in usage do
        write_line(line)
    od
else
    let length = System.Math.max(4, option(args, "-l") ?? 8)
    let count = option(args, "-c") ?? 1
    let exclude = args |> any(a => a =~ "-x")

    let pools = groups
        |> map(g => if exclude then without_lookalikes(g) else g fi)
        |> collect()

    let seed = option(args, "-s")
    let seeded = if let s = seed then System.Random(s) else null fi

    let next = bound =>
        if let r = seeded then
            r.next(bound)
        else
            RandomNumberGenerator.get_int32(bound)
        fi

    for _ in 1::count do
        write_line(password(length, pools, next))
    od
fi
