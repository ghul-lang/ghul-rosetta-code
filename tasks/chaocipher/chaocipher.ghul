use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `LIST()`, `SET()`, `MAP()` and `ARRAY()` build the collection eagerly.
// `*` as an argument leaves that parameter open: partial application.

let nadir = 13

rotate(alphabet: LIST[char], by: int) is
    for _ in 0..by do
        let first = alphabet[0]

        alphabet.remove_at(0)
        alphabet.add(first)
    od
si

advance(left: LIST[char], right: LIST[char], index: int) is
    rotate(left, index)

    let from_left = left[1]

    left.remove_at(1)
    left.insert(nadir, from_left)

    rotate(right, index + 1)

    let from_right = right[2]

    right.remove_at(2)
    right.insert(nadir, from_right)
si

chao(text: string, encrypting: bool) -> string is
    let left = "HXUCZVAMDSLKPEFJRIGTWOBNYQ" |> LIST()
    let right = "PTLNBQDEOYSFAVZKGJRIHWXUMC" |> LIST()
    let out = LIST()

    for letter in text do
        let index =
            if encrypting then
                right |> find_index(* == letter)!
            else
                left |> find_index(* == letter)!
            fi

        out.add(if encrypting then left[index] else right[index] fi)

        advance(left, right, index)
    od

    return string(out)
si

let plain = "WELLDONEISBETTERTHANWELLSAID"
let cipher = chao(plain, true)

write_line("plaintext  {plain}")
write_line("ciphertext {cipher}")
write_line("recovered  {chao(cipher, false)}")
