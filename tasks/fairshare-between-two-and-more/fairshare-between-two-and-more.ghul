use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

fairshare(base: int) -> int{} =>
    from(0) |> map(count => digit_sum(count, base) % base)

write_line("the first 25 terms of the fairshare sequence:")

[2, 3, 5, 11]
    |> each(people =>
        write_line(
            "  {people,3} people: "
            "{fairshare(people) |> take(25) |> join(" ")}"
        )
    )
