use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

fairshare(base: int) -> int{} =>
    from(0) |> map(count => digit_sum(count, base) % base)

write_line("the first 25 terms of the fairshare sequence:")

[2, 3, 5, 11]
    |> each(people =>
        write_line(
            "  {people,3} people: "
            "{fairshare(people) |> take(25) |> join(" ")}"
        )
    )
