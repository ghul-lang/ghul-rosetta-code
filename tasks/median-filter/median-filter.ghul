use default
use Raster.IMAGE

pt(x: double, y: double) -> (x: double, y: double) => (x = x, y = y)

scene() -> IMAGE is
    let image = IMAGE(160, 120)

    for y in 0..80 do
        let t = double(y) / 80.0

        image.color(
            ubyte(40.0 + 200.0 * t),
            ubyte(70.0 + 100.0 * t),
            ubyte(160.0 - 60.0 * t)
        )
        image.fill_rectangle(0.0, double(y), 160.0, double(y + 1))
    od

    image.color(255ub, 220ub, 60ub)
    image.disc(112.0, 42.0, 15.0)

    image.color(90ub, 60ub, 120ub)
    image.fill([
        pt(0.0, 80.0),
        pt(45.0, 30.0),
        pt(95.0, 80.0)
    ])

    image.color(60ub, 110ub, 70ub)
    image.fill([
        pt(55.0, 80.0),
        pt(105.0, 48.0),
        pt(160.0, 80.0)
    ])

    image.color(70ub, 150ub, 60ub)
    image.fill_rectangle(0.0, 80.0, 160.0, 120.0)

    image.color(200ub, 35ub, 40ub)
    image.fill_rectangle(22.0, 88.0, 52.0, 110.0)

    image.color(120ub, 25ub, 30ub)
    image.fill([
        pt(18.0, 88.0),
        pt(37.0, 75.0),
        pt(56.0, 88.0)
    ])

    image.color(250ub, 245ub, 235ub)
    image.fill_rectangle(33.0, 97.0, 41.0, 110.0)

    image
si

median_filter(source: IMAGE) -> IMAGE is
    let result = IMAGE(source.width, source.height)

    for y in 0..source.height do
        for x in 0..source.width do
            let window =
                (-1::1)
                    |> flat_map(dy => -1::1 |> map(dx => (dx, dy)))
                    |> map((dx, dy) =>
                        source.pixel(
                            clamp(x + dx, 0, source.width - 1),
                            clamp(y + dy, 0, source.height - 1)
                        )
                    )

            let middle =
                pick =>
                    let sorted = window |> map(pick) |> sort() in
                    (sorted |> list())[4]

            result.set_pixel(
                x,
                y,
                middle(p => p.red),
                middle(p => p.green),
                middle(p => p.blue)
            )
        od
    od

    result
si

let random = System.Random(3)
let noisy = scene()

for _ in 0..1500 do
    let shade = if random.next(2) == 0 then 0ub else 255ub fi

    let x = random.next(noisy.width), y = random.next(noisy.height)

    noisy.set_pixel(x, y, shade, shade, shade)
od

noisy.write("noisy.png")

let source = IMAGE.read("noisy.png")
let cleaned = median_filter(source)

cleaned.write("cleaned.png")

write_line("1500 pixels of salt and pepper, then a 3 x 3 median filter")

source.show("noisy.png")
cleaned.show("cleaned.png")
