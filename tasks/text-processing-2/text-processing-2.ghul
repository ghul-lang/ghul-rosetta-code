use default
use IO.File
use System.StringSplitOptions

let fields_per_record = 49
let instruments = fields_per_record / 2

let records =
    File.read_lines("readings.txt")
        |> map(line =>
            line.split(
                [' ', '\t'],
                StringSplitOptions.REMOVE_EMPTY_ENTRIES))
        |> collect()

let wrong_width =
    records |> count(fields => fields.count != fields_per_record)

let all_good =
    records
        |> count(fields =>
            1::instruments
                |> all(reading => int.parse(fields[reading * 2]) >= 1))

let duplicates =
    records
        |> group_by(fields => fields[0])
        |> filter((_, seen) => seen.count > 1)
        |> map((date, _) => date)
        |> collect()

write_line("{records.count} records read")

if wrong_width == 0 then
    write_line("every record has {fields_per_record} fields")
else
    write_line("{wrong_width} records have some other number of fields")
fi

write_line("{all_good} records have every instrument working")
write_line("{duplicates.count} datestamps appear more than once:")

duplicates |> each(date => write_line("  {date}"))
