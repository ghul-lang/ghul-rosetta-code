use default
use System.Net.Http.HttpClient
use System.Net.Http.StringContent
use System.Text.Encoding
use System.Xml.Linq.XDocument

// The envelope's namespace, which every SOAP message carries.
soap_ns() -> string => "http://schemas.xmlsoap.org/soap/envelope/"

// A call is an XML envelope posted to the service, naming the function in
// the SOAPAction header and in the body; the answer comes back in an
// envelope too.
call(endpoint: string, function: string) -> string is
    let envelope =
        "<soap:Envelope xmlns:soap=\"{soap_ns()}\"><soap:Body>"
        "<{function} xmlns=\"http://example.com/soap/\"/>"
        "</soap:Body></soap:Envelope>"
    let content = StringContent(envelope, Encoding.utf8, "text/xml")

    let action = "\"http://example.com/soap/{function}\""

    content.headers.add("SOAPAction", action)

    let reply = HttpClient().post_async(endpoint, content).result
    let text = reply.content.read_as_string_async().result
    let document = XDocument.parse(text)

    document.descendants()
        |> filter(e => e.name.local_name =~ "{function}Result")
        |> map(e => e.value)
        |> first() ?? "no result"
si

for function in ["soapFunc", "anotherSoapFunc"] do
    let answer = call("http://example.com/soap/wsdl", function)

    write_line("{function}: {answer}")
od
