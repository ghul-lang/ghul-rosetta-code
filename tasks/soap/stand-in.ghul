use default
use System.Net.HttpListener
use System.Net.IPAddress
use System.Net.IPEndPoint
use System.Net.Sockets.TcpListener
use System.Text.Encoding

// The test's entry: answers its own calls on the loopback interface, the
// way the service the task describes would. Not part of the published
// solution.
@entry()
test_entry() is
    let probe = TcpListener(IPAddress.loopback, 0)

    probe.start()

    let port =
        if let bound: IPEndPoint = probe.local_endpoint then
            bound.port
        else throw System.Exception("the probe has no address")
        fi

    probe.stop()

    let prefix = "http://127.0.0.1:{port}/soap/"
    let listener = HttpListener()

    listener.prefixes.add(prefix)
    listener.start()

    Tasks.TASK.run(() is
        for _ in 1::2 do
            let context = listener.get_context()
            let action =
                context.request.headers["SOAPAction"] ?? ""
            let parts = action.trim('"').split(['/'])
            let function = parts[parts.count - 1]
            let reply = Encoding.utf8.get_bytes(
                "<soap:Envelope xmlns:soap=\"{soap_ns()}\"><soap:Body>"
                "<{function}Response xmlns=\"http://example.com/soap/\">"
                "<{function}Result>{function} was called</{function}Result>"
                "</{function}Response></soap:Body></soap:Envelope>"
            )

            context.response.content_type = "text/xml"
            context.response.output_stream.write(
                reply,
                0,
                reply.count
            )
            context.response.close()
        od
    si)

    for function in ["soapFunc", "anotherSoapFunc"] do
        write_line("{function}: {call(prefix, function)}")
    od
si
