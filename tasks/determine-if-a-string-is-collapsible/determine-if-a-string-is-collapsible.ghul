use default

collapsed(text: string) -> char{} is
    let previous mut = null

    for ch in text do
        if !previous? \/ ch != previous then
            yield ch
        fi

        previous = ch
    od
si

collapse(text: string) -> string =>
    collapsed(text) |> map(c => "{c}") |> join("")

let strings = [
    "",
    "\"If I were two-faced, would I be wearing this one?\" "
    "--- Abraham Lincoln ",
    "..111111111111111111111111111111111111111111111111"
    "1111111111111117777888",
    "I never give 'em hell, I just tell the truth, and "
    "they think it's hell. ",
    "                                                   "
    "---  Harry S Truman  "
]

for s in strings do
    let c = collapse(s)

    write_line("original : length = {s.length}, string = <<<{s}>>>")
    write_line("collapsed: length = {c.length}, string = <<<{c}>>>")
    write_line("")
od
