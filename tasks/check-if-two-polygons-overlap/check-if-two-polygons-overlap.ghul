use default
use Raster.IMAGE
use Raster.SHAPES
use Point = (x: double, y: double)
use Polygon = Point[]

⋅(a: Point, b: Point) -> double => a.x * b.x + a.y * b.y

normal(corner: Point, next: Point) -> Point => (
    x = corner.y - next.y,
    y = next.x - corner.x
)

axes(shape: Polygon) -> Point{} =>
    0..shape.count
        |> map(index =>
            normal(shape[index], shape[(index + 1) % shape.count])
        )

spread(polygon: Polygon, axis: Point) -> (low: double, high: double) =>
    let alongs = polygon |> map(corner => corner ⋅ axis) |> list() in
    (alongs |> reduce(alongs[0], min), alongs |> reduce(alongs[0], max))

separated(first: Polygon, second: Polygon, axis: Point) -> bool =>
    let
        (low, high) = spread(first, axis),
        (other_low, other_high) = spread(second, axis)
    in
        high < other_low \/ other_high < low

overlap(first: Polygon, second: Polygon) -> bool =>
    !(axes(first) ++ axes(second) |> any(separated(first, second, *)))

polygon(corners: (double, double)[]) -> Polygon =>
    corners |> map((x, y) => (x = x, y = y)) |> list()

let shapes = [
    (
        name = "A",
        corners = polygon([
            (0.0, 0.0), (0.0, 2.0), (1.0, 4.0),
            (2.0, 2.0), (2.0, 0.0)
        ])
    ),
    (
        name = "B",
        corners = polygon([
            (4.0, 0.0), (4.0, 2.0), (5.0, 4.0),
            (6.0, 2.0), (6.0, 0.0)
        ])
    ),
    (
        name = "C",
        corners = polygon([
            (1.0, 0.0), (1.0, 2.0), (5.0, 4.0),
            (9.0, 2.0), (9.0, 0.0)
        ])
    )
]

for first in 0..shapes.count do
    for second in first + 1..shapes.count do
        let (one, other) = (shapes[first], shapes[second])

        let verdict =
            if overlap(one.corners, other.corners) then
                "overlap"
            else
                "do not overlap"
            fi

        write_line("{one.name} and {other.name} {verdict}")
    od
od

let image = IMAGE(480, 300)

image.view(-1.0, -1.0, 10.0, 5.0)
image.clear(252ub, 250ub, 245ub)

let drawing = SHAPES()

let colors = [
    (60ub, 110ub, 200ub),
    (220ub, 150ub, 60ub),
    (80ub, 170ub, 110ub)
]

for index in 0..shapes.count do
    let (r, g, b) = colors[index]

    drawing.add(
        shapes[index].corners
            |> map(corner => (corner.x, corner.y))
            |> list(),
        r,
        g,
        b
    )
od

image.fill(drawing)

for shape in shapes do
    image.color(40ub, 40ub, 60ub)
    image.text(shape.corners[0].x + 0.1, 4.2, 16.0, shape.name)
od

image.write("polygons.png")

image.show("polygons.png")
