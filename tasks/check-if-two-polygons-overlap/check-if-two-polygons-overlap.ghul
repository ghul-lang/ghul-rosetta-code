use default
use Raster.IMAGE
use Raster.SHAPES
use Point = (x: double, y: double)
use Polygon = Collections.List[Point]

⋅(a: Point, b: Point) -> double => a.x * b.x + a.y * b.y

normal(corner: Point, next: Point) -> Point =>
    (x = corner.y - next.y, y = next.x - corner.x)

axes(shape: Polygon) -> Point{} =>
    0..shape.count
        |> map(index =>
            normal(shape[index], shape[(index + 1) % shape.count]))

spread(polygon: Polygon, axis: Point) -> (low: double, high: double) is
    let alongs = polygon |> map(corner => corner ⋅ axis) |> collect()

    return
        (low = alongs |> reduce(alongs[0], System.Math.min),
         high = alongs |> reduce(alongs[0], System.Math.max))
si

separated(first: Polygon, second: Polygon, axis: Point) -> bool is
    let (low, high) = spread(first, axis)
    let (other_low, other_high) = spread(second, axis)

    return high < other_low \/ other_high < low
si

overlap(first: Polygon, second: Polygon) -> bool =>
    !(axes(first)
        |> cat(axes(second))
        |> any(axis => separated(first, second, axis)))

polygon(corners: List[(double, double)]) -> Polygon =>
    corners |> map((x, y) => (x = x, y = y)) |> collect()

let shapes =
    [(name = "A",
      corners = polygon([(0.0D, 0.0D), (0.0D, 2.0D), (1.0D, 4.0D),
                         (2.0D, 2.0D), (2.0D, 0.0D)])),
     (name = "B",
      corners = polygon([(4.0D, 0.0D), (4.0D, 2.0D), (5.0D, 4.0D),
                         (6.0D, 2.0D), (6.0D, 0.0D)])),
     (name = "C",
      corners = polygon([(1.0D, 0.0D), (1.0D, 2.0D), (5.0D, 4.0D),
                         (9.0D, 2.0D), (9.0D, 0.0D)]))]

for first in 0..shapes.count do
    for second in first + 1..shapes.count do
        let (one, other) = (shapes[first], shapes[second])

        let verdict =
            if overlap(one.corners, other.corners) then
                "overlap"
            else
                "do not overlap"
            fi

        write_line("{one.name} and {other.name} {verdict}")
    od
od

let image = IMAGE(480, 300)

image.view(-1.0D, -1.0D, 10.0D, 5.0D)
image.clear(252ub, 250ub, 245ub)

let drawing = SHAPES()

let colours =
    [(r = 60ub, g = 110ub, b = 200ub),
     (r = 220ub, g = 150ub, b = 60ub),
     (r = 80ub, g = 170ub, b = 110ub)]

for index in 0..shapes.count do
    let (r, g, b) = colours[index]

    drawing.add(
        shapes[index].corners
            |> map(corner => (corner.x, corner.y))
            |> collect(),
        r, g, b)
od

image.fill(drawing)

for shape in shapes do
    image.colour(40ub, 40ub, 60ub)
    image.text(shape.corners[0].x + 0.1D, 4.2D, 16.0D, shape.name)
od

image.write("polygons.png")

image.show("polygons.png")
