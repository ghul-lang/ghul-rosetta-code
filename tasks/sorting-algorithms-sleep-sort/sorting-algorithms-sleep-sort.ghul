// Each value waits its own amount of real time before printing, so the
// values emerge in ascending order.

use default
use Ghul.Coroutines

let values = [5, 3, 8, 0, 1, 9, 2, 7]

emit(value: int) -> COROUTINE is
    await sleep(value * 50)
    write_line("{value}")
si

for value in values do
    emit(value)
od

run()
