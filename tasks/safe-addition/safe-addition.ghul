use default

struct INTERVAL(low: double public, high: double public)

// The rounding error of a + b is recovered exactly, as the difference
// between the sum and what each operand contributed to it. Its sign says
// which side of the exact sum the rounded one fell.
safe_add(a: double, b: double) -> INTERVAL is
    let sum = a + b
    let b_part = sum - a
    let error = (a - (sum - b_part)) + (b - b_part)

    if error > 0.0 then
        INTERVAL(sum, System.Math.bit_increment(sum))
    elif error < 0.0 then
        INTERVAL(System.Math.bit_decrement(sum), sum)
    else
        INTERVAL(sum, sum)
    fi
si

for
    (a, b) in [
        (1.14, 2000.0),
        (0.1, 0.2),
        (1.0, 1.0e-20),
        (0.5, 0.25)
    ]
do
    let interval = safe_add(a, b)

    write_line("{a:R} + {b:R}")
    write_line("    in [{interval.low:R}, {interval.high:R}]")
od
