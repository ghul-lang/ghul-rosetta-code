use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `yield` makes the function a generator: it returns a lazy `T{}`.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

anti_primes() -> int{} is
    let most mut = 0
    let n mut = 1

    do
        let divisors = divisor_count(n)

        if divisors > most then
            most = divisors

            yield n
        fi

        n = n + 1
    od
si

write_line(anti_primes() |> take(20) |> join(" "))
