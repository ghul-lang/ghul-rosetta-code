use default

smallest_prime_factor(n) is
    let i mut = 2

    while i * i <= n do
        if n % i == 0 then
            return i
        fi

        i = i + 1
    od

    n
si

largest_proper_divisor(n) =>
    if n == 1 then 1 else n / smallest_prime_factor(n) fi

let divisors = 1::100 |> map(n => "{largest_proper_divisor(n)}") |> join()

write_line(divisors)
