use default

use Graph = List[SET[int]]

graph(n: int, edges: Iterable[(int, int)]) -> Graph is
    let adjacency = 0..n |> map(_ => SET()) |> collect()

    for (u, v) in edges do
        adjacency[u].add(v)
        adjacency[v].add(u)
    od

    adjacency
si

closure(g: Graph) -> Graph is
    let n = g.count
    let h = g |> map(neighbours => SET(neighbours)) |> collect()
    let changed mut = true

    while changed do
        changed = false

        for u in 0..n do
            for v in u + 1..n do
                if !h[u].contains(v) /\ h[u].count + h[v].count >= n then
                    h[u].add(v)
                    h[v].add(u)
                    changed = true
                fi
            od
        od
    od

    h
si

is_complete(g: Graph) -> bool => g |> all(s => s.count == g.count - 1)

hamiltonian_cycle(g: Graph) -> List[int]? is
    let path = LIST([0])

    extend() is
        let last = path[path.count - 1]

        if path.count == g.count then
            return g[last].contains(0)
        fi

        for next in g[last] |> sort() do
            if !path.contains(next) then
                path.add(next)

                if extend() then
                    return true
                fi

                path.remove_at(path.count - 1)
            fi
        od

        false
    si

    if extend() then path else null fi
si

show_neighbours(g: Graph) =>
    for (v, neighbours) in g |> index() do
        write_line("    {v}: {neighbours |> sort() |> join(" ")}")
    od

test(name: string, g: Graph) is
    write_line("{name}")
    write_line("  degrees: {g |> map(s => s.count) |> join(" ")}")
    write_line("  closure:")

    let h = closure(g)
    show_neighbours(h)

    if is_complete(h) then
        write_line("  closure is complete, so the graph is Hamiltonian")
    else
        write_line("  closure is not complete, so the test is inconclusive")
    fi

    if let cycle = hamiltonian_cycle(g) then
        write_line("  a cycle: {cycle |> join(" -> ")} -> 0")
    else
        write_line("  a search finds no Hamiltonian cycle")
    fi

    write_line()
si

let k5_less_one_edge =
    [(u, v) for u in 0..5 for v in u + 1..5 if (u, v) !~ (0, 1)]

test("K5 without the edge 0-1", graph(5, k5_less_one_edge))
test("A cycle of 5", graph(5, [(0, 1), (1, 2), (2, 3), (3, 4), (4, 0)]))
test("A path of 5", graph(5, [(0, 1), (1, 2), (2, 3), (3, 4)]))
