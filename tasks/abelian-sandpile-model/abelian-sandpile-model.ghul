use default
use Raster.IMAGE

let around = [(-1, 0), (1, 0), (0, -1), (0, 1)]

settle(pile: MATRIX_2[int]) is
    let (rows, columns) = pile.lengths
    let unstable mut = true

    while unstable do
        unstable = false

        for y in 0..rows do
            for x in 0..columns do
                if pile[y, x] >= 4 then
                    let spilled = pile[y, x] / 4

                    pile[y, x] = pile[y, x] - 4 * spilled

                    for (dy, dx) in around do
                        let (ny, nx) = (y + dy, x + dx)

                        if ny >= 0 /\ ny < rows /\ nx >= 0 /\ nx < columns then
                            pile[ny, nx] = pile[ny, nx] + spilled
                        fi
                    od

                    unstable = true
                fi
            od
        od
    od
si

settled(size: int, grains: int) -> int[,] => (
    let pile = repeat(0) |> MATRIX(size, size)

    pile[size / 2, size / 2] = grains
    settle(pile)

    pile
)

show(grains: int) is
    write_line("{grains} grains:")

    for row in settled(5, grains) do
        write_line("  {row |> join(" ")}")
    od
si

let shades = [
    (red = 30ub, green = 30ub, blue = 60ub),
    (red = 70ub, green = 130ub, blue = 180ub),
    (red = 240ub, green = 200ub, blue = 80ub),
    (red = 200ub, green = 70ub, blue = 50ub)
]

show(4)
show(6)
show(16)

let big = settled(201, 20000)
let (height, width) = big.lengths

let image = IMAGE(width, height)

for y in 0..height do
    for x in 0..width do
        let shade = shades[big[y, x]]

        image.set_pixel(x, y, shade.red, shade.green, shade.blue)
    od
od

image.write("sandpile.png")

image.show("sandpile.png")
