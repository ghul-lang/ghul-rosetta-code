use default

let random = System.Random(12345)

dice5() -> int => random.next(1, 6)

dice7() -> int is
    do
        let roll = 5 * (dice5() - 1) + dice5() - 1

        if roll < 21 then
            return roll % 7 + 1
        fi
    od
si

check_distribution(
    generate: () -> int, calls: int, tolerance: double
) -> bool is
    let counts =
        (0..calls)
        |> map(_ => generate())
        |> group_by(value => value)
        |> map(entry => (entry.key, entry.value.count))
        |> collect_map()

    let expected = double(calls) / double(counts.count)
    let uniform mut = true

    for value in counts.keys |> sort() do
        let difference = double(counts[value]) - expected
        let deviation = System.Math.abs(difference) / expected

        let flag = if deviation > tolerance then "  NOT UNIFORM" else "" fi
        write_line("{value}: {counts[value],8}{flag}")

        uniform = uniform /\ deviation <= tolerance
    od

    return uniform
si

let uniform = check_distribution(dice7, 1_000_000, 0.01)

write_line(
    if uniform then
        "every face is within 1% of the expected count"
    else
        "the distribution is not uniform"
    fi)
