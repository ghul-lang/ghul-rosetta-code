use default
use System.Math

arithmetic(values: double[]) -> double =>
    let total = values |> sum() in
    total / cast(values.count)


geometric(values: double[]) -> double =>
    Math.pow(values |> product(), 1.0 / cast(values.count))

harmonic(values: double[]) -> double =>
    let reciprocals =
        values |> reduce(0.0, (running, v) => running + 1.0 / v) in
    cast(values.count) / reciprocals


let one_to_ten = 1::10 |> map(n => double(n)) |> collect()

let a = arithmetic(one_to_ten)
let g = geometric(one_to_ten)
let h = harmonic(one_to_ten)

write_line("arithmetic {a}")
write_line("geometric  {g}")
write_line("harmonic   {h}")
write_line("A >= G >= H holds: {a >= g /\ g >= h}")
