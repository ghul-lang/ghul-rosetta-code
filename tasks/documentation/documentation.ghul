use default

/// A point in the plane.
///
/// - x: the distance along the horizontal axis
/// - y: the distance along the vertical axis
class POINT(x: double, y: double) is
    /// How far the point is from the origin.
    length() -> double => double.sqrt(x * x + y * y)
si

/// The point halfway between `a` and `b`.
///
/// - a: one end of the line
/// - b: the other end
midpoint(a, b) =>
    POINT((a.x + b.x) / 2.0, (a.y + b.y) / 2.0)

write_line("{POINT(3.0, 4.0).length()}")
let middle = midpoint(POINT(0.0, 0.0), POINT(6.0, 8.0))

write_line("{middle.x}, {middle.y}")
