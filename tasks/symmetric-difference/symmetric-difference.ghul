use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `SET()` builds its collection eagerly
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

only_in(left: SET[string], right: SET[string]) -> string{} =>
    left |> filter(name => !right.contains(name))

show(label: string, names: string{}) =>
    let listed = names |> join() in
    write_line("{label}: {listed}")

let a = SET(["John", "Serena", "Bob", "Mary", "Serena"])
let b = SET(["Jim", "Mary", "John", "Jim", "Bob"])

show("only in A", only_in(a, b))
show("only in B", only_in(b, a))
show("symmetric difference", only_in(a, b) ++ only_in(b, a))
