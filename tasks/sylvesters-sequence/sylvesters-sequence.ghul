use default

sylvester(count: int) -> bigint{} is
    let term mut = 2n

    for _ in 1::count do
        yield term
        term = term * term - term + 1n
    od
si

gcd(a: bigint, b: bigint) -> bigint =>
    if b.is_zero then a else gcd(b, a % b) fi

let terms = sylvester(10) |> collect()

write_line("first ten terms:")

for term in terms do
    write_line("  {term}")
od

let numerator mut = 0n
let denominator mut = 1n

for term in terms do
    numerator = numerator * term + denominator
    denominator = denominator * term
od

let common = gcd(numerator, denominator)

write_line("")
write_line("sum of the reciprocals of the first ten:")
write_line("  numerator   {numerator / common}")
write_line("  denominator {denominator / common}")
