use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read

sylvester(count: int) -> bigint{} is
    let term mut = 2n

    for _ in 1::count do
        yield term
        term = term * term - term + 1n
    od
si

let terms = sylvester(10) |> list()

write_line("first ten terms:")

for term in terms do
    write_line("  {term}")
od

let (numerator, denominator) =
    terms |> reduce((0n, 1n), ((n, d), term) => (n * term + d, d * term))

let common = gcd(numerator, denominator)

write_line("")
write_line("sum of the reciprocals of the first ten:")
write_line("  numerator   {numerator / common}")
write_line("  denominator {denominator / common}")
