use default

let scratch = IO.Path.combine(
    IO.Path.get_temp_path(),
    "rosetta-create-a-file"
)

IO.Directory.create_directory(scratch)
IO.Directory.set_current_directory(scratch)

outcome(create: () -> void) -> string is
    try
        create()
        return "created"
    catch e: System.Exception
        return "refused"
    yrt
si

discard(remove: () -> void) is
    try
        remove()
    catch e: System.Exception
    yrt
si

for where in ["", "/"] do
    let file = "{where}output.txt"
    let directory = "{where}docs"

    write_line(
        "{file}: {outcome(() => IO.File.write_all_text(file, ""))}"
    )
    write_line(
        "{directory}: "
        "{outcome(() => IO.Directory.create_directory(directory))}"
    )

    discard(() => IO.File.delete(file))
    discard(() => IO.Directory.delete(directory))
od

IO.Directory.set_current_directory(IO.Path.get_temp_path())
IO.Directory.delete(scratch, true)
