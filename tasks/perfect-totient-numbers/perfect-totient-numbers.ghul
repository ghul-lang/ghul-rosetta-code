use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity
// `memo` on a function caches its results - a call with arguments equal to
//  an earlier call's returns the cached result, recursive calls included

totient_sum(value: int) -> int memo =>
    if value > 1 then
        let next = totient(value) in
        next + totient_sum(next)
    else
        0
    fi

perfect_totients(count: int) -> int{} =>
    from(2) |> filter(c => totient_sum(c) == c) |> take(count)

let terms = perfect_totients(20) |> map(term => "{term}")

write_line("the first twenty perfect totient numbers:")
write_line(terms |> join(" "))
