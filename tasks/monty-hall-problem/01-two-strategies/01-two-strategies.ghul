use default

let random = System.Random(2026)

let rounds = 100000

play() -> (car: int, chosen: int, opened: int, switched: int) is
    let car = random.next(3)
    let chosen = random.next(3)

    let opened mut = random.next(3)

    while opened == chosen \/ opened == car do
        opened = random.next(3)
    od

    let switched =
        (0::2 |> find(door => door != chosen /\ door != opened))!

    (car = car, chosen = chosen, opened = opened, switched = switched)
si

write_line("the first three games")

for _ in 1::3 do
    let game = play()

    write_line(
        "  car behind {game.car}, player picks {game.chosen}, "
        "host opens {game.opened}, switching gives {game.switched}")
od

let stay_wins mut = 0
let switch_wins mut = 0

for _ in 1::rounds do
    let game = play()

    if game.chosen == game.car then
        stay_wins = stay_wins + 1
    fi

    if game.switched == game.car then
        switch_wins = switch_wins + 1
    fi
od

percentage(wins: int) -> string =>
    "{double(wins) * 100.0 / double(rounds),5:F2}%"

write_line("over {rounds} games")
write_line("  staying  wins {percentage(stay_wins)}")
write_line("  switching wins {percentage(switch_wins)}")
