use default
use Raster.AXES
use Raster.IMAGE

// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

let random = System.Random(2026)

let rounds = 10000

let staying = LIST()
let switching = LIST()

let stay_wins mut = 0
let switch_wins mut = 0

for trial in 1::rounds do
    let car = random.next(3)
    let chosen = random.next(3)

    let opened mut = random.next(3)

    while opened == chosen \/ opened == car do
        opened = random.next(3)
    od

    let switched = (0::2 |> find(door => door != chosen /\ door != opened))!

    if chosen == car then
        stay_wins = stay_wins + 1
    fi

    if switched == car then
        switch_wins = switch_wins + 1
    fi

    staying.add(double(stay_wins) / double(trial))
    switching.add(double(switch_wins) / double(trial))
od

curve(rates: double[]) -> (x: double, y: double)[] =>
    rates
        |> index()
        |> map(rate => (x = log10(double(rate.index + 1)), y = rate.value))
        |> list()

let stay_color = (red = 210ub, green = 130ub, blue = 40ub)
let switch_color = (red = 40ub, green = 85ub, blue = 165ub)

let image = IMAGE(760, 460)

image.color(95ub, 100ub, 115ub)
image.stroke(1.0)

let axes = AXES(image)

axes.x_title = "games played"
axes.y_title = "win rate"

axes.x_ticks(
    (0::4)
        |> map(decade => (
            value = double(decade),
            label = "{pow(10.0, double(decade))}"
        ))
        |> list()
)

axes.y_ticks([
    (value = 0.0, label = "0"),
    (value = 1.0 / 3.0, label = "1/3"),
    (value = 0.5, label = "1/2"),
    (value = 2.0 / 3.0, label = "2/3"),
    (value = 1.0, label = "1")
])

axes.key("switching", switch_color)
axes.key("staying", stay_color)

axes.fit(0.0, 0.0, 4.0, 1.0)
axes.draw()

image.color(195ub, 200ub, 210ub)

for line in [1.0 / 3.0, 2.0 / 3.0] do
    image.line(0.0, line, 4.0, line)
od

image.stroke(1.4)

image.color(stay_color)
image.line(curve(staying))

image.color(switch_color)
image.line(curve(switching))

image.write("monty-hall.png")

image.show("monty-hall.png")
