use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `LIST()` builds its collection eagerly
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

let limit = 1_000_000
let totient = LIST(limit + 1)

0::limit |> each(totient.add)

for prime in 2::limit do
    if totient[prime] == prime then
        let multiple mut = prime

        while multiple <= limit do
            totient[multiple] = totient[multiple] / prime * (prime - 1)
            multiple = multiple + prime
        od
    fi
od

sharing_a_factor() -> long{} is
    let coprime_total mut = 0L

    for count in 1::limit do
        coprime_total = coprime_total + long(totient[count])

        yield long(count) * cast(count - 1) / 2L + 1L - coprime_total
    od
si

let terms = sharing_a_factor() |> list()

write_line("the first 100 terms:")

terms
    |> take(100)
    |> chunk(10)
    |> each(row => write_line(row |> map(term => "{term,5}") |> join("")))

write_line()

[1_000, 10_000, 100_000, 1_000_000]
    |> each(count => write_line("a({count,9:N0}) = {terms[count - 1]:N0}"))
