use default

// `STACK[T]` is a mutable last-in, first-out stack
// `==` compares identity

let plates = STACK()

plates.push("bottom")
plates.push("middle")
plates.push("top")

write_line("depth: {plates.count}")
write_line("peek:  {plates.peek()}")

while plates.count > 0 do
    write_line("pop:   {plates.pop()}")
od

write_line("empty: {plates.count == 0}")
