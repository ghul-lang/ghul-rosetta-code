use default
use Raster.IMAGE

let size = 480
let centre = double(size) / 2.0
let radius = 208.0

let ambient = 0.14
let shine = 28.0

let towards_light = (
    let x = -0.45
    let y = 0.55
    let z = 0.70

    let length = sqrt(x * x + y * y + z * z)

    (x = x / length, y = y / length, z = z / length)
)

channel(base: double, level: double, gloss: double) -> ubyte => (
    let value = base * level + 255.0 * gloss

    ubyte(min(255.0, max(0.0, value)))
)

let image = IMAGE(size, size)

for down in 0..size do
    for across in 0..size do
        let x = (double(across) + 0.5 - centre) / radius
        let y = (centre - double(down) - 0.5) / radius
        let square = x * x + y * y

        if square <= 1.0 then
            let z = sqrt(1.0 - square)

            let lambert =
                x * towards_light.x +
                y * towards_light.y +
                z * towards_light.z

            let level = ambient + 0.9 * max(0.0, lambert)

            let gloss = pow(
                max(0.0, 2.0 * lambert * z - towards_light.z),
                shine
            )

            image.set_pixel(
                across,
                down,
                channel(70.0, level, gloss),
                channel(130.0, level, gloss),
                channel(235.0, level, gloss)
            )
        fi
    od
od

image.write("sphere.png")

image.show("sphere.png")
