use default
use IO.Std.read_line

let masses = MAP()

for line in IO.File.read_all_lines("masses.txt") do
    let fields = line.split([' '])

    masses[fields[0]] =
        decimal.parse(
            fields[1], System.Globalization.CultureInfo.invariant_culture)
od

class FORMULA(text: string) is
    _at: int

    more: bool => _at < text.length

    count() -> int is
        let start = _at

        while more /\ char.is_digit(text[_at]) do
            _at = _at + 1
        od

        if _at == start then 1
        else int.parse(text.substring(start, _at - start))
        fi
    si

    element() -> decimal is
        let start = _at

        _at = _at + 1

        while more /\ char.is_lower(text[_at]) do
            _at = _at + 1
        od

        let symbol = text.substring(start, _at - start)

        if !masses.contains_key(symbol) then
            throw System.ArgumentException("unknown element {symbol}")
        fi

        masses[symbol]
    si

    group() -> decimal is
        let total mut = 0m

        while more /\ text[_at] != ')' do
            let part =
                if text[_at] == '(' then
                    _at = _at + 1

                    let inside = group()

                    _at = _at + 1
                    inside
                else
                    element()
                fi

            total = total + part * decimal(count())
        od

        total
    si
si

while let formula = read_line() do
    let mass = FORMULA(formula).group()

    write_line("{formula,-20} {mass,10:F3}")
od
