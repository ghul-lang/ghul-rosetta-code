use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `=~` compares values (structural equality) - `==` compares identity

pollard_rho(value: bigint, budget: int) -> bigint? is
    let slow mut = 2n
    let fast mut = 2n
    let divisor mut = 1n

    for _ in 0..budget do
        slow = (slow * slow + 1n) % value
        fast = (fast * fast + 1n) % value
        fast = (fast * fast + 1n) % value
        divisor = gcd(slow - fast, value)

        if divisor !~ 1n then
            return if divisor =~ value then null else divisor fi
        fi
    od

    return null
si

factors(value: bigint) -> bigint{} is
    if is_prime(value) then
        yield value
    elif let divisor = pollard_rho(value, 1_000_000) then
        yield in factors(divisor)
        yield in factors(value / divisor)
    else
        yield value
    fi
si

fermat(index: int) -> bigint => bigint.pow(2n, 1 << index) + 1n

write_line("the first ten Fermat numbers:")

for index in 0..10 do
    write_line("F{index} = {fermat(index)}")
od

write_line("")
write_line("prime factors:")

for index in 0..8 do
    let value = fermat(index)
    let found = value |> factors() |> list()
    let shown = found |> map(f => "{f}") |> join(" * ")
    let note =
        if is_prime(value) then " (prime)"
        elif found.count == 1 then " (no factor found)"
        else ""
        fi

    write_line("F{index} = {shown}{note}")
od
