use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

equilibrium_indices(values: int[]) -> int{} is
    let total = values |> sum()
    let below mut = 0

    for index in 0..values.count do
        if below * 2 + values[index] == total then
            yield index
        fi

        below = below + values[index]
    od
si

let sequence = [-7, 1, 5, 2, -4, 3, 0]

let indices =
    sequence
        |> equilibrium_indices()
        |> map(index => "{index}")
        |> join(" ")

write_line("equilibrium indices: {indices}")
