use default

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `*` as an argument leaves that parameter open: partial application.

dot(left: int[], right: int[]) -> int is
    assert left.count == right.count else "vectors must be the same length"

    return left |> zip(right, * * *) |> sum()
si

write_line("{dot([1, 3, -5], [4, -2, -1])}")
