use default

positions(pieces: string, piece: char) -> List[int] =>
    pieces
        |> index()
        |> filter((_, p) => p == piece)
        |> map((i, _) => i)
        |> collect()

without(pieces: string, removed: string) -> string =>
    pieces |> filter(p => !removed.contains(p)) |> join("")

let knight_pairs =
    [(first, second) for first in 0::4 for second in first + 1::4]

sp_id(pieces: string) -> int =>
    let
        knights = positions(without(pieces, "QB"), 'N'),
        n = knight_pairs |> find_index(* =~ (knights[0], knights[1]))!,
        q = without(pieces, "B").index_of('Q'),
        bishops = positions(pieces, 'B'),
        dark = bishops |> find(b => b % 2 == 0)! / 2,
        light = bishops |> find(b => b % 2 == 1)! / 2
    in
        96 * n + 16 * q + 4 * dark + light

let symbols = "KQRBN" |> zip("♔♕♖♗♘") |> collect_map()

for pieces in ["QNRBBNKR", "RNBQKBNR", "RQNBBKRN", "RNQBBKRN"] do
    let shown = pieces |> map(p => symbols[p]) |> join("")

    write_line("{pieces} {shown}: {sp_id(pieces)}")
od
