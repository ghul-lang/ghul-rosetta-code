use default

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `MAP()` builds its collection eagerly
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`
// `=~` compares values (structural equality) - `==` compares identity

positions(pieces: string, piece: char) -> int[] =>
    pieces
        |> index()
        |> filter((_, p) => p == piece)
        |> map((i, _) => i)
        |> list()

without(pieces: string, removed: string) -> string =>
    pieces |> filter(p => !removed.contains(p)) |> join("")

let knight_pairs = [
    (first, second)
    for first in 0::4
    for second in first + 1::4
]

sp_id(pieces: string) -> int =>
    let
        knights = positions(without(pieces, "QB"), 'N'),
        n = knight_pairs |> find_index(* =~ (knights[0], knights[1]))!,
        q = without(pieces, "B").index_of('Q'),
        bishops = positions(pieces, 'B'),
        dark = bishops |> find(b => b % 2 == 0)! / 2,
        light = bishops |> find(b => b % 2 == 1)! / 2
    in
        96 * n + 16 * q + 4 * dark + light

let symbols = "KQRBN" |> zip("♔♕♖♗♘") |> MAP()

for pieces in ["QNRBBNKR", "RNBQKBNR", "RQNBBKRN", "RNQBBKRN"] do
    let shown = pieces |> map(p => symbols[p]) |> join("")

    write_line("{pieces} {shown}: {sp_id(pieces)}")
od
