use default

is_curzon(base: int, n: int) -> bool =>
    let
        divisor = bigint(base * n + 1),
        big_base = bigint(base)
    in
        let power = bigint.mod_pow(big_base, bigint(n), divisor) in
        (power + 1n) % divisor =~ 0n

curzon_numbers(base: int) -> int{} => from(1) |> filter(is_curzon(base, *))

for base in [2, 4, 6, 8, 10] do
    write_line("generalized Curzon numbers with base {base}:")

    curzon_numbers(base)
        |> take(50)
        |> chunk(10)
        |> each(row => write_line(row |> map(n => "{n,5}") |> join("")))

    let thousandth = (curzon_numbers(base) |> skip(999) |> first())!

    write_line("the one thousandth: {thousandth}")
    write_line("")
od
