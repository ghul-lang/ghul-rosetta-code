use default

// `=~` compares values (structural equality) - `==` compares identity
// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

is_curzon(base: int, n: int) -> bool =>
    let
        divisor = bigint(base * n + 1),
        big_base = bigint(base)
    in
        let power = bigint.mod_pow(big_base, bigint(n), divisor) in
        (power + 1n) % divisor =~ 0n

curzon_numbers(base: int) -> int{} => from(1) |> filter(is_curzon(base, *))

for base in [2, 4, 6, 8, 10] do
    write_line("generalized Curzon numbers with base {base}:")

    let first_50 = curzon_numbers(base) |> take(50) |> list()

    for row in 0..5 do
        let cells =
            (0..10) |> map(column => "{first_50[row * 10 + column],5}")

        write_line(cells |> join(""))
    od

    let thousandth = (curzon_numbers(base) |> skip(999) |> first())!

    write_line("the one thousandth: {thousandth}")
    write_line("")
od
