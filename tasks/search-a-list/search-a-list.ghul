use default

let haystack = [
    "Zig", "Zag", "Wally", "Ronald", "Bush", "Krusty", "Charlie", "Bush",
    "Bozo"
]

positions(needle: string) -> int{} =>
    haystack |> index()
        |> filter(e => e.value =~ needle)
        |> map(e => e.index)

missing(needle: string) -> int =>
    throw Ghul.Exception("{needle} is not in the haystack")

first_index(needle: string) -> int =>
    positions(needle) |> first() ?? missing(needle)

last_index(needle: string) -> int =>
    positions(needle) |> take_last(1) |> first() ?? missing(needle)

for needle in ["Bush", "Washington"] do
    try
        let (first, last) = (first_index(needle), last_index(needle))
        write_line("{needle}: first at {first}, last at {last}")
    catch e: Ghul.Exception
        write_line(e.message)
    yrt
od
