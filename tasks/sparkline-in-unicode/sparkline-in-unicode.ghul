use default
use System.StringSplitOptions

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`
// `==` compares identity

let bars = "▁▂▃▄▅▆▇█"

let separators = [' ', ',', '\t']

bar(value: double, lowest: double, span: double) -> char =>
    if span == 0.0 then
        bars[0]
    else
        bars[int((value - lowest) * 7.999 / span)]
    fi

sparkline(series: string) -> string is
    let values =
        series.split(separators, StringSplitOptions.REMOVE_EMPTY_ENTRIES)
            |> map(double.parse)

    let ordered = values |> sort() |> list()

    let lowest = ordered[0]
    let highest = ordered[ordered.count - 1]
    let span = highest - lowest

    write_line("min {lowest}, max {highest}")

    return string(values |> map(bar(*, lowest, span)))
si

for
    series in [
        "1 2 3 4 5 6 7 8 7 6 5 4 3 2 1",
        "1.5, 0.5 3.5, 2.5 5.5, 4.5 7.5, 6.5",
        "0, 1, 19, 20",
        "0, 999, 4000, 4999, 7000, 7999"
    ]
do
    write_line(sparkline(series))
    write_line("")
od
