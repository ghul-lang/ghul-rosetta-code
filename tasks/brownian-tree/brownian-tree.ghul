use Collections.SET
use Raster.IMAGE

let size = 240
let particles = 8000

let random = System.Random(987654321)

let tree = SET()

touches(x: int, y: int) -> bool =>
    (let found mut = false

     for across in -1..2 do
         for up in -1..2 do
             if tree.contains((x = x + across, y = y + up)) then
                 found = true
             fi
         od
     od

     found)

let image = IMAGE(size, size)

image.set_pixel(size / 2, size / 2, 0ub, 0ub, 0ub)
tree.add((x = size / 2, y = size / 2))

for particle in 0..particles do
    let x mut = random.next(size)
    let y mut = random.next(size)

    while !touches(x, y) do
        x = (x + random.next(3) - 1 + size) % size
        y = (y + random.next(3) - 1 + size) % size
    od

    tree.add((x = x, y = y))

    let age = ubyte(255 * particle / particles)

    image.set_pixel(x, y, age, 40ub, 255ub - age)
od

image.write("brownian.png")

image.show("brownian.png")
