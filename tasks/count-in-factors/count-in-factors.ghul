use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `==` compares identity
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence

factors(n: int) -> int{} is
    let remaining mut = n
    let divisor mut = 2

    while divisor * divisor <= remaining do
        while remaining % divisor == 0 do
            yield divisor
            remaining = remaining / divisor
        od

        divisor = divisor + 1
    od

    if remaining > 1 then
        yield remaining
    fi
si

describe(n: int) -> string =>
    if n == 1 then
        "1"
    else
        n |> factors() |> map(f => "{f}") |> join(" x ")
    fi

for n in 1::25 do
    write_line("{n}: {describe(n)}")
od

write_line("{2144}: {describe(2144)}")
