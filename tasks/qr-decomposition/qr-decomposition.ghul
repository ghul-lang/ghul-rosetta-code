use default

use Rows = double[][]
use Table = LIST[LIST[double]]

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `LIST()` builds its collection eagerly
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

zeros(rows: int, columns: int) -> Table =>
    0..rows |> map(_ => repeat(0.0, columns) |> LIST()) |> LIST()

identity(size: int) -> Table => (
    let result = zeros(size, size)

    for i in 0..size do
        result[i][i] = 1.0
    od

    result
)

multiply(a: Rows, b: Rows) -> Table is
    let result = zeros(a.count, b[0].count)

    for i in 0..a.count do
        for j in 0..b[0].count do
            result[i][j] = 0..b.count |> sum_by(k => a[i][k] * b[k][j])
        od
    od

    result
si

transpose(a: Rows) -> Rows =>
    0..a[0].count
        |> map(j => 0..a.count |> map(i => a[i][j]) |> list())
        |> list()

householder(a: Rows, k: int) -> Table is
    let m = a.count
    let column = k..m |> map(i => a[i][k]) |> list()
    let norm = System.Math.sqrt(column |> sum_by(x => x * x))
    let sign = if column[0] < 0.0 then -1.0 else 1.0 fi
    let first = column[0] + sign * norm
    let v =
        0..column.count
            |> map(i => if i == 0 then 1.0 else column[i] / first fi)
            |> list()
    let beta = 2.0 / (v |> sum_by(x => x * x))
    let h = identity(m)

    for i in 0..v.count do
        for j in 0..v.count do
            h[k + i][k + j] = h[k + i][k + j] - beta * v[i] * v[j]
        od
    od

    h
si

decompose(a: Rows) -> (q: Table, r: Table) => (
    let m = a.count
    let n = a[0].count
    let q mut = identity(m)
    let r mut = multiply(a, identity(n))

    for k in 0 .. if m - 1 < n then m - 1 else n fi do
        let h = householder(r, k)

        q = multiply(q, h)
        r = multiply(h, r)
    od

    (q, r)
)

least_squares(a: Rows, b: double[]) -> double{} => (
    let (q, r) = decompose(a)
    let n = a[0].count
    let column = b |> map(y => LIST([y])) |> list()
    let qtb = multiply(transpose(q), column)
    let x = repeat(0.0, n) |> LIST()

    for i in (0..n) |> reverse() do
        let known = i + 1..n |> sum_by(j => r[i][j] * x[j])

        x[i] = (qtb[i][0] - known) / r[i][i]
    od

    x
)

show(name: string, matrix: Rows) is
    write_line("{name}:")

    for row in matrix do
        write_line(row |> map(x => "{x,10:F3}") |> join(""))
    od

    write_line("")
si

let a = [
    [12.0, -51.0, 4.0],
    [6.0, 167.0, -68.0],
    [-4.0, 24.0, -41.0]
]
    |> map(LIST)
    |> list()

let (q, r) = decompose(a)

show("Q", q)
show("R", r)
show("Q R", multiply(q, r))

let xs = 0::10 |> map(double)
let ys = [
    1.0, 6.0, 17.0, 34.0, 57.0, 86.0, 121.0, 162.0, 209.0, 262.0, 321.0
]
let design = xs |> map(x => LIST([1.0, x, x * x])) |> list()

let fit = least_squares(design, LIST(ys))

write_line("Fitting y = a + bx + cx² to the polynomial regression data:")
write_line(fit |> map(c => "{c:F6}") |> join("  "))
