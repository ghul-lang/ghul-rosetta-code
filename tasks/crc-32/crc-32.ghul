use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.
// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.

let table =
    (0..256)
        |> map(n =>
            0..8
                |> reduce(uint(n), (c, _) =>
                    if (c & 1u) != 0u then
                        0xEDB88320u ^ (c >> 1)
                    else
                        c >> 1
                    fi
                )
        )
        |> list()

crc32(data: ubyte[]) -> uint =>
    let step = (crc, b) => table[int((crc ^ uint(b)) & 0xFFu)] ^ (crc >> 8)
    in
    (data |> reduce(0xFFFFFFFFu, step)) ^ 0xFFFFFFFFu

let text = "The quick brown fox jumps over the lazy dog"
let bytes = System.Text.Encoding.ascii.get_bytes(text)

write_line("{text}")
write_line("{crc32(bytes),0:X8}")
