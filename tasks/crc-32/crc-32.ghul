use default

let table = (0..256)
    |> map(n => 0..8 |> reduce(uint(n), (c, _) =>
        if (c & 1u) != 0u then 0xEDB88320u ^ (c >> 1) else c >> 1 fi))
    |> collect()

crc32(data: ubyte[]) -> uint is
    let step = (crc, b) =>
        table[int((crc ^ uint(b)) & 0xFFu)] ^ (crc >> 8)

    (data |> reduce(0xFFFFFFFFu, step)) ^ 0xFFFFFFFFu
si

let text = "The quick brown fox jumps over the lazy dog"
let bytes = System.Text.Encoding.ascii.get_bytes(text)

write_line("{text}")
write_line("{crc32(bytes),0:X8}")
