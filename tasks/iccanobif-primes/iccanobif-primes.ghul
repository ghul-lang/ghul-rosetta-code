use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `yield` makes the function a generator: it returns a lazy `T{}`.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

fibonacci() -> bigint{} is
    let previous mut = 0n
    let current mut = 1n

    while true do
        yield current
        let following = previous + current
        previous = current
        current = following
    od
si

reversed(value: bigint) -> bigint => (
    let digits = value.to_string().to_char_array()

    System.Array.reverse(digits)

    bigint.parse(string(digits))
)

let iccanobif =
    fibonacci() |> map(reversed) |> filter(is_prime) |> take(15) |> list()

write_line("the first 10 iccanobif primes:")
write_line(iccanobif |> take(10) |> map(p => "{p}") |> join(" "))
write_line("")
write_line("digit counts of the next 5:")
write_line(iccanobif |> skip(10) |> map(p => "{"{p}".length}") |> join(" "))
