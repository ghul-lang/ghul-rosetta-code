use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

fibonacci() -> bigint{} is
    let previous mut = 0n
    let current mut = 1n

    while true do
        yield current
        let following = previous + current
        previous = current
        current = following
    od
si

reversed(value: bigint) -> bigint => (
    let digits = value.to_string().to_char_array()

    System.Array.reverse(digits)

    bigint.parse(string(digits))
)

let iccanobif =
    fibonacci() |> map(reversed) |> filter(is_prime) |> take(15) |> list()

write_line("the first 10 iccanobif primes:")
write_line(iccanobif |> take(10) |> map(p => "{p}") |> join(" "))
write_line("")
write_line("digit counts of the next 5:")
write_line(iccanobif |> skip(10) |> map(p => "{"{p}".length}") |> join(" "))
