use default

is_prime(n: int) -> bool =>
    n > 1 /\ (n == 2 \/ n % 2 == 1 /\
        from(3) |> take_while(d => d * d <= n) |> all(d => n % d != 0))

reverse(n: int) -> int is
    walk(m: int, r: int) -> int =>
        if m == 0 then r else walk(m / 10, r * 10 + m % 10) fi

    walk(n, 0)
si

is_emirp(n: int) -> bool =>
    let r = reverse(n) in
    r != n /\ is_prime(n) /\ is_prime(r)

emirps() -> int{} => from(2) |> filter(is_emirp)

write_line("first 20 emirps: {emirps() |> take(20) |> join()}")

write_line("emirps between 7700 and 8000: {7700::8000 |> filter(is_emirp) |> join()}")

write_line("10000th emirp: {emirps() |> skip(9999) |> first()!}")
