use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence

class NODE[T](value: T) is
    next: NODE[T]?

    insert_after(value: T) -> NODE[T] is
        let inserted = NODE(value)

        inserted.next = next
        next = inserted

        inserted
    si
si

values[T](first: NODE[T]) -> T{} is
    let cursor mut = first

    while let node = cursor do
        yield node.value
        cursor = node.next
    od
si

let first = NODE(1)
first.insert_after(2).insert_after(3)

for value in values(first) do
    write_line(value)
od
