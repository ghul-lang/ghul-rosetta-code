use default
use Raster.Anchor
use Raster.IMAGE
use System.Math.*

let cases = [
    27, 27, 27, 44, 44, 59, 59, 59, 59, 59, 59, 59, 59, 60, 60, 61, 61,
    66, 83, 219, 239, 392, 534, 631, 897, 1350, 2023, 2820, 4587, 6067,
    7823, 9826, 11946, 14554, 17372, 20615, 24522, 28273, 31491, 34933,
    37552, 40540, 43105, 45177, 60328, 64543, 67103, 69265, 71332, 73327,
    75191, 75723, 76719, 77804, 78812, 79339, 80132, 80995, 82101, 83365,
    85203, 87024, 89068, 90664, 93077, 95316, 98172, 102133, 105824,
    109695, 114232, 118610, 125497, 133852, 143227, 151367, 167418,
    180096, 194836, 213150, 242364, 271106, 305117, 338133, 377918,
    416845, 468049, 527767, 591704, 656866, 715353, 777796, 851308,
    928436, 1000249, 1082054, 1174652
]

let start = 27.0D
let population = 7.8e9

model(r: double, t: double) -> double =>
    let growth = exp(r * t) in
    start * growth / (1.0D + start * (growth - 1.0D) / population)

error(r: double) -> double =>
    cases
        |> index()
        |> map(c => model(r, double(c.index)) - double(c.value))
        |> sum_by(d => d * d)

golden_section(low: double, high: double) -> double is
    let ratio = (sqrt(5.0D) - 1.0D) / 2.0D
    let a mut = low, b mut = high

    while b - a > 1.0e-12 do
        let c = b - ratio * (b - a)
        let d = a + ratio * (b - a)

        if error(c) < error(d) then b = d else a = c fi
    od

    (a + b) / 2.0D
si

let r = golden_section(0.0D, 0.5D)

write_line("the r that fits the world Covid-19 data best is {r:F8}")
write_line("so R0 is roughly e^(12r) = {exp(12.0D * r):F7}")

let image = IMAGE(420, 280)
let days = double(cases.count)

image.view(-16.0D, 0.8D, days + 2.0D, 6.6D)
image.clear(252ub, 250ub, 245ub)

image.colour(215ub, 215ub, 220ub)
image.stroke(1.0D)

for power in 1::6 do
    image.line(0.0D, double(power), days, double(power))
od

image.colour(90ub, 90ub, 100ub)

for power in 1::6 do
    let y = double(power) - 0.07D

    image.text(-2.0D, y, 10.0D, "1e{power}", Anchor.RIGHT)
od

image.colour(200ub, 60ub, 40ub)
image.stroke(2.0D)
image.line(
    (0::cases.count * 4)
        |> map(q => double(q) / 4.0D)
        |> map(t => (x = t, y = log10(model(r, t))))
        |> collect())

image.colour(40ub, 80ub, 170ub)

for (day, count) in cases |> index() do
    image.dot(double(day), log10(double(count)), 2.5D)
od

image.write("fit.png")

image.show("fit.png")
