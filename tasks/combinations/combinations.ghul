use default

choose(
    m: int,
    n: int,
    from: int,
    chosen: List[int]
) -> List[int]{} is
    if chosen.count == m then
        yield chosen

        return
    fi

    for candidate in from..n do
        let extended = chosen ++ [candidate] |> collect()
        yield in choose(m, n, candidate + 1, extended)
    od
si

combinations(m: int, n: int) -> List[int]{} =>
    choose(m, n, 0, [])

for combination in combinations(3, 5) do
    write_line(combination |> join(" "))
od
