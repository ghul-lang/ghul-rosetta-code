use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity
// `if let` pattern-matches, and `[x, ..rest]` matches a list head and tail

union Huffman(weight: int) is
    LEAF(symbol: char, ..)
    NODE(left: Huffman, right: Huffman, ..)
si

use Huffman.LEAF
use Huffman.NODE

take_lightest(pending: LIST[Huffman]) -> Huffman is
    let lightest = pending |> min_by(node => node.weight)!

    pending.remove(lightest)

    lightest
si

build_tree(leaves: Huffman[]) -> Huffman => (
    let pending = LIST(leaves)

    while pending.count > 1 do
        let first = take_lightest(pending)
        let second = take_lightest(pending)

        pending.add(NODE(first, second, first.weight + second.weight))
    od

    pending[0]
)

codes(node: Huffman, prefix: string) -> (
    symbol: char,
    weight: int,
    code: string
){} is
    if let leaf: LEAF = node then
        let code = if prefix.length == 0 then "0" else prefix fi

        yield (symbol = leaf.symbol, weight = leaf.weight, code = code)
    elif let branch: NODE = node then
        yield in codes(branch.left, "{prefix}0")
        yield in codes(branch.right, "{prefix}1")
    fi
si

let text = "this is an example for huffman encoding"

let weights = text |> frequencies()

let leaves =
    weights.keys
        |> sort()
        |> map(symbol => LEAF(symbol, weights[symbol]))
        |> list()

let table =
    codes(build_tree(leaves), "")
        |> sort((left, right) =>
            if left.weight != right.weight then
                right.weight - left.weight
            else
                int(left.symbol) - int(right.symbol)
            fi
        )

write_line("symbol  weight  code")

for entry in table do
    let symbol = "'{entry.symbol}'"

    write_line("{symbol,-6}  {entry.weight,6}  {entry.code}")
od
