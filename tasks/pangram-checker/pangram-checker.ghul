use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

is_pangram(sentence: string) -> bool =>
    sentence
        |> map(char.to_lower)
        |> filter(char.is_letter)
        |> distinct()
        |> count() == 26

write_line("{is_pangram("The quick brown fox jumps over the lazy dog")}")
write_line("{is_pangram("Hello, World!")}")
