use default
use System.Net.IPAddress
use System.Net.Sockets.TcpClient
use System.Net.Sockets.TcpListener
use System.Threading.Thread

let port = 8080

serve(client: TcpClient) is
    let stream = client.get_stream()
    let reader = IO.StreamReader(stream)
    let writer = IO.StreamWriter(stream)

    writer.auto_flush = true

    let request = reader.read_line() ?? ""

    while let header = reader.read_line() do
        if header.length == 0 then
            break
        fi
    od

    write_line("serving {request}")

    let body = "Goodbye, World!\n"

    writer.write(
        "HTTP/1.1 200 OK\r\n"
        "Content-Type: text/plain\r\n"
        "Content-Length: {body.length}\r\n"
        "Connection: close\r\n"
        "\r\n"
        "{body}"
    )

    client.dispose()
si

let listener = TcpListener(IPAddress.loopback, port)

listener.start()

let serving = Thread(() is
    let served mut = 0

    while served < 2 do
        let client = listener.accept_tcp_client()

        served = served + 1

        serve(client)
    od
si)

serving.start()

fetch(path: string) is
    let client = TcpClient("127.0.0.1", port)
    let stream = client.get_stream()
    let writer = IO.StreamWriter(stream)

    writer.auto_flush = true
    writer.write(
        "GET {path} HTTP/1.1\r\nHost: localhost\r\n\r\n"
    )

    let lines =
        IO.StreamReader(stream).read_to_end().split(['\n'])
            |> map(line => line.trim_end())
            |> collect()

    write_line(lines[0])

    let body =
        lines
            |> filter(line => line.length > 0)
            |> reduce("", (_, line) => line)

    write_line(body)

    client.dispose()
si

fetch("/")
fetch("/again")

serving.join()
listener.stop()
