use Ghul.Pipes
use Raster.IMAGE
use Ghul.Math

let turns = 5.0
let steps = 2000

let last = turns * 2.0 * pi

at(angle: double) -> (x: double, y: double) => (
    x = angle * cos(angle),
    y = angle * sin(angle)
)

let image = IMAGE(400, 400)

image.view(-last, -last, last, last)

image.color(0ub, 0ub, 160ub)
image.stroke(1.5)

image.line(
    (0..steps + 1)
        |> map(step => at(last * double(step) / double(steps)))
        |> list()
)

image.write("spiral.png")

image.show("spiral.png")
