use Ghul.Pipes
use Raster.IMAGE
use System.Math.*

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

let turns = 5.0D
let steps = 2000

let last = turns * 2.0D * pi

at(angle: double) -> (x: double, y: double) => (
    x = angle * cos(angle),
    y = angle * sin(angle)
)

let image = IMAGE(400, 400)

image.view(-last, -last, last, last)

image.colour(0ub, 0ub, 160ub)
image.stroke(1.5D)

image.line(
    (0..steps + 1)
        |> map(step => at(last * double(step) / double(steps)))
        |> list()
)

image.write("spiral.png")

image.show("spiral.png")
