use Ghul.Pipes
use Raster.IMAGE
use Ghul.Math

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

let turns = 5.0D
let steps = 2000

let last = turns * 2.0D * pi

at(angle: double) -> (x: double, y: double) => (
    x = angle * cos(angle),
    y = angle * sin(angle)
)

let image = IMAGE(400, 400)

image.view(-last, -last, last, last)

image.colour(0ub, 0ub, 160ub)
image.stroke(1.5D)

image.line(
    (0..steps + 1)
        |> map(step => at(last * double(step) / double(steps)))
        |> list()
)

image.write("spiral.png")

image.show("spiral.png")
