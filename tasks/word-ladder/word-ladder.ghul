use default

let words = IO.File.read_lines("unixdict.txt") |> collect_set()

neighbours(word: string) -> string{} =>
    (0..word.length)
    |> flat_map(i =>
        ('a'::'z')
        |> filter(* != word[i])
        |> map(c => "{word[0..i]}{c}{word[i + 1..<0]}"))
    |> filter(words.contains)

path_back(previous: MAP[string, string], start: string, word: string)
    -> Collections.List[string] =>
    if word =~ start then
        LIST([start])
    else
        (path_back(previous, start, previous[word]) ++ [word])
            |> collect()
    fi

ladder(start: string, goal: string) -> Collections.List[string]? is
    let previous = MAP()
    let queue = Collections.Queue()

    previous[start] = start
    queue.enqueue(start)

    while queue.count > 0 do
        let word = queue.dequeue()

        if word =~ goal then
            return path_back(previous, start, goal)
        fi

        for next in neighbours(word) do
            if !previous.contains_key(next) then
                previous[next] = word
                queue.enqueue(next)
            fi
        od
    od

    return null
si

for (start, goal) in [
    ("boy", "man"), ("girl", "lady"), ("john", "jane"), ("child", "adult"),
    ("cat", "dog"), ("lead", "gold"), ("white", "black")
] do
    if let path = ladder(start, goal) then
        write_line(path |> join(" -> "))
    else
        write_line("{start} cannot be turned into {goal}")
    fi
od
