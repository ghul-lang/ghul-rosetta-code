use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `SET[T]` is a mutable set, holding each element once
// `MAP[K, V]` is a mutable map from keys to values
// `QUEUE[T]` is a mutable first-in, first-out queue
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|> SET()` reads the whole sequence into a new `SET`
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`
// `=~` compares values (structural equality) - `==` compares identity
// `if let` pattern-matches, and `[x, ..rest]` matches a list head and tail

let words = IO.File.read_lines("unixdict.txt") |> SET()

neighbours(word: string) -> string{} =>
    (0..word.length)
        |> flat_map(i =>
            ('a'::'z')
                |> filter(* != word[i])
                |> map(c => "{word[0..i]}{c}{word[i + 1..<0]}")
        )
        |> filter(words.contains)

path_back(
    previous: MAP[string, string],
    start: string,
    word: string
) -> string[] =>
    if word =~ start then
        LIST([start])
    else
        (path_back(previous, start, previous[word]) ++ [word]) |> list()
    fi

ladder(start: string, goal: string) -> string[]? is
    let previous = MAP()
    let queue = QUEUE()

    previous[start] = start
    queue.enqueue(start)

    while queue.count > 0 do
        let word = queue.dequeue()

        if word =~ goal then
            return path_back(previous, start, goal)
        fi

        for next in neighbours(word) do
            if !previous.contains_key(next) then
                previous[next] = word
                queue.enqueue(next)
            fi
        od
    od

    return null
si

for
    (start, goal) in [
        ("boy", "man"), ("girl", "lady"), ("john", "jane"),
        ("child", "adult"),
        ("cat", "dog"), ("lead", "gold"), ("white", "black")
    ]
do
    if let path = ladder(start, goal) then
        write_line(path |> join(" -> "))
    else
        write_line("{start} cannot be turned into {goal}")
    fi
od
