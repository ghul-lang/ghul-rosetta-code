use default

let treatment = [85, 88, 75, 66, 25, 29, 83, 39, 97]
let control = [68, 41, 10, 49, 16, 65, 32, 92, 28, 98]

let everyone = cat(treatment, control) |> collect()
let total = everyone |> sum()
let n = treatment.count
let m = control.count

// The difference in means scaled by n * m, so it stays an integer.
difference(treated: int) -> int => treated * m - (total - treated) * n

let observed = difference(treatment |> sum())
let at_most mut = 0
let above mut = 0

choose(start: int, left: int, treated: int) is
    if left == 0 then
        if difference(treated) <= observed then
            at_most = at_most + 1
        else
            above = above + 1
        fi
    else
        for i in start::everyone.count - left do
            choose(i + 1, left - 1, treated + everyone[i])
        od
    fi
si

choose(0, n, 0)

let groupings = double(at_most + above)

write_line("{at_most + above} alternative groupings")
percent(count: int) -> double => 100.0 * double(count) / groupings

write_line("difference <= observed: {percent(at_most):F4}%")
write_line("difference  > observed: {percent(above):F4}%")
