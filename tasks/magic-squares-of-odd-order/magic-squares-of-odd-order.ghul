use default

magic_square(n: int) -> int{} is
    let cells =
        repeat(0, n * n) |> collect_mutable()

    let row mut = 0
    let column mut = n / 2

    for value in 1::(n * n) do
        cells[row * n + column] = value

        let next_row = (row + n - 1) % n
        let next_column = (column + 1) % n

        if cells[next_row * n + next_column] == 0 then
            row = next_row
            column = next_column
        else
            row = (row + 1) % n
        fi
    od

    cells
si

let n = 5
let square = magic_square(n)
let magic_number = n * (n * n + 1) / 2

write_line("5 by 5 magic square, magic number {magic_number}:")
square |> chunk(n)
    |> each(row => write_line(row |> map(value => "{value,3}") |> join("")))
