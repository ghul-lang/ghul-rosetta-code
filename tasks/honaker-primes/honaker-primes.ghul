use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

honakers() -> (position: int, prime: int){} =>
    primes()
        |> index()
        |> map(((i, prime)) => (position = i + 1, prime = prime))
        |> filter(h => digit_sum(h.position) == digit_sum(h.prime))

write_line("the first fifty Honaker primes:")

let first_fifty = honakers() |> take(50) |> list()

for row in 0..10 do
    let cells =
        first_fifty[row * 5..row * 5 + 5]
            |> map(h => "{h.position,7}:{h.prime,8}")

    write_line(cells |> join(""))
od

let ten_thousandth = honakers() |> skip(9999) |> first()

write_line("")
write_line(
    "the ten thousandth is at position {ten_thousandth!.position}, "
    "and is {ten_thousandth.prime}"
)
