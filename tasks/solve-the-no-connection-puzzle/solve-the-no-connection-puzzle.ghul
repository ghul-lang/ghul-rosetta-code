use default
use System.Math

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `if let` and `case ... when` pattern-match; `[x, ..rest]` matches a list.

let connections = [
    (from = 0, to = 2), (from = 0, to = 3), (from = 0, to = 4),
    (from = 1, to = 3), (from = 1, to = 4), (from = 1, to = 5),
    (from = 2, to = 3), (from = 2, to = 6),
    (from = 3, to = 4), (from = 3, to = 6), (from = 3, to = 7),
    (from = 4, to = 5), (from = 4, to = 6), (from = 4, to = 7),
    (from = 5, to = 7)
]

peaceful(pegs: int[]) -> bool =>
    connections
        |> all(line => Math.abs(pegs[line.from] - pegs[line.to]) > 1)

draw(pegs: int[]) is
    write_line("      {pegs[0]}   {pegs[1]}")
    write_line("     /|\\ /|\\")
    write_line("    / | X | \\")
    write_line("   /  |/ \\|  \\")
    write_line("  {pegs[2]}---{pegs[3]}---{pegs[4]}---{pegs[5]}")
    write_line("   \\  |\\ /|  /")
    write_line("    \\ | X | /")
    write_line("     \\|/ \\|/")
    write_line("      {pegs[6]}   {pegs[7]}")
si

let pegs = 1::8

if let solution = pegs |> permutations() |> find(peaceful) then
    write_line("one solution:")

    draw(solution)
fi

let total = pegs |> permutations() |> filter(peaceful) |> count()

write_line()
write_line("solutions in all: {total}")
