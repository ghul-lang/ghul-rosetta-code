use default

// `T[]` is the read-only list trait - elements can be read by index
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read, and `count` reads it all

kolakoski(values: int[], length: int) -> int[] is
    let cycled = () is
        do
            yield in values
        od
    si

    let sequence = LIST()
    let at_run mut = 0

    for value in cycled() do
        sequence.add(value)

        for _ in 1 .. sequence[at_run] do
            sequence.add(value)
        od

        at_run = at_run + 1

        if sequence.count >= length then
            break
        fi
    od

    return sequence[0..length]
si

run_lengths(sequence: int[]) -> int[] =>
    sequence |> group() |> map(run => run.count) |> list()

self_describing(sequence: int[]) -> bool => (
    let runs = run_lengths(sequence)
    0..runs.count - 1 |> all(i => runs[i] == sequence[i])
)

report(values: int[], length: int) is
    let sequence = kolakoski(values, length)

    write_line("from ({values |> join(", ")}), first {length}:")
    write_line("  {sequence |> join(", ")}")
    write_line("  self-describing: {self_describing(sequence)}")
si

report([1, 2], 20)
report([2, 1], 20)
report([1, 3, 1, 2], 30)
report([1, 3, 2, 1], 30)
