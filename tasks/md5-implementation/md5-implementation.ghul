use default
use System.Math.*

let shifts = [
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
]

let sines =
    0..64
        |> map(step =>
            uint(
                floor(
                    abs(sin(double(step + 1))) * 4294967296.0D
                )
            )
        )
        |> collect()

rotate_left(value: uint, count: int) -> uint =>
    (value << count) | (value >>> (32 - count))

padded(message: ubyte[]) -> List[ubyte] is
    let bits = ulong(message.count) * 8ul

    let block = LIST(message)

    block.add(0x80ub)

    while block.count % 64 != 56 do
        block.add(0ub)
    od

    for byte_index in 0..8 do
        block.add(ubyte((bits >>> (8 * byte_index)) & 0xFFul))
    od

    return block
si

word(block: List[ubyte], at: int) -> uint =>
    0..4
        |> map(byte_index =>
            uint(block[at + byte_index]) << (8 * byte_index)
        )
        |> reduce(0u, (bits, more) => bits | more)

md5(message: ubyte[]) -> string is
    let block = padded(message)

    let state = LIST([
        0x67452301u, 0xEFCDAB89u, 0x98BADCFEu, 0x10325476u
    ])

    let start mut = 0

    while start < block.count do
        let words =
            0..16
                |> map(index => word(block, start + index * 4))
                |> collect()

        let a mut = state[0]
        let b mut = state[1]
        let c mut = state[2]
        let d mut = state[3]

        for step in 0..64 do
            let (mixed, index) =
                if step < 16 then
                    ((b & c) | (\b & d), step)
                elif step < 32 then
                    ((d & b) | (\d & c), (5 * step + 1) % 16)
                elif step < 48 then
                    (b ^ c ^ d, (3 * step + 5) % 16)
                else
                    (c ^ (b | \d), (7 * step) % 16)
                fi

            let rotated = rotate_left(
                a + mixed + sines[step] + words[index],
                shifts[step]
            )

            a = d
            d = c
            c = b
            b = b + rotated
        od

        state[0] = state[0] + a
        state[1] = state[1] + b
        state[2] = state[2] + c
        state[3] = state[3] + d

        start = start + 64
    od

    return [
        "{(value >>> (8 * index)) & 0xFFu:x2}"
        for value in state
        for index in 0..4
    ]
        |> join("")
si

let tests = [
    ("", "d41d8cd98f00b204e9800998ecf8427e"),
    ("a", "0cc175b9c0f1b6a831c399e269772661"),
    ("abc", "900150983cd24fb0d6963f7d28e17f72"),
    ("message digest", "f96b697d7cb7938d525a2f31aaf161d0"),
    ("abcdefghijklmnopqrstuvwxyz", "c3fcd3d76192e4007dfb496cca67e13b"),
    (
        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789",
        "d174ab98d277d9f5a5611c2c9f419d9f"
    ),
    (
        "1234567890123456789012345678901234567890"
        "1234567890123456789012345678901234567890",
        "57edf4a22be3c955ac49da2e2107b67a"
    )
]

for (message, expected) in tests do
    let digest = md5(
        System.Text.Encoding.utf8.get_bytes(message)
    )

    assert digest =~ expected
        else "does not agree with RFC 1321"

    write_line("{digest}  \"{message}\"")
od
