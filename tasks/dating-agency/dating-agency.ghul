use default

struct LADY(name: string) is
    is_nice: bool => name |> sum_by(c => int(c)) % 2 == 0
si

last_letter(name: string) -> int => int(name[name.length - 1])

struct SAILOR(name: string) is
    finds_lovable(lady: LADY) -> bool =>
        last_letter(name) % 2 == last_letter(lady.name) % 2
si

struct AGENCY(ladies: List[LADY]) is
    suggestions: LADY{} => ladies |> filter(lady => lady.is_nice)
si

let agency = AGENCY(
    [
        "Ada", "Beatrice", "Cora", "Delia", "Edith",
        "Flora", "Grace", "Hazel", "Iris", "Juno"
    ] |> map(name => LADY(name)) |> collect()
)

let sailor = SAILOR("Popeye")

let suggested = agency.suggestions |> map(lady => lady.name)

let dated = agency.suggestions
    |> filter(lady => sailor.finds_lovable(lady))
    |> map(lady => lady.name)

write_line("The agency suggests: {suggested |> join(", ")}")
write_line("{sailor.name} offers to date: {dated |> join(", ")}")
