use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `T[]` is the read-only list trait - elements can be read by index
// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `T{}` is a lazy sequence of `T`, read by iterating it.

struct LADY(name: string) is
    is_nice: bool => name |> sum_by(int) % 2 == 0
si

last_letter(name: string) -> int => int(name[name.length - 1])

struct SAILOR(name: string) is
    finds_lovable(lady: LADY) -> bool =>
        last_letter(name) % 2 == last_letter(lady.name) % 2
si

struct AGENCY(ladies: LADY[]) is
    suggestions: LADY{} => ladies |> filter(lady => lady.is_nice)
si

let agency = AGENCY(
    [
        "Ada", "Beatrice", "Cora", "Delia", "Edith",
        "Flora", "Grace", "Hazel", "Iris", "Juno"
    ]
        |> map(LADY)
        |> list()
)

let sailor = SAILOR("Popeye")

let suggested = agency.suggestions |> map(lady => lady.name)

let dated =
    agency.suggestions
        |> filter(sailor.finds_lovable(*))
        |> map(lady => lady.name)

write_line("The agency suggests: {suggested |> join(", ")}")
write_line("{sailor.name} offers to date: {dated |> join(", ")}")
