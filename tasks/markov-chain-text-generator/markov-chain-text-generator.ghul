use default
use Collections

suffixes(words: string[], size: int)
    -> (by_prefix: MAP[string, LIST[string]], prefixes: LIST[string])
is
    let by_prefix = MAP[string, LIST[string]]()
    let prefixes = LIST[string]()

    for at in size::words.count do
        let prefix = words[(at - size)..at] |> join(" ")

        if !by_prefix.contains_key(prefix) then
            by_prefix[prefix] = LIST[string]()
            prefixes.add(prefix)
        fi

        if at < words.count then
            by_prefix[prefix].add(words[at])
        fi
    od

    (by_prefix = by_prefix, prefixes = prefixes)
si

generate(
    by_prefix: Map[string, LIST[string]],
    start: string,
    length: int,
    random: System.Random
) -> string
is
    let out = LIST[string](start.split([' ']))
    let size = out.count

    while out.count < length do
        let prefix = out[(out.count - size)..out.count] |> join(" ")
        let choices = by_prefix[prefix]

        if choices.count == 0 then
            break
        fi

        out.add(choices[random.next(0, choices.count)])
    od

    out |> join(" ")
si

wrap(text: string, width: int) -> string{} is
    let line = System.Text.StringBuilder()

    for word in text.split([' ']) do
        if line.length > 0 /\ line.length + 1 + word.length > width then
            yield line.to_string()

            line.clear()
        fi

        if line.length > 0 then
            line.append(' ')
        fi

        line.append(word)
    od

    if line.length > 0 then
        yield line.to_string()
    fi
si

let example = "now he is gone she said he is gone for good"
let built = suffixes(example.split([' ']), 2)

write_line("prefixes of \"{example}\", key 2")
write_line("")

for prefix in built.prefixes do
    let words_after = built.by_prefix[prefix] |> join()

    write_line("  {prefix,-10} {words_after}".trim_end())
od

let path = if args.count > 0 then args[0] else "alice.txt" fi
let size = if args.count > 1 then int.parse(args[1]) else 2 fi
let length = if args.count > 2 then int.parse(args[2]) else 60 fi

let words = IO.File.read_all_text(path).split([' ', '\n', '\r', '\t'])
let corpus = words |> filter(w => w.length > 0) |> collect()
let source = suffixes(corpus, size)
let random = System.Random(2026)
let start = source.prefixes[random.next(0, source.prefixes.count)]

write_line("")
write_line(
    "{length} words from {path}, key {size},"
    " starting \"{start}\"")
write_line("")

for line in wrap(generate(source.by_prefix, start, length, random), 68) do
    write_line("  {line}")
od
