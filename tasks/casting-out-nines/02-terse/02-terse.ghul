use default
co9(x) => if x < 10L then x else co9(x |> digits() |> sum()) fi
fast(x, b) =>
    let r = x % (b - 1L) in if r == 0L /\ x > 0L then b - 1L else r fi
write_line("part 1: digit-sum checksum")
[318682L, 101558217124L, 65536L, 999999999L]
    |> each(x => write_line("  co9({x}) = {co9(x)}"))
write_line("part 2: k where co9(k) = co9(k^2), for k in 1L::100L")
let ks1 = 1L::100L |> filter(k => co9(k) == co9(k * k)) |> list()
write_line(
    "  {ks1.count} of 100 numbers: {ks1 |> map(k => "{k}") |> join()}"
)
write_line("part 3: fast mod-based checksum, base 10")
[318682L, 101558217124L, 65536L, 999999999L]
    |> each(x =>
        write_line(
            "  co9_fast({x}, 10) = {fast(x, 10L)}, matches part 1: {fast(x, 10L) == co9(x)}"
        )
    )
write_line(
    "part 3: generalised to base 16, k where k mod 15 = k^2 mod 15, for k in 1L::100L"
)
let ks2 =
    1L::100L |> filter(k => fast(k, 16L) == fast(k * k, 16L)) |> list()
write_line(
    "  {ks2.count} of 100 numbers: {ks2 |> map(k => "{k}") |> join()}"
)
