use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`
// `==` compares identity

class ENVIRONMENT(value: int public, count: int public)

hailstone_step(env: ENVIRONMENT) is
    if env.value != 1 then
        env.value =
            if env.value % 2 == 0 then
                env.value / 2
            else 3 * env.value + 1
            fi

        env.count = env.count + 1
    fi
si

let environments = (1..13) |> map(ENVIRONMENT(*, 0)) |> list()

while !(environments |> all(env => env.value == 1)) do
    environments |> each(hailstone_step)
    write_line(environments |> map(env => "{env.value}") |> join(" "))
od

write_line(environments |> map(env => "{env.count}") |> join(" "))
