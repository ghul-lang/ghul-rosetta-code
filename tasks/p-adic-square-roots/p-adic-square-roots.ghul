use default

floor_div(a: bigint, b: bigint) -> bigint =>
    let q = a / b in
    if (a % b !~ 0n) /\ ((a < 0n) != (b < 0n)) then q - 1n else q fi

modulo(a: bigint, m: bigint) -> bigint => ((a % m) + m) % m

inverse(value: bigint, m: bigint) -> bigint is
    let (r0, r1) mut = (modulo(value, m), m)
    let (s0, s1) mut = (1n, 0n)

    while r1 !~ 0n do
        let q = r0 / r1

        (r0, r1) = (r1, r0 - q * r1)
        (s0, s1) = (s1, s0 - q * s1)
    od

    modulo(s0, m)
si

without_p(n: bigint, p: bigint) -> (rest: bigint, count: int) is
    let rest mut = n
    let count mut = 0

    while rest !~ 0n /\ rest % p =~ 0n do
        rest = rest / p
        count = count + 1
    od

    (rest, count)
si

show(digits: List[bigint], exponent: int) -> string =>
    let text = digits |> reverse() |> map(d => "{d}") |> join("") in
    if exponent >= 0 then
        "...{text}{string('0', exponent)}.0"
    else
        let split = text.length + exponent in
        "...{text.substring(0, split)}.{text.substring(split)}"
    fi

to_digits(n: bigint, p: bigint, k: int) -> List[bigint] =>
    0..k |> map(i => n / bigint.pow(p, i) % p) |> collect()

// the rational a/b nearest to n modulo p^k, by Gauss lattice reduction

rational(n: bigint, p: bigint, k: int) -> (top: bigint, bottom: bigint) is
    dot(u, w) =>
        u.`0 * w.`0 + u.`1 * w.`1

    let u mut = (bigint.pow(p, k), 0n)
    let w mut = (n, 1n)

    do
        let ww = dot(w, w)
        let q = floor_div(2n * dot(u, w) + ww, 2n * ww)
        let t = (u.`0 - q * w.`0, u.`1 - q * w.`1)

        if dot(t, t) >= ww then
            break
        fi

        (u, w) = (w, t)
    od

    if w.`1 < 0n then (-w.`0, -w.`1) else w fi
si

// every residue modulo p^j whose square is u modulo p^j, one digit at a
// time; for p = 2 a square root is only settled from three digits up

square_roots(u: bigint, p: bigint, digits: int) -> List[bigint] is
    let start = if p =~ 2n then 3 else 1 fi
    let modulus mut = bigint.pow(p, start)

    let roots mut =
        0..int(modulus)
            |> map(r => bigint(r))
            |> filter(r => modulo(r * r - u, modulus) =~ 0n)
            |> collect_mutable()

    for _ in start..digits do
        let step = modulus

        modulus = modulus * p

        roots =
            [r + bigint(t) * step
                for r in roots for t in 0..int(p)]
                |> filter(r => modulo(r * r - u, modulus) =~ 0n)
                |> collect_set()
                |> sort()
                |> collect_mutable()
    od

    roots
si

let examples = [
    (2n, 20, 497n, 10496n), (5n, 14, 86n, 25n), (7n, 10, -19n, 1n)
]

for (p, k, a, b) in examples do
    write_line("Number: {a} / {b} in {p}-adic")

    let (top, above) = without_p(a, p)
    let (bottom, below) = without_p(b, p)
    let valuation = above - below

    if valuation % 2 != 0 then
        write_line("    no square root: odd valuation\n")
        continue
    fi

    let precision = k + 3
    let modulus = bigint.pow(p, precision)
    let u = modulo(top * inverse(bottom, modulus), modulus)
    let roots = square_roots(u, p, precision)

    if roots.count == 0 then
        write_line("    no square root: not a square modulo {p}\n")
        continue
    fi

    let root = roots[0] % bigint.pow(p, k)
    let negated = modulo(-root, bigint.pow(p, k))
    let exponent = valuation / 2

    write_line("    the two square roots are:")
    write_line("        {show(to_digits(root, p, k), exponent)}")
    write_line("        {show(to_digits(negated, p, k), exponent)}")

    let square = modulo(root * root, bigint.pow(p, k))
    let (n, d) = rational(square, p, k)
    let scale = bigint.pow(p, int.abs(valuation))
    let (num, den) =
        if valuation >= 0 then (n * scale, d) else (n, d * scale) fi
    let common = bigint.greatest_common_divisor(num, den)

    let shown = show(to_digits(square, p, k), valuation)

    write_line("    the square of a root is {shown}")
    let (numerator, denominator) = (num / common, den / common)

    write_line("    which is the rational {numerator} / {denominator}\n")
od
