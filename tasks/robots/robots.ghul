use default
use IO.Std.read_line
use System.Math.*

let width = 30
let height = 12

let random = System.Random(9)

use Spot = (x: int, y: int)

let keys = ["y", "k", "u", "h", "w", "l", "b", "j", "n"]

anywhere() -> Spot => (
    x = random.next(width),
    y = random.next(height)
)

let player mut = anywhere()
let robots = LIST()
let junk = SET()

while robots.count < 8 do
    let spot = anywhere()

    if spot !~ player /\ !(robots |> any(r => r =~ spot)) then
        robots.add(spot)
    fi
od

toward(from: int, to: int) -> int => sign(to - from)

draw() is
    write_line("+{"".pad_right(width, '-')}+")

    for y in 0..height do
        let row =
            0..width
                |> map(x =>
                    let spot = (x = x, y = y) in
                    if spot =~ player then "@"
                    elif junk.contains(spot) then "*"
                    elif robots |> any(r => r =~ spot) then "+"
                    else " "
                    fi
                )

        write_line("|{row |> join("")}|")
    od

    write_line("+{"".pad_right(width, '-')}+")
si

write_line(
    "escape the robots (+) by making them crash into each other"
)
write_line(
    "move with y k u / h w l / b j n, w to wait, t to teleport"
)

let alive mut = true

while alive /\ robots.count > 0 do
    write_line()
    draw()
    write_line("{robots.count} robots left")

    let line = read_line()

    if !line? then
        break
    fi

    let key = line.trim()

    write_line("> {key}")

    if key =~ "t" then
        player = anywhere()
    elif let index = 0..9 |> find(i => keys[i] =~ key) then
        let next = (
            x = clamp(player.x + index % 3 - 1, 0, width - 1),
            y = clamp(player.y + index / 3 - 1, 0, height - 1)
        )

        if junk.contains(next) then
            write_line("junk is in the way")
            continue
        fi

        player = next
    else
        write_line(
            "move with y k u h l b j n, w to wait, t to teleport"
        )
        continue
    fi

    let moved =
        robots
            |> map(r => (
                x = r.x + toward(r.x, player.x),
                y = r.y + toward(r.y, player.y)
            ))
            |> collect()

    robots.clear()

    for r in moved do
        let crowded =
            moved |> filter(o => o =~ r) |> count() > 1

        if crowded \/ junk.contains(r) then
            junk.add(r)
        else
            robots.add(r)
        fi
    od

    if
        robots |> any(r => r =~ player) \/ junk.contains(player)
    then
        alive = false
    fi
od

write_line()
draw()

if !alive then
    write_line("a robot got you")
elif robots.count == 0 then
    write_line("every robot is junk - you escaped")
fi
