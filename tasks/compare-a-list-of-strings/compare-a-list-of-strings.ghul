use default

all_equal(strings: List[string]) -> bool =>
    strings |> windows(2) |> all(pair => pair[0] =~ pair[1])

strictly_ascending(strings: List[string]) -> bool =>
    strings |> windows(2) |> all(pair => pair[0] < pair[1])

let lists = [
    ["AA", "AA", "AA", "AA"],
    ["AA", "ACB", "BB", "CC"],
    ["AA", "CC", "BB"],
    ["single"],
    []
]

for strings in lists do
    let shown = $(strings)
    let equal = $(all_equal(strings))
    let ascending = $(strictly_ascending(strings))

    write_line("{shown,-22} equal: {equal,-5}  ascending: {ascending}")
od
