use default

// `T[]` is the read-only list trait - elements can be read by index
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `=~` compares values (structural equality)

all_equal(strings: string[]) -> bool =>
    strings |> windows(2) |> all(pair => pair[0] =~ pair[1])

strictly_ascending(strings: string[]) -> bool =>
    strings |> windows(2) |> all(pair => pair[0] < pair[1])

let lists = [
    ["AA", "AA", "AA", "AA"],
    ["AA", "ACB", "BB", "CC"],
    ["AA", "CC", "BB"],
    ["single"],
    []
]

for strings in lists do
    let shown = $(strings)
    let equal = $(all_equal(strings))
    let ascending = $(strictly_ascending(strings))

    write_line("{shown,-22} equal: {equal,-5}  ascending: {ascending}")
od
