use default

struct BT(digits: int{}) is
    to_string() -> string =>
        digits
            |> reverse()
            |> map(d => "-0+"[d + 1])
            |> string()
si

trim(ds: int{}) -> int{} =>
    ds |> reverse() |> skip_while(* == 0) |> reverse()

digit(c: char) -> int =>
    case c
    when '+' then 1
    when '-' then -1
    else 0
    esac

parse(s: string) -> BT => BT(s |> reverse() |> map(digit))

balanced(n: bigint) -> BT => BT(digits(n))

digits(n: bigint) -> int{} =>
    case int((n % 3n + 3n) % 3n)
    when 0 then if n =~ 0n then [] else [0] ++ digits(n / 3n) fi
    when 1 then [1] ++ digits((n - 1n) / 3n)
    else [-1] ++ digits((n + 1n) / 3n)
    esac

value(a: BT) -> bigint =>
    a.digits
        |> reverse()
        |> reduce(0n, (t, d) => t * 3n + bigint(d))

add(a: int{}, b: int{}) -> int{} =>
    case (a, b)
    when ([], _) then b
    when (_, []) then a
    when ([x, ..xs], [y, ..ys]) then
        case x + y
        when 2 then [-1] ++ add(xs, add(ys, [1]))
        when -2 then [1] ++ add(xs, add(ys, [-1]))
        else trim([x + y] ++ add(xs, ys))
        esac
    esac

-(a: BT) -> BT => BT(a.digits |> map(d => -d))

+(a: BT, b: BT) -> BT => BT(add(a.digits, b.digits))

-(a: BT, b: BT) -> BT => a + -b

*(a: BT, b: BT) -> BT =>
    case a.digits
    when [] then a
    when [d, ..rest] then
        let scaled =
            case d
            when 0 then BT([])
            when 1 then b
            else -b
            esac
        in
        scaled + BT([0] ++ (BT(rest) * b).digits)
    esac

let a = parse("+-0++0+")
let b = balanced(-436n)
let c = parse("+-++-")

write_line("a = {value(a)}")
write_line("b = {value(b)}")
write_line("c = {value(c)}")

let result = a * (b - c)
write_line("a * (b - c) = {result} = {value(result)}")
