use default

struct BT(digits: string) is
    to_string() -> string => digits
si

digit_value(c: char) -> int =>
    case c
    when '+' then 1
    when '-' then -1
    else 0
    esac

digit_char(v: int) -> char =>
    if v == 1 then '+' elif v == -1 then '-' else '0' fi

ternary(n: bigint) -> string =>
    if n =~ 0n then
        ""
    else
        let
            r = int((n % 3n + 3n) % 3n),
            d = if r == 2 then -1 else r fi
        in
            "{ternary((n - bigint(d)) / 3n)}{digit_char(d)}"
    fi

balanced(n: bigint) -> BT => BT(ternary(n))

value(a: BT) -> bigint =>
    a.digits
        |> reduce(0n, (total, c) =>
            total * 3n + bigint(digit_value(c))
        )

-(a: BT) -> BT is
    BT(
        a.digits
            |> map(c => digit_char(-digit_value(c)))
            |> join("")
    )
si

+(a: BT, b: BT) -> BT is
    let chars = LIST()
    let carry mut = 0
    let i mut = a.digits.length - 1
    let j mut = b.digits.length - 1

    while i >= 0 \/ j >= 0 \/ carry != 0 do
        let sum mut = carry

        if i >= 0 then
            sum = sum + digit_value(a.digits[i])
            i = i - 1
        fi

        if j >= 0 then
            sum = sum + digit_value(b.digits[j])
            j = j - 1
        fi

        let d mut = sum % 3
        if d < 0 then d = d + 3 fi
        if d == 2 then d = -1 fi

        carry = (sum - d) / 3
        chars.add(digit_char(d))
    od

    while chars.count > 1 /\ chars[chars.count - 1] == '0' do
        chars.remove_at(chars.count - 1)
    od

    chars.reverse()
    BT(chars |> map(c => "{c}") |> join(""))
si

-(a: BT, b: BT) -> BT => a + -b

<<(a: BT, places: int) -> BT =>
    let zeroes = repeat('0', places) |> join("") in
    BT("{a.digits}{zeroes}")

*(a: BT, b: BT) -> BT is
    let product mut = BT("0")

    for i in 0..a.digits.length do
        let d = digit_value(a.digits[a.digits.length - 1 - i])

        if d != 0 then
            let term = b << i

            product =
                product + if d == 1 then term else -term fi
        fi
    od

    product
si

let a = BT("+-0++0+")
let b = balanced(bigint(-436))
let c = BT("+-++-")

write_line("a = {value(a)}")
write_line("b = {value(b)}")
write_line("c = {value(c)}")

let result = a * (b - c)
write_line("a * (b - c) = {result} = {value(result)}")
