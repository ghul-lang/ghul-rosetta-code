use default

struct BT(digits: List[int]) is
    to_string() -> string =>
        digits |> reverse() |> map(d => "-0+"[d + 1]) |> string()
si

cons(d: int, rest: List[int]) -> List[int] => [d] ++ rest |> collect()

trim(ds: List[int]) -> List[int] =>
    ds |> reverse() |> skip_while(d => d == 0) |> reverse() |> collect()

digit(c: char) -> int =>
    case c when '+' then 1 when '-' then -1 else 0 esac

parse(s: string) -> BT => BT(s |> reverse() |> map(digit) |> collect())

balanced(n: bigint) -> BT => BT(digits(n) |> collect())

digits(n: bigint) -> int{} =>
    case int((n % 3n + 3n) % 3n)
    when 0 then if n =~ 0n then [] else [0] ++ digits(n / 3n) fi
    when 1 then [1] ++ digits((n - 1n) / 3n)
    else [-1] ++ digits((n + 1n) / 3n)
    esac

value(a: BT) -> bigint =>
    a.digits |> reverse() |> reduce(0n, (t, d) => t * 3n + bigint(d))

add(a: List[int], b: List[int]) -> List[int] =>
    case (a, b)
    when ([], _) then b
    when (_, []) then a
    when ([x, ..xs], [y, ..ys]) then
        case x + y
        when 2 then cons(-1, add(xs, add(ys, [1])))
        when -2 then cons(1, add(xs, add(ys, [-1])))
        else trim(cons(x + y, add(xs, ys)))
        esac
    esac

-(a: BT) -> BT => BT(a.digits |> map(d => -d) |> collect())

+(a: BT, b: BT) -> BT => BT(add(a.digits, b.digits))

-(a: BT, b: BT) -> BT => a + -b

*(a: BT, b: BT) -> BT =>
    case a.digits
    when [] then a
    when [d, ..rest] then
        let scaled = case d when 0 then BT([]) when 1 then b else -b esac in
        scaled + BT(cons(0, (BT(rest) * b).digits))
    esac

let a = parse("+-0++0+")
let b = balanced(-436n)
let c = parse("+-++-")

write_line("a = {value(a)}")
write_line("b = {value(b)}")
write_line("c = {value(c)}")

let result = a * (b - c)
write_line("a * (b - c) = {result} = {value(result)}")
