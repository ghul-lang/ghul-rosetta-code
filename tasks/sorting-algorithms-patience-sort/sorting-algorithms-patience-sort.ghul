use default

top(pile: LIST[int]) -> int => pile[pile.count - 1]

patience_sort(values: List[int]) -> int{} is
    let piles = LIST[LIST[int]]()

    for value in values do
        if let pile = piles |> find(p => top(p) >= value) then
            pile.add(value)
        else
            piles.add(LIST[int]([value]))
        fi
    od

    while piles.count > 0 do
        let pile = piles |> min_by(p => top(p))!

        yield top(pile)

        pile.remove_at(pile.count - 1)

        if pile.count == 0 then
            piles.remove_at(piles.index_of(pile))
        fi
    od
si

for values in [[5, 3, 1, 7, 4, 1, 1, 20], [2, 1], [8]] do
    write_line(
        "{values |> join(" ")} -> {values |> patience_sort() |> join(" ")}"
    )
od
