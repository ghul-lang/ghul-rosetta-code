use default

ascending_number(mask: int) -> int =>
    1::9
        |> filter(d => (mask >> (d - 1)) & 1 == 1)
        |> reduce(0, (value, d) => value * 10 + d)

is_prime(n: int) -> bool =>
    n > 1 /\ 2::int(Ghul.Math.sqrt(double(n))) |> all(d => n % d != 0)

1::511
    |> map(ascending_number)
    |> filter(is_prime)
    |> sort()
    |> chunk(8)
    |> each(row => write_line(row |> map(n => "{n,10}") |> join("")))
