use default

// `T[]` is the read-only list trait - elements can be read by index
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read, and `count` reads it all

let wanted = 15

let triangle = LIST[int[]]()

for n in 0::2 * wanted do
    let previous: int[] = if n == 0 then [] else triangle[n - 1] fi

    let row =
        0::n
            |> map(k =>
                if k == 0 \/ k == n then
                    1
                else
                    previous[k - 1] + previous[k]
                fi
            )
            |> list()

    triangle.add(row)
od

for n in 1::wanted do
    let row = triangle[2 * n]

    write_line("{n,3}{row[n] - row[n + 1],12}")
od
