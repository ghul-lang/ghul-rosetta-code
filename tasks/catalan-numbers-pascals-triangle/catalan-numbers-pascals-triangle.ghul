use default

let wanted = 15

let triangle = LIST[List[int]]()

for n in 0::2 * wanted do
    let previous: List[int] =
        if n == 0 then [] else triangle[n - 1] fi

    let row =
        0::n
            |> map(k =>
                if k == 0 \/ k == n then
                    1
                else
                    previous[k - 1] + previous[k]
                fi
            )
            |> collect()

    triangle.add(row)
od

for n in 1::wanted do
    let row = triangle[2 * n]

    write_line("{n,3}{row[n] - row[n + 1],12}")
od
