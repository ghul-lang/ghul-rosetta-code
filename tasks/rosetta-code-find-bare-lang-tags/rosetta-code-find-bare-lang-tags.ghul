use default

use System.Text.RegularExpressions.Regex
use System.Text.RegularExpressions.Match

let marker = Regex("=={{{{header\\|([^}}]+)}}}}==|<lang>")

bare_tags(page: string) -> (language: string, page: string){} is
    let text = IO.File.read_all_text("{page}.txt")
    let language mut = "no language"

    let matches: Collections.Iterable[Match] = marker.matches(text)

    for found in matches do
        if found.groups[1].success then
            language = found.groups[1].value.to_lower_invariant()
        else
            yield (language, page)
        fi
    od
si

report(pages: string[], show_pages: bool) is
    let found = pages |> flat_map(bare_tags) |> collect()

    write_line("{found.count} bare language tags.")
    write_line("")

    for (language, tags) in found |> group_by(tag => tag.language) do
        let where =
            tags
            |> map(tag => "[[{tag.page}]]")
            |> distinct()
            |> join()

        write_line(
            "{tags.count} in {language}"
            "{if show_pages then " ({where})" else "" fi}")
    od

    write_line("")
si

report(["Example"], false)
report(["Foo", "Bar", "Baz"], true)
