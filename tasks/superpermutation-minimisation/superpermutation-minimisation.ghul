use default

let alphabet = "ABCDEFG"

is_permutation(s: string) -> bool =>
    s.to_char_array() |> collect_set() |> count() == s.length

// Every permutation of n - 1 letters, in the order they first appear in
// the superpermutation of n - 1, is written out as itself, the new
// letter, and itself again; each piece overlaps the one before it as far
// as it can.
recursive(n: int) -> string is
    if n == 1 then
        return "A"
    fi

    let previous = recursive(n - 1)
    let seen = SET()
    let letter = alphabet[n - 1]
    let result = System.Text.StringBuilder()

    for i in 0::previous.length - (n - 1) do
        let window = previous.substring(i, n - 1)

        if is_permutation(window) /\ seen.add(window) then
            let piece = "{window}{letter}{window}"
            let built = result.to_string()
            let overlap mut = System.Math.min(built.length, piece.length)

            let matches = k => built.ends_with(piece.substring(0, k))

            while overlap > 0 /\ !matches(overlap) do
                overlap = overlap - 1
            od

            result.append(piece.substring(overlap))
        fi
    od

    result.to_string()
si

permutations(letters: string) -> List[string] =>
    if letters.length <= 1 then LIST([letters])
    else
        ["{letters[i]}{rest}"
            for i in 0..letters.length
            for rest in permutations(letters.remove(i, 1))]
    fi

contains_all(s: string, n: int) -> bool =>
    permutations(alphabet.substring(0, n)) |> all(p => s.contains(p))

factorial(n: int) -> int => 1::n |> reduce(1, (a, b) => a * b)

write_line(" n  joined  recursive  contains all")

for n in 1::7 do
    let built = recursive(n)
    let joined = factorial(n) * n

    write_line(
        "{n,2}  {joined,6}  {built.length,9}  {contains_all(built, n)}")
od

write_line("")
write_line("recursive(3) = {recursive(3)}")
write_line("recursive(4) = {recursive(4)}")
