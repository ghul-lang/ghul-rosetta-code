use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

sum_of_squares(values: double{}) -> double => values |> sum_by(v => v * v)

write_line("{sum_of_squares([3.0, 1.0, 4.0, 1.0, 5.0, 9.0])}")
write_line("{sum_of_squares([])}")
