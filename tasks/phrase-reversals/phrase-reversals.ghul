use default

reversed(s: string) -> string =>
    graphemes(s) |> reverse() |> string()

let phrase = "rosetta code phrase reversal"
let words = phrase.split([' '])

write_line("Reversed:            {reversed(phrase)}")
write_line("Words reversed:      {words |> map(reversed) |> join(" ")}")
write_line("Word order reversed: {words |> reverse() |> join(" ")}")
