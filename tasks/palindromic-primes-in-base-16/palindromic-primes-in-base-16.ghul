use default

is_palindrome(text: string) -> bool =>
    text |> reverse() |> join("") =~ text

let found =
    2..500
        |> filter(is_prime)
        |> map(n => "{n:x}")
        |> filter(is_palindrome)
        |> collect()

write_line(
    "{found.count} palindromic primes below 500, in base 16:"
)
write_line(found |> join(" "))
