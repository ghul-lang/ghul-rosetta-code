use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `=~` compares values (structural equality); `==` compares identity.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

is_palindrome(text: string) -> bool => text |> reverse() |> join("") =~ text

let found =
    2..500
        |> filter(is_prime)
        |> map(n => "{n:x}")
        |> filter(is_palindrome)
        |> list()

write_line("{found.count} palindromic primes below 500, in base 16:")
write_line(found |> join(" "))
