use default

let weights = [1, 3, 1, 7, 3, 9]

value(c: char) -> int? =>
    if char.is_digit(c) then int(c) - int('0')
    elif c >= 'B' /\ c <= 'Z' /\ "AEIOU".index_of(c) < 0 then
        int(c) - int('A') + 10
    else null
    fi

check_digit(sedol: string) -> char? is
    if sedol.length != 6 then
        return null
    fi

    let total mut = 0

    for i in 0..6 do
        let v = value(sedol[i])

        if !v? then
            return null
        fi

        total = total + v * weights[i]
    od

    char(int('0') + (10 - total % 10) % 10)
si

let inputs = [
    "710889", "B0YBKJ", "406566", "B0YBLH", "228276", "B0YBKL",
    "557910", "B0YBKR", "585284", "B0YBKT", "B00030",
    "B0YBKA", "12345", "1234567"
]

for sedol in inputs do
    if let digit = check_digit(sedol) then
        write_line("{sedol}{digit}")
    else
        write_line("{sedol}: not a valid SEDOL")
    fi
od
