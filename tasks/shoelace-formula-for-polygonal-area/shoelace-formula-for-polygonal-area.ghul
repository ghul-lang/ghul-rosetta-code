use default

use Point = (x: double, y: double)

// `T[]` is the read-only list trait - elements can be read by index
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

shoelace_area(vertices: Point[]) -> double =>
    abs(
        zip(vertices, vertices |> skip(1) |> cat([vertices[0]]))
            |> sum_by((a, b) => a.x * b.y - b.x * a.y)
    ) / 2.0

let polygon: Point[] = [
    (3.0, 4.0), (5.0, 11.0), (12.0, 8.0), (9.0, 5.0),
    (5.0, 6.0)
]

write_line("area = {shoelace_area(polygon)}")
