use default

to_digits(value: long, base: long) -> LIST[int] is
    let digits = LIST[int]()
    let remaining mut = value

    while remaining > 0L do
        digits.insert(0, int(remaining % base))

        remaining = remaining / base
    od

    if digits.count == 0 then
        digits.add(0)
    fi

    return digits
si

from_digits(digits: List[int], base: long) -> long =>
    digits |> reduce(0L, (value, digit) => value * base + long(digit))

is_palindrome(digits: List[int]) -> bool =>
    0..digits.count / 2
        |> all(i => digits[i] == digits[digits.count - 1 - i])

raised(base: long, exponent: int) -> long =>
    repeat(base, exponent) |> reduce(1L, (value, factor) => value * factor)

in_base(value: long, base: long) -> string =>
    string(
        to_digits(value, base)
            |> map(digit => "0123456789"[digit])
            |> collect())

ternary_palindromes() -> long{} is
    yield 0L

    for length in 1::40 do
        let half_length = (length + 1) / 2

        let lowest = raised(3L, half_length - 1)
        let highest = raised(3L, half_length) - 1L

        for half in lowest::highest do
            let front = to_digits(half, 3L)
            let mirrored = front |> take(length / 2) |> reverse()

            yield from_digits(front |> cat(mirrored) |> collect(), 3L)
        od
    od
si

ternary_palindromes()
    |> filter(value => is_palindrome(to_digits(value, 2L)))
    |> take(6)
    |> each(value =>
        write_line(
            "{value,12}  base 2 {in_base(value, 2L)}  "
            "base 3 {in_base(value, 3L)}"))
