use default

class Shape(x: double, y: double) abstract is
    describe() -> string

    copy() -> Shape
si

class POINT(x: double, y: double): Shape is
    super(x, y)

    describe() -> string => "a point at ({x}, {y})"

    copy() -> Shape => POINT(x, y)
si

class CIRCLE(x: double, y: double, r: double): Shape is
    super(x, y)

    describe() -> string =>
        "a circle of radius {r} at ({x}, {y})"

    copy() -> Shape => CIRCLE(x, y, r)
si

let shapes = [POINT(1.0, 2.0), CIRCLE(3.0, 4.0, 5.0)]

shapes |> each(shape => write_line(shape.describe()))

shapes
    |> each(shape =>
        let copy = shape.copy() in
        write_line(
            "{copy.describe()}, the same object: {copy == shape}"
        )
    )

shapes
    |> each(shape =>
        write_line(
            case shape
            when circle: CIRCLE then "radius {circle.r}"
            when _: POINT then "no radius: a point has none"
            esac
        )
    )
