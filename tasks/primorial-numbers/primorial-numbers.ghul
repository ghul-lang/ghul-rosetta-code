use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `LIST()` builds a collection eagerly
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read, and `count` reads it all

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `LIST()`, `SET()`, `MAP()` and `ARRAY()` build the collection eagerly.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

write_line("multiplying primes to find the primorial primes")
write_line("")

let sieve_limit = 1_300_000
let composite = repeat(false, sieve_limit + 1) |> LIST()

for candidate in 2::sieve_limit do
    if !composite[candidate] /\ candidate <= sieve_limit / candidate then
        let multiple mut = candidate * candidate

        while multiple <= sieve_limit do
            composite[multiple] = true
            multiple = multiple + candidate
        od
    fi
od

let primes =
    (2::sieve_limit)
        |> filter(candidate => !composite[candidate])
        |> map(bigint)
        |> list()

primorial(index: int) -> bigint => primes[0..index] |> product()

write_line("the first ten primorial numbers:")

(0..10)
    |> each(index =>
        write_line("  primorial({index}) = {primorial(index)}")
    )

write_line()
write_line("digits in larger primorial numbers:")

[10, 100, 1_000, 10_000, 100_000]
    |> each(index =>
        write_line(
            "  primorial({index,7:N0}) has "
            "{primorial(index).to_string().length,7:N0} digits"
        )
    )
