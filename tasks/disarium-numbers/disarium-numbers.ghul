use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

is_disarium(n: int) -> bool =>
    "{n}"
        |> index()
        |> sum_by((position, digit) =>
            repeat(int(digit - '0'), position + 1) |> product()
        ) == n

write_line(from(0) |> filter(is_disarium) |> take(18) |> join(" "))
