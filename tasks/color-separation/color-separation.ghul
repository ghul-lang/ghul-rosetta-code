use default
use Raster.Anchor
use Raster.IMAGE

use RGB = (red: ubyte, green: ubyte, blue: ubyte)

scene() -> IMAGE is
    let image = IMAGE(160, 120)

    for y in 0..80 do
        let t = double(y) / 80.0

        image.color(
            ubyte(40.0 + 200.0 * t),
            ubyte(70.0 + 100.0 * t),
            ubyte(160.0 - 60.0 * t)
        )
        image.fill_rectangle(0.0, double(y), 160.0, double(y + 1))
    od

    image.color(255ub, 220ub, 60ub)
    image.disc(112.0, 42.0, 15.0)

    image.color(90ub, 60ub, 120ub)
    image.fill([
        (0.0, 80.0),
        (45.0, 30.0),
        (95.0, 80.0)
    ])

    image.color(60ub, 110ub, 70ub)
    image.fill([
        (55.0, 80.0),
        (105.0, 48.0),
        (160.0, 80.0)
    ])

    image.color(70ub, 150ub, 60ub)
    image.fill_rectangle(0.0, 80.0, 160.0, 120.0)

    image.color(200ub, 35ub, 40ub)
    image.fill_rectangle(22.0, 88.0, 52.0, 110.0)

    image.color(120ub, 25ub, 30ub)
    image.fill([
        (18.0, 88.0),
        (37.0, 75.0),
        (56.0, 88.0)
    ])

    image.color(250ub, 245ub, 235ub)
    image.fill_rectangle(33.0, 97.0, 41.0, 110.0)

    image
si

use Layer = (name: string, row: int, column: int, show: RGB -> RGB)

byte(v: double) -> ubyte => ubyte(round(255.0 * clamp(v, 0.0, 1.0)))

fraction(b: ubyte) -> double => double(b) / 255.0

ink(amount: double, r: double, g: double, b: double) -> RGB => (
    red = byte(1.0 - amount * (1.0 - r)),
    green = byte(1.0 - amount * (1.0 - g)),
    blue = byte(1.0 - amount * (1.0 - b))
)

cmyk(p: RGB) -> (c: double, m: double, y: double, k: double) is
    let r = fraction(p.red), g = fraction(p.green), b = fraction(p.blue)
    let k = 1.0 - max(r, max(g, b))

    if k >= 1.0 then
        return (0.0, 0.0, 0.0, 1.0)
    fi

    let rest = 1.0 - k

    ((1.0 - r - k) / rest, (1.0 - g - k) / rest, (1.0 - b - k) / rest, k)
si

let layers: Layer[] = [
    ("original", 0, 0, p => p),
    ("red", 0, 1, p => (red = p.red, green = 0ub, blue = 0ub)),
    ("green", 0, 2, p => (red = 0ub, green = p.green, blue = 0ub)),
    ("blue", 0, 3, p => (red = 0ub, green = 0ub, blue = p.blue)),
    ("cyan", 1, 1, p => ink(1.0 - fraction(p.red), 0.0, 1.0, 1.0)),
    ("magenta", 1, 2, p => ink(1.0 - fraction(p.green), 1.0, 0.0, 1.0)),
    ("yellow", 1, 3, p => ink(1.0 - fraction(p.blue), 1.0, 1.0, 0.0)),
    ("cyan", 2, 0, p => ink(cmyk(p).c, 0.0, 1.0, 1.0)),
    ("magenta", 2, 1, p => ink(cmyk(p).m, 1.0, 0.0, 1.0)),
    ("yellow", 2, 2, p => ink(cmyk(p).y, 1.0, 1.0, 0.0)),
    ("black", 2, 3, p => ink(cmyk(p).k, 0.0, 0.0, 0.0))
]

scene().write("scene.png")

let source = IMAGE.read("scene.png")
let cell_width = source.width + 10
let cell_height = source.height + 24

let sheet = IMAGE(cell_width * 4 + 10, cell_height * 3 + 10)

sheet.clear(235ub, 235ub, 230ub)

for layer in layers do
    let left = 10 + layer.column * cell_width
    let top = 10 + layer.row * cell_height

    for y in 0..source.height do
        for x in 0..source.width do
            let p = layer.show(source.pixel(x, y))

            sheet.set_pixel(left + x, top + y, p.red, p.green, p.blue)
        od
    od

    sheet.color(40ub, 40ub, 40ub)
    sheet.text(
        double(left + source.width / 2),
        double(top + source.height + 15),
        10.0,
        layer.name,
        Anchor.CENTER
    )
od

let key_top = double(10 + cell_height + 40)

for (i, line) in ["top: RGB", "middle: CMY", "bottom: CMYK"] |> index() do
    let y = key_top + 18.0 * double(i)

    sheet.text(90.0, y, 11.0, line, Anchor.CENTER)
od

write_line("RGB, CMY and CMYK layers")

sheet.write("separation.png")

sheet.show("separation.png")
