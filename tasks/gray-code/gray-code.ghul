use default

bits(n) => System.Convert.to_string(n, 2).pad_left(5, '0')

encode(n) => n ^ (n >>> 1)

decode(gray) =>
    1..5 |> reduce(gray, (n, shift) => n ^ (gray >>> shift))

write_line("binary  gray   decoded")

for n in 0::31 do
    let gray = encode(n)

    write_line("{bits(n)}   {bits(gray)}   {decode(gray)}")
od
