use default

prime_factors(n: int) -> int{} is
    let remaining mut = n
    let divisor mut = 2

    while divisor * divisor <= remaining do
        if remaining % divisor == 0 then
            yield divisor
            remaining = remaining / divisor
        else
            divisor = divisor + 1
        fi
    od

    if remaining > 1 then
        yield remaining
    fi
si

min_max_product(n: int) -> int =>
    (let factors = prime_factors(n) |> collect()

     case factors
     when [] then 1
     when [first, ..] then first * factors[factors.count - 1]
     esac)

for row in (1::100) |> map(min_max_product) |> chunk(10) do
    write_line(row |> map(p => "{p,5}") |> join(""))
od
