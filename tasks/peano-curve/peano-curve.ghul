use Raster

let order = 3
let step = 18.0

let image = IMAGE(540, 540)
let pen = TURTLE(image)

peano(depth: int, angle: double) is
    if depth == 0 then
        return
    fi

    peano(depth - 1, angle)
    pen.forward(step)
    peano(depth - 1, -angle)
    pen.forward(step)
    peano(depth - 1, angle)

    pen.turn(angle)
    pen.forward(step)
    pen.turn(angle)

    peano(depth - 1, -angle)
    pen.forward(step)
    peano(depth - 1, angle)
    pen.forward(step)
    peano(depth - 1, -angle)

    pen.turn(-angle)
    pen.forward(step)
    pen.turn(-angle)

    peano(depth - 1, angle)
    pen.forward(step)
    peano(depth - 1, -angle)
    pen.forward(step)
    peano(depth - 1, angle)
si

image.view(0.0, 0.0, 540.0, 540.0)
image.color(0ub, 0ub, 160ub)
image.stroke(1.2)

pen.move_to(24.0, 24.0)

peano(order, 90.0)

image.write("peano.png")

image.show("peano.png")
