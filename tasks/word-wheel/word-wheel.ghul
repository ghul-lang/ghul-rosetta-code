use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

let wheel = "ndeokgelw"
let centre = 'k'

available(letters: string) -> MAP[char, int] =>
    MAP(letters |> frequencies())

spellable(word: string) -> bool is
    let left = available(wheel)

    for letter in word do
        if !left.contains_key(letter) \/ left[letter] == 0 then
            return false
        fi

        left[letter] = left[letter] - 1
    od

    return true
si

let found =
    IO.File.read_all_lines("unixdict.txt")
        |> filter(word =>
            word.length >= 3 /\ word.contains(centre) /\ spellable(word)
        )
        |> list()

write_line(found |> join("\n"))
write_line("")
write_line("{found.count} words")
