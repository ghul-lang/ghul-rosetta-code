use default
use IO.Std.read_line

union Node is
    EMPTY
    LEAF(kind: string, value: string)
    BRANCH(kind: string, left: Node, right: Node)
si

enum KIND is
    LEFT_PAREN, RIGHT_PAREN, LEFT_BRACE, RIGHT_BRACE, SEMICOLON, COMMA,
    ASSIGN, NOT, MULTIPLY, DIVIDE, MOD, ADD, SUBTRACT,
    LESS, LESS_EQUAL, GREATER, GREATER_EQUAL, EQUAL, NOT_EQUAL, AND, OR,
    IDENTIFIER, INTEGER, STRING,
    IF, ELSE, WHILE, PRINT, PUTC,
    END_OF_INPUT
si

class TOKEN(kind: KIND, value: string, line: string, column: string)

let lexicon = [
    ("LeftParen", KIND.LEFT_PAREN), ("RightParen", KIND.RIGHT_PAREN),
    ("LeftBrace", KIND.LEFT_BRACE), ("RightBrace", KIND.RIGHT_BRACE),
    ("Semicolon", KIND.SEMICOLON), ("Comma", KIND.COMMA),
    ("Op_assign", KIND.ASSIGN), ("Op_not", KIND.NOT),
    ("Op_multiply", KIND.MULTIPLY), ("Op_divide", KIND.DIVIDE),
    ("Op_mod", KIND.MOD), ("Op_add", KIND.ADD),
    ("Op_subtract", KIND.SUBTRACT), ("Op_less", KIND.LESS),
    ("Op_lessequal", KIND.LESS_EQUAL), ("Op_greater", KIND.GREATER),
    ("Op_greaterequal", KIND.GREATER_EQUAL), ("Op_equal", KIND.EQUAL),
    ("Op_notequal", KIND.NOT_EQUAL), ("Op_and", KIND.AND),
    ("Op_or", KIND.OR), ("Identifier", KIND.IDENTIFIER),
    ("Integer", KIND.INTEGER), ("String", KIND.STRING),
    ("Keyword_if", KIND.IF), ("Keyword_else", KIND.ELSE),
    ("Keyword_while", KIND.WHILE), ("Keyword_print", KIND.PRINT),
    ("Keyword_putc", KIND.PUTC), ("End_of_input", KIND.END_OF_INPUT)
]

let kinds = MAP(lexicon)
let spellings = MAP(lexicon |> map(((text, kind)) => (kind, text)))

let unary = 14

binary_operator(kind: KIND) -> (symbol: string, precedence: int)? =>
    case kind
    when KIND.MULTIPLY then (symbol = "Multiply", precedence = 13)
    when KIND.DIVIDE then (symbol = "Divide", precedence = 13)
    when KIND.MOD then (symbol = "Mod", precedence = 13)
    when KIND.ADD then (symbol = "Add", precedence = 12)
    when KIND.SUBTRACT then (symbol = "Subtract", precedence = 12)
    when KIND.LESS then (symbol = "Less", precedence = 10)
    when KIND.LESS_EQUAL then (symbol = "LessEqual", precedence = 10)
    when KIND.GREATER then (symbol = "Greater", precedence = 10)
    when KIND.GREATER_EQUAL then (symbol = "GreaterEqual", precedence = 10)
    when KIND.EQUAL then (symbol = "Equal", precedence = 9)
    when KIND.NOT_EQUAL then (symbol = "NotEqual", precedence = 9)
    when KIND.AND then (symbol = "And", precedence = 5)
    when KIND.OR then (symbol = "Or", precedence = 4)
    else null
    esac

class PARSER(tokens: List[TOKEN]) is
    _at: int

    token: TOKEN => tokens[_at]

    advance() is
        _at = _at + 1
    si

    accept(kind: KIND) -> bool =>
        if token.kind =~ kind then
            advance()
            true
        else
            false
        fi

    expect(kind: KIND) is
        if !accept(kind) then
            throw System.Exception(
                "({token.line}, {token.column}) expecting "
                "{spellings[kind]}, found {spellings[token.kind]}")
        fi
    si

    program() -> Node =>
        statements([KIND.END_OF_INPUT])

    statements(stoppers: KIND{}) -> Node =>
        statements_from(Node.EMPTY, stoppers)

    statements_from(list: Node, stoppers: KIND{}) -> Node =>
        if stoppers |> contains(token.kind) then
            list
        else
            statements_from(
                Node.BRANCH("Sequence", list, statement()), stoppers)
        fi

    statement() -> Node =>
        case token.kind
        when KIND.IF then
            advance()
            let condition = parenthesised()
            let then_part = statement()
            let else_part =
                if accept(KIND.ELSE) then statement() else Node.EMPTY fi
            Node.BRANCH("If", condition,
                Node.BRANCH("If", then_part, else_part))
        when KIND.PUTC then
            advance()
            let value = parenthesised()
            expect(KIND.SEMICOLON)
            Node.BRANCH("Prtc", value, Node.EMPTY)
        when KIND.PRINT then
            advance()
            print_list()
        when KIND.SEMICOLON then
            advance()
            Node.EMPTY
        when KIND.IDENTIFIER then
            assignment()
        when KIND.WHILE then
            advance()
            let condition = parenthesised()
            Node.BRANCH("While", condition, statement())
        when KIND.LEFT_BRACE then
            block()
        else
            throw System.Exception(
                "({token.line}, {token.column}) expecting a statement, "
                "found {spellings[token.kind]}")
        esac

    assignment() -> Node => (
        let target = Node.LEAF("Identifier", token.value)
        advance()
        expect(KIND.ASSIGN)
        let value = expression(0)
        expect(KIND.SEMICOLON)
        Node.BRANCH("Assign", target, value))

    block() -> Node => (
        advance()
        let list = statements([KIND.RIGHT_BRACE, KIND.END_OF_INPUT])
        expect(KIND.RIGHT_BRACE)
        list)

    print_list() -> Node => (
        expect(KIND.LEFT_PAREN)
        let list =
            print_items(Node.BRANCH("Sequence", Node.EMPTY, print_item()))
        expect(KIND.RIGHT_PAREN)
        expect(KIND.SEMICOLON)
        list)

    print_items(list: Node) -> Node =>
        if accept(KIND.COMMA) then
            print_items(Node.BRANCH("Sequence", list, print_item()))
        else
            list
        fi

    print_item() -> Node =>
        case token.kind
        when KIND.STRING then
            let text = Node.LEAF("String", token.value)
            advance()
            Node.BRANCH("Prts", text, Node.EMPTY)
        else
            Node.BRANCH("Prti", expression(0), Node.EMPTY)
        esac

    parenthesised() -> Node => (
        expect(KIND.LEFT_PAREN)
        let inside = expression(0)
        expect(KIND.RIGHT_PAREN)
        inside)

    expression(minimum: int) -> Node =>
        binary_tail(primary(), minimum)

    primary() -> Node =>
        case token.kind
        when KIND.LEFT_PAREN then
            parenthesised()
        when KIND.SUBTRACT then
            advance()
            Node.BRANCH("Negate", expression(unary), Node.EMPTY)
        when KIND.NOT then
            advance()
            Node.BRANCH("Not", expression(unary), Node.EMPTY)
        when KIND.ADD then
            advance()
            expression(unary)
        when KIND.IDENTIFIER then
            let value = token.value
            advance()
            Node.LEAF("Identifier", value)
        when KIND.INTEGER then
            let value = token.value
            advance()
            Node.LEAF("Integer", value)
        else
            throw System.Exception(
                "({token.line}, {token.column}) expecting a primary, "
                "found {spellings[token.kind]}")
        esac

    binary_tail(left: Node, minimum: int) -> Node =>
        if let op = binary_operator(token.kind) /\
                op.precedence >= minimum then
            advance()
            let right = expression(op.precedence + 1)
            binary_tail(Node.BRANCH(op.symbol, left, right), minimum)
        else
            left
        fi
si

show(node: Node) is
    case node
    when (kind, value): Node.LEAF then write_line("{kind,-14}{value}")
    when (kind, left, right): Node.BRANCH then
        write_line(kind)
        show(left)
        show(right)
    else write_line(";")
    esac
si

stdin_lines() -> string{} is
    while let line = read_line() do
        yield line
    od
si

token(line: string) -> TOKEN => (
    let fields = line |> words() |> collect()
    let name = fields[2]
    let rest = line.substring(line.index_of(name) + name.length).trim()
    TOKEN(kinds[name], rest, fields[0], fields[1]))

let tokens =
    stdin_lines()
    |> filter(line => line |> words() |> count() >= 3)
    |> map(token)
    |> collect()

show(PARSER(tokens).program())
