use default
use IO.Std.read_line

enum Kind is
    LEFT_PAREN, RIGHT_PAREN, LEFT_BRACE, RIGHT_BRACE, SEMICOLON, COMMA,
    ASSIGN, NOT, MULTIPLY, DIVIDE, MOD, ADD, SUBTRACT,
    LESS, LESS_EQUAL, GREATER, GREATER_EQUAL, EQUAL, NOT_EQUAL, AND, OR,
    IDENTIFIER, INTEGER, STRING,
    IF, ELSE, WHILE, PRINT, PUTC,
    END_OF_INPUT
si

union Node is
    EMPTY
    IDENTIFIER(name: string)
    INTEGER(value: string)
    STRING(text: string)
    SEQUENCE(left: Node, right: Node)
    IF(condition: Node, then_part: Node, else_part: Node)
    ASSIGN(target: Node, value: Node)
    WHILE(condition: Node, body: Node)
    PRTC(value: Node)
    PRTS(text: Node)
    PRTI(value: Node)
    NEGATE(operand: Node)
    NOT(operand: Node)
    OPERATOR(kind: Kind, left: Node, right: Node)
si

class TOKEN(kind: Kind, value: string, line: string, column: string)

let lexicon = [
    ("LeftParen", Kind.LEFT_PAREN), ("RightParen", Kind.RIGHT_PAREN),
    ("LeftBrace", Kind.LEFT_BRACE), ("RightBrace", Kind.RIGHT_BRACE),
    ("Semicolon", Kind.SEMICOLON), ("Comma", Kind.COMMA),
    ("Op_assign", Kind.ASSIGN), ("Op_not", Kind.NOT),
    ("Op_multiply", Kind.MULTIPLY), ("Op_divide", Kind.DIVIDE),
    ("Op_mod", Kind.MOD), ("Op_add", Kind.ADD),
    ("Op_subtract", Kind.SUBTRACT), ("Op_less", Kind.LESS),
    ("Op_lessequal", Kind.LESS_EQUAL), ("Op_greater", Kind.GREATER),
    ("Op_greaterequal", Kind.GREATER_EQUAL), ("Op_equal", Kind.EQUAL),
    ("Op_notequal", Kind.NOT_EQUAL), ("Op_and", Kind.AND),
    ("Op_or", Kind.OR), ("Identifier", Kind.IDENTIFIER),
    ("Integer", Kind.INTEGER), ("String", Kind.STRING),
    ("Keyword_if", Kind.IF), ("Keyword_else", Kind.ELSE),
    ("Keyword_while", Kind.WHILE), ("Keyword_print", Kind.PRINT),
    ("Keyword_putc", Kind.PUTC), ("End_of_input", Kind.END_OF_INPUT)
]

let kinds = MAP(lexicon)
let spellings = MAP(lexicon |> map(((text, kind)) => (kind, text)))

let unary_precedence = 14

binary_precedence(kind: Kind) -> int? =>
    case kind
    when Kind.MULTIPLY, Kind.DIVIDE, Kind.MOD then 13
    when Kind.ADD, Kind.SUBTRACT then 12
    when Kind.LESS, Kind.LESS_EQUAL, Kind.GREATER,
        Kind.GREATER_EQUAL then 10
    when Kind.EQUAL, Kind.NOT_EQUAL then 9
    when Kind.AND then 5
    when Kind.OR then 4
    else null
    esac

operator_spelling(kind: Kind) -> string =>
    case kind
    when Kind.MULTIPLY then "Multiply"
    when Kind.DIVIDE then "Divide"
    when Kind.MOD then "Mod"
    when Kind.ADD then "Add"
    when Kind.SUBTRACT then "Subtract"
    when Kind.LESS then "Less"
    when Kind.LESS_EQUAL then "LessEqual"
    when Kind.GREATER then "Greater"
    when Kind.GREATER_EQUAL then "GreaterEqual"
    when Kind.EQUAL then "Equal"
    when Kind.NOT_EQUAL then "NotEqual"
    when Kind.AND then "And"
    when Kind.OR then "Or"
    else
        throw System.Exception("{kind} is not a binary operator")
    esac

class PARSER(tokens: Iterator[TOKEN]) is
    token: TOKEN

    init(..) is
        advance()
    si

    // the parser never moves past End_of_input, so there is always a next
    advance() is
        token = (tokens |> next())!
    si

    accept(kind: Kind) -> bool =>
        if token.kind =~ kind then
            advance()
            true
        else
            false
        fi

    expect(kind: Kind) is
        if !accept(kind) then
            throw System.Exception(
                "({token.line}, {token.column}) expecting "
                "{spellings[kind]}, found {spellings[token.kind]}")
        fi
    si

    program() -> Node =>
        statements([Kind.END_OF_INPUT])

    statements(stoppers: Kind{}) -> Node =>
        statements_from(Node.EMPTY, stoppers)

    statements_from(list: Node, stoppers: Kind{}) -> Node =>
        if stoppers |> contains(token.kind) then
            list
        else
            statements_from(
                Node.SEQUENCE(list, statement()), stoppers)
        fi

    statement() -> Node =>
        case token.kind
        when Kind.IF then
            advance()
            let condition = parenthesised()
            let then_part = statement()
            let else_part =
                if accept(Kind.ELSE) then statement() else Node.EMPTY fi
            Node.IF(condition, then_part, else_part)
        when Kind.PUTC then
            advance()
            let value = parenthesised()
            expect(Kind.SEMICOLON)
            Node.PRTC(value)
        when Kind.PRINT then
            advance()
            print_list()
        when Kind.SEMICOLON then
            advance()
            Node.EMPTY
        when Kind.IDENTIFIER then
            assignment()
        when Kind.WHILE then
            advance()
            let condition = parenthesised()
            Node.WHILE(condition, statement())
        when Kind.LEFT_BRACE then
            block()
        else
            throw System.Exception(
                "({token.line}, {token.column}) expecting a statement, "
                "found {spellings[token.kind]}")
        esac

    assignment() -> Node => (
        let target = Node.IDENTIFIER(token.value)
        advance()
        expect(Kind.ASSIGN)
        let value = expression(0)
        expect(Kind.SEMICOLON)
        Node.ASSIGN(target, value))

    block() -> Node => (
        advance()
        let list = statements([Kind.RIGHT_BRACE, Kind.END_OF_INPUT])
        expect(Kind.RIGHT_BRACE)
        list)

    print_list() -> Node => (
        expect(Kind.LEFT_PAREN)
        let list =
            print_items(Node.SEQUENCE(Node.EMPTY, print_item()))
        expect(Kind.RIGHT_PAREN)
        expect(Kind.SEMICOLON)
        list)

    print_items(list: Node) -> Node =>
        if accept(Kind.COMMA) then
            print_items(Node.SEQUENCE(list, print_item()))
        else
            list
        fi

    print_item() -> Node =>
        case token.kind
        when Kind.STRING then
            let text = Node.STRING(token.value)
            advance()
            Node.PRTS(text)
        else
            Node.PRTI(expression(0))
        esac

    parenthesised() -> Node => (
        expect(Kind.LEFT_PAREN)
        let inside = expression(0)
        expect(Kind.RIGHT_PAREN)
        inside)

    expression(minimum: int) -> Node =>
        binary_tail(primary(), minimum)

    primary() -> Node =>
        case token.kind
        when Kind.LEFT_PAREN then
            parenthesised()
        when Kind.SUBTRACT then
            advance()
            Node.NEGATE(expression(unary_precedence))
        when Kind.NOT then
            advance()
            Node.NOT(expression(unary_precedence))
        when Kind.ADD then
            advance()
            expression(unary_precedence)
        when Kind.IDENTIFIER then
            let name = token.value
            advance()
            Node.IDENTIFIER(name)
        when Kind.INTEGER then
            let value = token.value
            advance()
            Node.INTEGER(value)
        else
            throw System.Exception(
                "({token.line}, {token.column}) expecting a primary, "
                "found {spellings[token.kind]}")
        esac

    binary_tail(left: Node, minimum: int) -> Node =>
        if let precedence = binary_precedence(token.kind) /\
                precedence >= minimum then
            let kind = token.kind
            advance()
            let right = expression(precedence + 1)
            binary_tail(Node.OPERATOR(kind, left, right), minimum)
        else
            left
        fi
si

leaf(kind: string, value: string) is
    write_line("{kind,-14}{value}")
si

unary(kind: string, value: Node) is
    // the task's tree gives every unary node an empty second child
    write_line(kind)
    show(value)
    write_line(";")
si

binary(kind: string, left: Node, right: Node) is
    write_line(kind)
    show(left)
    show(right)
si

show(node: Node) is
    case node
    when identifier: Node.IDENTIFIER then
        leaf("Identifier", identifier.name)
    when integer: Node.INTEGER then
        leaf("Integer", integer.value)
    when literal: Node.STRING then
        leaf("String", literal.text)
    when Node.EMPTY then
        write_line(";")
    when (condition, then_part, else_part): Node.IF then
        // the task's output spells an if as an If over the condition and
        // a second If over the two parts
        write_line("If")
        show(condition)
        write_line("If")
        show(then_part)
        show(else_part)
    when (left, right): Node.SEQUENCE then
        binary("Sequence", left, right)
    when (target, value): Node.ASSIGN then
        binary("Assign", target, value)
    when (condition, body): Node.WHILE then
        binary("While", condition, body)
    when prtc: Node.PRTC then
        unary("Prtc", prtc.value)
    when prts: Node.PRTS then
        unary("Prts", prts.text)
    when prti: Node.PRTI then
        unary("Prti", prti.value)
    when operand: Node.NEGATE then
        unary("Negate", operand.operand)
    when operand: Node.NOT then
        unary("Not", operand.operand)
    when (kind, left, right): Node.OPERATOR then
        binary(operator_spelling(kind), left, right)
    esac
si

stdin_lines() -> string{} is
    while let line = read_line() do
        yield line
    od
si

token(line: string) -> TOKEN => (
    let fields = line |> words() |> collect()
    let name = fields[2]
    let rest = line.substring(line.index_of(name) + name.length).trim()
    TOKEN(kinds[name], rest, fields[0], fields[1]))

let tokens =
    stdin_lines()
    |> filter(line => line |> words() |> count() >= 3)
    |> map(token)

show(PARSER(tokens.iterator).program())
