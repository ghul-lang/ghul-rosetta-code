use default
use IO.Std.read_line

union Node is
    EMPTY
    LEAF(kind: string, value: string)
    BRANCH(kind: string, left: Node, right: Node)
si

class TOKEN(
    name: string,
    value: string,
    line: string,
    column: string
)

use Operator = (kind: string, precedence: int)

let binary = MAP()

for
    (name, kind, precedence) in [
        ("Op_multiply", "Multiply", 13),
        ("Op_divide", "Divide", 13),
        ("Op_mod", "Mod", 13), ("Op_add", "Add", 12),
        ("Op_subtract", "Subtract", 12),
        ("Op_less", "Less", 10),
        ("Op_lessequal", "LessEqual", 10),
        ("Op_greater", "Greater", 10),
        ("Op_greaterequal", "GreaterEqual", 10),
        ("Op_equal", "Equal", 9),
        ("Op_notequal", "NotEqual", 9), ("Op_and", "And", 5),
        ("Op_or", "Or", 4)
    ]
do
    binary[name] = (kind = kind, precedence = precedence)
od

let unary = 14

class PARSER(tokens: List[TOKEN]) is
    _at: int

    token: TOKEN => tokens[_at]

    advance() is
        _at = _at + 1
    si

    accept(name: string) -> bool is
        if token.name =~ name then
            advance()
            return true
        fi

        false
    si

    expect(name: string) is
        if !accept(name) then
            throw System.Exception(
                "({token.line}, {token.column}) expecting {name}, "
                "found {token.name}"
            )
        fi
    si

    expression(minimum: int) -> Node is
        let left mut = Node.EMPTY
        let name = token.name

        if name =~ "LeftParen" then
            left = parenthesised()
        elif name =~ "Op_subtract" \/ name =~ "Op_not" then
            advance()

            let operand = expression(unary)
            let kind =
                if name =~ "Op_not" then "Not" else "Negate" fi

            left = Node.BRANCH(kind, operand, Node.EMPTY)
        elif name =~ "Op_add" then
            advance()
            left = expression(unary)
        elif name =~ "Identifier" \/ name =~ "Integer" then
            left = Node.LEAF(name, token.value)
            advance()
        else
            throw System.Exception(
                "({token.line}, {token.column}) expecting a primary, "
                "found {name}"
            )
        fi

        while
            binary.contains_key(token.name) /\
            binary[token.name].precedence >= minimum
        do
            let operator = binary[token.name]

            advance()

            let right = expression(operator.precedence + 1)

            left = Node.BRANCH(operator.kind, left, right)
        od

        left
    si

    parenthesised() -> Node is
        expect("LeftParen")

        let inside = expression(0)

        expect("RightParen")

        inside
    si

    statement() -> Node is
        if accept("Keyword_if") then
            let condition = parenthesised()
            let then_part = statement()
            let else_part =
                if accept("Keyword_else") then statement()
                else Node.EMPTY
                fi

            return Node.BRANCH(
                "If",
                condition,
                Node.BRANCH("If", then_part, else_part)
            )
        elif accept("Keyword_putc") then
            let value = parenthesised()

            expect("Semicolon")

            return Node.BRANCH("Prtc", value, Node.EMPTY)
        elif accept("Keyword_print") then
            expect("LeftParen")

            let list mut = Node.EMPTY

            do
                let item =
                    if token.name =~ "String" then
                        let text = Node.LEAF(
                            "String",
                            token.value
                        )
                        in
                        (
                            advance()
                            Node.BRANCH(
                                "Prts",
                                text,
                                Node.EMPTY
                            )
                        )
                    else
                        Node.BRANCH(
                            "Prti",
                            expression(0),
                            Node.EMPTY
                        )
                    fi

                list = Node.BRANCH("Sequence", list, item)

                if !accept("Comma") then
                    break
                fi
            od

            expect("RightParen")
            expect("Semicolon")

            return list
        elif accept("Semicolon") then
            return Node.EMPTY
        elif token.name =~ "Identifier" then
            let target = Node.LEAF("Identifier", token.value)

            advance()
            expect("Op_assign")

            let value = expression(0)

            expect("Semicolon")

            return Node.BRANCH("Assign", target, value)
        elif accept("Keyword_while") then
            let condition = parenthesised()

            return Node.BRANCH("While", condition, statement())
        elif accept("LeftBrace") then
            let list mut = Node.EMPTY

            while
                !(token.name =~ "RightBrace") /\
                !(token.name =~ "End_of_input")
            do
                list = Node.BRANCH(
                    "Sequence",
                    list,
                    statement()
                )
            od

            expect("RightBrace")

            return list
        fi

        throw System.Exception(
            "({token.line}, {token.column}) expecting a statement, "
            "found {token.name}"
        )
    si

    program() -> Node is
        let list mut = Node.EMPTY

        while !(token.name =~ "End_of_input") do
            list = Node.BRANCH("Sequence", list, statement())
        od

        list
    si
si

show(node: Node) is
    case node
    when (kind, value): Node.LEAF then
        write_line("{kind,-14}{value}")
    when (kind, left, right): Node.BRANCH then
        write_line(kind)
        show(left)
        show(right)
    else write_line(";")
    esac
si

let tokens = LIST()

while let line = read_line() do
    let fields = line |> words() |> collect()

    if fields.count >= 3 then
        let name = fields[2]
        let rest = line.substring(
            line.index_of(name) + name.length
        )

        tokens.add(
            TOKEN(name, rest.trim(), fields[0], fields[1])
        )
    fi
od

show(PARSER(tokens).program())
