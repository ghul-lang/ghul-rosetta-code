use default

// `if let` and `case ... when` pattern-match; `[x, ..rest]` matches a list.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `*` as an argument leaves that parameter open: partial application.

value(letter: char) -> int =>
    case letter
    when 'M' then 1000
    when 'D' then 500
    when 'C' then 100
    when 'L' then 50
    when 'X' then 10
    when 'V' then 5
    else 1
    esac

signed_value(numeral: string, index: int) -> int =>
    if
        index + 1 < numeral.length /\
        value(numeral[index]) < value(numeral[index + 1])
    then
        -value(numeral[index])
    else
        value(numeral[index])
    fi

decode(numeral: string) -> int =>
    (0..numeral.length) |> sum_by(signed_value(numeral, *))

for numeral in ["MCMXC", "MMVIII", "MDCLXVI"] do
    write_line("{numeral} = {decode(numeral)}")
od
