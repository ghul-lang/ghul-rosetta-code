use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `MAP[K, V]` is a mutable map from keys to values
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

van_eck() -> int{} is
    let last_seen = MAP()

    let term mut = 0
    let position mut = 0

    do
        yield term

        let previous mut = 0
        let next =
            if last_seen.try_get_value(term, previous ref) then
                position - previous
            else
                0
            fi

        last_seen[term] = position

        term = next
        position = position + 1
    od
si

write_line("first ten:      {van_eck() |> take(10) |> join(" ")}")
write_line(
    "terms 991-1000: {van_eck() |> skip(990) |> take(10) |> join(" ")}"
)
