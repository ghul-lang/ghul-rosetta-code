use default
use System.Threading.Interlocked
use System.Threading.Thread
use System.Threading.Volatile

class FLAG is
    state: int field

    init() is
        state = 0
    si

    read() -> int => Volatile.read(state ref)

    write(value: int) is
        Volatile.write(state ref, value)
    si
si

let workers = 4
let rounds = 500

let flags = 0..workers |> map(i => FLAG()) |> collect()

let counter = LIST([0])
let occupancy = LIST([0, 0])

all_within(from: int, to: int, allowed: int[]) -> bool =>
    from..to |> all(i => allowed |> any(value => value == flags[i].read()))

any_is(value: int) -> bool =>
    0..workers |> any(i => flags[i].read() == value)

enter(me: int) is
    flags[me].write(1)

    while !all_within(0, workers, [0, 1, 2]) do
        Thread.yield()
    od

    flags[me].write(3)

    if any_is(1) then
        flags[me].write(2)

        while !any_is(4) do
            Thread.yield()
        od
    fi

    flags[me].write(4)

    while !all_within(0, me, [0, 1]) do
        Thread.yield()
    od
si

leave(me: int) is
    while !all_within(me + 1, workers, [0, 1, 4]) do
        Thread.yield()
    od

    flags[me].write(0)
si

work(me: int) is
    for round in 0..rounds do
        enter(me)

        let inside = occupancy[0] + 1

        occupancy[0] = inside

        if inside > occupancy[1] then
            occupancy[1] = inside
        fi

        counter[0] = counter[0] + 1

        occupancy[0] = occupancy[0] - 1

        leave(me)
    od
si

let threads = 0..workers
    |> map(i => Thread(System.Threading.ThreadStart(() => work(i))))
    |> collect()

threads |> each(thread => thread.start())
threads |> each(thread => thread.join())

write_line("workers: {workers}, rounds each: {rounds}")
write_line("counter: {counter[0]}, expected {workers * rounds}")
write_line("most workers inside at once: {occupancy[1]}")
write_line("every flag back to zero: {all_within(0, workers, [0])}")
