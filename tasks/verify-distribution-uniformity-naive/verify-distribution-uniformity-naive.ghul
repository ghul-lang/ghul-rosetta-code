use default

let random = System.Random(12345)

dice5() -> int => random.next(1, 6)

dice7() -> int is
    do
        let roll = 5 * (dice5() - 1) + dice5() - 1

        if roll < 21 then
            return roll % 7 + 1
        fi
    od
si

loaded7() -> int =>
    if random.next(100) < 5 then 7 else dice7() fi

check_distribution(
    generate: () -> int, calls: int, delta: double
) -> bool is
    let counts =
        (0..calls)
        |> map(_ => generate())
        |> group_by(value => value)
        |> map(entry => (entry.key, entry.value.count))
        |> collect_map()

    let expected = double(calls) / double(counts.count)
    let flat mut = true

    for value in counts.keys |> sort() do
        let difference = double(counts[value]) - expected
        let deviation = System.Math.abs(difference) / expected
        let within = deviation <= delta

        write_line(
            "  {value}: {counts[value],7}  {100.0 * deviation,5:F2}% off"
            "{if within then "" else "  <- too far from flat" fi}")

        flat = flat /\ within
    od

    return flat
si

for (name, generate) in [("dice7", dice7), ("loaded7", loaded7)] do
    write_line("{name}, 1000000 calls, delta 1%:")

    if check_distribution(generate, 1_000_000, 0.01) then
        write_line("  flat enough")
    else
        write_line("  error: the distribution is not flat enough")
    fi

    write_line("")
od
