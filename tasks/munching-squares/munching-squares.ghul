use Ghul.Math
use Raster.IMAGE

let size = 256

shade(value: int, phase: double) -> ubyte =>
    ubyte(127.5 * (1.0 - cos(2.0 * pi * double(value) / 256.0 + phase)))

let image = IMAGE(size, size)

for y in 0..size do
    for x in 0..size do
        let value = x ^ y

        image.set_pixel(
            x,
            y,
            shade(value, 0.0),
            shade(value, 2.1),
            shade(value, 4.2)
        )
    od
od

image.write("munching.png")

image.show("munching.png")
