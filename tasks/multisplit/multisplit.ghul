use default

use PIECE = (text: string, separator: string, at: int)

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`
// `=~` compares values (structural equality) - `==` compares identity
// `if let` pattern-matches, and `[x, ..rest]` matches a list head and tail

starts_with(text: string, position: int, separator: string) -> bool =>
    position + separator.length <= text.length /\
    text[position..position + separator.length] =~ separator

multisplit(text: string, separators: string[]) -> PIECE{} is
    let start mut = 0
    let position mut = 0

    while position < text.length do
        if let
            separator = separators |> find(starts_with(text, position, *))
        then
            yield (
                text = text[start..position],
                separator = separator,
                at = position
            )

            position = position + separator.length
            start = position
        else
            position = position + 1
        fi
    od

    yield (text = text[start..text.length], separator = "", at = -1)
si

let pieces = multisplit("a!===b=!=c", ["==", "!=", "="]) |> list()

write_line(pieces |> map(piece => "\"{piece.text}\"") |> join())

pieces
    |> filter(piece => piece.separator.length > 0)
    |> each(piece => write_line("matched {piece.separator} at {piece.at}"))
