use default

digit_square_sum(n: int) -> int =>
    n |> digits() |> map(d => d * d) |> sum()

is_happy(n: int) -> bool is
    let seen = LIST()
    let remaining mut = n

    while remaining != 1 /\ !seen.contains(remaining) do
        seen.add(remaining)
        remaining = digit_square_sum(remaining)
    od

    remaining == 1
si

let first_eight = from(1)
    |> filter(is_happy)
    |> take(8)

write_line("first happy numbers: {first_eight |> join(" ")}")
