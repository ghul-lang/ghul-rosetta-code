use default
use System.Text.RegularExpressions.Regex

luhn(digits: string) -> bool is
    let total mut = 0

    for (i, c) in digits.to_char_array() |> reverse() |> index() do
        let d = int(c) - int('0')
        let doubled = if i % 2 == 1 then d * 2 else d fi

        total = total + doubled / 10 + doubled % 10
    od

    total % 10 == 0
si

let format = Regex("^[A-Z]{{2}}[A-Z0-9]{{9}}[0-9]$")

base_36(c: char) -> int =>
    if char.is_digit(c) then int(c) - int('0')
    else int(c) - int('A') + 10
    fi

is_valid(isin: string) -> bool =>
    format.is_match(isin) /\
    luhn(isin |> map(c => "{base_36(c)}") |> join(""))

let cases = [
    "US0378331005", "US0373831005", "U50378331005", "US03378331005",
    "AU0000XVGZA3", "AU0000VXGZA3", "FR0000988040"
]

for isin in cases do
    let verdict = if is_valid(isin) then "valid" else "not valid" fi

    write_line("{isin,-13} {verdict}")
od
