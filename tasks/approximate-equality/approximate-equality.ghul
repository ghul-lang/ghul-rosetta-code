use default
use System.Math.*

≈(left: double, right: double) -> bool is
    if left == right then
        return true
    fi

    let difference = abs(left - right)
    let largest = max(abs(left), abs(right))

    difference <= largest * 1.0e-9
si

let pairs = [
    (left = 100000000000000.01, right = 100000000000000.011),
    (left = 100.01, right = 100.011),
    (left = 10000000000000.001 / 10000.0, right = 1000000000.0000001),
    (left = 0.001, right = 0.0010000001),
    (left = 0.000000000000000000000101, right = 0.0),
    (left = sqrt(2.0) * sqrt(2.0), right = 2.0),
    (left = -sqrt(2.0) * sqrt(2.0), right = 2.0),
    (left = 100000000000000003.0, right = 100000000000000004.0),
    (left = 3.14159265358979323846, right = 3.14159265358979324)
]

for (left, right) in pairs do
    write_line("{left,26} {right,26}  {left ≈ right}")
od
