use default

≈(left: double, right: double) -> bool is
    if left == right then
        return true
    fi

    let difference = abs(left - right)
    let largest = max(abs(left), abs(right))

    difference <= largest * 1.0e-9
si

let pairs = [
    (100000000000000.01, 100000000000000.011),
    (100.01, 100.011),
    (10000000000000.001 / 10000.0, 1000000000.0000001),
    (0.001, 0.0010000001),
    (0.000000000000000000000101, 0.0),
    (sqrt(2.0) * sqrt(2.0), 2.0),
    (-sqrt(2.0) * sqrt(2.0), 2.0),
    (100000000000000003.0, 100000000000000004.0),
    (3.14159265358979323846, 3.14159265358979324)
]

for (left, right) in pairs do
    write_line("{left,26} {right,26}  {left ≈ right}")
od
