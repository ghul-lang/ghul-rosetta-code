use default

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read, and `count` reads it all
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

power_set[T](values: T[]) -> LIST[LIST[T]] is
    if values.count == 0 then
        let empty = _()
        empty.add(LIST())

        return empty
    fi

    let first = values[0]
    let result = _()
    for subset in power_set(values |> skip(1) |> list()) do
        let with_first = _()
        with_first.add(first)
        with_first.add_range(subset)

        result.add(subset)
        result.add(with_first)
    od

    return result
si

braced[T](values: T{}) -> string => "{{{values |> join(", ")}}}"

show[T](sets: LIST[LIST[T]]) -> string => braced(sets |> map(braced))

write_line(show(power_set(LIST[int]())))
write_line(show(power_set([1, 2, 3])))
write_line(show(power_set(["a", "b"])))
