use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `ARRAY[T]` is a fixed-size, read-only array
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `case ... when` pattern-matches, and `[x, ..rest]` matches a list head
//  and tail

power_set[T](values: T[]) -> T[][] =>
    case values
    when [] then [[]]
    when [first, ..rest] then
        let subsets = power_set(rest) in
        subsets ++ [[first] ++ subset |> list() for subset in subsets]
            |> list()
    esac

braced[T](values: T{}) -> string => "{{{values |> join(", ")}}}"

show[T](sets: T[][]) -> string => braced(sets |> map(braced))

write_line(show(power_set(ARRAY[int]([]))))
write_line(show(power_set([1, 2, 3])))
write_line(show(power_set(["a", "b"])))
