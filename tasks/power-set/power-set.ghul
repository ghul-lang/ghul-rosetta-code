use default

power_set[T](values: T[]) -> T[][] =>
    case values
    when [] then [[]]
    when [first, ..rest] then
        power_set(rest)
            |> flat_map(subset => [subset, [first] ++ subset |> list()])
            |> list()
    esac

write_line("{power_set([])}")
write_line("{power_set([1, 2, 3])}")
write_line("{power_set(["a", "b"])}")
