use default

balanced(n: int) -> bool =>
    let pairs = digits(n) |> windows(2) |> collect() in
    pairs |> count(pair => pair[0] < pair[1]) ==
    pairs |> count(pair => pair[0] > pair[1])

sequence() -> int{} => from(1) |> filter(balanced)

write_line("the first 200 numbers with equal rises and falls:")

let first_200 = sequence() |> take(200) |> collect()

for row in 0::19 do
    write_line(
        (0::9)
        |> map(column => "{first_200[row * 10 + column],5}")
        |> join(""))
od

let ten_millionth = sequence() |> skip(10000000 - 1) |> first()

write_line("the 10000000th is {ten_millionth}")
