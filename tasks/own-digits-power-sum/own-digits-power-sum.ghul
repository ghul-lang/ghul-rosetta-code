use default

power(base: int, exponent: int) -> long =>
    repeat(long(base), exponent) |> product()

digit_counts(value: long) -> LIST[int] is
    walk(remaining: long) -> LIST[int] =>
        if remaining == 0L then
            repeat(0, 10) |> collect_mutable()
        else (
            let counts = walk(remaining / 10L)
            counts[int(remaining % 10L)] = counts[int(remaining % 10L)] + 1
            counts
        )
        fi

    walk(value)
si

held(combination: LIST[int], digit: int) -> int =>
    combination |> count(* == digit)

multisets(width: int, lowest: int, chosen: LIST[int]) -> LIST[int]{} is
    if chosen.count == width then
        yield chosen
    else
        for digit in lowest::9 do
            let extended = LIST(chosen)

            extended.add(digit)

            yield in multisets(width, digit, extended)
        od
    fi
si

own_sums(width: int) -> long{} is
    for combination in multisets(width, 0, LIST()) do
        let total = combination |> map(power(*, width)) |> sum()

        if "{total}".length == width then
            let counts = digit_counts(total)

            if (0::9) |> all(d => counts[d] == held(combination, d)) then
                yield total
            fi
        fi
    od
si

for width in 3::9 do
    let found = own_sums(width) |> collect_mutable()

    found.sort()

    write_line("{width} digits: {found |> map(v => "{v}") |> join(" ")}")
od
