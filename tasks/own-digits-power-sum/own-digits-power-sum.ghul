use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `LIST()` builds its collection eagerly
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`
// `==` compares identity

power(base: int, exponent: int) -> long =>
    repeat(long(base), exponent) |> product()

digit_counts(value: long) -> int[] =>
    let found = value |> digits() |> list() in
    0::9 |> map(d => found |> count(* == long(d))) |> list()

held(combination: int[], digit: int) -> int =>
    combination |> count(* == digit)

multisets(width: int, lowest: int, chosen: int[]) -> int[]{} is
    if chosen.count == width then
        yield chosen
    else
        for digit in lowest::9 do
            yield in multisets(width, digit, chosen ++ [digit] |> list())
        od
    fi
si

own_sums(width: int) -> long{} is
    for combination in multisets(width, 0, []) do
        let total = combination |> map(power(*, width)) |> sum()

        if "{total}".length == width then
            let counts = digit_counts(total)

            if (0::9) |> all(d => counts[d] == held(combination, d)) then
                yield total
            fi
        fi
    od
si

for width in 3::9 do
    let found = own_sums(width) |> LIST()

    found.sort()

    write_line("{width} digits: {found |> map(v => "{v}") |> join(" ")}")
od
