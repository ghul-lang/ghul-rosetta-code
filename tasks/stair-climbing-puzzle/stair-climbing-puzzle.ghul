use default
use IO.Std.write

step_up() => while !step() do step_up() od

let random mut = Ghul.RANDOM(0)

step() -> bool is
    let up = random.next_double() < 0.5
    write(if up then " up" else " down" fi)
    up
si

for seed in 1::5 do
    random = Ghul.RANDOM(seed)
    write("seed {seed}:")
    step_up()
    write_line("")
od
