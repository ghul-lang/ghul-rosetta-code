use default
use System.Math.*


legendre(n: int, x: double) -> (value: double, slope: double) is
    let previous mut = 1.0
    let current mut = x

    for k in 2::n do
        let order = double(k)
        let next =
            ((2.0 * order - 1.0) * x * current - (order - 1.0) * previous) /
            order
        (previous, current) = (current, next)
    od

    let slope = double(n) * (x * current - previous) / (x * x - 1.0)

    (value = current, slope = slope)
si

root(n: int, i: int) -> double is
    let guess = (double(i) - 0.25) / (double(n) + 0.5)
    let x mut = cos(pi * guess)

    for _ in 1::100 do
        let p = legendre(n, x)
        x = x - p.value / p.slope
    od

    x
si

nodes_and_weights(n: int) -> List[(node: double, weight: double)] =>
    1::n
        |> map(i =>
            let x = root(n, i) in
            let slope = legendre(n, x).slope in
            (node = x, weight = 2.0 / ((1.0 - x * x) * slope * slope)))
        |> collect()

integrate(f: double -> double, a: double, b: double, n: int) -> double =>
    let half = (b - a) / 2.0 in
    let middle = (a + b) / 2.0 in
    half * (nodes_and_weights(n)
        |> sum_by(nw => nw.weight * f(half * nw.node + middle)))

write_line("Nodes and weights for 5 points:")

for (node, weight) in nodes_and_weights(5) do
    write_line("{node,14:F10}{weight,14:F10}")
od

write_line()
let estimate = integrate(x => exp(x), -3.0, 3.0, 5)

write_line("exp(x) from -3 to 3: {estimate:F10}")
write_line("exact:               {exp(3.0) - exp(-3.0):F10}")
