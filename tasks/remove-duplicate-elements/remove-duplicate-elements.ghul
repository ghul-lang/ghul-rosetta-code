use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `SET()` builds a collection eagerly

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `LIST()`, `SET()`, `MAP()` and `ARRAY()` build the collection eagerly.

let values = [
    1, 2, 3, "a", "b", "c", 2, 3, 4, "b", "v", "d", "a"
]

write_line(values |> distinct() |> join())

let words = ["pear", "apple", "pear", "quince", "apple"]

write_line(words |> SET() |> sort() |> join())
