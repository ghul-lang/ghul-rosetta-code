use default
use Raster.IMAGE

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`
// `==` compares identity

let inner = cos(0.4D * pi) / cos(0.2D * pi)

corner(index: int) -> (x: double, y: double) => (
    let radius = if index % 2 == 0 then 1.0D else inner fi
    let angle = (90.0D + 36.0D * double(index)) * pi / 180.0D

    (x = radius * cos(angle), y = radius * sin(angle))
)

let image = IMAGE(500, 500)

image.view(-1.12D, -1.12D, 1.12D, 1.12D)

image.colour(100ub, 149ub, 237ub)
image.fill(0..10 |> map(corner) |> list())

image.colour(64ub, 64ub, 64ub)
image.stroke(4.0D)
image.line((0::5) |> map(* * 4) |> map(* % 10) |> map(corner) |> list())

image.write("pentagram.png")

image.show("pentagram.png")
