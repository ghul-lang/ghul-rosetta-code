use default
use Raster.IMAGE
use System.Math.*

let inner = cos(0.4D * pi) / cos(0.2D * pi)

corner(index: int) -> (x: double, y: double) => (
    let radius = if index % 2 == 0 then 1.0D else inner fi
    let angle = (90.0D + 36.0D * double(index)) *
            pi / 180.0D

    (x = radius * cos(angle),
     y = radius * sin(angle))
)

let image = IMAGE(500, 500)

image.view(-1.12D, -1.12D, 1.12D, 1.12D)

image.colour(100ub, 149ub, 237ub)
image.fill(0..10 |> map(corner) |> collect())

image.colour(64ub, 64ub, 64ub)
image.stroke(4.0D)
image.line(
    (0::5)
        |> map(* * 4)
        |> map(* % 10)
        |> map(corner)
        |> collect()
)

image.write("pentagram.png")

image.show("pentagram.png")
