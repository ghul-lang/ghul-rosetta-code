use default

// `==` compares identity
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `*` as an argument leaves that parameter open: partial application.

power(value: int, exponent: int) -> int =>
    if exponent == 0 then
        1
    else
        value * power(value, exponent - 1)
    fi

is_narcissistic(number: int) -> bool =>
    let width = number |> digits() |> count() in
    number |> digits() |> map(power(*, width)) |> sum() == number

let narcissistic =
    from(0)
        |> filter(is_narcissistic)
        |> take(25)
        |> map(number => "{number}")
        |> join(" ")

write_line(narcissistic)
