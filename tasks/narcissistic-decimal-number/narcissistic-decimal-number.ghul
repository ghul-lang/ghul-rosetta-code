use default

power(value: int, exponent: int) -> int =>
    if exponent == 0 then 1 else value * power(value, exponent - 1) fi

is_narcissistic(number: int) -> bool =>
    let width = digits(number) |> count() in
    digits(number) |> map(d => power(d, width)) |> sum() == number

let narcissistic = from(0)
    |> filter(is_narcissistic)
    |> take(25)
    |> map(number => "{number}")
    |> join(" ")

write_line(narcissistic)
