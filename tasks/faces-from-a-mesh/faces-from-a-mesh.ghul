use default
use Edge = (from: int, to: int)

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `MAP[K, V]` is a mutable map from keys to values
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `=~` compares values (structural equality) - `==` compares identity
// `if let` pattern-matches, and `[x, ..rest]` matches a list head and tail

rotations(face: int[]) -> int[]{} =>
    0..face.count
        |> map(offset =>
            0..face.count
                |> map(index => face[(index + offset) % face.count])
                |> list()
        )

same_perimeter(one: int[], other: int[]) -> bool =>
    one.count == other.count /\
    other |> rotations() |> any(turned => turned =~ one)

perimeter(edges: Edge[]) -> int[]? is
    let neighbours = MAP()

    let join = (a, b) is
        if !neighbours.contains_key(a) then
            neighbours[a] = LIST()
        fi

        neighbours[a].add(b)
    si

    for (from, to) in edges do
        join(from, to)
        join(to, from)
    od

    if neighbours |> any((vertex, ends) => ends.count != 2) then
        return null
    fi

    let start = edges[0].from

    walk_from(previous: int, current: int) -> int{} is
        if current != start then
            let ends = neighbours[current]

            yield current
            let next =
                if ends[0] == previous then
                    ends[1]
                else
                    ends[0]
                fi

            yield in walk_from(current, next)
        fi
    si

    let walk = ([start] ++ walk_from(start, edges[0].to)) |> list()

    return if walk.count == edges.count then walk else null fi
si

edges(pairs: (int, int)[]) -> Edge[] =>
    pairs |> map((from, to) => (from = from, to = to)) |> list()

let perimeters = [
    (name = "Q", face = [8, 1, 3], against = "R", other = [1, 3, 8]),
    (
        name = "U",
        face = [18, 8, 14, 10, 12, 17, 19],
        against = "V",
        other = [8, 14, 10, 12, 17, 19, 18]
    )
]

for (name, face, against, other) in perimeters do
    let verdict =
        if same_perimeter(face, other) then
            "same"
        else
            "different"
        fi

    write_line("{name} and {against}: {verdict}")
od

let faces = [
    (name = "E", sides = edges([(1, 11), (7, 11), (1, 7)])),
    (name = "F", sides = edges([(11, 23), (1, 17), (17, 23), (1, 11)])),
    (
        name = "G",
        sides = edges([
            (8, 14), (17, 19), (10, 12), (10, 14), (12, 17),
            (8, 18), (18, 19)
        ])
    ),
    (name = "H", sides = edges([(1, 3), (9, 11), (3, 11), (1, 11)]))
]

for (name, sides) in faces do
    if let walk = perimeter(sides) then
        write_line("{name}: {$walk}")
    else
        write_line("{name}: not a simple face")
    fi
od
