use default
use Edge = (from: int, to: int)

rotations(face: List[int]) -> LIST[int]{} =>
    0..face.count
        |> map(offset =>
            0..face.count
                |> map(index => face[(index + offset) % face.count])
                |> collect_mutable())

same_perimeter(one: List[int], other: List[int]) -> bool =>
    one.count == other.count /\
    rotations(other) |> any(turned => turned =~ one)

perimeter(edges: List[Edge]) -> List[int]? is
    let neighbours = MAP()

    let join = (a, b) is
        if !neighbours.contains_key(a) then
            neighbours[a] = LIST()
        fi

        neighbours[a].add(b)
    si

    for (from, to) in edges do
        join(from, to)
        join(to, from)
    od

    if neighbours |> any((vertex, ends) => ends.count != 2) then
        return null
    fi

    let start = edges[0].from

    let walk = LIST([start])

    let previous mut = start
    let current mut = edges[0].to

    while current != start do
        walk.add(current)

        let ends = neighbours[current]

        let next = if ends[0] == previous then ends[1] else ends[0] fi

        previous = current
        current = next
    od

    return
        if walk.count == edges.count then walk else null fi
si

edges(pairs: List[(int, int)]) -> List[Edge] =>
    pairs |> map((from, to) => (from = from, to = to)) |> collect()

let perimeters =
    [(name = "Q", face = [8, 1, 3], against = "R", other = [1, 3, 8]),
     (name = "U", face = [18, 8, 14, 10, 12, 17, 19],
      against = "V", other = [8, 14, 10, 12, 17, 19, 18])]

for (name, face, against, other) in perimeters do
    let verdict =
        if same_perimeter(face, other) then "same" else "different" fi

    write_line("{name} and {against}: {verdict}")
od

let faces =
    [(name = "E", sides = edges([(1, 11), (7, 11), (1, 7)])),
     (name = "F", sides = edges([(11, 23), (1, 17), (17, 23), (1, 11)])),
     (name = "G",
      sides = edges([(8, 14), (17, 19), (10, 12), (10, 14), (12, 17),
                     (8, 18), (18, 19)])),
     (name = "H", sides = edges([(1, 3), (9, 11), (3, 11), (1, 11)]))]

for (name, sides) in faces do
    if let walk = perimeter(sides) then
        write_line("{name}: {$walk}")
    else
        write_line("{name}: not a simple face")
    fi
od
