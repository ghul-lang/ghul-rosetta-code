use default

let rows = 7
let columns = 8

use Grid = List[List[int]]

parse(lines: List[string]) -> Grid =>
    lines
        |> map(line =>
            line |> map(c => int(c - '0')) |> collect())
        |> collect()

solve(grid: Grid) -> List[int]? is
    let partner = repeat(-1, rows * columns) |> collect_mutable()
    let used = SET()

    value(cell) => grid[cell / columns][cell % columns]

    domino(a, b) =>
        let x = value(a), y = value(b) in
        if x < y then x * 7 + y else y * 7 + x fi

    place(from) is
        let cell mut = from

        while cell < rows * columns /\ partner[cell] >= 0 do
            cell = cell + 1
        od

        if cell == rows * columns then
            return true
        fi

        let right =
            if cell % columns < columns - 1 then cell + 1 else -1 fi
        let down =
            if cell / columns < rows - 1 then cell + columns else -1 fi

        for other in [right, down] do
            if other >= 0 /\ partner[other] < 0 then
                let key = domino(cell, other)

                if used.add(key) then
                    partner[cell] = other
                    partner[other] = cell

                    if place(cell + 1) then
                        return true
                    fi

                    partner[cell] = -1
                    partner[other] = -1
                    used.remove(key)
                fi
            fi
        od

        false
    si

    if place(0) then partner else null fi
si

show(grid: Grid, partner: List[int]) is
    for row in 0..rows do
        let cells =
            0..columns
                |> map(column =>
                    let cell = row * columns + column in
                    let joined = partner[cell] == cell + 1 in
                    let gap = if joined then "-" else " " fi in
                    "{grid[row][column]}{gap}")
                |> join("")

        write_line(cells.trim_end())

        if row < rows - 1 then
            let links =
                0..columns
                    |> map(column =>
                        let cell = row * columns + column in
                        let below = partner[cell] == cell + columns in
                        if below then "| " else "  " fi)
                    |> join("")

            write_line(links.trim_end())
        fi
    od
si

shuffled_tableau(random: System.Random) -> Grid is
    let tiles =
        [(a, b) for a in 0::6 for b in a::6]
            |> sort_by(_ => random.next())

    let grid =
        0..rows
            |> map(_ => repeat(0, columns) |> collect_mutable())
            |> collect()

    for (i, (a, b)) in tiles |> index() do
        let row = i / 4, column = (i % 4) * 2
        let flip = random.next(2) == 1
        let (left, right) = if flip then (b, a) else (a, b) fi

        grid[row][column] = left
        grid[row][column + 1] = right
    od

    grid
si

let tableaux = [
    parse([
        "05132231", "05505246", "43036620", "06235126",
        "11300245", "21433466", "64515414"
    ]),
    shuffled_tableau(System.Random(5))
]

for grid in tableaux do
    for row in grid do
        write_line(row |> join(""))
    od

    write_line("")

    if let partner = solve(grid) then
        show(grid, partner)
    else
        write_line("no arrangement found")
    fi

    write_line("")
od
