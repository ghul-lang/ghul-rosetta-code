use default

use Ordering = (string, string) -> int
use Row = string[]

lexicographic(left: string, right: string) -> int =>
    left <> right

sort_table(rows: List[Row]) -> List[Row] => sort_table(rows, 0)

sort_table(rows: List[Row], column: int) -> List[Row] =>
    sort_table(rows, column, lexicographic)

sort_table(
    rows: List[Row],
    column: int,
    ordering: Ordering
) -> List[Row] => sort_table(rows, column, ordering, false)

sort_table(
    rows: List[Row],
    column: int,
    ordering: Ordering,
    reverse: bool
) -> List[Row] =>
    rows
        |> sort((left, right) =>
            if reverse then
                ordering(right[column], left[column])
            else
                ordering(left[column], right[column])
            fi
        )
        |> collect()

by_length(left: string, right: string) -> int =>
    left.length <> right.length

show(caption: string, rows: List[Row]) is
    write_line(caption)

    for row in rows do
        write_line("  {row |> join(" ")}")
    od
si

let table = [
    ["a", "bbbb", "ccc"],
    ["c", "aa", "bbb"],
    ["b", "ccc", "aaa"]
]

show("default", table |> sort_table())
show("by column 2", table |> sort_table(2))
show("by length of column 1", table |> sort_table(1, by_length))
show("reversed", table |> sort_table(0, lexicographic, true))

show(
    "named, in any order",
    sort_table(
        reverse = true,
        rows = table,
        ordering = lexicographic,
        column = 2
    )
)
