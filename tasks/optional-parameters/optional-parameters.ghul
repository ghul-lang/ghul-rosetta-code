use default

use Ordering = (string, string) -> int
use Row = string[]

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

lexicographic(left: string, right: string) -> int => left <> right

sort_table(rows: Row[]) -> Row[] => sort_table(rows, 0)

sort_table(rows: Row[], column: int) -> Row[] =>
    sort_table(rows, column, lexicographic)

sort_table(rows: Row[], column: int, ordering: Ordering) -> Row[] =>
    sort_table(rows, column, ordering, false)

sort_table(
    rows: Row[],
    column: int,
    ordering: Ordering,
    reverse: bool
) -> Row[] =>
    rows
        |> sort((left, right) =>
            if reverse then
                ordering(right[column], left[column])
            else
                ordering(left[column], right[column])
            fi
        )
        |> list()

by_length(left: string, right: string) -> int => left.length <> right.length

show(caption: string, rows: Row[]) is
    write_line(caption)

    for row in rows do
        write_line("  {row |> join(" ")}")
    od
si

let table = [
    ["a", "bbbb", "ccc"],
    ["c", "aa", "bbb"],
    ["b", "ccc", "aaa"]
]

show("default", table |> sort_table())
show("by column 2", table |> sort_table(2))
show("by length of column 1", table |> sort_table(1, by_length))
show("reversed", table |> sort_table(0, lexicographic, true))

show(
    "named, in any order",
    sort_table(
        reverse = true,
        rows = table,
        ordering = lexicographic,
        column = 2
    )
)
