use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

cubans() -> long{} =>
    from(1L) |> map(n => 3L * n * n + 3L * n + 1L) |> filter(is_prime)

write_line("the first 200 cuban primes:")

let head = cubans() |> take(200) |> map(p => "{p,12:N0}") |> list()

for row in 0..25 do
    write_line(head[row * 8..row * 8 + 8] |> join(""))
od

let hundred_thousandth = cubans() |> skip(99_999) |> first()

let largest = hundred_thousandth!

write_line("")
write_line("the 100,000th cuban prime is {largest:N0}")
