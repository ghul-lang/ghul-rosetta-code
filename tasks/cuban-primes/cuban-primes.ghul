use default

cubans() -> long{} =>
    from(1L)
        |> map(n => 3L * n * n + 3L * n + 1L)
        |> filter(is_prime)

write_line("the first 200 cuban primes:")

let head = cubans() |> take(200) |> map(p => "{p,12:N0}") |> collect()

for row in 0..25 do
    write_line(head[row * 8..row * 8 + 8] |> join(""))
od

let hundred_thousandth = cubans() |> skip(99_999) |> first()

let largest = hundred_thousandth!

write_line("")
write_line("the 100,000th cuban prime is {largest:N0}")
