use default

// `SET()` builds its collection eagerly
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

reversed(word: string) -> string => word |> reverse() |> join("")

let words = [
    word.to_lower()
    for word in IO.File.read_lines("words.txt")
    if word.length > 6
]
    |> SET()

let pairs =
    words
        |> sort()
        |> map(word => (word, reversal = reversed(word)))
        |> filter((word, reversal) =>
            word < reversal /\ words.contains(reversal)
        )

for (word, reversal) in pairs do
    write_line("{word,9} <-> {reversal}")
od
