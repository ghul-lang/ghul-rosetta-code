use default

write_line("searching for seeds, which takes a moment")
write_line("")

is_seed(n: long) -> bool =>
    let big = bigint(n) in
    1::4 |> all(k => is_prime(bigint.pow(big, k) + big + 1n))

let seeds = LIST()
let milestones = LIST[(limit: long, seed: long, index: int)]()
let next_milestone mut = 1_000_000L
let n mut = 1L

while next_milestone <= 3_000_000L do
    if is_seed(n) then
        seeds.add(n)

        if n > next_milestone then
            milestones.add((next_milestone, n, seeds.count))
            next_milestone = next_milestone + 1_000_000L
        fi
    fi

    n = n + 1L
od

write_line("First fifty quad-power prime seeds:")

for row in 0..5 do
    let cells = seeds |> skip(row * 10) |> take(10)

    write_line(cells |> map(s => "{s,8}") |> join(""))
od

write_line("")

for (limit, seed, index) in milestones do
    write_line("First over {limit,10:N0}: {seed,10:N0}, index {index}")
od
