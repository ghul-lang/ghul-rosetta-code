use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

running_sums(values: int{}) -> (length: int, last: int, sum: int){} is
    let length mut = 0
    let total mut = 0

    for value in values do
        length = length + 1
        total = total + value

        yield (length = length, last = value, sum = total)
    od
si

let summaries =
    (2..1000)
        |> filter(is_prime)
        |> running_sums()
        |> filter(summary => is_prime(summary.sum))
        |> list()

write_line("length    last     sum")

summaries
    |> each(summary =>
        write_line("{summary.length,6}{summary.last,8}{summary.sum,8}")
    )

write_line()
write_line("{summaries.count} such sequences below 1000")
