use default

running_sums(values: int{}) -> (
    length: int,
    last: int,
    sum: int
){} is
    let length mut = 0
    let total mut = 0

    for value in values do
        length = length + 1
        total = total + value

        yield (length = length, last = value, sum = total)
    od
si

let summaries =
    (2..1000)
        |> filter(is_prime)
        |> running_sums()
        |> filter(summary => is_prime(summary.sum))
        |> collect()

write_line("length    last     sum")

summaries
    |> each(summary =>
        write_line(
            "{summary.length,6}{summary.last,8}{summary.sum,8}"
        )
    )

write_line()
write_line("{summaries.count} such sequences below 1000")
