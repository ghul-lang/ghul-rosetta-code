use default

count(limit: long) -> (total: long, primitive: long) is
    let total mut = 0L
    let primitive mut = 0L
    let m mut = 2L

    while 2L * m * (m + 1L) <= limit do
        let n mut = if m % 2L == 0L then 1L else 2L fi

        while n < m /\ 2L * m * (m + n) <= limit do
            if gcd(m, n) == 1L then
                primitive = primitive + 1L
                total = total + limit / (2L * m * (m + n))
            fi

            n = n + 2L
        od

        m = m + 1L
    od

    (total, primitive)
si

for limit in 2::8 |> map(k => repeat(10L, k) |> product()) do
    let (total, primitive) = count(limit)

    write_line(
        "Perimeter up to {limit,11:N0}: {total,11:N0} triples, "
        "{primitive,10:N0} primitive"
    )
od
