use default
use Raster.IMAGE

use Eisenstein = (a: int, b: int)

norm(e) => e.a * e.a - e.a * e.b + e.b * e.b

is_eisenstein_prime(e) =>
    if e.a == 0 \/ e.b == 0 \/ e.a == e.b then
        let p = max(abs(e.a), abs(e.b)) in
        is_prime(p) /\ p % 3 == 2
    else
        is_prime(norm(e))
    fi

real(e) => double(e.a) - double(e.b) / 2.0

imaginary(e) => double(e.b) * sqrt(3.0) / 2.0

show(e) =>
    let
        im = imaginary(e),
        sign = if im < 0.0 then "-" else "+" fi
    in
        "{real(e),8:F4} {sign} {abs(im):F4}i"

let reach = 60

let primes = [(a = a, b = b) for a in -reach::reach for b in -reach::reach]
    |> filter(is_eisenstein_prime)
    |> sort((x, y) =>
        if norm(x) != norm(y) then norm(x) - norm(y)
        elif x.b != y.b then x.b - y.b
        else x.a - y.a
        fi
    )

write_line("the first 100 Eisenstein primes, nearest 0 first:")

for row in 0..25 do
    let four = primes |> skip(row * 4) |> take(4)

    write_line(four |> map(show) |> join("  "))
od

let plotted = primes |> take(2000) |> list()
let largest = plotted[plotted.count - 1]

write_line("")
write_line("plotted the first 2000, out to norm {norm(largest)}")

let image = IMAGE(400, 400)
let extent = sqrt(double(norm(largest))) * 1.05

image.view(-extent, -extent, extent, extent)
image.clear(10ub, 12ub, 25ub)
image.color(120ub, 200ub, 255ub)

for e in plotted do
    image.dot(real(e), imaginary(e), 1.6)
od

image.write("eisenstein.png")

image.show("eisenstein.png")
