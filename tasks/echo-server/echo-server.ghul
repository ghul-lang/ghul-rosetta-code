use default
use System.Net.IPAddress
use System.Net.Sockets.TcpClient
use System.Net.Sockets.TcpListener
use System.Threading.Thread

echo(client: TcpClient, number: int, log: (string) -> void) is
    let stream = client.get_stream()
    let reader = IO.StreamReader(stream), writer = IO.StreamWriter(stream)

    writer.auto_flush = true

    log("client {number} connected")

    while let line = reader.read_line() do
        log("client {number} said {line}")
        writer.write("{line}\r\n")
    od

    log("client {number} went away")

    client.dispose()
si

// each client gets its own thread, so one that stalls holds up no other
serve(listener: TcpListener, log: (string) -> void) is
    for number in from(1) do
        let client = listener.accept_tcp_client()

        Thread(() => echo(client, number, log)).start()
    od
si

let listener = TcpListener(IPAddress.loopback, 12321)

listener.start()

serve(listener, line => write_line(line))
