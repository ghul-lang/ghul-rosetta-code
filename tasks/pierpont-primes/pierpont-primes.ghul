use default

three_smooth() -> bigint{} is
    let found = LIST()
    let next_double mut = 0
    let next_triple mut = 0
    let value mut = 1n

    do
        found.add(value)

        yield value

        let doubled = found[next_double] * 2n
        let tripled = found[next_triple] * 3n

        value =
            if doubled < tripled then doubled else tripled fi

        if doubled =~ value then
            next_double = next_double + 1
        fi
        if tripled =~ value then
            next_triple = next_triple + 1
        fi
    od
si

pierpont(offset: bigint) -> bigint{} =>
    three_smooth() |> map(* + offset) |> filter(is_prime)

report(kind: string, offset: bigint) is
    let found = pierpont(offset) |> take(250) |> collect()

    write_line("first 50 Pierpont primes of the {kind} kind:")

    found
        |> take(50)
        |> chunk(10)
        |> each(row =>
            write_line(
                row |> map(prime => "{prime,9}") |> join("")
            )
        )

    write_line("250th: {found[249]}")
    write_line()
si

report("first", 1n)
report("second", -1n)
