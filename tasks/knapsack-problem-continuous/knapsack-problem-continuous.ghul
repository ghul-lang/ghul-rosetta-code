use default

use Item = (name: string, weight: double, value: double)

let items =
    [
        (name = "beef", weight = 3.8, value = 36.0),
        (name = "pork", weight = 5.4, value = 43.0),
        (name = "ham", weight = 3.6, value = 90.0),
        (name = "greaves", weight = 2.4, value = 45.0),
        (name = "flitch", weight = 4.0, value = 30.0),
        (name = "brawn", weight = 2.5, value = 56.0),
        (name = "welt", weight = 3.7, value = 67.0),
        (name = "salami", weight = 3.0, value = 95.0),
        (name = "sausage", weight = 5.9, value = 98.0)
    ]

let capacity = 15.0

let taken = LIST()

let remaining mut = capacity

let by_density =
    items |> sort((a, b) => b.value / b.weight <> a.value / a.weight)

for item in by_density do
    if remaining <= 0.0 then
        break
    fi

    let portion = System.Math.min(item.weight, remaining)

    taken.add(
        (
            name = item.name,
            portion = portion,
            value = item.value * portion / item.weight))

    remaining = remaining - portion
od

write_line("    ITEM   PORTION VALUE")

for (name, portion, value) in taken do
    write_line("{name,10} {portion,5:F2} {value,6:F2}")
od

let total_weight = taken |> sum_by(t => t.portion)
let total_value = taken |> sum_by(t => t.value)

write_line("")
write_line("TOTAL WEIGHT: {total_weight:F2}")
write_line("TOTAL VALUE: {total_value:F2}")
