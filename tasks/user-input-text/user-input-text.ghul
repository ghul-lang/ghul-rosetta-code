use default
use IO.Std.write
use IO.Std.read_line

ask(prompt: string) -> string? is
    write(prompt)
    read_line()
si

read_75000() -> int? =>
    while let line = ask("integer: ") do
        let value mut = 0

        if
            int.try_parse(line, value ref ) /\ value == 75000
        then
            break value
        fi

        write_line("please enter 75000")
    od

if let text = ask("string: "), number = read_75000() then
    write_line(
        "read the string {text} and the integer {number}"
    )
fi
