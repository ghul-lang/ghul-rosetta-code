use default
use System.Math.*
use Raster.IMAGE
use Raster.AXES

is_gaussian_prime(a: int, b: int) -> bool =>
    case (a, b)
    when (0, 0) then false
    when (0, b) then is_prime(abs(b)) /\ abs(b) % 4 == 3
    when (a, 0) then is_prime(abs(a)) /\ abs(a) % 4 == 3
    else is_prime(a * a + b * b)
    esac

let primes_under_100 =
    [(a = a, b = b)
        for a in -10::10 for b in -10::10
        if a * a + b * b < 100 /\ is_gaussian_prime(a, b)]

let count = primes_under_100.count
let listing = primes_under_100
    |> map(p => "{p.a}{if p.b >= 0 then "+" else "" fi}{p.b}i")
    |> join()

write_line("gaussian primes with norm < 100 ({count} total):")
write_line(listing)

let image = IMAGE(620, 620)

let axes = AXES(image)

axes.x_title = "real"
axes.y_title = "imaginary"
axes.fit(-54.0D, -54.0D, 54.0D, 54.0D)

image.colour(90ub, 90ub, 100ub)
image.stroke(1.0D)

axes.draw()

image.colour(40ub, 92ub, 168ub)

for b in -50::50 do
    for a in -50::50 do
        if a * a + b * b <= 50 * 50 /\ is_gaussian_prime(a, b) then
            image.dot(double(a), double(b), 2.0D)
        fi
    od
od

image.write("gaussian-primes.png")

image.show("gaussian-primes.png")
