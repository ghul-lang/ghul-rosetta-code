use default

use Implicant = (bits: int, dashes: int)

ones(value: int) -> int => digits(value, 2) |> sum()

covers(implicant: Implicant, minterm: int) -> bool =>
    (minterm & \implicant.dashes) == implicant.bits

render(implicant: Implicant, variables: int) -> string =>
    0..variables
        |> map(position =>
            let bit = variables - 1 - position in
            if (implicant.dashes >> bit) & 1 == 1 then 'X'
            elif (implicant.bits >> bit) & 1 == 1 then '1'
            else '0'
            fi)
        |> string()

prime_implicants(minterms: List[int], variables: int) -> List[Implicant] is
    let primes = LIST()

    let current mut =
        minterms
            |> map(m => (bits = m, dashes = 0))
            |> distinct()
            |> collect()

    while current.count > 0 do
        let combined = LIST()
        let used = repeat(false, current.count) |> collect_mutable()

        for i in 0..current.count do
            for j in i + 1..current.count do
                let left = current[i]
                let right = current[j]

                if left.dashes != right.dashes then
                    continue
                fi

                let difference = left.bits ^ right.bits

                if ones(difference) != 1 then
                    continue
                fi

                used[i] = true
                used[j] = true

                combined.add(
                    (
                        bits = left.bits & \difference,
                        dashes = left.dashes | difference))
            od
        od

        for i in 0..current.count do
            if !used[i] then
                primes.add(current[i])
            fi
        od

        current = combined |> distinct() |> collect()
    od

    return primes |> distinct() |> collect()
si

// Every prime implicant that alone covers some minterm must be in the
// answer; the rest is the smallest set of the others that covers what is
// left, found by trying every combination in increasing size.
minimal_cover(minterms: List[int], variables: int) -> List[Implicant] is
    let primes = prime_implicants(minterms, variables)

    let essential =
        primes
            |> filter(prime =>
                minterms
                    |> any(m =>
                        covers(prime, m) /\
                        primes |> count(covers(*, m)) == 1))
            |> collect()

    let uncovered =
        minterms
            |> filter(m => !(essential |> any(covers(*, m))))
            |> collect()

    if uncovered.count == 0 then
        return essential
    fi

    let spare =
        primes |> filter(p => !(essential |> any(e => e =~ p))) |> collect()

    let found =
        1::spare.count
            |> find_map(size => smallest_choice(spare, uncovered, size))

    if let chosen = found then
        return essential ++ chosen |> collect()
    fi

    return essential
si

smallest_choice(
    spare: List[Implicant],
    uncovered: List[int],
    size: int
) -> List[Implicant]? =>
    let chosen = LIST() in
    search(spare, uncovered, size, 0, chosen)


search(
    spare: List[Implicant],
    uncovered: List[int],
    size: int,
    start: int,
    chosen: LIST[Implicant]
) -> List[Implicant]? is
    if chosen.count == size then
        if uncovered |> all(m => chosen |> any(covers(*, m))) then
            return chosen |> collect()
        fi

        return null
    fi

    for i in start..spare.count do
        chosen.add(spare[i])

        let found = search(spare, uncovered, size, i + 1, chosen)

        chosen.remove_at(chosen.count - 1)

        if found? then
            return found
        fi
    od

    return null
si

let examples = [([0, 1, 2, 5], 3), ([0, 1, 2, 5, 6, 7, 8, 9, 10, 14], 4)]

for (minterms, variables) in examples do
    let cover = minimal_cover(minterms, variables)

    write_line("minterms {minterms |> join(", ")}")
    write_line("  {cover |> map(render(*, variables)) |> join(" ")}")
od
