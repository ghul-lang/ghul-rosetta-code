use default

use Triple = (a: long, b: long, c: long)

exact_root(square: long) -> long? =>
    let estimate = System.Math.sqrt(double(square)) in
    let root = long(System.Math.round(estimate)) in
    if root * root == square then root else null fi

triples(k: long, limit: long) -> Pipe[Triple] =>
    1L::limit
        |> flat_map(a => a::limit |> map(b => (a, b)))
        |> map((a, b) =>
            (a = a, b = b, c = exact_root(a * a + b * b - k * a * b)))
        |> filter(t => t.c? /\ t.c! <= limit)
        |> map(t => (a = t.a, b = t.b, c = t.c!))

for (degrees, k) in [(90, 0L), (60, 1L), (120, -1L)] do
    let found = triples(k, 13L) |> collect()

    write_line("{degrees} degrees: {found.count} triples")

    for row in found |> chunk(5) do
        let shown = row |> map(t => "({t.a}, {t.b}, {t.c})")
        write_line("  {shown |> join(" ")}")
    od

    write_line()
od

let not_equilateral = triples(1L, 10_000L)
    |> filter(t => t.a != t.b)
    |> count()

write_line("60 degrees, sides to 10,000, not all equal: {not_equilateral}")
