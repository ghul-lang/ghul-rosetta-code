use default

use ENTRY = (score: int, name: string)
use RANKER = (int, int, int, int) -> string

let competitors = [
    (score = 44, name = "Solomon"),
    (score = 42, name = "Jason"),
    (score = 42, name = "Errol"),
    (score = 41, name = "Garry"),
    (score = 41, name = "Bernard"),
    (score = 41, name = "Barry"),
    (score = 39, name = "Stephen")
]

ties(entries) =>
    entries |> group_by(e => e.score) |> map((_, group) => group)

ranked(rank) is
    let ahead mut = 0
    let place mut = 0

    for tied in ties(competitors) do
        place = place + 1

        for member in 0..tied.count do
            yield
                "{rank(ahead, tied.count, member, place),5}  "
                "{tied[member].score} {tied[member].name}"
        od

        ahead = ahead + tied.count
    od
si

standard(ahead, size, member, place) =>
    "{ahead + 1}"

modified(ahead, size, member, place) =>
    "{ahead + size}"

dense(ahead, size, member, place) => "{place}"

ordinal(ahead, size, member, place) =>
    "{ahead + member + 1}"

fractional(ahead, size, member, place) =>
    "{double(ahead + ahead + size + 1) / 2.0:F1}"

let methods = [
    (name = "standard", rank = standard),
    (name = "modified", rank = modified),
    (name = "dense", rank = dense),
    (name = "ordinal", rank = ordinal),
    (name = "fractional", rank = fractional)
]

methods
    |> each(method => (
        write_line("{method.name} ranking:")

        ranked(method.rank) |> each(line => write_line("  {line}"))

        write_line()
    ))
