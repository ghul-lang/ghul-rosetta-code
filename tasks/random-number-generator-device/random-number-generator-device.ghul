use default

// `ARRAY[T]` is a fixed-size, read-only array
// `|> ARRAY()` reads the whole sequence into a new `ARRAY`
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

random_32_bits() -> uint is
    let use device = IO.File.open_read("/dev/urandom")

    let bytes = repeat(0ub, 4) |> ARRAY()

    let read mut = 0

    while read < bytes.count do
        let got = device.read(bytes, read, bytes.count - read)

        assert got > 0 else "/dev/urandom gave nothing"

        read = read + got
    od

    return
        (uint(bytes[0]) << 24) |
        (uint(bytes[1]) << 16) |
        (uint(bytes[2]) << 8) |
        uint(bytes[3])
si

for _ in 0..4 do
    write_line("{random_32_bits()}")
od
