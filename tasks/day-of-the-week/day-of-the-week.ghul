use default
use System

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

christmas_days() -> DateTime{} is
    for year in 2008::2121 do
        yield DateTime(year, 12, 25)
    od
si

let sundays =
    christmas_days()
        |> filter(christmas => christmas.day_of_week == DayOfWeek.SUNDAY)

write_line("Christmas falls on a Sunday in:")
sundays |> each(christmas => write_line("{christmas:yyyy}"))
