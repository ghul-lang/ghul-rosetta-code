use default

let add = a => b => a + b

write_line("add(2)(3) = {add(2)(3)}")

let add_ten = add(10)

write_line("add_ten(5) = {add_ten(5)}")
write_line("add_ten(32) = {add_ten(32)}")

curry[A, B, C](f: (A, B) -> C) -> (A) -> (B) -> C =>
    a => b => f(a, b)

uncurry[A, B, C](f: (A) -> (B) -> C) -> (A, B) -> C =>
    (a, b) => f(a)(b)

repeat_text(text: string, times: int) -> string =>
    string.join("", repeat(text, times) |> collect())

let curried = curry(repeat_text)

write_line("curried(\"ab\")(3) = {curried("ab")(3)}")
write_line("uncurry(curried)(\"-\", 5) = {uncurry(curried)("-", 5)}")

let plus = curry(add_int)

write_line("plus(7)(8) = {plus(7)(8)}")

add_int(a: int, b: int) -> int => a + b
