use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

bsd_rand(seed: int) -> int{} is
    let state mut = long(seed)

    do
        state = (1103515245L * state + 12345L) % 2147483648L
        yield cast(state)
    od
si

ms_rand(seed: int) -> int{} is
    let state mut = long(seed)

    do
        state = (214013L * state + 2531011L) % 2147483648L
        yield cast(state / 65536L)
    od
si

let bsd_text = bsd_rand(0) |> take(10) |> map(n => "{n}") |> join()
let ms_text = ms_rand(0) |> take(10) |> map(n => "{n}") |> join()

write_line("BSD rand, seed 0: {bsd_text}")
write_line("MS rand, seed 0: {ms_text}")
