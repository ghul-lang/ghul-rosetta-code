use default

sudan(order: int, left: bigint, right: bigint) -> bigint =>
    if order == 0 then left + right
    elif right.is_zero then left
    else
        let step = sudan(order, left, right - 1n)

        sudan(order - 1, step, step + right)
    fi

show(order: int, left: int, right: int) =>
    let value = sudan(order, cast(left), cast(right)) in
    write_line("F({order}, {left}, {right}) = {value}")

for right in 0::3 do
    show(0, 3, right)
od

for right in 0::3 do
    show(1, 3, right)
od

for right in 0::2 do
    show(2, 1, right)
od

show(3, 1, 1)
