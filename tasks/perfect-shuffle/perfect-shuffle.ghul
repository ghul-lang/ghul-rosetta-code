use default

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `=~` compares values (structural equality) - `==` compares identity

shuffle(deck: int[]) -> int[] =>
    let half = deck.count / 2 in
    0..deck.count
        |> map(i =>
            if i % 2 == 0 then
                deck[i / 2]
            else
                deck[half + i / 2]
            fi
        )
        |> list()

shuffles_needed(size: int) -> int is
    let original = 0..size |> list()

    walk(deck: int[], count: int) -> int =>
        if deck =~ original then count
        else walk(shuffle(deck), count + 1)
        fi

    walk(shuffle(original), 1)
si

for size in [8, 24, 52, 100, 1020, 1024, 10000] do
    write_line("{size,5} cards: {shuffles_needed(size),4} shuffles")
od
