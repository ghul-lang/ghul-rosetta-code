use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

let limit = 10_000_000

is_unprimeable(value: int) -> bool is
    if is_prime(value) then return false fi

    let place mut = 1

    while place <= value do
        let kept = value - value / place % 10 * place

        if 0::9 |> any(d => is_prime(kept + d * place)) then
            return false
        fi

        place = place * 10
    od

    true
si

unprimeables() -> int{} is
    let candidate mut = 99

    do
        candidate = candidate + 1

        if is_unprimeable(candidate) then
            yield candidate
        fi
    od
si

let terms = unprimeables() |> take(600) |> list()

write_line("the first 35 unprimeable numbers:")
write_line("  {terms[0..35] |> map(t => "{t}") |> join(" ")}")

write_line("")
write_line("the 600th unprimeable number is {terms[599]:N0}")

write_line("")
write_line("the lowest unprimeable number ending in each digit:")

for last in 0::9 do
    let lowest = (unprimeables() |> find(c => c % 10 == last))!

    write_line("  {last}: {lowest:N0}")
od
