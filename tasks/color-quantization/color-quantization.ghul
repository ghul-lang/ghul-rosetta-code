use default
use Raster.IMAGE

use Color = (red: int, green: int, blue: int)

scene() is
    let image = IMAGE(160, 120)

    for y in 0..80 do
        let t = double(y) / 80.0

        image.color(
            ubyte(40.0 + 200.0 * t),
            ubyte(70.0 + 100.0 * t),
            ubyte(160.0 - 60.0 * t)
        )
        image.fill_rectangle(0.0, double(y), 160.0, double(y + 1))
    od

    image.color(255ub, 220ub, 60ub)
    image.disc(112.0, 42.0, 15.0)

    image.color(90ub, 60ub, 120ub)
    image.fill([
        (0.0, 80.0),
        (45.0, 30.0),
        (95.0, 80.0)
    ])

    image.color(60ub, 110ub, 70ub)
    image.fill([
        (55.0, 80.0),
        (105.0, 48.0),
        (160.0, 80.0)
    ])

    image.color(70ub, 150ub, 60ub)
    image.fill_rectangle(0.0, 80.0, 160.0, 120.0)

    image.color(200ub, 35ub, 40ub)
    image.fill_rectangle(22.0, 88.0, 52.0, 110.0)

    image.color(120ub, 25ub, 30ub)
    image.fill([
        (18.0, 88.0),
        (37.0, 75.0),
        (56.0, 88.0)
    ])

    image.color(250ub, 245ub, 235ub)
    image.fill_rectangle(33.0, 97.0, 41.0, 110.0)

    image
si

hue(h) =>
    let
        part = (h * 6.0) - floor(h * 6.0),
        sector = int(h * 6.0) % 6,
        up = int(255.0 * part),
        down = int(255.0 * (1.0 - part))
    in
        case sector
        when 0 then (255, up, 0)
        when 1 then (down, 255, 0)
        when 2 then (0, 255, up)
        when 3 then (0, down, 255)
        when 4 then (up, 0, 255)
        else (255, 0, down)
        esac

put(image: IMAGE, x: int, y: int, c: Color) is
    image.set_pixel(x, y, ubyte(c.red), ubyte(c.green), ubyte(c.blue))
si

of(p) => (
    red = int(p.red),
    green = int(p.green),
    blue = int(p.blue)
)

picture() is
    let image = scene()

    for x in 0..image.width do
        let c = hue(double(x) / double(image.width))

        for y in 0..8 do
            put(image, x, y, c)
        od
    od

    image
si

use Weighted = (color: Color, count: int)

channel(c, axis) =>
    case axis
    when 0 then c.red
    when 1 then c.green
    else c.blue
    esac

spread(box, axis) =>
    let values = box |> map(w => channel(w.color, axis)) in
    (values |> max()!) - (values |> min()!)

widest(box) => 0..3 |> max_by(spread(box, *))!

score(box) => spread(box, widest(box))

split(box) is
    let axis = widest(box)
    let sorted =
        box
            |> sort((a, b) =>
                channel(a.color, axis) - channel(b.color, axis)
            )
            |> list()

    let total = sorted |> sum_by(w => w.count)

    walk(cut: int, seen: int) -> int =>
        if cut < sorted.count - 1 /\ seen < total / 2 then
            walk(cut + 1, seen + sorted[cut].count)
        else
            cut
        fi

    let cut = walk(1, sorted[0].count)

    (sorted |> take(cut) |> list(), sorted |> skip(cut) |> list())
si

average(box) is
    let n = box |> sum_by(w => w.count)

    weighted(axis) =>
        (box |> sum_by(w => channel(w.color, axis) * w.count)) / n

    (red = weighted(0), green = weighted(1), blue = weighted(2))
si

median_cut(colors, count) => (
    let boxes = LIST[Weighted[]]([colors])

    while boxes.count < count do
        let worst = boxes |> max_by(score)!
        let (low, high) = split(worst)

        boxes[boxes |> find_index(* == worst)!] = low
        boxes.add(high)
    od

    boxes |> map(average) |> list()
)

distance(a, b) =>
    let
        dr = a.red - b.red,
        dg = a.green - b.green,
        db = a.blue - b.blue
    in
        dr * dr + dg * dg + db * db

nearest(palette, c) =>
    palette |> min_by(distance(*, c))!

picture().write("picture.png")

let input = IMAGE.read("picture.png")

let pixels = [
    of(input.pixel(x, y))
    for y in 0..input.height
    for x in 0..input.width
]

let counts = pixels |> frequencies()

let colors =
    counts |> map(kv => (color = kv.key, count = kv.value)) |> list()

let palette = median_cut(colors, 16)

write_line("{colors.count} colors reduced to {palette.count}:")

for row in 0..4 do
    write_line(
        palette
            |> skip(row * 4)
            |> take(4)
            |> map(c => "#{c.red:X2}{c.green:X2}{c.blue:X2}")
            |> join("  ")
    )
od

let scale = 2
let output = IMAGE(input.width * 2 * scale, input.height * scale)

for y in 0..input.height * scale do
    for x in 0..input.width * scale do
        let c = pixels[(y / scale) * input.width + x / scale]
        let q = nearest(palette, c)
        let right = x + input.width * scale

        put(output, x, y, c)
        put(output, right, y, q)
    od
od

output.write("quantized.png")

output.show("quantized.png")
