use default

rot13(c: char) -> char =>
    if c >= 'a' /\ c <= 'z' then
        char((int(c) - int('a') + 13) % 26 + int('a'))
    elif c >= 'A' /\ c <= 'Z' then
        char((int(c) - int('A') + 13) % 26 + int('A'))
    else
        c
    fi

rot13(s: string) -> string =>
    string(s |> map(rot13) |> collect())

while let line = IO.Std.read_line() do
    write_line(rot13(line))
od
