use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

let additive =
    (2..500) |> filter(n => is_prime(n) /\ is_prime(digit_sum(n))) |> list()

for row in additive |> chunk(10) do
    write_line(row |> map(n => "{n,4}") |> join(""))
od

write_line("")
write_line("{additive.count} additive primes below 500")
