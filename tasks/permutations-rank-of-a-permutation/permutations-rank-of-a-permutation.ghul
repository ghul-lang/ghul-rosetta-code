use default

factorial(n: int) -> bigint =>
    1::n |> map(k => bigint(k)) |> reduce(1n, (a, b) => a * b)

// Lexicographic order, read as a number in the factorial base.
unrank(rank: bigint, n: int) -> List[int] is
    let left = 0..n |> collect_mutable()
    let result = LIST[int]()
    let rest mut = rank

    for i in 0..n do
        let place = factorial(n - 1 - i)
        let index = int(rest / place)

        rest = rest % place
        result.add(left[index])
        left.remove_at(index)
    od

    result
si

rank(permutation: List[int]) -> bigint is
    let n = permutation.count
    let total mut = 0n

    for i in 0..n do
        let smaller_later =
            i + 1..n |> count(j => permutation[j] < permutation[i])

        total = total + bigint(smaller_later) * factorial(n - 1 - i)
    od

    total
si

let random = System.Random(12)

random_below(limit: bigint) -> bigint =>
    let limbs = limit.to_string().length / 9 + 2 in
    1::limbs
        |> map(_ => bigint(random.next(1_000_000_000)))
        |> reduce(0n, (total, limb) => total * 1_000_000_000n + limb) %
        limit

show(permutation: List[int]) -> string => "({permutation |> join(", ")})"

for r in 0..6 do
    let permutation = unrank(bigint(r), 3)

    write_line("{r} -> {show(permutation)} -> {rank(permutation)}")
od

write_line("")
write_line("Four random permutations of 12 items:")

for _ in 1::4 do
    let r = random_below(factorial(12))

    write_line("{r,9} -> {show(unrank(r, 12))}")
od

let limit = factorial(144)
let trials = 1_000
let round_trips =
    1::trials
        |> count(_ =>
            let r = random_below(limit) in rank(unrank(r, 144)) =~ r)

write_line("")
write_line("144! has {limit.to_string().length} digits")
write_line("{round_trips} of {trials} random ranks of 144 items round-trip")
