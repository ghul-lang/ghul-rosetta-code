use default

product_of_digits(n: long) -> long =>
    "{n}" |> map(c => long(c - '0')) |> product()

root(n: long) -> (persistence: int, root: long) is
    let m mut = n
    let steps mut = 0

    while m > 9L do
        m = product_of_digits(m)
        steps = steps + 1
    od

    (steps, m)
si

write_line("   number  MP  MDR")

for n in [123321L, 7739L, 893L, 899998L] do
    let (persistence, digital_root) = root(n)

    write_line("{n,9}  {persistence,2}  {digital_root,3}")
od

write_line("\nMDR: first five numbers")

for target in 0::9 do
    let numbers =
        from(0L)
            |> filter(n => root(n).root == long(target))
            |> take(5)

    write_line("{target,3}: {numbers}")
od
