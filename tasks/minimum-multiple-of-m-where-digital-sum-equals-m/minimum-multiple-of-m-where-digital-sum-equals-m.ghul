use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

least_multiplier(n: long) -> long =>
    from(1L) |> find(m => digits(n * m) |> sum() == n)!

let terms = 1L::70L |> map(least_multiplier) |> list()

write_line("The first 40 terms:")

for row in terms |> take(40) |> chunk(10) do
    write_line(row |> map(m => "{m,8}") |> join(""))
od

write_line()
write_line("The next 30:")

for row in terms |> skip(40) |> chunk(10) do
    write_line(row |> map(m => "{m,10}") |> join(""))
od
