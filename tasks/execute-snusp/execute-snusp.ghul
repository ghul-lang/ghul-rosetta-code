use default
use IO.Std.write

use Point = (x: int, y: int)

run(lines: List[string]) is
    let width = lines |> map(l => l.length) |> reduce(0, int.max)
    let at_start =
        (0..lines.count)
            |> find(y => lines[y].index_of('$') >= 0)

    let ip mut =
        if let y = at_start then (x = lines[y].index_of('$'), y = y)
        else (x = 0, y = 0)
        fi

    let heading mut = (x = 1, y = 0)
    let memory = MAP()
    let cell mut = 0
    let calls = STACK()

    get() => if memory.contains_key(cell) then memory[cell] else 0 fi

    step() is
        ip = (x = ip.x + heading.x, y = ip.y + heading.y)
    si

    while ip.y >= 0 /\ ip.y < lines.count /\ ip.x >= 0 /\ ip.x < width do
        let line = lines[ip.y]
        let op = if ip.x < line.length then line[ip.x] else ' ' fi

        case op
        when '>' then cell = cell + 1
        when '<' then cell = cell - 1
        when '+' then memory[cell] = get() + 1
        when '-' then memory[cell] = get() - 1
        when '.' then write(char(get()))
        when ',' then memory[cell] = IO.Std.in.read()
        when '/' then heading = (x = -heading.y, y = -heading.x)
        when '\\' then heading = (x = heading.y, y = heading.x)
        when '!' then step()
        when '?' then
            if get() == 0 then
                step()
            fi
        when '@' then calls.push((at = ip, heading = heading))
        when '#' then
            if calls.count == 0 then
                return
            fi

            let (at, direction) = calls.pop()

            ip = at
            heading = direction
            step()
        else
        esac

        step()
    od
si

for file in ["core.snusp", "modular.snusp"] do
    write_line("{file}:")
    run(IO.File.read_all_lines(file))
    write_line()
od
