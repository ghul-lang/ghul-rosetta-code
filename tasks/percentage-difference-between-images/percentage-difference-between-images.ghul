use default
use Raster.IMAGE

scene() is
    let image = IMAGE(160, 120)

    for y in 0..80 do
        let t = double(y) / 80.0

        image.color(
            ubyte(40.0 + 200.0 * t),
            ubyte(70.0 + 100.0 * t),
            ubyte(160.0 - 60.0 * t)
        )
        image.fill_rectangle(0.0, double(y), 160.0, double(y + 1))
    od

    image.color(255ub, 220ub, 60ub)
    image.disc(112.0, 42.0, 15.0)

    image.color(90ub, 60ub, 120ub)
    image.fill([
        (0.0, 80.0),
        (45.0, 30.0),
        (95.0, 80.0)
    ])

    image.color(60ub, 110ub, 70ub)
    image.fill([
        (55.0, 80.0),
        (105.0, 48.0),
        (160.0, 80.0)
    ])

    image.color(70ub, 150ub, 60ub)
    image.fill_rectangle(0.0, 80.0, 160.0, 120.0)

    image.color(200ub, 35ub, 40ub)
    image.fill_rectangle(22.0, 88.0, 52.0, 110.0)

    image.color(120ub, 25ub, 30ub)
    image.fill([
        (18.0, 88.0),
        (37.0, 75.0),
        (56.0, 88.0)
    ])

    image.color(250ub, 245ub, 235ub)
    image.fill_rectangle(33.0, 97.0, 41.0, 110.0)

    image
si

coarse(value) => ubyte(int(value) / 16 * 16 + 8)

reduced(image) is
    let copy = IMAGE(image.width, image.height)

    for y in 0..image.height do
        for x in 0..image.width do
            let p = image.pixel(x, y)

            copy.set_pixel(
                x,
                y,
                coarse(p.red),
                coarse(p.green),
                coarse(p.blue)
            )
        od
    od

    copy
si

gap(a, b) => long(abs(int(a) - int(b)))

difference(a, b) is
    assert a.width == b.width /\ a.height == b.height
        else "the images are not the same size"

    let total mut = 0L

    for y in 0..a.height do
        for x in 0..a.width do
            let p = a.pixel(x, y), q = b.pixel(x, y)

            total =
                total +
                gap(p.red, q.red) +
                gap(p.green, q.green) +
                gap(p.blue, q.blue)
        od
    od

    let most = 255.0 * 3.0 * double(a.width * a.height)

    100.0 * double(total) / most
si

let original = scene()

original.write("original.png")
reduced(original).write("reduced.png")

let first = IMAGE.read("original.png")
let second = IMAGE.read("reduced.png")

write_line("original.png against reduced.png, 16 levels a channel")
write_line("difference: {difference(first, second):F5}%")
write_line("original.png against itself: {difference(first, first):F5}%")

first.show("original.png")
second.show("reduced.png")
