use default

within(x, y, centre, radius) =>
    x * x + (y - centre) * (y - centre) <= radius * radius

symbol(x, y, radius) =>
    if !within(x, y, 0.0, radius) then
        " "
    elif within(x, y, -radius / 2.0, radius / 6.0) then
        "#"
    elif within(x, y, radius / 2.0, radius / 6.0) then
        "."
    elif within(x, y, -radius / 2.0, radius / 2.0) then
        "."
    elif within(x, y, radius / 2.0, radius / 2.0) then
        "#"
    elif x < 0.0 then
        "."
    else
        "#"
    fi

taijitu(radius) is
    for row in -radius::radius do
        yield
            ((-2 * radius)::(2 * radius))
                |> map(column =>
                    symbol(cast(column) / 2.0, cast(row), cast(radius))
                )
                |> join("")
    od
si

[4, 8]
    |> each(radius => (
        taijitu(radius) |> each(line => write_line(line))
        write_line("")
    ))
