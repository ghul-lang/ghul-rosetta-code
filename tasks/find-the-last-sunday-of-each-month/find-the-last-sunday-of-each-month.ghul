use default

let year = 2013

last_sunday(month) =>
    let last = Time.DATE_TIME(
        year,
        month,
        Time.DATE_TIME.days_in_month(year, month)
    )
    in
    last.add_days(double(-cast int(last.day_of_week)))

for month in 1::12 do
    write_line(last_sunday(month).to_string("yyyy-MM-dd"))
od
