use default

use System.Random
use System.Security.Cryptography.RandomNumberGenerator

rolls(generator: Random) -> string =>
    (0..10) |> map(_ => "{generator.next(1, 7)}") |> join(" ")

// the same seed gives the same sequence, on every run
write_line("seeded with 42: {rolls(Random(42))}")
write_line("seeded with 42: {rolls(Random(42))}")

// an unseeded generator is seeded from the system
let first = rolls(Random())
let second = rolls(Random())

write_line("two unseeded generators agree: {first =~ second}")

// the cryptographic generator is the operating system's
let die = RandomNumberGenerator.get_int32(1, 7)
write_line("cryptographic roll in range: {die >= 1 /\ die <= 6}")
