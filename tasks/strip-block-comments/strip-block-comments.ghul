use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

strip_block_comments(
    text: string,
    start: string,
    ended: string
) -> string =>
    let open = text.index_of(start) in
    if open < 0 then
        text
    else
        let close = text.index_of(ended, open + start.length) in
        if close < 0 then
            text[0..open]
        else
            let rest = text[close + ended.length..<0] in
            "{text[0..open]}{strip_block_comments(rest, start, ended)}"
        fi
    fi

let lines = [
    "  /**",
    "   * Some comments",
    "   * longer comments here that we can parse.",
    "   *",
    "   * Rahoo ",
    "   */",
    "   function subroutine() {{",
    "    a = /* inline comment */ b + c ;",
    "   }}",
    "   /*/ <-- tricky comments */",
    "",
    "   /**",
    "    * Another comment.",
    "    */",
    "    function something() {{",
    "    }}"
]

write_line(strip_block_comments(lines |> join("\n"), "/*", "*/"))
