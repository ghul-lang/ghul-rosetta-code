use default

power_mod(
    base: bigint,
    exponent: bigint,
    modulus: bigint
) -> bigint =>
    if exponent.is_zero then
        1n % modulus
    else
        let
            half = power_mod(base, exponent >> 1, modulus),
            square = half * half % modulus
        in
            if exponent.is_even then square
            else square * (base % modulus) % modulus
            fi
    fi

let a =
    2988348162058574136915891421498819466320163312926952423791023078876139n
let b =
    2351399303373464486466122544523690094744975233415544072992656881240319n
let m = bigint.pow(10n, 40)

let digits = power_mod(a, b, m)

write_line(digits)
write_line(
    "same as mod_pow: {digits =~ bigint.mod_pow(a, b, m)}"
)
