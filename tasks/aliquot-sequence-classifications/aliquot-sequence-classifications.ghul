use default

enum Kind is
    TERMINATING,
    PERFECT,
    AMICABLE,
    SOCIABLE,
    ASPIRING,
    CYCLIC,
    NON_TERMINATING
si

proper_divisor_sum(n: long) -> long is
    let sigma mut = 1L
    let rest mut = n
    let p mut = 2L

    while p * p <= rest do
        let term mut = 1L
        let power mut = 1L

        while rest % p == 0L do
            rest = rest / p
            power = power * p
            term = term + power
        od

        sigma = sigma * term
        p = p + 1L
    od

    if rest > 1L then
        sigma = sigma * (rest + 1L)
    fi

    sigma - n
si

classify(k: long) -> (kind: Kind, terms: List[long]) is
    let terms = LIST([k])

    while
        terms.count < 16 /\ terms[terms.count - 1] <= 1L << 47
    do
        let last = terms[terms.count - 1]
        let next = proper_divisor_sum(last)
        let seen = terms.contains(next)

        terms.add(next)

        let kind =
            if next == 0L then Kind.TERMINATING
            elif next == k then
                case terms.count
                when 2 then Kind.PERFECT
                when 3 then Kind.AMICABLE
                else Kind.SOCIABLE
                esac
            elif next == last then Kind.ASPIRING
            elif seen then Kind.CYCLIC
            fi

        if kind? then
            return (kind, terms)
        fi
    od

    (Kind.NON_TERMINATING, terms)
si

let numbers = [
    1L, 2L, 3L, 4L, 5L, 6L, 7L, 8L, 9L, 10L, 11L, 12L, 28L, 496L,
    220L, 1184L, 12496L, 1264460L, 790L, 909L, 562L, 1064L, 1488L,
    15355717786080L
]

for k in numbers do
    let (kind, terms) = classify(k)
    let name = "{kind}".to_lower().replace('_', '-')

    write_line("{k,14}: {name,-15} {terms}")
od
