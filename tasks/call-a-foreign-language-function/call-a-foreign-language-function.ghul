use default
use System.Runtime.InteropServices.DllImport
use System.Runtime.InteropServices.Marshal

// a bodyless static under DllImport is the call into the C library
class LIBC is
    @DllImport("libc")
    strdup(text: string) -> word static;

    @DllImport("libc")
    free(pointer: word) static;

    init() is si
si

// the string is copied into a C string for the call; strdup's copy is
// C memory, read back and then freed
let copy = LIBC.strdup("Hello World!")

write_line(Marshal.ptr_to_string_ansi(copy))

LIBC.free(copy)
