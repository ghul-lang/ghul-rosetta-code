use default
use System.Runtime.InteropServices.DllImport
use System.Runtime.InteropServices.Marshal

class LIBC is
    @DllImport("libc")
    strdup(text: string) -> word static

    @DllImport("libc")
    free(pointer: word) static

    init() is si
si

let copy = LIBC.strdup("Hello World!")

write_line(Marshal.ptr_to_string_ansi(copy))

LIBC.free(copy)
