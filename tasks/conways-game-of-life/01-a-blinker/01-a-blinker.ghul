use default

let offsets = [
    (dr, dc)
    for dr in -1::1
    for dc in -1::1
    if dr != 0 \/ dc != 0
]

neighbours((row, column): (int, int)) -> (int, int){} =>
    offsets |> map(((dr, dc)) => (row + dr, column + dc))

survives(live: Set[(int, int)], cell: (int, int)) -> bool =>
    let alive = neighbours(cell) |> count(live.contains(*)) in
    alive == 3 \/ (alive == 2 /\ live.contains(cell))

// A cell can only be alive next generation if it is next to a live one now.
step(live: SET[(int, int)]) -> SET[(int, int)] =>
    live |> flat_map(neighbours) |> filter(survives(live, *)) |> SET()

show(generation: int, live: Set[(int, int)]) is
    write_line("generation {generation}")

    for row in 0..5 do
        write_line(
            0..5
                |> map(column =>
                    if live.contains((row, column)) then "#" else "." fi
                )
                |> string()
        )
    od

    write_line()
si

// A blinker, which oscillates with period two.
let blinker = SET([(2, 1), (2, 2), (2, 3)])

iterate(blinker, step)
    |> take(5)
    |> index()
    |> each(g => show(g.index, g.value))
