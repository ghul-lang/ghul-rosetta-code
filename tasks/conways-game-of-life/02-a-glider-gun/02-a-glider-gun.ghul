use default
use Raster.ANIMATION
use Raster.IMAGE

let columns = 80
let rows = 60
let cell = 4
let generations = 160

let gun = [
    "........................#...........",
    "......................#.#...........",
    "............##......##............##",
    "...........#...#....##............##",
    "##........#.....#...##..............",
    "##........#...#.##....#.#...........",
    "..........#.....#.......#...........",
    "...........#...#....................",
    "............##......................"
]

let offsets = [
    (dr, dc)
    for dr in -1::1
    for dc in -1::1
    if dr != 0 \/ dc != 0
]

// The world wraps at its edges.
neighbours((row, column): (int, int)) -> (int, int){} =>
    offsets
        |> map(((dr, dc)) => (
            (row + dr + rows) % rows,
            (column + dc + columns) % columns
        ))

survives(live: SET[(int, int)], cell: (int, int)) -> bool =>
    let alive = neighbours(cell) |> count(live.contains(*)) in
    alive == 3 \/ (alive == 2 /\ live.contains(cell))

// A cell can only be alive next generation if it is next to a live one now.
step(live: SET[(int, int)]) -> SET[(int, int)] =>
    live |> flat_map(neighbours) |> filter(survives(live, *)) |> SET()

draw(image: IMAGE, live: SET[(int, int)]) is
    image.clear(250ub, 250ub, 247ub)
    image.color(35ub, 70ub, 130ub)

    for (row, column) in live do
        image.fill_rectangle(
            double(column * cell),
            double(row * cell),
            double(column * cell + cell),
            double(row * cell + cell)
        )
    od
si

let start = SET([
    (row + 4, column + 4)
    for row in 0..gun.count
    for column in 0..gun[row].length
    if gun[row][column] == '#'
])

let image = IMAGE(columns * cell, rows * cell)
let animation = ANIMATION(columns * cell, rows * cell)

for live in iterate(start, step) |> take(generations) do
    draw(image, live)

    animation.add(image, 50)
od

animation.write("gun.png")

animation.show("gun.png")
