use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `SET()` builds its collection eagerly
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`
// `==` compares identity

let areas = [
    2 * (length * width + height * (length + width))
    for length in 1::12
    for width in length::16
    for height in width::166
]
    |> filter(* < 1000)
    |> SET()

let o_halloran =
    (7::999)
        |> filter(n => n % 2 == 0 /\ areas.contains(n) == false)
        |> list()

write_line("even values below 1000 that are no cuboid's surface area:")
write_line(o_halloran |> join(" "))
write_line("count: {o_halloran.count}")
