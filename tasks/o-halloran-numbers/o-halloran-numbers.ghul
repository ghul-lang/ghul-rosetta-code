use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `*` as an argument leaves that parameter open: partial application.
// `LIST()`, `SET()`, `MAP()` and `ARRAY()` build the collection eagerly.

let areas = [
    2 * (length * width + height * (length + width))
    for length in 1::12
    for width in length::16
    for height in width::166
]
    |> filter(* < 1000)
    |> SET()

let o_halloran =
    (7::999)
        |> filter(n => n % 2 == 0 /\ areas.contains(n) == false)
        |> list()

write_line("even values below 1000 that are no cuboid's surface area:")
write_line(o_halloran |> join(" "))
write_line("count: {o_halloran.count}")
