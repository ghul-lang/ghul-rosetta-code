use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `|> LIST()` reads the whole sequence into a new `LIST`
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

counting_sort(values: int[], low: int, high: int) -> int{} is
    let counts = low..high + 1 |> map(_ => 0) |> LIST()

    for value in values do
        counts[value - low] = counts[value - low] + 1
    od

    let result = LIST()

    for offset in 0..counts.count do
        for _ in 0 .. counts[offset] do
            result.add(offset + low)
        od
    od

    result
si

let numbers = [5, 3, 8, 1, 9, 2, 7, 1, 9]

write_line(numbers |> counting_sort(1, 9) |> join())
