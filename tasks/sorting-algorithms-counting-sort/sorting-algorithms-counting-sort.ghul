use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

counting_sort(values: int[], low: int, high: int) -> int{} is
    let counts = low..high + 1 |> map(_ => 0) |> LIST()

    for value in values do
        counts[value - low] = counts[value - low] + 1
    od

    let result = LIST()

    for offset in 0..counts.count do
        for _ in 0 .. counts[offset] do
            result.add(offset + low)
        od
    od

    result
si

let numbers = [5, 3, 8, 1, 9, 2, 7, 1, 9]

write_line(numbers |> counting_sort(1, 9) |> join())
