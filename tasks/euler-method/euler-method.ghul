use default

let k = 0.07
let room = 20.0
let initial = 100.0

cooling(t, temperature) =>
    -k * (temperature - room)

exact(t) => room + (initial - room) * double.exp(-k * t)

euler(f, y0, step, end) is
    let y mut = y0

    for t in from(0, step) |> take_while(* <= end) do
        yield (t, y)

        y = y + double(step) * f(double(t), y)
    od
si

for step in [2, 5, 10] do
    write_line("step {step} s:")
    write_line("  time    euler    exact")

    for (time, value) in euler(cooling, initial, step, 100) do
        if time % 10 == 0 then
            let expected = exact(double(time))

            write_line("{time,6} {value,8:F3} {expected,8:F3}")
        fi
    od

    write_line("")
od
