use default
use System.Math.cos
use System.Math.log
use System.Math.pi
use System.Math.sqrt

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read, and `count` reads it all
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

let mean = 1.0
let deviation = 0.5

let random = System.Random(1963)

// Box-Muller: a pair of uniform values on (0, 1] becomes a value from the
// standard normal distribution, which the mean and deviation then place.
normal() -> double =>
    mean +
    deviation *
    sqrt(-2.0 * log(random.next_double())) *
    cos(2.0 * pi * random.next_double())

let sample = 0..1000 |> map(_ => normal()) |> list()

let average = sample |> sum() / double(sample.count)

let variance =
    (sample |> sum_by(value => (value - average) * (value - average))) /
    double(sample.count)

write_line("{sample.count} values")
let first_five = sample |> take(5) |> map(v => "{v:F4}") |> join(" ")

write_line("first five: {first_five}")
write_line("mean {average:F4}")
write_line("standard deviation {sqrt(variance):F4}")
