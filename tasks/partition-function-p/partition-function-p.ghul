use default

partitions(n: int) -> bigint is
    let p = LIST([1n])

    walk(m: int, k: int, total: bigint) -> bigint =>
        let first = m - k * (3 * k - 1) / 2 in
        if first < 0 then total
        else
            let second = m - k * (3 * k + 1) / 2 in
            let pair =
                p[first] +
                if second >= 0 then p[second] else 0n fi
            in
            walk(
                m,
                k + 1,
                if k % 2 == 1 then
                    total + pair
                else
                    total - pair
                fi
            )
        fi

    for m in 1::n do
        p.add(walk(m, 1, 0n))
    od

    p[n]
si

write_line(
    "P(1) .. P(12): {1::12 |> map(partitions) |> join(" ")}"
)
write_line("P(6666) = {partitions(6666)}")
