use default

partitions(n: int) -> bigint is
    let p = LIST([1n])

    for m in 1::n do
        let total mut = 0n
        let k mut = 1

        do
            let first = m - k * (3 * k - 1) / 2

            if first < 0 then
                break
            fi

            let second = m - k * (3 * k + 1) / 2
            let pair = p[first] + (if second >= 0 then p[second] else 0n fi)

            total = if k % 2 == 1 then total + pair else total - pair fi
            k = k + 1
        od

        p.add(total)
    od

    p[n]
si

write_line("P(1) .. P(12): {1::12 |> map(partitions) |> join(" ")}")
write_line("P(6666) = {partitions(6666)}")
