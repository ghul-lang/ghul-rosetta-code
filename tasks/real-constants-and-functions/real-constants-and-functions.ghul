use default

write_line("e: {e}")
write_line("pi: {pi}")
write_line("square root of 2: {sqrt(2.0)}")
write_line("natural log of 10: {log(10.0)}")
write_line("e to the 2: {exp(2.0)}")
write_line("absolute value of -3.5: {abs(-3.5)}")
write_line("floor of -3.5: {floor(-3.5)}")
write_line("ceiling of -3.5: {ceiling(-3.5)}")
write_line("2 to the 10: {pow(2.0, 10.0)}")
