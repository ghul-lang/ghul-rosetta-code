use default

zigzag(n: int) -> List[LIST[int]] is
    let cells = 0..n
        |> map(_ => repeat(0, n) |> collect_mutable())
        |> collect()

    let row mut = 0
    let column mut = 0

    for value in 0..(n * n) do
        cells[row][column] = value

        if (row + column) % 2 == 0 then
            if column == n - 1 then
                row = row + 1
            elif row == 0 then
                column = column + 1
            else
                row = row - 1
                column = column + 1
            fi
        else
            if row == n - 1 then
                column = column + 1
            elif column == 0 then
                row = row + 1
            else
                row = row + 1
                column = column - 1
            fi
        fi
    od

    cells
si

let n = 5

zigzag(n) |> each(row =>
    write_line(row |> map(value => "{value,2}") |> join(" ")))
