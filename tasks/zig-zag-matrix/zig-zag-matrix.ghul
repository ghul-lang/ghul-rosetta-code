use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `MAP[K, V]` is a mutable map from keys to values
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

zigzag_order(n: int) -> (int, int){} =>
    [(row, column) for row in 0..n for column in 0..n]
        |> sort_by(((row, column)) =>
            let diagonal = row + column in
            diagonal * n + if diagonal % 2 == 0 then column else row fi
        )

zigzag(n: int) -> int[][] =>
    let
        order = zigzag_order(n) |> list(),
        position = MAP(0..order.count |> map(i => (order[i], i)))
    in
        [[position[(row, column)] for column in 0..n] for row in 0..n]

let n = 5

zigzag(n)
    |> each(row =>
        write_line(row |> map(value => "{value,2}") |> join(" "))
    )
