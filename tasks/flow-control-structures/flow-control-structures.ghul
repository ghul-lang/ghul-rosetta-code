use default

classify(n: int) -> string =>
    if n < 0 then
        "negative"
    elif n == 0 then
        "zero"
    else
        case n % 3
        when 0 then "a multiple of three"
        else "positive"
        esac
    fi

for n in [-2, 0, 3, 7] do
    write_line("{n} is {classify(n)}")
od

let first_over_ten = for n in [3, 8, 14, 21] do
    if n > 10 then
        break n
    fi
od

write_line("first over ten: {first_over_ten}")
let over_a_hundred = for n in [3, 8] do
    if n > 100 then
        break n
    fi
od

write_line("first over a hundred: {over_a_hundred?.to_string() ?? "none"}")

outer: for row in 0..3 do
    for column in 0..3 do
        if column > row then
            continue outer
        fi

        if row == 2 then
            break outer
        fi

        write_line("row {row} column {column}")
    od
od

let countdown = (
    let n mut = 3
    let said = LIST()

    do
        said.add("{n}")

        n = n - 1

        if n == 0 then
            break
        fi
    od

    said |> join()
)

write_line("counting down: {countdown}")

try
    throw System.Exception("and out again")
catch e: System.Exception
    write_line("caught: {e.message}")
finally
    write_line("the finally always runs")
yrt
