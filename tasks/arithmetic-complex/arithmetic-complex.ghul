use default

show(name, value) =>
    let
        sign = if value.imaginary < 0.0 then "-" else "+" fi,
        size = abs(value.imaginary)
    in
        write_line("{name,-10} {value.real} {sign} {size}i")

let a = 1r + 1j
let b = 3.14159r + 1.25j

show("a", a)
show("b", b)
show("a + b", a + b)
show("a * b", a * b)
show("negation", -a)
show("inverse", 1r / a)
show("conjugate", complex.conjugate(a))
