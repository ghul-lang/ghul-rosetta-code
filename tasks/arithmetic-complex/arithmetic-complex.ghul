use default
use System.Math
use System.Numerics.Complex

show(name: string, value: Complex) =>
    let
        sign = if value.imaginary < 0.0 then "-" else "+" fi,
        size = Math.abs(value.imaginary)
    in
    write_line("{name,-10} {value.real} {sign} {size}i")

let a = Complex(1.0, 1.0)
let b = Complex(3.14159, 1.25)

show("a", a)
show("b", b)
show("a + b", a + b)
show("a * b", a * b)
show("negation", -a)
show("inverse", Complex.one / a)
show("conjugate", Complex.conjugate(a))
