use default
use Raster.IMAGE
use Point = (x: double, y: double)
use Ring = Collections.List[Point]

let epsilon = 0.000001D

crosses(point: Point, from: Point, to: Point) -> bool is
    let (low, high) = if from.y < to.y then (from, to) else (to, from) fi

    let y = if point.y == low.y \/ point.y == high.y then
                point.y + epsilon
            else
                point.y
            fi

    let rightmost = System.Math.max(low.x, high.x)

    if y < low.y \/ y > high.y \/ point.x >= rightmost then
        return false
    fi

    if point.x < System.Math.min(low.x, high.x) then
        return true
    fi

    let edge_slope =
        if low.x != high.x then
            (high.y - low.y) / (high.x - low.x)
        else
            0.0D
        fi

    let point_slope =
        if low.x != point.x then
            (y - low.y) / (point.x - low.x)
        else
            0.0D
        fi

    return
        if low.x == high.x then
            true
        elif low.x == point.x then
            false
        else
            point_slope >= edge_slope
        fi
si

inside(point: Point, rings: List[Ring]) -> bool =>
    [true
        for ring in rings for index in 0..ring.count
        if crosses(point, ring[index], ring[(index + 1) % ring.count])]
        .count % 2 == 1

ring(corners: List[(double, double)]) -> Ring =>
    corners |> map((x, y) => (x = x, y = y)) |> collect()

let square = [ring([(0.0D, 0.0D), (10.0D, 0.0D), (10.0D, 10.0D),
                    (0.0D, 10.0D)])]

let square_hole =
    [square[0],
     ring([(2.5D, 2.5D), (7.5D, 2.5D), (7.5D, 7.5D), (2.5D, 7.5D)])]

let hexagon =
    [ring([(3.0D, 0.0D), (7.0D, 0.0D), (10.0D, 5.0D), (7.0D, 10.0D),
           (3.0D, 10.0D), (0.0D, 5.0D)])]

let shapes =
    [(name = "square", rings = square),
     (name = "square with hole", rings = square_hole),
     (name = "hexagon", rings = hexagon)]

let probes =
    [(x = 5.0D, y = 5.0D), (x = 5.0D, y = 8.0D), (x = -10.0D, y = 5.0D),
     (x = 0.0D, y = 5.0D), (x = 10.0D, y = 5.0D), (x = 8.0D, y = 5.0D),
     (x = 10.0D, y = 10.0D)]

for (name, rings) in shapes do
    write_line(name)

    for probe in probes do
        let verdict = if inside(probe, rings) then "in" else "out" fi

        write_line("  {probe}: {verdict}")
    od
od

let image = IMAGE(480, 360)

image.view(-1.0D, -1.0D, 11.0D, 11.0D)
image.clear(252ub, 250ub, 245ub)
image.stroke(2.0D)

image.colour(40ub, 40ub, 60ub)

for hole in square_hole do
    image.line(
        hole |> cat([hole[0]]) |> collect())
od

for step_x in 0..49 do
    for step_y in 0..49 do
        let probe =
            (x = -0.5D + double(step_x) * 0.22D,
             y = -0.5D + double(step_y) * 0.22D)

        if inside(probe, square_hole) then
            image.colour(40ub, 140ub, 60ub)
        else
            image.colour(200ub, 90ub, 70ub)
        fi

        image.dot(probe.x, probe.y, 1.6D)
    od
od

image.write("inside.png")

image.show("inside.png")
