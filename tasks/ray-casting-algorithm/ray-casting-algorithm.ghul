use default
use Raster.IMAGE
use Point = (x: double, y: double)
use Ring = Point[]

let epsilon = 0.000001

crosses(point, from, to) is
    let (low, high) = if from.y < to.y then (from, to) else (to, from) fi

    let y =
        if point.y == low.y \/ point.y == high.y then
            point.y + epsilon
        else
            point.y
        fi

    let rightmost = max(low.x, high.x)

    if y < low.y \/ y > high.y \/ point.x >= rightmost then
        return false
    fi

    if point.x < min(low.x, high.x) then
        return true
    fi

    let edge_slope =
        if low.x != high.x then
            (high.y - low.y) / (high.x - low.x)
        else
            0.0
        fi

    let point_slope =
        if low.x != point.x then
            (y - low.y) / (point.x - low.x)
        else
            0.0
        fi

    return
        if low.x == high.x then
            true
        elif low.x == point.x then
            false
        else
            point_slope >= edge_slope
        fi
si

inside(point, rings) =>
    [
        true
        for ring in rings
        for index in 0..ring.count
        if crosses(point, ring[index], ring[(index + 1) % ring.count])
    ].count % 2 == 1

ring(corners: (double, double)[]) -> Ring =>
    corners |> map((x, y) => (x = x, y = y)) |> list()

let square = [
    ring([
        (0.0, 0.0), (10.0, 0.0), (10.0, 10.0),
        (0.0, 10.0)
    ])
]

let square_hole = [
    square[0],
    ring([(2.5, 2.5), (7.5, 2.5), (7.5, 7.5), (2.5, 7.5)])
]

let hexagon = [
    ring([
        (3.0, 0.0), (7.0, 0.0), (10.0, 5.0), (7.0, 10.0),
        (3.0, 10.0), (0.0, 5.0)
    ])
]

let shapes = [
    (name = "square", rings = square),
    (name = "square with hole", rings = square_hole),
    (name = "hexagon", rings = hexagon)
]

let probes = [
    (x = 5.0, y = 5.0), (x = 5.0, y = 8.0), (x = -10.0, y = 5.0),
    (x = 0.0, y = 5.0), (x = 10.0, y = 5.0), (x = 8.0, y = 5.0),
    (x = 10.0, y = 10.0)
]

for (name, rings) in shapes do
    write_line(name)

    for probe in probes do
        let verdict = if inside(probe, rings) then "in" else "out" fi

        write_line("  {probe}: {verdict}")
    od
od

let image = IMAGE(480, 360)

image.view(-1.0, -1.0, 11.0, 11.0)
image.clear(252ub, 250ub, 245ub)
image.stroke(2.0)

image.color(40ub, 40ub, 60ub)

for hole in square_hole do
    image.line(hole ++ [hole[0]] |> list())
od

for step_x in 0..49 do
    for step_y in 0..49 do
        let probe = (
            x = -0.5 + double(step_x) * 0.22,
            y = -0.5 + double(step_y) * 0.22
        )

        if inside(probe, square_hole) then
            image.color(40ub, 140ub, 60ub)
        else
            image.color(200ub, 90ub, 70ub)
        fi

        image.dot(probe.x, probe.y, 1.6)
    od
od

image.write("inside.png")

image.show("inside.png")
