use default

use Matrix = double[][]

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `LIST()` builds its collection eagerly
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`
// `==` compares identity

*(a: Matrix, b: Matrix) -> Matrix =>
    0..a.count
        |> map(i =>
            0..b[0].count
                |> map(j => 0..b.count |> sum_by(k => a[i][k] * b[k][j]))
                |> list()
        )
        |> list()

square(n: int, cell: (int, int) -> double) -> LIST[LIST[double]] =>
    0..n |> map(i => 0..n |> map(cell(i, *)) |> LIST()) |> LIST()

pivot(a: Matrix) -> Matrix => (
    let n = a.count
    let order = LIST(0..n)

    for column in 0..n do
        let best = column..n |> max_by(row => double.abs(a[row][column]))!

        (order[column], order[best]) = (order[best], order[column])
    od

    square(n, (i, j) => if order[i] == j then 1.0 else 0.0 fi)
)

decompose(a: Matrix) -> (
    lower: Matrix,
    upper: Matrix,
    permutation: Matrix
) is
    let n = a.count
    let p = pivot(a)
    let pa = p * a
    let lower = square(n, (i, j) => if i == j then 1.0 else 0.0 fi)
    let upper = square(n, (_, _) => 0.0)

    for j in 0..n do
        for i in 0::j do
            let known = 0..i |> sum_by(k => upper[k][j] * lower[i][k])

            upper[i][j] = pa[i][j] - known
        od

        for i in j + 1..n do
            let known = 0..j |> sum_by(k => upper[k][j] * lower[i][k])

            lower[i][j] = (pa[i][j] - known) / upper[j][j]
        od
    od

    (lower, upper, p)
si

show(name: string, m: Matrix, format: string) is
    write_line(name)

    for row in m do
        let cells = row |> map(v => v.to_string(format).pad_left(10))

        write_line(cells |> join(""))
    od
si

let examples = [
    [[1.0, 3.0, 5.0], [2.0, 4.0, 7.0], [1.0, 1.0, 0.0]],
    [
        [11.0, 9.0, 24.0, 2.0],
        [1.0, 5.0, 2.0, 6.0],
        [3.0, 17.0, 18.0, 1.0],
        [2.0, 5.0, 7.0, 1.0]
    ]
]

for a in examples do
    let (lower, upper, permutation) = decompose(a)

    show("A", a, "0")
    show("L", lower, "0.00000")
    show("U", upper, "0.00000")
    show("P", permutation, "0")
    write_line("")
od
