use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

class BOX(value: int public)

let n = 5

let distinct = 0..n |> map(_ => BOX(0)) |> list()

distinct[0].value = 42

write_line("distinct: {distinct |> map(box => "{box.value}") |> join(" ")}")

let shared = BOX(0)
let same = 0..n |> map(_ => shared) |> list()

same[0].value = 42

write_line("shared:   {same |> map(box => "{box.value}") |> join(" ")}")
