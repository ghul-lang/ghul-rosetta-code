use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

class BOX(value: int public)

let n = 5

let distinct = 0..n |> map(_ => BOX(0)) |> list()

distinct[0].value = 42

write_line("distinct: {distinct |> map(box => "{box.value}") |> join(" ")}")

let shared = BOX(0)
let same = 0..n |> map(_ => shared) |> list()

same[0].value = 42

write_line("shared:   {same |> map(box => "{box.value}") |> join(" ")}")
