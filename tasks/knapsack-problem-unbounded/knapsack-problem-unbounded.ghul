use default

use Bounty = (name: string, value: int, weight: double, volume: double)

let panacea = (name = "panacea", value = 3000, weight = 0.3, volume = 0.025)
let ichor = (name = "ichor", value = 1800, weight = 0.2, volume = 0.015)
let gold = (name = "gold", value = 2500, weight = 2.0, volume = 0.002)

let weight_limit = 25.0
let volume_limit = 0.25

most_of(item: Bounty) -> int =>
    System.Math.min(
        int(weight_limit / item.weight),
        int(volume_limit / item.volume))

let best_value mut = 0
let best mut = (panaceas = 0, ichors = 0, golds = 0)

for panaceas in 0::most_of(panacea) do
    for ichors in 0::most_of(ichor) do
        let weight =
            double(panaceas) * panacea.weight +
            double(ichors) * ichor.weight

        let volume =
            double(panaceas) * panacea.volume +
            double(ichors) * ichor.volume

        if weight > weight_limit \/ volume > volume_limit then
            break
        fi

        let golds =
            System.Math.min(
                int((weight_limit - weight) / gold.weight),
                int((volume_limit - volume) / gold.volume))

        let value =
            panaceas * panacea.value +
            ichors * ichor.value +
            golds * gold.value

        if value > best_value then
            best_value = value
            best = (panaceas = panaceas, ichors = ichors, golds = golds)
        fi
    od
od

let (panaceas, ichors, golds) = best

let weight =
    double(panaceas) * panacea.weight +
    double(ichors) * ichor.weight +
    double(golds) * gold.weight

let volume =
    double(panaceas) * panacea.volume +
    double(ichors) * ichor.volume +
    double(golds) * gold.volume

write_line("Maximum value achievable is {best_value}")
write_line(
    "This is achieved by carrying (one solution) "
    "{panaceas} panacea, {ichors} ichor and {golds} gold")
write_line(
    "The weight to carry is {weight:F1} "
    "and the volume used is {volume:F3}")
