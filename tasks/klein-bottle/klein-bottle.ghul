use default
use Raster.IMAGE

struct VEC(x: double, y: double, z: double) is
    -(other: VEC) -> VEC => VEC(x - other.x, y - other.y, z - other.z)

    ×(o: VEC) -> VEC =>
        VEC(y * o.z - z * o.y, z * o.x - x * o.z, x * o.y - y * o.x)

    length: double => sqrt(x * x + y * y + z * z)
si

use Quad = VEC[]

let around = 40
let along = 40
let yaw = 0.9
let pitch = 0.3

surface(u, v) => (
    let c = cos(u),
        s = sin(u),
        cv = cos(v),
        z = 2.0 / 15.0 * (3.0 + 5.0 * c * s) * sin(v)

    let x =
        -2.0 /
        15.0 *
        c *
        (
            3.0 * cv -
            30.0 * s +
            90.0 * pow(c, 4.0) * s -
            60.0 * pow(c, 6.0) * s +
            5.0 * c * cv * s
        )

    let y =
        -1.0 /
        15.0 *
        s *
        (
            3.0 * cv -
            3.0 * c * c * cv -
            48.0 * pow(c, 4.0) * cv +
            48.0 * pow(c, 6.0) * cv -
            60.0 * s +
            5.0 * c * cv * s -
            5.0 * pow(c, 3.0) * cv * s -
            80.0 * pow(c, 5.0) * cv * s +
            80.0 * pow(c, 7.0) * cv * s
        )

    VEC(y, -z, -x)
)

turned(p) =>
    let
        x = p.x * cos(yaw) - p.y * sin(yaw),
        y = p.x * sin(yaw) + p.y * cos(yaw)
    in
        VEC(
            x,
            p.z * cos(pitch) - y * sin(pitch),
            p.z * sin(pitch) + y * cos(pitch)
        )

corner(i, j) =>
    let
        u = pi * double(i) / double(around),
        v = 2.0 * pi * double(j) / double(along)
    in
        turned(surface(u, v))

depth(quad) => quad |> sum_by(c => c.z)

brightness(quad) =>
    let n = (quad[1] - quad[0]) × (quad[3] - quad[0]) in
    if n.length == 0.0 then 0.5
    else 0.25 + 0.75 * abs(n.z) / n.length
    fi

quad(i, j) => [
    corner(i, j), corner(i + 1, j),
    corner(i + 1, j + 1), corner(i, j + 1)
]

let quads = [quad(i, j) for i in 0..around for j in 0..along]
    |> sort((p, q) => depth(p) <> depth(q))
    |> list()

let image = IMAGE(360, 360)

let flat = quads |> flat_map(q => q) |> list()
let low_x = flat |> map(p => p.x) |> reduce(0.0, min)
let high_x = flat |> map(p => p.x) |> reduce(0.0, max)
let low_y = flat |> map(p => p.y) |> reduce(0.0, min)
let high_y = flat |> map(p => p.y) |> reduce(0.0, max)
let half = 0.53 * max(high_x - low_x, high_y - low_y)
let middle_x = (low_x + high_x) / 2.0
let middle_y = (low_y + high_y) / 2.0

image.view(
    middle_x - half,
    middle_y - half,
    middle_x + half,
    middle_y + half
)
image.clear(248ub, 248ub, 244ub)
image.stroke(0.6)

for q in quads do
    let light = brightness(q)
    let outline = q |> map(p => (x = p.x, y = p.y)) |> list()

    image.color(
        ubyte(60.0 * light),
        ubyte(150.0 * light),
        ubyte(200.0 * light)
    )
    image.fill(outline)

    image.color(20ub, 40ub, 60ub)
    image.line(outline ++ [outline[0]] |> list())
od

write_line("a Klein bottle, immersed in three dimensions")
write_line("{quads.count} quadrilaterals, drawn farthest first")

image.write("klein.png")

image.show("klein.png")
