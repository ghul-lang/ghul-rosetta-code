use default
use Raster.IMAGE
use System.Math.*

struct VEC(x: double, y: double, z: double) is
    -(other: VEC) -> VEC => VEC(x - other.x, y - other.y, z - other.z)

    ×(o: VEC) -> VEC =>
        VEC(y * o.z - z * o.y, z * o.x - x * o.z, x * o.y - y * o.x)

    length: double => sqrt(x * x + y * y + z * z)
si

use Quad = List[VEC]

let around = 40
let along = 40
let yaw = 0.9D
let pitch = 0.3D

surface(u: double, v: double) -> VEC is
    let c = cos(u)
    let s = sin(u)
    let cv = cos(v)

    let x = -2.0D / 15.0D * c * (
        3.0D * cv - 30.0D * s + 90.0D * pow(c, 4.0D) * s -
        60.0D * pow(c, 6.0D) * s + 5.0D * c * cv * s)

    let y = -1.0D / 15.0D * s * (
        3.0D * cv - 3.0D * c * c * cv - 48.0D * pow(c, 4.0D) * cv +
        48.0D * pow(c, 6.0D) * cv - 60.0D * s + 5.0D * c * cv * s -
        5.0D * pow(c, 3.0D) * cv * s -
        80.0D * pow(c, 5.0D) * cv * s +
        80.0D * pow(c, 7.0D) * cv * s)

    let z = 2.0D / 15.0D * (3.0D + 5.0D * c * s) * sin(v)

    VEC(y, -z, -x)
si

turned(p: VEC) -> VEC is
    let x = p.x * cos(yaw) - p.y * sin(yaw)
    let y = p.x * sin(yaw) + p.y * cos(yaw)

    VEC(
        x,
        p.z * cos(pitch) - y * sin(pitch),
        p.z * sin(pitch) + y * cos(pitch))
si

corner(i: int, j: int) -> VEC =>
    let u = pi * double(i) / double(around) in
    let v = 2.0D * pi * double(j) / double(along) in
    turned(surface(u, v))

depth(quad: Quad) -> double =>
    quad |> sum_by(c => c.z)

brightness(quad: Quad) -> double =>
    let n = (quad[1] - quad[0]) × (quad[3] - quad[0]) in
    if n.length == 0.0D then 0.5D
    else 0.25D + 0.75D * abs(n.z) / n.length
    fi

quad(i: int, j: int) -> Quad =>
    [
        corner(i, j), corner(i + 1, j),
        corner(i + 1, j + 1), corner(i, j + 1)]

let quads =
    [quad(i, j) for i in 0..around for j in 0..along]
        |> sort((p, q) => depth(p) <> depth(q))
        |> collect()

let image = IMAGE(360, 360)

let flat = quads |> flat_map(q => q) |> collect()
let low_x = flat |> map(p => p.x) |> reduce(0.0D, min)
let high_x = flat |> map(p => p.x) |> reduce(0.0D, max)
let low_y = flat |> map(p => p.y) |> reduce(0.0D, min)
let high_y = flat |> map(p => p.y) |> reduce(0.0D, max)
let half = 0.53D * max(high_x - low_x, high_y - low_y)
let middle_x = (low_x + high_x) / 2.0D
let middle_y = (low_y + high_y) / 2.0D

image.view(
    middle_x - half, middle_y - half, middle_x + half, middle_y + half)
image.clear(248ub, 248ub, 244ub)
image.stroke(0.6D)

for q in quads do
    let light = brightness(q)
    let outline = q |> map(p => (x = p.x, y = p.y)) |> collect()

    image.colour(
        ubyte(60.0D * light),
        ubyte(150.0D * light),
        ubyte(200.0D * light))
    image.fill(outline)

    image.colour(20ub, 40ub, 60ub)
    image.line(outline |> cat([outline[0]]) |> collect())
od

write_line("a Klein bottle, immersed in three dimensions")
write_line("{quads.count} quadrilaterals, drawn farthest first")

image.write("klein.png")

image.show("klein.png")
