use default

let men_preferences = [
    ("abe", ["abi", "eve", "cath", "ivy", "jan",
             "dee", "fay", "bea", "hope", "gay"]),
    ("bob", ["cath", "hope", "abi", "dee", "eve",
             "fay", "bea", "jan", "ivy", "gay"]),
    ("col", ["hope", "eve", "abi", "dee", "bea",
             "fay", "ivy", "gay", "cath", "jan"]),
    ("dan", ["ivy", "fay", "dee", "gay", "hope",
             "eve", "jan", "bea", "cath", "abi"]),
    ("ed", ["jan", "dee", "bea", "cath", "fay",
            "eve", "abi", "ivy", "hope", "gay"]),
    ("fred", ["bea", "abi", "dee", "gay", "eve",
              "ivy", "cath", "jan", "hope", "fay"]),
    ("gav", ["gay", "eve", "ivy", "bea", "cath",
             "abi", "dee", "hope", "jan", "fay"]),
    ("hal", ["abi", "eve", "hope", "fay", "ivy",
             "cath", "jan", "bea", "gay", "dee"]),
    ("ian", ["hope", "cath", "dee", "gay", "bea",
             "abi", "fay", "ivy", "jan", "eve"]),
    ("jon", ["abi", "fay", "jan", "gay", "eve",
             "bea", "dee", "cath", "ivy", "hope"])
] |> collect_map()

let women_preferences = [
    ("abi", ["bob", "fred", "jon", "gav", "ian",
             "abe", "dan", "ed", "col", "hal"]),
    ("bea", ["bob", "abe", "col", "fred", "gav",
             "dan", "ian", "ed", "jon", "hal"]),
    ("cath", ["fred", "bob", "ed", "gav", "hal",
              "col", "ian", "abe", "dan", "jon"]),
    ("dee", ["fred", "jon", "col", "abe", "ian",
             "hal", "gav", "dan", "bob", "ed"]),
    ("eve", ["jon", "hal", "fred", "dan", "abe",
             "gav", "col", "ed", "ian", "bob"]),
    ("fay", ["bob", "abe", "ed", "ian", "jon",
             "dan", "fred", "gav", "col", "hal"]),
    ("gay", ["jon", "gav", "hal", "fred", "bob",
             "abe", "col", "ed", "dan", "ian"]),
    ("hope", ["gav", "jon", "bob", "abe", "ian",
              "dan", "hal", "ed", "col", "fred"]),
    ("ivy", ["ian", "col", "hal", "gav", "fred",
             "bob", "abe", "ed", "jon", "dan"]),
    ("jan", ["ed", "hal", "gav", "abe", "bob",
             "jon", "col", "ian", "fred", "dan"])
] |> collect_map()


rank(preferences: string[], name: string) -> int =>
    preferences |> find_index(* =~ name)!

prefers(
    preferences: Map[string, string[]],
    judge: string,
    a: string,
    b: string
) -> bool => rank(preferences[judge], a) < rank(preferences[judge], b)

engage() -> MAP[string, string] is
    let engaged_to = MAP()
    let next_choice = MAP()
    let free = LIST(men_preferences.keys |> sort())

    for man in men_preferences.keys do
        next_choice[man] = 0
    od

    while let [man, ..] = free do
        let woman = men_preferences[man][next_choice[man]]

        next_choice[man] = next_choice[man] + 1

        if !engaged_to.contains_key(woman) then
            free.remove_at(0)
            engaged_to[woman] = man
        elif prefers(women_preferences, woman, man, engaged_to[woman]) then
            free.remove_at(0)
            free.add(engaged_to[woman])
            engaged_to[woman] = man
        fi
    od

    engaged_to
si

is_stable(engaged_to: MAP[string, string]) -> bool =>
    engaged_to.keys |> all(woman =>
        men_preferences.keys |> all(man =>
            man =~ engaged_to[woman] \/
                !prefers(men_preferences, man, woman,
                    find_partner(engaged_to, man)) \/
                !prefers(women_preferences, woman, man, engaged_to[woman])))

find_partner(engaged_to: MAP[string, string], man: string) -> string =>
    engaged_to.keys |> find(woman => engaged_to[woman] =~ man) ?? ""

let engaged_to = engage()

engaged_to.keys
    |> sort()
    |> each(woman => write_line("{woman} - {engaged_to[woman]}"))

write_line("stable: {is_stable(engaged_to)}")

let first = engaged_to.keys |> sort() |> collect()
(engaged_to[first[0]], engaged_to[first[1]]) =
    (engaged_to[first[1]], engaged_to[first[0]])

write_line("stable after perturbation: {is_stable(engaged_to)}")
