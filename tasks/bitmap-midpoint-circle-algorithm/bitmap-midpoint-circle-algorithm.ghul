use Raster.IMAGE

circle(centre_x: int, centre_y: int, radius: int) -> (int, int){} is
    let x mut = radius
    let y mut = 0
    let error mut = 1 - radius

    while x >= y do
        yield (centre_x + x, centre_y + y)
        yield (centre_x + y, centre_y + x)
        yield (centre_x - y, centre_y + x)
        yield (centre_x - x, centre_y + y)
        yield (centre_x - x, centre_y - y)
        yield (centre_x - y, centre_y - x)
        yield (centre_x + y, centre_y - x)
        yield (centre_x + x, centre_y - y)

        y = y + 1

        if error < 0 then
            error = error + 2 * y + 1
        else
            x = x - 1
            error = error + 2 * (y - x) + 1
        fi
    od
si

let image = IMAGE(400, 400)

for radius in 1..10 do
    for (x, y) in circle(200, 200, radius * 18) do
        image.set_pixel(x, y, 0ub, 0ub, 160ub)
    od
od

image.write("circles.png")

image.show("circles.png")
