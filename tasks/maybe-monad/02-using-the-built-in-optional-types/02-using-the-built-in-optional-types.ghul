use IO.Std.write_line

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `~>` is the absent-coalescing thread-first operator - it skips the call
//  when the left value is absent, and the result is then absent too
// `==` compares identity

halve(n: int) -> int? => if n % 2 == 0 then n / 2 else null fi

describe(n: int) -> string? => if n > 0 then "positive {n}" else null fi

show(n: int?) =>
    write_line("{n}: {n ~> halve() ~> describe() ?? "nothing"}")

show(8)
show(7)
show(-4)
