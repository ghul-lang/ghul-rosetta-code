use default

let pair_bound = 1200

cube(x: long) -> long => x * x * x

let taxis =
    [cube(long(a)) + cube(long(b))
        for a in 1..pair_bound for b in (a + 1)..pair_bound]
    |> sort()
    |> group_by(value => value)
    |> filter((_, group) => group.count > 1)
    |> map((value, _) => value)
    |> collect()

cube_root(value: long) -> long => (
    let cube_root_of = System.Math.cbrt(cast(value))
    let root = long(System.Math.floor(cube_root_of + 0.5D))

    if root * root * root == value then root else 0L fi
)

expressions(taxi: long) -> string =>
    from(1L)
    |> take_while(a => cube(a) * 2L < taxi)
    |> map(a => (a, cube_root(taxi - cube(a))))
    |> filter((_, b) => b > 0L)
    |> map((a, b) => "{a}^3 + {b}^3")
    |> join(" = ")

show(rank: int, taxis: List[long]) =>
    let taxi = taxis[rank - 1] in
    write_line("{rank}: {taxi} = {expressions(taxi)}")

write_line("the lowest 25 taxicab numbers:")

for rank in 1::25 do
    show(rank, taxis)
od

write_line("the 2000th taxicab number, and half a dozen more:")

for rank in 2000::2006 do
    show(rank, taxis)
od
