use default

escaped(text: string) -> string =>
    text
        |> map(character =>
            case character
            when '&' then "&amp;"
            when '<' then "&lt;"
            when '>' then "&gt;"
            else "{character}"
            esac)
        |> join("")

row(line: string, cell: string) -> string =>
    line.split([','])
        |> map(value => "      <{cell}>{escaped(value)}</{cell}>")
        |> join("\n")

table(csv: string) -> string => (
    let lines = csv.split(['\n'])

    let head =
        "  <thead>\n    <tr>\n{row(lines[0], "th")}\n    </tr>\n  </thead>"
    let body =
        lines[1..lines.count]
            |> map(line => "    <tr>\n{row(line, "td")}\n    </tr>")
            |> join("\n")

    "<table>\n{head}\n  <tbody>\n{body}\n  </tbody>\n</table>"
)


let csv =
    "Character,Speech\n"
    "The multitude,The messiah! Show us the messiah!\n"
    "Brians mother,<angry>Now you listen here! He's not the messiah; "
    "he's a very naughty boy! Now go away!</angry>\n"
    "The multitude,Who are you?\n"
    "Brians mother,I'm his mother; that's who!\n"
    "The multitude,Behold his mother! Behold his mother!"

write_line(table(csv))
