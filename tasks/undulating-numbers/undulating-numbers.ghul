use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `*` as an argument leaves that parameter open: partial application.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

undulating_value(first: int, second: int, length: int) -> long =>
    0..length
        |> reduce(0L, (value, position) =>
            value * 10L +
            cast(if position % 2 == 0 then first else second fi)
        )

let limit = 9007199254740992L

let values = LIST()

for length in 3..17 do
    for first in 1..10 do
        for second in 0..10 do
            if second != first then
                let value = undulating_value(first, second, length)

                if value < limit then
                    values.add(value)
                fi
            fi
        od
    od
od

let three_digit = values |> filter(* < 1000L) |> list()
let four_digit = values |> filter(v => v >= 1000L /\ v < 10000L)

write_line("three digit:")

for row in 0..9 do
    write_line(
        three_digit
            |> skip(row * 9)
            |> take(9)
            |> map(v => "{v}")
            |> join(" ")
    )
od

write_line("four digit:")

for row in 0..9 do
    write_line(
        four_digit
            |> skip(row * 9)
            |> take(9)
            |> map(v => "{v}")
            |> join(" ")
    )
od

prime(value: long) -> bool =>
    value >= 2L /\
    2L::long(Ghul.Math.sqrt(double(value))) |> all(d => value % d != 0L)

write_line("three digit primes:")

write_line(three_digit |> filter(prime) |> map(v => "{v}") |> join(" "))

write_line("600th: {values[599]}")

write_line(
    "{values.count} undulating numbers below 2^53, "
    "the largest is {values[values.count - 1]}"
)
