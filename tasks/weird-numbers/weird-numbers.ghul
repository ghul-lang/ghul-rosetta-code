use default

sums_to(divisors: List[int], target: int) -> bool =>
    case (divisors, target)
    when (_, 0) then true
    when ([], _) then false
    when ([d, ..rest], _) then
        if d > target then sums_to(rest, target)
        else sums_to(rest, target - d) \/ sums_to(rest, target)
        fi
    esac

weird(n: int) -> bool => (
    let proper =
        n |> divisors() |> filter(d => d != n) |> sort_descending() |> collect()

    proper |> sum() > n /\
        !sums_to(proper, n))

from(2)
    |> filter(weird)
    |> take(25)
    |> chunk(5)
    |> each(row =>
        write_line(row |> map(n => "{n,7}") |> join("")))
