use default

proper_divisors(n: int) -> int{} =>
    [1] ++ (
        from(2)
            |> take_while(d => d * d <= n)
            |> filter(d => n % d == 0)
            |> flat_map(d => if d == n / d then [d] else [d, n / d] fi))

sums_to(divisors: List[int], target: int) -> bool =>
    case (divisors, target)
    when (_, 0) then true
    when ([], _) then false
    when ([d, ..rest], _) then
        if d > target then sums_to(rest, target)
        else sums_to(rest, target - d) \/ sums_to(rest, target)
        fi
    esac

weird(n: int) -> bool => (
    let divisors = proper_divisors(n) |> sort_descending() |> collect()

    divisors |> sum() > n /\
        !sums_to(divisors, n))

from(2)
    |> filter(weird)
    |> take(25)
    |> chunk(5)
    |> each(row =>
        write_line(row |> map(n => "{n,7}") |> join("")))
