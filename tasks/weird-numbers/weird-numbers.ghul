use default

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity
// `case ... when` pattern-matches, and `[x, ..rest]` matches a list head
// and tail

sums_to(divisors: int[], target: int) -> bool =>
    case (divisors, target)
    when (_, 0) then true
    when ([], _) then false
    when ([d, ..rest], _) then
        if d > target then sums_to(rest, target)
        else sums_to(rest, target - d) \/ sums_to(rest, target)
        fi
    esac

weird(n: int) -> bool => (
    let proper =
        n
            |> divisors()
            |> filter(d => d != n)
            |> sort_descending()
            |> list()

    proper |> sum() > n /\ !sums_to(proper, n)
)

from(2)
    |> filter(weird)
    |> take(25)
    |> chunk(5)
    |> each(row => write_line(row |> map(n => "{n,7}") |> join("")))
