use default

proper_divisors(n: int) -> List[int] is
    let divisors = LIST([1])
    let candidate mut = 2

    while candidate * candidate <= n do
        if n % candidate == 0 then
            divisors.add(candidate)

            if candidate != n / candidate then
                divisors.add(n / candidate)
            fi
        fi

        candidate = candidate + 1
    od

    divisors
si

sums_to(divisors: List[int], target: int) -> bool =>
    case (divisors, target)
    when (_, 0) then true
    when ([], _) then false
    when ([d, ..rest], _) then
        if d > target then sums_to(rest, target)
        else sums_to(rest, target - d) \/ sums_to(rest, target)
        fi
    esac

weird(n: int) -> bool =>
    (let divisors = proper_divisors(n) |> sort_descending() |> collect()

     divisors |> sum() > n /\
         !sums_to(divisors, n))

from(2)
    |> filter(weird)
    |> take(25)
    |> chunk(5)
    |> each(row =>
        write_line(row |> map(n => "{n,7}") |> join("")))
