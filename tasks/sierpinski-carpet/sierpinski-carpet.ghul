use default

let order = 3

filled(x: int, y: int) -> bool =>
    if x == 0 /\ y == 0 then true
    elif x % 3 == 1 /\ y % 3 == 1 then false
    else filled(x / 3, y / 3)
    fi

let size = repeat(3, order) |> product()

for down in 0..size do
    write_line(
        (0..size)
            |> map(across =>
                if filled(across, down) then "#" else " " fi
            )
            |> join("")
    )
od
