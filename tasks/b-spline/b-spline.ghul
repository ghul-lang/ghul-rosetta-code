use default
use Raster.IMAGE

use Point = (x: double, y: double)

let control: Point[] = [
    (171.0, 171.0), (185.0, 111.0), (202.0, 109.0), (202.0, 189.0),
    (328.0, 160.0), (208.0, 254.0), (241.0, 330.0), (164.0, 252.0),
    (69.0, 278.0), (139.0, 208.0), (72.0, 148.0), (168.0, 172.0)
]

let degree = 3
let spans = control.count - degree

knot(i) => double(clamp(i - degree, 0, spans))

lerp(a, b, t) => (
    x = a.x + (b.x - a.x) * t,
    y = a.y + (b.y - a.y) * t
)

de_boor(t) is
    let span = min(int(t), spans - 1) + degree
    let d = LIST(0::degree |> map(j => control[j + span - degree]))

    for r in 1::degree do
        for step in 0::degree - r do
            let j = degree - step
            let i = j + span - degree
            let left = knot(i)
            let right = knot(i + degree + 1 - r)
            let alpha = (t - left) / (right - left)

            d[j] = lerp(d[j - 1], d[j], alpha)
        od
    od

    d[degree]
si

let samples = 400

let curve =
    (0::samples)
        |> map(s => de_boor(double(spans * s) / double(samples)))
        |> list()

let image = IMAGE(400, 400)

image.clear(252ub, 250ub, 245ub)

image.color(190ub, 190ub, 200ub)
image.stroke(1.0)
image.line(control)

image.color(200ub, 60ub, 50ub)

for p in control do
    image.dot(p.x, p.y, 3.0)
od

image.color(30ub, 70ub, 150ub)
image.stroke(2.5)
image.line(curve)

let first = curve[0]
let last = curve[curve.count - 1]

write_line("clamped cubic B-spline over {control.count} control points")
write_line("starts at ({first.x:F1}, {first.y:F1})")
write_line("ends at ({last.x:F1}, {last.y:F1})")

image.write("b-spline.png")

image.show("b-spline.png")
