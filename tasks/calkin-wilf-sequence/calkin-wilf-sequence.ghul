use default

next_term(numerator, denominator) => (
    denominator,
    denominator * (2 * (numerator / denominator) + 1) - numerator
)

let terms = stream(
    (1, 1),
    ((numerator, denominator)) =>
        "{numerator}/{denominator}" || next_term(numerator, denominator)
)

write_line(terms |> take(20) |> join(" "))

quotients(left, right) is
    if right > 0 then
        yield left / right
        yield in quotients(right, left % right)
    fi
si

continued_fraction(numerator, denominator) =>
    let terms = quotients(numerator, denominator) |> list() in
    if terms.count % 2 == 0 then
        (terms |> take(terms.count - 1)) ++ [terms[terms.count - 1] - 1, 1]
    else
        terms
    fi

let fraction = continued_fraction(83116, 51639)

let bits =
    fraction
        |> reverse()
        |> index()
        |> map((step, run) =>
            string(if step % 2 == 0 then '1' else '0' fi, run)
        )
        |> string()

write_line("83116/51639 is term {System.Convert.to_int64(bits, 2)}")
