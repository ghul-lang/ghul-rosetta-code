use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

let letters = 'a'::'z' |> list()

let last = letters.count - 1

write_line(letters |> join(""))
write_line("{letters.count} letters, {letters[0]} to {letters[last]}")
