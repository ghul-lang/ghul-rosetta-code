use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

almost_primes(k: int) -> int{} =>
    from(2) |> filter(n => prime_factors(n) |> count() == k)

for k in 1::5 do
    let first_ten = almost_primes(k) |> take(10) |> map(n => "{n,5}")

    write_line("k = {k}:{first_ten |> join("")}")
od
