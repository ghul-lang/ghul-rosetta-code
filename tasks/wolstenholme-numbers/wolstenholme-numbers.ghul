use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

write_line("summing the harmonic numerators")
write_line("")

wolstenholme(count: int) -> bigint{} is
    let numerator mut = 0n
    let denominator mut = 1n

    for k in 1::count do
        let square = bigint(k) * bigint(k)

        numerator = numerator * square + denominator
        denominator = denominator * square

        let common = gcd(numerator, denominator)

        numerator = numerator / common
        denominator = denominator / common

        yield numerator
    od
si

write_line("the first twenty Wolstenholme numbers:")

for term in wolstenholme(20) do
    write_line("  {term}")
od

write_line("")
write_line("the first four prime Wolstenholme numbers:")

let prime_terms = wolstenholme(20) |> filter(is_prime) |> take(4)

for term in prime_terms do
    write_line("  {term}")
od

write_line("")
write_line("digit counts:")

let wanted = [500, 1_000, 2_500, 5_000, 10_000]
let position mut = 0

for term in wolstenholme(10_000) do
    position = position + 1

    if wanted |> any(w => w == position) then
        let digits = term.to_string().length

        write_line("  term {position,5} has {digits} digits")
    fi
od
