use default
use Raster.Anchor
use Raster.AXES
use Raster.IMAGE

fivenum(xs_raw: double[]) -> double[] is
    let xs = xs_raw |> sort() |> list()
    let n = xs.count
    let n4 = floor((double(n) + 3.0) / 2.0) / 2.0
    let d = [
        1.0, n4, (double(n) + 1.0) / 2.0,
        double(n) + 1.0 - n4, double(n)
    ]
    midpoint(di) =>
        let
            lo = xs[int(floor(di)) - 1],
            hi = xs[int(ceiling(di)) - 1]
        in
            0.5 * (lo + hi)

    d |> map(midpoint) |> list()
si

let datasets = [
    (
        label = "first set",
        values = [
            15.0, 6.0, 42.0, 41.0, 7.0, 36.0, 49.0, 40.0, 39.0, 47.0, 43.0
        ]
    ),
    (label = "second set", values = [36.0, 40.0, 7.0, 39.0, 41.0, 15.0])
]

let half = 0.16

let dark = (red = 45ub, green = 75ub, blue = 130ub)
let pale = (red = 160ub, green = 185ub, blue = 225ub)
let median_color = (red = 195ub, green = 70ub, blue = 45ub)

box(image: IMAGE, summary: double[], center: double) is
    image.color(dark)
    image.stroke(1.4)
    image.line(summary[0], center, summary[4], center)
    image.line(summary[0], center - half, summary[0], center + half)
    image.line(summary[4], center - half, summary[4], center + half)

    image.color(pale)
    image.fill_rectangle(
        summary[1],
        center - half,
        summary[3],
        center + half
    )

    image.color(dark)
    image.line([
        (x = summary[1], y = center - half),
        (x = summary[3], y = center - half),
        (x = summary[3], y = center + half),
        (x = summary[1], y = center + half),
        (x = summary[1], y = center - half)
    ])

    image.color(median_color)
    image.stroke(2.2)
    image.line(summary[2], center - half, summary[2], center + half)
si

annotate(image: IMAGE, summary: double[], center: double) is
    image.color(80ub, 85ub, 100ub)

    for at in [0, 2, 4] do
        image.text(
            summary[at],
            center - half - 0.155,
            12.0,
            "{summary[at]}",
            Anchor.CENTER
        )
    od

    for at in [1, 3] do
        image.text(
            summary[at],
            center + half + 0.055,
            12.0,
            "{summary[at]}",
            Anchor.CENTER
        )
    od
si

let image = IMAGE(740, 320)

image.color(95ub, 100ub, 115ub)
image.stroke(1.0)

let axes = AXES(image)

axes.x_title = "value"
axes.y_ticks(
    datasets
        |> index()
        |> map(set => (
            value = double(datasets.count - set.index) - 0.5,
            label = set.value.label
        ))
        |> list()
)

axes.fit(0.0, 0.0, 55.0, double(datasets.count))
axes.draw()

for set in datasets |> index() do
    let center = double(datasets.count - set.index) - 0.5

    box(image, fivenum(set.value.values), center)
    annotate(image, fivenum(set.value.values), center)
od

image.write("fivenum.png")

image.show("fivenum.png")
