use default
use System.Math.*

fivenum(xs_raw: double[]) -> double[] is
    let xs = xs_raw |> sort() |> collect()
    let n = xs.count
    let n4 = floor((double(n) + 3.0) / 2.0) / 2.0
    let d = [
        1.0, n4, (double(n) + 1.0) / 2.0,
        double(n) + 1.0 - n4, double(n)
    ]
    midpoint(di: double) -> double is
        let lo = xs[int(floor(di)) - 1]
        let hi = xs[int(ceiling(di)) - 1]

        0.5 * (lo + hi)
    si

    d |> map(midpoint) |> collect()
si

let datasets = [
    [15.0, 6.0, 42.0, 41.0, 7.0, 36.0, 49.0, 40.0, 39.0, 47.0, 43.0],
    [36.0, 40.0, 7.0, 39.0, 41.0, 15.0]
]

for xs in datasets do
    let data_text = xs |> map(x => "{x}") |> join()
    let result_text = fivenum(xs) |> map(x => "{x}") |> join()

    write_line("data: {data_text}")
    write_line("fivenum: {result_text}")
od
