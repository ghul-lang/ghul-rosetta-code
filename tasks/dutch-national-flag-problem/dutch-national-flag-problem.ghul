use default

// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `case ... when` pattern-matches, and `[x, ..rest]` matches a list head
//  and tail

enum Color is
    RED,
    WHITE,
    BLUE
si

is_sorted(balls: Color[]) -> bool =>
    0..balls.count - 1 |> all(i => balls[i] <= balls[i + 1])

shuffle(balls: LIST[Color], random: System.Random) is
    let i mut = balls.count - 1

    while i > 0 do
        let j = random.next(i + 1)
        (balls[i], balls[j]) = (balls[j], balls[i])
        i = i - 1
    od
si

dutch_flag_sort(balls: LIST[Color]) is
    let low mut = 0
    let mid mut = 0
    let high mut = balls.count - 1

    while mid <= high do
        case balls[mid]
        when Color.RED then
            (balls[low], balls[mid]) = (balls[mid], balls[low])
            low = low + 1
            mid = mid + 1
        when Color.WHITE then
            mid = mid + 1
        when Color.BLUE then
            (balls[high], balls[mid]) = (balls[mid], balls[high])
            high = high - 1
        esac
    od
si

let random = System.Random(42)
let balls = LIST([
    Color.RED, Color.RED, Color.RED,
    Color.WHITE, Color.WHITE, Color.WHITE,
    Color.BLUE, Color.BLUE, Color.BLUE
])

shuffle(balls, random)

while is_sorted(balls) do
    shuffle(balls, random)
od

write_line("random order:  {balls |> map(c => "{c}") |> join(", ")}")
write_line("already sorted: {is_sorted(balls)}")

dutch_flag_sort(balls)

write_line("sorted order:  {balls |> map(c => "{c}") |> join(", ")}")
write_line("now sorted:    {is_sorted(balls)}")
