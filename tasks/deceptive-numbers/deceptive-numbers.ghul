use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

divides_repunit(value: int) -> bool =>
    let remainder =
        (1..value) |> reduce(0, (running, _) => (running * 10 + 1) % value)
    in
    remainder == 0

let deceptive =
    from(7)
        |> filter(candidate => candidate % 2 != 0 /\ candidate % 5 != 0)
        |> filter(candidate => !is_prime(candidate))
        |> filter(divides_repunit)

write_line("the first 25 deceptive numbers:")

deceptive
    |> take(25)
    |> chunk(5)
    |> each(row => write_line(row |> map(value => "{value,7}") |> join("")))
