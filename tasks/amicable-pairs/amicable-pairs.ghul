use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

let limit = 20000

(1::limit)
    |> map(n => (n, partner = divisor_sum(n) - n))
    |> filter((n, partner) =>
        partner > n /\ divisor_sum(partner) - partner == n
    )
    |> each((n, partner) => write_line("{n} and {partner}"))
