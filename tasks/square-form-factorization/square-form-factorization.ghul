use default

let multipliers = [
    1, 3, 5, 7, 11, 3 * 5, 3 * 7, 3 * 11, 5 * 7, 5 * 11, 7 * 11,
    3 * 5 * 7, 3 * 5 * 11, 3 * 7 * 11, 5 * 7 * 11,
    3 * 5 * 7 * 11
]

// Shanks's method: walk the principal cycle of forms for kN until the
// last coefficient is a square, take the square root form, and walk its
// cycle to the symmetry point, where the coefficient shares a factor
// with N.
squfof(n: bigint) -> bigint? is
    let s = isqrt(n)

    if s * s =~ n then
        return s
    fi

    let bound = 3n * isqrt(8n * s)

    for k in multipliers do
        let d = bigint(k) * n
        let p0 = isqrt(d)
        let p mut = p0
        let p_previous mut = p0
        let q_previous mut = 1n
        let q mut = d - p0 * p0
        let root mut = 0n
        let i mut = 2n
        let found mut = false

        while i < bound /\ !q.is_zero do
            let b = (p0 + p) / q

            p = b * q - p

            let next = q_previous + b * (p_previous - p)

            q_previous = q
            q = next
            p_previous = p

            if i.is_even /\ is_square(q) then
                root = isqrt(q)
                found = true
                break
            fi

            i = i + 1n
        od

        if !found then
            continue
        fi

        let b0 = (p0 - p) / root

        p = b0 * root + p
        p_previous = p
        q_previous = root
        q = (d - p_previous * p_previous) / q_previous

        do
            let b = (p0 + p) / q

            p_previous = p
            p = b * q - p

            let next = q_previous + b * (p_previous - p)

            q_previous = q
            q = next

            if p =~ p_previous then
                break
            fi
        od

        let factor = gcd(n, q_previous)

        if !factor.is_one /\ factor !~ n then
            return factor
        fi
    od

    null
si

let examples = [
    2501L, 12851L, 13289L, 75301L, 120787L, 967009L, 997417L,
    7091569L,
    13290059L, 42854447L, 223553581L, 2027651281L, 11111111111L,
    100895598169L, 1002742628021L, 60012462237239L,
    287129523414791L,
    9007199254740931L, 11111111111111111L, 314159265358979323L,
    384307168202281507L, 419244183493398773L,
    658812288346769681L,
    922337203685477563L, 1000000000000000127L,
    1152921505680588799L,
    1537228672809128917L, 4611686018427387877L
]

write_line("Integer              Factor       Quotient")

for n in examples do
    let big = bigint(n)

    if let factor = squfof(big) then
        write_line("{n,-20} {factor,-12} {big / factor}")
    else
        write_line("{n,-20} fail")
    fi
od
