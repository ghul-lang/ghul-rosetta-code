use default

microsoft_rand(seed: int) -> Pipe[int] is
    let state mut = long(seed)

    while true do
        state = (214013L * state + 2531011L) % 2147483648L
        yield int(state / 65536L)
    od
si

let ranks = "A23456789TJQK"
let suits = "CDHS"

name(card: int) -> string => "{ranks[card / 4]}{suits[card % 4]}"

deal(game: int) -> List[string] is
    let deck = LIST(0..52)
    let dealt = LIST()
    let random = microsoft_rand(game)

    while deck.count > 0 do
        let index = (random |> first()) ?? 0
        let chosen = index % deck.count
        let last = deck.count - 1

        dealt.add(name(deck[chosen]))

        deck[chosen] = deck[last]
        deck.remove_at(last)
    od

    dealt
si

for game in [1, 617] do
    write_line("Game #{game}")

    let cards = deal(game)

    for row in 0..(cards.count + 7) / 8 do
        write_line(cards |> skip(row * 8) |> take(8) |> join(" "))
    od

    write_line("")
od
