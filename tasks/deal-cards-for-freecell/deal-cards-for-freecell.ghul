use default

microsoft_rand(seed: int) -> int{} is
    let state mut = long(seed)

    while true do
        state = (214013L * state + 2531011L) % 2147483648L
        yield int(state / 65536L)
    od
si

let ranks = "A23456789TJQK"
let suits = "CDHS"

name(card: int) -> string =>
    "{ranks[card / 4]}{suits[card % 4]}"

deal(game: int) -> string{} is
    let deck = LIST(0..52)

    for index in microsoft_rand(game) |> take(52) do
        let chosen = index % deck.count
        let last = deck.count - 1

        yield name(deck[chosen])

        deck[chosen] = deck[last]
        deck.remove_at(last)
    od
si

for game in [1, 617] do
    write_line("Game #{game}")

    for row in deal(game) |> chunk(8) do
        write_line(row |> join(" "))
    od

    write_line("")
od
