use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

fibonacci() -> int{} is
    let previous mut = 0
    let current mut = 1
    do
        yield previous

        (previous, current) = (current, previous + current)
    od
si

let fib = n => fibonacci() |> skip(n) |> first()

for (position, value) in fibonacci() |> take(10) |> index() do
    write_line("fib({position}) = {value}")
od

write_line("fib(30) = {fib(30)}")
