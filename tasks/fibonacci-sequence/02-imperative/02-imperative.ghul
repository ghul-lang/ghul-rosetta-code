use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `yield` makes the function a generator: it returns a lazy `T{}`.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

fibonacci() -> int{} is
    let previous mut = 0
    let current mut = 1
    do
        yield previous

        (previous, current) = (current, previous + current)
    od
si

let fib = n => fibonacci() |> skip(n) |> first()

for (position, value) in fibonacci() |> take(10) |> index() do
    write_line("fib({position}) = {value}")
od

write_line("fib(30) = {fib(30)}")
