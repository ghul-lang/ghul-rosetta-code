use default

let standard_deviation =
    let
        count mut = 0,
        total mut = 0.0,
        squares mut = 0.0
    in
        sample => (
            count = count + 1
            total = total + sample
            squares = squares + sample * sample

            let mean = total / cast(count)

            sqrt(squares / cast(count) - mean * mean)
        )

for sample in [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0] do
    write_line("after {sample}: {standard_deviation(sample)}")
od
