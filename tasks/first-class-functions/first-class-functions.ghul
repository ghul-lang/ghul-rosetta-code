use Ghul
use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

let cube = x => x * x * x
let cube_root = x => cbrt(x)

let functions = [sin, cos, cube]
let inverses = [asin, acos, cube_root]

for (function, inverse) in functions |> zip(inverses) do
    let round_trip = function >> inverse

    write_line("{round_trip(0.5D):F6}")
od
