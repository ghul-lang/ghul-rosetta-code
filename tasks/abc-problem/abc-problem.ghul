use default

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

without(blocks: string[], at: int) -> string[] =>
    blocks
        |> index()
        |> filter(block => block.index != at)
        |> map(block => block.value)
        |> list()

can_spell(word: string, blocks: string[]) -> bool =>
    word.length == 0 \/
    (
        blocks
            |> index()
            |> filter(block => block.value.contains(word[0]))
            |> any(block =>
                can_spell(word.substring(1), blocks |> without(block.index))
            )
    )

let blocks = [
    "BO", "XK", "DQ", "CP", "NA", "GT", "RE", "TG", "QD", "FS",
    "JW", "HU", "VI", "AN", "OB", "ER", "FS", "LY", "PC", "ZM"
]

can_make_word(word: string) -> bool => can_spell(word.to_upper(), blocks)

for
    word in [
        "A", "BARK", "BOOK", "TREAT", "COMMON", "SQUAD",
        "CONFUSE"
    ]
do
    write_line("can_make_word(\"{word}\") = {can_make_word(word)}")
od
