use default

let values = [1, 2, 2, 3, 4, 4, 5]

for index in 0..values.count do
    let current = values[index]
    let previous: int mut

    if index > 0 /\ current == previous then
        write_line("{index}")
    fi

    previous = current
od

write_line("")

let previous mut = 0

for index in 0..values.count do
    let current = values[index]

    if index > 0 /\ current == previous then
        write_line("{index}")
    fi

    previous = current
od
