use default
use Raster.IMAGE

scene() is
    let image = IMAGE(160, 120)

    for y in 0..80 do
        let t = double(y) / 80.0

        image.color(
            ubyte(40.0 + 200.0 * t),
            ubyte(70.0 + 100.0 * t),
            ubyte(160.0 - 60.0 * t)
        )
        image.fill_rectangle(0.0, double(y), 160.0, double(y + 1))
    od

    image.color(255ub, 220ub, 60ub)
    image.disc(112.0, 42.0, 15.0)

    image.color(90ub, 60ub, 120ub)
    image.fill([
        (0.0, 80.0),
        (45.0, 30.0),
        (95.0, 80.0)
    ])

    image.color(60ub, 110ub, 70ub)
    image.fill([
        (55.0, 80.0),
        (105.0, 48.0),
        (160.0, 80.0)
    ])

    image.color(70ub, 150ub, 60ub)
    image.fill_rectangle(0.0, 80.0, 160.0, 120.0)

    image.color(200ub, 35ub, 40ub)
    image.fill_rectangle(22.0, 88.0, 52.0, 110.0)

    image.color(120ub, 25ub, 30ub)
    image.fill([
        (18.0, 88.0),
        (37.0, 75.0),
        (56.0, 88.0)
    ])

    image.color(250ub, 245ub, 235ub)
    image.fill_rectangle(33.0, 97.0, 41.0, 110.0)

    image
si

class FIELD is
    width: int
    height: int
    values: LIST[double]

    init(width: int, height: int) is
        self.width = width
        self.height = height
        values = repeat(0.0, width * height) |> LIST()
    si

    at(x: int, y: int) -> double =>
        values[clamp(y, 0, height - 1) * width + clamp(x, 0, width - 1)]

    put(x: int, y: int, v: double) is
        values[y * width + x] = v
    si
si

grayscale(image) is
    let gray = FIELD(image.width, image.height)

    for y in 0..image.height do
        for x in 0..image.width do
            let p = image.pixel(x, y)

            gray.put(
                x,
                y,
                0.299 * double(p.red) +
                0.587 * double(p.green) +
                0.114 * double(p.blue)
            )
        od
    od

    gray
si

let gaussian = [
    [2.0, 4.0, 5.0, 4.0, 2.0],
    [4.0, 9.0, 12.0, 9.0, 4.0],
    [5.0, 12.0, 15.0, 12.0, 5.0],
    [4.0, 9.0, 12.0, 9.0, 4.0],
    [2.0, 4.0, 5.0, 4.0, 2.0]
]

blur(f) is
    let result = FIELD(f.width, f.height)

    for y in 0..f.height do
        for x in 0..f.width do
            let total mut = 0.0

            for j in 0..5 do
                for i in 0..5 do
                    let weight = gaussian[j][i]

                    total = total + weight * f.at(x + i - 2, y + j - 2)
                od
            od

            result.put(x, y, total / 159.0)
        od
    od

    result
si

canny(f, low, high) is
    let w = f.width, h = f.height
    let magnitude = FIELD(w, h)
    let direction = repeat(0, w * h) |> LIST()

    for y in 0..h do
        for x in 0..w do
            let n = (dx, dy) => f.at(x + dx, y + dy)

            let gx =
                n(1, -1) +
                2.0 * n(1, 0) +
                n(1, 1) -
                n(-1, -1) -
                2.0 * n(-1, 0) -
                n(-1, 1)
            let gy =
                n(-1, 1) +
                2.0 * n(0, 1) +
                n(1, 1) -
                n(-1, -1) -
                2.0 * n(0, -1) -
                n(1, -1)

            magnitude.put(x, y, sqrt(gx * gx + gy * gy))

            let angle = atan2(gy, gx) * 180.0 / pi
            let sector = int(round((angle + 180.0) / 45.0)) % 4

            direction[y * w + x] = sector
        od
    od

    let steps = [(1, 0), (1, 1), (0, 1), (-1, 1)]
    let thin = FIELD(w, h)

    for y in 1..h - 1 do
        for x in 1..w - 1 do
            let (dx, dy) = steps[direction[y * w + x]]
            let m = magnitude.at(x, y)

            if
                m >= magnitude.at(x + dx, y + dy) /\
                m >= magnitude.at(x - dx, y - dy)
            then
                thin.put(x, y, m)
            fi
        od
    od

    let edges = FIELD(w, h)
    let pending = STACK[(int, int)]()

    for y in 0..h do
        for x in 0..w do
            if thin.at(x, y) >= high then
                edges.put(x, y, 1.0)
                pending.push((x, y))
            fi
        od
    od

    while pending.count > 0 do
        let (x, y) = pending.pop()

        for dy in -1::1 do
            for dx in -1::1 do
                let nx = x + dx, ny = y + dy

                if
                    nx >= 0 /\
                    nx < w /\
                    ny >= 0 /\
                    ny < h /\
                    edges.at(nx, ny) == 0.0 /\
                    thin.at(nx, ny) >= low
                then
                    edges.put(nx, ny, 1.0)
                    pending.push((nx, ny))
                fi
            od
        od
    od

    edges
si

scene().write("scene.png")

let input = IMAGE.read("scene.png")
let edges = canny(blur(grayscale(input)), 20.0, 50.0)

let found = edges.values |> filter(* > 0.0) |> count()

write_line("{found} of {edges.width * edges.height} pixels are on an edge")

let scale = 2
let output = IMAGE(edges.width * 2 * scale, edges.height * scale)

for y in 0..edges.height * scale do
    for x in 0..edges.width * scale do
        let p = input.pixel(x / scale, y / scale)
        let on = edges.at(x / scale, y / scale) > 0.0
        let shade = if on then 255ub else 0ub fi

        output.set_pixel(x, y, p.red, p.green, p.blue)
        output.set_pixel(x + edges.width * scale, y, shade, shade, shade)
    od
od

output.write("edges.png")

output.show("edges.png")
