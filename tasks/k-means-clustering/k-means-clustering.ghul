use default
use Raster.COLOR_MAP
use Raster.IMAGE

use Point = (x: double, y: double)

// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|> LIST()` reads the whole sequence into a new `LIST`
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

let random = System.Random(20260918)

let clusters = 6
let sample_size = 30_000

apart(a: Point, b: Point) -> double =>
    (a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y)

nearest(centers: Point[], at: Point) -> (index: int, distance: double) is
    let best mut = 0
    let closest mut = apart(centers[0], at)

    for index in 1..centers.count do
        let gap = apart(centers[index], at)

        if gap < closest then
            best = index
            closest = gap
        fi
    od

    return (index = best, distance = closest)
si

let points =
    (1::sample_size)
        |> map(_ => (
            let angle = random.next_double() * 2.0D * pi
            let radius = sqrt(random.next_double())

            (x = radius * cos(angle), y = radius * sin(angle))
        ))
        |> list()

seeded_centers() -> Point[] is
    let centers = LIST([points[random.next(points.count)]])

    while centers.count < clusters do
        let weights =
            points |> map(at => nearest(centers, at).distance) |> list()

        let total = weights |> sum()

        let target mut = random.next_double() * total
        let chosen mut = 0

        while chosen < weights.count - 1 /\ target > weights[chosen] do
            target = target - weights[chosen]
            chosen = chosen + 1
        od

        centers.add(points[chosen])
    od

    return centers
si

let centers mut = seeded_centers()
let membership = points |> map(_ => 0) |> LIST()

recentered() -> Point[] is
    let totals = LIST()
    let sizes = LIST()

    for _ in 0..clusters do
        totals.add((x = 0.0D, y = 0.0D))
        sizes.add(0)
    od

    for index in 0..points.count do
        let which = membership[index]
        let at = points[index]

        totals[which] = (
            x = totals[which].x + at.x,
            y = totals[which].y + at.y
        )

        sizes[which] = sizes[which] + 1
    od

    return
        (0..clusters)
            |> map(which =>
                if sizes[which] == 0 then
                    centers[which]
                else
                    (
                        x = totals[which].x / double(sizes[which]),
                        y = totals[which].y / double(sizes[which])
                    )
                fi
            )
            |> list()
si

let passes mut = 0
let settled mut = false

while !settled do
    settled = true
    passes = passes + 1

    for index in 0..points.count do
        let pick = nearest(centers, points[index]).index

        if pick != membership[index] then
            membership[index] = pick
            settled = false
        fi
    od

    centers = recentered()
od

let sizes = repeat(0, clusters) |> LIST()

for which in membership do
    sizes[which] = sizes[which] + 1
od

write_line(
    "{sample_size} points, {clusters} clusters, "
    "{passes} passes"
)
write_line("")
write_line("cluster   size   centroid")

for which in 0..clusters do
    let at = centers[which]

    write_line(
        "{which,7}{sizes[which],7}   "
        "({at.x,7:F4}, {at.y,7:F4})"
    )
od

let image = IMAGE(600, 600)

image.view(-1.06D, -1.06D, 1.06D, 1.06D)

for index in 0..points.count do
    let shade = double(membership[index]) / double(clusters)

    image.color(COLOR_MAP.hue(shade))
    image.dot(points[index].x, points[index].y, 1.4D)
od

image.stroke(2.0D)

for at in centers do
    image.color(255ub, 255ub, 255ub)
    image.dot(at.x, at.y, 6.0D)

    image.color(30ub, 30ub, 40ub)
    image.ring(at.x, at.y, 6.0D)
od

image.write("clusters.png")

image.show("clusters.png")
