use default

difference(from: double, to: double) -> double =>
    System.Math.ieeeremainder(to - from, 360.0)

let pairs = [
    (20.0, 45.0),
    (-45.0, 45.0),
    (-85.0, 90.0),
    (-95.0, 90.0),
    (-45.0, 125.0),
    (-45.0, 145.0),
    (29.4803, -88.6381),
    (-78.3251, -159.036),
    (-70099.74233810938, 29840.67437876723),
    (-165313.6666297357, 33693.9894517456),
    (1174.8380510598456, -154146.66490124757),
    (60175.77306795546, 42213.07192354373)
]

for (from, to) in pairs do
    write_line(
        "{from,14:F4} {to,14:F4} {difference(from, to),11:F4}"
    )
od
