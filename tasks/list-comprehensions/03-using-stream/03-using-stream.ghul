use default

triples(n: int) -> (int, int, int){} =>
    stream((1, 1, 1), (a, b, c) =>
        if a > n then STREAM.DONE
        elif c < n then (a, b, c) || (a, b, c + 1)
        elif b < n then (a, b, c) || (a, b + 1, b + 1)
        else (a, b, c) || (a + 1, a + 1, a + 1)
        fi)
    |> filter((a, b, c) => a * a + b * b == c * c)

write_line(triples(20) |> join())
