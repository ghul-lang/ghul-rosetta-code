use default
use Raster.IMAGE

let colors = ["red", "green", "purple"]
let numbers = ["one", "two", "three"]
let symbols = ["oval", "squiggle", "diamond"]
let shadings = ["solid", "open", "striped"]

struct CARD(color: int, number: int, symbol: int, shading: int) is
    to_string() -> string =>
        "{colors[color]}, {numbers[number]}, "
        "{symbols[symbol]}, {shadings[shading]}"
si

use Triple = (CARD, CARD, CARD)

is_set(t: Triple) -> bool =>
    let (a, b, c) = t in
    (a.color + b.color + c.color) % 3 == 0 /\
    (a.number + b.number + c.number) % 3 == 0 /\
    (a.symbol + b.symbol + c.symbol) % 3 == 0 /\
    (a.shading + b.shading + c.shading) % 3 == 0

triples(cards: CARD[]) -> Triple{} is
    for i in 0..cards.count do
        for j in i + 1..cards.count do
            for k in j + 1..cards.count do
                yield (cards[i], cards[j], cards[k])
            od
        od
    od
si

let deck =
    (0..81) |> map(i => CARD(i % 3, i / 3 % 3, i / 9 % 3, i / 27)) |> LIST()

let random = System.Random(81)

deal(size: int) -> CARD[] is
    for i in 0..size do
        let other = i + random.next(deck.count - i)
        (deck[i], deck[other]) = (deck[other], deck[i])
    od

    return deck |> take(size) |> list()
si

puzzle(size: int, wanted: int) -> CARD[] is
    do
        let cards = deal(size)

        if cards |> triples() |> filter(is_set) |> count() == wanted then
            return cards
        fi
    od
si

let deals = [
    (mode = "basic", cards = puzzle(9, 4), wanted = 4),
    (mode = "advanced", cards = puzzle(12, 6), wanted = 6)
]

for (mode, cards, wanted) in deals do
    write_line("{mode}: dealt {cards.count} cards")

    for card in cards do
        write_line("    {card}")
    od

    write_line()
    write_line("containing {wanted} sets")

    for (a, b, c) in cards |> triples() |> filter(is_set) do
        write_line()
        write_line("    {a}")
        write_line("    {b}")
        write_line("    {c}")
    od

    write_line()
od

let inks = [
    (220ub, 30ub, 50ub), (20ub, 150ub, 60ub), (110ub, 40ub, 150ub)
]

outline(symbol: int, x: double, y: double) -> List[(
    x: double,
    y: double
)] =>
    let steps = 32 in
    (0..steps)
        |> map(i =>
            let
                turn = double(i) / double(steps),
                t = 2.0 * pi * turn
            in
                case symbol
                when 0 then
                    (x = x + 8.0 * cos(t), y = y + 18.0 * sin(t))
                when 1 then
                    let dy = 18.0 * sin(t) in
                    (x = x + 7.0 * cos(t) + 4.0 * sin(dy / 6.0), y = y + dy)
                else
                    let
                        s = sin(t),
                        c = cos(t),
                        k = 1.0 / (abs(s) + abs(c))
                    in
                        (x = x + 9.0 * c * k, y = y + 19.0 * s * k)
                esac
        )
        |> list()

let card_width = 120.0
let card_height = 72.0
let gap = 12.0

let image = IMAGE(
    int(4.0 * card_width + 5.0 * gap),
    int(3.0 * card_height + 4.0 * gap)
)

image.view(0.0, double(image.height), double(image.width), 0.0)
image.clear(40ub, 90ub, 60ub)

for
    (card, place) in deals[1].cards
        |> index()
        |> map(iv => (iv.value, iv.index))
do
    let left = gap + double(place % 4) * (card_width + gap)
    let top = gap + double(place / 4) * (card_height + gap)
    let (red, green, blue) = inks[card.color]

    image.color(255ub, 255ub, 252ub)
    image.fill_rectangle(left, top, left + card_width, top + card_height)

    for i in 0..card.number + 1 do
        let offset = double(i) - double(card.number) / 2.0
        let x = left + card_width / 2.0 + 26.0 * offset
        let shape = outline(card.symbol, x, top + card_height / 2.0)

        if card.shading == 0 then
            image.color(red, green, blue)
            image.fill(shape)
        elif card.shading == 2 then
            image.color(
                ubyte(255 - (255 - int(red)) / 3),
                ubyte(255 - (255 - int(green)) / 3),
                ubyte(255 - (255 - int(blue)) / 3)
            )
            image.fill(shape)
        fi

        image.color(red, green, blue)
        image.stroke(2.0)
        image.line(shape ++ [shape[0]] |> list())
    od
od

image.write("set.png")

image.show("set.png")
