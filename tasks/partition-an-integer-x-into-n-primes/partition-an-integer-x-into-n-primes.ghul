use default

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `LIST()` builds its collection eagerly
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`
// `==` compares identity
// `if let` pattern-matches, and `[x, ..rest]` matches a list head and tail

let limit = 100_000
let composite = repeat(false, limit + 1) |> LIST()

for p in 2..317 do
    if !composite[p] then
        for multiple in from(p * p, p) |> take_while(* <= limit) do
            composite[multiple] = true
        od
    fi
od

let primes = 2::limit |> filter(n => !composite[n]) |> list()

partition(x: int, n: int, from_index: int) -> int[]? is
    if n == 0 then
        return if x == 0 then LIST() else null fi
    fi

    for i in from_index..primes.count do
        if primes[i] > x then
            break
        fi

        if let rest = partition(x - primes[i], n - 1, i + 1) then
            return [primes[i]] ++ rest |> list()
        fi
    od

    null
si

let cases = [
    (99809, 1), (18, 2), (19, 3), (20, 4), (2017, 24),
    (22699, 1), (22699, 2), (22699, 3), (22699, 4), (40355, 3)
]

for (x, n) in cases do
    let shown =
        if let found = partition(x, n, 0) then
            found |> join("+")
        else
            "not possible"
        fi

    write_line("Partitioned {x,5} with {n,2} primes: {shown}")
od
