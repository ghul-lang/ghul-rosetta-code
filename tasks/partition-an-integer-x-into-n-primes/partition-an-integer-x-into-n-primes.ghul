use default

let limit = 100_000
let composite = repeat(false, limit + 1) |> collect_mutable()

for p in 2..317 do
    if !composite[p] then
        for multiple in from(p * p, p) |> take_while(m => m <= limit) do
            composite[multiple] = true
        od
    fi
od

let primes = 2::limit |> filter(n => !composite[n]) |> collect()

partition(x: int, n: int, from_index: int) -> List[int]? is
    if n == 0 then
        return if x == 0 then LIST() else null fi
    fi

    for i in from_index..primes.count do
        if primes[i] > x then
            break
        fi

        if let rest = partition(x - primes[i], n - 1, i + 1) then
            return [primes[i]] |> cat(rest) |> collect()
        fi
    od

    null
si

let cases = [
    (99809, 1), (18, 2), (19, 3), (20, 4), (2017, 24),
    (22699, 1), (22699, 2), (22699, 3), (22699, 4), (40355, 3)
]

for (x, n) in cases do
    let shown =
        if let found = partition(x, n, 0) then
            found |> join("+")
        else
            "not possible"
        fi

    write_line("Partitioned {x,5} with {n,2} primes: {shown}")
od
