use default
use Raster.Anchor
use Raster.IMAGE
use Time.DATE_TIME
use System.Globalization.CultureInfo

let cycles = [
    ("Physical", 23),
    ("Emotional", 28),
    ("Mental", 33)
]

let quadrants = [
    ("up and rising", "peak"),
    ("up but falling", "transition"),
    ("down and falling", "valley"),
    ("down but rising", "transition")
]

date(text: string) -> DATE_TIME =>
    DATE_TIME.parse(text, CultureInfo.invariant_culture)

show(d: DATE_TIME) -> string => d.to_string("yyyy-MM-dd")

level(position: int, length: int) -> double =>
    sin(2.0 * pi * double(position) / double(length))

report(birth: DATE_TIME, target: DATE_TIME) is
    let days = int((target - birth).total_days)

    write_line("{show(birth)} to {show(target)}, day {days}:")

    for (label, length) in cycles do
        let position = days % length
        let quadrant = position * 4 / length
        let value = level(position, length)
        let percentage = floor(value * 1000.0) / 10.0

        let description =
            if percentage > 95.0 then
                "peak"
            elif percentage < -95.0 then
                "valley"
            elif abs(percentage) < 5.0 then
                "critical transition"
            else
                let
                    (trend, next) = quadrants[quadrant],
                    ahead = (quadrant + 1) * length / 4 - position,
                    due = show(target.add_days(double(ahead)))
                in
                    "{percentage}% ({trend}, next {next} {due})"
            fi

        write_line("  {label} day {position}: {description}")
    od

    write_line("")
si

report(date("1943-03-09"), date("1972-07-11"))
report(date("1809-01-12"), date("1863-11-19"))

let birth = date("1943-03-09")
let target = date("1972-07-11")
let center = int((target - birth).total_days)
let span = 16
let wide = double(span)

let image = IMAGE(480, 240)

image.view(-wide - 1.0, -1.55, wide + 1.0, 1.75)
image.clear(252ub, 250ub, 245ub)

image.color(200ub, 200ub, 205ub)
image.stroke(1.0)
image.line(-wide, 0.0, wide, 0.0)
image.line(0.0, -1.2, 0.0, 1.2)

let colors = [
    (200ub, 50ub, 40ub), (40ub, 130ub, 60ub), (40ub, 80ub, 180ub)
]

for (i, (label, length)) in cycles |> index() do
    let (r, g, b) = colors[i]

    image.color(r, g, b)
    image.stroke(2.0)
    image.line(
        (-span * 4::span * 4)
            |> map(q =>
                let day = double(q) / 4.0 in
                let turn = (double(center) + day) / double(length) in
                (day, sin(2.0 * pi * turn))
            )
            |> list()
    )
    image.text(-wide + 10.0 * double(i), 1.45, 13.0, label)
od

image.color(60ub, 60ub, 60ub)
image.text(0.0, -1.45, 12.0, show(target), Anchor.CENTER)

image.write("biorhythms.png")

image.show("biorhythms.png")
