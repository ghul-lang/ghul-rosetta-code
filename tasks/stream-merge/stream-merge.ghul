use default
use Ghul.Comparable

merge_two[T: Comparable[T]](left: T{}, right: T{}) -> T{} is
    case (left, right)
    when ([], _) then
        yield in right
    when (_, []) then
        yield in left
    when ([x, ..xs], [y, ..ys]) then
        if x <= y then
            yield x
            yield in merge_two(xs, right)
        else
            yield y
            yield in merge_two(left, ys)
        fi
    esac
si

merge_all[T: Comparable[T]](streams: T{}[]) -> T{} =>
    case streams
    when [] then LIST()
    when [s] then s
    else
        let middle = streams.count / 2 in
        merge_two(
            merge_all(streams[0..middle]),
            merge_all(streams[middle..<0])
        )
    esac

counting(start, step, count) => 0..count |> map(term => start + term * step)

let pair = merge_two(counting(0, 3, 4), counting(1, 3, 4))

write_line("two streams:")
write_line("  {pair |> join(" ")}")

let streams = [
    counting(0, 3, 4),
    counting(1, 3, 4),
    counting(2, 3, 4)
]

write_line("three streams:")
write_line("  {streams |> merge_all() |> join(" ")}")

write_line("nothing to merge:")
write_line("  [{merge_all[int]([]) |> join(" ")}]")

let words = [
    ["apple", "cherry", "grape"],
    ["banana", "date"]
]

write_line("two streams of words:")
write_line("  {words |> merge_all() |> join(" ")}")