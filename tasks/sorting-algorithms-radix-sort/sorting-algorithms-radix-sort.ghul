use default

// Least significant digit first, in base 10. Negative numbers are sorted
// by their magnitude on their own and put first, reversed.
radix_sort(values: List[int]) -> List[int] is
    sort_magnitudes(magnitudes: List[int]) -> List[int] is
        let current mut = magnitudes |> collect_mutable()
        let largest = current |> max() ?? 0
        let place mut = 1

        while largest / place > 0 do
            let buckets =
                0..10 |> map(_ => LIST()) |> collect()

            for v in current do
                buckets[v / place % 10].add(v)
            od

            current = buckets |> flat_map(b => b) |> collect_mutable()
            place = place * 10
        od

        current
    si

    let below =
        values |> filter(v => v < 0) |> map(v => -v) |> collect()
    let above = values |> filter(v => v >= 0) |> collect()
    let negatives = sort_magnitudes(below)
    let others = sort_magnitudes(above)

    cat(negatives |> reverse() |> map(v => -v), others) |> collect()
si

let values = [170, 45, 75, -90, -802, 24, 2, 66, 0, -1, 802]

write_line("before: {values |> join(" ")}")
write_line("after:  {radix_sort(LIST(values)) |> join(" ")}")
