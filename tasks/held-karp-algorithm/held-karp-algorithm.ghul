use default

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read, and `count` reads it all
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

held_karp(cost: int[][]) -> (total: int, tour: int[]) is
    let n = cost.count
    let subsets = 1 << n
    let unreached = int.max_value

    let best =
        0..subsets |> map(_ => repeat(unreached, n) |> LIST()) |> list()

    let previous = 0..subsets |> map(_ => repeat(-1, n) |> LIST()) |> list()

    best[1][0] = 0

    for visited in 0..subsets |> filter(s => s & 1 == 1) do
        for last in 0..n |> filter(c => best[visited][c] != unreached) do
            for next in 0..n |> filter(c => visited & (1 << c) == 0) do
                let extended = visited | (1 << next)
                let total = best[visited][last] + cost[last][next]

                if total < best[extended][next] then
                    best[extended][next] = total
                    previous[extended][next] = last
                fi
            od
        od
    od

    let everything = subsets - 1

    let final = 1..n |> min_by(c => best[everything][c] + cost[c][0])!

    let tour = LIST([0])
    let visited mut = everything
    let at mut = final

    while at != 0 do
        tour.add(at)
        let before = previous[visited][at]
        visited = visited & \(1 << at)
        at = before
    od

    tour.add(0)

    (total = best[everything][final] + cost[final][0], tour = tour)
si

let cost = [
    [0, 2, 9, 10],
    [1, 0, 6, 4],
    [15, 7, 0, 8],
    [6, 3, 12, 0]
]

let (total, tour) = held_karp(cost)

write_line("Minimum tour cost: {total}")
write_line("Tour: {tour |> reverse() |> join(" -> ")}")
