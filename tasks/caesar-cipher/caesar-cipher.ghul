use default

rotate(text: string, key: int) -> string =>
    text
        |> map(letter => rotate_letter(letter, key))
        |> string()

rotate_letter(letter: char, key: int) -> char =>
    let first =
        if letter >= 'a' /\ letter <= 'z' then int('a')
        elif letter >= 'A' /\ letter <= 'Z' then int('A')
        else -1
        fi
    in
    if first < 0 then letter
    else char(first + (int(letter) - first + key) % 26)
    fi

encode(text: string, key: int) -> string => rotate(text, key)
decode(text: string, key: int) -> string =>
    rotate(text, 26 - key)

let message = "The Quick Brown Fox Jumps Over The Lazy Dog!"
let encoded = encode(message, 3)

write_line("plain:   {message}")
write_line("encoded: {encoded}")
write_line("decoded: {decode(encoded, 3)}")
