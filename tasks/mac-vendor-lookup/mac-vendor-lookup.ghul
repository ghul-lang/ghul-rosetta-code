use default
use System.Net.Http.HttpClient

// The task: ask an online registry who made the device a MAC address
// belongs to. An address it does not know is "N/A"; a failure to reach it
// at all is null.
vendor(api: string, mac: string) -> string? is
    try
        let response =
            HttpClient().get_async("{api}{mac}").result

        if
            response.status_code ==
            System.Net.HttpStatusCode.NOT_FOUND
        then
            return "N/A"
        elif !response.is_success_status_code then
            return null
        fi

        return response.content.read_as_string_async().result
    catch e: System.AggregateException
        return null
    yrt
si

let macs = [
    "FC-FB-FB-01-FA-21", "88:53:2E:67:07:BE",
    "D4:F4:6F:C9:EF:8D", "23:45:67"
]

for mac in macs do
    // The registry refuses more than about one request a second.
    System.Threading.Thread.sleep(1500)

    let found = vendor(
        "https://api.macvendors.com/",
        mac.replace(':', '-')
    )

    write_line("{mac,-18} {found ?? "null"}")
od
