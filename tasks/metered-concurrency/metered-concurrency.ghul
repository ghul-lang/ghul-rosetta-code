// The event loop runs the workers on one thread, so a turn parked stands
// in for the two seconds the task asks for.

use default
use Concurrency

let permits = 3
let workers = 5
// The task has each worker hold its permit for two seconds. Every worker
// here runs on one thread, so the hold is measured in turns of the event
// loop instead.
let holding_turns = 2

let semaphore = Semaphore(permits)

holding() -> int => permits - semaphore.available

worker(id: int) -> Future is
    await semaphore.acquire()

    write_line("worker {id} acquired, {holding()} holding")

    for _ in 1::holding_turns do
        await pause()
    od

    semaphore.release()

    write_line("worker {id} released, {holding()} holding")
si

run(() => Future.when_all(1::workers |> map(worker)))
