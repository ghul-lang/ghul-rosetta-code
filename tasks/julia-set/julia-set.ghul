use Raster.IMAGE
use Ghul.Math

let width = 600
let height = 450
let limit = 300

let cx = -0.7
let cy = 0.27015

escape(start_x, start_y) => (
    let x mut = start_x
    let y mut = start_y
    let steps mut = 0

    while steps < limit /\ x * x + y * y <= 4.0 do
        let next = x * x - y * y + cx

        y = 2.0 * x * y + cy
        x = next
        steps = steps + 1
    od

    steps
)

band(level, phase) => ubyte(127.5 * (1.0 - cos(6.0 * pi * level + phase)))

let image = IMAGE(width, height)

for row in 0..height do
    for column in 0..width do
        let x = -1.8 + 3.6 * double(column) / double(width)
        let y = -1.35 + 2.7 * double(row) / double(height)

        let steps = escape(x, y)

        if steps < limit then
            let level = log(double(steps) + 1.0) / log(double(limit) + 1.0)

            image.set_pixel(
                column,
                row,
                band(level, 0.0),
                band(level, 2.1),
                band(level, 4.2)
            )
        else
            image.set_pixel(column, row, 0ub, 0ub, 0ub)
        fi
    od
od

image.write("julia.png")

image.show("julia.png")
