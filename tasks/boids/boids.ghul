use default
use Raster.ANIMATION
use Raster.IMAGE

struct VEC(x: double, y: double) is
    +(other: VEC) -> VEC => VEC(x + other.x, y + other.y)
    -(other: VEC) -> VEC => VEC(x - other.x, y - other.y)
    *(k: double) -> VEC => VEC(x * k, y * k)

    length: double => sqrt(x * x + y * y)

    limited(low: double, high: double) -> VEC =>
        if length > high then
            self * (high / length)
        elif length < low /\ length > 0.0 then
            self * (low / length)
        else
            self
        fi
si

class BOID(position: VEC public, velocity: VEC public)

let cave = IO.File.read_all_lines("cave.txt")

let columns = cave[0].length
let rows = cave.count
let width = double(columns)
let height = 2.0 * double(rows)

let frames = 240
let sight = 6.0
let personal_space = 1.5

row_of(y) => rows - 1 - int(floor(y / 2.0))

column_of(x) => (int(floor(x)) % columns + columns) % columns

is_wall(point) =>
    point.y < 0.0 \/
    point.y >= height \/
    cave[row_of(point.y)][column_of(point.x)] == '#'

wall_push(point) is
    let push mut = VEC(0.0, 0.0)

    for dx in -3::3 do
        for dy in -6::6 do
            let probe = point + VEC(double(dx), double(dy))

            if is_wall(probe) then
                let away = point - probe
                let distance = max(away.length, 0.5)

                push = push + away * pow(distance, -3.0)
            fi
        od
    od

    push
si

steer(boid, flock) is
    let near =
        flock
            |> filter(other =>
                !(other == boid) /\
                (other.position - boid.position).length < sight
            )
            |> list()

    let force mut = VEC(0.04, 0.0) + wall_push(boid.position) * 1.5

    if near.count > 0 then
        let n = double(near.count)

        let center =
            near |> map(o => o.position) |> reduce(VEC(0.0, 0.0), * + *)

        let heading =
            near |> map(o => o.velocity) |> reduce(VEC(0.0, 0.0), * + *)

        let crowding =
            near
                |> filter(o =>
                    (o.position - boid.position).length < personal_space
                )
                |> map(o => boid.position - o.position)
                |> reduce(VEC(0.0, 0.0), * + *)

        force =
            force +
            (center * (1.0 / n) - boid.position) * 0.01 +
            (heading * (1.0 / n) - boid.velocity) * 0.05 +
            crowding * 0.1
    fi

    force
si

move(boid, flock) is
    boid.velocity = (boid.velocity + steer(boid, flock)).limited(0.4, 0.8)

    let next = boid.position + boid.velocity

    if is_wall(next) then
        boid.velocity = boid.velocity * -0.5
        return false
    fi

    let wrapped = next.x >= width

    boid.position = if wrapped then VEC(next.x - width, next.y) else next fi

    wrapped
si

draw(image, flock) is
    image.clear(235ub, 240ub, 245ub)
    image.color(90ub, 80ub, 70ub)

    for (row, line) in cave |> index() do
        for (column, c) in line |> index() do
            if c == '#' then
                let x = double(column)
                let y = height - 2.0 * double(row + 1)

                image.fill_rectangle(x - 0.05, y - 0.05, x + 1.05, y + 2.05)
            fi
        od
    od

    image.color(200ub, 40ub, 40ub)

    for boid in flock do
        image.dot(boid.position.x, boid.position.y, 2.0)
    od
si

cave |> each(line => write_line(line))
write_line("")

let random = System.Random(1)

let flock = [
    BOID(
        VEC(double(c.index) + 0.5, height - 2.0 * double(r.index) - 1.0),
        VEC(0.3, random.next_double() * 0.4 - 0.2)
    )
    for r in cave |> index()
    for c in r.value |> index()
    if c.value == 'O'
]

let image = IMAGE(240, 90)

image.view(0.0, 0.0, width, height)

let animation = ANIMATION(240, 90)
let crossings mut = 0
let bumps mut = 0

for _ in 0..frames do
    draw(image, flock)
    animation.add(image, 40)

    for boid in flock do
        if move(boid, flock) then
            crossings = crossings + 1
        fi
    od

    bumps =
        bumps + (flock |> filter(boid => is_wall(boid.position)) |> count())
od

write_line("{flock.count} boids, {frames} frames")
write_line("{crossings} crossings of the cave")
write_line("{bumps} boids found inside a wall")

animation.write("boids.png")

animation.show("boids.png")
