use default
use Raster.IMAGE

use Circle = (x: double, y: double, radius: double)

tangent_to(first, second, third, outside_first, outside_second, outside_third) => (
    let v11 = 2.0 * second.x - 2.0 * first.x
    let v12 = 2.0 * second.y - 2.0 * first.y
    let v13 =
        first.x * first.x -
        second.x * second.x +
        first.y * first.y -
        second.y * second.y -
        first.radius * first.radius +
        second.radius * second.radius
    let v14 =
        2.0 * outside_second * second.radius -
        2.0 * outside_first * first.radius

    let v21 = 2.0 * third.x - 2.0 * second.x
    let v22 = 2.0 * third.y - 2.0 * second.y
    let v23 =
        second.x * second.x -
        third.x * third.x +
        second.y * second.y -
        third.y * third.y -
        second.radius * second.radius +
        third.radius * third.radius
    let v24 =
        2.0 * outside_third * third.radius -
        2.0 * outside_second * second.radius

    let w12 = v12 / v11
    let w13 = v13 / v11
    let w14 = v14 / v11

    let w22 = v22 / v21 - w12
    let w23 = v23 / v21 - w13
    let w24 = v24 / v21 - w14

    let p = -w23 / w22
    let q = w24 / w22
    let m = -w12 * p - w13
    let n = w14 - w12 * q

    let a = n * n + q * q - 1.0
    let b =
        2.0 * m * n -
        2.0 * n * first.x +
        2.0 * p * q -
        2.0 * q * first.y +
        2.0 * outside_first * first.radius
    let c =
        first.x * first.x +
        m * m -
        2.0 * m * first.x +
        p * p +
        first.y * first.y -
        2.0 * p * first.y -
        first.radius * first.radius

    let radius = (-b - sqrt(b * b - 4.0 * a * c)) / (2.0 * a)

    (x = m + n * radius, y = p + q * radius, radius = radius)
)

let given = [
    (x = 0.0, y = 0.0, radius = 1.0),
    (x = 4.0, y = 0.0, radius = 1.0),
    (x = 2.0, y = 4.0, radius = 2.0)
]

let inside = tangent_to(given[0], given[1], given[2], 1.0, 1.0, 1.0)

let outside = tangent_to(given[0], given[1], given[2], -1.0, -1.0, -1.0)

spelled(circle) =>
    "x = {circle.x:F6}, y = {circle.y:F6}, "
    "r = {circle.radius:F6}"

for circle in given do
    write_line("given       {spelled(circle)}")
od

write_line("internally  {spelled(inside)}")
write_line("externally  {spelled(outside)}")

let image = IMAGE(600, 600)

image.view(-2.3, -2.3, 6.3, 6.3)

image.stroke(2.0)

image.color(40ub, 40ub, 48ub)

for circle in given do
    image.circle(circle.x, circle.y, circle.radius)
od

image.color(200ub, 50ub, 50ub)
image.circle(inside.x, inside.y, inside.radius)

image.color(40ub, 150ub, 70ub)
image.circle(outside.x, outside.y, outside.radius)

image.write("apollonius.png")

image.show("apollonius.png")
