use default

splits_repeated_doubling(value) =>
    let wide = long(value) in
    mod_pow(2L, wide, wide) == 2L % wide

is_super_poulet(value) =>
    splits_repeated_doubling(value) /\
    !is_prime(value) /\
    (value |> divisors() |> all(splits_repeated_doubling))

let super_poulets = from(3, 2) |> filter(is_super_poulet)

write_line("the first 20 super-Poulet numbers:")
write_line("  {super_poulets |> take(20) |> join(" ")}")
write_line()

let (position, value) =
    super_poulets |> index() |> find(e => e.value > 1_000_000)!

write_line(
    "super-Poulet number {position + 1} is the first over "
    "1,000,000: {value:N0}"
)
