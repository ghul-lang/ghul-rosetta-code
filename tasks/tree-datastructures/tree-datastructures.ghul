use default

use LINE = (depth: int, name: string)

class NODE(name: string, children: List[NODE])

leaf(name: string) -> NODE => NODE(name, LIST())

render_nest(node: NODE, depth: int) -> string{} is
    yield "{repeat("    ", depth) |> join("")}{node.name}"

    for child in node.children do
        yield in render_nest(child, depth + 1)
    od
si

render_indent(lines: List[LINE]) -> string{} =>
    lines |> map(line => "{line.depth} {line.name}")

to_indent(node: NODE, depth: int) -> LINE{} is
    yield (depth = depth, name = node.name)

    for child in node.children do
        yield in to_indent(child, depth + 1)
    od
si

to_nest(lines: List[LINE], position: int) -> (
    node: NODE,
    next: int
) => (
    let head = lines[position]
    let children = LIST()
    let cursor mut = position + 1

    while
        cursor < lines.count /\ lines[cursor].depth > head.depth
    do
        let (child, following) = to_nest(lines, cursor)

        children.add(child)

        cursor = following
    od

    (node = NODE(head.name, children), next = cursor)
)

let start = NODE("RosettaCode", [
    NODE("rocks", [leaf("code"), leaf("comparison"), leaf("wiki")]),
    NODE("mocks", [leaf("trolling")])
])

write_line("nest form:")

start |> render_nest(0) |> each(line => write_line(line))

let indented = start |> to_indent(0) |> collect()

write_line()
write_line("indent form:")

indented |> render_indent() |> each(line => write_line(line))

let (rebuilt, _) = to_nest(indented, 0)

write_line()
write_line("nest form, rebuilt from the indent form:")

rebuilt |> render_nest(0) |> each(line => write_line(line))

let before = start |> render_nest(0) |> join("\n")
let after = rebuilt |> render_nest(0) |> join("\n")

write_line()
write_line("round trip preserved the tree: {before =~ after}")
