use default

sort_disjoint_sublist(values, indices) is
    let positions = indices |> sort() |> list()
    let picked = positions |> map(i => values[i]) |> sort() |> list()

    for i in 0..positions.count do
        values[positions[i]] = picked[i]
    od
si

let values = LIST([7, 6, 5, 4, 3, 2, 1, 0])
let indices = SET([6, 1, 7])

sort_disjoint_sublist(values, indices)

write_line(values |> join())
