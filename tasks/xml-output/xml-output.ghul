use default
use System.Xml.Linq
use Remark = (name: string, remark: string)

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

character(name: string, remark: string) -> XElement =>
    XElement(XName.get("Character"), [
        XAttribute(XName.get("name"), name),
        remark
    ])

remarks_document(remarks: Remark[]) -> XDocument =>
    XDocument([
        XElement(
            XName.get("CharacterRemarks"),
            remarks |> map((name, remark) => character(name, remark))
        )
    ])

let remarks = [
    (name = "April", remark = "Bubbly: I'm > Tam and <= Emily"),
    (
        name = "Tam O'Shanter",
        remark = "Burns: \"When chapman billies leave the street ...\""
    ),
    (name = "Emily", remark = "Short & shrift")
]

write_line("{remarks_document(remarks)}")
