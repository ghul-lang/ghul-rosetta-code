use default
use System.Xml.Linq
use Remark = (name: string, remark: string)

character(name: string, remark: string) -> XElement =>
    XElement(XName.get("Character"), [
        XAttribute(XName.get("name"), name),
        remark
    ])

remarks_document(remarks: Remark[]) -> XDocument =>
    XDocument([
        XElement(
            XName.get("CharacterRemarks"),
            remarks |> map((name, remark) => character(name, remark))
        )
    ])

let remarks = [
    ("April", "Bubbly: I'm > Tam and <= Emily"),
    (
        "Tam O'Shanter",
        "Burns: \"When chapman billies leave the street ...\""
    ),
    ("Emily", "Short & shrift")
]

write_line("{remarks_document(remarks)}")
