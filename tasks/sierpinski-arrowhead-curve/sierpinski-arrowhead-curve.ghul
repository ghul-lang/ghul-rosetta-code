use Raster

let order = 6
let step = 8.0

let image = IMAGE(560, 480)
let pen = TURTLE(image)

arrowhead(depth: int, angle: double) is
    if depth == 0 then
        pen.forward(step)
        return
    fi

    arrowhead(depth - 1, -angle)
    pen.turn(-angle)
    arrowhead(depth - 1, angle)
    pen.turn(-angle)
    arrowhead(depth - 1, -angle)
si

image.view(0.0, 0.0, 560.0, 480.0)
image.color(0ub, 0ub, 160ub)
image.stroke(1.2)

pen.move_to(24.0, 22.0)

arrowhead(order, 60.0)

image.write("arrowhead.png")

image.show("arrowhead.png")
