use default
use System.Text.Json.JsonSerializer

class ENTRY(
    name: string public,
    legs: int public,
    tags: LIST[string] public
) is
    to_string() -> string =>
        "{name}, {legs} legs, tagged {tags |> join(" and ")}"
si

let zoo = LIST()

zoo.add(ENTRY("spider", 8, LIST(["small", "hairy"])))
zoo.add(ENTRY("ostrich", 2, LIST(["large", "fast"])))

let text = JsonSerializer.serialize[LIST[ENTRY]](zoo, null)

write_line(text)

let path = IO.Path.combine(IO.Path.get_temp_path(), "zoo.json")

try
    IO.File.write_all_text(path, text)

    let json = IO.File.read_all_text(path)
    let read_back = JsonSerializer.deserialize[LIST[ENTRY]](json, null)!

    read_back |> each(entry => write_line("{entry}"))

    write_line("same count: {read_back.count == zoo.count}")
    write_line("a different object: {read_back == zoo}")
finally
    IO.File.delete(path)
yrt
