use default

proper_divisors(n: int) -> List[int] is
    let small = LIST()
    let large = LIST()

    for d in 1::n do
        if d * d > n then
            break
        fi

        if n % d == 0 then
            small.add(d)

            if d * d != n then
                large.add(n / d)
            fi
        fi
    od

    cat(small, large |> reverse()) |> filter(d => d != n)
        |> collect()
si

for n in 1::10 do
    write_line("{n,2}: [{proper_divisors(n) |> join(", ")}]")
od

let counts = 1::20_000 |> map(n => (n, proper_divisors(n).count))
let (best, most) =
    counts |> reduce((0, -1), (a, b) => if b.`1 > a.`1 then b else a fi)

write_line("")
write_line("From 1 to 20,000, {best} has the most proper divisors: {most}")
