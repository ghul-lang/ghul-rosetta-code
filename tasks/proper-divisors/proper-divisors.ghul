use default

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`
// `==` compares identity

proper_divisors(n: int) -> int[] is
    let small = LIST()
    let large = LIST()

    for d in 1::n do
        if d * d > n then
            break
        fi

        if n % d == 0 then
            small.add(d)

            if d * d != n then
                large.add(n / d)
            fi
        fi
    od

    small ++ (large |> reverse()) |> filter(* != n) |> list()
si

for n in 1::10 do
    write_line("{n,2}: [{n |> proper_divisors() |> join(", ")}]")
od

let counts = 1::20_000 |> map(n => (n, proper_divisors(n).count))
let (best, most) =
    counts |> reduce((0, -1), (a, b) => if b.`1 > a.`1 then b else a fi)

write_line("")
write_line("From 1 to 20,000, {best} has the most proper divisors: {most}")
