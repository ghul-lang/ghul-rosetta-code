use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

let factorial = n rec => if n <= 1 then 1 else n * rec(n - 1) fi

digit_factorial_sum(n: int, base_value: int) -> int =>
    n |> digits(base_value) |> sum_by(factorial)

factorions(base_value: int) -> int[] =>
    1..1_500_000
        |> filter(n => digit_factorial_sum(n, base_value) == n)
        |> list()

for base_value in [9, 10, 11, 12] do
    let found = factorions(base_value)
    write_line(
        "base {base_value}: {found |> join(" ")} "
        "({found.count} factorions)"
    )
od
