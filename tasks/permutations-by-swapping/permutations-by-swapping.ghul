use default

use STEP = (order: int[], sign: int)

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `LIST()` builds its collection eagerly
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

swap(values: LIST[int], left: int, right: int) is
    (values[left], values[right]) = (values[right], values[left])
si

permutations(size: int) -> STEP{} is
    let values = 1::size |> LIST()
    let facing = repeat(-1, size) |> LIST()
    let sign mut = 1

    do
        yield (order = values, sign = sign)

        let mobile mut = 0
        let position mut = -1

        for index in 0..size do
            let target = index + facing[index]

            if
                target >= 0 /\
                target < size /\
                values[index] > values[target] /\
                values[index] > mobile
            then
                mobile = values[index]
                position = index
            fi
        od

        if position < 0 then break fi

        swap(values, position, position + facing[position])
        swap(facing, position, position + facing[position])

        for index in 0..size do
            if values[index] > mobile then
                facing[index] = -facing[index]
            fi
        od

        sign = -sign
    od
si

[3, 4]
    |> each(size => (
        write_line("permutations of {size} items, by adjacent swaps:")

        permutations(size)
            |> each(step =>
                write_line(
                    "  {step.order |> join(" ")}  sign {step.sign,2}"
                )
            )

        write_line()
    ))
