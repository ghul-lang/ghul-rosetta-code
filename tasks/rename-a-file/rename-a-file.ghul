use default

rename_file(from, to) is
    if !IO.File.exists(from) then
        return "not there"
    fi

    try
        IO.File.move(from, to)
        return "renamed"
    catch e: System.Exception
        return "refused"
    yrt
si

rename_directory(from, to) is
    if !IO.Directory.exists(from) then
        return "not there"
    fi

    try
        IO.Directory.move(from, to)
        return "renamed"
    catch e: System.Exception
        return "refused"
    yrt
si

for where in ["", "/"] do
    write_line(
        "{where}input.txt -> {where}output.txt: "
        "{rename_file("{where}input.txt", "{where}output.txt")}"
    )
    write_line(
        "{where}docs -> {where}mydocs: "
        "{rename_directory("{where}docs", "{where}mydocs")}"
    )
od
