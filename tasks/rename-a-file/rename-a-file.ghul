use default
use IO.Directory
use IO.File

rename(
    from: string,
    to: string,
    exists: string -> bool,
    move: (string, string) -> void
) -> string is
    if !exists(from) then
        return "not there"
    fi

    try
        move(from, to)
        return "renamed"
    catch e: System.Exception
        return "refused"
    yrt
si

for where in ["", "/"] do
    let (file, new_file) = ("{where}input.txt", "{where}output.txt")
    let (folder, new_folder) = ("{where}docs", "{where}mydocs")

    write_line(
        "{file} -> {new_file}: "
        "{rename(file, new_file, File.exists, File.move)}"
    )
    write_line(
        "{folder} -> {new_folder}: "
        "{rename(folder, new_folder, Directory.exists, Directory.move)}"
    )
od
