use default

let scratch = IO.Path.combine(
    IO.Path.get_temp_path(),
    "rosetta-rename-a-file"
)

IO.Directory.create_directory(scratch)
IO.Directory.set_current_directory(scratch)

IO.File.write_all_text("input.txt", "")
IO.Directory.create_directory("docs")

rename_file(from: string, to: string) -> string is
    if !IO.File.exists(from) then
        return "not there"
    fi

    try
        IO.File.move(from, to)
        return "renamed"
    catch e: System.Exception
        return "refused"
    yrt
si

rename_directory(from: string, to: string) -> string is
    if !IO.Directory.exists(from) then
        return "not there"
    fi

    try
        IO.Directory.move(from, to)
        return "renamed"
    catch e: System.Exception
        return "refused"
    yrt
si

for where in ["", "/"] do
    write_line(
        "{where}input.txt -> {where}output.txt: "
        "{rename_file("{where}input.txt", "{where}output.txt")}"
    )
    write_line(
        "{where}docs -> {where}mydocs: "
        "{rename_directory("{where}docs", "{where}mydocs")}"
    )
od

IO.Directory.set_current_directory(IO.Path.get_temp_path())
IO.Directory.delete(scratch, true)
