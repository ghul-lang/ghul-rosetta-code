use default

use Crypto.sha1

sha1(text) =>
    System.Convert.to_hex_string_lower(
        sha1(System.Text.Encoding.utf8.get_bytes(text))
    )

let messages = [
    "",
    "abc",
    "Rosetta Code",
    "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
]

for text in messages do
    write_line("{sha1(text)}  \"{text}\"")
od
