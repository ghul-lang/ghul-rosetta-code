use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|> LIST()` reads the whole sequence into a new `LIST`
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`
// `==` compares identity

letter_counts(text: string) -> LIST[int] => (
    let counts = repeat(0, 26) |> LIST()

    for letter in text do
        if char.is_letter(letter) then
            let index = int(char.to_lower(letter)) - int('a')

            counts[index] = counts[index] + 1
        fi
    od

    counts
)

fits(word: int[], available: int[]) -> bool =>
    0..26 |> all(i => word[i] <= available[i])

adjust(counts: LIST[int], by: int[], sign: int) is
    for letter in 0..26 do
        counts[letter] = counts[letter] + sign * by[letter]
    od
si

let words = IO.File.read_all_lines("unixdict.txt")

anagrams_of(seed: string, wanted: int) -> string{} is
    let remaining = letter_counts(seed)

    let candidates =
        words
            |> filter(word => word.length > 2)
            |> map(word => (text = word, counts = letter_counts(word)))
            |> filter(candidate => fits(candidate.counts, remaining))
            |> sort((a, b) => b.text.length <> a.text.length)
            |> list()

    let found = LIST()
    let chosen = LIST()

    search(start) is
        if found.count >= wanted then
            return
        elif remaining |> all(* == 0) then
            found.add(chosen |> join(" "))
            return
        fi

        for i in start..candidates.count do
            let candidate = candidates[i]

            if fits(candidate.counts, remaining) then
                adjust(remaining, candidate.counts, -1)

                chosen.add(candidate.text)

                search(i)

                chosen.remove_at(chosen.count - 1)

                adjust(remaining, candidate.counts, 1)
            fi
        od
    si

    search(0)

    return found
si

for seed in ["Petelomax", "rosetta code", "William Shakespeare"] do
    write_line("{seed}:")

    seed |> anagrams_of(3) |> each(phrase => write_line("  {phrase}"))
od
