use default

let coin = System.Random(20260909)

let runs = 1000000

let heads = 0..runs |> count(_ => coin.next(2) == 0)
let wakings = heads + 2 * (runs - heads)

write_line("{runs} runs of the experiment")
write_line("{wakings} wakings")
write_line("{heads} of them after heads")
write_line("credence: {double(heads) / double(wakings):F4}")
