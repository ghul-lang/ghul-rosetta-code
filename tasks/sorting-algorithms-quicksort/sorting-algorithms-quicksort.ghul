use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `case ... when` pattern-matches, and `[x, ..rest]` matches a list head
//  and tail

quicksort[T: Ghul.Comparable[T]](values: T[]) -> T{} =>
    case values
    when [] then values
    when [pivot, ..rest] then
        quicksort([v for v in rest if v < pivot]) ++
        [pivot] ++
        quicksort([v for v in rest if v >= pivot])
    esac

write_line("{quicksort([6, 2, 9, 2, 5, 1, 8, 3])}")
write_line("{quicksort(["pear", "apple", "fig", "date"])}")
