use default

// `T[]` is the read-only list trait - elements can be read by index
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`

first_missing_positive(nums: int[]) -> int =>
    let present = SET(nums |> filter(* > 0)) in
    from(1) |> find(n => !present.contains(n))!

for nums in [[1, 2, 0], [3, 4, -1, 1], [7, 8, 9, 11, 12]] do
    write_line("{$(nums)} -> {first_missing_positive(nums)}")
od
