use default

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `*` as an argument leaves that parameter open: partial application.

first_missing_positive(nums: int[]) -> int =>
    let present = SET(nums |> filter(* > 0)) in
    from(1) |> find(n => !present.contains(n))!

for nums in [[1, 2, 0], [3, 4, -1, 1], [7, 8, 9, 11, 12]] do
    write_line("{$(nums)} -> {first_missing_positive(nums)}")
od
