use default

encode(data: List[ubyte], marker: ubyte) -> List[ubyte] is
    let frame = LIST()
    let block = LIST()

    flush() is
        frame.add(ubyte(block.count + 1))

        block |> each(b => frame.add(b))

        block.clear()
    si

    for at in 0..data.count do
        let byte = data[at]

        if byte =~ marker then
            flush()
        elif block.count == 253 /\ at + 1 < data.count then
            block.add(byte)

            flush()
        else
            block.add(byte)
        fi
    od

    flush()

    frame
si

decode(frame: List[ubyte], marker: ubyte) -> List[ubyte] is
    let data = LIST()
    let at mut = 0

    while at < frame.count do
        let milestone = int(frame[at])

        assert milestone > 0 else "a milestone of zero cannot advance"
        assert at + milestone <= frame.count
            else "the final milestone runs past the end of the frame"

        for step in 1..milestone do
            data.add(frame[at + step])
        od

        at = at + milestone

        if milestone < 255 /\ at < frame.count then
            data.add(marker)
        fi
    od

    data
si

hex(bytes: List[ubyte]) -> string =>
    if bytes.count > 8 then
        "{bytes[0..4] |> map(b => "{b:X2}") |> join(" ")} ... "
        "{bytes[bytes.count - 2..<0] |> map(b => "{b:X2}") |> join(" ")} "
        "({bytes.count} bytes)"
    else
        bytes |> map(b => "{b:X2}") |> join(" ")
    fi

let examples: List[ubyte][] = [
    [0ub],
    [0ub, 0ub],
    [0x11ub, 0x22ub, 0ub, 0x33ub],
    [0x11ub, 0x22ub, 0x33ub, 0x44ub],
    [0x11ub, 0ub, 0ub, 0ub],
    1::254 |> map(n => ubyte(n)) |> collect(),
    0::254 |> map(n => ubyte(n)) |> collect(),
    1::255 |> map(n => ubyte(n)) |> collect()
]

write_line("unencoded                              encoded")

for example in examples do
    let frame = encode(example, 0ub)

    write_line("{hex(example),-38} {hex(frame)}")
od

write_line()

let round_trips =
    examples |> all(example => decode(encode(example, 0ub), 0ub) =~ example)

write_line("every example decodes back to itself: {round_trips}")

try
    let _ = decode([0x03ub, 0x11ub], 0ub)

    write_line("a frame whose milestone runs past the end: accepted")
catch failed: Ghul.AssertFailedException
    write_line("a frame whose milestone runs past the end: rejected")
yrt

write_line()

let marked = [0x2Fub, 0x11ub, 0x2Fub, 0x22ub]
let framed = encode(marked, 0x2Fub)

write_line("with 2F as the marker")
write_line("{hex(marked),-38} {hex(framed)}")
write_line("decodes back to itself: {decode(framed, 0x2Fub) =~ marked}")
