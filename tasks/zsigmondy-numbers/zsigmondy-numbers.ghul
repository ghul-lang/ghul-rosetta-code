use default

difference(exponent: int, a: int, b: int) -> bigint =>
    bigint.pow(bigint(a), exponent) -
    bigint.pow(bigint(b), exponent)

zsigmondy(exponent: int, a: int, b: int) -> bigint is
    let greatest mut = difference(exponent, a, b)

    for lesser in 1..exponent do
        let smaller = difference(lesser, a, b)
        let common mut = bigint.greatest_common_divisor(
            greatest,
            smaller
        )

        while common > 1n do
            greatest = greatest / common
            common = bigint.greatest_common_divisor(
                greatest,
                smaller
            )
        od
    od

    greatest
si

let radices = [
    (2, 1), (3, 1), (4, 1), (5, 1), (6, 1),
    (7, 1), (3, 2), (5, 3), (7, 3), (7, 5)
]

write_line(
    "Zsigmondy numbers, the first twenty of each sequence:"
)

for (a, b) in radices do
    let terms =
        1::20 |> map(n => "{zsigmondy(n, a, b)}") |> join(" ")

    write_line("")
    write_line("a = {a}, b = {b}")
    write_line("  {terms}")
od
