use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `if let` pattern-matches

harmonic_numbers() -> (n: int, value: double){} is
    let sum mut = 0.0
    let n mut = 1

    do
        sum = sum + 1.0 / double(n)
        yield (n = n, value = sum)
        n = n + 1
    od
si

write_line("first 20 harmonic numbers:")

for (n, value) in harmonic_numbers() |> take(20) do
    write_line("H({n}) = {value,0:F6}")
od

write_line("")
write_line("first position where H(n) exceeds a given integer:")

for threshold in 1::10 do
    let past_threshold =
        harmonic_numbers()
            |> filter(h => h.value > double(threshold))
            |> first()

    if let (n, _) = past_threshold then
        write_line("H(n) > {threshold} first at n = {n}")
    fi
od
