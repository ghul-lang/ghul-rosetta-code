use default

use Edge = (from: int, to: int)

let size = 13

let edges = [
    (from = 4, to = 2), (from = 2, to = 3), (from = 3, to = 2),
    (from = 6, to = 0), (from = 0, to = 1), (from = 2, to = 0),
    (from = 11, to = 12), (from = 12, to = 9), (from = 9, to = 10),
    (from = 9, to = 11), (from = 8, to = 9), (from = 10, to = 12),
    (from = 0, to = 5), (from = 5, to = 4), (from = 3, to = 5),
    (from = 6, to = 4), (from = 6, to = 9), (from = 7, to = 6),
    (from = 7, to = 8), (from = 8, to = 7), (from = 5, to = 3),
    (from = 0, to = 6)
]

let adjacent = LIST[LIST[int]]()

for _ in 0..size do
    adjacent.add(LIST[int]())
od

for (from, to) in edges do
    adjacent[from].add(to)
od

for neighbours in adjacent do
    neighbours.sort()
od

write_line("Constructed digraph:")
write_line(
    "Digraph has {size} vertices and {edges.count} edges"
)
write_line("Adjacency lists:")

for vertex in 0..size do
    write_line("{vertex,2}: {adjacent[vertex] |> join(" ")}")
od

let preorder = LIST[int?]()
let component = LIST[int?]()

for _ in 0..size do
    preorder.add(null)
    component.add(null)
od

let path = Collections.STACK[int]()
let candidates = Collections.STACK[int]()
let visited mut = 0
let components mut = 0

search(vertex: int) is
    preorder[vertex] = visited
    visited = visited + 1

    path.push(vertex)
    candidates.push(vertex)

    for next in adjacent[vertex] do
        if !preorder[next]? then
            search(next)
        elif !component[next]? then
            while
                preorder[candidates.peek()]! > preorder[next]!
            do
                let _ = candidates.pop()
            od
        fi
    od

    if candidates.peek() == vertex then
        let _ = candidates.pop()

        let closed mut = -1

        while closed != vertex do
            closed = path.pop()

            component[closed] = components
        od

        components = components + 1
    fi
si

for vertex in 0..size do
    if !preorder[vertex]? then
        search(vertex)
    fi
od

write_line("")
write_line("It has {components} strongly connected components.")
write_line("")
write_line("Components:")

for which in 0..components do
    let members =
        0..size
            |> filter(vertex => component[vertex]! == which)
            |> map(vertex => "{vertex}")
            |> join(" ")

    write_line("Component {which}: {members}")
od

connected(a: int, b: int) -> bool =>
    component[a]! == component[b]!

write_line("")
write_line("Example connectivity checks:")
write_line(
    "Vertices 0 and 3 strongly connected? {connected(0, 3)}"
)
write_line(
    "Vertices 0 and 7 strongly connected? {connected(0, 7)}"
)
write_line(
    "Vertices 9 and 12 strongly connected? {connected(9, 12)}"
)
write_line("Component ID of vertex 5: {component[5]!}")
write_line("Component ID of vertex 8: {component[8]!}")
