use default
use Raster.IMAGE

struct P(x: double, y: double) is
    +(o: P) -> P => P(x + o.x, y + o.y)
    -(o: P) -> P => P(x - o.x, y - o.y)
    *(k: double) -> P => P(x * k, y * k)
    length: double => sqrt(x * x + y * y)
    normal: P => P(-y, x)

    show: string => "({x:F4}, {y:F4})"
si

union Circles is
    TWO(first: P, second: P)
    ONE(center: P)
    ANY
    POINT
    NONE(reason: string)
si

circles(a: P, b: P, r: double) -> Circles is
    let d = (b - a).length

    if d == 0.0 then
        return if r == 0.0 then Circles.POINT else Circles.ANY fi
    fi

    if r == 0.0 then
        return Circles.NONE("a radius of zero describes no circle")
    fi

    if d > 2.0 * r then
        return Circles.NONE("the points are too far apart")
    fi

    let middle = (a + b) * 0.5

    if d == 2.0 * r then
        return Circles.ONE(middle)
    fi

    let offset = sqrt(r * r - d * d / 4.0)
    let across = (b - a).normal * (offset / d)

    Circles.TWO(middle + across, middle - across)
si

let inputs = [
    (P(0.1234, 0.9876), P(0.8765, 0.2345), 2.0),
    (P(0.0000, 2.0000), P(0.0000, 0.0000), 1.0),
    (P(0.1234, 0.9876), P(0.1234, 0.9876), 2.0),
    (P(0.1234, 0.9876), P(0.8765, 0.2345), 0.5),
    (P(0.1234, 0.9876), P(0.1234, 0.9876), 0.0)
]

for (a, b, r) in inputs do
    let result =
        case circles(a, b, r)
        when (first, second): Circles.TWO then
            "centers {first.show} and {second.show}"
        when (center): Circles.ONE then
            "a diameter: one circle, center {center.show}"
        when _: Circles.ANY then
            "the points coincide: any circle through them"
        when _: Circles.POINT then
            "a single point"
        when (reason): Circles.NONE then
            "none: {reason}"
        esac

    write_line("{a.show} {b.show} r = {r}: {result}")
od

let (a, b, r) = inputs[0]

if let (first, second): Circles.TWO = circles(a, b, r) then
    let image = IMAGE(360, 360)

    image.view(-3.2, -3.0, 4.0, 4.2)
    image.clear(252ub, 250ub, 245ub)
    image.stroke(2.0)

    image.color(60ub, 110ub, 200ub)
    image.circle(first.x, first.y, r)

    image.color(200ub, 90ub, 40ub)
    image.circle(second.x, second.y, r)

    image.color(30ub, 30ub, 30ub)
    image.dot(a.x, a.y, 4.0)
    image.dot(b.x, b.y, 4.0)
    image.ring(first.x, first.y, 3.0)
    image.ring(second.x, second.y, 3.0)

    image.write("circles.png")

    image.show("circles.png")
fi
