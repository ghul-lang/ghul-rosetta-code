use default

let digits = "0123456789abcdefghijklmnopqrstuvwxyz"

to_base(n: long, base: int) -> string =>
    let b = long(base) in
    let last = digits[int(n % b)] in
    if n < b then "{last}" else "{to_base(n / b, base)}{last}" fi

from_base(text: string, base: int) -> long =>
    text
        |> reduce(0L, (value: long, c: char) =>
            value * long(base) + long(digits.index_of(c)))

let cases = [
    (26L, 16), (0L, 2), (255L, 2), (1_000_000L, 36),
    (9_007_199_254_740_991L, 7)
]

for (n, base) in cases do
    let text = to_base(n, base)
    let back = from_base(text, base)

    write_line("{n} in base {base} is {text}, which reads back as {back}")
od
