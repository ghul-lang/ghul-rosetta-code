use default

let table = [
    "0317598642",
    "7092154863",
    "4206871359",
    "1750983426",
    "6123045978",
    "3674209581",
    "5869720134",
    "8945362017",
    "9438617205",
    "2581436790"
]

digit_value(digit: char) -> int => int(digit) - cast('0')

valid(number: string) -> bool =>
    number |> reduce(0, (interim, digit) =>
        digit_value(table[interim][digit_value(digit)])) == 0

for sample in ["5724", "5727", "5857"] do
    let verdict = if valid(sample) then "valid" else "invalid" fi
    write_line("{sample} checksum {verdict}")
od
