use default

class CALCULATOR is
    init() is si

    double(n: int) -> int => n * 2

    square(n: int) -> int => n * n

    negate(n: int) -> int => -n
si

let calculator = CALCULATOR()

send(name: string, argument: int) -> string is
    let method = calculator.get_type().get_method(name)

    if !method? then
        return "{name} is not a method of CALCULATOR"
    fi

    let result = method.invoke(calculator, [
        cast object(argument)
    ])

    "{name}({argument}) = {result}"
si

for chosen in ["double", "square", "negate", "cube"] do
    write_line(send(chosen, 7))
od

let generated = "{"squ"}{"are"}"

write_line(send(generated, 9))
