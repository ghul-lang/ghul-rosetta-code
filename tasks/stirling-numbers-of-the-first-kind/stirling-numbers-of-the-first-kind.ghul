use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read, and `count` reads it all

rows() -> bigint[]{} is
    let row mut = [1n] |> list()

    do
        yield row

        let previous = row
        let width = previous.count

        row =
            (0::width)
                |> map(column => (
                    let left =
                        if column > 0 then
                            previous[column - 1]
                        else
                            0n
                        fi
                    let below =
                        if column < width then
                            previous[column]
                        else
                            0n
                        fi

                    left + bigint(width - 1) * below
                ))
                |> list()
    od
si

write_line("unsigned Stirling numbers of the first kind, S1(n, k):")

rows()
    |> take(13)
    |> each(row => write_line(row |> map(v => "{v,11}") |> join("")))

write_line()

let hundredth = rows() |> skip(100) |> first_or_throw()

let largest = hundredth |> max()

write_line("the largest S1(100, k):")
write_line("  {largest!}")
