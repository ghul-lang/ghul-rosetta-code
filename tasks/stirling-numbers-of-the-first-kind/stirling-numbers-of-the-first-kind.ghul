use default

rows() -> bigint[]{} is
    let row mut = [1n] |> list()

    do
        yield row

        let previous = row
        let width = previous.count

        row =
            (0::width)
                |> map(column => (
                    let left =
                        if column > 0 then
                            previous[column - 1]
                        else
                            0n
                        fi
                    let below =
                        if column < width then
                            previous[column]
                        else
                            0n
                        fi

                    left + bigint(width - 1) * below
                ))
                |> list()
    od
si

write_line("unsigned Stirling numbers of the first kind, S1(n, k):")

rows()
    |> take(13)
    |> each(row => write_line(row |> map(v => "{v,11}") |> join("")))

write_line()

let hundredth = rows() |> skip(100) |> first()!

let largest = hundredth |> max()

write_line("the largest S1(100, k):")
write_line("  {largest!}")
