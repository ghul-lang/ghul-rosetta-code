use default

next_row(row: bigint[]) -> bigint[] pure =>
    row |> scan(row[row.count - 1], (total, n) => total + n) |> list()

let rows = iterate([1n] |> list(), next_row) |> take(50) |> list()

write_line("first fifteen and fiftieth Bell numbers:")

for i in 0..15 do
    let n = i + 1
    write_line("{n,2}: {rows[i][0]}")
od

write_line("50: {rows[49][0]}")
write_line("")
write_line("first ten rows of Bell's triangle:")

for i in 0..10 do
    write_line("{rows[i] |> join(", ")}")
od
