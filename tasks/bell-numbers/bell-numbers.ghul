use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence

bell_triangle() -> bigint[]{} is
    let row mut = LIST()

    row.add(1n)

    while true do
        yield row

        let next = LIST()

        next.add(row[row.count - 1])

        for j in 0..row.count do
            next.add(next[j] + row[j])
        od

        row = next
    od
si

let rows = bell_triangle() |> take(50) |> list()

write_line("first fifteen and fiftieth Bell numbers:")

for i in 0..15 do
    let n = i + 1
    write_line("{n,2}: {rows[i][0]}")
od

write_line("50: {rows[49][0]}")
write_line("")
write_line("first ten rows of Bell's triangle:")

for i in 0..10 do
    write_line("{rows[i] |> join(", ")}")
od
