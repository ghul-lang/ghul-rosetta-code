use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read, and `count` reads it all
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

let first_primes = primes() |> take(50) |> list()

// A number with a prime number p of divisors is a prime to the power
// p - 1, so the nth of them is the nth prime to that power.
term(n: int) -> bigint =>
    if is_prime(n) then
        bigint.pow(bigint(first_primes[n - 1]), n - 1)
    else
        bigint(
            from(1L)
                |> filter(c => divisor_count(c) == long(n))
                |> skip(n - 1)
                |> first()!
        )
    fi

for n in 1::15 do
    write_line("{n,2}: {term(n)}")
od
