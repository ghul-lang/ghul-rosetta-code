use default

is_valid_iban(raw: string) -> bool is
    let iban =
        ["{ch}" for ch in raw if ch != ' '] |> join("")

    let is_letter = ch => ch >= 'A' /\ ch <= 'Z'

    if iban.length < 4 \/ !is_letter(iban[0]) \/ !is_letter(iban[1]) then
        return false
    fi

    let rearranged = "{iban[4..<0]}{iban[0..4]}"

    let letter_value = ch => "{int(ch) - int('A') + 10}"
    let numeric = rearranged
        |> map(ch => if is_letter(ch) then letter_value(ch) else "{ch}" fi)
        |> join("")

    let remainder mut = 0

    for ch in numeric do
        remainder = (remainder * 10 + (int(ch) - int('0'))) % 97
    od

    remainder == 1
si

let candidates = [
    "GB82 WEST 1234 5698 7654 32",
    "GB82 WEST 1234 5698 7654 33"
]

for candidate in candidates do
    let verdict = if is_valid_iban(candidate) then "valid" else "invalid" fi

    write_line("{candidate}: {verdict}")
od
