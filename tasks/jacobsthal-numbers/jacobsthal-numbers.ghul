use default

let two = 2n

jacobsthal_from(first: bigint, second: bigint) -> bigint{} is
    let previous mut = first
    let current mut = second

    do
        yield previous
        let next = current + previous * two
        previous = current
        current = next
    od
si

jacobsthal() -> bigint{} => jacobsthal_from(0n, 1n)

jacobsthal_lucas() -> bigint{} => jacobsthal_from(two, 1n)

jacobsthal_oblongs() -> bigint{} is
    let previous mut = 0n
    let current mut = 1n

    do
        yield previous * current
        let next = current + previous * two
        previous = current
        current = next
    od
si

is_prime(n: bigint) -> bool =>
    n > 1n /\
        stream(two, d => d || d + 1n)
            |> take_while(d => d * d <= n)
            |> all(d => n % d !~ 0n)

show(label: string, values: bigint{}, count: int) is
    write_line("{label}:")
    let rows = values |> take(count) |> chunk(10)

    rows |> each(row =>
        write_line(row |> map(v => "{v,16}") |> join(" ")))
si

show("first 30 Jacobsthal numbers", jacobsthal(), 30)
show("first 30 Jacobsthal-Lucas numbers", jacobsthal_lucas(), 30)
show("first 20 Jacobsthal oblong numbers", jacobsthal_oblongs(), 20)
show("first 10 Jacobsthal primes",
    jacobsthal() |> filter(is_prime),
    10)
