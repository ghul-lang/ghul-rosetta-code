use Raster

let order = 12
let step = 6.0

let image = IMAGE(620, 440)
let pen = TURTLE(image)

dragon(depth: int, angle: double) is
    if depth == 0 then
        pen.forward(step)
        return
    fi

    dragon(depth - 1, 90.0)
    pen.turn(angle)
    dragon(depth - 1, -90.0)
si

image.color(0ub, 0ub, 160ub)
image.stroke(1.0)

pen.move_to(468.0, 150.0)

dragon(order, 90.0)

image.write("dragon.png")

image.show("dragon.png")
