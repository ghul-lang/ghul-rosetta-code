use default

use Sum = (total: int, sign: int, term: int)

let joined = 2
let minus = 1

operators(code: int) -> int[] =>
    [code / (repeat(3, at) |> product()) % 3 for at in 0..9]

separator(operator: int, at: int) -> string =>
    if operator == joined then ""
    elif at == 0 then if operator == minus then "-" else "" fi
    elif operator == minus then " - "
    else " + "
    fi

text_of(operators: int[]) -> string =>
    0..9 |> map(at => "{separator(operators[at], at)}{at + 1}") |> join("")

add_digit(sum: Sum, operator: int, digit: int) -> Sum =>
    if operator == joined then
        (sum.total, sum.sign, sum.term * 10 + digit)
    else
        (sum.total + sum.sign * sum.term,
            if operator == minus then -1 else 1 fi,
            digit)
    fi

value_of(operators: int[]) -> int =>
    let
        start: Sum = (0, 1, 0),
        sum = 0..9 |> reduce(start, (sum, at) =>
            add_digit(sum, operators[at], at + 1))
    in
        sum.total + sum.sign * sum.term

expressions() -> (value: int, text: string){} =>
    0..19683
        |> map(operators)
        |> filter(ops => ops[0] != joined)
        |> map(ops => (value = value_of(ops), text = text_of(ops)))

let all = expressions() |> memo()

write_line("expressions summing to 100:")

all
    |> filter(expression => expression.value == 100)
    |> sort((left, right) => left.text <> right.text)
    |> each(expression => write_line("    {expression.text}"))

let counts = all
    |> group_by(expression => expression.value)
    |> map(group => (group.key, group.value.count))
    |> collect_map()

let most = counts.keys |> max_by(value => counts[value])

assert most? else "some sum has the most expressions"

write_line("")
write_line("{most} has the most expressions, {counts[most]} of them")

let unreachable = from(1)
    |> filter(sum => !counts.contains_key(sum))
    |> first()

assert unreachable? else "some positive sum has no expression"

write_line("{unreachable} is the lowest positive sum with no expression")

let highest = counts.keys |> sort((left, right) => right - left) |> take(10)

write_line("ten highest sums: {highest |> join(", ")}")
