use default

cullen(n: int) -> bigint => (bigint(n) << n) + 1n

woodall(n: int) -> bigint => (bigint(n) << n) - 1n

let small_primes = 3::20_000
    |> filter(p => 2..p |> all(d => d * d > p \/ p % d != 0))
    |> map(p => long(p))
    |> collect()

power_of_two_mod(n: int, p: long) -> long is
    let result mut = 1L
    let base mut = 2L
    let exponent mut = n

    while exponent > 0 do
        if exponent % 2 == 1 then
            result = result * base % p
        fi

        base = base * base % p
        exponent = exponent / 2
    od

    result
si

has_small_factor(n: int, offset: long) -> bool =>
    n > 10 /\ small_primes |> any(p =>
        (long(n) % p * power_of_two_mod(n, p) + offset) % p == 0L)

passes_round(
    witness: bigint, candidate: bigint, odd_part: bigint, twos: int
) -> bool is
    let minus_one = candidate - 1n
    let x mut = bigint.mod_pow(witness, odd_part, candidate)

    if x.is_one \/ x =~ minus_one then
        return true
    fi

    for _ in 1..twos do
        x = bigint.mod_pow(x, 2n, candidate)

        if x =~ minus_one then
            return true
        fi
    od

    false
si

is_probable_prime(candidate: bigint) -> bool is
    if candidate < 4n then
        return candidate > 1n
    fi

    let odd_part mut = candidate - 1n
    let twos mut = 0

    while odd_part.is_even do
        odd_part = odd_part >> 1
        twos = twos + 1
    od

    [2n, 3n, 5n, 7n, 11n, 13n, 17n]
        |> filter(witness => witness < candidate)
        |> all(witness => passes_round(witness, candidate, odd_part, twos))
si

is_cullen_prime(n: int) -> bool =>
    !has_small_factor(n, 1L) /\ is_probable_prime(cullen(n))

is_woodall_prime(n: int) -> bool =>
    !has_small_factor(n, -1L) /\ is_probable_prime(woodall(n))

write_line("First 20 Cullen numbers:")
write_line(from(1) |> map(cullen) |> take(20) |> join(" "))
write_line()
write_line("First 20 Woodall numbers:")
write_line(from(1) |> map(woodall) |> take(20) |> join(" "))
write_line()
write_line("searching for Cullen primes, which takes a while")
write_line("First 5 Cullen primes, as n:")
write_line(from(1) |> filter(is_cullen_prime) |> take(5) |> join(" "))
write_line()
write_line("searching for Woodall primes")
write_line("First 12 Woodall primes, as n:")
write_line(from(1) |> filter(is_woodall_prime) |> take(12) |> join(" "))
