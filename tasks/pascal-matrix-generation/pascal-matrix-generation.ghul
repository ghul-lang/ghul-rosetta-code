use default

choose(n, k) => binomial(long(n), long(k))

matrix(size, entry) =>
    0..size |> map(i => 0..size |> map(entry(i, *)) |> list()) |> list()

upper(size) => matrix(size, (i, j) => choose(j, i))

lower(size) => matrix(size, (i, j) => choose(i, j))

symmetric(size) => matrix(size, (i, j) => choose(i + j, i))

show(title, m) is
    write_line("{title}:")

    for row in m do
        write_line(row |> map(v => "{v,4}") |> join(""))
    od

    write_line()
si

show("Upper", upper(5))
show("Lower", lower(5))
show("Symmetric", symmetric(5))
