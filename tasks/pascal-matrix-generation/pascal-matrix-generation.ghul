use default

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `*` as an argument leaves that parameter open: partial application.

choose(n: int, k: int) -> long => binomial(long(n), long(k))

matrix(size: int, entry: (int, int) -> long) -> long[][] =>
    0..size |> map(i => 0..size |> map(entry(i, *)) |> list()) |> list()

upper(size: int) -> long[][] => matrix(size, (i, j) => choose(j, i))

lower(size: int) -> long[][] => matrix(size, (i, j) => choose(i, j))

symmetric(size: int) -> long[][] => matrix(size, (i, j) => choose(i + j, i))

show(title: string, m: long[][]) is
    write_line("{title}:")

    for row in m do
        write_line(row |> map(v => "{v,4}") |> join(""))
    od

    write_line()
si

show("Upper", upper(5))
show("Lower", lower(5))
show("Symmetric", symmetric(5))
