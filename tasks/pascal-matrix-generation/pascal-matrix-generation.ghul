use default

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`

choose(n: int, k: int) -> long => binomial(long(n), long(k))

matrix(size: int, entry: (int, int) -> long) -> long[][] =>
    0..size |> map(i => 0..size |> map(entry(i, *)) |> list()) |> list()

upper(size: int) -> long[][] => matrix(size, (i, j) => choose(j, i))

lower(size: int) -> long[][] => matrix(size, (i, j) => choose(i, j))

symmetric(size: int) -> long[][] => matrix(size, (i, j) => choose(i + j, i))

show(title: string, m: long[][]) is
    write_line("{title}:")

    for row in m do
        write_line(row |> map(v => "{v,4}") |> join(""))
    od

    write_line()
si

show("Upper", upper(5))
show("Lower", lower(5))
show("Symmetric", symmetric(5))
