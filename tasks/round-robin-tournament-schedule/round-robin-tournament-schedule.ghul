use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `LIST()` builds its collection eagerly
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

rounds(players: int) -> (int, int)[]{} is
    let n = if players % 2 == 0 then players else players + 1 fi
    let seats = (1::n) |> LIST()

    for _ in 1..n do
        yield (0..n / 2) |> map(i => (seats[i], seats[n - 1 - i])) |> list()

        let last = seats[n - 1]
        seats.remove_at(n - 1)
        seats.insert(1, last)
    od
si

show(player: int, players: int) -> string =>
    if player > players then "bye" else "{player}" fi

schedule(players: int) is
    write_line("{players} players:")

    for (round, games) in rounds(players) |> index() do
        let line =
            games
                |> map((a, b) =>
                    "{show(a, players),3} v {show(b, players),-3}"
                )
                |> join(" ")

        write_line("round {round + 1,2}: {line}".trim_end())
    od

    write_line("")
si

schedule(12)
schedule(5)
