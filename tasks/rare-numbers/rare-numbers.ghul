use default

let square_endings = [0, 1, 4, 5, 6, 9]

reverse_of(n: long) -> long is
    let remaining mut = n
    let reversed mut = 0L

    while remaining > 0L do
        reversed = reversed * 10L + remaining % 10L
        remaining = remaining / 10L
    od

    return reversed
si

is_square(n: long) -> bool is
    if n < 0L then
        return false
    fi

    let root mut = long(System.Math.sqrt(double(n)))

    while root * root > n do
        root = root - 1L
    od

    while (root + 1L) * (root + 1L) <= n do
        root = root + 1L
    od

    return root * root == n
si

is_rare(n: long) -> bool is
    let r = reverse_of(n)

    return n > r /\ is_square(n + r) /\ is_square(n - r)
si

// The sum ends in the last digit of n plus its first, and the difference in
// their difference, so a pair of those digits that can end neither square
// rules out every number that starts and ends with them.
let starts_and_ends =
    [(first = first, last = last)
        for first in 1::9 for last in 0::9
        if square_endings |> any(e => e == (last + first) % 10) /\
            square_endings
                |> any(e => e == (last - first + 10) % 10)]

let limit = 2_100_000_000L

let found = LIST()

let block mut = 10L

while block < limit do
    for pair in starts_and_ends do
        let start = block * long(pair.first)
        let stop = System.Math.min(start + block, limit)

        let first_candidate = start + long(pair.last)

        let n mut =
            if first_candidate < start then start else first_candidate fi

        while n < stop do
            if is_rare(n) then
                found.add(n)
            fi

            n = n + 10L
        od
    od

    block = block * 10L
od

found |> sort() |> each(n => write_line("{n:N0}"))
