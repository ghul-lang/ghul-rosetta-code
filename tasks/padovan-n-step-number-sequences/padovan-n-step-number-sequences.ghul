use default

// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

padovan(step: int, count: int) -> int[] is
    let terms mut = LIST()

    if step == 2 then
        terms.add(1)
        terms.add(1)
        terms.add(1)
    else
        terms = LIST(padovan(step - 1, count)[0::step])
    fi

    while terms.count < count do
        let total = 2::step + 1 |> sum_by(back => terms[terms.count - back])
        terms.add(total)
    od

    terms
si

for step in 2::8 do
    let terms = padovan(step, 15) |> map(term => "{term,4}")

    write_line("{step}:{terms |> join("")}")
od
