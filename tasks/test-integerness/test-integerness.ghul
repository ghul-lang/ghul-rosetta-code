use default
use System.Numerics.Complex
use System.Globalization.CultureInfo
use System.Math.*

is_integer(d: decimal) -> bool => d == decimal.truncate(d)

is_integer(x: double) -> bool =>
    double.is_finite(x) /\ x == floor(x)

// A fraction is held in lowest terms, so it is an integer exactly when
// its denominator divides its numerator.
is_integer(numerator: bigint, denominator: bigint) -> bool =>
    (numerator % denominator).is_zero

is_integer(z: Complex) -> bool =>
    z.imaginary == 0.0 /\ is_integer(z.real)

// Close enough, for a double that has picked up rounding error on the
// way to what should have been an integer.
is_nearly_integer(x: double, tolerance: double) -> bool =>
    abs(x - round(x)) <= tolerance

for d in [25.000000m, 24.999999m, 25.000100m] do
    write_line("decimal  {d,-12} {is_integer(d)}")
od

for
    x in [
        -2.1e120, -5.0e-2, double.na_n,
        double.positive_infinity, 25.0
    ]
do
    let shown = x.to_string(CultureInfo.invariant_culture)

    write_line("double   {shown,-12} {is_integer(x)}")
od

for (n, d) in [(5n, 2n), (-6n, 3n), (0n, 7n)] do
    write_line("fraction {"{n}/{d}",-12} {is_integer(n, d)}")
od

for
    z in [
        Complex(5.0, 0.0),
        Complex(5.0, 1.0),
        Complex(1.5, 0.0)
    ]
do
    let shown = "{z.real}+{z.imaginary}i"

    write_line("complex  {shown,-12} {is_integer(z)}")
od

write_line("")

for x in [24.999999, 25.000100, 3.0000000000001] do
    let near = is_nearly_integer(x, 0.00001)

    write_line("{x} within 0.00001 of an integer: {near}")
od
