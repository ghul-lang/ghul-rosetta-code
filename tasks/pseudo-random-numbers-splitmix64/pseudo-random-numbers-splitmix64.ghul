use default

class SPLITMIX64 is
    _state: ulong

    init(seed: ulong) is
        _state = seed
    si

    next_int() -> ulong is
        _state = _state + 0x9e3779b97f4a7c15ul

        let z mut = _state

        z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ul
        z = (z ^ (z >> 27)) * 0x94d049bb133111ebul

        z ^ (z >> 31)
    si

    next_float() -> double =>
        double(next_int()) / 18_446_744_073_709_551_616.0
si

let first = SPLITMIX64(1234567ul)

for _ in 1::5 do
    write_line("{first.next_int(),20}")
od

let generator = SPLITMIX64(987654321ul)
let counts = repeat(0, 5) |> collect_mutable()

for _ in 1::100_000 do
    let bucket = int(generator.next_float() * 5.0)

    counts[bucket] = counts[bucket] + 1
od

write_line("")
write_line(0..5 |> map(i => "{i}: {counts[i]}") |> join())
