use default
use Raster.IMAGE

// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

struct V2(x: double, y: double) is
    +(o: V2) -> V2 => V2(x + o.x, y + o.y)
    -(o: V2) -> V2 => V2(x - o.x, y - o.y)
    *(k: double) -> V2 => V2(x * k, y * k)
si

class PARTICLE(position: V2 public, velocity: V2 public, best: V2 public)

class PROBLEM(
    name: string,
    f: V2 -> double,
    low: V2,
    high: V2,
    omega: double,
    phi_p: double,
    phi_g: double,
    count: int,
    iterations: int
)

let random = System.Random(42)

between(low: double, high: double) -> double =>
    low + (high - low) * random.next_double()

clamp(p: V2, problem: PROBLEM) -> V2 =>
    V2(
        Ghul.Math.clamp(p.x, problem.low.x, problem.high.x),
        Ghul.Math.clamp(p.y, problem.low.y, problem.high.y)
    )

swarm(problem: PROBLEM) -> (best: V2, particles: PARTICLE[]) is
    let f = problem.f
    let span = problem.high - problem.low

    let particles =
        (0..problem.count)
            |> map(_ =>
                let at = V2(
                    between(problem.low.x, problem.high.x),
                    between(problem.low.y, problem.high.y)
                )
                in
                PARTICLE(
                    at,
                    V2(between(-span.x, span.x), between(-span.y, span.y)),
                    at
                )
            )
            |> list()

    let best mut = (particles |> min_by(p => f(p.best)))!.best

    for _ in 0..problem.iterations do
        for p in particles do
            p.velocity =
                p.velocity * problem.omega +
                (p.best - p.position) *
                (problem.phi_p * random.next_double()) +
                (best - p.position) * (problem.phi_g * random.next_double())

            p.position = clamp(p.position + p.velocity, problem)

            if f(p.position) < f(p.best) then
                p.best = p.position

                if f(p.position) < f(best) then
                    best = p.position
                fi
            fi
        od
    od

    return (best = best, particles = particles)
si

mccormick(p: V2) -> double =>
    sin(p.x + p.y) +
    (p.x - p.y) * (p.x - p.y) -
    1.5D * p.x +
    2.5D * p.y +
    1.0D

michalewicz(p: V2) -> double =>
    let term =
        (x, i) =>
            sin(x) * pow(sin(i * x * x / pi), 20.0D)
    in
    -(term(p.x, 1.0D) + term(p.y, 2.0D))

draw(problem: PROBLEM, found: (best: V2, particles: PARTICLE[])) is
    let size = 300
    let image = IMAGE(size, size)
    let span = problem.high - problem.low

    let at =
        (column, row) => V2(
            problem.low.x + span.x * (double(column) + 0.5D) / double(size),
            problem.high.y - span.y * (double(row) + 0.5D) / double(size)
        )

    let values = LIST()

    for row in 0..size do
        for column in 0..size do
            values.add(problem.f(at(column, row)))
        od
    od

    let low = values |> reduce(values[0], (a, b) => min(a, b))
    let high = values |> reduce(values[0], (a, b) => max(a, b))

    for row in 0..size do
        for column in 0..size do
            let t = (values[row * size + column] - low) / (high - low)
            let s = sqrt(t)

            image.set_pixel(
                column,
                row,
                ubyte(40.0D + 215.0D * s),
                ubyte(30.0D + 200.0D * s * s),
                ubyte(90.0D + 60.0D * (1.0D - s))
            )
        od
    od

    image.view(problem.low.x, problem.low.y, problem.high.x, problem.high.y)

    image.colour(255ub, 255ub, 255ub)

    for p in found.particles do
        image.dot(p.position.x, p.position.y, 2.0D)
    od

    image.colour(0ub, 200ub, 255ub)
    image.stroke(2.5D)
    image.ring(found.best.x, found.best.y, 9.0D)

    let file = "{problem.name.to_lower()}.png"

    image.write(file)
    image.show(file)
si

let problems = [
    PROBLEM(
        "McCormick",
        mccormick,
        V2(-1.5D, -3.0D),
        V2(4.0D, 4.0D),
        0.0D,
        0.6D,
        0.3D,
        100,
        40
    ),
    PROBLEM(
        "Michalewicz",
        michalewicz,
        V2(0.0D, 0.0D),
        V2(pi, pi),
        0.3D,
        0.3D,
        0.3D,
        1000,
        30
    )
]

write_line("each picture shows the swarm after its last iteration")
write_line("and rings the best point found")
write_line()

for problem in problems do
    let found = swarm(problem)
    let b = found.best

    write_line("{problem.name}: f({b.x:F5}, {b.y:F5}) = {problem.f(b):F5}")

    draw(problem, found)
od
