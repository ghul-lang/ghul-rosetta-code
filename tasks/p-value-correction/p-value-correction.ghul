use default

let p_values = [
    4.533744e-01, 7.296024e-01, 9.936026e-02, 9.079658e-02, 1.801962e-01,
    8.752257e-01, 2.922222e-01, 9.115421e-01, 4.355806e-01, 5.324867e-01,
    4.926798e-01, 5.802978e-01, 3.485442e-01, 7.883130e-01, 2.729308e-01,
    8.502518e-01, 4.268138e-01, 6.442008e-01, 3.030266e-01, 5.001555e-02,
    3.194810e-01, 7.892933e-01, 9.991834e-01, 1.745691e-01, 9.037516e-01,
    1.198578e-01, 3.966083e-01, 1.403837e-02, 7.328671e-01, 6.793476e-02,
    4.040730e-03, 3.033349e-04, 1.125147e-02, 2.375072e-02, 5.818542e-04,
    3.075482e-04, 8.251272e-03, 1.356534e-03, 1.360696e-02, 3.764588e-04,
    1.801145e-05, 2.504456e-07, 3.310253e-02, 9.427839e-03, 8.791153e-04,
    2.177831e-04, 9.693054e-04, 6.610250e-05, 2.900813e-02, 5.735490e-03
]

let n = p_values.count

let ascending =
    0..n
        |> sort((a, b) => p_values[a] <> p_values[b])
        |> collect()
let descending = ascending |> reverse() |> collect()

running(
    order: List[int],
    factor: (int) -> double,
    keep_lower: bool
) -> List[double] is
    let adjusted = repeat(0.0, n) |> collect_mutable()
    let bound mut = if keep_lower then 1.0 else 0.0 fi

    for rank in 0..n do
        let value = factor(rank) * p_values[order[rank]]

        bound =
            if keep_lower then System.Math.min(bound, value)
            else System.Math.max(bound, value)
            fi

        adjusted[order[rank]] = System.Math.min(1.0, bound)
    od

    adjusted
si

let harmonic = 1::n |> sum_by(i => 1.0 / double(i))

benjamini_hochberg() -> List[double] =>
    running(
        descending, rank => double(n) / double(n - rank), true)

benjamini_yekutieli() -> List[double] =>
    running(
        descending,
        rank => harmonic * double(n) / double(n - rank),
        true)

bonferroni() -> List[double] =>
    p_values
        |> map(p => System.Math.min(1.0, double(n) * p))
        |> collect()

hochberg() -> List[double] =>
    running(descending, rank => double(rank + 1), true)

holm() -> List[double] =>
    running(ascending, rank => double(n - rank), false)

hommel() -> List[double] is
    let sorted = ascending |> map(i => p_values[i]) |> collect()
    let smallest =
        0..n
            |> map(i => double(n) * sorted[i] / double(i + 1))
            |> min() ?? 1.0
    let q = repeat(smallest, n) |> collect_mutable()
    let floor = repeat(smallest, n) |> collect_mutable()

    for m in (2::n - 1) |> reverse() do
        let tail = n - m + 1
        let q1 =
            tail..n
                |> map(i =>
                    double(m) * sorted[i] / double(i - tail + 2))
                |> min() ?? 1.0

        for i in 0..tail do
            q[i] = System.Math.min(double(m) * sorted[i], q1)
        od

        for i in tail..n do
            q[i] = q[tail - 1]
        od

        for i in 0..n do
            floor[i] = System.Math.max(floor[i], q[i])
        od
    od

    let adjusted = repeat(0.0, n) |> collect_mutable()

    for rank in 0..n do
        adjusted[ascending[rank]] =
            System.Math.max(floor[rank], sorted[rank])
    od

    adjusted
si

show(name: string, adjusted: List[double]) is
    write_line(name)

    for row in 0..n / 5 do
        let cells = adjusted |> skip(row * 5) |> take(5)

        let text =
            cells |> map(v => v.to_string("0.000000e+00")) |> join(" ")

        write_line("[{row * 5 + 1,2}] {text}")
    od

    write_line("")
si

show("Benjamini-Hochberg", benjamini_hochberg())
show("Benjamini-Yekutieli", benjamini_yekutieli())
show("Bonferroni", bonferroni())
show("Hochberg", hochberg())
show("Holm", holm())
show("Hommel", hommel())
