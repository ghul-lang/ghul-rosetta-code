use default

reorder(items: string[], order: string[]) -> string{} is
    let wanted = MAP(order |> frequencies())

    let places = LIST()

    for entry in items |> index() do
        let outstanding mut = 0

        wanted.try_get_value(entry.value, outstanding ref)

        if outstanding > 0 then
            wanted[entry.value] = outstanding - 1

            places.add(entry.index)
        fi
    od

    let reordered = LIST(items)

    for place in places |> index() do
        reordered[place.value] = order[place.index]
    od

    reordered.to_array()
si

[("the cat sat on the mat", "mat cat"),
 ("the cat sat on the mat", "cat mat"),
 ("A B C A B C A B C", "C A C A"),
 ("A B C A B D A B E", "E A D A"),
 ("A B", "B"),
 ("A B", "B A"),
 ("A B B A", "B A")]
    |> each(example =>
        (let (items, order) = example

         let result = reorder(items.split([' ']), order.split([' ']))

         write_line("M: {items}")
         write_line("N: {order}")
         write_line("result: {result |> join(" ")}")
         write_line("")))
