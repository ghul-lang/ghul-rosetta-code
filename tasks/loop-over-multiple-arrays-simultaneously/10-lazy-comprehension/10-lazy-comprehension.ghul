use default

let letters = ['a', 'b', 'c']
let capitals = ['A', 'B', 'C']
let digits = [1, 2, 3]
let count =
    [letters.count, capitals.count, digits.count] |> min()!

let rows = {
    "{letters[i]}{capitals[i]}{digits[i]}"
    for i in from(0)
}

rows |> take(count) |> each(row => write_line(row))
