use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

let letters = ['a', 'b', 'c']
let capitals = ['A', 'B', 'C']
let digits = [1, 2, 3]
let count = [letters.count, capitals.count, digits.count] |> min()!

stream(
    (letters, capitals, digits),
    (l, c, d) => "{l[0]}{c[0]}{d[0]}" || (l[1..<0], c[1..<0], d[1..<0])
)
    |> take(count)
    |> each(row => write_line(row))
