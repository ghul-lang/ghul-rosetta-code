use default

show(
    letters: List[char], capitals: List[char], digits: List[int]
) -> string{} =>
    if [letters.count, capitals.count, digits.count] |> min()! == 0 then
        []
    else
        ["{letters[0]}{capitals[0]}{digits[0]}"] ++
            show(letters[1..<0], capitals[1..<0], digits[1..<0])
    fi

write_line(show(['a', 'b', 'c'], ['A', 'B', 'C'], [1, 2, 3]) |> join("\n"))
