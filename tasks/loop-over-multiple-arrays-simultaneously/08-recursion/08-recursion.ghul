use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `if let` and `case ... when` pattern-match; `[x, ..rest]` matches a list.

merge(letters: char[], capitals: char[], digits: int[]) -> string{} =>
    if let
        [lh, ..lr] = letters,
        [ch, ..cr] = capitals,
        [dh, ..dr] = digits
    then
        ["{lh}{ch}{dh}"] ++ merge(lr, cr, dr)
    else
        []
    fi

write_line(merge(['a', 'b', 'c'], ['A', 'B', 'C'], [1, 2, 3]) |> join("\n"))
