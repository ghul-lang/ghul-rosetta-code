use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `if let` pattern-matches, and `[x, ..rest]` matches a list head and tail

merge(letters: char[], capitals: char[], digits: int[]) -> string{} =>
    if let
        [lh, ..lr] = letters,
        [ch, ..cr] = capitals,
        [dh, ..dr] = digits
    then
        ["{lh}{ch}{dh}"] ++ merge(lr, cr, dr)
    else
        []
    fi

write_line(merge(['a', 'b', 'c'], ['A', 'B', 'C'], [1, 2, 3]) |> join("\n"))
