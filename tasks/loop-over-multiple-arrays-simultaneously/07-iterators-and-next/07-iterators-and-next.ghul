use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

let letters = ['a', 'b', 'c'].iterator
let capitals = ['A', 'B', 'C'].iterator
let digits = [1, 2, 3].iterator

while let
    letter = letters |> next(),
    capital = capitals |> next(),
    digit = digits |> next()
do
    write_line("{letter}{capital}{digit}")
od
