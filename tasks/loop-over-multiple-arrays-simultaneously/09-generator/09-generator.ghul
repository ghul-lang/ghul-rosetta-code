use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `T{}` is a lazy sequence of `T`, read by iterating it.
// `yield` makes the function a generator: it returns a lazy `T{}`.

let letters = ['a', 'b', 'c']
let capitals = ['A', 'B', 'C']
let digits = [1, 2, 3]
let count = [letters.count, capitals.count, digits.count] |> min()!

rows() -> string{} is
    for i in 0..count do
        yield "{letters[i]}{capitals[i]}{digits[i]}"
    od
si

for row in rows() do
    write_line(row)
od
