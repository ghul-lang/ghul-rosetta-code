use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
// sequence

let letters = ['a', 'b', 'c']
let capitals = ['A', 'B', 'C']
let digits = [1, 2, 3]
let count = [letters.count, capitals.count, digits.count] |> min()!

rows() -> string{} is
    for i in 0..count do
        yield "{letters[i]}{capitals[i]}{digits[i]}"
    od
si

for row in rows() do
    write_line(row)
od
