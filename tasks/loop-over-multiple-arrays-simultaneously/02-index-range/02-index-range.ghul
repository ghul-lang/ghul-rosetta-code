use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

let letters = ['a', 'b', 'c']
let capitals = ['A', 'B', 'C']
let digits = [1, 2, 3]
let count = [letters.count, capitals.count, digits.count] |> min()!

for i in 0..count do
    write_line("{letters[i]}{capitals[i]}{digits[i]}")
od
