use Raster

let order = 6
let step = 8.0D

let image = IMAGE(560, 560)
let pen = TURTLE(image)

hilbert(depth: int, angle: double) is
    if depth == 0 then
        return
    fi

    pen.turn(angle)
    hilbert(depth - 1, -angle)
    pen.forward(step)

    pen.turn(-angle)
    hilbert(depth - 1, angle)
    pen.forward(step)
    hilbert(depth - 1, angle)

    pen.turn(-angle)
    pen.forward(step)
    hilbert(depth - 1, -angle)
    pen.turn(angle)
si

image.color(0ub, 0ub, 160ub)
image.stroke(1.2D)

pen.move_to(24.0D, 24.0D)

hilbert(order, 90.0D)

image.write("hilbert.png")

image.show("hilbert.png")
