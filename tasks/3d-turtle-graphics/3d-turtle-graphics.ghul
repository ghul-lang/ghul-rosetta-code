use default
use Raster.IMAGE

struct V3(x: double, y: double, z: double) is
    +(o: V3) -> V3 => V3(x + o.x, y + o.y, z + o.z)
    -(o: V3) -> V3 => V3(x - o.x, y - o.y, z - o.z)
    *(k: double) -> V3 => V3(x * k, y * k, z * k)
    ⋅(o: V3) -> double => x * o.x + y * o.y + z * o.z
    length: double => sqrt(self ⋅ self)
si

use Segment = (from: V3, to: V3, color: (ubyte, ubyte, ubyte))

class TURTLE is
    at: V3 public
    heading: V3 public
    left: V3 public
    up: V3 public
    color: (ubyte, ubyte, ubyte) public
    drawing: bool public
    drawn: LIST[Segment]

    init() is
        at = V3(0.0, 0.0, 0.0)
        heading = V3(1.0, 0.0, 0.0)
        left = V3(0.0, 1.0, 0.0)
        up = V3(0.0, 0.0, 1.0)
        color = (40ub, 40ub, 40ub)
        drawing = true
        drawn = LIST()
    si

    forward(distance: double) is
        let next = at + heading * distance

        if drawing then
            drawn.add((at, next, color))
        fi
        at = next
    si

    turn(degrees: double) is
        let a = degrees * pi / 180.0
        let h = heading * cos(a) + left * sin(a)

        left = left * cos(a) - heading * sin(a)
        heading = h
    si

    pitch(degrees: double) is
        let a = degrees * pi / 180.0
        let h = heading * cos(a) + up * sin(a)

        up = up * cos(a) - heading * sin(a)
        heading = h
    si

    state: (V3, V3, V3, V3) => (at, heading, left, up)
si

rectangle(t, a, b) is
    for side in [a, b, a, b] do
        t.forward(side)
        t.turn(90.0)
    od
si

box(t, width, depth, height) is
    rectangle(t, width, depth)

    for along in [width, depth, width, depth] do
        t.pitch(90.0)
        t.forward(height)
        t.pitch(-90.0)
        t.forward(along)
        t.pitch(-90.0)
        t.forward(height)
        t.pitch(90.0)
        t.turn(90.0)
    od
si

house(t, size) is
    let start = t.state

    box(t, size, size, size)

    let apex = size / 2.0
    let rise = size / sqrt(2.0)
    let slant = sqrt(apex * apex + apex * apex + rise * rise)
    let climb = asin(rise / slant) * 180.0 / pi

    t.pitch(90.0)
    t.forward(size)
    t.pitch(-90.0)

    for _ in 0..4 do
        t.turn(45.0)
        t.pitch(climb)
        t.forward(slant)
        t.pitch(180.0)
        t.forward(slant)
        t.pitch(180.0 - climb)
        t.turn(-45.0)
        t.forward(size)
        t.turn(90.0)
    od

    t.pitch(-90.0)
    t.forward(size)
    t.pitch(90.0)

    assert (t.at - start.`0).length < 1.0e-9
si

bar_chart(t, values, size) is
    let start = t.state
    let width = size / double(values.count)
    let most = values |> reduce(0.0, max)

    for value in values do
        box(t, width * 0.8, width * 0.8, size * value / most)

        t.forward(width)
    od

    t.drawing = false
    t.turn(180.0)
    t.forward(size)
    t.turn(180.0)
    t.drawing = true

    assert (t.at - start.`0).length < 1.0e-9
si

let turtle = TURTLE()

turtle.color = (170ub, 40ub, 40ub)
house(turtle, 100.0)

turtle.turn(-90.0)
turtle.drawing = false
turtle.forward(260.0)
turtle.drawing = true
turtle.turn(90.0)
turtle.color = (40ub, 90ub, 170ub)
bar_chart(turtle, [0.5, 0.33333, 2.0, 1.3, 0.5], 200.0)

let at_home = turtle.state

write_line("{turtle.drawn.count} segments drawn")
let facing = (at_home.`1 - V3(1.0, 0.0, 0.0)).length < 1.0e-9
write_line("facing the way it started: {facing}")

let yaw = 35.0 * pi / 180.0
let elevation = 25.0 * pi / 180.0

project(p) =>
    let
        across = p.x * cos(yaw) - p.y * sin(yaw),
        depth = p.x * sin(yaw) + p.y * cos(yaw),
        height = p.z * cos(elevation) + depth * sin(elevation)
    in
        (x = across, y = height)

let image = IMAGE(480, 360)

let points = turtle.drawn |> flat_map(s => [project(s.from), project(s.to)])

let low_x = points |> map(p => p.x) |> reduce(0.0, min)
let high_x = points |> map(p => p.x) |> reduce(0.0, max)
let low_y = points |> map(p => p.y) |> reduce(0.0, min)
let high_y = points |> map(p => p.y) |> reduce(0.0, max)

image.view(low_x - 20.0, low_y - 20.0, high_x + 20.0, high_y + 20.0)
image.clear(252ub, 250ub, 245ub)
image.stroke(2.0)

for (from, to, (r, g, b)) in turtle.drawn do
    let a = project(from), z = project(to)

    image.color(r, g, b)
    image.line(a.x, a.y, z.x, z.y)
od

image.write("turtle.png")

image.show("turtle.png")
