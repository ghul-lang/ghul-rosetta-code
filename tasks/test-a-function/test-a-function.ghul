use default
use System.Reflection.BindingFlags

use Microsoft.VisualStudio.TestTools.UnitTesting

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `=~` compares values (structural equality)

is_palindrome(text: string) -> bool =>
    let letters =
        text.to_lower().to_char_array()
            |> filter(char.is_letter_or_digit)
            |> list()
    in
    letters =~ (letters |> reverse() |> list())

// MSTest 4 records the text of the checked expression through trailing
// optional parameters, which a call has to supply.
is_true(condition: bool) => Assert.is_true(condition, "", "")
is_false(condition: bool) => Assert.is_false(condition, "", "")

@TestClass()
class PALINDROME_TESTS is
    init() is si

    @TestMethod()
    an_empty_string_is_a_palindrome() => is_true(is_palindrome(""))

    @TestMethod()
    a_single_letter_is_a_palindrome() => is_true(is_palindrome("a"))

    @TestMethod()
    a_word_that_reads_the_same_backwards_is_a_palindrome() =>
        is_true(is_palindrome("racecar"))

    @TestMethod()
    case_spaces_and_punctuation_are_ignored() =>
        is_true(is_palindrome("A man, a plan, a canal: Panama!"))

    @TestMethod()
    a_word_that_does_not_is_not() => is_false(is_palindrome("rosetta"))
si

is_test(method: System.Reflection.MethodInfo) -> bool =>
    method.get_custom_attributes(typeof TestMethodAttribute, true).count > 0

// MSTest's own runner is a test host rather than a program, so this
// finds the test methods itself and reports each one.
let tests = typeof PALINDROME_TESTS
let fixture = System.Activator.create_instance(tests)
let flags = BindingFlags.PUBLIC | BindingFlags.INSTANCE
let methods = tests.get_methods(flags) |> filter(is_test) |> list()
let passed mut = 0

for method in methods do
    try
        method.invoke(fixture, null)
        passed = passed + 1
        write_line("pass  {method.name}")
    catch e: System.Reflection.TargetInvocationException
        write_line("FAIL  {method.name}: {e.inner_exception?.message}")
    yrt
od

write_line("")
write_line("{passed} of {methods.count} tests passed")
