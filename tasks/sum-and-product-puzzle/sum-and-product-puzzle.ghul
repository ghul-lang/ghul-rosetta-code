use default

use Pair = (x: int, y: int)

sum(pair: Pair) -> int => pair.x + pair.y
product(pair: Pair) -> int => pair.x * pair.y

let candidates = [
    (x = x, y = y)
    for x in 2::100
    for y in x + 1::100 - x
]

with_sum(pairs: List[Pair], value: int) -> List[Pair] =>
    pairs |> filter(p => sum(p) == value) |> collect()

with_product(pairs: List[Pair], value: int) -> List[Pair] =>
    pairs |> filter(p => product(p) == value) |> collect()

let s_knows_p_does_not =
    candidates
        |> filter(pair =>
            with_sum(candidates, sum(pair))
                |> all(q =>
                    with_product(
                        candidates,
                        product(q)
                    ).count > 1
                )
        )
        |> collect()

let p_now_knows =
    s_knows_p_does_not
        |> filter(pair =>
            with_product(
                s_knows_p_does_not,
                product(pair)
            ).count == 1
        )
        |> collect()

let s_now_knows =
    p_now_knows
        |> filter(pair =>
            with_sum(p_now_knows, sum(pair)).count == 1
        )

for (x, y) in s_now_knows do
    write_line("X = {x}, Y = {y}")
od
