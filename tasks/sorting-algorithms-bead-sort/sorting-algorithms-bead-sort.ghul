use default

bead_sort(values: List[int]) -> int{} =>
    let tallest =
        values
            |> reduce(0, (most, value) =>
                if value > most then value else most fi
            )
    in
    let beads =
        (0..tallest)
            |> map(level =>
                values |> filter(* > level) |> count()
            )
    in
    (0..values.count)
        |> map(row => beads |> filter(* > row) |> count())
        |> reverse()

for values in [[5, 3, 1, 7, 4, 1, 1, 20], [2, 1], [8]] do
    write_line(
        "{values |> join(" ")} -> {values |> bead_sort() |> join(" ")}"
    )
od
