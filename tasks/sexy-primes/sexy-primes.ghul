use default

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

let limit = 1_000_035

group_from(first: int, size: int) -> int[] =>
    0..size |> map(step => first + step * 6) |> list()

sexy_groups(size: int) -> int[]{} =>
    (primes() |> take_while(p => p < limit))
        |> map(group_from(*, size))
        |> filter(members =>
            members[size - 1] < limit /\ (members |> all(p => is_prime(p)))
        )

show(values: int[]{}) -> string =>
    values |> map(members => "({members |> join(" ")})") |> join(" ")

last[T](values: T[], wanted: int) -> T{} =>
    let extra = values.count - wanted in
    values |> skip(if extra > 0 then extra else 0 fi)

let kinds = [
    (size = 2, name = "pairs"), (size = 3, name = "triplets"),
    (size = 4, name = "quadruplets"), (size = 5, name = "quintuplets")
]

kinds
    |> each(kind => (
        let found = sexy_groups(kind.size) |> list()

        write_line("sexy prime {kind.name} below {limit}: {found.count}")
        write_line("  last: {show(last(found, 5))}")
    ))

let unsexy =
    (primes() |> take_while(p => p < limit))
        |> filter(prime => !is_prime(prime - 6) /\ !is_prime(prime + 6))
        |> list()

write_line("unsexy primes below {limit}: {unsexy.count}")
write_line("  last: {unsexy |> last(10) |> join(" ")}")
