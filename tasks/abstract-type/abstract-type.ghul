use default

trait Shape is
    area() -> double
    name() -> string
si

trait Described is
    describe() -> string => "a shape"
si

class Polygon(sides: int private): Shape, Described abstract is
    area() -> double

    name() -> string => "{_sides}-sided polygon"

    describe() -> string => "{name()}, area {area():F2}"
si

class SQUARE(side: double private): Polygon is
    super(4)

    area() -> double => _side * _side
si

class TRIANGLE(
    base: double private,
    height: double private
): Polygon is
    super(3)

    area() -> double => _base * _height / 2.0D

    describe() -> string =>
        "{super.describe()}, and it is a triangle"
si

let shapes: Shape[] = [SQUARE(3.0D), TRIANGLE(4.0D, 5.0D)]

shapes |> each(shape => write_line(shape.name()))

let described: Described[] = [
    SQUARE(2.0D),
    TRIANGLE(6.0D, 1.0D)
]

described |> each(shape => write_line(shape.describe()))
