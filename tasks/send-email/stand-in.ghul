use default
use System.Net.IPAddress
use System.Net.IPEndPoint
use System.Net.Sockets.TcpListener

// The test's entry: sending a real email needs a real server and
// credentials we don't have, so this runs one of its own on the loopback
// interface, speaking just enough SMTP to accept a message and show what
// it was handed. Not part of the published solution.
@entry()
test_entry() is
    let listener = TcpListener(IPAddress.loopback, 0)

    listener.start()

    Tasks.TASK.run(() is
        let connection =
            listener.accept_tcp_client().get_stream()
        let reader = IO.StreamReader(connection)
        let writer = IO.StreamWriter(connection)

        writer.auto_flush = true
        writer.write("220 stand-in ready\r\n")

        let line mut = reader.read_line() ?? "QUIT"

        while !line.starts_with("QUIT") do
            if line.starts_with("DATA") then
                writer.write("354 go ahead\r\n")

                let text mut = reader.read_line() ?? "."

                while text !~ "." do
                    let shown =
                        text.starts_with("Subject:") \/
                        !text.contains(':')

                    if shown /\ text.length > 0 then
                        write_line("  | {text}")
                    fi

                    text = reader.read_line() ?? "."
                od
            elif
                line.starts_with("MAIL") \/
                line.starts_with("RCPT")
            then
                write_line("  {line}")
            fi

            writer.write("250 ok\r\n")
            line = reader.read_line() ?? "QUIT"
        od

        writer.write("221 bye\r\n")
    si)

    let port =
        if let bound: IPEndPoint = listener.local_endpoint then
            bound.port
        else
            throw System.Exception(
                "the listener has no address"
            )
        fi

    write_line("sending:")

    send_email(
        "127.0.0.1",
        port,
        "sender@example.com",
        "recipient@example.com",
        "copy@example.com",
        "Rosetta Code",
        "Hello from the task."
    )

    write_line("sent")
si
