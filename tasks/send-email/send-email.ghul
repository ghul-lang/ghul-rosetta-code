use default
use System.Net.Mail.MailAddress
use System.Net.Mail.MailMessage
use System.Net.Mail.SmtpClient

// The task: send a message through an SMTP server. SmtpClient throws an
// SmtpException naming the server's reply when anything is refused, and
// returns quietly once the server has accepted the message.
send_email(
    server: string,
    port: int,
    from: string,
    to: string,
    cc: string,
    subject: string,
    text: string
) is
    let message = MailMessage(
        MailAddress(from),
        MailAddress(to)
    )

    message.cc.add(cc)
    message.subject = subject
    message.body = text

    SmtpClient(server, port).send(message)
si

send_email(
    "smtp.example.com",
    587,
    "sender@example.com",
    "recipient@example.com",
    "copy@example.com",
    "Rosetta Code",
    "Hello from the task."
)
