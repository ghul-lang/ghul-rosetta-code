use default
use System.Reflection
use System.Reflection.BindingFlags

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `=~` compares values (structural equality) - `==` compares identity
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.
// `=~` compares values (structural equality); `==` compares identity.

bloop: int
blip: int
name: string

let runtime = System.Environment.version

write_line("runtime major version: {runtime.major}")

if runtime.major < 8 then
    write_line("too old")

    System.Environment.exit(1)
fi

bloop = -17
blip = 25
name = "not an integer"

let assembly = System.Reflection.Assembly.get_entry_assembly()!
let visible = BindingFlags.STATIC | BindingFlags.PUBLIC
let flags = visible | BindingFlags.NON_PUBLIC

let integers =
    assembly.get_types()
        |> flat_map(t => pipe(t.get_fields(flags)))
        |> filter(f => f.field_type == typeof int)
        |> list()

let has_bloop = integers |> any(f => f.name.trim_start(['$']) =~ "bloop")
let abs = (typeof System.Math).get_method("Abs", [typeof int])

write_line("bloop exists: {has_bloop}")
write_line("abs exists: {abs?}")

if has_bloop /\ abs? then
    write_line("abs(bloop) = {abs.invoke(null, [cast object(bloop)])}")
fi

let values = integers |> map(f => cast int(f.get_value(null)!))

let named = integers |> map(f => f.name.trim_start(['$'])) |> sort()

write_line("integer globals: {named |> join(", ")}")
write_line("their sum: {values |> sum()}")
