use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `yield` makes the function a generator: it returns a lazy `T{}`.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

leonardo(first: int, second: int, add: int) -> int{} is
    let previous mut = first
    let current mut = second

    do
        yield previous

        let following = previous + current + add

        previous = current
        current = following
    od
si

show(first: int, second: int, add: int) is
    let terms = leonardo(first, second, add) |> take(25) |> map(t => "{t}")

    write_line("L(0)={first} L(1)={second} add={add}")
    write_line("  {terms |> join(" ")}")
si

show(1, 1, 1)
show(0, 1, 0)
