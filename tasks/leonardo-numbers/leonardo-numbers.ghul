use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

leonardo(first: int, second: int, add: int) -> int{} is
    let previous mut = first
    let current mut = second

    do
        yield previous

        let following = previous + current + add

        previous = current
        current = following
    od
si

show(first: int, second: int, add: int) is
    let terms = leonardo(first, second, add) |> take(25) |> map(t => "{t}")

    write_line("L(0)={first} L(1)={second} add={add}")
    write_line("  {terms |> join(" ")}")
si

show(1, 1, 1)
show(0, 1, 0)
