use default
use System.Math.*

non_square(n: int) -> int =>
    n + int(floor(0.5 + sqrt(double(n))))

is_square(n: int) -> bool =>
    let root = int(sqrt(double(n))) in
    root * root == n \/ (root + 1) * (root + 1) == n

write_line(1::22 |> map(non_square) |> join(" "))

let squares = 1..1_000_000 |> count(n => is_square(non_square(n)))

write_line("squares for n below one million: {squares}")
