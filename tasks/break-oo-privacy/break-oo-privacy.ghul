use default
use System.Reflection.BindingFlags

class SAFE(combination: string private, contents: string) is
    open(attempt: string) -> string =>
        if attempt =~ _combination then contents else "it stays shut" fi
si

let safe = SAFE("1234", "a bar of gold")

write_line(safe.open("0000"))

let hidden = BindingFlags.INSTANCE | BindingFlags.NON_PUBLIC
let fields =
    safe.get_type().get_fields(hidden)
        |> filter(f => !f.name.starts_with('$'))

for member in fields do
    write_line("{member.name} = {member.get_value(safe)}")
od

let combination = safe.get_type()
    .get_field("_combination", hidden)!
    .get_value(safe)

write_line(safe.open("{combination}"))

let contents = safe.get_type().get_property("contents")!

contents.set_value(safe, cast object("a bag of sand"))

write_line(safe.open("{combination}"))
