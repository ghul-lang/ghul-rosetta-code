use default

categorise(p: int) -> int memo =>
    1 +
    (
        factorize(p + 1)
            |> map(f => f.prime)
            |> filter(* > 3)
            |> map(categorise)
            |> max() ?? 0
    )

let first_million = primes() |> take(1_000_000) |> memo()

write_line("First 200 primes:")

for
    (number, group) in first_million
        |> take(200)
        |> group_by(categorise)
do
    write_line("\nCategory {number}:")
    write_line("{group}")
od

write_line("\nFirst million primes:\n")

for
    (number, group) in first_million
        |> group_by(categorise)
do
    let first = group[0], last = group[group.count - 1]

    write_line(
        "Category {number,2}: first {first,8}  last {last,8}  "
        "count {group.count,6}"
    )
od
