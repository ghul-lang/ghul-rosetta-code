use default

use System.Numerics.Complex

use Matrix = List[List[Complex]]

conjugate_transpose(m: Matrix) -> Matrix =>
    0..m[0].count
        |> map(j =>
            0..m.count
                |> map(i => Complex.conjugate(m[i][j]))
                |> collect())
        |> collect()

*(a: Matrix, b: Matrix) -> Matrix =>
    0..a.count
        |> map(i =>
            0..b[0].count
                |> map(j =>
                    0..b.count
                        |> map(k => a[i][k] * b[k][j])
                        |> reduce(Complex.zero, * + *))
                |> collect())
        |> collect()

≈(a: Matrix, b: Matrix) -> bool =>
    0..a.count
        |> all(i =>
            0..a[i].count
                |> all(j => Complex.abs(a[i][j] - b[i][j]) < 1.0e-12))

identity(n: int) -> Matrix =>
    0..n
        |> map(i =>
            0..n
                |> map(j => if i == j then Complex.one else Complex.zero fi)
                |> collect())
        |> collect()

show(c: Complex) -> string =>
    let sign = if c.imaginary < 0.0 then "-" else "+" fi in
    let size = double.abs(c.imaginary) in
    "{c.real:0.####}{sign}{size:0.####}i"

print(m: Matrix) =>
    for row in m do
        write_line(row |> map(c => "{show(c),12}") |> join(""))
    od

let r = double.sqrt(0.5)

let examples = [
    [
        [Complex(3.0, 0.0), Complex(2.0, 1.0)],
        [Complex(2.0, -1.0), Complex(1.0, 0.0)]
    ],
    [
        [Complex.one, Complex.one, Complex.zero],
        [Complex.zero, Complex.one, Complex.one],
        [Complex.one, Complex.zero, Complex.one]
    ],
    [
        [Complex(r, 0.0), Complex(r, 0.0), Complex.zero],
        [Complex(0.0, r), Complex(0.0, -r), Complex.zero],
        [Complex.zero, Complex.zero, Complex(0.0, 1.0)]
    ]
]

for m in examples do
    let h = conjugate_transpose(m)

    write_line("matrix:")
    print(m)
    write_line("conjugate transpose:")
    print(h)
    write_line("Hermitian: {h ≈ m}")
    write_line("normal:    {h * m ≈ m * h}")
    write_line("unitary:   {h * m ≈ identity(m.count)}")
    write_line("")
od
