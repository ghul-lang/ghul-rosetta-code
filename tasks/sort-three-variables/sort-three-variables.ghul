use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

sort_three[T: Ghul.Comparable[T]](x: T ref, y: T ref, z: T ref) is
    let sorted = [x!, y!, z!] |> sort() |> list()

    x! = sorted[0]
    y! = sorted[1]
    z! = sorted[2]
si

let x mut = "lions, tigers, and"
let y mut = "bears, oh my!"
let z mut = "(from the \"Wizard of OZ\")"

sort_three(x ref, y ref, z ref)

write_line("x = {x}\ny = {y}\nz = {z}")
write_line("")

let a mut = 77444
let b mut = -12
let c mut = 0

sort_three(a ref, b ref, c ref)

write_line("x = {a,6}\ny = {b,6}\nz = {c,6}")
