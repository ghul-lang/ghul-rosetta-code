use default
use Raster.ANIMATION
use Raster.IMAGE
use Raster.SHAPES

use Point = (x: double, y: double, z: double)

let size = 180
let frames = 40

dot(a: Point, b: Point) -> double => a.x * b.x + a.y * b.y + a.z * b.z

scale(p: Point, k: double) -> Point => (
    x = p.x * k,
    y = p.y * k,
    z = p.z * k
)

let up = scale((x = 1.0, y = 1.0, z = 1.0), 1.0 / sqrt(3.0))
let across = scale((x = 1.0, y = -1.0, z = 0.0), 1.0 / sqrt(2.0))
let toward = (
    x = up.y * across.z - up.z * across.y,
    y = up.z * across.x - up.x * across.z,
    z = up.x * across.y - up.y * across.x
)

let corners =
    (0..8)
        |> map(i => (
            x = if i & 1 == 0 then -1.0 else 1.0 fi,
            y = if i & 2 == 0 then -1.0 else 1.0 fi,
            z = if i & 4 == 0 then -1.0 else 1.0 fi
        ))
        |> list()

let faces = [
    (corners = [0, 2, 6, 4], normal = (x = -1.0, y = 0.0, z = 0.0)),
    (corners = [1, 3, 7, 5], normal = (x = 1.0, y = 0.0, z = 0.0)),
    (corners = [0, 1, 5, 4], normal = (x = 0.0, y = -1.0, z = 0.0)),
    (corners = [2, 3, 7, 6], normal = (x = 0.0, y = 1.0, z = 0.0)),
    (corners = [0, 1, 3, 2], normal = (x = 0.0, y = 0.0, z = -1.0)),
    (corners = [4, 5, 7, 6], normal = (x = 0.0, y = 0.0, z = 1.0))
]

let light = scale((x = -0.5, y = 0.8, z = 0.4), 1.0 / sqrt(1.05))

turned(p: Point, angle: double) -> Point =>
    let
        a = dot(p, across),
        b = dot(p, toward)
    in
        (
            x = a * cos(angle) + b * sin(angle),
            y = dot(p, up),
            z = b * cos(angle) - a * sin(angle)
        )

draw(image: IMAGE, angle: double) is
    image.clear(250ub, 250ub, 247ub)

    let shapes = SHAPES()
    let outlines = LIST()

    for face in faces do
        let normal = turned(face.normal, angle)

        if normal.z > 0.0 then
            let outline =
                face.corners
                    |> map(i => turned(corners[i], angle))
                    |> map(p => (x = p.x, y = p.y))
                    |> list()

            let bright = 0.3 + 0.7 * max(0.0, dot(normal, light))

            shapes.add(
                outline,
                ubyte(70.0 * bright),
                ubyte(130.0 * bright),
                ubyte(210.0 * bright)
            )

            outlines.add(outline)
        fi
    od

    image.fill(shapes)

    image.color(20ub, 30ub, 50ub)
    image.stroke(1.5)

    for outline in outlines do
        image.line(outline ++ [outline[0]] |> list())
    od
si

let image = IMAGE(size, size)

image.view(-2.0, -2.0, 2.0, 2.0)

let animation = ANIMATION(size, size)

for frame in 0..frames do
    let turn = double(frame) / double(frames)
    let angle = 2.0 * pi / 3.0 * turn

    draw(image, angle)
    animation.add(image, 50)
od

write_line("{frames} frames, a third of a turn: the cube looks the same")
write_line("again after 120 degrees about its vertical diagonal")

animation.write("cube.png")

animation.show("cube.png")
