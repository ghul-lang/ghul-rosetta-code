use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity
// `if let` pattern-matches

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `if let` and `case ... when` pattern-match; `[x, ..rest]` matches a list.

first_different(text: string) -> int? =>
    1..text.length |> find(i => text[i] != text[0])

for
    text in [
        "", "   ", "2", "333", ".55", "tttTTT", "4444 444k"
    ]
do
    write_line("\"{text}\" has length {text.length}:")

    if let at = first_different(text) then
        let c = text[at]

        write_line(
            "    not all the same: '{c}' (0x{int(c):X2}) "
            "differs at position {at + 1}"
        )
    else
        write_line("    all the same")
    fi
od
