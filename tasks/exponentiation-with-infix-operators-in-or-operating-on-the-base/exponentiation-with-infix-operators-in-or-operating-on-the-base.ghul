use default

// A prefix operator applies to its operand before any infix operator
// does, so -x ** p raises -x to the power p.

let lines = [
    "x = {x,2}, p = {p}:  -x ** p = {-x ** p,4}  "
    "-(x) ** p = {-(x) ** p,4}  (-x) ** p = {(-x) ** p,4}  "
    "-(x ** p) = {-(x ** p),4}"
    for x in [-5, 5]
    for p in [2, 3]
]

lines |> each(write_line)
