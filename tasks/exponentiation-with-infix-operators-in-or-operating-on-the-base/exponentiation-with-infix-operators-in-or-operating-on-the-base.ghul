use default

// ghūl has no exponentiation operator, so this program declares one. A
// prefix operator applies to its operand before any infix operator does.

**(base: int, exponent: int) -> int =>
    repeat(base, exponent) |> product()

for x in [-5, 5] do
    for p in [2, 3] do
        let first = -x ** p, second = -(x) ** p
        let third = (-x) ** p, fourth = -(x ** p)

        write_line(
            "x = {x,2}, p = {p}:  -x ** p = {first,4}  "
            "-(x) ** p = {second,4}  (-x) ** p = {third,4}  "
            "-(x ** p) = {fourth,4}"
        )
    od
od
