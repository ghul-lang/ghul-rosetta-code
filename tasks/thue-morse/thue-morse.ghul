use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

complement(text: string) -> string =>
    text |> map(digit => if digit == '0' then "1" else "0" fi) |> join("")

stream("0", step => step || "{step}{complement(step)}")
    |> take(7)
    |> each(step => write_line(step))
