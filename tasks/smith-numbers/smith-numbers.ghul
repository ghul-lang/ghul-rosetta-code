use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

is_smith(n: int) -> bool =>
    let factors = prime_factors(n) in
    factors.count > 1 /\ (factors |> sum_by(digit_sum)) == digit_sum(n)

let smith = (1..10_000) |> filter(is_smith) |> list()

write_line("{smith.count} Smith numbers below 10000:")

for row in smith |> chunk(12) do
    write_line(row |> map(n => "{n,5}") |> join(""))
od
