use default
use Raster.IMAGE

use POINT = (x: double, y: double)

let steps = 200

quadratic(a, b, c) =>
    (0..steps + 1)
        |> map(step => (
            let t = double(step) / double(steps)
            let u = 1.0 - t

            (
                x = u * u * a.x + 2.0 * u * t * b.x + t * t * c.x,
                y = u * u * a.y + 2.0 * u * t * b.y + t * t * c.y
            )
        ))
        |> list()

let start = (x = 20.0, y = 220.0)
let control = (x = 160.0, y = 10.0)
let finish = (x = 280.0, y = 180.0)

let image = IMAGE(300, 240)

image.color(190ub, 190ub, 190ub)
image.stroke(1.0)
image.line([start, control, finish])

image.color(0ub, 0ub, 160ub)
image.stroke(2.0)
image.line(quadratic(start, control, finish))

image.write("quadratic.png")

image.show("quadratic.png")
