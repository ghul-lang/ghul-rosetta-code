use default

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

let elements = [1, 2, 3, 4]

selected(mask: int) -> int[] =>
    (0..elements.count)
        |> filter(index => (mask & (1 << index)) != 0)
        |> map(index => elements[index])
        |> list()

continuous(chosen: int[]) -> bool =>
    chosen[chosen.count - 1] - chosen[0] + 1 == chosen.count

(1..(1 << elements.count))
    |> map(selected)
    |> filter(chosen => chosen.count > 1 /\ !continuous(chosen))
    |> map(chosen => chosen |> join())
    |> each(line => write_line(line))
