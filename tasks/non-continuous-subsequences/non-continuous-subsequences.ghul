use default

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

let elements = [1, 2, 3, 4]

selected(mask: int) -> int[] =>
    (0..elements.count)
        |> filter(index => (mask & (1 << index)) != 0)
        |> map(index => elements[index])
        |> list()

continuous(chosen: int[]) -> bool =>
    chosen[chosen.count - 1] - chosen[0] + 1 == chosen.count

(1..(1 << elements.count))
    |> map(selected)
    |> filter(chosen => chosen.count > 1 /\ !continuous(chosen))
    |> map(chosen => chosen |> join())
    |> each(line => write_line(line))
