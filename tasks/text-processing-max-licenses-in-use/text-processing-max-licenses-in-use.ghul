use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `=~` compares values (structural equality) - `==` compares identity

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.
// `=~` compares values (structural equality); `==` compares identity.

let out mut = 0
let most mut = 0
let peaks = LIST()

for line in IO.File.read_all_lines("mlijobs.txt") do
    let fields = line |> words() |> list()
    let time = fields[3]

    if fields[1] =~ "OUT" then
        out = out + 1

        if out > most then
            most = out
            peaks.clear()
        fi

        if out == most then
            peaks.add(time)
        fi
    else
        out = out - 1
    fi
od

write_line("Maximum simultaneous licenses in use: {most}, at:")

for time in peaks do
    write_line("    {time}")
od
