namespace Hailstone is
    use default

    hailstone(n: long) -> List[long] is
        let terms = LIST([n])

        while terms[terms.count - 1] != 1L do
            let term = terms[terms.count - 1]

            let next =
                if term % 2L == 0L then term / 2L else 3L * term + 1L fi

            terms.add(next)
        od

        terms
    si

    entry() is
        let sequence = hailstone(27L)
        let first = sequence |> take(4) |> join()
        let last = sequence |> skip(sequence.count - 4) |> join()

        write_line(
            "hailstone(27) has {sequence.count} elements: "
            "{first}, ..., {last}")

        let (start, length) =
            1..100_000
                |> map(n => (n, length = hailstone(long(n)).count))
                |> max_by((_, length) => length)!

        write_line(
            "{start} has the longest sequence below 100,000: "
            "{length} elements")
    si
si
