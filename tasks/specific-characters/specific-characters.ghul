use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

counts(s: string) -> Map[char, int] => s |> frequencies()

show(strings: string[]) is
    let tallies = strings |> map(counts) |> list()
    let specific = LIST()
    let others = LIST()

    for i in 0..strings.count do
        let chars = tallies[i].keys |> list()
        let elsewhere =
            c =>
                0..strings.count
                    |> any(j => j != i /\ tallies[j].contains_key(c))
        let passes =
            chars |> count(c => tallies[i][c] == 2 /\ !elsewhere(c))

        specific.add(passes)
        others.add(chars.count - passes)
    od

    write_line("[{strings |> map(s => "\"{s}\"") |> join(", ")}]")
    write_line("    specific: [{specific |> join(", ")}]")
    write_line("    not:      [{others |> join(", ")}]")
si

show(["ahwiueshaiu", "ajxxfioaaf", "ajrdsfroiwr"])
show(["aabbcc", "abcdd", "eeff"])
