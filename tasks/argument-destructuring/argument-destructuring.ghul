use default

use Rgb = (int, int, int)

greet((greeting, name): (string, string)) -> string =>
    "{greeting}, {name}!"

volume([width, height, depth]: int[]) -> int =>
    width * height * depth

first_three([a, b, c, ..]: int{}) -> string =>
    "{a}, {b}, {c}, ..."

label(
    (name, [x, y], (r, g, b)): (string, int[], Rgb)
) -> string => "{name} at ({x}, {y}) in #{r:X2}{g:X2}{b:X2}"

apply[T.., U](f: (T..) -> U, arguments: T..) -> U =>
    f(arguments)

cuboid(width: int, height: int, depth: int) -> int =>
    width * height * depth

join_words(first: string, second: string) -> string =>
    "{first} {second}"

let words = ("hello", "world")
write_line(greet(words))

let sides = [2, 3, 4]
write_line("{volume(sides)}")

let squares = from(1) |> map(n => n * n)
write_line(first_three(squares))

let marker = ("home", [10, 20], (255, 128, 0))
write_line(label(marker))

let box = (width = 2, height = 3, depth = 4)
write_line(apply(join_words, words))
write_line("{apply(cuboid, box)}")
write_line("{apply(cuboid, 5, 6, 7)}")
