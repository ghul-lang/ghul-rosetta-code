use default

// `T[]` is the read-only list trait - elements can be read by index
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`

strip_comment(line: string, markers: char[]) -> string =>
    let cut =
        markers
            |> map(line.index_of(*))
            |> filter(i => i >= 0)
            |> min() ?? line.length
    in
    line[0..cut].trim()

let markers = ['#', ';']

write_line(strip_comment("apples, pears # and bananas", markers))
write_line(strip_comment("apples, pears ; and bananas", markers))
