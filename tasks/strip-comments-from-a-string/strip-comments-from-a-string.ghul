use default

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `*` as an argument leaves that parameter open: partial application.

strip_comment(line: string, markers: char[]) -> string =>
    let cut =
        markers
            |> map(line.index_of(*))
            |> filter(i => i >= 0)
            |> min() ?? line.length
    in
    line[0..cut].trim()

let markers = ['#', ';']

write_line(strip_comment("apples, pears # and bananas", markers))
write_line(strip_comment("apples, pears ; and bananas", markers))
