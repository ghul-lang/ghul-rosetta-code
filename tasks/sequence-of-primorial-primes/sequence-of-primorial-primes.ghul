use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

let found = LIST()
let primorial mut = 1n
let index mut = 0

for p in primes() do
    primorial = primorial * bigint(p)
    index = index + 1

    let below = is_prime(primorial - 1n)

    if below \/ is_prime(primorial + 1n) then
        found.add(index)

        if found.count == 15 then
            break
        fi
    fi
od

write_line(found |> join(" "))
