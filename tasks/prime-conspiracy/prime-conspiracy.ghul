use default

primes(limit: int) -> int{} is
    let composite = repeat(false, limit) |> collect_mutable()

    for n in 2..limit do
        if !composite[n] then
            yield n

            if n <= limit / n then
                let multiple mut = n * n

                while multiple < limit do
                    composite[multiple] = true
                    multiple = multiple + n
                od
            fi
        fi
    od
si

let count = 1_000_000
let last_digits =
    primes(15_500_000) |> take(count) |> map(* % 10) |> collect()

let transitions =
    1..count
        |> map(i => last_digits[i - 1] * 10 + last_digits[i])
        |> group_by(key => key)
        |> map(group => (group.key, group.value.count))
        |> collect_map()

write_line("{count:N0} first primes. "
    "Transitions prime % 10 -> next-prime % 10.")

for key in transitions.keys |> sort() do
    let frequency =
        100.0 * double(transitions[key]) / double(count)

    write_line(
        "{key / 10} -> {key % 10} count: {transitions[key],6} "
        "frequency: {frequency:F2} %")
od
