use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `MAP()` builds its collection eagerly
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`

let count = 1_000_000
let last_digits = primes() |> take(count) |> map(* % 10) |> list()

let transitions =
    1..count
        |> map(i => last_digits[i - 1] * 10 + last_digits[i])
        |> group_by(key => key)
        |> map(group => (group.key, group.value.count))
        |> MAP()

write_line(
    "{count:N0} first primes. "
    "Transitions prime % 10 -> next-prime % 10."
)

for key in transitions.keys |> sort() do
    let frequency = 100.0 * double(transitions[key]) / double(count)

    write_line(
        "{key / 10} -> {key % 10} count: {transitions[key],6} "
        "frequency: {frequency:F2} %"
    )
od
