use default

let limit = 1000000

let composite = repeat(false, limit + 1) |> collect_mutable()

let root mut = 2

while root * root <= limit do
    if !composite[root] then
        let multiple mut = root * root

        while multiple <= limit do
            composite[multiple] = true
            multiple = multiple + root
        od
    fi

    root = root + 1
od

prime(text: string) -> bool => (
    let value = int.parse(text)

    value >= 2 /\ !composite[value]
)

left_truncatable(text: string) -> bool =>
    0..text.length |> all(start => prime(text[start..<0]))

right_truncatable(text: string) -> bool =>
    1::text.length |> all(end => prime(text[0..end]))

let candidates =
    (2..(limit + 1))
        |> filter(n => !composite[n] /\ !"{n}".contains('0'))

let largest_left =
    candidates |> filter(n => left_truncatable("{n}")) |> max()!

let largest_right =
    candidates
        |> filter(n => right_truncatable("{n}"))
        |> max()!

write_line(
    "largest left-truncatable prime below 1000000: {largest_left}"
)
write_line(
    "largest right-truncatable prime below 1000000: "
    "{largest_right}"
)
