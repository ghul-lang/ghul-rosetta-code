use Raster.ANIMATION
use Raster.IMAGE
use Ghul.Math

use STATE = (angle: double, rate: double)

let gravity = 9.81
let length = 1.0
let swing = 1.0

let width = 240
let height = 180

let frames = 40
let substeps = 25

advance(state, dt) =>
    let rate = state.rate - dt * gravity / length * sin(state.angle) in
    (angle = state.angle + dt * rate, rate = rate)

quarter_period(dt) => (
    let state mut = (angle = swing, rate = 0.0)
    let elapsed mut = 0.0

    while state.angle > 0.0 do
        state = advance(state, dt)
        elapsed = elapsed + dt
    od

    elapsed
)

draw(image, angle) is
    let x = length * sin(angle)
    let y = -length * cos(angle)

    image.clear()

    image.color(140ub, 140ub, 150ub)
    image.stroke(2.0)
    image.line(0.0, 0.0, x, y)

    image.color(60ub, 60ub, 70ub)
    image.dot(0.0, 0.0, 5.0)

    image.color(200ub, 50ub, 40ub)
    image.dot(x, y, 12.0)
si

// The pendulum passing vertical is easy to detect and comes a
// quarter of a period after release, so that interval is timed and
// scaled to a frame time that divides the period exactly.
let period = 4.0 * quarter_period(0.0002)

let tick = period / double(frames * substeps)
let delay = int(round(1000.0 * period / double(frames)))

let image = IMAGE(width, height)

image.view(-1.05, -1.15, 1.05, 0.25)

let animation = ANIMATION(width, height)

let state mut = (angle = swing, rate = 0.0)

for _ in 0..frames do
    draw(image, state.angle)

    animation.add(image, delay)

    for _ in 0..substeps do
        state = advance(state, tick)
    od
od

animation.write("pendulum.png")

animation.show("pendulum.png")
