use default

class FIELD(name: string, offset: int, width: int)

union Diagram is
    HEADER(fields: List[FIELD], width: int) default
    REJECTED(why: string)
si

cells(row: string) -> List[string]? is
    let trimmed = row.trim()

    if trimmed.length < 2 \/
        trimmed[0] != '|' \/
        trimmed[trimmed.length - 1] != '|'
    then
        return null
    fi

    trimmed[1..<1].split(['|'])
si

read(diagram: string) -> Diagram is
    let fields = LIST()
    let width mut = 0
    let at mut = 0

    for row in diagram.split(['\n']) do
        let trimmed = row.trim()

        if trimmed.length == 0 \/ !trimmed.contains('|') then
            continue
        fi

        if let columns = cells(row) then
            for cell in columns do
                if (cell.length + 1) % 3 != 0 then
                    return Diagram.REJECTED(
                        "a cell {cell.length} wide is not a whole number "
                        "of bits")
                fi

                fields.add(FIELD(cell.trim(), at, (cell.length + 1) / 3))

                at = at + (cell.length + 1) / 3
            od

            if width == 0 then
                width = at
            elif at % width != 0 then
                return Diagram.REJECTED(
                    "a row of {at % width} bits among rows of {width}")
            fi
        else
            return Diagram.REJECTED("a row not bounded by '|': {trimmed}")
        fi
    od

    if width != 8 /\ width != 16 /\ width != 32 /\ width != 64 then
        return Diagram.REJECTED("a header {width} bits wide")
    fi

    Diagram.HEADER(fields, width)
si

bits_of(message: string) -> string =>
    string(
        message
            |> flat_map(
                c =>
                    let nibble = System.Convert.to_int32("{c}", 16) in
                    0..4
                        |> map(
                            b =>
                                if (nibble >> (3 - b)) & 1 == 1 then '1'
                                else '0'
                                fi))
            |> collect())

let rfc1035 =
    "+--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+\n"
    "|                      ID                       |\n"
    "+--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+\n"
    "|QR|   Opcode  |AA|TC|RD|RA|   Z    |   RCODE   |\n"
    "+--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+\n"
    "|                    QDCOUNT                    |\n"
    "+--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+\n"
    "|                    ANCOUNT                    |\n"
    "+--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+\n"
    "|                    NSCOUNT                    |\n"
    "+--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+\n"
    "|                    ARCOUNT                    |\n"
    "+--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+"

let message = "78477bbf5496e12e1bf169a4"

case read(rfc1035)
when header: Diagram.HEADER then
    write_line("{header.fields.count} fields, {header.width} bits a row")
    write_line()

    let bits = bits_of(message)

    write_line("name      bits  binary            value")

    for part in header.fields do
        let cut = bits[part.offset..part.offset + part.width]

        write_line(
            "{part.name,-9} {part.width,4}  {cut,-16}  "
            "{System.Convert.to_int32(cut, 2)}")
    od
when rejected: Diagram.REJECTED then
    write_line("rejected: {rejected.why}")
esac

write_line()

let bad =
    "+--+--+--+--+\n"
    "|  ID   |X |\n"
    "+--+--+--+--+"

case read(bad)
when header: Diagram.HEADER then
    write_line("{header.fields.count} fields")
when rejected: Diagram.REJECTED then
    write_line("rejected: {rejected.why}")
esac
