use default

abundant_odd(start: long) -> long{} =>
    from(start, 2L) |> filter(n => divisor_sum(n) > 2L * n)

show(n: long) =>
    let sum = divisor_sum(n) - n in
    write_line("{n,13:N0}  proper divisor sum {sum,13:N0}")

write_line("The first 25 abundant odd numbers:")

abundant_odd(3L) |> take(25) |> each(show)

write_line("\nThe one thousandth:")

show(abundant_odd(3L) |> skip(999) |> first()!)

write_line("\nThe first above one billion:")

show(abundant_odd(1_000_000_001L) |> first()!)
