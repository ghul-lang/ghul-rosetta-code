use default

factorial_primes() -> (n: int, sign: int, value: bigint){} is
    let fact mut = 1n
    let n mut = 1

    do
        fact = fact * bigint(n)

        if is_prime(fact - 1n) then
            yield (n = n, sign = -1, value = fact - 1n)
        fi

        if is_prime(fact + 1n) then
            yield (n = n, sign = 1, value = fact + 1n)
        fi

        n = n + 1
    od
si

for entry in factorial_primes() |> take(10) do
    let op = if entry.sign < 0 then "-" else "+" fi

    write_line("{entry.n}! {op} 1 = {entry.value}")
od
