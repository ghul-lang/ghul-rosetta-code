use default
use IO.Std.read_line

write_line("Enter the maximum:")

let max_n = int.parse(read_line()!)
let factors = LIST()

write_line("Enter three factors, each a number and its word:")

for _ in 0..3 do
    let parts = read_line()!.split([' '])

    factors.add((factor = int.parse(parts[0]), word = parts[1]))
od

for n in 1::max_n do
    let label =
        [f.word for f in factors if n % f.factor == 0] |> join("")

    write_line(if label.length == 0 then "{n}" else label fi)
od
