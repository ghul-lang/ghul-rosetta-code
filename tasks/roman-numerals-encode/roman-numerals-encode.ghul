use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `if let` pattern-matches

let numerals = [
    (1000, "M"), (900, "CM"), (500, "D"), (400, "CD"), (100, "C"),
    (90, "XC"), (50, "L"), (40, "XL"), (10, "X"), (9, "IX"),
    (5, "V"), (4, "IV"), (1, "I")
]

roman(n: int) -> string =>
    if let (value, symbol) = numerals |> find(((value, _)) => value <= n) then
        "{symbol}{roman(n - value)}"
    else
        ""
    fi

for n in [1990, 2008, 1666, 4, 9, 3999] do
    write_line("{n,4} = {roman(n)}")
od
