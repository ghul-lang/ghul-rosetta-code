use default

// pass p toggles every p-th door, so a door ends open when an odd number of
// passes have touched it
passes_touching(door: int) -> int =>
    1::100 |> count(pass => door % pass == 0)

let open_doors = 1::100 |> filter(door => passes_touching(door) % 2 == 1)

write_line("open doors: {$open_doors}")
