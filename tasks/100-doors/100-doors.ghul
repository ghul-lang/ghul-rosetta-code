use default

// `T[]` is the read-only list trait - elements can be read by index
// `==` compares identity
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read

toggle(doors: bool[], pass: int) -> bool[] => [
    if (i + 1) % pass == 0 then !doors[i] else doors[i] fi
    for i in 0..100
]

let closed = repeat(false, 100) |> list()
let doors = 1::100 |> reduce(closed, toggle)

let open_doors = 1::100 |> filter(door => doors[door - 1])

write_line("open doors: {$open_doors}")
