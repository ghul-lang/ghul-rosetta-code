use default

// one pass toggles every door whose number is a multiple of the pass
toggle(doors: bool[], pass: int) -> bool[] =>
    [if (i + 1) % pass == 0 then !doors[i] else doors[i] fi for i in 0..100]

let closed = repeat(false, 100) |> collect()
let doors = 1::100 |> reduce(closed, toggle)

let open_doors = 1::100 |> filter(door => doors[door - 1])

write_line("open doors: {$open_doors}")
