use default

class MONEY(cents: bigint) is
    +(other: MONEY) -> MONEY => MONEY(cents + other.cents)

    *(quantity: bigint) -> MONEY => MONEY(cents * quantity)

    taxed(rate_per_10000: bigint) -> MONEY =>
        let
            raw = cents * rate_per_10000,
            rounded = (raw + 5000n) / 10000n
        in
            MONEY(rounded)

    to_string() -> string =>
        let
            whole = cents / 100n,
            part = cents % 100n
        in
            "{whole}.{part,2:00}"
si

dollars(units: int, cents: int) -> MONEY =>
    MONEY(bigint(units) * 100n + bigint(cents))

let hamburger = dollars(5, 50)
let milkshake = dollars(2, 86)

let burgers = 4_000_000_000_000_000n
let shakes = 2n

let before_tax = hamburger * burgers + milkshake * shakes
let tax = before_tax.taxed(765n)
let total = before_tax + tax

write_line("before tax: {before_tax,20}")
write_line("tax:        {tax,20}")
write_line("total:      {total,20}")
