use default
use System.Runtime.InteropServices.Marshal
use System.Runtime.InteropServices.LayoutKind

@System.Runtime.InteropServices.StructLayout(LayoutKind.SEQUENTIAL)
struct FLAGS(
    carry: byte field,
    zero: byte field,
    interrupt: byte field,
    decimal_mode: byte field
)

@System.Runtime.InteropServices.StructLayout(LayoutKind.SEQUENTIAL)
struct HEADER(
    kind: int field,
    length: short field,
    checksum: byte field
)

layout[T: struct](name: string) is
    write_line("{name}: {Marshal.size_of[T]()} bytes")

    for member in (typeof T).get_fields() do
        let offset = Marshal.offset_of[T](member.name)

        write_line("  {member.name,-14} at {offset}")
    od
si

layout[FLAGS]("FLAGS")
layout[HEADER]("HEADER")

let flags = FLAGS(1b, 0b, 1b, 0b)

write_line("carry is set: {flags.carry == 1b}")
