use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `yield` makes the function a generator: it returns a lazy `T{}`.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

let alphabet =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

decode(text: string) -> ubyte{} is
    let buffer mut = 0
    let bits mut = 0

    for c in text do
        let value = alphabet.index_of(c)

        if value >= 0 then
            buffer = ((buffer << 6) | value) & 0xFFFF
            bits = bits + 6

            if bits >= 8 then
                bits = bits - 8

                yield ubyte((buffer >> bits) & 0xFF)
            fi
        fi
    od
si

let encoded =
    "VG8gZXJyIGlzIGh1bWFuLCBidXQgdG8gcmVhbGx5IGZvdWwgdGhpbmdzIHVwIHlvdSBu"
    "ZWVkIGEgY29tcHV0ZXIuCiAgICAtLSBQYXVsIFIuIEVocmxpY2g="

let bytes = encoded |> decode() |> ARRAY()

write_line(System.Text.Encoding.utf8.get_string(bytes))
