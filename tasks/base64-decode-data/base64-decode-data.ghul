use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `ARRAY[T]` is a fixed-size, read-only array
// `|> ARRAY()` reads the whole sequence into a new `ARRAY`
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

let alphabet =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

decode(text: string) -> ubyte{} is
    let buffer mut = 0
    let bits mut = 0

    for c in text do
        let value = alphabet.index_of(c)

        if value >= 0 then
            buffer = ((buffer << 6) | value) & 0xFFFF
            bits = bits + 6

            if bits >= 8 then
                bits = bits - 8

                yield ubyte((buffer >> bits) & 0xFF)
            fi
        fi
    od
si

let encoded =
    "VG8gZXJyIGlzIGh1bWFuLCBidXQgdG8gcmVhbGx5IGZvdWwgdGhpbmdzIHVwIHlvdSBu"
    "ZWVkIGEgY29tcHV0ZXIuCiAgICAtLSBQYXVsIFIuIEVocmxpY2g="

let bytes = encoded |> decode() |> ARRAY()

write_line(System.Text.Encoding.utf8.get_string(bytes))
