use default

dimensions() -> (width: int, height: int)? =>
    if IO.Std.is_output_redirected then
        null
    else
        let size = (
            width = IO.Std.window_width,
            height = IO.Std.window_height
        )
        in
        if size.width > 0 /\ size.height > 0 then
            size
        else
            null
        fi
    fi

if let size = dimensions() then
    write_line("{size.width} columns by {size.height} rows")
else
    write_line(
        "standard output has no terminal dimensions to read"
    )
fi
