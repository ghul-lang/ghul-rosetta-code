use IO.Std.write_line
use System.Numerics.INumber
use System.Numerics.IAdditionOperators.`+

accumulator[T: INumber[T]](initial: T) -> T -> T is
    let sum mut = initial

    return value => (
        sum = sum + value
        sum
    )
si

// int
let x = accumulator(1)
x(5)
accumulator(3)
write_line(x(2))

// double
let y = accumulator(1.0)
y(5.0)
accumulator(3.0)
write_line(y(2.3))

// bigint
let z = accumulator(1n)
z(123456789012345678901234567890n)
write_line(z(1n))
