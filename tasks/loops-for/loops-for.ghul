use default
use IO.Std.write

for row in 1::5 do
    for _ in 1::row do
        write("*")
    od

    write_line()
od

write_line()

for row in 1::5 do
    write_line(repeat('*', row) |> string())
od

write_line()

let rows = [['*' for _ in 1::row] |> string() for row in 1::5]

write_line(rows |> string("\n"))
