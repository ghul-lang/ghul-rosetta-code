use Raster
use Ghul.Math

let order = 4
let step = 8.0

let diagonal = step * sqrt(2.0)

let image = IMAGE(540, 540)
let pen = TURTLE(image)

bend() -> void is
    pen.forward(step)
    pen.turn(45.0)
    pen.forward(diagonal)
    pen.turn(45.0)
si

fold() -> void is
    pen.forward(step)
    pen.turn(-90.0)
    pen.forward(step)
    pen.turn(-90.0)
si

curve(n: int) is
    if n > 0 then
        curve(n - 1)
        bend()
        curve(n - 1)
        fold()
        curve(n - 1)
        bend()
        curve(n - 1)
    fi
si

image.view(0.0, 0.0, 540.0, 540.0)
image.color(0ub, 0ub, 160ub)
image.stroke(1.2)

pen.move_to(266.0, 514.0)

pen.forward(step)
pen.turn(-90.0)
curve(order)
fold()
curve(order)
pen.forward(step)

image.write("sierpinski.png")

image.show("sierpinski.png")
