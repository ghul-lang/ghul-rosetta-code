use default
use Raster.IMAGE

use Circle = (x: double, y: double, r: double)
use Arc = (circle: Circle, from: double, to: double)

let circles: Circle[] = [
    (1.6417233788, 1.6121789534, 0.0848270516),
    (-1.4944608174, 1.2077959613, 1.1039549836),
    (0.6110294452, -0.6907087527, 0.9089162485),
    (0.3844862411, 0.2923344616, 0.2375743054),
    (-0.2495892950, -0.3832854473, 1.0845181219),
    (1.7813504266, 1.6178237031, 0.8162655711),
    (-0.1985249206, -0.8343333301, 0.0538864941),
    (-1.7011985145, -0.1263820964, 0.4776976918),
    (-0.4319462812, 1.4104420482, 0.7886291537),
    (0.2178372997, -0.9499557344, 0.0357871187),
    (-0.6294854565, -1.3078893852, 0.7653357688),
    (1.7952608455, 0.6281269104, 0.2727652452),
    (1.4168575317, 1.0683357171, 1.1016025378),
    (1.4637371396, 0.9463877418, 1.1846214562),
    (-0.5263668798, 1.7315156631, 1.4428514068),
    (-1.2197352481, 0.9144146579, 1.0727263474),
    (-0.1389358881, 0.1092805780, 0.7350208828),
    (1.5293954595, 0.0030278255, 1.2472867347),
    (-0.5258728625, 1.3782633069, 1.3495508831),
    (-0.1403562064, 0.2437382535, 1.3804956588),
    (0.8055826339, -0.0482092025, 0.3327165165),
    (-0.6311979224, 0.7184578971, 0.2491045282),
    (1.4685857879, -0.8347049536, 1.3670667538),
    (-0.6855727502, 1.6465021616, 1.0593087096),
    (0.0152957411, 0.0638919221, 0.9771215985)
]

let turn = 2.0 * pi

wrap(angle) => angle - turn * floor(angle / turn)

distance(a, b) =>
    sqrt((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y))

inside(c, others) =>
    others |> any(o => !(o =~ c) /\ distance(o, c) + c.r <= o.r)

on(c, angle) => (
    x = c.x + c.r * cos(angle),
    y = c.y + c.r * sin(angle)
)

covers(o, x, y) =>
    (x - o.x) * (x - o.x) + (y - o.y) * (y - o.y) < o.r * o.r

crossings(c: Circle, o: Circle) -> double{} is
    let d = distance(c, o)

    if d >= c.r + o.r \/ d <= abs(c.r - o.r) then
        return LIST()
    fi

    let base = atan2(o.y - c.y, o.x - c.x)
    let cosine = (c.r * c.r + d * d - o.r * o.r) / (2.0 * c.r * d)
    let spread = acos(cosine)

    [base - spread, base + spread]
si

outer_arcs(c: Circle, others: Circle[]) -> Arc{} is
    let angles = LIST(
        others
            |> filter(o => !(o =~ c))
            |> flat_map(crossings(c, *))
            |> map(wrap)
    )

    if angles.count == 0 then
        return [(circle = c, from = 0.0, to = 2.0 * pi)]
    fi

    angles.sort()
    angles.add(angles[0] + 2.0 * pi)

    (0..angles.count - 1)
        |> map(i => (circle = c, from = angles[i], to = angles[i + 1]))
        |> filter(arc =>
            let
                middle = (arc.from + arc.to) / 2.0,
                p = on(c, middle)
            in
                !(others |> any(o => !(o =~ c) /\ covers(o, p.x, p.y)))
        )
        |> list()
si

area_under(arc) =>
    let c = arc.circle in
    0.5 *
    (
        c.r * c.r * (arc.to - arc.from) +
        c.r * c.x * (sin(arc.to) - sin(arc.from)) -
        c.r * c.y * (cos(arc.to) - cos(arc.from))
    )

let all = LIST(circles)
let kept = all |> filter(c => !inside(c, all)) |> list()

let arcs = kept |> flat_map(outer_arcs(*, kept)) |> list()
let area = arcs |> sum_by(area_under)

let hidden = circles.count - kept.count

write_line("{circles.count} circles, {hidden} inside others")
write_line("the boundary is {arcs.count} arcs")
write_line("total area: {area:F8}")

let image = IMAGE(400, 400)

image.view(-3.2, -3.0, 3.4, 3.6)
image.clear(252ub, 250ub, 245ub)
image.color(150ub, 190ub, 230ub)

for c in circles do
    image.disc(c.x, c.y, c.r)
od

image.color(90ub, 130ub, 180ub)
image.stroke(0.8)

for c in circles do
    image.circle(c.x, c.y, c.r)
od

image.color(20ub, 50ub, 120ub)
image.stroke(2.0)

for arc in arcs do
    let c = arc.circle

    image.line(
        (0::32)
            |> map(i =>
                let t = double(i) / 32.0 in
                on(c, arc.from + (arc.to - arc.from) * t)
            )
            |> list()
    )
od

image.write("circles.png")

image.show("circles.png")
