use default

use IO.Path

// directive: #include "path", relative to the including file
// includes nest to any depth; an include cycle is an error

expand(path: string, active: List[string]) -> string{} is
    let full = Path.get_full_path(path)

    assert !(active |> any(open => open =~ full))
    else "include cycle through {path}"

    let nested = active |> cat([full]) |> collect()

    for line in IO.File.read_all_lines(path) do
        let directive = line.trim()

        if directive.starts_with("#include ") then
            let target = directive.substring(9).trim().trim('"')
            let directory = Path.get_directory_name(path) ?? ""

            yield in expand(Path.combine(directory, target), nested)
        else
            yield line
        fi
    od
si

for line in expand("program.ghi", []) do
    write_line(line)
od
