use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `SET()` builds a collection eagerly

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `LIST()`, `SET()`, `MAP()` and `ARRAY()` build the collection eagerly.

isogram_order(word: string) -> int =>
    let counts =
        word
            |> group_by(c => c)
            |> map((_, occurrences) => occurrences.count)
            |> SET()
    in
    if counts.count == 1 then counts |> first()! else 0 fi

let words =
    IO.File.read_all_lines("unixdict.txt")
        |> map(word => word.to_lower())
        |> map(word => (word, n = isogram_order(word)))

let isograms =
    words
        |> filter((_, n) => n > 1)
        |> sort_by((word, n) => (-n, -word.length, word))

write_line("n-isograms with n > 1:")

for (word, n) in isograms do
    write_line("{n}  {word}")
od

let heterograms =
    words
        |> filter((word, n) => n == 1 /\ word.length > 10)
        |> sort_by((word, _) => (-word.length, word))

write_line("\nHeterograms with more than 10 letters:")

for (word, _) in heterograms do
    write_line(word)
od
