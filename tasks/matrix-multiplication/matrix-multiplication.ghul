use default
use Matrix = int[][]

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

multiply(left: Matrix, right: Matrix) -> Matrix =>
    assert left[0].count == right.count else "shapes do not conform" in
    left
        |> map(row =>
            0..right[0].count
                |> map(column =>
                    0..right.count
                        |> map(i => row[i] * right[i][column])
                        |> sum()
                )
                |> list()
        )
        |> list()

let a = [[1, 2], [3, 4], [5, 6]]
let b = [[1, 2, 3], [4, 5, 6]]

for row in multiply(a, b) do
    write_line(row |> join(" "))
od
