use default
use Matrix = int[][]

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

multiply(left: Matrix, right: Matrix) -> Matrix =>
    assert left[0].count == right.count else "shapes do not conform" in
    left
        |> map(row =>
            0..right[0].count
                |> map(column =>
                    0..right.count
                        |> map(i => row[i] * right[i][column])
                        |> sum()
                )
                |> list()
        )
        |> list()

let a = [[1, 2], [3, 4], [5, 6]]
let b = [[1, 2, 3], [4, 5, 6]]

for row in multiply(a, b) do
    write_line(row |> join(" "))
od
