    0.443D, -0.521D, -0.799D, 0.087D]

let dys = [
    0.136D, 0.717D, 0.459D, -0.225D, 1.392D, 0.385D, 0.121D, -0.395D,
    0.49D, -0.682D, -0.065D, 0.242D, -0.288D, 0.658D, 0.459D, 0.0D,
    0.426D, 0.205D, -0.765D, -2.188D, -0.742D, -0.01D, 0.089D, 0.208D,
