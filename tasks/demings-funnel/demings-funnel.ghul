drops(ds: List[double], rule: (double, double) -> double) -> List[double] is
    let landed = LIST[double]()
    let at mut = 0.0D

    for d in ds do
        landed.add(at + d)

        at = rule(at, d)
    od

    landed
si

mean(xs: List[double]) -> double => (xs |> sum()) / double(xs.count)

deviation(xs: List[double]) -> double is
    let m = mean(xs)

    sqrt(
        (xs |> sum_by(x => (x - m) * (x - m))) /
        double(xs.count))
si

let rules = [
    (name = "the funnel stays over the target", next = (at, d) => 0.0D),
    (name = "shift by the last miss", next = (at, d) => -d),
    (name = "shift from the target by the last miss",
     next = (at, d) => -(at + d)),
    (name = "follow the last marble", next = (at, d) => at + d)]

plot(
    image: IMAGE,
    at: int,
    xs: List[double],
    ys: List[double],
    reach: double
) is
    let width = double(image.width) / 2.0D
    let height = double(image.height) / 2.0D
    let left = double(at % 2) * width
    let top = double(at / 2) * height
    let middle = (x = left + width / 2.0D, y = top + height / 2.0D)
    let scale = (min(width, height) / 2.0D - 14.0D) / reach

    image.colour(170ub, 170ub, 170ub)
    image.stroke(1.0D)
    image.line([
        (x = left + 1.0D, y = top + 1.0D),
        (x = left + width - 1.0D, y = top + 1.0D),
        (x = left + width - 1.0D, y = top + height - 1.0D),
        (x = left + 1.0D, y = top + height - 1.0D),
        (x = left + 1.0D, y = top + 1.0D)])

    image.colour(210ub, 210ub, 210ub)
    image.line(left + 10.0D, middle.y, left + width - 10.0D, middle.y)
    image.line(middle.x, top + 10.0D, middle.x, top + height - 10.0D)

    image.colour(30ub, 70ub, 160ub)

    for i in 0..xs.count do
        image.dot(middle.x + xs[i] * scale, middle.y + ys[i] * scale, 2.0D)
    od

    image.colour(40ub, 40ub, 40ub)
    image.text(
        left + width / 2.0D, top + 22.0D, 15.0D,
        "rule {at + 1}", Anchor.CENTRE)
si

let image = IMAGE(640, 640)

let runs = rules
    |> map(rule => (
        rule = rule,
        xs = drops(dxs, rule.next),
        ys = drops(dys, rule.next)))
    |> collect()

let reach = runs
    |> flat_map(run => run.xs |> cat(run.ys))
    |> map(abs)
    |> reduce(0.0D, max)

for run in runs |> index() do
    write_line("rule {run.index + 1}: {run.value.rule.name}")
    write_line(
        "  x mean {mean(run.value.xs),8:F3}"
        "  deviation {deviation(run.value.xs),8:F3}")
    write_line(
        "  y mean {mean(run.value.ys),8:F3}"
        "  deviation {deviation(run.value.ys),8:F3}")
    write_line("")

    plot(image, run.index, run.value.xs, run.value.ys, reach)
od

write_line("all four on one scale, the widest drop reaching the frame")

image.write("funnel.png")

image.show("funnel.png")
