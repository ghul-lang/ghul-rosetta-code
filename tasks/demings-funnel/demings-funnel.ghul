drops(ds: double[], rule: (double, double) -> double) -> double[] => (
    let landed = LIST()
    let at mut = 0.0

    for d in ds do
        landed.add(at + d)

        at = rule(at, d)
    od

    landed
)

mean(xs: double[]) -> double => (xs |> sum()) / double(xs.count)

deviation(xs: double[]) -> double =>
    let m = mean(xs) in
    sqrt((xs |> sum_by(x => (x - m) * (x - m))) / double(xs.count))

let rules = [
    (name = "the funnel stays over the target", next = (at, d) => 0.0),
    (name = "shift by the last miss", next = (at, d) => -d),
    (
        name = "shift from the target by the last miss",
        next = (at, d) => -(at + d)
    ),
    (name = "follow the last marble", next = (at, d) => at + d)
]

plot(image: IMAGE, at: int, xs: double[], ys: double[], reach: double) is
    let width = double(image.width) / 2.0
    let height = double(image.height) / 2.0
    let left = double(at % 2) * width
    let top = double(at / 2) * height
    let middle = (x = left + width / 2.0, y = top + height / 2.0)
    let scale = (min(width, height) / 2.0 - 14.0) / reach

    image.color(170ub, 170ub, 170ub)
    image.stroke(1.0)
    image.line([
        (x = left + 1.0, y = top + 1.0),
        (x = left + width - 1.0, y = top + 1.0),
        (x = left + width - 1.0, y = top + height - 1.0),
        (x = left + 1.0, y = top + height - 1.0),
        (x = left + 1.0, y = top + 1.0)
    ])

    image.color(210ub, 210ub, 210ub)
    image.line(left + 10.0, middle.y, left + width - 10.0, middle.y)
    image.line(middle.x, top + 10.0, middle.x, top + height - 10.0)

    image.color(30ub, 70ub, 160ub)

    for i in 0..xs.count do
        image.dot(middle.x + xs[i] * scale, middle.y + ys[i] * scale, 2.0)
    od

    image.color(40ub, 40ub, 40ub)
    image.text(
        left + width / 2.0,
        top + 22.0,
        15.0,
        "rule {at + 1}",
        Anchor.CENTER
    )
si

let image = IMAGE(640, 640)

let runs =
    rules
        |> map(rule => (
            rule = rule,
            xs = drops(dxs, rule.next),
            ys = drops(dys, rule.next)
        ))
        |> list()

let reach =
    runs
        |> flat_map(run => run.xs |> cat(run.ys))
        |> map(abs)
        |> reduce(0.0, max)

for run in runs |> index() do
    write_line("rule {run.index + 1}: {run.value.rule.name}")
    write_line(
        "  x mean {mean(run.value.xs),8:F3}"
        "  deviation {deviation(run.value.xs),8:F3}"
    )
    write_line(
        "  y mean {mean(run.value.ys),8:F3}"
        "  deviation {deviation(run.value.ys),8:F3}"
    )
    write_line("")

    plot(image, run.index, run.value.xs, run.value.ys, reach)
od

write_line("all four on one scale, the widest drop reaching the frame")

image.write("funnel.png")

image.show("funnel.png")
