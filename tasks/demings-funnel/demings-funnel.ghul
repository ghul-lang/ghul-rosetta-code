    -0.095, 0.695, 0.34, -0.182, 0.287, 0.213, -0.423, -0.021,
    -0.134, 1.798, 0.021, -1.099, -0.361, 1.636, -1.134, 1.315,
    0.201, 0.034, 0.097, -0.17, 0.054, -0.553, -0.024, -0.181,
    -0.7, -0.361, -0.789, 0.279, -0.174, -0.009, -0.323, -0.658,
