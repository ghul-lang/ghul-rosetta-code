use default

// `=~` compares values (structural equality)
// `if let` pattern-matches

full_name(user: string) -> string? =>
    if user =~ "alice" then "Alice Liddell" else null fi

let present = full_name("alice")
let absent = full_name("bob")

write_line("present is null: {!present?}")
write_line("absent is null:  {!absent?}")
write_line("absent, with a fallback: {absent ?? "none"}")

if let name = present then
    write_line("present holds \"{name}\", {name.length} characters")
fi
