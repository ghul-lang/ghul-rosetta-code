use default
use Text.Regex

// The program inspects its own source: every name written directly before
// an opening parenthesis, other than where a line declares a function, is
// a call of that function.

let keywords = ["if", "elif", "when", "while", "for", "case", "return", "assert"] |> SET()

let source = IO.File.read_all_text("function-frequency.ghul")

let called_names =
    Regex.matches(source, "[^\\w\\n]([a-z_]\\w*)\\(")
        |> map(m => m.groups[1].value)
        |> filter(name => !keywords.contains(name))

let most_called =
    called_names
        |> group_by(name => name)
        |> map(uses => (name = uses.key, uses = uses.value.count))
        |> sort((a, b) =>
            if a.uses != b.uses then b.uses <> a.uses
            else a.name <> b.name
            fi
        )
        |> take(10)

for called in most_called do
    write_line("{called.uses,4}  {called.name}")
od
