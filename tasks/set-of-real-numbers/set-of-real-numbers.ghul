use default

use RealSet = (double) -> bool

open_range(low: double, high: double) -> RealSet =>
    value => low < value /\ value < high

closed_range(low: double, high: double) -> RealSet =>
    value => low <= value /\ value <= high

open_closed(low: double, high: double) -> RealSet =>
    value => low < value /\ value <= high

closed_open(low: double, high: double) -> RealSet =>
    value => low <= value /\ value < high

joined(left: RealSet, right: RealSet) -> RealSet =>
    value => left(value) \/ right(value)

shared(left: RealSet, right: RealSet) -> RealSet =>
    value => left(value) /\ right(value)

without(left: RealSet, right: RealSet) -> RealSet =>
    value => left(value) /\ !right(value)

samples(low: double, high: double, steps: int) -> double{} =>
    (0::steps)
        |> map(step => low + (high - low) * double(step) / double(steps))

is_empty(set: RealSet, low: double, high: double, steps: int) -> bool =>
    samples(low, high, steps) |> all(value => !set(value))

extent(set: RealSet, low: double, high: double, steps: int) -> double =>
    let inside = samples(low, high, steps) |> filter(set) |> count() in
    (high - low) * double(inside) / double(steps)

let examples = [
    (
        name = "(0,1] u [0,2)",
        set = joined(open_closed(0.0, 1.0), closed_open(0.0, 2.0))
    ),
    (
        name = "[0,2) n (1,2]",
        set = shared(closed_open(0.0, 2.0), open_closed(1.0, 2.0))
    ),
    (
        name = "[0,3) - (0,1)",
        set = without(closed_open(0.0, 3.0), open_range(0.0, 1.0))
    ),
    (
        name = "[0,3) - [0,1]",
        set = without(closed_open(0.0, 3.0), closed_range(0.0, 1.0))
    )
]

write_line("membership:")

examples
    |> each(example => (
        let answers = [0.0, 1.0, 2.0]
            |> map(value => "{value:F0}: {example.set(value),-5}")
            |> join(" ")

        write_line("  {example.name}   {answers.trim_end()}")
    ))

write_line()
write_line("emptiness over [0,2]:")

let probes = [
    (name = "[1,1]", set = closed_range(1.0, 1.0)),
    (name = "(1,1)", set = open_range(1.0, 1.0)),
    (name = "(0,0]", set = open_closed(0.0, 0.0))
]

probes
    |> each(probe =>
        write_line(
            "  {probe.name} is empty: "
            "{is_empty(probe.set, 0.0, 2.0, 100_000)}"
        )
    )

let ripples: RealSet =
    value =>
        0.0 < value /\ value < 10.0 /\ abs(sin(pi * value * value)) > 0.5

let waves: RealSet =
    value => 0.0 < value /\ value < 10.0 /\ abs(sin(pi * value)) > 0.5

write_line()
write_line(
    "length of A - B over (0,10): "
    "{extent(without(ripples, waves), 0.0, 10.0, 1_000_000):F3}"
)
