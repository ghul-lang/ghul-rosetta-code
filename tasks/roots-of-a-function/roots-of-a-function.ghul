use default

union Root is
    EXACT(x: double)
    APPROXIMATE(x: double)
si

bisect(f: double -> double, low: double, high: double) -> double is
    let a mut = low
    let b mut = high

    for _ in 0..60 do
        let middle = (a + b) / 2.0

        if (f(a) < 0.0) == (f(middle) < 0.0) then
            a = middle
        else
            b = middle
        fi
    od

    return (a + b) / 2.0
si

roots(
    f: double -> double, start: double, stop: double, step: double
) -> Pipe[Root] is
    let steps = int(System.Math.round((stop - start) / step))
    let x = (i: int) => start + double(i) * step

    for i in 0::steps do
        if f(x(i)) == 0.0 then
            yield Root.EXACT(x(i))
        elif i < steps /\ f(x(i + 1)) != 0.0 /\
            (f(x(i)) < 0.0) != (f(x(i + 1)) < 0.0)
        then
            yield Root.APPROXIMATE(bisect(f, x(i), x(i + 1)))
        fi
    od
si

let f = (x: double) => x * x * x - 3.0 * x * x + 2.0 * x

for (start, stop, step) in [(-1.0, 3.0, 0.1), (-0.95, 3.05, 0.3)] do
    write_line("from {start} to {stop} in steps of {step}:")

    for root in roots(f, start, stop, step) do
        case root
        when (x): Root.EXACT then
            write_line("  root at {x:R} (exact)")
        when (x): Root.APPROXIMATE then
            write_line("  root at {x:G10} (approximate)")
        esac
    od

    write_line("")
od
