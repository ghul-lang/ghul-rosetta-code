use default
use System.Math.*

// `T[]` is the read-only list trait - elements can be read by index
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read, and `count` reads it all

let seconds_per_day = 24.0 * 60.0 * 60.0

to_angle(time: string) -> double =>
    let seconds = System.TimeSpan.parse(time).total_seconds in
    tau * seconds / seconds_per_day

mean_angle(angles: double[]) -> double =>
    atan2(angles |> sum_by(sin), angles |> sum_by(cos))

mean_time(times: string[]) -> string =>
    let
        angle = mean_angle(times |> map(to_angle) |> list()),
        turn = if angle < 0.0 then angle + tau else angle fi,
        seconds = round(turn / tau * seconds_per_day)
    in
        System.TimeSpan.from_seconds(seconds).to_string()

let times = ["23:00:17", "23:40:20", "00:12:45", "00:17:19"]

write_line("mean time of {times |> join(", ")} is {mean_time(times)}")
