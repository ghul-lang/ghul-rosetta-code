use default
use System.Math.*

let seconds_per_day = 24.0 * 60.0 * 60.0

to_angle(time: string) -> double =>
    let seconds = System.TimeSpan.parse(time).total_seconds in
    tau * seconds / seconds_per_day

mean_angle(angles: List[double]) -> double =>
    atan2(angles |> sum_by(sin), angles |> sum_by(cos))

mean_time(times: List[string]) -> string =>
    let
        angle = mean_angle(times |> map(to_angle) |> collect()),
        turn = if angle < 0.0 then angle + tau else angle fi,
        seconds = round(turn / tau * seconds_per_day)
    in
        System.TimeSpan.from_seconds(seconds).to_string()

let times = ["23:00:17", "23:40:20", "00:12:45", "00:17:19"]

write_line(
    "mean time of {times |> join(", ")} is {mean_time(times)}"
)
