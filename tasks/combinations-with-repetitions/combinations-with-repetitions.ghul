use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity
// `case ... when` pattern-matches, and `[x, ..rest]` matches a list head
//  and tail

combos[T](items: T[], k: int) -> T[]{} is
    if k == 0 then
        yield LIST()
    else
        case items
        when [] then
        when [first, ..rest] then
            for combo in combos(LIST([first] ++ rest), k - 1) do
                yield LIST([first] ++ combo)
            od

            yield in combos(rest, k)
        esac
    fi
si

let doughnuts = ["iced", "jam", "plain"]
let picks = combos(doughnuts, 2)

let choices = doughnuts |> join()

write_line("choosing 2 from {choices}: {picks |> count()} ways")

for pick in picks do
    write_line("  {pick |> join(", ")}")
od

let ten_types = LIST(1::10)
let ways = ten_types |> combos(3) |> count()

write_line("choosing 3 from 10 types: {ways} ways")
