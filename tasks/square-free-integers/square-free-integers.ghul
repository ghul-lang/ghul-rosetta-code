use default

is_square_free(n: long) -> bool =>
    n % 4L != 0L /\
    from(1L)
        |> map(k => 2L * k + 1L)
        |> take_while(d => d * d <= n)
        |> all(d => n % (d * d) != 0L)

show(from: long, to: long) is
    let found = from::to |> filter(is_square_free) |> collect()
    let width = "{to}".length + 1
    let per_row = 72 / width

    write_line(
        "Square-free integers from {from:N0} to {to:N0}:"
    )

    for row in 0..(found.count + per_row - 1) / per_row do
        let cells =
            found |> skip(row * per_row) |> take(per_row)

        write_line(
            cells |> map(n => "{n}".pad_left(width)) |> join("")
        )
    od

    write_line("")
si

show(1L, 145L)
show(1_000_000_000_000L, 1_000_000_000_145L)

let limit = 1_000_000
let square_free = repeat(true, limit + 1) |> collect_mutable()

for d in 2::1000 do
    let square = d * d
    let multiple mut = square

    while multiple <= limit do
        square_free[multiple] = false
        multiple = multiple + square
    od
od

for bound in [100, 1_000, 10_000, 100_000, 1_000_000] do
    let found = 1::bound |> count(n => square_free[n])

    write_line("up to {bound,9:N0}: {found,7:N0}")
od
