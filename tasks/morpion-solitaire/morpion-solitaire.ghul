use default
use Raster.IMAGE
use System.Math.*

use Move = (x: int, y: int, d: int, k: int)

let random = System.Random(7)

let steps =
    [(dx = 1, dy = 0), (dx = 0, dy = 1),
     (dx = 1, dy = 1), (dx = 1, dy = -1)]
let symbols = ["-", "|", "/", "\\"]

let cross = [
    "...XXXX...",
    "...X..X...",
    "...X..X...",
    "XXXX..XXXX",
    "X........X",
    "X........X",
    "XXXX..XXXX",
    "...X..X...",
    "...X..X...",
    "...XXXX..."
]

let points = SET[(int, int)]()
let used = SET[(int, int, int)]()

for row in 0..10 do
    for column in 0..10 do
        if cross[row][column] == 'X' then
            points.add((column, 9 - row))
        fi
    od
od

let start = LIST(points)

fits(m: Move) -> bool is
    let step = steps[m.d]

    for i in 0..5 do
        let x = m.x + (i - m.k) * step.dx
        let y = m.y + (i - m.k) * step.dy

        if i != m.k /\ !points.contains((x, y)) then
            return false
        fi

        if i < 4 /\ used.contains((x, y, m.d)) then
            return false
        fi
    od

    return true
si

legal_moves() -> LIST[Move] is
    let empty = SET[(int, int)]()

    for (x, y) in points do
        for dx in -1::1 do
            for dy in -1::1 do
                if !points.contains((x + dx, y + dy)) then
                    empty.add((x + dx, y + dy))
                fi
            od
        od
    od

    let moves = LIST()

    for (x, y) in empty do
        for d in 0..4 do
            for k in 0..5 do
                let m = (x = x, y = y, d = d, k = k)

                if fits(m) then
                    moves.add(m)
                fi
            od
        od
    od

    return moves
si

play(m: Move) is
    let step = steps[m.d]

    points.add((m.x, m.y))

    for i in 0..4 do
        let x = m.x + (i - m.k) * step.dx
        let y = m.y + (i - m.k) * step.dy

        used.add((x, y, m.d))
    od
si

let played = LIST()

do
    let moves = legal_moves()

    if moves.count == 0 then
        break
    fi

    let m = moves[random.next(moves.count)]

    play(m)
    played.add(m)
od

write_line("{played.count} moves")
write_line("each is the new point, the line's direction, and")
write_line("the new point's place along the line, 0 to 4")
write_line()

let listed = played |> index() |> map(im =>
    let m = im.value in
    "{im.index + 1,3}: {m.x,3},{m.y,3} {symbols[m.d]}{m.k}")

for group in 0..(played.count + 3) / 4 do
    write_line(listed |> skip(group * 4) |> take(4) |> join("  "))
od

let low_x =
    points |> map(p => p.`0) |> reduce(0, (a, b) => min(a, b))
let high_x =
    points |> map(p => p.`0) |> reduce(0, (a, b) => max(a, b))
let low_y =
    points |> map(p => p.`1) |> reduce(0, (a, b) => min(a, b))
let high_y =
    points |> map(p => p.`1) |> reduce(0, (a, b) => max(a, b))

let cell = 36

let image = IMAGE(
    (high_x - low_x + 2) * cell, (high_y - low_y + 2) * cell)

image.view(
    double(low_x) - 1.0D, double(low_y) - 1.0D,
    double(high_x) + 1.0D, double(high_y) + 1.0D)

image.clear(255ub, 255ub, 255ub)

image.colour(225ub, 225ub, 230ub)
image.stroke(1.0D)

for x in low_x - 1::high_x + 1 do
    image.line(
        double(x), double(low_y - 1),
        double(x), double(high_y + 1))
od

for y in low_y - 1::high_y + 1 do
    image.line(
        double(low_x - 1), double(y),
        double(high_x + 1), double(y))
od

image.colour(40ub, 90ub, 170ub)
image.stroke(2.0D)

for m in played do
    let step = steps[m.d]
    let from_x = m.x - m.k * step.dx
    let from_y = m.y - m.k * step.dy

    image.line(
        double(from_x), double(from_y),
        double(from_x + 4 * step.dx),
        double(from_y + 4 * step.dy))
od

image.colour(20ub, 20ub, 20ub)

for (x, y) in start do
    image.dot(double(x), double(y), 7.0D)
od

for (m, n) in played |> index() |> map(im => (im.value, im.index + 1)) do
    image.colour(255ub, 255ub, 255ub)
    image.dot(double(m.x), double(m.y), 12.0D)
    image.colour(200ub, 40ub, 40ub)
    image.circle(double(m.x), double(m.y), 0.36D)
    image.text(
        double(m.x), double(m.y) - 0.16D, 12.0D, "{n}",
        Raster.Anchor.CENTRE)
od

image.write("morpion.png")

image.show("morpion.png")
