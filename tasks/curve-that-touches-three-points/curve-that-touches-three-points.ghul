use default
use Raster.IMAGE

struct P(x: double, y: double) is
    -(o: P) -> P => P(x - o.x, y - o.y)
    length: double => sqrt(x * x + y * y)
si

let full = 2.0 * pi

center_of(a, b, c) => (
    let d =
        2.0 * (a.x * (b.y - c.y) + b.x * (c.y - a.y) + c.x * (a.y - b.y))

    let a2 = a.x * a.x + a.y * a.y,
        b2 = b.x * b.x + b.y * b.y,
        c2 = c.x * c.x + c.y * c.y

    P(
        (a2 * (b.y - c.y) + b2 * (c.y - a.y) + c2 * (a.y - b.y)) / d,
        (a2 * (c.x - b.x) + b2 * (a.x - c.x) + c2 * (b.x - a.x)) / d
    )
)

curve(start, middle, finish, steps) is
    let center = center_of(start, middle, finish)
    let radius = (start - center).length

    angle(p) => atan2(p.y - center.y, p.x - center.x)

    let from = angle(start)
    let through = angle(middle)
    let turn mut = angle(finish) - from

    let wrap = a => a - full * floor(a / full)

    if (wrap(through - from) < wrap(turn)) != (turn > 0.0) then
        turn = if turn > 0.0 then turn - full else turn + full fi
    fi

    (0::steps)
        |> map(i =>
            let
                a = from + turn * double(i) / double(steps),
                x = center.x + radius * cos(a)
            in
                P(x, center.y + radius * sin(a))
        )
        |> list()
si

let start = P(10.0, 10.0)
let middle = P(100.0, 200.0)
let finish = P(200.0, 10.0)

let center = center_of(start, middle, finish)

write_line("the circle through all three has its center at")
write_line("({center.x:F3}, {center.y:F3})")
write_line("and radius {(start - center).length:F3}")

let points = curve(start, middle, finish, 100)

let image = IMAGE(300, 300)

image.view(-20.0, -40.0, 230.0, 210.0)
image.clear(252ub, 250ub, 245ub)
image.color(40ub, 80ub, 170ub)
image.stroke(2.5)
image.line(points |> map(p => (x = p.x, y = p.y)) |> list())

image.color(210ub, 50ub, 40ub)

for p in [start, middle, finish] do
    image.dot(p.x, p.y, 5.0)
od

image.write("curve.png")

image.show("curve.png")
