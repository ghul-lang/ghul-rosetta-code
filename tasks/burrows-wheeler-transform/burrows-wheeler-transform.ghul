use default

let start_of_text = 2c
let end_of_text = 3c

ordinal_order(left: string, right: string) -> int =>
    string.compare_ordinal(left, right)

rotations(text: string) -> string{} =>
    (0..text.length) |> map(i => "{text[i..<0]}{text[0..i]}")

last_character(text: string) -> string =>
    "{text[text.length - 1]}"

transform(text: string) -> string =>
    rotations("{start_of_text}{text}{end_of_text}")
        |> sort(ordinal_order)
        |> map(last_character)
        |> join("")

invert(transformed: string) -> string => (
    let width = transformed.length,
        empty = 0..width |> map(i => "")

    let table =
        0..width
            |> reduce(empty, (t, _) =>
                t
                    |> index()
                    |> map(row =>
                        "{transformed[row.index]}{row.value}"
                    )
                    |> sort(ordinal_order)
            )

    let framed =
        table
            |> filter(row => row[row.length - 1] == end_of_text)
            |> only()

    framed[1..width - 1]
)

visible(text: string) -> string =>
    text.replace(start_of_text, '^').replace(end_of_text, '|')

[
    "banana",
    "appellee",
    "dogwood",
    "TO BE OR NOT TO BE OR WANT TO BE OR NOT?",
    "SIX.MIXED.PIXIES.SIFT.SIXTY.PIXIE.DUST.BOXES"
]
    |> each(text => (
        let transformed = transform(text)
        write_line("Original text:                {text}")
        write_line(
            "After transformation:         {visible(transformed)}"
        )
        write_line(
            "After inverse transformation: {invert(transformed)}"
        )
        write_line("")
    ))
