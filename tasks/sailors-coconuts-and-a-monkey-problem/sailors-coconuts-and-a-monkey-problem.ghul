use default

after_night(pile, sailors) =>
    pile - 1 - (pile - 1) / sailors

satisfies_tale(pile, sailors, nights) =>
    if nights == 0 then
        pile % sailors == 0
    else
        pile % sailors == 1 /\
        satisfies_tale(after_night(pile, sailors), sailors, nights - 1)
    fi

hidden_piles(pile, sailors, nights) is
    if nights > 0 then
        yield (pile - 1) / sailors
        yield in hidden_piles(
            after_night(pile, sailors),
            sailors,
            nights - 1
        )
    fi
si

for sailors in [5, 6] do
    if let
        total = from(sailors) |> find(satisfies_tale(*, sailors, sailors))
    then
        write_line("{sailors} sailors: smallest pile is {total} coconuts")
        write_line(
            "  piles hidden at night: "
            "{hidden_piles(total, sailors, sailors) |> join(", ")}"
        )
    fi
od
