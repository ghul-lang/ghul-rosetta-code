use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `yield` makes the function a generator: it returns a lazy `T{}`.
// `if let` and `case ... when` pattern-match; `[x, ..rest]` matches a list.

after_night(pile: int, sailors: int) -> int =>
    pile - 1 - (pile - 1) / sailors

satisfies_tale(pile: int, sailors: int, nights: int) -> bool =>
    if nights == 0 then
        pile % sailors == 0
    else
        pile % sailors == 1 /\
        satisfies_tale(after_night(pile, sailors), sailors, nights - 1)
    fi

hidden_piles(pile: int, sailors: int, nights: int) -> int{} is
    if nights > 0 then
        yield (pile - 1) / sailors
        yield in hidden_piles(
            after_night(pile, sailors),
            sailors,
            nights - 1
        )
    fi
si

for sailors in [5, 6] do
    if let
        total = from(sailors) |> find(satisfies_tale(*, sailors, sailors))
    then
        write_line("{sailors} sailors: smallest pile is {total} coconuts")
        write_line(
            "  piles hidden at night: "
            "{hidden_piles(total, sailors, sailors) |> join(", ")}"
        )
    fi
od
