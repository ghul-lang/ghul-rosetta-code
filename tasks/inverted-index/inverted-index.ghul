use default

// `SET[T]` is a mutable set, holding each element once
// `MAP[K, V]` is a mutable map from keys to values
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

let documents = [
    "it is what it is",
    "what is done is done",
    "what is done is what is done"
]

let index = MAP()
let number mut = 0

for document in documents do
    for word in words(document) do
        if !index.contains_key(word) then
            index[word] = SET()
        fi

        index[word].add(number)
    od

    number = number + 1
od

for term in ["what", "is", "done", "absent"] do
    let hits =
        if index.contains_key(term) then
            index[term] |> sort() |> map(n => "{n}") |> join()
        else ""
        fi

    write_line("{term}: {hits}")
od
