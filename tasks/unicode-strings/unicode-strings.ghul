use default

use Collections.SET

×(a: int, b: int) -> int => a * b

∪(a: SET[int], b: SET[int]) -> SET[int] =>
    a |> cat(b) |> collect_set()

bytes(encoding: System.Text.Encoding, text: string) -> string =>
    encoding.get_bytes(text) |> map(b => "{b:X2}") |> join(" ")

code_points(text: string) -> int =>
    text |> filter(c => !char.is_low_surrogate(c)) |> count()

write_line("source is UTF-8, and a literal holds what it says")
write_line("  héllo wörld")
write_line("  日本語")
write_line("  Ελληνικά")
write_line("")

let héllo = "wörld"
let 日本語 = "テキスト"
let ελληνικά = "κείμενο"

write_line("a name is written in any script, and so is an operator")
write_line("  héllo {héllo}, 日本語 {日本語}, ελληνικά {ελληνικά}")

let evens = SET([2, 4])
let odds = SET([1, 3])
let joined = (evens ∪ odds) |> sort()

write_line("  6 × 7 = {6 × 7}")
write_line("  evens ∪ odds = {joined}")
write_line("")

let face = "😀"

write_line("a char is a UTF-16 code unit, so this one is two")
write_line("  {face}: {face.length} chars, {code_points(face)} point")
write_line("  escaped and literal agree: {face =~ "😀"}")
write_line("  \\u20AC is {"€"}, \\u0041cat is {"Acat"}")
write_line("")

let text = "né"

write_line("every .NET encoding is reachable, here for {text}")
write_line("  UTF-8    {bytes(System.Text.Encoding.utf8, text)}")
write_line("  UTF-16   {bytes(System.Text.Encoding.unicode, text)}")
write_line("  UTF-32   {bytes(System.Text.Encoding.utf32, text)}")
write_line("")

let composed = "é"
let decomposed = "é"
let form_c = System.Text.NormalizationForm.FORM_C
let normalized = decomposed.normalize(form_c)

write_line("normalization comes from .NET too")
write_line("  {composed} is one char, {decomposed} is two")
write_line("  composed =~ decomposed is {composed =~ decomposed}")
write_line("  after NFC it is {composed =~ normalized}")
