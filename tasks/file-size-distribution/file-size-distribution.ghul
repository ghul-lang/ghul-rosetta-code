use default
use System.Math.*

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`
// `==` compares identity
// `if let` pattern-matches, and `[x, ..rest]` matches a list head and tail

let root = if let [root, ..] = args then root else "." fi

let sizes =
    IO.Directory.enumerate_files(root, "*", IO.SearchOption.ALL_DIRECTORIES)
        |> map(path => IO.FileInfo(path).length)
        |> list()

bucket(size: long) -> int =>
    if size == 0L then
        0
    else
        int(log10(double(size))) + 1
    fi

label(bucket: int) -> string =>
    if bucket == 0 then
        "empty"
    else
        "{pow(10.0, double(bucket - 1))} to "
        "{pow(10.0, double(bucket)) - 1.0} bytes"
    fi

let counts =
    sizes
        |> group_by(bucket)
        |> map(entry => (bucket = entry.key, count = entry.value.count))
        |> sort_by(entry => entry.bucket)

write_line("{sizes.count} files under {root}")
write_line("")

for (b, count) in counts do
    write_line("{label(b),-22} {count,4}  {string('#', count)}")
od

let total = sizes |> sum()
let small = sizes |> filter(* < 1000L) |> list()
let share = 100.0 * double(small |> sum()) / double(total)

write_line("")
write_line(
    "{small.count} of {sizes.count} files are under 1000 bytes, "
    "holding {share:F1}% of the {total} bytes"
)
