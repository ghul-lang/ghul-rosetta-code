use default

merge_sort[T: Ghul.Comparable[T]](values: List[T]) -> List[T] is
    if values.count <= 1 then
        return values
    fi

    let middle = values.count / 2

    return merge(
        merge_sort(values[0..middle]),
        merge_sort(values[middle..<0])
    )
si

merge[T: Ghul.Comparable[T]](
    left: List[T],
    right: List[T]
) -> List[T] =>
    case (left, right)
    when ([], _) then right
    when (_, []) then left
    when ([x, ..xr], [y, ..yr]) then
        if x <= y then
            [x] ++ merge(xr, right) |> collect()
        else
            [y] ++ merge(left, yr) |> collect()
        fi
    esac

write_line([5, 3, 8, 1, 9, 2, 7] |> merge_sort() |> join())
write_line(
    ["pear", "apple", "quince", "banana"]
        |> merge_sort()
        |> join()
)
