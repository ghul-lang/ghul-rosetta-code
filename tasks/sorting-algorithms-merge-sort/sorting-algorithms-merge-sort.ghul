use default

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `case ... when` pattern-matches, and `[x, ..rest]` matches a list head
//  and tail

merge_sort[T: Ghul.Comparable[T]](values: T[]) -> T[] is
    if values.count <= 1 then
        return values
    fi

    let middle = values.count / 2

    return merge(
        merge_sort(values[0..middle]),
        merge_sort(values[middle..<0])
    )
si

merge[T: Ghul.Comparable[T]](left: T[], right: T[]) -> T[] =>
    case (left, right)
    when ([], _) then right
    when (_, []) then left
    when ([x, ..xr], [y, ..yr]) then
        if x <= y then
            [x] ++ merge(xr, right) |> list()
        else
            [y] ++ merge(left, yr) |> list()
        fi
    esac

write_line([5, 3, 8, 1, 9, 2, 7] |> merge_sort() |> join())
write_line(["pear", "apple", "quince", "banana"] |> merge_sort() |> join())
