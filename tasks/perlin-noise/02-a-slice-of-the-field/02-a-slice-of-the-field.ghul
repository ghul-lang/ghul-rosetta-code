use default
use Raster.COLOUR_MAP
use Raster.IMAGE
use System.Math.*

let permutation = [
    151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225,
    140, 36, 103, 30, 69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148,
    247, 120, 234, 75, 0, 26, 197, 62, 94, 252, 219, 203, 117, 35, 11, 32,
    57, 177, 33, 88, 237, 149, 56, 87, 174, 20, 125, 136, 171, 168, 68,
    175, 74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231, 83, 111,
    229, 122, 60, 211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244,
    102, 143, 54, 65, 25, 63, 161, 1, 216, 80, 73, 209, 76, 132, 187, 208,
    89, 18, 169, 200, 196, 135, 130, 116, 188, 159, 86, 164, 100, 109, 198,
    173, 186, 3, 64, 52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118,
    126, 255, 82, 85, 212, 207, 206, 59, 227, 47, 16, 58, 17, 182, 189, 28,
    42, 223, 183, 170, 213, 119, 248, 152, 2, 44, 154, 163, 70, 221, 153,
    101, 155, 167, 43, 172, 9, 129, 22, 39, 253, 19, 98, 108, 110, 79, 113,
    224, 232, 178, 185, 112, 104, 218, 246, 97, 228, 251, 34, 242, 193,
    238, 210, 144, 12, 191, 179, 162, 241, 81, 51, 145, 235, 249, 14, 239,
    107, 49, 192, 214, 31, 181, 199, 106, 157, 184, 84, 204, 176, 115, 121,
    50, 45, 127, 4, 150, 254, 138, 236, 205, 93, 222, 114, 67, 29, 24, 72,
    243, 141, 128, 195, 78, 66, 215, 61, 156, 180
]

let p =
    (0..512)
    |> map(index => permutation[index % 256])
    |> collect()

fade(t: double) -> double => t * t * t * (t * (t * 6.0 - 15.0) + 10.0)

lerp(t: double, a: double, b: double) -> double => a + t * (b - a)

grad(hash: int, x: double, y: double, z: double) -> double is
    let h = hash & 15

    let u = if h < 8 then x else y fi

    let v =
        if h < 4 then
            y
        elif h == 12 \/ h == 14 then
            x
        else
            z
        fi

    let first = if h & 1 == 0 then u else -u fi
    let second = if h & 2 == 0 then v else -v fi

    return first + second
si

noise(at_x: double, at_y: double, at_z: double) -> double is
    let unit_x = int(floor(at_x)) & 255
    let unit_y = int(floor(at_y)) & 255
    let unit_z = int(floor(at_z)) & 255

    let x = at_x - floor(at_x)
    let y = at_y - floor(at_y)
    let z = at_z - floor(at_z)

    let u = fade(x)
    let v = fade(y)
    let w = fade(z)

    let a = p[unit_x] + unit_y
    let aa = p[a] + unit_z
    let ab = p[a + 1] + unit_z

    let b = p[unit_x + 1] + unit_y
    let ba = p[b] + unit_z
    let bb = p[b + 1] + unit_z

    let near =
        lerp(v,
             lerp(u, grad(p[aa], x, y, z), grad(p[ba], x - 1.0, y, z)),
             lerp(u,
                  grad(p[ab], x, y - 1.0, z),
                  grad(p[bb], x - 1.0, y - 1.0, z)))

    let far =
        lerp(v,
             lerp(u,
                  grad(p[aa + 1], x, y, z - 1.0),
                  grad(p[ba + 1], x - 1.0, y, z - 1.0)),
             lerp(u,
                  grad(p[ab + 1], x, y - 1.0, z - 1.0),
                  grad(p[bb + 1], x - 1.0, y - 1.0, z - 1.0)))

    return lerp(w, near, far)
si

let image = IMAGE(480, 320)

let cell = 28.0

for y in 0..image.height do
    for x in 0..image.width do
        let value =
            noise(double(x) / cell, double(y) / cell, 0.5)

        let shade = COLOUR_MAP.viridis(0.5 + value / 1.2)

        image.set_pixel(x, y, shade.red, shade.green, shade.blue)
    od
od

image.write("noise.png")

image.show("noise.png")
