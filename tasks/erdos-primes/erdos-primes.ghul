use default

let limit = 1_000_000
let factorials = LIST()
let next mut = 1
let step mut = 1

while next <= limit do
    factorials.add(next)
    step = step + 1
    next = next * step
od

is_erdos(prime: int) -> bool =>
    factorials
        |> filter(* < prime)
        |> all(f => !is_prime(prime - f))

let erdos =
    primes()
        |> take_while(* <= limit)
        |> filter(is_erdos)
        |> collect()

let below_2500 = erdos |> filter(* < 2_500) |> collect()

write_line("the Erdos primes below 2500:")

for row in 0..(below_2500.count + 9) / 10 do
    let last = System.Math.min(row * 10 + 10, below_2500.count)
    let cells = below_2500[row * 10..last] |> map(p => "{p,6}")

    write_line(cells |> join(""))
od

write_line("")
write_line("there are {below_2500.count} of them")
write_line("")
write_line(
    "Erdos prime {erdos.count} is {erdos[erdos.count - 1]}, "
    "the highest below a million"
)
