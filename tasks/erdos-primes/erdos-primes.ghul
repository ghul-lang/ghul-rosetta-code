use default

// `LIST[T]` is a mutable list that grows as elements are added
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`

let limit = 1_000_000
let factorials = LIST()
let next mut = 1
let step mut = 1

while next <= limit do
    factorials.add(next)
    step = step + 1
    next = next * step
od

is_erdos(prime: int) -> bool =>
    factorials |> filter(* < prime) |> all(f => !is_prime(prime - f))

let erdos = primes() |> take_while(* <= limit) |> filter(is_erdos) |> list()

let below_2500 = erdos |> filter(* < 2_500) |> list()

write_line("the Erdos primes below 2500:")

for row in 0..(below_2500.count + 9) / 10 do
    let last = min(row * 10 + 10, below_2500.count)
    let cells = below_2500[row * 10..last] |> map(p => "{p,6}")

    write_line(cells |> join(""))
od

write_line("")
write_line("there are {below_2500.count} of them")
write_line("")
write_line(
    "Erdos prime {erdos.count} is {erdos[erdos.count - 1]}, "
    "the highest below a million"
)
