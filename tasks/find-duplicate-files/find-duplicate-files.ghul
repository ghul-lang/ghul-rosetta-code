use default

use IO.Directory
use IO.File
use IO.Path

use System.Security.Cryptography.SHA256

// Works on any filesystem .NET can read. Files are grouped by size, then by
// a SHA-256 of their contents. Hard links are not identified: .NET has no
// portable way to ask whether two paths name the same file.

use Group = (size: long, paths: string[])

digest(path: string) -> string =>
    let bytes = File.read_all_bytes(path) in
    System.Convert.to_hex_string(SHA256.hash_data(bytes))

same_contents(root: string, size: long, paths: Iterable[string])
    -> Group{} =>
    paths
        |> group_by(digest)
        |> map((_, same) =>
            (size,
             paths =
                same
                    |> map(path => Path.get_relative_path(root, path))
                    |> sort()
                    |> collect()))
        |> filter((_, paths) => paths.count > 1)

duplicates(root: string, minimum: long) -> List[Group] =>
    Directory.enumerate_files(root, "*", IO.SearchOption.ALL_DIRECTORIES)
        |> map(path => (path, size = IO.FileInfo(path).length))
        |> filter((_, size) => size >= minimum)
        |> group_by((_, size) => size)
        |> flat_map((size, files) =>
            same_contents(root, size, files |> map((path, _) => path)))
        |> sort_by_descending((size, _) => size)
        |> collect()

let root =
    Path.combine(
        Path.get_temp_path(), "duplicates-{System.Guid.new_guid()}")

let contents = [
    ("a.txt", "the same text"),
    ("docs/b.txt", "the same text"),
    ("docs/deep/c.txt", "the same text"),
    ("d.txt", "different text"),
    ("e.dat", "a longer run of repeated content"),
    ("backup/e.dat", "a longer run of repeated content"),
    ("tiny", "x"),
    ("backup/tiny", "x")
]

for (name, text) in contents do
    let path = Path.combine(root, name)

    Directory.create_directory(Path.get_directory_name(path)!)
    File.write_all_text(path, text)
od

for (size, paths) in duplicates(root, 2L) do
    write_line("{size} bytes: {paths |> join(", ")}")
od

Directory.delete(root, true)
