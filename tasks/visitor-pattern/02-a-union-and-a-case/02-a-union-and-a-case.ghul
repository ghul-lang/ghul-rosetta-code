use default

union Expression is
    NUMBER(value: double)
    ADD(left: Expression, right: Expression)
    MULTIPLY(left: Expression, right: Expression)
    NEGATE(inner: Expression)
si

value_of(expression: Expression) -> double =>
    case expression
    when number: Expression.NUMBER then number.value
    when add: Expression.ADD then
        value_of(add.left) + value_of(add.right)
    when multiply: Expression.MULTIPLY then
        value_of(multiply.left) * value_of(multiply.right)
    when negate: Expression.NEGATE then -value_of(negate.inner)
    esac

text_of(expression: Expression) -> string =>
    case expression
    when number: Expression.NUMBER then "{number.value}"
    when add: Expression.ADD then
        "({text_of(add.left)} + {text_of(add.right)})"
    when multiply: Expression.MULTIPLY then
        "({text_of(multiply.left)} × {text_of(multiply.right)})"
    when negate: Expression.NEGATE then
        "-{text_of(negate.inner)}"
    esac

let expression = Expression.ADD(
    Expression.MULTIPLY(
        Expression.NUMBER(3.0),
        Expression.NUMBER(4.0)
    ),
    Expression.NEGATE(Expression.NUMBER(5.0))
)

write_line("{text_of(expression)} = {value_of(expression)}")

let expressions = [
    expression,
    Expression.NUMBER(1.5),
    Expression.NEGATE(expression)
]

expressions
    |> each(each =>
        write_line("{text_of(each),-28} {value_of(each)}")
    )
