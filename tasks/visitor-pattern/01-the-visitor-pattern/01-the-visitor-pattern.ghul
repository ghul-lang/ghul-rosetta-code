use default

trait Visitor[T] is
    visit_number(number: NUMBER) -> T
    visit_add(add: ADD) -> T
    visit_multiply(multiply: MULTIPLY) -> T
    visit_negate(negate: NEGATE) -> T
si

class Expression abstract is
    accept[T](visitor: Visitor[T]) -> T
si

class NUMBER(value: double): Expression is
    accept[T](visitor: Visitor[T]) -> T =>
        visitor.visit_number(self)
si

class ADD(left: Expression, right: Expression): Expression is
    accept[T](visitor: Visitor[T]) -> T =>
        visitor.visit_add(self)
si

class MULTIPLY(
    left: Expression,
    right: Expression
): Expression is
    accept[T](visitor: Visitor[T]) -> T =>
        visitor.visit_multiply(self)
si

class NEGATE(inner: Expression): Expression is
    accept[T](visitor: Visitor[T]) -> T =>
        visitor.visit_negate(self)
si

class EVALUATOR: Visitor[double] is
    init() is si

    of(expression: Expression) -> double =>
        expression.accept(self)

    visit_number(number: NUMBER) -> double => number.value

    visit_add(add: ADD) -> double =>
        of(add.left) + of(add.right)

    visit_multiply(multiply: MULTIPLY) -> double =>
        of(multiply.left) * of(multiply.right)

    visit_negate(negate: NEGATE) -> double => -of(negate.inner)
si

class PRINTER: Visitor[string] is
    init() is si

    of(expression: Expression) -> string =>
        expression.accept(self)

    visit_number(number: NUMBER) -> string => "{number.value}"

    visit_add(add: ADD) -> string =>
        "({of(add.left)} + {of(add.right)})"

    visit_multiply(multiply: MULTIPLY) -> string =>
        "({of(multiply.left)} × {of(multiply.right)})"

    visit_negate(negate: NEGATE) -> string =>
        "-{of(negate.inner)}"
si

let evaluator = EVALUATOR()
let printer = PRINTER()

let expression = ADD(
    MULTIPLY(NUMBER(3.0), NUMBER(4.0)),
    NEGATE(NUMBER(5.0))
)

write_line(
    "{printer.of(expression)} = {evaluator.of(expression)}"
)

let expressions: LIST[Expression] = _()
expressions.add(expression)
expressions.add(NUMBER(1.5))
expressions.add(NEGATE(expression))

expressions
    |> each(each =>
        write_line(
            "{printer.of(each),-28} {evaluator.of(each)}"
        )
    )
