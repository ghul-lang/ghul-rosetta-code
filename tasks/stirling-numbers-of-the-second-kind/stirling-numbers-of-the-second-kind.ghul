use default

row_of(n: int) -> List[bigint] is
    let row mut = LIST()
    row.add(1n)

    for step in 1::n do
        let following = LIST()
        following.add(0n)

        for k in 1::step do
            let above = if k < row.count then row[k] else 0n fi

            following.add(bigint(k) * above + row[k - 1])
        od

        row = following
    od

    row
si

write_line("Stirling numbers of the second kind, S2(n, k):")
write_line("")

write_line(
    ["{"n/k",3}"] ++ (0::12 |> map(k => "{k,10}"))
    |> join(""))

for n in 0::12 do
    write_line(
        ["{n,3}"] ++ (row_of(n) |> map(v => "{v,10}"))
        |> join(""))
od

let largest = (row_of(100) |> max())!

write_line("")
write_line("the largest S2(100, k):")
write_line("  {largest}")
