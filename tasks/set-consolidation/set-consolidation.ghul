use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

consolidate(input: List[Set[string]]) -> List[Set[string]] is
    let result = LIST[SET[string]]()

    for candidate in input do
        let merged = SET(candidate)
        let kept = LIST()

        for existing in result do
            if existing |> any(merged.contains) then
                merged.union_with(existing)
            else
                kept.add(existing)
            fi
        od

        kept.add(merged)
        result.clear()
        result.add_range(kept)
    od

    result
si

render(sets: List[Set[string]]) -> string =>
    sets |> map(one => "{{{one |> sort() |> join(", ")}}}") |> join(" ")

show(groups: string[][]) is
    let sets = groups |> map(SET) |> list()

    write_line("{render(sets)}")
    write_line("  consolidates to {render(consolidate(sets))}")
si

show([["A", "B"], ["C", "D"]])
show([["A", "B"], ["B", "D"]])
show([["A", "B"], ["C", "D"], ["D", "B"]])
show([
    ["H", "I", "K"],
    ["A", "B"],
    ["C", "D"],
    ["D", "B"],
    ["F", "G", "H"]
])
