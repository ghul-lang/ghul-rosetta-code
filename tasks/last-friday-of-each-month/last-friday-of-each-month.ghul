use default
use Time

last_friday(year: int, month: int) -> DATE_TIME =>
    let last_day = DATE_TIME(
        year,
        month,
        DATE_TIME.days_in_month(year, month)
    )
    in
    from(0)
        |> map(back => last_day.add_days(-double(back)))
        |> find(day => day.day_of_week =~ DayOfWeek.FRIDAY)!

last_fridays(year: int) -> DATE_TIME{} => 1::12 |> map(last_friday(year, *))

let year = 2012

last_fridays(year) |> each(friday => write_line("{friday:yyyy-MM-dd}"))
