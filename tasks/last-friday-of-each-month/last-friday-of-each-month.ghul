use default
use System

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`
// `=~` compares values (structural equality)

last_friday(year: int, month: int) -> DateTime =>
    let last_day = DateTime(
        year,
        month,
        DateTime.days_in_month(year, month)
    )
    in
    from(0)
        |> map(back => last_day.add_days(-double(back)))
        |> find(day => day.day_of_week =~ DayOfWeek.FRIDAY)!

last_fridays(year: int) -> DateTime{} => 1::12 |> map(last_friday(year, *))

let year = 2012

last_fridays(year) |> each(friday => write_line("{friday:yyyy-MM-dd}"))
