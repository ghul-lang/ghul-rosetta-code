use default
use System.Numerics.Complex

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`
// `==` compares identity

every_other(x: Complex[], start: int) -> Complex[] =>
    x
        |> index()
        |> filter(e => e.index % 2 == start)
        |> map(e => e.value)
        |> list()

twiddle(k: int, n: int) -> Complex =>
    Complex.from_polar_coordinates(
        1.0D,
        -2.0D * pi * double(k) / double(n)
    )

fft(x: Complex[]) -> Complex[] is
    let n = x.count

    if n <= 1 then
        return x
    fi

    let even = fft(every_other(x, 0))
    let odd = fft(every_other(x, 1))

    let turned = 0..n / 2 |> map(k => twiddle(k, n) * odd[k]) |> list()

    0..n / 2
        |> map(k => even[k] + turned[k])
        |> cat(0..n / 2 |> map(k => even[k] - turned[k]))
        |> list()
si

tidy(v: double) -> double => if abs(v) < 1.0e-12 then 0.0D else v fi

show(c: Complex) -> string =>
    "({tidy(c.real),8:F4}, {tidy(c.imaginary),8:F4})"

let input = [1.0D, 1.0D, 1.0D, 1.0D, 0.0D, 0.0D, 0.0D, 0.0D]
    |> map(Complex(*, 0.0D))
    |> list()

write_line("input:  {input |> map(c => c.real) |> join(", ")}")
write_line("")

for (i, value) in input |> fft() |> index() do
    write_line("X[{i}] = {show(value)}  magnitude {value.magnitude:F4}")
od
