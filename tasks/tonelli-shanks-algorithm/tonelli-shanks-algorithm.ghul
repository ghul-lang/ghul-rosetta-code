use default

legendre(a: bigint, p: bigint) -> bigint =>
    bigint.mod_pow(a, (p - 1n) / 2n, p)

// The two square roots of n modulo the odd prime p, if n has any.
tonelli_shanks(n: bigint, p: bigint) -> (bigint, bigint)? is
    if !legendre(n, p).is_one then
        return null
    fi

    let q mut = p - 1n
    let s mut = 0

    while q.is_even do
        q = q / 2n
        s = s + 1
    od

    if s == 1 then
        let r = bigint.mod_pow(n, (p + 1n) / 4n, p)

        return (r, p - r)
    fi

    let z mut = 2n

    while legendre(z, p) !~ p - 1n do
        z = z + 1n
    od

    let c mut = bigint.mod_pow(z, q, p)
    let r mut = bigint.mod_pow(n, (q + 1n) / 2n, p)
    let t mut = bigint.mod_pow(n, q, p)
    let m mut = s

    while !t.is_one do
        let i mut = 1
        let t2 mut = t * t % p

        while !t2.is_one do
            t2 = t2 * t2 % p
            i = i + 1
        od

        let b = bigint.mod_pow(c, bigint.pow(2n, m - i - 1), p)

        r = r * b % p
        c = b * b % p
        t = t * c % p
        m = i
    od

    (r, p - r)
si

let cases = [
    (10n, 13n),
    (56n, 101n),
    (1030n, 10009n),
    (1032n, 10009n),
    (44402n, 100049n),
    (665820697n, 1000000009n),
    (881398088036n, 1000000000039n),
    (
        41660815127637347468140745042827704103445750172002n,
        bigint.pow(10n, 50) + 577n
    )
]

for (n, p) in cases do
    write_line("n = {n}")
    write_line("p = {p}")

    if let (r1, r2) = tonelli_shanks(n, p) then
        write_line("    roots {r1} and {r2}")
    else
        write_line("    no root")
    fi

    write_line("")
od
