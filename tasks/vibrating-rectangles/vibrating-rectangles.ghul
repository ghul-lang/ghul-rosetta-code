use default
use Raster.ANIMATION
use Raster.IMAGE

let width = 240
let height = 180
let rectangles = 21
let spacing = 4.0
let frames = 42

channel(hue, offset) =>
    let wave = 0.5 + 0.5 * cos(2.0 * pi * (hue - offset)) in
    ubyte(round(40.0 + 215.0 * wave))

draw(image, frame) is
    image.clear(10ub, 10ub, 15ub)
    image.stroke(2.0)

    for ring in 0..rectangles do
        let inset = spacing * double(ring) + 2.0
        let hue = double(frame - 2 * ring) / double(frames)

        image.color(
            channel(hue, 0.0),
            channel(hue, 1.0 / 3.0),
            channel(hue, 2.0 / 3.0)
        )

        let left = inset
        let top = inset
        let right = double(width) - inset
        let bottom = double(height) - inset

        image.line([
            (x = left, y = top), (x = right, y = top),
            (x = right, y = bottom), (x = left, y = bottom),
            (x = left, y = top)
        ])
    od
si

let image = IMAGE(width, height)
let animation = ANIMATION(width, height)

for frame in 0..frames do
    draw(image, frame)
    animation.add(image, 50)
od

write_line("{rectangles} rectangles around one center, the color fading")
write_line("in from the outermost to the innermost")

animation.write("rectangles.png")

animation.show("rectangles.png")
