use default
use System.Net.Http.HttpClient
use System.Text.Json.JsonDocument
use System.Text.Json.JsonDocumentOptions
use System.Text.RegularExpressions.Regex

// The task: count the examples on every task page, which is the number of
// language headers in its wikitext. The API lists the tasks a batch at a
// time, continuing until there are no more, and gives each page's wikitext
// on request.
count_examples(api: string) is
    let client = HttpClient()

    // The wiki refuses a request that does not say what is making it.
    client.default_request_headers.user_agent
        .parse_add("ghul-rosetta-code/1.0")

    let get = query =>
        let text = client.get_string_async("{api}?{query}").result in
        JsonDocument.parse(text, _[JsonDocumentOptions]).root_element

    let listing =
        "action=query&list=categorymembers"
        "&cmtitle=Category:Programming_Tasks"
        "&cmlimit=5&cmprop=title&format=json&formatversion=2"
    let next mut = ""
    let total mut = 0

    do
        let batch = get("{listing}{next}")
        let tasks =
            batch.get_property("query")
                .get_property("categorymembers")

        for task in tasks.enumerate_array() do
            let title = task.get_property("title").get_string() ?? ""
            let page = get(
                "action=parse&prop=wikitext&format=json&formatversion=2"
                "&page={System.Uri.escape_data_string(title)}")
            let text =
                page.get_property("parse")
                    .get_property("wikitext").get_string() ?? ""
            let examples = Regex.matches(text, "=={{{{header\\|").count

            write_line("{title}: {examples} examples.")
            total = total + examples
        od

        let more: System.Text.Json.JsonElement mut = _

        if !batch.try_get_property("continue", more ref) then
            break
        fi

        let token = more.get_property("cmcontinue").get_string() ?? ""

        next =
            "&cmcontinue={System.Uri.escape_data_string(token)}"
            "&continue=-||"
    od

    write_line("")
    write_line("Total: {total} examples.")
si

count_examples("https://rosettacode.org/w/api.php")
