use default
use Raster.IMAGE
use System.Math.*

let bins = 10

class TALLY is
    count: int
    total: double
    squares: double
    histogram: LIST[int]

    init() is
        histogram = repeat(0, bins) |> collect_mutable()
    si

    add(x: double) is
        count = count + 1
        total = total + x
        squares = squares + x * x

        let bin = min(int(x * double(bins)), bins - 1)

        histogram[bin] = histogram[bin] + 1
    si

    mean: double => total / double(count)

    deviation: double =>
        sqrt(squares / double(count) - mean * mean)
si

let random = System.Random(100)

samples() -> double{} is
    while true do
        yield random.next_double()
    od
si

let sizes = [100, 1000, 10000, 100000, 1000000]
let tallies = LIST()

write_line("      size       mean     stddev")

for size in sizes do
    let tally = TALLY()

    samples() |> take(size) |> each(x => tally.add(x))
    tallies.add(tally)

    write_line(
        "{size,10}   {tally.mean:F6}   {tally.deviation:F6}")
od

write_line()
write_line("1/sqrt(12) = {1.0D / sqrt(12.0D):F6}")
write_line()
write_line("histogram of the 1000 sample:")

let small = tallies[1]
let tallest = small.histogram |> reduce(0, (a, b) => max(a, b))

for bin in 0..bins do
    let n = small.histogram[bin]
    let low = double(bin) / double(bins)

    write_line(
        "  {low:F1} - {low + 0.1D:F1} {n,4} "
        "{"".pad_right(n * 50 / tallest, '#')}")
od

let shown = [0, 2, 4]
let panel = 220.0D

let image = IMAGE(int(panel) * shown.count, 200)

image.view(0.0D, 0.0D, panel * double(shown.count), 200.0D)
image.clear(252ub, 252ub, 250ub)

for (which, place) in
        shown |> index() |> map(iv => (iv.value, iv.index)) do
    let tally = tallies[which]
    let left = panel * double(place) + 15.0D
    let width = (panel - 30.0D) / double(bins)

    for bin in 0..bins do
        let share =
            double(tally.histogram[bin]) / double(tally.count)
        let x = left + width * double(bin)

        image.colour(60ub, 110ub, 190ub)
        image.fill_rectangle(
            x + 1.0D, 30.0D, x + width - 1.0D, 30.0D + share * 1000.0D)
    od

    image.colour(220ub, 60ub, 40ub)
    image.line(left, 130.0D, left + panel - 30.0D, 130.0D)

    image.colour(40ub, 40ub, 40ub)
    image.text(
        left + (panel - 30.0D) / 2.0D, 10.0D, 13.0D,
        "{tally.count:N0} samples", Raster.Anchor.CENTRE)
od

image.write("histograms.png")

image.show("histograms.png")
