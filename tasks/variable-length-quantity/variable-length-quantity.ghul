use default

// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

to_octets(value: long) -> ubyte[] => (
    let octets = LIST([ubyte(value & 0x7FL)])
    let rest mut = value >> 7

    while rest > 0L do
        octets.insert(0, cast((rest & 0x7FL) | 0x80L))
        rest = rest >> 7
    od

    octets
)

from_octets(octets: ubyte[]) -> long =>
    octets
        |> reduce(0L, (value, octet) =>
            (value << 7) | cast(cast(octet) & 0x7F)
        )

as_hex(octet: ubyte) -> string => "{octet:X2}"

[0x200000L, 0x1FFFFFL]
    |> each(value => (
        let octets = to_octets(value)
        let shown = octets |> map(as_hex) |> join(" ")

        write_line(
            "{value,8} = 0x{value:X6} -> {shown}"
            " -> {from_octets(octets)}"
        )
    ))
