use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `T{}` is a lazy sequence of `T`, read by iterating it.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

is_magnanimous(value: int) -> bool =>
    let digits = "{value}" in
    1..digits.length
        |> all(split =>
            is_prime(
                System.Convert.to_int32(digits[0..split]) +
                System.Convert.to_int32(digits[split..<0])
            )
        )

magnanimous() -> int{} => from(0) |> filter(is_magnanimous)

let terms = magnanimous() |> take(400) |> list()

write_line("the first 45 magnanimous numbers:")

for row in 0::4 do
    let last = if row == 4 then 45 else row * 10 + 10 fi
    let cells = terms[row * 10..last] |> map(term => "{term,6}")

    write_line("  {cells |> join("")}")
od

write_line("")
write_line("the 241st to 250th:")
write_line("  {terms[240..250] |> map(t => "{t,8}") |> join("")}")

write_line("")
write_line("the 391st to 400th:")
write_line("  {terms[390..400] |> map(t => "{t,8}") |> join("")}")
