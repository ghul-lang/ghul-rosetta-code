use default

sorted_string(s: string) -> string is
    let chars = s |> collect_mutable()

    chars.sort((x, y) =>
        if x < y then -1 elif x == y then 0 else 1 fi)
    chars |> map(c => "{c}") |> join("")
si

fangs(n: long) -> (long, long){} is
    let half = "{n}".length / 2
    let low mut = 1L
    let digits mut = 1

    while digits < half do
        low = low * 10L
        digits = digits + 1
    od

    let a mut = low

    while a * a <= n do
        if n % a == 0L then
            let b = n / a

            if b < low * 10L /\ (a % 10L != 0L \/ b % 10L != 0L) /\
                    sorted_string("{a}{b}") =~ sorted_string("{n}") then
                yield (a, b)
            fi
        fi

        a = a + 1L
    od
si

fang_text(n: long) -> string is
    let pairs = fangs(n) |> collect()

    if pairs.count == 0 then
        "{n}: not a vampire number"
    else
        let texts = pairs
            |> map((a, b) => "{a} x {b}")
        "{n}: {texts |> join(", ")}"
    fi
si

let first mut = 0
let n mut = 1000L

while first < 25 do
    if "{n}".length % 2 == 0 /\ fangs(n) |> any(_ => true) then
        write_line(fang_text(n))
        first = first + 1
    fi

    n = n + 1L
od

for candidate in [16758243290880L, 24959017348650L, 14593825548650L] do
    write_line(fang_text(candidate))
od
