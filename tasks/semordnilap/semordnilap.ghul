use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `SET()` builds its collection eagerly
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

reversed(s: string) -> string => string(s.to_char_array() |> reverse())

let words = SET(IO.File.read_all_lines("unixdict.txt"))

let pairs =
    words
        |> filter(w => let r = reversed(w) in w < r /\ words.contains(r))
        |> sort()
        |> list()

write_line("{pairs.count} semordnilap pairs, including:")

for word in pairs |> skip(pairs.count / 2) |> take(5) do
    write_line("{word,-10} {reversed(word)}")
od
