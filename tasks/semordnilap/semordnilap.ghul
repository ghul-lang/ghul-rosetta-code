use default

reversed(s: string) -> string =>
    string(s.to_char_array() |> reverse())

let words = SET(IO.File.read_all_lines("unixdict.txt"))

let pairs =
    words
        |> filter(w => let r = reversed(w) in w < r /\ words.contains(r))
        |> sort()
        |> collect()

write_line("{pairs.count} semordnilap pairs, including:")

for word in pairs |> skip(pairs.count / 2) |> take(5) do
    write_line("{word,-10} {reversed(word)}")
od
