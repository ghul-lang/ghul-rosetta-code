use default

let limit = 11_000
let orders = 11

is_prime(n: int) -> bool =>
    n > 1 /\ (2..n) |> take_while(d => d * d <= n) |> all(d => n % d != 0)

factorials_mod(count: int, modulus: long) -> List[long] => (
    let result = LIST([1L])

    for k in 1..count do
        result.add(result[k - 1] * long(k) % modulus)
    od

    result
)

is_wilson(p: int, n: int, factorials: List[long], modulus: long) -> bool =>
    let sign = if n % 2 == 0 then 1L else -1L fi in
    let product = factorials[n - 1] * factorials[p - n] % modulus in
    (product - sign + modulus) % modulus == 0L


// the orders n for which p is a Wilson prime, from one table of factorials
orders_of(p: int) -> List[int] =>
    let
        modulus = long(p) * long(p),
        factorials = factorials_mod(p, modulus)
    in
        1::orders
            |> filter(n => n <= p /\ is_wilson(p, n, factorials, modulus))
            |> collect()

let found = 2..limit |> filter(is_prime) |> map(p => (p, orders_of(p)))
    |> collect()

let wilson =
    [[p for (p, ns) in found if ns |> contains(n)] for n in 1::orders]

write_line("Wilson primes below {limit}:")
write_line(" n  primes")

for (n, primes) in wilson |> index() do
    let listed =
        if primes.count == 0 then
            "none"
        else
            primes |> map(p => "{p}") |> join(" ")
        fi

    write_line("{n + 1,2}  {listed}")
od
