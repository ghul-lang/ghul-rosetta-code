use default

// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

let limit = 11_000
let orders = 11

factorials_mod(count: int, modulus: long) -> long[] => (
    let result = LIST([1L])

    for k in 1..count do
        result.add(result[k - 1] * long(k) % modulus)
    od

    result
)

is_wilson(p: int, n: int, factorials: long[], modulus: long) -> bool =>
    let
        sign = if n % 2 == 0 then 1L else -1L fi,
        product = factorials[n - 1] * factorials[p - n] % modulus
    in
        (product - sign + modulus) % modulus == 0L

orders_of(p: int) -> int[] =>
    let
        modulus = long(p) * long(p),
        factorials = factorials_mod(p, modulus)
    in
        1::orders
            |> filter(n => n <= p /\ is_wilson(p, n, factorials, modulus))
            |> list()

let found =
    2..limit |> filter(is_prime) |> map(p => (p, orders_of(p))) |> list()

let wilson = [
    [p for (p, ns) in found if ns |> contains(n)]
    for n in 1::orders
]

write_line("Wilson primes below {limit}:")
write_line(" n  primes")

for (n, primes) in wilson |> index() do
    let listed =
        if primes.count == 0 then
            "none"
        else
            primes |> map(p => "{p}") |> join(" ")
        fi

    write_line("{n + 1,2}  {listed}")
od
