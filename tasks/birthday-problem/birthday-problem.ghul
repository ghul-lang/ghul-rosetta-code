use default
use Raster.Anchor
use Raster.IMAGE

let days = 365
let random = System.Random(365)
let counts = repeat(0, days) |> LIST()

shared(people: int, at_least: int) -> bool is
    for day in 0..days do
        counts[day] = 0
    od

    for _ in 0..people do
        let day = random.next(days)

        counts[day] = counts[day] + 1

        if counts[day] >= at_least then
            return true
        fi
    od

    false
si

simulated(people: int, at_least: int, trials: int) -> double =>
    let hits = 0..trials |> filter(_ => shared(people, at_least)) |> count()
    in
    double(hits) / double(trials)

log_factorial(n: int) -> double =>
    1::n |> reduce(0.0, (s, i) => s + log(double(i)))

exact(most: int, at_least: int) -> double[] is
    let inverse_factorial =
        (0..at_least) |> map(j => 1.0 / exp(log_factorial(j))) |> list()

    let nobody = [if m == 0 then 1.0 else 0.0 fi for m in 0::most]

    let ways =
        0..days
            |> reduce(nobody, (ways, _) => [
                0..min(at_least, m + 1)
                    |> map(j => ways[m - j] * inverse_factorial[j])
                    |> sum()
                for m in 0::most
            ])

    (0::most)
        |> map(n =>
            let log_scale = log_factorial(n) - double(n) * log(double(days))
            in
            1.0 - ways[n] * exp(log_scale)
        )
        |> list()
si

first_even(chance: (int) -> double, low: int, high: int) -> int =>
    if low >= high then
        low
    else
        let middle = (low + high) / 2 in
        if chance(middle) > 0.5 then
            first_even(chance, low, middle)
        else first_even(chance, middle + 1, high)
        fi
    fi

let crossings = LIST()
let curves = LIST[double[]]()
let start mut = 2

for at_least in 2::5 do
    let estimate = first_even(simulated(*, at_least, 10000), start, 600)
    let curve = exact(600, at_least)
    let answer = first_even(n => curve[n], start, 600)

    curves.add(curve)

    crossings.add(answer)
    start = answer

    write_line(
        "{at_least} sharing: simulated {estimate}, exactly {answer} "
        "({100.0 * curve[answer]:F2}%)"
    )
od

let image = IMAGE(480, 300)
let most = 400

image.view(-40.0, -0.15, double(most) + 10.0, 1.08)
image.clear(252ub, 250ub, 245ub)

image.color(200ub, 200ub, 205ub)
image.stroke(1.0)
image.line(0.0, 0.5, double(most), 0.5)
image.line(0.0, 0.0, double(most), 0.0)
image.line(0.0, 0.0, 0.0, 1.0)

let colors = [
    (200ub, 50ub, 40ub), (40ub, 130ub, 60ub),
    (40ub, 80ub, 180ub), (150ub, 60ub, 170ub)
]

for (i, at_least) in 2::5 |> index() do
    let (r, g, b) = colors[i]
    let curve =
        (1::most / 4)
            |> map(* * 4)
            |> map(n => (x = double(n), y = curves[i][n]))
            |> list()

    image.color(r, g, b)
    image.stroke(2.0)
    image.line(curve)

    let crossing = double(crossings[i])

    image.ring(crossing, 0.5, 4.0)
    let label = "{crossings[i]}"

    image.text(crossing - 6.0, 0.56, 11.0, label, Anchor.RIGHT)
od

image.color(60ub, 60ub, 60ub)
image.text(-8.0, 0.47, 11.0, "50%", Anchor.RIGHT)
image.text(
    double(most) / 2.0,
    -0.12,
    12.0,
    "people in the group",
    Anchor.CENTER
)

image.write("birthdays.png")

image.show("birthdays.png")
