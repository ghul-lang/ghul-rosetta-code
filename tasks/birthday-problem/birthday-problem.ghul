use default
use Raster.Anchor
use Raster.IMAGE
use System.Math.*

let days = 365
let random = System.Random(365)
let counts = repeat(0, days) |> collect_mutable()

shared(people: int, at_least: int) -> bool is
    for day in 0..days do
        counts[day] = 0
    od

    for _ in 0..people do
        let day = random.next(days)

        counts[day] = counts[day] + 1

        if counts[day] >= at_least then
            return true
        fi
    od

    false
si

simulated(people: int, at_least: int, trials: int) -> double =>
    let hits =
        0..trials |> filter(_ => shared(people, at_least)) |> count() in
    double(hits) / double(trials)

log_factorial(n: int) -> double =>
    1::n |> reduce(0.0D, (s, i) => s + log(double(i)))

// After each day, ways[m] measures how many ways m people can have
// birthdays on the days so far with fewer than at_least of them on any
// one day. Each new day takes j of the m people, for every j that keeps
// it under the limit.
exact(most: int, at_least: int) -> List[double] is
    let inverse_factorial =
        (0..at_least)
            |> map(j => 1.0D / exp(log_factorial(j)))
            |> collect()

    let nobody = [if m == 0 then 1.0D else 0.0D fi for m in 0::most]

    let ways = 0..days |> reduce(nobody, (ways, _) => [
        0..min(at_least, m + 1)
            |> map(j => ways[m - j] * inverse_factorial[j])
            |> sum()
        for m in 0::most
    ])

    (0::most)
        |> map(n =>
            let log_scale =
                log_factorial(n) -
                double(n) * log(double(days)) in
            1.0D - ways[n] * exp(log_scale))
        |> collect()
si

// A binary search for the smallest group size between low and high
// whose chance is more than a half.
first_even(chance: (int) -> double, low: int, high: int) -> int =>
    if low >= high then
        low
    else
        let middle = (low + high) / 2 in
        if chance(middle) > 0.5D then first_even(chance, low, middle)
        else first_even(chance, middle + 1, high)
        fi
    fi

let crossings = LIST()
let curves = LIST[List[double]]()
let start mut = 2

for at_least in 2::5 do
    let estimate = first_even(simulated(*, at_least, 10000), start, 600)
    let curve = exact(600, at_least)
    let answer = first_even(n => curve[n], start, 600)

    curves.add(curve)

    crossings.add(answer)
    start = answer

    write_line(
        "{at_least} sharing: simulated {estimate}, exactly {answer} "
        "({100.0D * curve[answer]:F2}%)")
od

let image = IMAGE(480, 300)
let most = 400

image.view(-40.0D, -0.15D, double(most) + 10.0D, 1.08D)
image.clear(252ub, 250ub, 245ub)

image.colour(200ub, 200ub, 205ub)
image.stroke(1.0D)
image.line(0.0D, 0.5D, double(most), 0.5D)
image.line(0.0D, 0.0D, double(most), 0.0D)
image.line(0.0D, 0.0D, 0.0D, 1.0D)

let colours = [
    (200ub, 50ub, 40ub), (40ub, 130ub, 60ub),
    (40ub, 80ub, 180ub), (150ub, 60ub, 170ub)
]

for (i, at_least) in 2::5 |> index() do
    let (r, g, b) = colours[i]
    let curve =
        (1::most / 4)
            |> map(* * 4)
            |> map(n => (x = double(n), y = curves[i][n]))
            |> collect()

    image.colour(r, g, b)
    image.stroke(2.0D)
    image.line(curve)

    let crossing = double(crossings[i])

    image.ring(crossing, 0.5D, 4.0D)
    let label = "{crossings[i]}"

    image.text(crossing - 6.0D, 0.56D, 11.0D, label, Anchor.RIGHT)
od

image.colour(60ub, 60ub, 60ub)
image.text(-8.0D, 0.47D, 11.0D, "50%", Anchor.RIGHT)
image.text(
    double(most) / 2.0D, -0.12D, 12.0D,
    "people in the group", Anchor.CENTRE)

image.write("birthdays.png")

image.show("birthdays.png")
