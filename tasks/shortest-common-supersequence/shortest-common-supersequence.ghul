use default

shortest_supersequence(u: string, v: string) -> string memo =>
    if u.length == 0 then
        v
    elif v.length == 0 then
        u
    elif u[0] == v[0] then
        "{u[0]}{shortest_supersequence(u[1..<0], v[1..<0])}"
    else
        let keep_u = "{u[0]}{shortest_supersequence(u[1..<0], v)}"
        let keep_v = "{v[0]}{shortest_supersequence(u, v[1..<0])}"

        if keep_u.length <= keep_v.length then keep_u else keep_v fi
    fi

let u = "abcbdab"
let v = "bdcaba"

write_line("u = {u}")
write_line("v = {v}")
write_line("s = {shortest_supersequence(u, v)}")
