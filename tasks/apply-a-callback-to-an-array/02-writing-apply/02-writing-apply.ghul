use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `LIST()` builds its collection eagerly
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

apply[T, U](values: T[], callback: T -> U) -> U{} => (
    let applied = LIST()

    for value in values do
        applied.add(callback(value))
    od

    applied
)

shout(word: string) -> string => "{word.to_upper()}!"

write_line("{$([1, 2, 3, 4, 5] |> apply(value => value * value))}")
write_line("{$(["frog", "newt", "toad"] |> apply(shout))}")
