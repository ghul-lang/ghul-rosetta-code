use default

trait Clock is
    now: Time.DateTime
    wait_until(time: Time.DateTime)
si

class SYSTEM_CLOCK: Clock is
    init() is si

    now: Time.DateTime => Time.DateTime.utc_now

    wait_until(time: Time.DateTime) is
        let delay = time - now

        if delay > Time.TimeSpan.zero then
            Tasks.Thread.sleep(delay)
        fi
    si
si

class SIMULATED_CLOCK(start: Time.DateTime): Clock is
    _time: Time.DateTime

    init(..) is
        _time = start
    si

    now: Time.DateTime => _time

    wait_until(time: Time.DateTime) is
        _time = time
    si
si

watch(time: Time.DateTime) -> string =>
    let hour = time.add_minutes(-1.0).hour in
    case hour
    when 0..4 then "Middle watch"
    when 4..8 then "Morning watch"
    when 8..12 then "Forenoon watch"
    when 12..16 then "Afternoon watch"
    when 16..18 then "First dog watch"
    when 18..20 then "Last dog watch"
    else "First watch"
    esac

ring(bells: int) -> string =>
    (0..bells / 2)
        |> map(_ => "ding-dong")
        |> cat(if bells % 2 == 1 then ["ding"] else [] fi)
        |> join(" ")

keep_watch(clock: Clock, until: Time.DateTime) is
    let now = clock.now
    let half_hours = int(now.time_of_day.total_minutes) / 30 + 1
    let next mut = now.date.add_minutes(30.0 * half_hours)

    while next <= until do
        clock.wait_until(next)

        let count = next.hour % 4 * 2 + next.minute / 30
        let bells = if count == 0 then 8 else count fi
        let plural = if bells == 1 then " " else "s" fi

        write_line(
            "{next:HH:mm}  {bells} bell{plural}  "
            "{watch(next),-15}  {ring(bells)}"
        )

        next = next.add_minutes(30.0)
    od
si

if let ["--live", ..] = args then
    keep_watch(SYSTEM_CLOCK(), Time.DateTime.max_value)
else
    let midnight = Time.DateTime(2026, 1, 1, 0, 0, 0, Time.DateTimeKind.UTC)

    keep_watch(SIMULATED_CLOCK(midnight), midnight.add_days(1.0))
fi
