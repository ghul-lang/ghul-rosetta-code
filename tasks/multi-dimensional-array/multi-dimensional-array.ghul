use default

// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|> LIST()` reads the whole sequence into a new `LIST`
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

let extents = [2, 3, 4, 5]

let cells =
    0..extents[0]
        |> map(_ =>
            0..extents[1]
                |> map(_ =>
                    0..extents[2]
                        |> map(_ => repeat(0, extents[3]) |> LIST())
                        |> list()
                )
                |> list()
        )
        |> list()

write_line("{extents.count} dimensions, extents {extents |> join(" by ")}")

cells[1][2][3][4] = 42

write_line("cells[1][2][3][4] = {cells[1][2][3][4]}")
write_line("cells[0][0][0][0] = {cells[0][0][0][0]}")

let size = extents |> product()
let flat = repeat(0, size) |> LIST()

at(index: int[]) -> int =>
    0..extents.count
        |> reduce(0, (offset, dimension) =>
            offset * extents[dimension] + index[dimension]
        )

flat[at([1, 2, 3, 4])] = 42

let offset = at([1, 2, 3, 4])
let neighbour = at([1, 2, 3, 3])

write_line("stored row-major in one list of {size}")
write_line("offset {offset} holds {flat[offset]}")
write_line("its neighbour {neighbour} holds {flat[neighbour]}")
