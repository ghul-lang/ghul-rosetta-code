use default
use IO.Std

let program =
    "15 17 -1 17 -1 -1 16 1 -1 16 3 -1 15 15 0 0 -1 "
    "72 101 108 108 111 44 32 119 111 114 108 100 33 10 0"

let memory =
    LIST(
        program.split([' '], System.StringSplitOptions.REMOVE_EMPTY_ENTRIES)
            |> map(word => int.parse(word)))

let ip mut = 0

while ip >= 0 do
    let (a, b, c) = (memory[ip], memory[ip + 1], memory[ip + 2])
    ip = ip + 3

    if a == -1 then
        memory[b] = Std.read()
    elif b == -1 then
        Std.write(char(memory[a]))
    else
        memory[b] = memory[b] - memory[a]

        if memory[b] <= 0 then
            ip = c
        fi
    fi
od
