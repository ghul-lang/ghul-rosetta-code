use default

// every way to place the blocks, leftmost first, each separated by at
// least one empty cell; yields the start position of each block

placements(cells: int, blocks: List[int]) -> List[int]{} is
    if blocks.count == 0 then
        yield []
    else
        let first = blocks[0]
        let rest = blocks |> skip(1) |> collect()
        let needed = (rest |> sum()) + rest.count

        for start in 0::cells - first - needed do
            let offset = start + first + 1

            for tail in placements(int.max(cells - offset, 0), rest) do
                let shifted = tail |> map(p => p + offset)

                yield [start] |> cat(shifted) |> collect()
            od
        od
    fi
si

draw(cells: int, blocks: List[int], starts: List[int]) -> string =>
    let filled =
        starts
            |> index()
            |> flat_map((i, start) => start..start + blocks[i])
            |> collect_set()
    in
    let row =
        0..cells |> map(c => if filled.contains(c) then "#" else "_" fi)
    in
    "|{row |> join("|")}|"

let cases: List[(cells: int, blocks: List[int])] = [
    (5, [2, 1]), (5, []), (10, [8]), (15, [2, 3, 2, 3]), (5, [2, 3])
]

for (cells, blocks) in cases do
    let found = placements(cells, blocks) |> collect()

    write_line("{cells} cells and {blocks} blocks: {found.count} positions")

    for starts in found do
        write_line("    {draw(cells, blocks, starts)}")
    od
od
