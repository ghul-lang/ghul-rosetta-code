use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `SET[T]` is a mutable set, holding each element once
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|> SET()` reads the whole sequence into a new `SET`
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`
// `case ... when` pattern-matches, and `[x, ..rest]` matches a list head
//  and tail

// every way to place the blocks, leftmost first, each separated by at
// least one empty cell; yields the start position of each block

placements(cells: int, blocks: int[]) -> int[]{} is
    case blocks
    when [] then
        yield []
    when [first, ..rest] then
        let needed = (rest |> sum()) + rest.count

        for start in 0::cells - first - needed do
            let offset = start + first + 1

            for tail in placements(int.max(cells - offset, 0), rest) do
                let shifted = tail |> map(* + offset)

                yield [start] ++ shifted |> list()
            od
        od
    esac
si

draw(cells: int, blocks: int[], starts: int[]) -> string =>
    let filled =
        starts
            |> index()
            |> flat_map((i, start) => start..start + blocks[i])
            |> SET()
    in
    let row =
        0..cells |> map(c => if filled.contains(c) then "#" else "_" fi)
    in
    "|{row |> join("|")}|"

let cases: (cells: int, blocks: int[])[] = [
    (5, [2, 1]), (5, []), (10, [8]), (15, [2, 3, 2, 3]), (5, [2, 3])
]

for (cells, blocks) in cases do
    let found = placements(cells, blocks) |> list()

    write_line("{cells} cells and {blocks} blocks: {found.count} positions")

    for starts in found do
        write_line("    {draw(cells, blocks, starts)}")
    od
od
