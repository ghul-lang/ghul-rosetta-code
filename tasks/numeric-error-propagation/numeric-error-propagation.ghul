use default
use System.Math.*

struct UNCERTAIN(value: double, error: double) is
    +(other: UNCERTAIN) -> UNCERTAIN =>
        UNCERTAIN(value + other.value, added_error(other))

    -(other: UNCERTAIN) -> UNCERTAIN =>
        UNCERTAIN(value - other.value, added_error(other))

    *(other: UNCERTAIN) -> UNCERTAIN =>
        let product = value * other.value in
        UNCERTAIN(product, abs(product) * relative_with(other))

    /(other: UNCERTAIN) -> UNCERTAIN =>
        let quotient = value / other.value in
        UNCERTAIN(
            quotient,
            abs(quotient) * relative_with(other)
        )

    +(c: double) -> UNCERTAIN => UNCERTAIN(value + c, error)
    -(c: double) -> UNCERTAIN => UNCERTAIN(value - c, error)
    *(c: double) -> UNCERTAIN =>
        UNCERTAIN(value * c, abs(c * error))
    /(c: double) -> UNCERTAIN =>
        UNCERTAIN(value / c, abs(error / c))

    added_error(other: UNCERTAIN) -> double =>
        sqrt(error * error + other.error * other.error)

    relative_with(other: UNCERTAIN) -> double =>
        let
            mine = error / value,
            theirs = other.error / other.value
        in
            sqrt(mine * mine + theirs * theirs)

    to_string() -> string => "{value} ± {error}"
si

power(a: UNCERTAIN, c: double) -> UNCERTAIN =>
    let raised = pow(a.value, c) in
    UNCERTAIN(raised, abs(raised * c * a.error / a.value))

let x1 = UNCERTAIN(100.0, 1.1)
let y1 = UNCERTAIN(50.0, 1.2)
let x2 = UNCERTAIN(200.0, 2.2)
let y2 = UNCERTAIN(100.0, 2.3)

let d = power(power(x1 - x2, 2.0) + power(y1 - y2, 2.0), 0.5)

write_line("d = {d}")
