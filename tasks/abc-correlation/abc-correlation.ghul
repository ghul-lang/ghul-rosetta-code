use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `*` as an argument leaves that parameter open: partial application.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

balanced(text: string) -> bool =>
    let counts =
        "abc" |> map(letter => text |> count(* == letter)) |> list()
    in
    counts |> all(* == counts[0])

write_line("Enter strings, one per line:")

while let text = IO.Std.read_line() do
    let verdict = if balanced(text) then "is" else "is not" fi

    write_line("'{text}' {verdict} an ABC string")
od
