use default
rev(t) => t |> graphemes() |> reverse() |> string()
pal(t) => t =~ rev(t)
ipal(t) =>
    pal(
        string(t)
            |> filter(char.is_letter)
            |> map(char.to_lower)
            |> string()
    )

check(t, b) =>
    let m = if (if b then pal else ipal fi)(t) then " " else " not " fi in
    write_line("\"{t}\" is{m}a palindrome")

[
    ("racecar", true),
    ("hello", true),
    ("rotor", true),
    ("A man, a plan, a canal: Panama", false),
    ("race car", false),
    ("hello world", false)
]
    |> each(check)
