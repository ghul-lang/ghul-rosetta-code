use default

rev(t) => t |> graphemes() |> reverse() |> string()
pal(t) => t =~ rev(t)
ipal(t) =>
    pal(
        string(t)
            |> filter(char.is_letter)
            |> map(char.to_lower)
            |> string()
    )

check(t, f) =>
    let m = if f(t) then " " else " not " fi in
    write_line("\"{t}\" is{m}a palindrome")

[
    ("racecar", pal),
    ("hello", pal),
    ("rotor", pal),
    ("A man, a plan, a canal: Panama", ipal),
    ("race car", ipal),
    ("hello world", ipal)
]
    |> each(check)
