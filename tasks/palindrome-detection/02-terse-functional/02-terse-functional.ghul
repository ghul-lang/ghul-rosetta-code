use default
rev(t)=>t|>graphemes()|>reverse()|>string()
pal(t)=>t=~rev(t)
ipal(t: string)=>t|>filter(char.is_letter)|>map(char.to_lower)|>string()|>pal()
test(t: string,f: (string) -> bool)=>write_line("\"{t}\" is{if f(t) then " " else " not " fi}a palindrome")
test("racecar",pal)
test("hello",pal)
test("rotor",pal)
test("A man, a plan, a canal: Panama",ipal)
test("race car",ipal)
test("hello world",ipal)
