use default
use Raster.COLOR_MAP
use Raster.IMAGE
use Raster.SHAPES

use Square = (file: int, rank: int)

let size = 8
let start = (file = 0, rank = 0)

let leaps = [
    (file = 1, rank = 2), (file = 2, rank = 1),
    (file = 2, rank = -1), (file = 1, rank = -2),
    (file = -1, rank = -2), (file = -2, rank = -1),
    (file = -2, rank = 1), (file = -1, rank = 2)
]

at(square: Square) -> int => square.rank * size + square.file

named(square: Square) -> string =>
    "{char(int('a') + square.file)}{square.rank + 1}"

inside(square: Square) -> bool =>
    square.file >= 0 /\
    square.file < size /\
    square.rank >= 0 /\
    square.rank < size

let visit_order = repeat(0, size * size) |> LIST()

onward(square: Square) -> Square{} =>
    leaps
        |> map(leap => (
            file = square.file + leap.file,
            rank = square.rank + leap.rank
        ))
        |> filter(next => inside(next) /\ visit_order[at(next)] == 0)

let tour = LIST([start])

visit_order[at(start)] = 1

while tour.count < size * size do
    let square = tour[tour.count - 1]

    let next =
        square
            |> onward()
            |> min_by(candidate => onward(candidate) |> count()) ?? square

    assert at(next) != at(square) else "the tour reached a dead end"

    visit_order[at(next)] = tour.count + 1

    tour.add(next)
od

write_line("a knight's tour from {named(start)}")
write_line("")

for row in 0..size do
    let rank = size - 1 - row

    write_line(
        (0..size)
            |> map(file =>
                "{visit_order[at((file = file, rank = rank))],3}"
            )
            |> join("")
    )
od

write_line("")

for row in 0..size do
    write_line(
        (0..size)
            |> map(step => named(tour[row * size + step]))
            |> join(" ")
    )
od

let image = IMAGE(520, 520)

image.view(-0.1, -0.1, 8.1, 8.1)

middle(square: Square) -> (x: double, y: double) => (
    x = double(square.file) + 0.5,
    y = double(square.rank) + 0.5
)

let board = SHAPES()

for rank in 0..size do
    for file in 0..size do
        let corner = (x = double(file), y = double(rank))

        let cell = [
            corner,
            (x = corner.x + 1.0, y = corner.y),
            (x = corner.x + 1.0, y = corner.y + 1.0),
            (x = corner.x, y = corner.y + 1.0)
        ]

        if (file + rank) % 2 == 0 then
            board.add(cell, 226ub, 222ub, 212ub)
        else
            board.add(cell, 246ub, 245ub, 240ub)
        fi
    od
od

image.fill(board)

image.stroke(2.6)

for step in 0..tour.count - 1 do
    let from = middle(tour[step])
    let to = middle(tour[step + 1])

    image.color(COLOR_MAP.viridis(double(step) / double(tour.count)))

    image.line(from.x, from.y, to.x, to.y)
od

image.color(190ub, 40ub, 40ub)
image.dot(middle(start).x, middle(start).y, 6.0)

image.color(40ub, 40ub, 50ub)
image.stroke(1.4)
image.line([
    (x = 0.0, y = 0.0), (x = 8.0, y = 0.0),
    (x = 8.0, y = 8.0), (x = 0.0, y = 8.0),
    (x = 0.0, y = 0.0)
])

image.write("tour.png")

image.show("tour.png")
