use default
use Crypto.sha256

let block_size = 1024

paired(hashes: ubyte[][]) -> ubyte[]{} =>
    0..(hashes.count + 1) / 2
        |> map(index =>
            if 2 * index + 1 < hashes.count then
                sha256(
                    hashes[2 * index] ++ hashes[2 * index + 1] |> ARRAY()
                )
            else
                hashes[2 * index]
            fi
        )

merkle_root(content: ubyte[]) -> ubyte[] is
    let hashes mut =
        0..(content.count + block_size - 1) / block_size
            |> map(index =>
                let
                    at = index * block_size,
                    end = min(at + block_size, content.count)
                in
                    sha256(content[at..end] |> ARRAY())
            )
            |> ARRAY()

    while hashes.count > 1 do
        hashes = hashes |> paired() |> ARRAY()
    od

    return hashes[0]
si

let image = IO.File.read_all_bytes("title.png")

write_line(
    image
        |> merkle_root()
        |> map(byte_value => "{byte_value:x2}")
        |> join("")
)
