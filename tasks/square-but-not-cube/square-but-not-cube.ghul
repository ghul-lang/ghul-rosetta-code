use default

// `T{}` is a lazy sequence of `T`, read by iterating it.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `*` as an argument leaves that parameter open: partial application.

is_cube(n: long) -> bool =>
    let
        estimate = System.Math.cbrt(double(n)),
        root = long(System.Math.round(estimate))
    in
        root * root * root == n

squares() -> long{} => from(1L) |> map(n => n * n)

let last = squares() |> filter(s => !is_cube(s)) |> skip(29) |> first()!

for square in squares() |> take_while(* <= last) do
    if is_cube(square) then
        write_line("{square,5} is a square and a cube")
    else
        write_line("{square,5}")
    fi
od
