use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
// order from its source
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`
// `==` compares identity

is_cube(n: long) -> bool =>
    let
        estimate = System.Math.cbrt(double(n)),
        root = long(System.Math.round(estimate))
    in
        root * root * root == n

squares() -> long{} => from(1L) |> map(n => n * n)

let last = squares() |> filter(s => !is_cube(s)) |> skip(29) |> first()!

for square in squares() |> take_while(* <= last) do
    if is_cube(square) then
        write_line("{square,5} is a square and a cube")
    else
        write_line("{square,5}")
    fi
od
