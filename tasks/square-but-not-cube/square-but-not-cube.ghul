use default

is_cube(n) =>
    let
        estimate = cbrt(double(n)),
        root = long(round(estimate))
    in
        root * root * root == n

squares() => from(1L) |> map(n => n * n)

let last = squares() |> filter(s => !is_cube(s)) |> skip(29) |> first()!

for square in squares() |> take_while(* <= last) do
    if is_cube(square) then
        write_line("{square,5} is a square and a cube")
    else
        write_line("{square,5}")
    fi
od
