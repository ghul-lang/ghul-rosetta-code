use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.

// == compares identity, not characters
let literal = "hello"
let built = "{"hel"}{"lo"}"

write_line("== says {literal == built}")
write_line("=~ says {literal =~ built}")

// adjacent string literals join, so a missing comma merges two elements
let colours = [
    "red"
    "green",
    "blue"
]

write_line("{colours.count} colours: {colours}")

// byte is signed, ubyte unsigned
write_line("byte {byte(200)}, ubyte {ubyte(200)}")

// every read of a pipe starts from the beginning and runs its stages again
let evens = [1, 2, 3, 4, 5, 6] |> filter(x => x % 2 == 0)

write_line("first even: {evens |> first()}")

for e in evens do
    write_line("even again: {e}")
od

write_line("all evens: {evens}")
