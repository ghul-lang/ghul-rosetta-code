use default

use Stage = (salt: uint, max: uint)

hash(n: uint, salt: uint, max: uint) -> uint is
    let m mut = n - salt

    m = m ^ (m << 2)
    m = m ^ (m << 3)
    m = m ^ (m >> 5)
    m = m ^ (m >> 7)
    m = m ^ (m << 11)
    m = m ^ (m << 13)
    m = m ^ (m >> 17)
    m = m ^ (m << 19)

    m = m + salt

    uint((ulong(m) * ulong(max)) >> 32)
si

infer_bit(command: uint, bit: int, program: List[Stage]) -> bool =>
    let input = command | (uint(bit) << 16) in
    let first_stage = program[0] in
    let start = (
        input = hash(input, first_stage.salt, first_stage.max),
        room = first_stage.max) in
    let result = program
        |> skip(1)
        |> reduce(start, (state, stage) =>
            let room = state.room - stage.max in
            (input = hash(state.input, stage.salt, room), room = room)) in
    result.input & 1u != 0u

inference(command: uint, bits: int, program: List[Stage]) -> ulong =>
    if program.count == 0 then
        0ul
    else
        0..bits
            |> filter(bit => infer_bit(command, bit, program))
            |> reduce(0ul, (out, bit) => out | (1ul << bit))
    fi

write_line("{inference(42u, 64, [(salt = 0u, max = 2u)])}")

let square_root_program = System.Text.RegularExpressions.Regex
    .matches(IO.File.read_all_text("square-root-program.txt"), "[0-9]+")
    |> map(m => uint.parse(m.value))
    |> chunk(2)
    |> map(pair => (salt = pair[0], max = pair[1]))
    |> collect()

let roots = 0..256
    |> map(n => inference(uint(n), 4, square_root_program))
    |> collect()

for row in roots |> chunk(16) do
    write_line(row |> map(root => "{root,3}") |> join(""))
od

let correct = 0..256
    |> all(n => roots[n] == ulong(System.Math.sqrt(double(n))))

write_line("every square root correct: {correct}")
