use default

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

for subject in ["knights", "𝔨𝔫𝔦𝔤𝔥𝔱𝔰"] do
    let characters = subject |> graphemes() |> list()

    write_line("no first: {characters[1..<0] |> string()}")
    write_line("no last:  {characters[0..<1] |> string()}")
    write_line("no ends:  {characters[1..<1] |> string()}")
od
