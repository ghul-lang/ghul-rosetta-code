use default
use System.Globalization.StringInfo

for subject in ["knights", "𝔨𝔫𝔦𝔤𝔥𝔱𝔰"] do
    let text = StringInfo(subject)
    let count = text.length_in_text_elements

    write_line("no first: {text.substring_by_text_elements(1)}")
    write_line("no last:  {text.substring_by_text_elements(0, count - 1)}")
    write_line("no ends:  {text.substring_by_text_elements(1, count - 2)}")
od
