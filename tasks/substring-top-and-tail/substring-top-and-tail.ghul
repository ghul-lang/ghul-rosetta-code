use default

// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

for subject in ["knights", "𝔨𝔫𝔦𝔤𝔥𝔱𝔰"] do
    let characters = subject |> graphemes() |> list()

    write_line("no first: {characters[1..<0] |> string()}")
    write_line("no last:  {characters[0..<1] |> string()}")
    write_line("no ends:  {characters[1..<1] |> string()}")
od
