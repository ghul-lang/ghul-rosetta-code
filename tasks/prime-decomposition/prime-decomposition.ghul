use default

decompose(n: bigint) -> List[bigint] is
    let factors = LIST()

    let two = 2n
    let rest mut = n

    while rest % two =~ 0n do
        factors.add(two)
        rest = rest / two
    od

    let divisor mut = 3n

    while divisor * divisor <= rest do
        if rest % divisor =~ 0n then
            factors.add(divisor)
            rest = rest / divisor
        else
            divisor = divisor + two
        fi
    od

    if rest > 1n then
        factors.add(rest)
    fi

    return factors
si

show(n: bigint) =>
    let rendered = decompose(n)
        |> map(factor => "{factor}") in
    write_line("{n} = {rendered |> join(" x ")}")

for n in [12L, 2L, 9L, 1024L, 1048576L, 4294967297L, 1234567890L] do
    show(cast(n))
od

show(12345678901234567890n)
