use default

decompose(n: bigint) -> bigint{} is
    if n > 1n then
        let factor = from(2L)
            |> map(d => bigint(d))
            |> find(d => d * d > n \/ (n % d).is_zero)!
        let prime = if factor * factor > n then n else factor fi

        yield prime
        yield in decompose(n / prime)
    fi
si

show(n: bigint) =>
    let rendered = n
        |> decompose()
        |> map(factor => "{factor}") in
    write_line("{n} = {rendered |> join(" x ")}")

for n in [12L, 2L, 9L, 1024L, 1048576L, 4294967297L, 1234567890L] do
    show(cast(n))
od

show(12345678901234567890n)
