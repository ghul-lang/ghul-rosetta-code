use default

let text =
    "{{\"name\": \"Ada\", \"age\": 36, "
    "\"languages\": [\"Ada\", \"ghūl\"]}}"

let parsed = Json.parse(text)
let languages = Json.as_array(Json.get(parsed, "languages")!)!

write_line("name = {Json.as_string(Json.get(parsed, "name")!)}")
write_line("age = {int(Json.as_number(Json.get(parsed, "age")!)!)}")
write_line("first language = {Json.as_string(languages[0])}")

let created = Json.object()

Json.set(created, "title", Json.of("Rosetta Code"))
Json.set(created, "year", Json.of(2007))
Json.set(
    created,
    "tags",
    Json.array([Json.of("wiki"), Json.of("programming")])
)

write_line(Json.write(created))
