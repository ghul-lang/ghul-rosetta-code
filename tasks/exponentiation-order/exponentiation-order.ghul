use default

// ghūl has no exponentiation operator, so this program declares one.
// An operator's precedence comes from its first character, and like
// almost every ghūl operator it groups to the left, so 5 ** 3 ** 2 is
// (5 ** 3) ** 2.

**(base: bigint, exponent: bigint) -> bigint =>
    bigint.pow(base, int(exponent))

write_line("5 ** 3 ** 2   = {5n ** 3n ** 2n}")
write_line("(5 ** 3) ** 2 = {(5n ** 3n) ** 2n}")
write_line("5 ** (3 ** 2) = {5n ** (3n ** 2n)}")
