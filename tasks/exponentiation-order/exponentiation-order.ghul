use default

// ghūl has no exponentiation operator, so this program declares one, and
// writes each grouping out in parentheses.

**(base: bigint, exponent: bigint) -> bigint =>
    bigint.pow(base, int(exponent))

write_line("(5 ** 3) ** 2 = {(5n ** 3n) ** 2n}")
write_line("5 ** (3 ** 2) = {5n ** (3n ** 2n)}")
