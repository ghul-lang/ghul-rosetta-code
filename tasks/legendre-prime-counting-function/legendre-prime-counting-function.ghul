use default

let limit = 40_000
let composite = repeat(false, limit) |> collect_mutable()

for p in 2..200 do
    if !composite[p] then
        for multiple in from(p * p, p) |> take_while(m => m < limit) do
            composite[multiple] = true
        od
    fi
od

let primes = [long(n) for n in 2..limit if !composite[n]]

phi(x: long, a: int) -> long =>
    if a == 0 then
        x
    elif x < primes[a] then
        if x >= 1L then 1L else 0L fi
    else
        phi(x, a - 1) - phi(x / primes[a - 1], a - 1)
    fi

prime_count(n: long) -> long =>
    if n < 2L then
        0L
    else
        let a = prime_count(long(System.Math.sqrt(double(n)))) in
        phi(n, int(a)) + a - 1L
    fi

for exponent in 0::9 do
    let n = long(System.Math.pow(10.0, double(exponent)))
    write_line("10^{exponent} {prime_count(n),12:N0}")
od
