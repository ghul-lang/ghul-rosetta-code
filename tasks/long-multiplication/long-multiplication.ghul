use default

// `T[]` is the read-only list trait - elements can be read by index
// `LIST[T]` is a mutable list that grows as elements are added
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `|> LIST()` reads the whole sequence into a new `LIST`
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

digits_of(s: string) -> int[] =>
    let value = c => int(c) - int('0') in
    s |> reverse() |> map(value) |> list()

multiply(a: string, b: string) -> string is
    let da = digits_of(a)
    let db = digits_of(b)
    let result = 0::(da.count + db.count) |> map(_ => 0) |> LIST()

    for i in 0..da.count do
        for j in 0..db.count do
            result[i + j] = result[i + j] + da[i] * db[j]
        od
    od

    let carry mut = 0

    for k in 0..result.count do
        let total = result[k] + carry

        result[k] = total % 10
        carry = total / 10
    od

    let raw = result |> reverse() |> map(d => "{d}") |> join("")
    let trimmed = raw.trim_start(['0'])

    if trimmed.length == 0 then "0" else trimmed fi
si

let a = "18446744073709551616"
let b = "18446744073709551616"

write_line("{a} * {b}")
write_line("= {multiply(a, b)}")
