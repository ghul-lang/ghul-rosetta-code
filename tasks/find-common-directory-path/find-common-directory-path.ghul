use default

// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
// index materialises the source only as far as that index and caches what
// it read
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `=~` compares values (structural equality)

common_directory_path(paths: string[]) -> string is
    let segments = paths |> map(p => p.split(['/'])) |> list()
    let common = LIST()

    for i in 0..segments[0].count do
        let candidate = segments[0][i]

        if segments |> all(s => i < s.count /\ s[i] =~ candidate) then
            common.add(candidate)
        else
            break
        fi
    od

    common |> join("/")
si

let paths = [
    "/home/user1/tmp/coverage/test",
    "/home/user1/tmp/covert/operator",
    "/home/user1/tmp/coven/members"
]

write_line(common_directory_path(paths))
