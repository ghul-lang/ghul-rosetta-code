use default

use Time.STOPWATCH

class RATE_COUNTER is
    _clock: STOPWATCH
    _jobs: int

    init() is
        _clock = STOPWATCH()
        _jobs = 0
    si

    tick(job: () -> void) is
        _clock.start()
        job()
        _clock.stop()
        _jobs = _jobs + 1
    si

    jobs: int => _jobs
    seconds: double => _clock.elapsed.total_seconds
    rate: double => double(_jobs) / seconds
si

job() -> void => 0..10_000 |> sum_by(i => long(i) * long(i))

let tick_ns = 1.0e9 / double(STOPWATCH.frequency)
write_line("timer resolution: {tick_ns:F0} ns")

for count in [100, 1_000, 10_000] do
    let counter = RATE_COUNTER()

    for _ in 0..count do
        counter.tick(job)
    od

    write_line(
        "{counter.jobs,6} jobs in {counter.seconds * 1000.0,10:F3} ms, "
        "{counter.rate,12:F0} jobs per second"
    )
od

let counter = RATE_COUNTER()
let deadline = STOPWATCH.start_new()

while deadline.elapsed.total_seconds < 0.25 do
    counter.tick(job)
od

write_line(
    "{counter.jobs,6} jobs in 250 ms of wall time, "
    "{counter.rate,12:F0} jobs per second of job time"
)
