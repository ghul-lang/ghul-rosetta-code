use default

// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

let words = LIST([
    "Here", "are", "some", "sample", "strings", "to", "be", "sorted"
])

compare(left: string, right: string) -> int is
    if left.length != right.length then
        return right.length - left.length
    fi

    string.compare(left, right, System.StringComparison.ORDINAL_IGNORE_CASE)
si

words.sort(compare)

words |> each(word => write_line(word))
