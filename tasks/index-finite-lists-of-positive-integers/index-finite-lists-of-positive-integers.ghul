use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `T[]` is the read-only list trait - elements can be read by index
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `LIST()` builds its collection eagerly
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `==` compares identity

let ten = 10n
let eleven = 11n

rank(values: bigint[]) -> bigint =>
    values
        |> reduce(1n, (acc, value) =>
            value.to_string()
                |> reduce(
                    acc * eleven + ten,
                    (r, d) => r * eleven + cast(d - '0')
                )
        )

unrank(index: bigint) -> bigint{} is
    let digits = LIST()
    let remaining mut = index

    while remaining > 1n do
        let digit = int(remaining % eleven)

        digits.add(if digit == 10 then " " else "{digit}" fi)
        remaining = remaining / eleven
    od

    digits.reverse()

    let values =
        digits |> join("") |> words() |> map(bigint.parse) |> list()

    return values
si

let sample = [1, 2, 3, 10, 100, 987654321, 1] |> map(bigint) |> list()

let index = rank(sample)
let restored = unrank(index)

write_line("list:     {sample |> map(v => "{v}") |> join(" ")}")
write_line("rank:     {index}")
write_line("unranked: {restored |> map(v => "{v}") |> join(" ")}")
