use default

let dice = System.Random(20260909)

attribute() -> int =>
    let rolls = 1::4 |> map(_ => dice.next(1, 7)) |> collect() in
    let lowest = rolls |> min_by(roll => roll) in
    let total = rolls |> sum() in
    total - (lowest ?? 0)


character() -> LIST[int] =>
    1::6 |> map(_ => attribute()) |> collect_mutable()

let rolled mut = character()

let attempts mut = 1

while !acceptable(rolled) do
    rolled = character()

    attempts = attempts + 1
od

acceptable(values: LIST[int]) -> bool =>
    let total = values |> sum() in
    let strong = values |> filter(value => value >= 15) |> count() in
    total >= 75 /\ strong >= 2


let total = rolled |> sum()

write_line("attributes: {rolled |> map(value => "{value}") |> join(", ")}")
write_line("total: {total}")
write_line("rolled {attempts} characters before one qualified")
