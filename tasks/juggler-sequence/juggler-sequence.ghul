use default
use System.Math.sqrt

step(value: long) -> long =>
    if (value % 2L) == 0L then
        long(sqrt(cast(value)))
    else
        long(cast(value) * sqrt(cast(value)))
    fi

sequence(start: long) -> long{} is
    yield start

    if start != 1L then
        yield in sequence(step(start))
    fi
si

stats(start: long) -> (int, long, int) =>
    let
        terms = sequence(start) |> collect(),
        highest = terms |> max()!
    in
        (terms.count - 1, highest, terms |> find_index(* == highest)!)

write_line("  n   l                h  i")

for n in 20::39 do
    let (terms, highest, at) = stats(cast(n))
    write_line("{n,3}  {terms,3}  {highest,17:N0}  {at}")
od
