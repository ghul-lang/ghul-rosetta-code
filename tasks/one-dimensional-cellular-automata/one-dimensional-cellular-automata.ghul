use default

// `==` compares identity
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
// `a => f(a, b)`

// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `*` as an argument leaves that parameter open: partial application.

alive(cells: string, index: int) -> bool =>
    index >= 0 /\ index < cells.length /\ cells[index] == '#'

live_neighbourhood(cells: string, index: int) -> int =>
    ((index - 1)::(index + 1)) |> filter(alive(cells, *)) |> count()

next_generation(cells: string) -> string =>
    (0..cells.length)
        |> map(index =>
            if live_neighbourhood(cells, index) == 2 then
                "#"
            else
                "_"
            fi
        )
        |> join("")

stream("_###_##_#_#_#_#__#__", generation =>
    generation || next_generation(generation)
)
    |> take(10)
    |> each(generation => write_line(generation))
