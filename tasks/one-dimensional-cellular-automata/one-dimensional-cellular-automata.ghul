use default

alive(cells, index) =>
    index >= 0 /\ index < cells.length /\ cells[index] == '#'

live_neighbourhood(cells, index) =>
    ((index - 1)::(index + 1)) |> filter(alive(cells, *)) |> count()

next_generation(cells: string) -> string =>
    (0..cells.length)
        |> map(index =>
            if live_neighbourhood(cells, index) == 2 then
                "#"
            else
                "_"
            fi
        )
        |> join("")

stream("_###_##_#_#_#_#__#__", generation =>
    generation || next_generation(generation)
)
    |> take(10)
    |> each(generation => write_line(generation))
