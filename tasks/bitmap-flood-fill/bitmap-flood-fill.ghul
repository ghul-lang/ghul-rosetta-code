use default
use Raster.IMAGE
use System.Math.*

use POINT = (x: double, y: double)

// `T[]` is a read-only list: an array, a `LIST` or a lazy list all fit.
// `x |> f(a, b)` is `f(x, a, b)`: the left value is the first argument.
// `list()` makes a lazy `T[]`: elements are produced once, on first access.

let steps = 240

around(radius: double) -> POINT[] =>
    (0..steps + 1)
        |> map(step => (
            let angle = 2.0D * pi * double(step) / double(steps)

            (
                x = 150.0D + radius * cos(angle),
                y = 150.0D + radius * sin(angle)
            )
        ))
        |> list()

let image = IMAGE(300, 300)

image.colour(0ub, 0ub, 0ub)
image.stroke(2.0D)

image.line(around(120.0D))
image.line(around(50.0D))

image.colour(230ub, 180ub, 60ub)
image.flood_fill(150, 90)

image.colour(60ub, 120ub, 200ub)
image.flood_fill(150, 150)

image.write("flooded.png")

image.show("flooded.png")
