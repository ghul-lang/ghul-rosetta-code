use default
use Raster.IMAGE

use POINT = (x: double, y: double)

let steps = 240

around(radius) =>
    (0..steps + 1)
        |> map(step => (
            let angle = 2.0 * pi * double(step) / double(steps)

            (
                x = 150.0 + radius * cos(angle),
                y = 150.0 + radius * sin(angle)
            )
        ))
        |> list()

let image = IMAGE(300, 300)

image.color(0ub, 0ub, 0ub)
image.stroke(2.0)

image.line(around(120.0))
image.line(around(50.0))

image.color(230ub, 180ub, 60ub)
image.flood_fill(150, 90)

image.color(60ub, 120ub, 200ub)
image.flood_fill(150, 150)

image.write("flooded.png")

image.show("flooded.png")
