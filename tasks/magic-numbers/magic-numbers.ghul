use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `list()` returns a `T[]` over a `T{}` sequence. It is lazy - a read by
//  index materialises the source only as far as that index and caches what
//  it read
// `LIST()` builds its collection eagerly
// `yield` in a function makes it a generator, returning a lazy `T{}`
//  sequence
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`
// `*` as an argument is partial application - `f(*, b)` means
//  `a => f(a, b)`
// `=~` compares values (structural equality) - `==` compares identity

magic_numbers() -> bigint{} is
    let current = 1::9 |> map(bigint) |> LIST()
    let length mut = 1

    yield 0n

    while current.count > 0 do
        yield in current

        length = length + 1

        let next = [n * 10n + bigint(d) for n in current for d in 0::9]
            |> filter(n => n % bigint(length) =~ 0n)

        current.clear()
        current.add_range(next)
    od
si

let magic = magic_numbers() |> list()

write_line("There are {magic.count} magic numbers, counting zero.")
write_line("The largest is {magic[magic.count - 1]}.\n")

write_line("Digits  count")

for (digits, group) in magic |> group_by(n => "{n}".length) do
    write_line("{digits,6}  {group.count,5}")
od

pandigital(n: bigint, digits: string) -> bool =>
    let text = "{n}" in
    text.length == digits.length /\ digits |> all(text.contains)

for digits in ["123456789", "0123456789"] do
    let found = magic |> filter(pandigital(*, digits)) |> join()

    write_line("\nMinimally pandigital in {digits}: {found}")
od
