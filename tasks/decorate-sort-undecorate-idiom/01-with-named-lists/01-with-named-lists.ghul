use default

decorate_sort_undecorate[T, K: Ghul.Comparable[K]]
    (items: Iterable[T], key: (T) -> K) -> T{}
is
    let decorated =
        items |> map(item => (item, key = key(item)))

    let sorted = decorated |> sort_by(pair => pair.key)

    sorted |> map(pair => pair.item)
si

let words =
    ["Rosetta", "Code", "is", "a", "programming", "chrestomathy", "site"]

write_line(words |> decorate_sort_undecorate(w => w.length) |> join())
write_line(words |> decorate_sort_undecorate(w => w[0]) |> join())
