use default

// `T{}` is the lazy sequence trait - elements are read on demand and in
//  order from its source
// `|>` is the thread-first operator - `x |> f(a, b)` means `f(x, a, b)`

schwartzian[T, K: Ghul.Comparable[K]](items: T{}, key: (T) -> K) -> T{} =>
    items
        |> map(item => (item, key = key(item)))
        |> sort_by(pair => pair.key)
        |> map(pair => pair.item)

let words = [
    "Rosetta", "Code", "is", "a", "programming", "chrestomathy",
    "site"
]

write_line(words |> schwartzian(w => w.length) |> join())
write_line(words |> schwartzian(w => w[0]) |> join())
