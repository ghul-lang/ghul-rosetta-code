use default
use System.Text.RegularExpressions.Regex

let pattern = Regex(
    "^(?<scheme>[^:/?#]+):"
    "(?://(?:(?<username>[^:@/]*)(?::(?<password>[^@/]*))?@)?"
    "(?<domain>\\[[^\\]]*\\]|[^:/?#]*)"
    "(?::(?<port>[0-9]+))?)?"
    "(?<path>[^?#]*)"
    "(?:\\?(?<query>[^#]*))?"
    "(?:#(?<fragment>.*))?$")

let part_names = [
    "scheme", "username", "password", "domain",
    "port", "path", "query", "fragment"
]

parse_url(url: string) -> (string, string)[]? =>
    let m = pattern.match(url) in
    if m.success then
        part_names
            |> map(name => (name, m.groups[name].value))
            |> filter(((_, value)) => value.length > 0)
            |> map(((name, value)) =>
                (name, if name =~ "port" then ":{value}" else value fi))
            |> collect()
    fi

show(url: string, indent: string) is
    if let parts = parse_url(url) then
        for (name, value) in parts do
            write_line("{indent}{name} = {value}")

            // A jdbc URL, and others like it, carry a whole URL as
            // their path.
            if name =~ "path" /\ value.contains("://") then
                show(value, "{indent}    ")
            fi
        od
    else
        write_line("{indent}could not be parsed")
    fi
si

let urls = [
    "foo://example.com:8042/over/there?name=ferret#nose",
    "urn:example:animal:ferret:nose",
    "jdbc:mysql://test_user:ouupppssss@localhost:3306/sakila"
        "?profileSQL=true",
    "ftp://ftp.is.co.za/rfc/rfc1808.txt",
    "http://www.ietf.org/rfc/rfc2396.txt#header1",
    "ldap://[2001:db8::7]/c=GB?objectClass=one&objectClass=two",
    "mailto:John.Doe@example.com",
    "news:comp.infosystems.www.servers.unix",
    "tel:+1-816-555-1212",
    "telnet://192.0.2.16:80/",
    "urn:oasis:names:specification:docbook:dtd:xml:4.1.2"
]

for url in urls do
    write_line(url)
    show(url, "  ")
od
