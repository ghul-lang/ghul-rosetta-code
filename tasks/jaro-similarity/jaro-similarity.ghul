use default

jaro(left, right) is
    if left.length == 0 \/ right.length == 0 then
        return
            if left.length == right.length then
                1.0
            else
                0.0
            fi
    fi

    let window = max(left.length, right.length) / 2 - 1
    let taken = SET()
    let matched_left = LIST()

    for i in 0..left.length do
        let first = max(0, i - window)
        let last = min(i + window + 1, right.length)

        for j in first..last do
            if !taken.contains(j) /\ left[i] == right[j] then
                taken.add(j)
                matched_left.add(left[i])
                break
            fi
        od
    od

    let match_count = matched_left.count

    if match_count == 0 then
        return 0.0
    fi

    let matched_right =
        (0..right.length)
            |> filter(taken.contains)
            |> map(j => right[j])
            |> list()

    let transposed =
        (0..match_count)
            |> filter(i => matched_left[i] != matched_right[i])
            |> count()

    let matches = double(match_count)
    let half_transpositions = cast(transposed) / 2.0

    return
        (
            matches / cast(left.length) +
            matches / cast(right.length) +
            (matches - half_transpositions) / matches
        ) / 3.0
si

[
    ("MARTHA", "MARHTA"),
    ("DIXON", "DICKSONX"),
    ("JELLYFISH", "SMELLYFISH")
]
    |> each((left, right) =>
        write_line("{left} / {right}: {jaro(left, right):F6}")
    )
