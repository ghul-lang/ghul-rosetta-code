<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NoWarn>NU1507</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ghul.runtime" />

    <GhulOptions Include="--warn-as-error null-deref" />

    <!-- Two warnings that are always a mistake in a solution: statements the
         entry point never runs, and a local hiding the function called beside
         it. As errors they fail the build at the site, where as warnings a
         captured warn.expected would record them as expected output. -->
    <GhulOptions Include="--warn-as-error top-level-statements-not-run" />
    <GhulOptions Include="--warn-as-error shadowed-non-callable" />

    <!-- Solutions carry no statement terminators, so a stray ; is an error in
         every task's own build. This replaces the check the former root
         project carried: there is no project that compiles every solution
         together any more. -->
    <GhulOptions Include="--warn redundant-semicolon" />
    <GhulOptions Include="--warn-as-error redundant-semicolon" />

    <!-- The pipe combinators take pure functions, and a call to write_line or
         a string interpolation is not one. The warning is advice: the call it
         sits on is judged on its own callee either way. Marking a solution's
         helpers pure to silence it puts a keyword on the wiki that says
         nothing about the task, so it is off everywhere here. -->
    <GhulOptions Include="--suppress impure-function-argument" />

    <!-- A solution is one file, so a function being private to its file
         tells the reader nothing. -->
    <GhulOptions Include="--suppress file-private-function" />

  </ItemGroup>
</Project>
