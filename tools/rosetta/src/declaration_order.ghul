namespace Rosetta is
    use Collections
    use Ghul.Pipes

    // Puts a solution's declarations with written signatures ahead of the functions whose types
    // are inferred, so a reader meets the types and the typed functions first, then the program.
    //
    // A file is read as its header (everything up to its last leading `use`), then a run of
    // top-level items. An item starts at a line in the first column that doesn't continue an
    // earlier one (`si`, `else`, a closing bracket and the like), and takes with it the comments
    // and pragmas written directly above it, with no blank line between, and the blank lines after
    // it. Types, and functions whose signatures are written, keep their relative order and come
    // just after the header; the inferred functions and the top-level statements follow, in
    // their original order too.
    class DECLARATION_ORDER is
        init() is si

        _continues(line: string) -> bool =>
            ["si", "od", "fi", "esac", "yrt", "elif", "else", "when", "catch", "finally", "in", ")", "]", "}}", "|>"]
                |> any(word => line =~ word \/ line.starts_with("{word} ") \/ (!char.is_letter(word[0]) /\ line.starts_with(word)))

        _starts_item(line: string) -> bool =>
            line.length > 0 /\
            !char.is_white_space(line[0]) /\
            !line.starts_with("//") /\
            !line.starts_with("@") /\
            !_continues(line)

        _attached(line: string) -> bool => line.starts_with("//") \/ line.starts_with("@")

        _declares_type(line: string) -> bool =>
            ["class ", "struct ", "union ", "enum ", "trait ", "partial ", "impl "] |> any(word => line.starts_with(word))

        // Whether the item starting at `lines[start]` defines a function: a name or operator, then
        // a parenthesised parameter list that a body, a return type or a modifier follows.
        _defines_function(lines: LIST[string], start: int, end: int) -> bool is
            let first = lines[start]
            let open = first.index_of('(')

            if open <= 0 \/ first.starts_with("let ") \/ first.starts_with("use ") then
                return false
            fi

            for i in start..end do
                let line = lines[i].trim_end()

                if line.ends_with(" is") \/ line.contains(" => ") \/ line.ends_with(" =>") \/ line.contains(") -> ") \/ line.ends_with(") is") then
                    return i == start \/ lines[i].starts_with(")")
                fi
            od

            false
        si

        _name(line: string) -> string is
            let stop mut = 0

            while stop < line.length /\ line[stop] != '(' /\ line[stop] != '[' do
                stop = stop + 1
            od

            line.substring(0, stop)
        si

        // The text with its typed declarations moved ahead of its inferred functions and its
        // statements, or null where it is already in that order or holds only one kind.
        reorder(text: string, inferred: SET[string]) -> string? is
            let lines = LIST(text.split(['\n']))
            let header_end mut = 0

            while header_end < lines.count /\ (lines[header_end].starts_with("use ") \/ !_starts_item(lines[header_end])) do
                header_end = header_end + 1
            od

            // Leading comments of the first item belong to it, not the header.
            while header_end > 0 /\ _attached(lines[header_end - 1]) do
                header_end = header_end - 1
            od

            let starts = LIST[int]()

            for i in header_end..lines.count do
                if _starts_item(lines[i]) then
                    let begin mut = i

                    while begin > header_end /\ _attached(lines[begin - 1]) do
                        begin = begin - 1
                    od

                    starts.add(begin)
                fi
            od

            if starts.count == 0 then
                return null
            fi

            let typed = LIST[(begin: int, end: int)]()
            let rest = LIST[(begin: int, end: int)]()
            let order = LIST[bool]()

            for k in 0..starts.count do
                let begin = starts[k]
                let end = if k + 1 < starts.count then starts[k + 1] else lines.count fi
                let first mut = begin

                while first < end /\ _attached(lines[first]) do
                    first = first + 1
                od

                let is_typed =
                    _declares_type(lines[first]) \/
                    (_defines_function(lines, first, end) /\ !inferred.contains(_name(lines[first])))

                (if is_typed then typed else rest fi).add((begin = begin, end = end))
                order.add(is_typed)
            od

            let first_rest = order |> find_index(t => !t)

            if typed.count == 0 \/ rest.count == 0 \/ !first_rest? \/ !(order |> skip(first_rest) |> any(t => t)) then
                return null
            fi

            let result = Text.STRING_BUILDER()

            for i in 0..header_end do
                result.append(lines[i])
                result.append("\n")
            od

            // Each chunk keeps its own blank lines. One that now sits before a chunk it didn't
            // precede gets a blank line, if it ends without one.
            let emitted = LIST(typed ++ rest)

            for k in 0..emitted.count do
                let chunk = emitted[k]
                let body = LIST(lines |> skip(chunk.begin) |> take(chunk.end - chunk.begin))
                let moved = k + 1 < emitted.count /\ emitted[k + 1].begin != chunk.end

                body |> each(line => (result.append(line); result.append("\n")))

                if moved /\ (body.count == 0 \/ body[body.count - 1].trim().length > 0) then
                    result.append("\n")
                fi
            od

            "{result.to_string().trim_end()}\n"
        si
    si
si
