namespace Rosetta is
    use IO.Std.error
    use System.Exception
    use System.Net.Http
    use System.Net.Http.MultipartFormDataContent
    use System.Net.Http.StringContent
    use System.Net.Http.ByteArrayContent
    use System.Text.Json.JsonDocument
    use System.Text.Json.JsonElement
    use Collections
    use Ghul.Pipes

    // A read and write client for the Rosetta Code MediaWiki API.
    //
    // Writing needs a credential from Special:BotPasswords on an account that can already edit.
    // The account name is `user@botname` and the password is the one that page issues once and
    // does not show again. Every edit appears in the page history under the underlying account.
    class WIKI is
        _client: HttpClient
        _api: string
        _csrf_token: string?

        init(api: string) is
            _api = api
            _client = HttpClient()

            _client.default_request_headers.add(
                "User-Agent",
                "ghul-rosetta/1.0 (https://github.com/ghul-lang/ghul-rosetta-code)"
            )
        si

        // retries a request through a timeout, a bad status, or a non-JSON body - blips a
        // struggling wiki produces on no predictable schedule. every _get/_post/upload call
        // goes through this.
        _with_retries[T](attempt: () -> T) -> T is
            let max_attempts = 3
            let attempt_number mut = 0

            do
                attempt_number = attempt_number + 1

                try
                    return attempt()
                catch problem: System.Exception
                    if attempt_number >= max_attempts then
                        throw problem
                    fi

                    let backoff_ms = attempt_number * 5000

                    error.write_line(
                        "wiki request failed, retrying in {backoff_ms / 1000}s: {problem.message}")

                    System.Threading.Thread.sleep(backoff_ms)
                yrt
            od
        si

        _get(query: string) -> JsonDocument =>
            _with_retries[JsonDocument](() is
                let body = _client.get_string_async("{_api}?{query}&format=json&formatversion=2").result

                JsonDocument.parse(body, _)
            si)

        _post(fields: MAP[string, string]) -> JsonDocument =>
            _with_retries[JsonDocument](() is
                let form = LIST[KeyValuePair[string, string]]()

                for pair in fields do
                    form.add(pair)
                od

                let content = FormUrlEncodedContent(form)
                let response = _client.post_async(_api, content).result
                let body = response.content.read_as_string_async().result

                JsonDocument.parse(body, _)
            si)

        // Every page in a category, following the continuation the API returns when the
        // membership is larger than one request can carry.
        category_members(category: string) -> LIST[string] is
            let titles = LIST[string]()
            let continue_from mut = ""

            do
                let cursor_argument =
                    if continue_from.length > 0 then
                        "&cmcontinue={System.Uri.escape_data_string(continue_from)}"
                    else
                        ""
                    fi

                let query =
                    "action=query&list=categorymembers&cmtype=page&cmlimit=500"
                    "&cmtitle={System.Uri.escape_data_string(category)}"
                    "{cursor_argument}"

                let document = _get(query)
                let root = document.root_element

                for member in root.get_property("query").get_property("categorymembers").enumerate_array() do
                    if let title = member.get_property("title").get_string() then
                        titles.add(title)
                    fi
                od

                let next: JsonElement mut

                if !root.try_get_property("continue", next ref) then
                    break
                fi

                let cursor: JsonElement mut

                if !next.try_get_property("cmcontinue", cursor ref) then
                    break
                fi

                continue_from = cursor.get_string() ?? ""
            od

            return titles
        si

        // The raw wikitext of a page, or absent when the page does not exist.
        page_wikitext(title: string) -> string? is
            let document =
                _get("action=parse&prop=wikitext&page={System.Uri.escape_data_string(title)}")

            let parse: JsonElement mut

            if !document.root_element.try_get_property("parse", parse ref) then
                return null
            fi

            return parse.get_property("wikitext").get_string()
        si

        // The raw wikitext of many pages, keyed by the title asked for. A page that does not
        // exist is left out. The API takes fifty titles a request, so a thousand pages are
        // twenty requests rather than a thousand.
        pages_wikitext(titles: List[string]) -> MAP[string, string] is
            let result = MAP[string, string]()
            let first mut = 0

            while first < titles.count do
                let batch = titles |> skip(first) |> take(50) |> collect_mutable()

                let joined =
                    batch |> map(title => System.Uri.escape_data_string(title)) |> join("%7C")

                let document =
                    _get("action=query&prop=revisions&rvprop=content&rvslots=main&titles={joined}")

                let query = document.root_element.get_property("query")

                // The API answers under its own spelling of a title, so map that back to the
                // one asked for.
                let asked = MAP[string, string]()

                for title in batch do
                    asked[title] = title
                od

                let normalized: JsonElement mut

                if query.try_get_property("normalized", normalized ref) then
                    for pair in normalized.enumerate_array() do
                        asked[pair.get_property("to").get_string() ?? ""] =
                            pair.get_property("from").get_string() ?? ""
                    od
                fi

                for page in query.get_property("pages").enumerate_array() do
                    let revisions: JsonElement mut

                    if page.try_get_property("revisions", revisions ref) then
                        let title = page.get_property("title").get_string() ?? ""

                        for revision in revisions.enumerate_array() do
                            let content =
                                revision
                                    .get_property("slots")
                                    .get_property("main")
                                    .get_property("content")
                                    .get_string() ?? ""

                            result[if asked.contains_key(title) then asked[title] else title fi] =
                                content
                        od
                    fi
                od

                first = first + 50
            od

            result
        si

        _token(kind: string) -> string is
            let document = _get("action=query&meta=tokens&type={kind}")

            return document.root_element
                .get_property("query")
                .get_property("tokens")
                .get_property("{kind}token")
                .get_string() ?? ""
        si

        // Signs in with a bot password and holds the edit token the session needs.
        log_in(user: string, password: string) is
            let login_token = _token("login")

            let fields = MAP[string, string]()

            fields["action"] = "login"
            fields["lgname"] = user
            fields["lgpassword"] = password
            fields["lgtoken"] = login_token
            fields["format"] = "json"
            fields["formatversion"] = "2"

            let result = _post(fields).root_element.get_property("login")
            let status = result.get_property("result").get_string() ?? ""

            if status !~ "Success" then
                let reason: JsonElement mut

                let detail =
                    if result.try_get_property("reason", reason ref) then
                        reason.to_string()
                    else
                        status
                    fi

                throw System.Exception("could not sign in to the wiki: {detail}")
            fi

            _csrf_token = _token("csrf")
        si

        // The account the session is acting as, and whether it may edit. Anonymous requests get
        // an IP address as the name, so this is how a failed sign-in shows itself.
        account() -> (name: string, can_edit: bool) is
            let user =
                _get("action=query&meta=userinfo&uiprop=rights")
                    .root_element
                    .get_property("query")
                    .get_property("userinfo")

            let can_edit mut = false

            for right in user.get_property("rights").enumerate_array() do
                if right.get_string() =~ "edit" then
                    can_edit = true
                fi
            od

            return (name = user.get_property("name").get_string() ?? "", can_edit = can_edit)
        si

        // How many lines an edit would remove, according to the wiki's own diff of the live page
        // against the text it is being offered. This is the one check that is not the splice
        // marking its own work: MediaWiki computes it, from the revision actually stored.
        lines_removed(title: string, text: string) -> int is
            let fields = MAP[string, string]()

            fields["action"] = "compare"
            fields["fromtitle"] = title
            fields["toslots"] = "main"
            fields["totext-main"] = text
            fields["prop"] = "diff"
            fields["format"] = "json"
            fields["formatversion"] = "2"

            let body =
                _post(fields)
                    .root_element
                    .get_property("compare")
                    .get_property("body")
                    .get_string() ?? ""

            return
                System.Text.RegularExpressions.Regex.matches(body, "diff-deletedline").count
        si

        // The wiki's own digest of a file's current version, or absent when
        // there is no such file. Comparing it against what was uploaded from
        // here is what tells our own picture from one somebody else has put
        // in its place.
        file_sha1(title: string) -> string? is
            let document =
                _get(
                    "action=query&prop=imageinfo&iiprop=sha1"
                    "&titles={System.Uri.escape_data_string(title)}"
                )

            let pages =
                document.root_element.get_property("query").get_property("pages")

            for page in pages.enumerate_array() do
                let images: JsonElement mut

                if page.try_get_property("imageinfo", images ref) then
                    for image in images.enumerate_array() do
                        let sha1: JsonElement mut

                        if image.try_get_property("sha1", sha1 ref) then
                            return sha1.get_string()
                        fi
                    od
                fi
            od

            return null
        si

        // Sends a file. The upload form is multipart rather than the encoded
        // fields every other call uses, because it carries the bytes.
        upload(title: string, path: string, comment: string) is
            assert _csrf_token? else "log_in has not run, so there is no edit token"

            let token = _csrf_token

            let form = MultipartFormDataContent()

            form.add(StringContent("upload"), "action")
            form.add(StringContent(title), "filename")
            form.add(StringContent(comment), "comment")
            form.add(StringContent(comment), "text")
            form.add(StringContent(token), "token")
            form.add(StringContent("json"), "format")
            form.add(StringContent("2"), "formatversion")
            form.add(StringContent("1"), "ignorewarnings")

            form.add(ByteArrayContent(IO.File.read_all_bytes(path)), "file", title)

            let root = _with_retries[JsonElement](() is
                let response = _client.post_async(_api, form).result
                let body = response.content.read_as_string_async().result

                JsonDocument.parse(body, _).root_element
            si)

            let failure: JsonElement mut

            if root.try_get_property("error", failure ref) then
                let code: JsonElement mut

                throw Exception(
                    "uploading {title} failed: "
                    "{if failure.try_get_property("code", code ref) then code.get_string() ?? "" else "" fi}"
                )
            fi

            let result: JsonElement mut

            if
                !root.get_property("upload").try_get_property("result", result ref) \/
                result.get_string() !~ "Success"
            then
                throw Exception("uploading {title} did not succeed: {root.get_raw_text()}")
            fi
        si

        // Replaces a page's whole text. `log_in` must have run first. A minor edit is marked
        // as one in the page history, where readers who watch the page can filter it out.
        edit(title: string, text: string, summary: string, minor: bool) is
            assert _csrf_token? else "log_in has not run, so there is no edit token"

            let token = _csrf_token

            let fields = MAP[string, string]()

            fields["action"] = "edit"
            fields["title"] = title
            fields["text"] = text
            fields["summary"] = summary

            if minor then
                fields["minor"] = "1"
            fi

            fields["token"] = token
            fields["format"] = "json"
            fields["formatversion"] = "2"
            // Asks the wiki to refuse the edit rather than add to a replication backlog it is
            // already struggling with.
            fields["maxlag"] = "5"

            let retried mut = false

            do
                let root = _post(fields).root_element
                let failure: JsonElement mut

                if root.try_get_property("error", failure ref) then
                    let code_element: JsonElement mut
                    let code mut = ""

                    if failure.try_get_property("code", code_element ref) then
                        code = code_element.get_string() ?? ""
                    fi

                    // These two say to come back later rather than that the edit was wrong, so
                    // the page gets one more chance before the batch gives up on it.
                    if !retried /\ (code =~ "maxlag" \/ code =~ "ratelimited") then
                        retried = true

                        System.Threading.Thread.sleep(30000)

                        continue
                    fi

                    throw System.Exception("the wiki refused the edit: {failure.to_string()}")
                fi

                let outcome = root.get_property("edit")
                let status = outcome.get_property("result").get_string() ?? ""

                // Whatever else the wiki says about a refusal is in the rest of the object - which
                // captcha it wants, which filter matched - and none of it is guessable from the
                // one-word result, so the whole thing is reported.
                if status !~ "Success" then
                    throw System.Exception("the wiki did not apply the edit: {outcome.to_string()}")
                fi

                break
            od
        si
    si
si
