namespace Rosetta is
    use System.Text.Json.JsonDocument
    use System.Text.Json.JsonElement
    use System.Text.Json.JsonValueKind
    use System.Text.Json.Utf8JsonWriter
    use System.Text.Json.JsonWriterOptions
    use System.Text.Encodings.Web.JavaScriptEncoder
    use System.Text.RegularExpressions.Regex
    use Collections
    use Ghul.Pipes

    // One runnable program: a task with no parts is one of these, a task with
    // parts is several.
    class INDEX_PART is
        id: string
        heading: string?
        source: string
        output: string
        lines: int
        playground: bool
        input: bool
        images: LIST[string]

        // The files the program reads, each by the name it opens it under
        // and the path of the file in the repository.
        files: LIST[(name: string, path: string)]

        // The command line the program is run with.
        args: LIST[string]

        // Whether the program draws with ghul.raster.
        raster: bool

        init(
            id: string, heading: string?, source: string, output: string, lines: int, playground: bool, input: bool,
            images: LIST[string], files: LIST[(name: string, path: string)], args: LIST[string], raster: bool
        ) is
            self.id = id
            self.heading = heading
            self.source = source
            self.output = output
            self.lines = lines
            self.playground = playground
            self.input = input
            self.images = images
            self.files = files
            self.args = args
            self.raster = raster
        si
    si

    // index.json: what ghul.dev's explorer reads about every task. Tags and
    // interest are written by hand in each task.json, against the vocabulary
    // in TAGS.json; everything else is derived from the task's files, so
    // nothing here can disagree with them.
    class TASK_INDEX is
        _root: string
        _vocabulary: MAP[string, string]
        _tag_order: LIST[string]
        _problems: LIST[string]
        _section: SECTION
        _published: MAP[string, string]
        _wasm: SET[string]
        _native: SET[string]
        _commit: string?

        problems: LIST[string] => _problems

        // `commit` is the commit the task directories were read at, which a
        // reader fetching a task's files fetches them at, or null where it
        // is not known.
        init(root: string, commit: string?) is
            _root = root
            _commit = commit
            _vocabulary = MAP[string, string]()
            _tag_order = LIST[string]()
            _problems = LIST[string]()
            _section = SECTION(root)
            _published = MAP[string, string]()
            _wasm = wasm_passing(root)
            _native = native_passing(root)

            for entry in LEDGER(IO.Path.combine(root, "ledger")).entries() do
                if let slug = entry.slug, hash = entry.published_hash then
                    if entry.state =~ "published" then
                        _published[slug] = hash
                    fi
                fi
            od

            let document = JsonDocument.parse(IO.File.read_all_text(IO.Path.combine(root, "TAGS.json")), _)

            for property in document.root_element.enumerate_object() do
                _vocabulary[property.name] = property.value.get_string() ?? ""
                _tag_order.add(property.name)
            od
        si

        path: string => IO.Path.combine(_root, "index.json")

        // The whole file, as it should read.
        render() -> string is
            let stream = IO.MemoryStream()
            let options: JsonWriterOptions mut = _

            options.indented = true
            options.encoder = JavaScriptEncoder.unsafe_relaxed_json_escaping

            let writer = Utf8JsonWriter(stream, options)

            writer.write_start_object()
            writer.write_number("version", 1)

            if let commit = _commit then
                writer.write_string("commit", commit)
            else
                writer.write_null("commit")
            fi

            // The ghul.raster release the tasks are built and tested with, which
            // a part whose raster is true needs.
            if let raster = _raster_version() then
                writer.write_string("raster_version", raster)
            else
                writer.write_null("raster_version")
            fi

            writer.write_start_object("tags")

            for tag in _tag_order do
                writer.write_string(tag, _vocabulary[tag])
            od

            writer.write_end_object()

            // Where a solution can run, in the order a reader is offered them.
            // Not tags: they are derived from the files rather than written in a
            // task.json, and tags are what the playground and the site compare to
            // find tasks that are alike, which every task would be on these.
            writer.write_start_object("platforms")
            writer.write_string("dotnet", "runs in the playground on .NET")
            writer.write_string("wasm", "runs in the playground compiled to WebAssembly")
            writer.write_string("native", "builds and runs as a native executable, on your own machine")
            writer.write_end_object()

            writer.write_start_array("tasks")

            let directories = LIST[string](IO.Directory.get_directories(IO.Path.combine(_root, "tasks")))

            directories.sort((a: string, b: string) -> int => string.compare_ordinal(a, b))

            for directory in directories do
                if IO.File.exists(IO.Path.combine(directory, "task.json")) then
                    write_task(writer, directory)
                fi
            od

            writer.write_end_array()
            writer.write_end_object()
            writer.flush()

            return "{System.Text.Encoding.utf8.get_string(stream.to_array())}\n"
        si

        write_task(writer: Utf8JsonWriter, directory: string) is
            let slug = IO.Path.get_file_name(directory) ?? ""
            let document = JsonDocument.parse(IO.File.read_all_text(IO.Path.combine(directory, "task.json")), _)
            let descriptor = document.root_element

            let title = string_property(descriptor, "task") ?? slug
            let url = string_property(descriptor, "url") ?? ""

            let tags = LIST[string]()
            let found: JsonElement mut

            if descriptor.try_get_property("tags", found ref) /\ found.value_kind == JsonValueKind.ARRAY then
                for element in found.enumerate_array() do
                    let tag = element.get_string() ?? ""

                    if !_vocabulary.contains_key(tag) then
                        _problems.add("{slug}: tag '{tag}' is not in TAGS.json")
                    elif tags.contains(tag) then
                        _problems.add("{slug}: tag '{tag}' is listed twice")
                    else
                        tags.add(tag)
                    fi
                od

                if tags.count == 0 then
                    _problems.add("{slug}: no tags")
                fi
            else
                _problems.add("{slug}: no tags")
            fi

            let interest mut = 0

            if descriptor.try_get_property("interest", found ref) /\ found.value_kind == JsonValueKind.NUMBER then
                interest = found.get_int32()
            fi

            if interest < 1 \/ interest > 5 then
                _problems.add("{slug}: interest must be 1 to 5")
            fi

            let parts = parts_of(directory, slug)

            if parts.count == 0 then
                _problems.add("{slug}: no source")
            fi

            let images = LIST[string]()

            for part in parts do
                images.add_range(part.images)
            od

            writer.write_start_object()
            writer.write_string("slug", slug)
            writer.write_string("title", title)
            writer.write_string("url", url)

            writer.write_start_array("tags")

            for tag in tags do
                writer.write_string_value(tag)
            od

            writer.write_end_array()

            writer.write_start_array("runs_on")

            if parts |> any(p => p.playground) then
                writer.write_string_value("dotnet")
            fi

            if parts |> any(p => _wasm.contains(p.id) /\ p.playground) then
                writer.write_string_value("wasm")
            fi

            if parts |> any(p => _native.contains(p.id)) then
                writer.write_string_value("native")
            fi

            writer.write_end_array()

            writer.write_number("interest", interest)
            writer.write_boolean("playground", parts |> any(p => p.playground))
            writer.write_boolean("input", parts |> any(p => p.input))
            write_strings(writer, "images", images)
            writer.write_number("lines", parts |> reduce(0, (total, p) => total + p.lines))

            // Whether the solution here has changed since the section on the
            // wiki was posted, so a reader of the site sees a newer one.
            let published: string mut
            let ahead = _published.try_get_value(slug, published ref) /\ _section.is_ahead_of(slug, published)

            writer.write_boolean("ahead_of_wiki", ahead)

            writer.write_start_array("parts")

            for part in parts do
                writer.write_start_object()
                writer.write_string("id", part.id)

                if let heading = part.heading then
                    writer.write_string("heading", heading)
                else
                    writer.write_null("heading")
                fi

                writer.write_string("source", part.source)
                writer.write_string("output", part.output)
                writer.write_number("lines", part.lines)
                writer.write_boolean("playground", part.playground)
                writer.write_boolean("input", part.input)
                write_strings(writer, "images", part.images)
                writer.write_boolean("wasm", _wasm.contains(part.id) /\ part.playground)
                writer.write_boolean("native", _native.contains(part.id))

                writer.write_start_array("files")

                for file in part.files do
                    writer.write_start_object()
                    writer.write_string("name", file.name)
                    writer.write_string("path", file.path)
                    writer.write_end_object()
                od

                writer.write_end_array()

                write_strings(writer, "args", part.args)
                writer.write_boolean("raster", part.raster)
                writer.write_end_object()
            od

            writer.write_end_array()
            writer.write_end_object()
        si

        // The programs wasm-passing.txt lists as running correctly when compiled
        // for WebAssembly, by part id. None when there is no such file.
        wasm_passing(root: string) -> SET[string] is
            let passing = SET[string]()
            let file = IO.Path.combine(root, "wasm-passing.txt")

            if IO.File.exists(file) then
                for line in IO.File.read_all_lines(file) do
                    let id = line.trim()

                    if id.length > 0 /\ !id.starts_with("#") then
                        passing.add(id)
                    fi
                od
            fi

            return passing
        si

        // The programs llvm-tasks.txt lists as building and passing as native
        // executables, by part id: the file names each by its path, which is
        // the id under tasks/. None when there is no such file.
        native_passing(root: string) -> SET[string] is
            let passing = SET[string]()
            let file = IO.Path.combine(root, "llvm-tasks.txt")

            if IO.File.exists(file) then
                for line in IO.File.read_all_lines(file) do
                    let path = line.trim()

                    if path.starts_with("tasks/") then
                        passing.add(path.substring("tasks/".length))
                    fi
                od
            fi

            return passing
        si

        write_strings(writer: Utf8JsonWriter, name: string, values: LIST[string]) is
            writer.write_start_array(name)

            for value in values do
                writer.write_string_value(value)
            od

            writer.write_end_array()
        si

        string_property(element: JsonElement, name: string) -> string? is
            let found: JsonElement mut

            if element.try_get_property(name, found ref) /\ found.value_kind == JsonValueKind.STRING then
                return found.get_string()
            fi

            return null
        si

        // A task's programs in order: its NN-name parts when it has them,
        // otherwise the task directory itself.
        parts_of(directory: string, slug: string) -> LIST[INDEX_PART] is
            let parts = LIST[INDEX_PART]()

            let numbered =
                LIST[string](
                    IO.Directory.get_directories(directory)
                    |> filter(d => Regex.is_match(IO.Path.get_file_name(d) ?? "", "^[0-9][0-9]-"))
                )

            numbered.sort((a: string, b: string) -> int => string.compare_ordinal(a, b))

            if numbered.count == 0 then
                if let part = part_of(directory, slug, null) then
                    parts.add(part)
                fi
            else
                for part_directory in numbered do
                    let name = IO.Path.get_file_name(part_directory) ?? ""

                    let heading = _section.heading(part_directory, name)

                    if let part = part_of(part_directory, "{slug}/{name}", heading) then
                        parts.add(part)
                    else
                        _problems.add("{slug}/{name}: no source")
                    fi
                od
            fi

            return parts
        si

        part_of(directory: string, id: string, heading: string?) -> INDEX_PART? is
            let name = IO.Path.get_file_name(directory) ?? ""
            let source = IO.Path.combine(directory, "{name}.ghul")

            if !IO.File.exists(source) then
                return null
            fi

            let images =
                LIST[string](
                    IO.Directory.get_files(directory, "*.png.expected")
                    |> map(f => relative(f))
                )

            images.sort((a: string, b: string) -> int => string.compare_ordinal(a, b))

            return
                INDEX_PART(
                    id,
                    heading,
                    relative(source),
                    relative(IO.Path.combine(directory, "run.expected")),
                    line_count(IO.File.read_all_text(source)),
                    !IO.File.exists(IO.Path.combine(directory, "playground-unsupported")),
                    IO.File.exists(IO.Path.combine(directory, "run.in")) \/
                        IO.File.exists(IO.Path.combine(directory, "run.session")),
                    images,
                    files_of(directory, id),
                    lines_of(IO.Path.combine(directory, "run.args")),
                    _uses_raster(IO.Path.combine(directory, "{name}.ghulproj"))
                )
        si

        // The files playground-files names, one per line relative to the
        // program's directory. A symbolic link is followed to the file it
        // names, since what the repository serves for a link is its target's
        // path rather than its contents.
        files_of(directory: string, id: string) -> LIST[(name: string, path: string)] is
            let files = LIST[(name: string, path: string)]()

            for line in lines_of(IO.Path.combine(directory, "playground-files")) do
                let full = IO.Path.get_full_path(IO.Path.combine(directory, line))

                if !IO.File.exists(full) then
                    _problems.add("{id}: playground-files names {line}, which does not exist")
                    continue
                fi

                let target = IO.File.resolve_link_target(full, true)
                let resolved = if let t = target then t.full_name else full fi

                files.add((name = IO.Path.get_file_name(full) ?? line, path = relative(resolved)))
            od

            return files
        si

        // The file's lines with surrounding space taken off and blank ones
        // left out, or none where there is no file.
        lines_of(path: string) -> LIST[string] is
            let lines = LIST[string]()

            if IO.File.exists(path) then
                for line in IO.File.read_all_lines(path) do
                    if line.trim().length > 0 then
                        lines.add(line.trim())
                    fi
                od
            fi

            return lines
        si

        _raster_version() -> string? is
            let props = IO.Path.combine(_root, "Directory.Packages.props")

            if !IO.File.exists(props) then
                return null
            fi

            let found = Regex.match(IO.File.read_all_text(props), "Include=\"ghul\\.raster\"\\s+Version=\"([^\"]+)\"")

            return if found.success then found.groups[1].value else null fi
        si

        _uses_raster(project: string) -> bool =>
            IO.File.exists(project) /\ IO.File.read_all_text(project).contains("\"ghul.raster\"")

        line_count(text: string) -> int is
            let trimmed = text.trim_end(['\n', '\r'])

            if trimmed.length == 0 then
                return 0
            fi

            return trimmed.split(['\n']).count
        si

        relative(path: string) -> string =>
            IO.Path.get_relative_path(_root, path).replace('\\', '/')
    si
si
