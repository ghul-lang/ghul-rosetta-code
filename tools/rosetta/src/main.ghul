use IO.Std.write_line
use IO.Std.error
use Collections
use Ghul.Pipes
use Raster.ANIMATION
use Rosetta

// The ghūl solutions' side of Rosetta Code: what has been done, what is worth doing, and getting
// a finished solution onto the wiki.
//
//   rosetta sync                     reconcile ledger/ with the wiki and with tasks/
//   rosetta candidates [count] [--category <Category:X>]
//                                    tasks nothing has been decided about yet
//   rosetta show [state]             ledger entries, all of them or one state's
//   rosetta set <title> <state> [reason] [note]
//   rosetta reopen <title> <note>    put a rejected task back in play, recording why
//   rosetta check [--api <url>]      sign in and report the account, changing nothing
//   rosetta publish [--dry-run] [--replace] [--note <text>] [--target <page>] [--api <url>] [slug ...]
//   rosetta publish --rehearse <page> [--api <url>] <slug>
//   rosetta adopt <slug> ...          record the live section as ours, when it matches wiki-out/
//   rosetta render-notes <path>      a task's notes.md as wiki markup, to stdout
//   rosetta section <slug>           the task's ghul section as wiki markup, to stdout
//   rosetta wiki-out <slug> ...       write each task's section to wiki-out/<slug>.wiki
//   rosetta index [--check]          write index.json, or only validate the tags it would carry
//   rosetta edit-page <title> <file> <summary> [--dry-run]
//                                    replace a page that is not a task's, such as a template
//
// Publishing reads the markup scripts/generate-wiki.sh leaves in wiki-out/, so generate first.

usage() is
    error.write_line(
        "usage: rosetta <sync|candidates|show|set|reopen|check|diff|self-test|publish|adopt|render-notes|index|edit-page> "
        "[arguments]"
    )
si

// The repository root, found by walking up from the working directory. Every path the tool
// touches hangs off it, so it can be run from anywhere inside the checkout.
find_root() -> string is
    let directory mut = IO.Directory.get_current_directory()

    while directory.length > 0 do
        if IO.File.exists(IO.Path.combine(directory, "rosetta-code.ghulproj")) then
            return directory
        fi

        let parent = IO.Directory.get_parent(directory)

        if !parent? then
            break
        fi

        directory = parent.full_name
    od

    throw System.Exception("not inside the ghul-rosetta-code checkout")
si

// The slug and title of every task with a solution here, read from its task.json.
local_tasks(root: string) -> MAP[string, string] is
    let by_title = MAP[string, string]()
    let tasks = IO.Path.combine(root, "tasks")

    if !IO.Directory.exists(tasks) then
        return by_title
    fi

    for directory in IO.Directory.get_directories(tasks) do
        let descriptor = IO.Path.combine(directory, "task.json")

        if IO.File.exists(descriptor) then
            let document = System.Text.Json.JsonDocument.parse(IO.File.read_all_text(descriptor), _)

            if let title = document.root_element.get_property("task").get_string() then
                by_title[title] = IO.Path.get_file_name(directory) ?? ""
            fi
        fi
    od

    return by_title
si

// The wiki and the working tree are both authorities here, over different things: the wiki says
// what is published, and tasks/ says what has a solution. Anything the ledger knows that neither
// of them can see - a rejection and its reason, a task blocked on a compiler fix - is left alone.
sync(root: string) is
    let ledger = LEDGER(IO.Path.combine(root, "ledger"))
    let wiki = WIKI(SITE.api)

    let published = wiki.category_members(SITE.category)
    let local = local_tasks(root)

    // a wiki section over an entry this ledger does not hold as published came from a run
    // elsewhere: publish records the state and its hash together, so writing the state in
    // from here would claim a publish with no hash behind it. reported and left alone; if
    // the section is ours, adopt records it against markup this repository vouched for
    let foreign = unpublished_here(ledger, published)

    for title in foreign do
        error.write_line(
            "{title}: the wiki has a ghul section this ledger did not publish - left alone; if it is ours, adopt it"
        )
    od

    for pair in local do
        let entry = ledger.entry(pair.key)

        entry.slug = pair.value

        if entry.state !~ "published" /\ entry.state !~ "blocked" then
            if entry.state !~ "solved" then
                write_line("{pair.key}: {entry.state} -> solved")
            fi

            entry.state = "solved"
        fi
    od

    ledger.save()

    // task.json carries a status too, and it is what scripts/generate-wiki.sh reads. The ledger
    // is the authority; this is the copy of it that lives beside each solution.
    for pair in local do
        if let entry = ledger.find(pair.key) then
            let descriptor = IO.Path.combine(root, "tasks", pair.value, "task.json")
            let text = IO.File.read_all_text(descriptor)

            let updated =
                System.Text.RegularExpressions.Regex.replace(
                    text,
                    "\"status\"[ \\t]*:[ \\t]*\"[^\"]*\"",
                    "\"status\": \"{entry.state}\""
                )

            if updated !~ text then
                IO.File.write_all_text(descriptor, updated)
            fi
        fi
    od

    write_line("{ledger.count} tasks: {ledger.in_state("published").count} published, {ledger.in_state("solved").count} solved, {ledger.in_state("blocked").count} blocked, {ledger.in_state("rejected").count} rejected")

    if foreign.count > 0 then
        error.write_line("{foreign.count} ghul sections on the wiki are not recorded here as published")

        System.Environment.exit_code = 1
    fi
si

// index.json is generated from the task directories rather than committed: a workflow
// on main writes it and publishes it on the index branch. --check validates the
// tags and interest scores without writing, which is what a pull request runs,
// and a failing validation writes nothing, so a bad task.json is never served.
write_index(root: string, check: bool) is
    let index = TASK_INDEX(root)
    let text = index.render()

    for problem in index.problems do
        error.write_line(problem)
    od

    if index.problems.count > 0 then
        error.write_line("{index.problems.count} problems in task.json tags or interest")

        System.Environment.exit_code = 1

        return
    fi

    if !check then
        IO.File.write_all_text(index.path, text)

        write_line("index.json written")
    fi
si

// the wiki's published pages this ledger cannot claim: an entry in another state than
// published, or none at all. the category says a page has a ghul section, not which ledger
// put it there
unpublished_here(ledger: LEDGER, published: LIST[string]) -> LIST[string] is
    let foreign = LIST[string]()

    for title in published do
        if let entry = ledger.find(title) then
            if entry.state !~ "published" then
                foreign.add(title)
            fi
        else
            foreign.add(title)
        fi
    od

    return foreign
si

// Tasks the ledger says nothing about. Everything else has either been done or been decided
// against, and neither needs looking at again.
candidates(root: string, count: int, category: string?) is
    let ledger = LEDGER(IO.Path.combine(root, "ledger"))
    let wiki = WIKI(SITE.api)

    let shown mut = 0

    for title in wiki.category_members(category ?? SITE.task_category) do
        if shown >= count then
            break
        fi

        if !ledger.has(title) then
            write_line(title)

            shown = shown + 1
        fi
    od
si

show(root: string, state: string?) is
    let ledger = LEDGER(IO.Path.combine(root, "ledger"))

    let entries =
        if let wanted = state then
            ledger.in_state(wanted)
        else
            ledger.entries()
        fi

    for entry in entries do
        let reason = if let r = entry.reason then " ({r})" else "" fi

        write_line("{entry.state}\t{entry.title}{reason}")
    od
si

set(root: string, title: string, state: string, reason: string?, note: string?) is
    let ledger = LEDGER(IO.Path.combine(root, "ledger"))
    let entry = ledger.entry(title)

    entry.state = state

    if reason? then
        entry.reason = reason
    fi

    if note? then
        entry.note = note
    fi

    ledger.save()

    write_line("{entry.title}: {entry.state}")
si

// Puts a task that was decided against back among the candidates. The verdict being reversed is
// written into the note rather than dropped: without it the next run has nothing to read and
// re-reaches the conclusion the rejection recorded.
reopen(root: string, title: string, why: string) is
    let ledger = LEDGER(IO.Path.combine(root, "ledger"))
    let entry = ledger.entry(title)

    let was =
        if let reason = entry.reason then
            "{entry.state}/{reason}"
        else
            entry.state
        fi

    entry.state = "queued"
    entry.reason = null
    entry.note = "reopened, was {was}: {why}"

    ledger.save()

    write_line("{entry.title}: {entry.state} ({entry.note})")
si

// The images a section refers to, by the name the solution wrote each under.
// `Png.show` writes the reference, and generate-wiki.sh turns it into the
// wiki's markup, so the file names are read back out of the markup rather
// than guessed at from the directory.
referenced_images(section: string) -> LIST[string] =>
    (let found = LIST[string]()

     for line in section.split(['\n']) do
         let trimmed = line.trim()

         if trimmed.starts_with("[[File:") then
             let rest = trimmed.substring("[[File:".length)
             let at = rest.index_of('|')

             found.add(if at < 0 then rest.replace("]]", "") else rest.substring(0, at) fi)
         fi
     od

     found)

// Puts a task's images on the wiki before the page that refers to them.
//
// A file already there is left alone when it is the one we uploaded, and
// replaced only when the wiki's digest is the one recorded for it. Anything
// else is somebody else's file under a name we chose, or ours after somebody
// edited it, and overwriting either unasked is the thing the section check
// exists to prevent. The File: namespace is shared with every language on
// the wiki, so this matters more there than on a task page.
upload_images(
    root: string,
    wiki: WIKI,
    entry: TASK_ENTRY,
    slug: string,
    section: string
) is
    let titles = referenced_images(section)

    if titles.count == 0 then
        return
    fi

    let recorded = entry.image_hashes ?? MAP[string, string]()

    entry.image_hashes = recorded

    for title in titles do
        // Ghul-<slug>-<name>: the name the wiki file takes is the tail.
        let name = title.substring("Ghul-{slug}-".length)
        let path = image_file(root, slug, name)

        if !IO.File.exists(path) then
            throw System.Exception(
                "{title} is referred to but {IO.Path.get_file_name(path)} was not written by the task"
            )
        fi

        let ours = file_digest(path)
        let live = wiki.file_sha1("File:{title}")

        if let there = live then
            if there =~ ours then
                write_line("  {title}: already there")

                recorded[title] = ours

                continue
            fi

            if !recorded.contains_key(title) \/ recorded[title] !~ there then
                throw System.Exception(
                    "File:{title} is not the image published from here, so it "
                    "was not replaced - read it before overwriting it"
                )
            fi
        fi

        wiki.upload(title, path, "ghūl solution for {entry.title}")

        recorded[title] = ours

        write_line("  {title}: {if live? then "replaced" else "uploaded" fi}")
    od
si

// Where a task wrote a file: its own directory, or for a task solved in
// parts, the directory of the part that wrote it. A file found nowhere is
// named in the task's own directory, so the caller reports the file the
// task was meant to write.
task_file(root: string, slug: string, name: string) -> string is
    let directory = IO.Path.combine(root, "tasks", slug)
    let own = IO.Path.combine(directory, name)

    if IO.File.exists(own) then
        return own
    fi

    let parts = IO.Directory.get_directories(directory)
    System.Array.sort(parts)

    for part in parts do
        let written = IO.Path.combine(part, name)

        if IO.File.exists(written) then
            return written
        fi
    od

    own
si

// The file to send for an image the markup refers to.
//
// A still is the file the solution wrote. An animation is an animated PNG
// in the repository, which is the file its test asserts, and a GIF on the
// wiki, which keeps every frame of a GIF in the scaled thumbnail an entry
// shows while showing a scaled animated PNG as its first frame alone. So the
// markup names a GIF and the frames are rewritten as one here, rather than
// every animation being kept twice. The conversion is deterministic, so a
// file already on the wiki still compares equal to what this produces.
image_file(root: string, slug: string, name: string) -> string is
    let written = task_file(root, slug, name)

    // a task the runner drives is not run when its markup is generated, so
    // fall back to the captured expectation, which the test asserts is the
    // same image
    let captured = "{written}.expected"

    if !IO.File.exists(written) /\ IO.File.exists(captured) then
        return captured
    fi

    if !name.ends_with(".gif") \/ IO.File.exists(written) then
        return written
    fi

    let animation = task_file(
        root, slug, "{name.substring(0, name.length - ".gif".length)}.png"
    )

    // Named so the caller reports the file the task was meant to write.
    if !IO.File.exists(animation) then
        return animation
    fi

    let converted = IO.Path.combine(root, "wiki-out", "Ghul-{slug}-{name}")

    ANIMATION.read(animation).write_gif(converted)

    converted
si

// What `upload_images` would send, for a dry run. The conversion runs, so an
// animation that cannot be read fails here rather than half way through a
// publish.
report_images(root: string, slug: string, section: string) is
    for title in referenced_images(section) do
        let name = title.substring("Ghul-{slug}-".length)
        let path = image_file(root, slug, name)

        if IO.File.exists(path) then
            write_line("  {title}: {path.substring(root.length + 1)}")
        else
            error.write_line(
                "  {title}: {IO.Path.get_file_name(path)} was not written by the task"
            )
        fi
    od
si

// The digest MediaWiki reports for a file is the SHA-1 of its bytes.
file_digest(path: string) -> string =>
    (let hash = System.Security.Cryptography.SHA1.hash_data(IO.File.read_all_bytes(path))

     System.Convert.to_hex_string(hash).to_lower())

// user and password for Special:BotPasswords, one per line, from a file outside the checkout.
credentials() -> (user: string, password: string) is
    let path =
        System.Environment.get_environment_variable("ROSETTA_CREDENTIALS") ??
        IO.Path.combine(
            System.Environment.get_folder_path(System.Environment_SpecialFolder.USER_PROFILE),
            "secrets",
            "rosetta-code-bot"
        )

    if !IO.File.exists(path) then
        throw System.Exception(
            "no wiki credentials at {path}: create one at Special:BotPasswords and write the "
            "user on the first line and the password on the second"
        )
    fi

    let lines = IO.File.read_all_lines(path)

    if lines.count < 2 then
        throw System.Exception("{path} should hold the bot user on one line and the password on the next")
    fi

    return (user = lines[0].trim(), password = lines[1].trim())
si

// Feeds the guards the damage they exist to stop. A guard that has never been seen to refuse
// anything is only believed to work.
// The page history is read by people looking for what changed, so an edit that rewrites the
// section already there says so rather than claiming to have added one. `note` names what a batch
// of edits is doing beyond the ordinary update or addition - a reader scanning recent changes for
// a run of edits from one account otherwise has nothing to tell them apart.
edit_summary(placement: PLACEMENT, note: string?) -> string =>
    let base =
        case placement
        when _: PLACEMENT.REPLACES then "Update the ghūl solution"
        else "Add a ghūl solution"
        esac
    in
        if let n = note then "{base}: {n}" else base fi

self_test() is
    let splice = SECTION_SPLICE()

    // A brace is written twice to get one, so each header below is =={{header|NAME}}==
    let page =
        "=={{{{header|Ada}}}}==\nada\n\n=={{{{header|Gleam}}}}==\ngleam\n\n=={{{{header|Go}}}}==\ngo\n"

    let section = "=={{{{header|ghul}}}}==\nghul\n"

    let failures mut = 0

    let check_that = (expectation: string, held: bool) =>
        val
            if !held then
                failures = failures + 1
            fi

            write_line("{if held then "  ok  " else "  FAIL" fi}  {expectation}")
        lav

    // A control character cannot survive a wiki page, so the published output
    // block shows Unicode's picture of it instead. The test still asserts the
    // real bytes, which is why only this rendering knows about the pictures.
    let escaped = "[7minverse[0m normal\n"

    check_that(
        "an escape character is shown as its picture",
        CONTROL_PICTURES.render(escaped) =~ "␛[7minverse␛[0m normal\n"
    )

    check_that(
        "a tab and a newline are left as they are",
        CONTROL_PICTURES.render("a\tb\n") =~ "a\tb\n"
    )

    check_that("a bell is shown as its picture", CONTROL_PICTURES.render("") =~ "␇")

    check_that("delete is shown as its picture", CONTROL_PICTURES.render("") =~ "␡")

    check_that("text with no control characters is unchanged", CONTROL_PICTURES.render("plain") =~ "plain")

    check_that("output holding one is recognised", CONTROL_PICTURES.has_any(escaped))

    check_that("output holding none is recognised", !CONTROL_PICTURES.has_any("a\tb\nc"))

    check_that(
        "the legend names each picture it shows, once",
        CONTROL_PICTURES.legend(escaped) =~ "In the output above, ␛ stands for the escape character."
    )

    check_that(
        "a legend over several pictures reads as a sentence",
        CONTROL_PICTURES.legend("") =~
            "In the output above, ␛ stands for the escape character and ␇ for the bell."
    )

    check_that("output with no control characters has no legend", !CONTROL_PICTURES.legend("plain")?)

    let spliced = splice.splice(page, "ghul", section)

    check_that("a good splice keeps every section", splice.keeps_every_other_section(page, spliced, "ghul"))
    check_that("a good splice stays confined", splice.is_confined(page, spliced, splice.placement(page, "ghul")))
    check_that(
        "a good splice puts ghul between Ada and Gleam",
        spliced.index_of("ghul") > spliced.index_of("Ada") /\ spliced.index_of("ghul") < spliced.index_of("Gleam")
    )

    // Section order on a real page is often not alphabetical, so a ghul section can sit after a
    // header ghul sorts before. Deciding placement on the ordering walk alone stops at that
    // header and inserts a second section beside the one already there.
    let out_of_order =
        "=={{{{header|Ada}}}}==\nada\n\n=={{{{header|Go}}}}==\ngo\n\n=={{{{header|ghul}}}}==\nold\n"

    check_that(
        "a ghul section out of alphabetical order is replaced, not duplicated",
        isa PLACEMENT.REPLACES(splice.placement(out_of_order, "ghul"))
    )

    check_that(
        "replacing a section is summarised as an update",
        edit_summary(splice.placement(out_of_order, "ghul"), null) =~ "Update the ghūl solution"
    )

    check_that(
        "adding a section is summarised as an addition",
        edit_summary(splice.placement(page, "ghul"), null) =~ "Add a ghūl solution"
    )

    check_that(
        "a note is appended to the summary",
        edit_summary(splice.placement(out_of_order, "ghul"), "link it to the playground") =~
            "Update the ghūl solution: link it to the playground"
    )

    // The page replaced by the section alone: what a wrong placement would produce, and the
    // failure worth being certain about.
    check_that("wiping the page is refused", !splice.keeps_every_other_section(page, section, "ghul"))

    // A splice that dropped one section on the way through.
    let lost = splice.splice(page.replace("=={{{{header|Gleam}}}}==\ngleam\n\n", ""), "ghul", section)

    check_that("losing one section is refused", !splice.keeps_every_other_section(page, lost, "ghul"))

    // A section that never made it in.
    check_that("leaving ghul out is refused", !splice.keeps_every_other_section(page, page, "ghul"))

    // The header template takes a display name after the language, and a section written that
    // way is still the ghul section. Missing it inserted a second one beside it.
    let aliased =
        "=={{{{header|Ada}}}}==\nada\n\n=={{{{header|Ghul|ghūl}}}}==\nold\n\n=={{{{header|Go}}}}==\ngo\n"

    check_that(
        "a ghul section with a display name is replaced, not duplicated",
        isa PLACEMENT.REPLACES(splice.placement(aliased, "ghul"))
    )

    // A page already carrying two ghul sections, one after the other.
    let duplicated =
        "=={{{{header|Ada}}}}==\nada\n\n=={{{{header|Ghul|ghūl}}}}==\nolder\n\n=={{{{header|ghul}}}}==\nold\n\n=={{{{header|Go}}}}==\ngo\n"

    let folded = splice.splice(duplicated, "ghul", section)

    check_that(
        "adjacent ghul sections are replaced by one",
        System.Text.RegularExpressions.Regex.matches(folded, "(?i)header\\|ghul").count == 1 /\
            !folded.contains("older") /\
            !folded.contains("old\n")
    )

    check_that("folding duplicates keeps every other section", splice.keeps_every_other_section(duplicated, folded, "ghul"))
    check_that("folding duplicates stays confined", splice.is_confined(duplicated, folded, splice.placement(duplicated, "ghul")))

    // A placement claiming the whole page, which is what the confinement check cannot see.
    check_that(
        "wiping the page passes the confinement check, which is why it is not the only one",
        splice.is_confined(page, section, PLACEMENT.REPLACES(0, page.length))
    )

    let markdown = MARKDOWN_TO_WIKI()

    check_that(
        "a heading becomes a level-three wiki heading",
        markdown.render("# The approach") =~ "===The approach==="
    )

    check_that(
        "a sub-heading becomes a level-four wiki heading",
        markdown.render("## Notes") =~ "====Notes===="
    )

    check_that(
        "bold and italic survive together",
        markdown.render("**bold** and *italic* and _also italic_") =~
            "'''bold''' and ''italic'' and ''also italic''"
    )

    check_that(
        "a link becomes url-then-text",
        markdown.render("see [the task](https://rosettacode.org/wiki/X)") =~
            "see [https://rosettacode.org/wiki/X the task]"
    )

    check_that(
        "a bullet list becomes wiki bullets",
        markdown.render("- one\n- two\n* three") =~ "* one\n* two\n* three"
    )

    check_that(
        "a numbered list becomes wiki numbering",
        markdown.render("1. one\n2. two") =~ "# one\n# two"
    )

    check_that(
        "a blank line separates paragraphs",
        markdown.render("first\nparagraph\n\nsecond") =~ "first paragraph\n\nsecond"
    )

    check_that(
        "an underscore in a link's url is not read as italic",
        markdown.render("[x](https://example.org/a_b_c)") =~ "[https://example.org/a_b_c x]"
    )

    check_that(
        "a list is followed by a blank line before the next heading",
        markdown.render("- one\n\n## Next") =~ "* one\n\n====Next===="
    )

    check_that(
        "a backtick span becomes a code element",
        markdown.render("the `previous` variable") =~ "the <code>previous</code> variable"
    )

    check_that(
        "emphasis markers inside a code span are left alone",
        markdown.render("`a_b` and `*c*`") =~ "<code>a_b</code> and <code>*c*</code>"
    )

    check_that(
        "an operator that would start a tag is escaped",
        markdown.render("`a <> b`") =~ "<code>a &lt;> b</code>"
    )

    check_that(
        "emphasis outside a code span still applies",
        markdown.render("**bold** then `code`") =~ "'''bold''' then <code>code</code>"
    )

    check_that(
        "a wrapped list item's continuation line joins the item",
        markdown.render("1. one\n   still one\n2. two") =~ "# one still one\n# two"
    )

    // the ledger is loaded from a path that does not exist, so it starts empty and the
    // check covers the decision alone, with no file involved
    let ledger = LEDGER(IO.Path.combine(IO.Path.get_temp_path(), IO.Path.get_random_file_name()))

    ledger.entry("Published long ago").state = "published"
    ledger.entry("Solved here").state = "solved"
    ledger.entry("Queued here").state = "queued"

    let foreign = unpublished_here(
        ledger,
        LIST[string](["Published long ago", "Solved here", "Queued here", "Never heard of"])
    )

    check_that(
        "a wiki section this ledger published is not foreign",
        !foreign.contains("Published long ago")
    )

    check_that(
        "a wiki section over a locally solved task is foreign",
        foreign.contains("Solved here")
    )

    check_that(
        "a wiki section over a locally queued task is foreign",
        foreign.contains("Queued here")
    )

    check_that(
        "a wiki section the ledger has no entry for is foreign",
        foreign.contains("Never heard of")
    )

    check_that("exactly the foreign titles come back", foreign.count =~ 3)

    if failures > 0 then
        error.write_line("{failures} checks failed")

        System.Environment.exit_code = 1
    fi
si

// Replaces the whole text of a page that is not a task's - a template, the language
// page - from a file. A task's section goes through `publish`, which splices it into the
// page and records it in the ledger; this does neither. With --dry-run it shows the
// page's current text and the new one and changes nothing. A page already holding the
// text is left alone.
edit_page(title: string, path: string, summary: string, dry_run: bool) is
    let wiki = WIKI(SITE.api)
    let text = IO.File.read_all_text(path)
    let current = wiki.page_wikitext(title)

    if current? /\ current.trim_end() =~ text.trim_end() then
        write_line("{title} already holds that text; nothing to do")
        return
    fi

    if dry_run then
        write_line("--- {title}, now:")
        write_line(current ?? "(no such page)")
        write_line("--- {title}, after:")
        write_line(text)
        return
    fi

    let account = credentials()

    wiki.log_in(account.user, account.password)
    wiki.edit(title, text, summary, false)

    write_line("edited {title}")
si

// Signs in and reports the account, without changing anything.
check(api: string?) is
    let wiki = WIKI(api ?? SITE.api)
    let account = credentials()

    wiki.log_in(account.user, account.password)

    let signed_in = wiki.account()

    write_line("signed in as {signed_in.name}")

    if !signed_in.can_edit then
        error.write_line("this account cannot edit: check the credential's grants")
    fi
si

digest(section: string) -> string => SECTION.digest(section)

// Writes each named task's section to wiki-out/<slug>.wiki, which is what `publish` reads, and
// reports one line a task. A task with nothing to post - a disabled test, no source, or no
// captured output - is reported and skipped, and makes the exit status non-zero.
write_wiki_out(root: string, slugs: Collections.List[string]) is
    let out = IO.Path.combine(root, "wiki-out")
    let section = SECTION(root)

    IO.Directory.create_directory(out)

    for slug in slugs do
        let path = IO.Path.combine(out, "{slug}.wiki")

        if let markup = section.render(slug) then
            IO.File.write_all_text(path, markup)

            let task = IO.Path.combine(root, "tasks", slug)
            let descriptor =
                System.Text.Json.JsonDocument.parse(IO.File.read_all_text(IO.Path.combine(task, "task.json")), _).root_element

            let status = descriptor.get_property("status").get_string()
            let url = descriptor.get_property("url").get_string()
            let notes = if IO.Directory.get_files(task, "notes.md", IO.SearchOption.ALL_DIRECTORIES).count > 0 then " (notes)" else "" fi

            write_line("{slug,-28} {status,-9} {url}{notes}")
        else
            IO.File.delete(path)

            write_line("{slug,-28} skipped (disabled, no source, or no captured output)")

            System.Environment.exit_code = 1
        fi
    od
si

// Records the section that is live on the wiki as the one this repository published, so a later
// `publish` can replace it.
//
// It is only recorded when the live section is exactly the markup in wiki-out/<slug>.wiki, which
// means generating that markup from the revision that was published rather than from the working
// tree. That is the whole safety of it: adopting whatever happens to be on the page would bless a
// stranger's edit and let the next publish throw it away, which is the thing the hash exists to
// prevent.
adopt(root: string, slugs: LIST[string]) is
    if slugs.count == 0 then
        error.write_line("usage: rosetta adopt <slug> ...")

        return
    fi

    let ledger = LEDGER(IO.Path.combine(root, "ledger"))
    let splice = SECTION_SPLICE()
    let wiki = WIKI(SITE.api)

    let refused mut = 0

    for entry in ledger.entries() do
        let slug = entry.slug

        if !slug? \/ !slugs.contains(slug) then
            continue
        fi

        let markup = IO.Path.combine(root, "wiki-out", "{slug}.wiki")

        if !IO.File.exists(markup) then
            error.write_line("{entry.title}: no markup at wiki-out/{slug}.wiki - generate it from the revision that was published")

            refused = refused + 1

            continue
        fi

        let page = wiki.page_wikitext(entry.title)

        if !page? then
            error.write_line("{entry.title}: no such page on the wiki")

            refused = refused + 1

            continue
        fi

        let placement = splice.placement(page, SITE.language)

        if let replaced: PLACEMENT.REPLACES = placement then
            let live = page.substring(replaced.start, replaced.end - replaced.start).trim()
            let expected = IO.File.read_all_text(markup).trim()

            if !string.equals(live, expected) then
                error.write_line("{entry.title}: the live section is not the markup in wiki-out/{slug}.wiki, so nothing was recorded")

                IO.File.write_all_text(IO.Path.combine(root, "wiki-out", "{slug}.live"), live)

                error.write_line("  what is on the wiki is in wiki-out/{slug}.live")

                refused = refused + 1

                continue
            fi

            entry.published_hash = digest(live)
            entry.state = "published"

            ledger.save()

            write_line("{entry.title}: recorded")
        else
            error.write_line("{entry.title}: there is no ghul section on the page to adopt")

            refused = refused + 1
        fi
    od

    if refused > 0 then
        error.write_line("{refused} were not recorded")

        System.Environment.exit_code = 1
    fi
si

// How long a publish run waits between one task's requests and the next's. Paces every request
// the wiki sees from a run, not only a successful edit, so a task that made a request and then
// failed still waits before the next one starts. ROSETTA_PACE_SECONDS lengthens it when the
// wiki is slow to answer.
pace_ms() -> int is
    let seconds = System.Environment.get_environment_variable("ROSETTA_PACE_SECONDS")
    let parsed mut = 0

    if seconds? /\ int.try_parse(seconds, parsed ref) /\ parsed > 0 then
        return parsed * 1000
    fi

    30000
si

// `target` redirects every write to one page, so the whole path - sign in, fetch the real task
// page, splice, save - can be run against a sandbox. The only thing it leaves untested is which
// page the text is sent to.
// `rehearse` reads and writes one page instead of a task page: the section is spliced into
// whatever that page already holds, and the result written back. Running it twice replaces the
// section rather than adding a second one, which is the same path a corrected solution takes.
// What a publish run would change, found without signing in or writing anything to the wiki.
// One line a task, tab-separated: the status, the slug and the title. `new` has no ghul section
// on the wiki yet; `same` and `differs` compare the live section with wiki-out/<slug>.wiki, and
// `differs` leaves the live one beside it as wiki-out/<slug>.live. `edited` marks a live section
// that is not the one published from here, and `unrecorded` one with no record of what was
// published: publish refuses both, and `rosetta adopt` records an unrecorded one that is ours.
// `no-markup` and `no-page` say which side is missing.
diff(root: string, slugs: LIST[string]) is
    let ledger = LEDGER(IO.Path.combine(root, "ledger"))
    let splice = SECTION_SPLICE()
    let wiki = WIKI(SITE.api)

    let wanted =
        ledger.entries()
            |> filter(entry =>
                entry.slug? /\
                if slugs.count > 0 then
                    slugs.contains(entry.slug ?? "")
                else
                    entry.state =~ "published" \/ entry.state =~ "solved"
                fi)
            |> collect_mutable()

    let pages = wiki.pages_wikitext(wanted |> map(entry => entry.title) |> collect_mutable())

    for entry in wanted do
        let slug = entry.slug ?? ""
        let markup = IO.Path.combine(root, "wiki-out", "{slug}.wiki")

        if !IO.File.exists(markup) then
            write_line("no-markup\t{slug}\t{entry.title}")
            continue
        fi

        if !pages.contains_key(entry.title) then
            write_line("no-page\t{slug}\t{entry.title}")
            continue
        fi

        let page = pages[entry.title]

        if let replaced: PLACEMENT.REPLACES = splice.placement(page, SITE.language) then
            let live = page.substring(replaced.start, replaced.end - replaced.start).trim()
            let section = IO.File.read_all_text(markup).trim()

            let status =
                if live =~ section then
                    "same"
                elif !entry.published_hash? then
                    "unrecorded"
                elif digest(live) !~ entry.published_hash then
                    "edited"
                else
                    "differs"
                fi

            if live !~ section then
                IO.File.write_all_text(IO.Path.combine(root, "wiki-out", "{slug}.live"), live)
            fi

            write_line("{status}\t{slug}\t{entry.title}")
        else
            write_line("new\t{slug}\t{entry.title}")
        fi
    od
si

publish(root: string, slugs: LIST[string], dry_run: bool, target: string?, api: string?, rehearse: bool, replace: bool, note: string?, minor: bool) is
    let ledger = LEDGER(IO.Path.combine(root, "ledger"))
    let splice = SECTION_SPLICE()

    // Reading always comes from Rosetta Code: the point of a run against another wiki is to
    // splice the real task page and write the result somewhere harmless.
    let wiki = WIKI(SITE.api)
    let destination = if api? then WIKI(api) else wiki fi

    let wanted = LIST[TASK_ENTRY]()

    if slugs.count > 0 then
        for entry in ledger.entries() do
            if let slug = entry.slug /\ slugs.contains(slug) then
                wanted.add(entry)
            fi
        od
    else
        for entry in ledger.in_state("solved") do
            wanted.add(entry)
        od
    fi

    if wanted.count == 0 then
        error.write_line("nothing to publish")

        return
    fi

    if !dry_run then
        let account = credentials()

        destination.log_in(account.user, account.password)
    fi

    let refused mut = 0

    for entry in wanted do
        let slug = entry.slug

        if !slug? then
            error.write_line("{entry.title}: no solution here to publish")

            continue
        fi

        let markup = IO.Path.combine(root, "wiki-out", "{slug}.wiki")

        if !IO.File.exists(markup) then
            error.write_line("{entry.title}: no markup at wiki-out/{slug}.wiki - generate it first")

            continue
        fi

        let section = IO.File.read_all_text(markup)

        let source = if rehearse then target ?? entry.title else entry.title fi

        let page =
            if rehearse then
                destination.page_wikitext(source)
            else
                wiki.page_wikitext(source)
            fi

        if !page? then
            error.write_line("{entry.title}: no such page on the wiki")

            continue
        fi

        let placement = splice.placement(page, SITE.language)

        let where =
            case placement
            when _: PLACEMENT.REPLACES then "replacing the ghul section already there"
            when before: PLACEMENT.INSERTED_BEFORE then "ahead of {before.language}"
            when _: PLACEMENT.APPENDED then "at the end of the page"
            esac

        let spliced = splice.splice(page, SITE.language, section)

        if !splice.keeps_every_other_section(page, spliced, SITE.language) then
            error.write_line("{entry.title}: the spliced page has lost a language section, so nothing was sent")

            refused = refused + 1

            continue
        fi

        if !splice.is_confined(page, spliced, placement) then
            error.write_line("{entry.title}: the splice would change the page outside the ghul section, so nothing was sent")

            refused = refused + 1

            continue
        fi

        if dry_run then
            // Both sides are written, so the edit can be read as a diff before it is an edit.
            IO.File.write_all_text(IO.Path.combine(root, "wiki-out", "{slug}.current"), page)

            IO.File.write_all_text(IO.Path.combine(root, "wiki-out", "{slug}.page"), spliced)

            write_line("{entry.title}: would go {where}; diff wiki-out/{slug}.current wiki-out/{slug}.page")

            report_images(root, slug, section)

            continue
        fi

        if api? /\ !target? then
            error.write_line("--api needs --target: refusing to write a task page on another wiki")

            return
        fi

        // Somebody may have edited the section since it was published - a correction, a
        // simplification, a fix to something wrong. Replacing it then destroys their work
        // silently, which is what happened to an edit on Multiton the first time this ran.
        //
        // So a replacement is only made when the section on the page is still the one this
        // repository put there, which is what `published_hash` records. Comparing against what
        // is about to be sent instead would refuse every update, since an update is a change by
        // definition.
        if let replaced: PLACEMENT.REPLACES = placement /\ !replace then
            let live = page.substring(replaced.start, replaced.end - replaced.start).trim()

            if !entry.published_hash? then
                error.write_line("{entry.title}: nothing is recorded about what was last published here, so an edit made on the wiki cannot be told from ours - nothing was sent")

                IO.File.write_all_text(IO.Path.combine(root, "wiki-out", "{slug}.live"), live)

                error.write_line("  what is on the wiki is in wiki-out/{slug}.live; read it, and if it is ours, `rosetta adopt {slug}` records it")

                refused = refused + 1

                continue
            fi

            if digest(live) !~ entry.published_hash then
                error.write_line("{entry.title}: the ghul section on the wiki is not the one published from here, so nothing was sent - read the difference before replacing it")

                IO.File.write_all_text(IO.Path.combine(root, "wiki-out", "{slug}.live"), live)

                error.write_line("  what is on the wiki is in wiki-out/{slug}.live; what would replace it is wiki-out/{slug}.wiki")

                refused = refused + 1

                continue
            fi
        fi

        // The last check before anything is sent, and the only one the splice does not mark its
        // own homework on: the wiki diffs its own stored revision against what it is being
        // offered. An insertion removes nothing; replacing the ghul section already there
        // removes that section and no more.
        let allowed_removals =
            case placement
            when replaced: PLACEMENT.REPLACES then
                page.substring(replaced.start, replaced.end - replaced.start).split(['\n']).count
            else
                0
            esac

        // A network blip or a malformed response here is the wiki's problem for this one
        // request, not a reason to stop publishing everything after it - the same standing the
        // edit itself is given below.
        let removals mut = 0

        try
            removals =
                if rehearse then
                    destination.lines_removed(source, spliced)
                else
                    wiki.lines_removed(source, spliced)
                fi
        catch problem: System.Exception
            error.write_line("{entry.title}: could not check how many lines this would remove, so nothing was sent - {problem.message}")

            refused = refused + 1

            System.Threading.Thread.sleep(pace_ms())

            continue
        yrt

        if removals > allowed_removals then
            error.write_line("{entry.title}: the wiki's own diff says this would remove {removals} lines, so nothing was sent")

            refused = refused + 1

            System.Threading.Thread.sleep(pace_ms())

            continue
        fi

        // A wiki can refuse one edit for reasons that say nothing about the next - an abuse
        // filter, a rate limit, a page protected since the run began - so a refusal is reported
        // against the task it happened to and the rest of the batch carries on.
        try
            if let sandbox = target then
                destination.edit(
                    sandbox,
                    spliced,
                    "Testing a ghūl solution's placement on {entry.title}",
                    false
                )

                write_line("{entry.title}: written to {sandbox}, would have gone {where}")
            else
                // slug! rather than slug: the try/catch above sits between where slug is
                // narrowed and this use of it, and the compiler does not carry a local's
                // narrowing across a try block even though nothing here reassigns it.
                upload_images(root, wiki, entry, slug!, section)

                wiki.edit(entry.title, spliced, edit_summary(placement, note), minor)

                entry.state = "published"
                entry.published_hash = digest(section.trim())

                ledger.save()

                write_line("{entry.title}: published, {where}")
            fi
        catch refusal: System.Exception
            refused = refused + 1

            error.write_line("{entry.title}: {refusal.message}")
        yrt

        System.Threading.Thread.sleep(pace_ms())
    od

    if refused > 0 then
        error.write_line("{refused} of {wanted.count} were refused")

        System.Environment.exit_code = 1
    fi
si

let arguments = LIST[string](System.Environment.get_command_line_args())

arguments.remove_at(0)

if arguments.count == 0 then
    usage()
else
    let root = find_root()
    let command = arguments[0]

    arguments.remove_at(0)

    case command
    when "sync" then
        sync(root)
    when "candidates" then
        let category: string? mut = null
        let count mut = 20
        let awaiting mut = false

        for argument in arguments do
            if awaiting then
                category = argument
                awaiting = false
            elif argument =~ "--category" then
                awaiting = true
            else
                count = int.parse(argument)
            fi
        od

        if awaiting then
            error.write_line("--category needs a category name")
        else
            candidates(root, count, category)
        fi
    when "show" then
        show(root, if arguments.count > 0 then arguments[0] else null fi)
    when "set" then
        if arguments.count < 2 then
            error.write_line("usage: rosetta set <title> <state> [reason] [note]")
        else
            set(
                root,
                arguments[0],
                arguments[1],
                if arguments.count > 2 then arguments[2] else null fi,
                if arguments.count > 3 then arguments[3] else null fi
            )
        fi
    when "reopen" then
        if arguments.count < 2 then
            error.write_line("usage: rosetta reopen <title> <note>")
        else
            reopen(root, arguments[0], arguments[1])
        fi
    when "index" then
        write_index(root, arguments.contains("--check"))
    when "self-test" then
        self_test()
    when "adopt" then
        adopt(root, arguments)
    when "render-output" then
        if arguments.count < 1 then
            error.write_line("usage: rosetta render-output <path-to-output> [--legend]")
        else
            let text = IO.File.read_all_text(arguments[0])

            // `--legend` asks for the sentence alone, since the caller puts it
            // under the output block rather than inside it.
            if arguments.contains("--legend") then
                if let legend = CONTROL_PICTURES.legend(text) then
                    write_line(legend)
                fi
            else
                IO.Std.write(CONTROL_PICTURES.render(text))
            fi
        fi
    when "section" then
        if arguments.count < 1 then
            error.write_line("usage: rosetta section <slug>")
        elif let section = SECTION(root).render(arguments[0]) then
            IO.Std.write(section)
        else
            error.write_line("{arguments[0]}: no section - disabled, no source, or no captured output")

            System.Environment.exit_code = 1
        fi
    when "wiki-out" then
        write_wiki_out(root, arguments)
    when "render-notes" then
        if arguments.count < 1 then
            error.write_line("usage: rosetta render-notes <path-to-notes.md>")
        else
            write_line(MARKDOWN_TO_WIKI().render(IO.File.read_all_text(arguments[0])))
        fi
    when "edit-page" then
        let dry_run = arguments.remove("--dry-run")

        if arguments.count < 3 then
            error.write_line("usage: rosetta edit-page <title> <file> <summary> [--dry-run]")
        else
            edit_page(arguments[0], arguments[1], arguments[2], dry_run)
        fi
    when "diff" then
        diff(root, arguments |> filter(argument => argument !~ "--all") |> collect_mutable())
    when "check" then
        check(if arguments.count > 1 /\ arguments[0] =~ "--api" then arguments[1] else null fi)
    when "publish" then
        let dry_run = arguments.contains("--dry-run")
        let target: string? mut = null
        let api: string? mut = null
        let note: string? mut = null
        let rehearse mut = false
        let replace = arguments.contains("--replace")
        let minor = arguments.contains("--minor")
        let solved = arguments.contains("--solved")
        let slugs = LIST[string]()
        let unknown = LIST[string]()
        let awaiting mut = ""

        for argument in arguments do
            if awaiting =~ "--target" then
                target = argument
                awaiting = ""
            elif awaiting =~ "--api" then
                api = argument
                awaiting = ""
            elif awaiting =~ "--note" then
                note = argument
                awaiting = ""
            elif awaiting =~ "--rehearse" then
                target = argument
                rehearse = true
                awaiting = ""
            elif
                argument =~ "--target" \/ argument =~ "--api" \/
                argument =~ "--note" \/ argument =~ "--rehearse"
            then
                awaiting = argument
            elif
                argument =~ "--dry-run" \/ argument =~ "--replace" \/
                argument =~ "--solved" \/ argument =~ "--minor"
            then
                // Already read above.
            elif argument.starts_with("--") then
                // An unrecognised flag taken as a slug matches no task, so the
                // run publishes nothing and says only that there was nothing to
                // publish. Refuse it instead.
                unknown.add(argument)
            else
                slugs.add(argument)
            fi
        od

        if awaiting.length > 0 then
            error.write_line("{awaiting} needs a value")
        elif unknown.count > 0 then
            error.write_line("unknown option: {unknown |> join(", ")}")
        elif slugs.count == 0 /\ !solved then
            error.write_line(
                "publish needs one or more slugs, or --solved for every solved task")
        else
            publish(root, slugs, dry_run, target, api, rehearse, replace, note, minor)
        fi
    else
        usage()
    esac
fi
