namespace Rosetta is
    use System.Text.RegularExpressions.Regex
    use System.Text.RegularExpressions.Match
    use Collections

    // Where a language's section belongs in a task page, and what is already there.
    union Placement is
        REPLACES(start: int, end: int)
        INSERTED_BEFORE(start: int, language: string)
        APPENDED(start: int)
    si

    // Puts a language's section into a task page's wikitext.
    //
    // A task page is a run of level-two `{{header|LANGUAGE}}` sections in case-insensitive
    // alphabetical order, one per language, each running to the next such header. Anything
    // deeper belongs to the section above it, so only level-two headers are read here.
    // Where the ghūl solutions live on the wiki, and what they are called there.
    class SITE is
        api: string static => "https://rosettacode.org/w/api.php"
        language: string static => "ghul"
        category: string static => "Category:Ghul"
        task_category: string static => "Category:Programming Tasks"
    si

    class SECTION_SPLICE is
        init() is si

        // A level-two language header on a line of its own, with the name captured. The template
        // also takes a display name after a second bar, as in {{header|Ghul|ghūl}}, and the
        // language is the first argument either way. A brace is written twice to get one, so the
        // pattern this builds is:
        //
        //     (?m)^==[ \t]*\{\{header\|([^}|]+)(?:\|[^}]*)?\}\}[ \t]*==[ \t]*$
        _PATTERN: string static =>
            "(?m)^==[ \\t]*\\{{\\{{header\\|([^}}|]+)(?:\\|[^}}]*)?\\}}\\}}[ \\t]*==[ \\t]*$"

        _headers(page: string) -> LIST[Match] is
            let found = LIST[Match]()
            let matches = Regex.matches(page, _PATTERN)

            for i in 0..matches.count do
                found.add(matches[i])
            od

            return found
        si

        _name(m: Match) -> string => m.groups[1].value.trim()

        _before(left: string, right: string) -> bool =>
            string.compare(left, right, System.StringComparison.ORDINAL_IGNORE_CASE) < 0

        _names(header: Match, language: string) -> bool =>
            string.equals(_name(header), language, System.StringComparison.ORDINAL_IGNORE_CASE)

        // Where `language`'s section goes, without changing anything.
        //
        // An existing section is looked for across the whole page before any
        // insertion point is considered. A page whose sections are not in
        // alphabetical order - and many are not - has one sitting after the
        // header the ordering walk would stop at, so deciding on the walk
        // alone inserts a second section beside the one already there.
        //
        // Sections for the language that follow one another are replaced together, so a page
        // already carrying a duplicate ends up with one section rather than keeping both.
        placement(page: string, language: string) -> Placement is
            let headers = _headers(page)

            for i in 0..headers.count do
                if _names(headers[i], language) then
                    let last mut = i

                    while last + 1 < headers.count /\ _names(headers[last + 1], language) do
                        last = last + 1
                    od

                    let end =
                        if last + 1 < headers.count then
                            headers[last + 1].index
                        else
                            page.length
                        fi

                    return Placement.REPLACES(headers[i].index, end)
                fi
            od

            for i in 0..headers.count do
                if _before(language, _name(headers[i])) then
                    return Placement.INSERTED_BEFORE(
                        headers[i].index, _name(headers[i]))
                fi
            od

            return Placement.APPENDED(page.length)
        si

        // The check that matters, and the reason it does not consult the placement: a splice
        // reasons about where the section goes, so a guard built on that reasoning shares its
        // mistakes. A placement of "replace the whole page" satisfies a prefix-and-suffix
        // comparison trivially, both being empty.
        //
        // So this asks the page itself. Every language section that was there has to still be
        // there afterwards, and ghul has to be one of them. Nothing a wrong placement can say
        // makes a lost section look present.
        keeps_every_other_section(page: string, spliced: string, language: string) -> bool is
            let after = LIST[string]()

            for header in _headers(spliced) do
                after.add(_name(header).to_lower())
            od

            if !after.contains(language.to_lower()) then
                return false
            fi

            for header in _headers(page) do
                let name = _name(header).to_lower()

                if !string.equals(name, language.to_lower()) /\ !after.contains(name) then
                    return false
                fi
            od

            return true
        si

        // What a splice is allowed to disturb: everything before where the section goes has to
        // survive unchanged, and so does everything after whatever it replaces. A splice that
        // fails this has gone wrong somewhere, and an edit to a live page is the wrong place to
        // discover that.
        is_confined(page: string, spliced: string, placement: Placement) -> bool is
            let head =
                case placement
                when replaced: Placement.REPLACES then replaced.start
                when inserted: Placement.INSERTED_BEFORE then inserted.start
                when appended: Placement.APPENDED then appended.start
                esac

            let tail =
                case placement
                when replaced: Placement.REPLACES then replaced.end
                when _: Placement.INSERTED_BEFORE then head
                when appended: Placement.APPENDED then appended.start
                esac

            if head > spliced.length \/ tail > page.length then
                return false
            fi

            if !string.equals(page.substring(0, head), spliced.substring(0, head)) then
                return false
            fi

            let remaining = page.length - tail

            if remaining > spliced.length then
                return false
            fi

            // The tail is compared with its trailing whitespace off, because appending trims the
            // page's own end before adding to it.
            return string.equals(
                page.substring(tail).trim_end(),
                spliced.substring(spliced.length - remaining).trim_end()
            )
        si

        // The page with `section` in place of, or in alphabetical position among, the language
        // sections already there. `section` is the whole section, heading included.
        splice(page: string, language: string, section: string) -> string =>
            val
                let body = "{section.trim_end()}\n\n"

                case placement(page, language)
                when replaced: Placement.REPLACES then
                    "{page.substring(0, replaced.start)}{body}{page.substring(replaced.end)}"
                when inserted: Placement.INSERTED_BEFORE then
                    "{page.substring(0, inserted.start)}{body}{page.substring(inserted.start)}"
                when _: Placement.APPENDED then
                    "{page.trim_end()}\n\n{body.trim_end()}\n"
                esac
            lav
    si
si
